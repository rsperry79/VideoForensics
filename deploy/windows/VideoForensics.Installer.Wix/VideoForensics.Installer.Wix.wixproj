<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v5 MSI Project for VideoForensics

  Validated against a real WiX v5.0.2 SDK build on Windows (2026-09-20) with a real publish output.

  Still open:
  - Event Log source registration approach (util:EventSource vs. direct registry)
  - Service failure-recovery config (util:ServiceConfig availability)
-->
<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Package</OutputType>

    <!-- Pin the output filename to VideoForensics.msi rather than relying on the WiX SDK's
         default (which follows the .wixproj filename, i.e. VideoForensics.Installer.Wix.msi) -
         the release CI workflow (.github/workflows/release-installers.yml) depends on this
         exact, predictable name. -->
    <OutputName>VideoForensics</OutputName>

    <!-- Placeholders meant to be overridden at CI build time via -p:PublishDir=... -p:ProductVersion=...
         with the real self-contained publish path and product version read from VideoForensics.WebApp.csproj.
         These are kept as their own properties (rather than passing a single combined -p:DefineConstants
         value) because the WixBuild MSBuild task turns each ';'-separated DefineConstants entry into its
         own "-d Name=Value" argument to wix.exe - passing a single -p:DefineConstants="A=1;B=2" from the
         command line collapses to ONE "-d" entry whose value is "1;B=2" instead of two separate defines,
         which manifests as WIX0150 (undefined preprocessor variable) for whichever constant got swallowed. -->
    <PublishDir Condition="'$(PublishDir)' == ''">..\..\..\src\client\web\VideoForensics.WebApp\bin\Release\net10.0\win-x64\publish</PublishDir>
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <DefineConstants>PublishDir=$(PublishDir);ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
  </ItemGroup>

  <!-- WixToolset.Sdk auto-globs **/*.wxs as Compile items (EnableDefaultItems, like the .NET SDK
       globbing .cs files) - an explicit <Compile Include="Package.wxs" /> here double-includes it,
       producing two entry sections (WIX0089/WIX0090). -->
</Project>
