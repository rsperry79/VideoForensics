<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v5 Burn Bootstrapper Project for VideoForensics

  Wraps the MSI (from VideoForensics.Installer.Wix) into a single .exe bootstrapper
  with the WiX Standard Bootstrapper Application UI.

  Validated against a real WiX v5.0.2 SDK build on Windows (2026-09-20), including ProjectReference
  harvesting of the MSI project's .TargetPath and the WixStandardBootstrapperApplication variant.

  Still open:
  - Whether a real license/icon should be added (currently suppressed - see Bundle.wxs)
-->
<Project Sdk="WixToolset.Sdk/5.0.2">
  <PropertyGroup>
    <OutputType>Bundle</OutputType>

    <!-- Pin the output filename to VideoForensicsBootstrapper.exe rather than relying on the
         WiX SDK's default (which follows the .wixproj filename) - the release CI workflow
         (.github/workflows/release-installers.yml) depends on this exact, predictable name. -->
    <OutputName>VideoForensicsBootstrapper</OutputName>

    <!-- ProductVersion should match the MSI (VideoForensics.Installer.Wix uses the same property -
         see the comment there for why this is a standalone property rather than being folded
         directly into a single -p:DefineConstants="..." command-line override). -->
    <ProductVersion Condition="'$(ProductVersion)' == ''">1.0.0</ProductVersion>
    <DefineConstants>ProductVersion=$(ProductVersion)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplications.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
  </ItemGroup>

  <!-- ProjectReference to the MSI project. WiX v5 SDK automatically harvests the MSI's
       TargetPath and makes it available as $(var.VideoForensics.Installer.Wix.TargetPath)
       in the Bundle.wxs file, which is used to reference the MSI in the Chain element. -->
  <ItemGroup>
    <ProjectReference Include="..\VideoForensics.Installer.Wix\VideoForensics.Installer.Wix.wixproj" />
  </ItemGroup>

  <!-- WixToolset.Sdk auto-globs **/*.wxs as Compile items (EnableDefaultItems, like the .NET SDK
       globbing .cs files) - an explicit <Compile Include="Bundle.wxs" /> here double-includes it,
       producing two entry sections (WIX0089/WIX0090). -->
</Project>
