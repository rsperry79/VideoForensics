#!/bin/sh
set -e

# postinst script for videoforensics package
# This script handles fresh installs and upgrades.
# The first argument passed by dpkg is the action: "configure" followed by
# the previously-installed version (if upgrading) or empty (if fresh install).

OLD_VERSION="${2:-}"

# Determine if this is a fresh install or an upgrade
if [ -z "$OLD_VERSION" ]; then
    # Fresh install: create system user, setup data directory, enable service

    # Create system user and group for videoforensics
    # This is idempotent - if user already exists, adduser will silently succeed
    adduser --system --group --no-create-home --home /nonexistent \
        --quiet videoforensics 2>/dev/null || true

    # Create data directory if it doesn't exist and set proper ownership
    # Only on fresh install - on upgrade, we leave permissions alone to avoid
    # clobbering an already-running data directory (see upgrade branch below)
    if [ ! -d /var/lib/videoforensics ]; then
        mkdir -p /var/lib/videoforensics
        chown videoforensics:videoforensics /var/lib/videoforensics
        chmod 0750 /var/lib/videoforensics
    fi

    # Reload systemd to register the new service unit file
    systemctl daemon-reload || true

    # Enable and start the service on fresh install
    systemctl enable videoforensics || true
    systemctl start videoforensics || true
else
    # Upgrade: service is already enabled, just restart it with new binary
    # No changes to data directory permissions - they stay as-is for safety

    # Reload systemd to pick up any changes to the service unit file
    systemctl daemon-reload || true

    # Restart the service with the new binaries
    # Note: no explicit database migration step is needed here.
    # VideoForensics app performs automatic migration via DatabaseInitializer.InitializeAsync
    # on every startup, including after the binary is updated.
    systemctl restart videoforensics || true
fi

exit 0
