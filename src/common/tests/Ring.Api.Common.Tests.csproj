        <AssemblyName>KoenZomers.Ring.Api.Common.Tests</AssemblyName>
        <RootNamespace>KoenZomers.Ring.Api.Common.Tests</RootNamespace>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>..\..\..\KoenZomers.RingApi.snk</AssemblyOriginatorKeyFile>
