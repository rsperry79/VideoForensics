<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>KoenZomers.Ring.Api</RootNamespace>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>../../KoenZomers.RingApi.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>KoenZomers.Ring.Api.Common</AssemblyName>
        <Company>Koen Zomers</Company>
        <Authors>Koen Zomers, Daniel Espinosa</Authors>
        <Description>Common interfaces, entities, and exceptions for Ring API</Description>
        <PackageProjectUrl>https://github.com/KoenZomers/RingApi</PackageProjectUrl>
        <RepositoryUrl>https://github.com/KoenZomers/RingApi</RepositoryUrl>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
        <PackageTags>Ring;Ring Api;Ring Doorbell;.NET;C#</PackageTags>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <Copyright>Koen Zomers</Copyright>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../KoenZomers.RingApi.snk" Link="KoenZomers.RingApi.snk" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="tests/**" />
    </ItemGroup>

</Project>
