<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>VideoForensics.Providers.Wyze</RootNamespace>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>../../../../KoenZomers.RingApi.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>VideoForensics.Providers.Wyze.Auth</AssemblyName>
        <Company>Video Forensics</Company>
        <Authors>Video Forensics Team</Authors>
        <Description>Authentication and credential management for Wyze API</Description>
        <Copyright>Video Forensics</Copyright>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../../../KoenZomers.RingApi.snk" Link="KoenZomers.RingApi.snk" />
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.11" />
        <ProjectReference Include="../common/VideoForensics.Providers.Wyze.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="tests/**/*.cs" />
    </ItemGroup>

</Project>
