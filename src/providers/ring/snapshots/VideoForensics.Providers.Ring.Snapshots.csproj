<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VideoForensics.Providers.Ring.Snapshots</RootNamespace>
    <AssemblyName>VideoForensics.Providers.Ring.Snapshots</AssemblyName>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <Nullable>enable</Nullable>
    <Description>Ring API snapshot management - internal testing/utility library for snapshot operations.</Description>
    <AssemblyTitle>Ring.Api.Snapshots</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../common/VideoForensics.Providers.Ring.Common.csproj" />
    <ProjectReference Include="../core/VideoForensics.Providers.Ring.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="tests/**" />
    <Compile Remove="metadata/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
  </ItemGroup>

</Project>


