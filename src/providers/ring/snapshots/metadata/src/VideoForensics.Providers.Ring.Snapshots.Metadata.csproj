<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>VideoForensics.Providers.Ring</RootNamespace>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>../../../../../../VideoForensics.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>VideoForensics.Providers.Ring.Snapshots.Metadata</AssemblyName>
        <Company>Koen Zomers</Company>
        <Authors>Koen Zomers, Daniel Espinosa</Authors>
        <Description>Snapshot metadata extraction, EXIF writing, and validation for Ring.Api</Description>
        <Copyright>Koen Zomers</Copyright>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../../../../../VideoForensics.snk" Link="VideoForensics.snk" />
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../src/VideoForensics.Providers.Ring.Snapshots.csproj" />
        <ProjectReference Include="../../../common/src/VideoForensics.Providers.Ring.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="System.IO.Abstractions" Version="22.3.0" />
        <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    </ItemGroup>

</Project>
