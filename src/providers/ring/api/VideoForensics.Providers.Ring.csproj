<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VideoForensics.Providers.Ring</RootNamespace>
    <AssemblyName>VideoForensics.Providers.Ring</AssemblyName>
    <Nullable>enable</Nullable>
    <Description>Aggregated Ring API package combining all Ring API modules (Core, Auth, Video, Common, Utils, Snapshots) into a single NuGet package for convenient consumption.</Description>
    <AssemblyTitle>Ring API</AssemblyTitle>
    <Version>1.0.0</Version>
    <Authors>Koen Zomers;Ring Community</Authors>
    <PackageProjectUrl>https://github.com/koenbeuk/RingApi</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/koenbeuk/RingApi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ring;api;video;doorbell;security;camera</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../core/VideoForensics.Providers.Ring.Core.csproj" />
    <ProjectReference Include="../auth/VideoForensics.Providers.Ring.Auth.csproj" />
    <ProjectReference Include="../video/VideoForensics.Providers.Ring.Video.csproj" />
    <ProjectReference Include="../common/VideoForensics.Providers.Ring.Common.csproj" />
    <ProjectReference Include="../utils/VideoForensics.Providers.Ring.Utils.csproj" />
    <ProjectReference Include="../snapshots/VideoForensics.Providers.Ring.Snapshots.csproj" />
  </ItemGroup>

</Project>



