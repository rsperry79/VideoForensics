<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>VideoForensics.Providers.Ring</RootNamespace>
        <SignAssembly>true</SignAssembly>
        <!-- Strong names are not validated on .NET (Core); this assembly is signed for legacy reasons but
             references unsigned assemblies (SIPSorcery, VideoForensics.* libraries), which is harmless. -->
        <NoWarn>$(NoWarn);CS8002</NoWarn>
        <AssemblyOriginatorKeyFile>../../../../KoenZomers.RingApi.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>VideoForensics.Providers.Ring.Core</AssemblyName>
        <Company>Koen Zomers</Company>
        <Authors>Koen Zomers, Daniel Espinosa</Authors>
        <Description>Core session and service implementations for Ring.Api</Description>
        <Copyright>Koen Zomers</Copyright>
        <PackageLicenseExpression> EPL-2.0</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../../../KoenZomers.RingApi.snk" Link="KoenZomers.RingApi.snk" />
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
        <PackageReference Include="Polly" Version="8.8.0" />
        <PackageReference Include="SIPSorcery" Version="10.0.17" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../common/VideoForensics.Providers.Ring.Common.csproj" />
        <ProjectReference Include="../auth/VideoForensics.Providers.Ring.Auth.csproj" />
        <ProjectReference Include="../video/VideoForensics.Providers.Ring.Video.csproj" />
        <ProjectReference Include="../../../core/helpers/core.helpers/VideoForensics.Providers.Common.Helpers.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="VideoForensics.Providers.Ring.Core.Tests, " />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="tests/**" />
    </ItemGroup>

</Project>



