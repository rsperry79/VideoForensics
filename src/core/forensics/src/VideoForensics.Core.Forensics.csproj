<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>VideoForensics.Core.Forensics</RootNamespace>
        <SignAssembly>true</SignAssembly>
        <!-- Strong names are not validated on .NET (Core); this assembly is signed for legacy reasons but
             references unsigned assemblies (VideoForensics.Data.Common), which is harmless. -->
        <NoWarn>$(NoWarn);CS8002</NoWarn>
        <AssemblyOriginatorKeyFile>../../../../VideoForensics.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>VideoForensics.Core.Forensics</AssemblyName>
        <Company>Koen Zomers</Company>
        <Authors>Koen Zomers</Authors>
        <Description>Provider-agnostic forensic analysis, including live-view interference scoring.</Description>
        <Copyright>Koen Zomers</Copyright>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../../../VideoForensics.snk" Link="VideoForensics.snk" />
    </ItemGroup>

    <ItemGroup>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../providers/ring/common/src/VideoForensics.Providers.Ring.Common.csproj" />
        <ProjectReference Include="../../helpers/forensics/src/VideoForensics.Core.Helpers.Forensics.csproj" />
        <ProjectReference Include="../../../data/common/src/VideoForensics.Data.Common.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
    </ItemGroup>

</Project>
