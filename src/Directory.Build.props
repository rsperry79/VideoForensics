<Project>
    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <!--
          Static fallback used only if git isn't available (e.g. a source archive with no .git
          directory). SetApiVersionFromGit below overrides these for a real checkout. Projects
          must NOT re-declare Version/AssemblyVersion/FileVersion in their own PropertyGroup -
          that would freeze in this fallback at evaluation time, before the target below runs.
        -->
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
    </PropertyGroup>

    <!--
      Derives the assembly/package version from git history instead of a hand-maintained
      constant, so every build is traceable to the commit it came from:
        - AssemblyVersion/FileVersion (numeric): 1.0.0.<commit count>
        - Version (semver, used for the NuGet package): 1.0.0+<short hash>
    -->
    <Target Name="SetApiVersionFromGit" BeforeTargets="BeforeBuild;GetAssemblyVersion;GenerateNuspec">
        <Exec Command="git rev-list --count HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitCount" />
        </Exec>
        <Exec Command="git rev-parse --short HEAD" ConsoleToMSBuild="true" StandardOutputImportance="low" ContinueOnError="true">
            <Output TaskParameter="ConsoleOutput" PropertyName="GitCommitHash" />
        </Exec>
        <PropertyGroup Condition="'$(GitCommitCount)' != '' AND '$(GitCommitHash)' != ''">
            <AssemblyVersion>1.0.0.$(GitCommitCount)</AssemblyVersion>
            <FileVersion>1.0.0.$(GitCommitCount)</FileVersion>
            <Version>1.0.0+$(GitCommitHash)</Version>
        </PropertyGroup>
    </Target>
</Project>