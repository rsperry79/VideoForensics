<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <AssemblyName>VideoForensics.Hosting</AssemblyName>
        <RootNamespace>VideoForensics.Hosting</RootNamespace>
        <Authors>DV Victim Protection Team</Authors>
        <Description>Shared dependency-injection registration and background services for every VideoForensics host (console, MCP, MAUI, Web)</Description>
        <Copyright>2026</Copyright>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>

        <!-- Syncfusion license key sourced from the SYNCFUSION_LICENSE_KEY GitHub Actions secret at CI build/publish time
             (see release-installers.yml, publish-dev.yml, publish-testing.yml) via -p:SyncfusionLicenseKey=...
             Never committed to git - empty by default for local/dev builds, which fall back to today's
             existing unlicensed-dev-mode behavior. -->
        <SyncfusionLicenseKey Condition="'$(SyncfusionLicenseKey)' == ''"></SyncfusionLicenseKey>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="VideoForensics.Hosting.Tests" />
    </ItemGroup>

    <ItemGroup>
        <AssemblyMetadata Include="SyncfusionLicenseKey" Value="$(SyncfusionLicenseKey)" />
    </ItemGroup>

    <ItemGroup>
        <!-- FrameworkReference, not PackageReference: this project isn't Microsoft.NET.Sdk.Web, but
             it's always consumed by a host that already carries the ASP.NET Core shared framework
             (WebApp directly; console/MCP indirectly since they reference this project). On MAUI iOS/Android,
             the shared framework is not available, so this reference is conditional - the needed
             Microsoft.AspNetCore.DataProtection and Microsoft.Extensions.Http packages are provided
             separately for mobile builds. A PackageReference to the standalone Microsoft.AspNetCore.Http.Abstractions
             NuGet package (the old netstandard2.0-era compat package, last published at 2.3.x) gets
             copy-local'd into the publish output and overwrites the real v10.0.0.0 shared-framework
             assembly of the same filename, causing "Could not load file or assembly
             'Microsoft.AspNetCore.Http.Abstractions, Version=10.0.0.0...'" at runtime in a
             self-contained publish. FrameworkReference compiles against the shared framework's types
             without copy-locating a conflicting file. -->
        <FrameworkReference Include="Microsoft.AspNetCore.App" Condition="'$(BuildIOS)' != 'true' AND '$(BuildAndroid)' != 'true'" />
    </ItemGroup>

    <ItemGroup>
        <!-- Microsoft.Extensions.DependencyInjection.Abstractions, Microsoft.Extensions.Logging.Abstractions,
             Microsoft.Extensions.Http, Microsoft.AspNetCore.DataProtection.Abstractions, and
             Microsoft.Extensions.Identity.Core are all part of the Microsoft.AspNetCore.App shared
             framework brought in by the FrameworkReference above - an explicit PackageReference to
             them is redundant now (NU1510) and removed. For MAUI iOS/Android builds where the
             shared framework is not available, Microsoft.AspNetCore.DataProtection, Microsoft.Extensions.Http,
             Microsoft.AspNetCore.Http.Abstractions (for HttpContext, used by NetworkTierResolver.cs),
             and Microsoft.Extensions.Identity.Core (for PasswordHasher<T>, used by
             VideoForensicsHostingExtensions.cs) are provided as standalone packages. The
             version-conflict concern documented on the FrameworkReference does not apply here since that
             FrameworkReference is conditioned off whenever these packages are on. -->
        <PackageReference Include="CliWrap" Version="3.10.5" />
        <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
        <PackageReference Include="MailKit" Version="4.18.1" />
        <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
        <PackageReference Include="Microsoft.AspNetCore.DataProtection" Version="10.0.12" Condition="'$(BuildIOS)' == 'true' OR '$(BuildAndroid)' == 'true'" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.12" Condition="'$(BuildIOS)' == 'true' OR '$(BuildAndroid)' == 'true'" />
        <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.13" Condition="'$(BuildIOS)' == 'true' OR '$(BuildAndroid)' == 'true'" />
        <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" Condition="'$(BuildIOS)' == 'true' OR '$(BuildAndroid)' == 'true'" />
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\..\core\api\VideoForensics.Api.Contracts\VideoForensics.Api.Contracts.csproj" />
        <ProjectReference Include="..\..\common\VideoForensics.Client.Common\VideoForensics.Client.Common.csproj" />
        <ProjectReference Include="..\..\core\VideoForensics.Client.Core\VideoForensics.Client.Core.csproj" />
        <ProjectReference Include="..\..\ui\VideoForensics.Ui.Shared\VideoForensics.Ui.Shared.csproj" />
        <ProjectReference Include="..\..\..\core\core\core.telemetry\VideoForensics.Core.Telemetry.csproj" />
        <ProjectReference Include="..\..\..\core\providers\providers-common\VideoForensics.Providers.Common.csproj" />
        <ProjectReference Include="..\..\..\core\providers\providers-core\VideoForensics.Providers.Core.csproj" />
        <ProjectReference Include="..\..\..\providers\ring\provider\VideoForensics.Providers.Ring.csproj" />
        <ProjectReference Include="..\..\..\providers\uniview\provider\VideoForensics.Providers.Uniview.csproj" />
        <ProjectReference Include="..\..\..\providers\wyze\provider\VideoForensics.Providers.Wyze.csproj" />
        <ProjectReference Include="..\..\..\data\common\data.common\VideoForensics.Data.Common.csproj" />
        <ProjectReference Include="..\..\..\data\core\data.core\VideoForensics.Data.Core.csproj" />
        <ProjectReference Include="..\..\..\data\database\data.database\VideoForensics.Data.Database.csproj" />
        <ProjectReference Include="..\..\..\data\database\sqlite\data.database.sqlite\VideoForensics.Data.Database.Sqlite.csproj" />
    </ItemGroup>

</Project>
