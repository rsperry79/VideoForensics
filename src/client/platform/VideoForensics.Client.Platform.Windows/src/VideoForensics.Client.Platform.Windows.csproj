<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Windows-only: uses the registry. Pinned to net10.0-windows so Microsoft.Win32 APIs are not flagged as CA1416. -->
        <TargetFramework>net10.0-windows</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <AssemblyName>VideoForensics.Client.Platform.Windows</AssemblyName>
        <RootNamespace>VideoForensics.Client.Platform.Windows</RootNamespace>
        <Authors>DV Victim Protection Team</Authors>
        <Description>Windows-only client services (OneDrive and known-folder lookups) for the VideoForensics desktop client</Description>
        <Copyright>2026</Copyright>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="VideoForensics.Client.Platform.Windows.Tests" />
    </ItemGroup>

</Project>
