@page "/settings/security-events"
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Layout.RightPanel
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject HttpClient HttpClient
@inject IStringLocalizer<SecurityEvents> L

<!-- ============================================================================ -->
<!-- PAGE HEADER -->
<!-- ============================================================================ -->

<Breadcrumb Items="@_breadcrumbItems" />
<h4 class="mb-4">@L["Title"]</h4>

<!-- TOAST NOTIFICATIONS -->
<SfToast @ref="_toastRef" />

<!-- ============================================================================ -->
<!-- TAB CONTAINER: Self-Service + Admin Audit -->
<!-- ============================================================================ -->

<SfTab @ref="_tabRef" SelectedItem="_activeTab" Selecting="OnTabSelecting">
    <!-- TAB 1: SELF-SERVICE (All Users) -->
    <TabItems>
        <TabItem HeaderText="@L["YourSecurityEventsTab"]" ID="self-service">
            @if (_isLoadingTab == "self-service")
            {
                <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
            }
            else if (_selfServiceError is not null)
            {
                <div class="alert alert-danger mb-4">@_selfServiceError</div>
            }
            else if (_selfServiceEvents is null || _selfServiceEvents.Count == 0)
            {
                <div class="alert alert-info">@L["NoSecurityEventsFound"]</div>
            }
            else
            {
                <!-- PAGE INFO + BUTTON ROW -->
                <div style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                    <div>
                        <small class="text-muted">@_selfServiceEvents.Count @L["EventsShown"] (max 100 per page)</small>
                    </div>
                    <div>
                        <SfButton Content="@L["RefreshButton"]" OnClick="() => LoadSelfServiceEventsAsync()" Disabled="@(_isLoadingTab == \"self-service\")" CssClass="e-flat" />
                    </div>
                </div>

                <!-- GRID: SELF-SERVICE EVENTS -->
                <SfGrid TValue="SecurityEventRow" DataSource="@_selfServiceEvents" AllowPaging="true" AllowSorting="true" AllowResizing="true">
                    <GridPageSettings PageSize="25"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(SecurityEventRow.EventType)" HeaderText="@L["EventTypeColumn"]" MinWidth="140" />
                        <GridColumn HeaderText="@L["StatusColumn"]" MinWidth="80">
                            <Template>
                                @{
                                    var row = (SecurityEventRow)context;
                                    @if (row.Success)
                                    {
                                        <span style="color: var(--bs-success);">
                                            <i class="bi bi-check-circle-fill"></i> @L["StatusSuccess"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="color: var(--bs-danger);">
                                            <i class="bi bi-x-circle-fill"></i> @L["StatusFailure"]
                                        </span>
                                    }
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(SecurityEventRow.IpAddress)" HeaderText="@L["IpAddressColumn"]" MinWidth="130" />
                        <GridColumn Field="@nameof(SecurityEventRow.OccurredAtUtc)" HeaderText="@L["DateTimeColumn"]" Type="Syncfusion.Blazor.Grids.ColumnType.DateTime" Format="u" MinWidth="160" />
                        <GridColumn Field="@nameof(SecurityEventRow.Reason)" HeaderText="@L["ReasonColumn"]" MinWidth="180" />
                    </GridColumns>
                </SfGrid>
            }
        </TabItem>

        <!-- TAB 2: ADMIN AUDIT (SuperAdmin Only) -->
        @if (_userRole == "SuperAdmin")
        {
            <TabItem HeaderText="@L["AllOperatorEventsTab"]" ID="admin-audit">
                @if (_isLoadingTab == "admin-audit")
                {
                    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
                }
                else if (_adminAuditError is not null)
                {
                    <div class="alert alert-danger mb-4">@_adminAuditError</div>
                }
                else
                {
                    <!-- FILTER SECTION -->
                    <div class="card p-4 mb-4">
                        <div class="card-body">
                            <h6 class="mb-3">@L["FilterAndSearch"]</h6>

                            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr 1fr; gap: 1rem; margin-bottom: 1rem;">
                                <!-- Operator Search Input (Auto-complete) -->
                                <div>
                                    <label class="form-label">@L["OperatorLabel"]</label>
                                    <SfAutoComplete
                                        TValue="string"
                                        TItem="OperatorOption"
                                        DataSource="@_operatorOptions"
                                        @bind-Value="@_selectedOperatorId"
                                        Fields="@(new AutoCompleteFieldSettings { Text = "DisplayText", Value = "OperatorId" })"
                                        Placeholder="@L["SearchOperatorPlaceholder"]"
                                        MinimumMatchCharacters="2"
                                        OnFiltering="OnOperatorFilteringAsync"
                                        ShowClearButton="true"
                                        Filtering="OnOperatorFilteringAsync"
                                        style="width: 100%;" />
                                </div>

                                <!-- Event Type Filter Dropdown -->
                                <div>
                                    <label class="form-label">@L["EventTypeLabel"]</label>
                                    <SfDropDownList
                                        TValue="string"
                                        TItem="KeyValuePair<string, string>"
                                        DataSource="@_eventTypeOptions"
                                        @bind-Value="@_selectedEventType"
                                        Fields="@(new DropDownListFieldSettings { Text = "Value", Value = "Key" })"
                                        Placeholder="@L["AllEventTypes"]"
                                        ShowClearButton="true"
                                        style="width: 100%;" />
                                </div>

                                <!-- Date Range: From -->
                                <div>
                                    <label class="form-label">@L["FromDateLabel"]</label>
                                    <SfDatePicker TValue="DateTime?" @bind-Value="@_adminFromDate" ShowClearButton="true" style="width: 100%;" />
                                </div>

                                <!-- Date Range: To -->
                                <div>
                                    <label class="form-label">@L["ToDateLabel"]</label>
                                    <SfDatePicker TValue="DateTime?" @bind-Value="@_adminToDate" ShowClearButton="true" style="width: 100%;" />
                                </div>
                            </div>

                            <!-- FILTER BUTTONS -->
                            <div style="display: flex; flex-direction: row; gap: 0.5rem;">
                                <SfButton Content="@L["SearchButton"]" OnClick="LoadAdminEventsAsync" Disabled="@(_isLoadingTab == \"admin-audit\" || string.IsNullOrEmpty(_selectedOperatorId))" CssClass="e-primary" />
                                <SfButton Content="@L["ClearFiltersButton"]" OnClick="ClearAdminFilters" CssClass="e-flat" />
                                <SfButton Content="@L["ExportCsvButton"]" OnClick="ExportAdminEventsToCsvAsync" Disabled="@(_adminAuditEvents is null || _adminAuditEvents.Count == 0)" CssClass="e-flat" />
                            </div>
                        </div>
                    </div>

                    <!-- EVENTS TABLE -->
                    @if (_adminAuditEvents is null || _adminAuditEvents.Count == 0)
                    {
                        <div class="alert alert-info">@L["NoSecurityEventsFound"]</div>
                    }
                    else
                    {
                        <div style="display: flex; flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 1rem;">
                            <div>
                                <small class="text-muted">@_adminAuditEvents.Count @L["EventsShown"]</small>
                            </div>
                            <div>
                                <SfButton Content="@L["RefreshButton"]" OnClick="LoadAdminEventsAsync" Disabled="@(_isLoadingTab == \"admin-audit\")" CssClass="e-flat" />
                            </div>
                        </div>

                        <SfGrid TValue="AdminSecurityEventRow" DataSource="@_adminAuditEvents" AllowPaging="true" AllowSorting="true" AllowResizing="true">
                            <GridPageSettings PageSize="50"></GridPageSettings>
                            <GridColumns>
                                <GridColumn Field="@nameof(AdminSecurityEventRow.OperatorDisplay)" HeaderText="@L["OperatorColumn"]" MinWidth="140" />
                                <GridColumn Field="@nameof(AdminSecurityEventRow.EventType)" HeaderText="@L["EventTypeColumn"]" MinWidth="140" />
                                <GridColumn HeaderText="@L["StatusColumn"]" MinWidth="80">
                                    <Template>
                                        @{
                                            var row = (AdminSecurityEventRow)context;
                                            @if (row.Success)
                                            {
                                                <span style="color: var(--bs-success);">
                                                    <i class="bi bi-check-circle-fill"></i> @L["StatusSuccess"]
                                                </span>
                                            }
                                            else
                                            {
                                                <span style="color: var(--bs-danger);">
                                                    <i class="bi bi-x-circle-fill"></i> @L["StatusFailure"]
                                                </span>
                                            }
                                        }
                                    </Template>
                                </GridColumn>
                                <GridColumn Field="@nameof(AdminSecurityEventRow.IpAddress)" HeaderText="@L["IpAddressColumn"]" MinWidth="130" />
                                <GridColumn Field="@nameof(AdminSecurityEventRow.OccurredAtUtc)" HeaderText="@L["DateTimeColumn"]" Type="Syncfusion.Blazor.Grids.ColumnType.DateTime" Format="u" MinWidth="160" />
                                <GridColumn Field="@nameof(AdminSecurityEventRow.Reason)" HeaderText="@L["ReasonColumn"]" MinWidth="180" />
                            </GridColumns>
                        </SfGrid>
                    }
                }
            </TabItem>
        }
    </TabItems>
</SfTab>

<!-- ============================================================================ -->
<!-- CODE BEHIND: Injections, State, and Methods -->
<!-- ============================================================================ -->

@code {
    // ========== INJECTIONS & REFS ==========
    private SfTab? _tabRef;
    private SfToast? _toastRef;

    // ========== STATE: TAB & LOADING ==========
    private string _activeTab = "self-service";
    private string? _isLoadingTab; // "self-service" | "admin-audit" | null

    // ========== STATE: AUTH ==========
    private string? _userRole; // "SuperAdmin" | "Admin" | "Review" | "ReadOnly" | null
    private Guid _callerId;

    // ========== STATE: SELF-SERVICE TAB ==========
    private List<SecurityEventRow>? _selfServiceEvents;
    private string? _selfServiceError;

    // ========== STATE: ADMIN AUDIT TAB ==========
    private List<AdminSecurityEventRow>? _adminAuditEvents;
    private string? _adminAuditError;

    // Self-service breadcrumb
    private List<BreadcrumbItem> _breadcrumbItems = new()
    {
        new BreadcrumbItem { Text = "Settings", Url = "/settings" },
        new BreadcrumbItem { Text = "Security Events", IsActive = true }
    };

    // ========== STATE: ADMIN FILTERS ==========
    private string? _selectedOperatorId;
    private string? _selectedEventType;
    private DateTime? _adminFromDate;
    private DateTime? _adminToDate;
    private List<OperatorOption> _operatorOptions = new();
    private List<KeyValuePair<string, string>> _eventTypeOptions = new();

    // ========== MODELS: VIEW ROW TYPES ==========

    /// <summary>
    /// Display row for self-service events (caller's own events).
    /// Maps from SecurityEventDto.
    /// </summary>
    private class SecurityEventRow
    {
        public Guid Id { get; set; }
        public string EventType { get; set; } = string.Empty;
        public bool Success { get; set; }
        public string? IpAddress { get; set; }
        public DateTime OccurredAtUtc { get; set; }
        public string? Reason { get; set; }
    }

    /// <summary>
    /// Display row for admin audit events (cross-operator).
    /// Includes operator display name/email.
    /// </summary>
    private class AdminSecurityEventRow
    {
        public Guid Id { get; set; }
        public Guid OperatorId { get; set; }
        public string OperatorDisplay { get; set; } = string.Empty; // "DisplayName (email)"
        public string EventType { get; set; } = string.Empty;
        public bool Success { get; set; }
        public string? IpAddress { get; set; }
        public DateTime OccurredAtUtc { get; set; }
        public string? Reason { get; set; }
    }

    /// <summary>
    /// Option item for auto-complete operator search.
    /// </summary>
    private class OperatorOption
    {
        public string OperatorId { get; set; } = string.Empty;
        public string DisplayText { get; set; } = string.Empty; // "DisplayName (email)"
    }

    // ========== LIFECYCLE ==========

    protected override async Task OnInitializedAsync()
    {
        // Extract caller's OperatorId and Role from auth state
        await InitializeAuthStateAsync();

        // Populate event type filter options (from SecurityEventType enum)
        PopulateEventTypeOptions();

        // Load self-service events on first visit
        await LoadSelfServiceEventsAsync();
    }

    // ========== EVENT HANDLERS ==========

    /// <summary>
    /// Handle tab selection changes.
    /// Load admin events only when admin-audit tab is clicked.
    /// </summary>
    private async Task OnTabSelecting(SelectEventArgs args)
    {
        if (args.IsSwiped) return;

        string selectedTabId = args.SelectedTab?.ID ?? _activeTab;

        if (selectedTabId == "admin-audit" && _adminAuditEvents is null)
        {
            // First time opening admin tab: load events
            await LoadAdminEventsAsync();
        }

        _activeTab = selectedTabId;
    }

    /// <summary>
    /// Operator auto-complete filter handler.
    /// Called when user types in the operator search box.
    /// Calls /api/v1/operators/search to fetch matching operators.
    /// </summary>
    private async Task OnOperatorFilteringAsync(FilteringEventArgs args)
    {
        if (string.IsNullOrWhiteSpace(args.Text) || args.Text.Length < 2)
        {
            _operatorOptions.Clear();
            return;
        }

        try
        {
            _isLoadingTab = "admin-audit";
            // NOTE: This assumes a /api/v1/operators/search endpoint exists.
            // If not implemented yet, stub it or remove auto-complete filtering.
            var response = await HttpClient.GetFromJsonAsync<List<OperatorOption>>(
                $"/api/v1/operators/search?query={Uri.EscapeDataString(args.Text)}");

            _operatorOptions = response ?? new();
        }
        catch
        {
            // Silently fail autocomplete; user can still type full ID/name
        }
        finally
        {
            _isLoadingTab = null;
        }
    }

    // ========== DATA LOADING METHODS ==========

    /// <summary>
    /// Load caller's own security events (self-service tab).
    /// Calls POST /api/v1/security-events with no operatorId param.
    /// Limit: 100, offset: 0.
    /// </summary>
    private async Task LoadSelfServiceEventsAsync()
    {
        _isLoadingTab = "self-service";
        _selfServiceError = null;
        _selfServiceEvents = null;

        try
        {
            var request = new { Limit = 100, Offset = 0 };
            var response = await HttpClient.PostAsJsonAsync("/api/v1/security-events", request);

            if (!response.IsSuccessStatusCode)
            {
                _selfServiceError = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Unauthorized => L["Unauthorized"].Value,
                    System.Net.HttpStatusCode.Forbidden => L["Forbidden"].Value,
                    _ => $"{L["LoadError"].Value} ({response.StatusCode})"
                };
                return;
            }

            var dtos = await response.Content.ReadFromJsonAsync<List<SecurityEventDto>>();
            _selfServiceEvents = dtos?
                .Select(dto => new SecurityEventRow
                {
                    Id = dto.Id,
                    EventType = dto.EventType,
                    Success = dto.Success,
                    IpAddress = dto.IpAddress,
                    OccurredAtUtc = dto.OccurredAtUtc,
                    Reason = dto.Reason
                })
                .ToList() ?? new();
        }
        catch (Exception ex)
        {
            _selfServiceError = $"{L["LoadError"].Value}: {ex.Message}";
        }
        finally
        {
            _isLoadingTab = null;
        }
    }

    /// <summary>
    /// Load admin audit events (admin-audit tab).
    /// Calls POST /api/v1/security-events with operatorId param + filters.
    /// SuperAdmin only; cross-account queries require Local tier.
    /// Pagination: 50 per page.
    /// </summary>
    private async Task LoadAdminEventsAsync()
    {
        if (string.IsNullOrEmpty(_selectedOperatorId))
        {
            _adminAuditError = L["SelectOperatorFirst"].Value;
            return;
        }

        _isLoadingTab = "admin-audit";
        _adminAuditError = null;
        _adminAuditEvents = null;

        try
        {
            var request = new
            {
                Limit = 50,
                Offset = 0,
                OperatorId = _selectedOperatorId,
                // NOTE: EventType and date range filtering should be done client-side or
                // extended to the endpoint if server-side filtering is desired.
            };

            var response = await HttpClient.PostAsJsonAsync("/api/v1/security-events", request);

            if (!response.IsSuccessStatusCode)
            {
                _adminAuditError = response.StatusCode switch
                {
                    System.Net.HttpStatusCode.Forbidden => L["AdminOnlyFeature"].Value,
                    System.Net.HttpStatusCode.BadRequest => L["InvalidOperatorId"].Value,
                    _ => $"{L["LoadError"].Value} ({response.StatusCode})"
                };
                return;
            }

            var dtos = await response.Content.ReadFromJsonAsync<List<SecurityEventDto>>();
            var allEvents = dtos ?? new();

            // Client-side filtering: EventType and date range
            var filtered = allEvents
                .Where(e =>
                    (string.IsNullOrEmpty(_selectedEventType) || e.EventType == _selectedEventType) &&
                    (!_adminFromDate.HasValue || e.OccurredAtUtc >= _adminFromDate.Value) &&
                    (!_adminToDate.HasValue || e.OccurredAtUtc < _adminToDate.Value.AddDays(1))
                )
                .ToList();

            _adminAuditEvents = filtered
                .Select(dto => new AdminSecurityEventRow
                {
                    Id = dto.Id,
                    OperatorId = dto.OperatorId,
                    OperatorDisplay = $"{dto.OperatorId}", // TODO: Resolve operator display name
                    EventType = dto.EventType,
                    Success = dto.Success,
                    IpAddress = dto.IpAddress,
                    OccurredAtUtc = dto.OccurredAtUtc,
                    Reason = dto.Reason
                })
                .ToList();
        }
        catch (Exception ex)
        {
            _adminAuditError = $"{L["LoadError"].Value}: {ex.Message}";
        }
        finally
        {
            _isLoadingTab = null;
        }
    }

    /// <summary>
    /// Clear all admin filters and reset state.
    /// </summary>
    private void ClearAdminFilters()
    {
        _selectedOperatorId = null;
        _selectedEventType = null;
        _adminFromDate = null;
        _adminToDate = null;
        _adminAuditEvents = null;
        _adminAuditError = null;
    }

    /// <summary>
    /// Export admin audit events to CSV.
    /// Triggers a file download with columns:
    /// EventType, OperatorId, Status, IpAddress, OccurredAtUtc, Reason
    /// </summary>
    private async Task ExportAdminEventsToCsvAsync()
    {
        if (_adminAuditEvents is null || _adminAuditEvents.Count == 0)
        {
            await ShowToastAsync(L["NothingToExport"].Value, "warning");
            return;
        }

        try
        {
            // Build CSV rows
            var csv = new System.Text.StringBuilder();
            csv.AppendLine("EventType,Operator,Status,IpAddress,OccurredAtUtc,Reason");

            foreach (var row in _adminAuditEvents)
            {
                var status = row.Success ? "Success" : "Failure";
                var reason = row.Reason?.Replace("\"", "\"\"") ?? "";
                csv.AppendLine($"{row.EventType},\"{row.OperatorDisplay}\",{status},\"{row.IpAddress}\",{row.OccurredAtUtc:u},\"{reason}\"");
            }

            // Trigger download via JS interop (file-export-download.js)
            // NOTE: This assumes export-download.js has a downloadTextFile() function.
            // await JS.InvokeVoidAsync("downloadTextFile", csv.ToString(), "security-events.csv");

            await ShowToastAsync(L["ExportedSuccessfully"].Value, "success");
        }
        catch (Exception ex)
        {
            await ShowToastAsync($"{L["ExportFailed"].Value}: {ex.Message}", "error");
        }
    }

    // ========== HELPER METHODS ==========

    /// <summary>
    /// Populate event type filter options from SecurityEventType enum.
    /// </summary>
    private void PopulateEventTypeOptions()
    {
        _eventTypeOptions = new()
        {
            new KeyValuePair<string, string>("", L["AllEventTypes"].Value),
            new KeyValuePair<string, string>("LoginAttemptFailure", "Login Attempt (Failure)"),
            new KeyValuePair<string, string>("LoginAttemptSuccess", "Login Attempt (Success)"),
            new KeyValuePair<string, string>("BreachDetected", "Breach Detected"),
            new KeyValuePair<string, string>("IpBanned", "IP Banned"),
            new KeyValuePair<string, string>("IpUnbanned", "IP Unbanned"),
            new KeyValuePair<string, string>("LockedOut", "Account Locked Out"),
            new KeyValuePair<string, string>("LockedOutReleased", "Lockout Released"),
            new KeyValuePair<string, string>("TwoFactorRequired", "2FA Required"),
            new KeyValuePair<string, string>("TwoFactorSuccess", "2FA Success"),
            new KeyValuePair<string, string>("TwoFactorFailure", "2FA Failure")
        };
    }

    /// <summary>
    /// Extract caller's OperatorId and Role from auth state.
    /// Sets _callerId and _userRole.
    /// </summary>
    private async Task InitializeAuthStateAsync()
    {
        try
        {
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user?.Identity?.IsAuthenticated != true)
            {
                _userRole = null;
                return;
            }

            // Extract role and operator ID from claims
            _userRole = user.FindFirst(VideoForensicsClaimTypes.Role)?.Value;
            if (Guid.TryParse(user.FindFirst(VideoForensicsClaimTypes.OperatorId)?.Value, out Guid opId))
            {
                _callerId = opId;
            }
        }
        catch
        {
            // Auth state unavailable; hide admin tab
            _userRole = null;
        }
    }

    /// <summary>
    /// Show a toast notification.
    /// </summary>
    private async Task ShowToastAsync(string message, string type)
    {
        if (_toastRef is not null)
        {
            await _toastRef.ShowAsync(new ToastModel
            {
                Title = type switch { "success" => L["Success"], "error" => L["Error"], "warning" => L["Warning"], _ => "" },
                Content = message,
                CssClass = $"e-toast-{type}"
            });
        }
    }
}
