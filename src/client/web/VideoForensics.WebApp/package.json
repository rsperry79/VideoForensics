    "pretest:js": "npm run build:ts",
    "test:js": "node scripts/run-tool.mjs test",
    "lint": "node scripts/run-tool.mjs lint",
    "check": "node scripts/check-js.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
