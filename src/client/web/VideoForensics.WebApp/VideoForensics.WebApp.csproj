<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <AssemblyName>VideoForensics.WebApp</AssemblyName>
    <RootNamespace>VideoForensics.WebApp</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>DV Victim Protection Team</Authors>
    <Description>ASP.NET Core Blazor Server host for VideoForensics</Description>
    <Copyright>2026</Copyright>
    <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast" Version="0.27.0" />
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
    <!-- WebAuthn/passkey attestation+assertion verification (plan §5.1/§6). Fido2NetLib does the
         CBOR/COSE parsing and attestation-statement cryptographic verification - explicitly called
         out in the plan as a "looks right and isn't" risk area not to hand-roll. -->
    <PackageReference Include="Fido2" Version="4.0.1" />
    <PackageReference Include="Fido2.AspNet" Version="4.0.1" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ui\VideoForensics.Ui.Shared\VideoForensics.Ui.Shared.csproj" />
    <ProjectReference Include="..\..\host\VideoForensics.Hosting\VideoForensics.Hosting.csproj" />
  </ItemGroup>

</Project>
