{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Server.Kestrel": "Error"
    }
  },
  "MediaAnalysis": {
    "Hemisphere": "Northern"
  },
  "ScheduledTasks": {
    "EnabledProviders": [ "Ring" ],
    "TickSeconds": 60,
    "InitialSyncEnabled": false
  },
  "AllowedHosts": "*",
  "Acme": {
    "UseStaging": true
  }
}
