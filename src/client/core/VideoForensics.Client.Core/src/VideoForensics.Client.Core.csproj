<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <AssemblyName>VideoForensics.Client.Core</AssemblyName>
        <RootNamespace>VideoForensics.Client.Core</RootNamespace>
        <Authors>DV Victim Protection Team</Authors>
        <Description>Service implementations shared by the VideoForensics console client and MCP server</Description>
        <Copyright>2026</Copyright>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>

        <!-- Syncfusion license key sourced from the SYNCFUSION_LICENSE_KEY GitHub Actions secret at CI build/publish time
             (see release-installers.yml, publish-dev.yml, publish-testing.yml) via -p:SyncfusionLicenseKey=...
             Never committed to git - empty by default for local/dev builds, which fall back to today's
             existing unlicensed-dev-mode behavior. Embedded here (not in Hosting) so every host that registers
             the license through SyncfusionLicenseRegistrar carries the same baked-in key. -->
        <SyncfusionLicenseKey Condition="'$(SyncfusionLicenseKey)' == ''"></SyncfusionLicenseKey>
    </PropertyGroup>

    <ItemGroup>
        <AssemblyMetadata Include="SyncfusionLicenseKey" Value="$(SyncfusionLicenseKey)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
        <PackageReference Include="NodaTime" Version="3.3.5" />
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
        <PackageReference Include="Syncfusion.Licensing" Version="35.1.40" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="VideoForensics" />
        <InternalsVisibleTo Include="VideoForensics.Client.MCP" />
        <InternalsVisibleTo Include="VideoForensics.Hosting" />
        <InternalsVisibleTo Include="VideoForensics.Client.Core.Tests" />
        <InternalsVisibleTo Include="VideoForensics.Providers.Ring.Tests" />
        <!-- Lets Moq's Castle DynamicProxy build a mock of ILogger<T> closed over an internal T
             (e.g. Mock<ILogger<EvidenceExportOrchestrator>>) - without this, proxy generation
             fails with "type ... is not accessible" because Castle's generated assembly is
             strong-named and can't otherwise see this assembly's internals. -->
        <InternalsVisibleTo Include="DynamicProxyGenAssembly2, " />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../common/VideoForensics.Client.Common/src/VideoForensics.Client.Common.csproj" />
        <ProjectReference Include="../../../../core/api/src/VideoForensics.Core.Api.Contracts.csproj" />
        <ProjectReference Include="../../../../data/common/src/VideoForensics.Data.Common.csproj" />
        <ProjectReference Include="../../../../data/core/src/VideoForensics.Data.Core.csproj" />
        <ProjectReference Include="../../../../core/providers/common/src/VideoForensics.Core.Providers.Common.csproj" />
        <ProjectReference Include="../../../../core/providers/core/src/VideoForensics.Core.Providers.Core.csproj" />
        <ProjectReference Include="../../../../providers/ring/provider/src/VideoForensics.Providers.Ring.csproj" />
        <ProjectReference Include="../../../../core/forensics/src/VideoForensics.Core.Forensics.csproj" />
        <ProjectReference Include="../../../../providers/ring/utils/src/VideoForensics.Providers.Ring.Utils.csproj" />
    </ItemGroup>

</Project>
