@page "/analyze/reports"
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ForensicReports> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToViewReports"]
    </div>
}
else
{
    <PageRightPanelContent>
        <div class="right-panel-section">
            <span>@L["Filters"]</span>
            <SfDropDownList TValue="string" TItem="KeyValuePair<string,string>" @bind-Value="_selectedDeviceId" DataSource="@DeviceOptions"
                Placeholder="@L["AllDevices"]" class="w-100 mt-2" Change="OnDeviceSelectionChanged">
                <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
            </SfDropDownList>
            <small class="mt-3">@L["FromDate"]</small>
            <SfDatePicker TValue="DateTime" @bind-Value="_fromDate" ValueChange="RunReportAsync" CssClass="w-100" />
            <small class="mt-2">@L["ToDate"]</small>
            <SfDatePicker TValue="DateTime" @bind-Value="_toDate" ValueChange="RunReportAsync" CssClass="w-100" />
            <SfButton Content="@L["RunReport"]" OnClick="RunReportAsync" CssClass="e-primary mt-3 w-100" />
        </div>

    </PageRightPanelContent>

    @if (_report is not null)
    {
        <h5 class="mt-4 mb-2">@L["EvidenceItems"]</h5>
        @if (_report.EvidenceItems.Count == 0)
        {
            <span>@L["NoEvidenceItems"]</span>
        }
        else
        {
            <SfGrid TValue="MediaItem" DataSource="@_filteredEvidenceItems" AllowSorting="true" AllowPaging="true" AllowFiltering="true" AllowResizing="true">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn HeaderText="@L["ColEvidenceId"]" MinWidth="100">
                        <Template>
                            @{
                                var item = (MediaItem)context;
                                @(item.Id.ToString("N")[..8])
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColDeviceId"]" MinWidth="100">
                        <Template>
                            @{
                                var item = (MediaItem)context;
                                var deviceName = _devices.FirstOrDefault(d => d.Id == item.DeviceId)?.Name ?? item.DeviceId.ToString("N")[..8];
                                @deviceName
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(MediaItem.FileName)" HeaderText="@L["ColFileName"]" MinWidth="100" />
                    <GridColumn Field="@nameof(MediaItem.MediaFormat)" HeaderText="@L["ColFormat"]" MinWidth="100" />
                </GridColumns>
            </SfGrid>
        }

        <h5 class="mt-4 mb-2">@L["AnomalousHealthSnapshots"]</h5>
        @if (_report.AnomalousHealthSnapshots.Count == 0)
        {
            <span>@L["NoAnomalousHealthSnapshots"]</span>
        }
        else
        {
            <SfGrid TValue="DeviceHealth" DataSource="@_filteredAnomalousHealthSnapshots" AllowSorting="true" AllowPaging="true" AllowFiltering="true" AllowResizing="true">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(DeviceHealth.CapturedAtUtc)" HeaderText="@L["ColCapturedAt"]" MinWidth="100" />
                    <GridColumn HeaderText="@L["ColDeviceId"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceHealth)context;
                                var deviceName = _devices.FirstOrDefault(d => d.Id == snapshot.DeviceId)?.Name ?? snapshot.DeviceId.ToString("N")[..8];
                                @deviceName
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColConnected"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceHealth)context;
                                @(snapshot.IsOnline?.ToString() ?? "-")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColBatteryPercent"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceHealth)context;
                                @(snapshot.BatteryPercentage?.ToString() ?? "-")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColRssi"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceHealth)context;
                                @(snapshot.WifiSignalRssi?.ToString() ?? "-")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColWifi"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceHealth)context;
                                @(snapshot.WifiName ?? "-")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColFirmware"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceHealth)context;
                                @(snapshot.FirmwareVersion ?? "-")
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        }

        <h5 class="mt-4 mb-2">@L["SignificantActions"]</h5>
        @if (_report.SignificantActions.Count == 0)
        {
            <span>@L["NoSignificantActions"]</span>
        }
        else
        {
            <SfGrid TValue="ActionLogEntry" DataSource="@_filteredSignificantActions" AllowSorting="true" AllowPaging="true" AllowFiltering="true" AllowResizing="true">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(ActionLogEntry.Actor)" HeaderText="@L["ColActor"]" MinWidth="100" />
                    <GridColumn Field="@nameof(ActionLogEntry.Action)" HeaderText="@L["ColAction"]" MinWidth="100" />
                    <GridColumn Field="@nameof(ActionLogEntry.EntityType)" HeaderText="@L["ColEntityType"]" MinWidth="100" />
                    <GridColumn Field="@nameof(ActionLogEntry.TimestampUtc)" HeaderText="@L["ColTimestamp"]" MinWidth="100" />
                </GridColumns>
            </SfGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private ForensicAnalysisReport? _report;
    private IEnumerable<MediaItem> _filteredEvidenceItems = new List<MediaItem>();
    private IEnumerable<DeviceHealth> _filteredAnomalousHealthSnapshots = new List<DeviceHealth>();
    private IEnumerable<ActionLogEntry> _filteredSignificantActions = new List<ActionLogEntry>();

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildForensicAnalysisReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);

        if (_report is not null)
        {
            _filteredEvidenceItems = _report.EvidenceItems;
            _filteredAnomalousHealthSnapshots = _report.AnomalousHealthSnapshots;
            _filteredSignificantActions = _report.SignificantActions;
        }
    }

    private async Task OnDeviceSelectionChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        await RunReportAsync();
    }
}
