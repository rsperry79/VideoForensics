@page "/analyze/reports"
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Forensic Analysis Report</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        You are not signed in. <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="Sign in" /> to view forensic reports.
    </RadzenAlert>
}
else
{
    <RadzenStack>
        <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceId" Data="@DeviceOptions"
            TextProperty="Value" ValueProperty="Key" Placeholder="(All devices)" />
        <RadzenStack Orientation="Orientation.Horizontal">
            <input type="date" @bind="_fromDate" />
            <input type="date" @bind="_toDate" />
            <RadzenButton Text="Run Report" Click="RunReportAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </RadzenStack>
    </RadzenStack>

    @if (_report is not null)
    {
        @if (!string.IsNullOrWhiteSpace(_report.Summary))
        {
            <RadzenText>@_report.Summary</RadzenText>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Evidence Items</RadzenText>
        @if (_report.EvidenceItems.Count == 0)
        {
            <RadzenText>No evidence items found in this range.</RadzenText>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Evidence ID</th>
                        <th>Device ID</th>
                        <th>File Name</th>
                        <th>Format</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _report.EvidenceItems)
                    {
                        <tr>
                            <td>@item.Id.ToString("N")[..8]</td>
                            <td>@item.DeviceId.ToString("N")[..8]</td>
                            <td>@item.FileName</td>
                            <td>@item.MediaFormat</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Anomalous Health Snapshots</RadzenText>
        @if (_report.AnomalousHealthSnapshots.Count == 0)
        {
            <RadzenText>No anomalous health snapshots found in this range.</RadzenText>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Captured At</th>
                        <th>Device ID</th>
                        <th>Connected</th>
                        <th>Battery %</th>
                        <th>RSSI</th>
                        <th>Wifi</th>
                        <th>Firmware</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var snapshot in _report.AnomalousHealthSnapshots)
                    {
                        <tr>
                            <td>@snapshot.CapturedAtUtc</td>
                            <td>@(snapshot.DeviceId?.ToString("N")[..8] ?? "-")</td>
                            <td>@(snapshot.Connected?.ToString() ?? "-")</td>
                            <td>@(snapshot.BatteryPercentage?.ToString() ?? "-")</td>
                            <td>@(snapshot.Rssi?.ToString() ?? "-")</td>
                            <td>@(snapshot.WifiName ?? "-")</td>
                            <td>@(snapshot.FirmwareVersion ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Significant Actions</RadzenText>
        @if (_report.SignificantActions.Count == 0)
        {
            <RadzenText>No significant actions found in this range.</RadzenText>
        }
        else
        {
            <table>
                <thead>
                    <tr>
                        <th>Actor</th>
                        <th>Action</th>
                        <th>Entity Type</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var action in _report.SignificantActions)
                    {
                        <tr>
                            <td>@action.Actor</td>
                            <td>@action.Action</td>
                            <td>@action.EntityType</td>
                            <td>@action.TimestampUtc</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private ForensicAnalysisReport? _report;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildForensicAnalysisReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
