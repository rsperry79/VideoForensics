@page "/analyze/reports"
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ForensicReports> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        @L["NotSignedIn"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="@L["SignIn"]" /> @L["SignInToViewReports"]
    </RadzenAlert>
}
else
{
    <RadzenStack>
        <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceId" Data="@DeviceOptions"
            TextProperty="Value" ValueProperty="Key" Placeholder="@L["AllDevices"]" />
        <RadzenStack Orientation="Orientation.Horizontal">
            <input type="date" @bind="_fromDate" />
            <input type="date" @bind="_toDate" />
            <RadzenButton Text="@L["RunReport"]" Click="RunReportAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </RadzenStack>
    </RadzenStack>

    @if (_report is not null)
    {
        @if (!string.IsNullOrWhiteSpace(_report.Summary))
        {
            <RadzenText>@_report.Summary</RadzenText>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["EvidenceItems"]</RadzenText>
        @if (_report.EvidenceItems.Count == 0)
        {
            <RadzenText>@L["NoEvidenceItems"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_evidenceItemsFilter" TItem="MediaItem" Data="@_report.EvidenceItems" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="Id" Title="@L["ColEvidenceId"]" />
                    <RadzenDataFilterProperty Property="DeviceId" Title="@L["ColDeviceId"]" />
                    <RadzenDataFilterProperty Property="FileName" Title="@L["ColFileName"]" />
                    <RadzenDataFilterProperty Property="MediaFormat" Title="@L["ColFormat"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="MediaItem" Data="@_evidenceItemsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="MediaItem" Title="@L["ColEvidenceId"]">
                        <Template Context="item">@item.Id.ToString("N")[..8]</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MediaItem" Title="@L["ColDeviceId"]">
                        <Template Context="item">@item.DeviceId.ToString("N")[..8]</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MediaItem" Property="FileName" Title="@L["ColFileName"]" />
                    <RadzenDataGridColumn TItem="MediaItem" Property="MediaFormat" Title="@L["ColFormat"]" />
                </Columns>
            </RadzenDataGrid>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["AnomalousHealthSnapshots"]</RadzenText>
        @if (_report.AnomalousHealthSnapshots.Count == 0)
        {
            <RadzenText>@L["NoAnomalousHealthSnapshots"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_anomalousHealthSnapshotsFilter" TItem="DeviceHealthSnapshot" Data="@_report.AnomalousHealthSnapshots" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="CapturedAtUtc" Title="@L["ColCapturedAt"]" />
                    <RadzenDataFilterProperty Property="DeviceId" Title="@L["ColDeviceId"]" />
                    <RadzenDataFilterProperty Property="Connected" Title="@L["ColConnected"]" />
                    <RadzenDataFilterProperty Property="BatteryPercentage" Title="@L["ColBatteryPercent"]" />
                    <RadzenDataFilterProperty Property="Rssi" Title="@L["ColRssi"]" />
                    <RadzenDataFilterProperty Property="WifiName" Title="@L["ColWifi"]" />
                    <RadzenDataFilterProperty Property="FirmwareVersion" Title="@L["ColFirmware"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="DeviceHealthSnapshot" Data="@_anomalousHealthSnapshotsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Property="CapturedAtUtc" Title="@L["ColCapturedAt"]" />
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="@L["ColDeviceId"]">
                        <Template Context="snapshot">@(snapshot.DeviceId?.ToString("N")[..8] ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="@L["ColConnected"]">
                        <Template Context="snapshot">@(snapshot.Connected?.ToString() ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="@L["ColBatteryPercent"]">
                        <Template Context="snapshot">@(snapshot.BatteryPercentage?.ToString() ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="@L["ColRssi"]">
                        <Template Context="snapshot">@(snapshot.Rssi?.ToString() ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="@L["ColWifi"]">
                        <Template Context="snapshot">@(snapshot.WifiName ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="@L["ColFirmware"]">
                        <Template Context="snapshot">@(snapshot.FirmwareVersion ?? "-")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["SignificantActions"]</RadzenText>
        @if (_report.SignificantActions.Count == 0)
        {
            <RadzenText>@L["NoSignificantActions"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_significantActionsFilter" TItem="ActionLogEntry" Data="@_report.SignificantActions" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="Actor" Title="@L["ColActor"]" />
                    <RadzenDataFilterProperty Property="Action" Title="@L["ColAction"]" />
                    <RadzenDataFilterProperty Property="EntityType" Title="@L["ColEntityType"]" />
                    <RadzenDataFilterProperty Property="TimestampUtc" Title="@L["ColTimestamp"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="ActionLogEntry" Data="@_significantActionsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="Actor" Title="@L["ColActor"]" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="Action" Title="@L["ColAction"]" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="EntityType" Title="@L["ColEntityType"]" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="TimestampUtc" Title="@L["ColTimestamp"]" />
                </Columns>
            </RadzenDataGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private ForensicAnalysisReport? _report;
    private RadzenDataFilter<MediaItem>? _evidenceItemsFilter;
    private RadzenDataFilter<DeviceHealthSnapshot>? _anomalousHealthSnapshotsFilter;
    private RadzenDataFilter<ActionLogEntry>? _significantActionsFilter;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildForensicAnalysisReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
