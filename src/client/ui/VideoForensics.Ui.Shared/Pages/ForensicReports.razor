@page "/analyze/reports"
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Forensic Analysis Report</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        You are not signed in. <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="Sign in" /> to view forensic reports.
    </RadzenAlert>
}
else
{
    <RadzenStack>
        <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceId" Data="@DeviceOptions"
            TextProperty="Value" ValueProperty="Key" Placeholder="(All devices)" />
        <RadzenStack Orientation="Orientation.Horizontal">
            <input type="date" @bind="_fromDate" />
            <input type="date" @bind="_toDate" />
            <RadzenButton Text="Run Report" Click="RunReportAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </RadzenStack>
    </RadzenStack>

    @if (_report is not null)
    {
        @if (!string.IsNullOrWhiteSpace(_report.Summary))
        {
            <RadzenText>@_report.Summary</RadzenText>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Evidence Items</RadzenText>
        @if (_report.EvidenceItems.Count == 0)
        {
            <RadzenText>No evidence items found in this range.</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_evidenceItemsFilter" TItem="MediaItem" Data="@_report.EvidenceItems" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="Id" Title="Evidence ID" />
                    <RadzenDataFilterProperty Property="DeviceId" Title="Device ID" />
                    <RadzenDataFilterProperty Property="FileName" Title="File Name" />
                    <RadzenDataFilterProperty Property="MediaFormat" Title="Format" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="MediaItem" Data="@_evidenceItemsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="MediaItem" Title="Evidence ID">
                        <Template Context="item">@item.Id.ToString("N")[..8]</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MediaItem" Title="Device ID">
                        <Template Context="item">@item.DeviceId.ToString("N")[..8]</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="MediaItem" Property="FileName" Title="File Name" />
                    <RadzenDataGridColumn TItem="MediaItem" Property="MediaFormat" Title="Format" />
                </Columns>
            </RadzenDataGrid>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Anomalous Health Snapshots</RadzenText>
        @if (_report.AnomalousHealthSnapshots.Count == 0)
        {
            <RadzenText>No anomalous health snapshots found in this range.</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_anomalousHealthSnapshotsFilter" TItem="DeviceHealthSnapshot" Data="@_report.AnomalousHealthSnapshots" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="CapturedAtUtc" Title="Captured At" />
                    <RadzenDataFilterProperty Property="DeviceId" Title="Device ID" />
                    <RadzenDataFilterProperty Property="Connected" Title="Connected" />
                    <RadzenDataFilterProperty Property="BatteryPercentage" Title="Battery %" />
                    <RadzenDataFilterProperty Property="Rssi" Title="RSSI" />
                    <RadzenDataFilterProperty Property="WifiName" Title="Wifi" />
                    <RadzenDataFilterProperty Property="FirmwareVersion" Title="Firmware" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="DeviceHealthSnapshot" Data="@_anomalousHealthSnapshotsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Property="CapturedAtUtc" Title="Captured At" />
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="Device ID">
                        <Template Context="snapshot">@(snapshot.DeviceId?.ToString("N")[..8] ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="Connected">
                        <Template Context="snapshot">@(snapshot.Connected?.ToString() ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="Battery %">
                        <Template Context="snapshot">@(snapshot.BatteryPercentage?.ToString() ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="RSSI">
                        <Template Context="snapshot">@(snapshot.Rssi?.ToString() ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="Wifi">
                        <Template Context="snapshot">@(snapshot.WifiName ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceHealthSnapshot" Title="Firmware">
                        <Template Context="snapshot">@(snapshot.FirmwareVersion ?? "-")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Significant Actions</RadzenText>
        @if (_report.SignificantActions.Count == 0)
        {
            <RadzenText>No significant actions found in this range.</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_significantActionsFilter" TItem="ActionLogEntry" Data="@_report.SignificantActions" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="Actor" Title="Actor" />
                    <RadzenDataFilterProperty Property="Action" Title="Action" />
                    <RadzenDataFilterProperty Property="EntityType" Title="Entity Type" />
                    <RadzenDataFilterProperty Property="TimestampUtc" Title="Timestamp" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="ActionLogEntry" Data="@_significantActionsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="Actor" Title="Actor" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="Action" Title="Action" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="EntityType" Title="Entity Type" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="TimestampUtc" Title="Timestamp" />
                </Columns>
            </RadzenDataGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private ForensicAnalysisReport? _report;
    private RadzenDataFilter<MediaItem>? _evidenceItemsFilter;
    private RadzenDataFilter<DeviceHealthSnapshot>? _anomalousHealthSnapshotsFilter;
    private RadzenDataFilter<ActionLogEntry>? _significantActionsFilter;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildForensicAnalysisReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
