@page "/analyze/reports"
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository

<MudText Typo="Typo.h4" Class="mb-4">Forensic Analysis Report</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudAlert Severity="Severity.Info">
        You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to view forensic reports.
    </MudAlert>
}
else
{
    <MudStack Spacing="3" Class="mb-4">
        <MudSelect T="string" @bind-Value="_selectedDeviceId" Label="Device" Variant="Variant.Outlined">
            <MudSelectItem Value="@("")">(All devices)</MudSelectItem>
            @foreach (var device in _devices)
            {
                <MudSelectItem Value="@device.Id.ToString()">@device.Name</MudSelectItem>
            }
        </MudSelect>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <input type="date" @bind="_fromDate" />
            <input type="date" @bind="_toDate" />
            <MudButton OnClick="RunReportAsync" Variant="Variant.Filled" Color="Color.Primary">Run Report</MudButton>
        </MudStack>
    </MudStack>

    @if (_report is not null)
    {
        @if (!string.IsNullOrWhiteSpace(_report.Summary))
        {
            <MudText>@_report.Summary</MudText>
        }

        <MudText Typo="Typo.h5" Class="mt-4 mb-2">Evidence Items</MudText>
        @if (_report.EvidenceItems.Count == 0)
        {
            <MudText>No evidence items found in this range.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true">
                <thead>
                    <tr>
                        <th>Evidence ID</th>
                        <th>Device ID</th>
                        <th>File Name</th>
                        <th>Format</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _report.EvidenceItems)
                    {
                        <tr>
                            <td>@item.Id.ToString("N")[..8]</td>
                            <td>@item.DeviceId.ToString("N")[..8]</td>
                            <td>@item.FileName</td>
                            <td>@item.MediaFormat</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        <MudText Typo="Typo.h5" Class="mt-4 mb-2">Anomalous Health Snapshots</MudText>
        @if (_report.AnomalousHealthSnapshots.Count == 0)
        {
            <MudText>No anomalous health snapshots found in this range.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true">
                <thead>
                    <tr>
                        <th>Captured At</th>
                        <th>Device ID</th>
                        <th>Connected</th>
                        <th>Battery %</th>
                        <th>RSSI</th>
                        <th>Wifi</th>
                        <th>Firmware</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var snapshot in _report.AnomalousHealthSnapshots)
                    {
                        <tr>
                            <td>@snapshot.CapturedAtUtc</td>
                            <td>@(snapshot.DeviceId?.ToString("N")[..8] ?? "-")</td>
                            <td>@(snapshot.Connected?.ToString() ?? "-")</td>
                            <td>@(snapshot.BatteryPercentage?.ToString() ?? "-")</td>
                            <td>@(snapshot.Rssi?.ToString() ?? "-")</td>
                            <td>@(snapshot.WifiName ?? "-")</td>
                            <td>@(snapshot.FirmwareVersion ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        <MudText Typo="Typo.h5" Class="mt-4 mb-2">Significant Actions</MudText>
        @if (_report.SignificantActions.Count == 0)
        {
            <MudText>No significant actions found in this range.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true">
                <thead>
                    <tr>
                        <th>Actor</th>
                        <th>Action</th>
                        <th>Entity Type</th>
                        <th>Timestamp</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var action in _report.SignificantActions)
                    {
                        <tr>
                            <td>@action.Actor</td>
                            <td>@action.Action</td>
                            <td>@action.EntityType</td>
                            <td>@action.TimestampUtc</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private ForensicAnalysisReport? _report;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildForensicAnalysisReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
