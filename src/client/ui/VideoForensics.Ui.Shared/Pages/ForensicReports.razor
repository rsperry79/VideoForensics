@page "/analyze/reports"
@using VideoForensics.Ui.Shared.Services.Scope
@inject NavigationManager NavigationManager

@code {
    protected override void OnInitialized()
    {
        // Redirect to /analyze?analysis=reports, preserving any other query parameters
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = uri.Query.TrimStart('?');
        var newUri = ScopeUrl.Merge("/analyze", "analysis=reports" + (string.IsNullOrEmpty(query) ? "" : "&" + query));
        NavigationManager.NavigateTo(newUri, replace: true);
    }
}
