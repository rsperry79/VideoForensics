@page "/settings"
@using VideoForensics.Client.Core.Tools
@inject IProviderAuthService AuthService
@inject IForensicsConfiguration Config
@inject IForensicsConfigurationService ConfigService
@inject ConfigToolsOrchestrator ConfigTools
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Settings</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        You are not signed in. <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="Sign in" /> to change settings.
    </RadzenAlert>
}
else
{
    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">Reports</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack>
            <label><RadzenCheckBox TValue="bool" Value="@Config.EnableForensicAnalysisReports" ValueChanged="@(async (bool v) => await SaveForensicAnalysisReportsAsync(v))" /> Forensic Analysis</label>
            @if (_reportMessages.TryGetValue("ForensicAnalysis", out var m1))
            {
                <RadzenText TextStyle="TextStyle.Caption" style="@(m1.Success ? "color: green;" : "color: red;")">@m1.Message</RadzenText>
            }
            <label><RadzenCheckBox TValue="bool" Value="@Config.EnableSignalAnomalyReports" ValueChanged="@(async (bool v) => await SaveSignalAnomalyReportsAsync(v))" /> Signal Anomaly</label>
            @if (_reportMessages.TryGetValue("SignalAnomaly", out var m2))
            {
                <RadzenText TextStyle="TextStyle.Caption" style="@(m2.Success ? "color: green;" : "color: red;")">@m2.Message</RadzenText>
            }
            <label><RadzenCheckBox TValue="bool" Value="@Config.EnableChainOfCustodyReports" ValueChanged="@(async (bool v) => await SaveChainOfCustodyReportsAsync(v))" /> Chain of Custody</label>
            @if (_reportMessages.TryGetValue("ChainOfCustody", out var m3))
            {
                <RadzenText TextStyle="TextStyle.Caption" style="@(m3.Success ? "color: green;" : "color: red;")">@m3.Message</RadzenText>
            }
            <label><RadzenCheckBox TValue="bool" Value="@Config.EnableEvidenceValidationReports" ValueChanged="@(async (bool v) => await SaveEvidenceValidationReportsAsync(v))" /> Evidence Validation</label>
            @if (_reportMessages.TryGetValue("EvidenceValidation", out var m4))
            {
                <RadzenText TextStyle="TextStyle.Caption" style="@(m4.Success ? "color: green;" : "color: red;")">@m4.Message</RadzenText>
            }
            <label><RadzenCheckBox TValue="bool" Value="@Config.EnableAccessControlMonitoring" ValueChanged="@(async (bool v) => await SaveAccessControlReportsAsync(v))" /> Access Control</label>
            @if (_reportMessages.TryGetValue("AccessControl", out var m5))
            {
                <RadzenText TextStyle="TextStyle.Caption" style="@(m5.Success ? "color: green;" : "color: red;")">@m5.Message</RadzenText>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">Health Sync</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack>
            <label><RadzenCheckBox TValue="bool" Value="@Config.EnableHealthSync" ValueChanged="@(async (bool v) => await SaveHealthSyncAsync(v))" /> Enable RSSI / device-health background sync</label>
            @if (_healthSyncMessage is not null)
            {
                <RadzenText style="@(_healthSyncSuccess ? "color: green;" : "color: red;")">@_healthSyncMessage</RadzenText>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">Network Discovery</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack>
            <label><RadzenCheckBox TValue="bool" Value="@Config.EnableMdnsAdvertisement" ValueChanged="@(async (bool v) => await SaveMdnsAdvertisementAsync(v))" /> Advertise this server on the local network (mDNS) so a pairing client can find it without typing an IP</label>
            @if (_mdnsMessage is not null)
            {
                <RadzenText style="@(_mdnsSuccess ? "color: green;" : "color: red;")">@_mdnsMessage</RadzenText>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">Retention</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack Orientation="Orientation.Horizontal">
            <label>Retention (days)</label> <RadzenNumeric TValue="int" @bind-Value="_retentionDays" Style="max-width: 200px;" />
            <RadzenButton Text="Save" Click="SaveRetentionAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            @if (_retentionMessage is not null)
            {
                <RadzenText style="@(_retentionSuccess ? "color: green;" : "color: red;")">@_retentionMessage</RadzenText>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">Downloads</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack Spacing="3">
            <RadzenStack Orientation="Orientation.Horizontal">
                <label>Max Concurrent Downloads</label> <RadzenNumeric TValue="int" @bind-Value="_maxConcurrentDownloads" Style="max-width: 260px;" />
                <RadzenButton Text="Save" Click="SaveMaxConcurrentAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                @if (_maxConcurrentMessage is not null)
                {
                    <RadzenText style="@(_maxConcurrentSuccess ? "color: green;" : "color: red;")">@_maxConcurrentMessage</RadzenText>
                }
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal">
                <label>Download Location</label> <RadzenTextBox @bind-Value="_downloadLocation" Placeholder="Download Location" Style="max-width: 400px;" />
                <RadzenButton Text="Save" Click="SaveDownloadLocationAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                @if (_downloadLocationMessage is not null)
                {
                    <RadzenText style="@(_downloadLocationSuccess ? "color: green;" : "color: red;")">@_downloadLocationMessage</RadzenText>
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">Reporting Format &amp; Redaction</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack Spacing="3">
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenDropDown TValue="string" @bind-Value="_reportFormat" Data="@(new[] { "json", "xml", "csv" })" Style="max-width: 200px;" />
                <RadzenButton Text="Save" Click="SaveReportFormatAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                @if (_reportFormatMessage is not null)
                {
                    <RadzenText style="@(_reportFormatSuccess ? "color: green;" : "color: red;")">@_reportFormatMessage</RadzenText>
                }
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenDropDown TValue="RedactionLevel" @bind-Value="_redactionLevel" Data="@(Enum.GetValues<RedactionLevel>())" Style="max-width: 200px;" />
                <RadzenButton Text="Save" Click="SaveRedactionLevelAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                @if (_redactionLevelMessage is not null)
                {
                    <RadzenText style="@(_redactionLevelSuccess ? "color: green;" : "color: red;")">@_redactionLevelMessage</RadzenText>
                }
            </RadzenStack>
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">Logging</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack Orientation="Orientation.Horizontal">
            <RadzenDropDown TValue="string" @bind-Value="_loggingLevel" Data="@(new[] { "Debug", "Information", "Warning", "Error", "Critical" })" Style="max-width: 200px;" />
            <RadzenButton Text="Save" Click="SaveLoggingLevelAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            @if (_loggingLevelMessage is not null)
            {
                <RadzenText style="@(_loggingLevelSuccess ? "color: green;" : "color: red;")">@_loggingLevelMessage</RadzenText>
            }
        </RadzenStack>
    </RadzenCard>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    private readonly Dictionary<string, (bool Success, string Message)> _reportMessages = new();

    private bool _healthSyncSuccess;
    private string? _healthSyncMessage;

    private bool _mdnsSuccess;
    private string? _mdnsMessage;

    private int _retentionDays;
    private bool _retentionSuccess;
    private string? _retentionMessage;

    private int _maxConcurrentDownloads;
    private bool _maxConcurrentSuccess;
    private string? _maxConcurrentMessage;

    private string _downloadLocation = string.Empty;
    private bool _downloadLocationSuccess;
    private string? _downloadLocationMessage;

    private string _reportFormat = "json";
    private bool _reportFormatSuccess;
    private string? _reportFormatMessage;

    private RedactionLevel _redactionLevel;
    private bool _redactionLevelSuccess;
    private string? _redactionLevelMessage;

    private string _loggingLevel = "Information";
    private bool _loggingLevelSuccess;
    private string? _loggingLevelMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                _retentionDays = Config.RetentionDaysDefault;
                _maxConcurrentDownloads = Config.MaxConcurrentDownloads;
                _downloadLocation = Config.DownloadLocation ?? string.Empty;
                _reportFormat = Config.ReportOutputFormat;
                _redactionLevel = Config.RedactionLevel;
                _loggingLevel = Config.LogLevel;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task SaveForensicAnalysisReportsAsync(bool enabled) => SaveReportToggleAsync("ForensicAnalysis", enabled);
    private Task SaveSignalAnomalyReportsAsync(bool enabled) => SaveReportToggleAsync("SignalAnomaly", enabled);
    private Task SaveChainOfCustodyReportsAsync(bool enabled) => SaveReportToggleAsync("ChainOfCustody", enabled);
    private Task SaveEvidenceValidationReportsAsync(bool enabled) => SaveReportToggleAsync("EvidenceValidation", enabled);
    private Task SaveAccessControlReportsAsync(bool enabled) => SaveReportToggleAsync("AccessControl", enabled);

    private async Task SaveReportToggleAsync(string reportType, bool enabled)
    {
        var (success, message) = await ConfigTools.SetReportEnabledAsync(Config, reportType, enabled, CancellationToken.None);
        _reportMessages[reportType] = (success, message);
    }

    private async Task SaveHealthSyncAsync(bool enabled)
    {
        try
        {
            Config.EnableHealthSync = enabled;
            await ConfigService.SaveConfigurationAsync(Config, CancellationToken.None);
            _healthSyncSuccess = true;
            _healthSyncMessage = $"Health sync {(enabled ? "enabled" : "disabled")}";
        }
        catch (Exception ex)
        {
            _healthSyncSuccess = false;
            _healthSyncMessage = $"Failed to update health sync: {ex.Message}";
        }
    }

    private async Task SaveMdnsAdvertisementAsync(bool enabled)
    {
        try
        {
            Config.EnableMdnsAdvertisement = enabled;
            await ConfigService.SaveConfigurationAsync(Config, CancellationToken.None);
            _mdnsSuccess = true;
            _mdnsMessage = $"mDNS advertisement {(enabled ? "enabled" : "disabled")}";
        }
        catch (Exception ex)
        {
            _mdnsSuccess = false;
            _mdnsMessage = $"Failed to update mDNS advertisement: {ex.Message}";
        }
    }

    private async Task SaveRetentionAsync()
    {
        (_retentionSuccess, _retentionMessage) = await ConfigTools.SetRetentionDaysAsync(Config, _retentionDays, CancellationToken.None);
    }

    private async Task SaveMaxConcurrentAsync()
    {
        (_maxConcurrentSuccess, _maxConcurrentMessage) = await ConfigTools.SetMaxConcurrentDownloadsAsync(Config, _maxConcurrentDownloads, CancellationToken.None);
    }

    private async Task SaveDownloadLocationAsync()
    {
        (_downloadLocationSuccess, _downloadLocationMessage) = await ConfigTools.SetDownloadLocationAsync(Config, _downloadLocation, CancellationToken.None);
    }

    private async Task SaveReportFormatAsync()
    {
        (_reportFormatSuccess, _reportFormatMessage) = await ConfigTools.SetReportFormatAsync(Config, _reportFormat, CancellationToken.None);
    }

    private async Task SaveRedactionLevelAsync()
    {
        (_redactionLevelSuccess, _redactionLevelMessage) = await ConfigTools.SetRedactionLevelAsync(Config, _redactionLevel, CancellationToken.None);
    }

    private async Task SaveLoggingLevelAsync()
    {
        (_loggingLevelSuccess, _loggingLevelMessage) = await ConfigTools.SetLoggingLevelAsync(Config, _loggingLevel, CancellationToken.None);
    }
}
