@page "/settings"
@using VideoForensics.Client.Core.Tools
@inject IProviderAuthService AuthService
@inject IForensicsConfiguration Config
@inject IForensicsConfigurationService ConfigService
@inject ConfigToolsOrchestrator ConfigTools

<MudText Typo="Typo.h4" Class="mb-4">Settings</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudAlert Severity="Severity.Info">
        You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to change settings.
    </MudAlert>
}
else
{
    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Reports</MudText>
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack>
            <MudSwitch T="bool" Value="Config.EnableForensicAnalysisReports" ValueChanged="SaveForensicAnalysisReportsAsync" Color="Color.Primary" Label="Forensic Analysis" />
            @if (_reportMessages.TryGetValue("ForensicAnalysis", out var m1))
            {
                <MudText Color="@(m1.Success ? Color.Success : Color.Error)" Typo="Typo.caption">@m1.Message</MudText>
            }
            <MudSwitch T="bool" Value="Config.EnableSignalAnomalyReports" ValueChanged="SaveSignalAnomalyReportsAsync" Color="Color.Primary" Label="Signal Anomaly" />
            @if (_reportMessages.TryGetValue("SignalAnomaly", out var m2))
            {
                <MudText Color="@(m2.Success ? Color.Success : Color.Error)" Typo="Typo.caption">@m2.Message</MudText>
            }
            <MudSwitch T="bool" Value="Config.EnableChainOfCustodyReports" ValueChanged="SaveChainOfCustodyReportsAsync" Color="Color.Primary" Label="Chain of Custody" />
            @if (_reportMessages.TryGetValue("ChainOfCustody", out var m3))
            {
                <MudText Color="@(m3.Success ? Color.Success : Color.Error)" Typo="Typo.caption">@m3.Message</MudText>
            }
            <MudSwitch T="bool" Value="Config.EnableEvidenceValidationReports" ValueChanged="SaveEvidenceValidationReportsAsync" Color="Color.Primary" Label="Evidence Validation" />
            @if (_reportMessages.TryGetValue("EvidenceValidation", out var m4))
            {
                <MudText Color="@(m4.Success ? Color.Success : Color.Error)" Typo="Typo.caption">@m4.Message</MudText>
            }
            <MudSwitch T="bool" Value="Config.EnableAccessControlMonitoring" ValueChanged="SaveAccessControlReportsAsync" Color="Color.Primary" Label="Access Control" />
            @if (_reportMessages.TryGetValue("AccessControl", out var m5))
            {
                <MudText Color="@(m5.Success ? Color.Success : Color.Error)" Typo="Typo.caption">@m5.Message</MudText>
            }
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Health Sync</MudText>
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack>
            <MudSwitch T="bool" Value="Config.EnableHealthSync" ValueChanged="SaveHealthSyncAsync" Color="Color.Primary" Label="Enable RSSI / device-health background sync" />
            @if (_healthSyncMessage is not null)
            {
                <MudText Color="@(_healthSyncSuccess ? Color.Success : Color.Error)" Typo="Typo.caption">@_healthSyncMessage</MudText>
            }
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Network Discovery</MudText>
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack>
            <MudSwitch T="bool" Value="Config.EnableMdnsAdvertisement" ValueChanged="SaveMdnsAdvertisementAsync" Color="Color.Primary" Label="Advertise this server on the local network (mDNS) so a pairing client can find it without typing an IP" />
            @if (_mdnsMessage is not null)
            {
                <MudText Color="@(_mdnsSuccess ? Color.Success : Color.Error)" Typo="Typo.caption">@_mdnsMessage</MudText>
            }
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Retention</MudText>
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudNumericField @bind-Value="_retentionDays" Label="Retention (days)" Variant="Variant.Outlined" Style="max-width: 200px;" />
            <MudButton OnClick="SaveRetentionAsync" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
            @if (_retentionMessage is not null)
            {
                <MudText Color="@(_retentionSuccess ? Color.Success : Color.Error)" Typo="Typo.caption">@_retentionMessage</MudText>
            }
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Downloads</MudText>
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudNumericField @bind-Value="_maxConcurrentDownloads" Label="Max Concurrent Downloads" Variant="Variant.Outlined" Style="max-width: 260px;" />
                <MudButton OnClick="SaveMaxConcurrentAsync" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
                @if (_maxConcurrentMessage is not null)
                {
                    <MudText Color="@(_maxConcurrentSuccess ? Color.Success : Color.Error)" Typo="Typo.caption">@_maxConcurrentMessage</MudText>
                }
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_downloadLocation" Label="Download Location" Variant="Variant.Outlined" Style="max-width: 400px;" />
                <MudButton OnClick="SaveDownloadLocationAsync" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
                @if (_downloadLocationMessage is not null)
                {
                    <MudText Color="@(_downloadLocationSuccess ? Color.Success : Color.Error)" Typo="Typo.caption">@_downloadLocationMessage</MudText>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Reporting Format &amp; Redaction</MudText>
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack Spacing="3">
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudSelect T="string" @bind-Value="_reportFormat" Label="Report Format" Variant="Variant.Outlined" Style="max-width: 200px;">
                    <MudSelectItem Value="@("json")">json</MudSelectItem>
                    <MudSelectItem Value="@("xml")">xml</MudSelectItem>
                    <MudSelectItem Value="@("csv")">csv</MudSelectItem>
                </MudSelect>
                <MudButton OnClick="SaveReportFormatAsync" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
                @if (_reportFormatMessage is not null)
                {
                    <MudText Color="@(_reportFormatSuccess ? Color.Success : Color.Error)" Typo="Typo.caption">@_reportFormatMessage</MudText>
                }
            </MudStack>
            <MudStack Row="true" AlignItems="AlignItems.Center">
                <MudSelect T="RedactionLevel" @bind-Value="_redactionLevel" Label="Redaction Level" Variant="Variant.Outlined" Style="max-width: 200px;">
                    @foreach (var level in Enum.GetValues<RedactionLevel>())
                    {
                        <MudSelectItem Value="@level">@level</MudSelectItem>
                    }
                </MudSelect>
                <MudButton OnClick="SaveRedactionLevelAsync" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
                @if (_redactionLevelMessage is not null)
                {
                    <MudText Color="@(_redactionLevelSuccess ? Color.Success : Color.Error)" Typo="Typo.caption">@_redactionLevelMessage</MudText>
                }
            </MudStack>
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Logging</MudText>
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudSelect T="string" @bind-Value="_loggingLevel" Label="Logging Level" Variant="Variant.Outlined" Style="max-width: 200px;">
                <MudSelectItem Value="@("Debug")">Debug</MudSelectItem>
                <MudSelectItem Value="@("Information")">Information</MudSelectItem>
                <MudSelectItem Value="@("Warning")">Warning</MudSelectItem>
                <MudSelectItem Value="@("Error")">Error</MudSelectItem>
                <MudSelectItem Value="@("Critical")">Critical</MudSelectItem>
            </MudSelect>
            <MudButton OnClick="SaveLoggingLevelAsync" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
            @if (_loggingLevelMessage is not null)
            {
                <MudText Color="@(_loggingLevelSuccess ? Color.Success : Color.Error)" Typo="Typo.caption">@_loggingLevelMessage</MudText>
            }
        </MudStack>
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    private readonly Dictionary<string, (bool Success, string Message)> _reportMessages = new();

    private bool _healthSyncSuccess;
    private string? _healthSyncMessage;

    private bool _mdnsSuccess;
    private string? _mdnsMessage;

    private int _retentionDays;
    private bool _retentionSuccess;
    private string? _retentionMessage;

    private int _maxConcurrentDownloads;
    private bool _maxConcurrentSuccess;
    private string? _maxConcurrentMessage;

    private string _downloadLocation = string.Empty;
    private bool _downloadLocationSuccess;
    private string? _downloadLocationMessage;

    private string _reportFormat = "json";
    private bool _reportFormatSuccess;
    private string? _reportFormatMessage;

    private RedactionLevel _redactionLevel;
    private bool _redactionLevelSuccess;
    private string? _redactionLevelMessage;

    private string _loggingLevel = "Information";
    private bool _loggingLevelSuccess;
    private string? _loggingLevelMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                _retentionDays = Config.RetentionDaysDefault;
                _maxConcurrentDownloads = Config.MaxConcurrentDownloads;
                _downloadLocation = Config.DownloadLocation ?? string.Empty;
                _reportFormat = Config.ReportOutputFormat;
                _redactionLevel = Config.RedactionLevel;
                _loggingLevel = Config.LogLevel;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task SaveForensicAnalysisReportsAsync(bool enabled) => SaveReportToggleAsync("ForensicAnalysis", enabled);
    private Task SaveSignalAnomalyReportsAsync(bool enabled) => SaveReportToggleAsync("SignalAnomaly", enabled);
    private Task SaveChainOfCustodyReportsAsync(bool enabled) => SaveReportToggleAsync("ChainOfCustody", enabled);
    private Task SaveEvidenceValidationReportsAsync(bool enabled) => SaveReportToggleAsync("EvidenceValidation", enabled);
    private Task SaveAccessControlReportsAsync(bool enabled) => SaveReportToggleAsync("AccessControl", enabled);

    private async Task SaveReportToggleAsync(string reportType, bool enabled)
    {
        var (success, message) = await ConfigTools.SetReportEnabledAsync(Config, reportType, enabled, CancellationToken.None);
        _reportMessages[reportType] = (success, message);
    }

    private async Task SaveHealthSyncAsync(bool enabled)
    {
        try
        {
            Config.EnableHealthSync = enabled;
            await ConfigService.SaveConfigurationAsync(Config, CancellationToken.None);
            _healthSyncSuccess = true;
            _healthSyncMessage = $"Health sync {(enabled ? "enabled" : "disabled")}";
        }
        catch (Exception ex)
        {
            _healthSyncSuccess = false;
            _healthSyncMessage = $"Failed to update health sync: {ex.Message}";
        }
    }

    private async Task SaveMdnsAdvertisementAsync(bool enabled)
    {
        try
        {
            Config.EnableMdnsAdvertisement = enabled;
            await ConfigService.SaveConfigurationAsync(Config, CancellationToken.None);
            _mdnsSuccess = true;
            _mdnsMessage = $"mDNS advertisement {(enabled ? "enabled" : "disabled")}";
        }
        catch (Exception ex)
        {
            _mdnsSuccess = false;
            _mdnsMessage = $"Failed to update mDNS advertisement: {ex.Message}";
        }
    }

    private async Task SaveRetentionAsync()
    {
        (_retentionSuccess, _retentionMessage) = await ConfigTools.SetRetentionDaysAsync(Config, _retentionDays, CancellationToken.None);
    }

    private async Task SaveMaxConcurrentAsync()
    {
        (_maxConcurrentSuccess, _maxConcurrentMessage) = await ConfigTools.SetMaxConcurrentDownloadsAsync(Config, _maxConcurrentDownloads, CancellationToken.None);
    }

    private async Task SaveDownloadLocationAsync()
    {
        (_downloadLocationSuccess, _downloadLocationMessage) = await ConfigTools.SetDownloadLocationAsync(Config, _downloadLocation, CancellationToken.None);
    }

    private async Task SaveReportFormatAsync()
    {
        (_reportFormatSuccess, _reportFormatMessage) = await ConfigTools.SetReportFormatAsync(Config, _reportFormat, CancellationToken.None);
    }

    private async Task SaveRedactionLevelAsync()
    {
        (_redactionLevelSuccess, _redactionLevelMessage) = await ConfigTools.SetRedactionLevelAsync(Config, _redactionLevel, CancellationToken.None);
    }

    private async Task SaveLoggingLevelAsync()
    {
        (_loggingLevelSuccess, _loggingLevelMessage) = await ConfigTools.SetLoggingLevelAsync(Config, _loggingLevel, CancellationToken.None);
    }
}
