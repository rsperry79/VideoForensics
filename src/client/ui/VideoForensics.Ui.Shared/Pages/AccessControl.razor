@page "/analyze/access-control"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<AccessControl> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">@L["NotSignedIn"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="@L["SignIn"]" /> @L["SignInToViewAccessControl"]</RadzenAlert>
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Class="mb-4">
        <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceId" Data="@DeviceOptions"
            TextProperty="Value" ValueProperty="Key" Placeholder="@L["AllDevicesPlaceholder"]" />
        <label>@L["FromLabel"] <input type="date" @bind="_fromDate" /></label>
        <label>@L["ToLabel"] <input type="date" @bind="_toDate" /></label>
        <RadzenButton Text="@L["RunReport"]" Click="RunReportAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </RadzenStack>

    @if (_report is not null)
    {
        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["AccessEventsTitle"]</RadzenText>
        @if (_report.AccessEvents.Count == 0)
        {
            <RadzenText>@L["NoAccessEventsFound"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_accessEventsFilter" TItem="AccessControlReport.AccessEvent" Data="@_report.AccessEvents" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="AccessedAtUtc" Title="@L["ColAccessedAt"]" />
                    <RadzenDataFilterProperty Property="Actor" Title="@L["ColActor"]" />
                    <RadzenDataFilterProperty Property="Action" Title="@L["ColAction"]" />
                    <RadzenDataFilterProperty Property="EntityType" Title="@L["ColEntityType"]" />
                    <RadzenDataFilterProperty Property="Details" Title="@L["ColDetails"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="AccessControlReport.AccessEvent" Data="@_accessEventsFilter?.View"
                AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="AccessControlReport.AccessEvent" Property="AccessedAtUtc" Title="@L["ColAccessedAt"]" />
                    <RadzenDataGridColumn TItem="AccessControlReport.AccessEvent" Property="Actor" Title="@L["ColActor"]" />
                    <RadzenDataGridColumn TItem="AccessControlReport.AccessEvent" Property="Action" Title="@L["ColAction"]" />
                    <RadzenDataGridColumn TItem="AccessControlReport.AccessEvent" Property="EntityType" Title="@L["ColEntityType"]" />
                    <RadzenDataGridColumn TItem="AccessControlReport.AccessEvent" Property="Details" Title="@L["ColDetails"]">
                        <Template Context="row">@(row.Details ?? "-")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["ExportEventsTitle"]</RadzenText>
        @if (_report.ExportEvents.Count == 0)
        {
            <RadzenText>@L["NoExportEventsFound"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_exportEventsFilter" TItem="AccessControlReport.ExportEvent" Data="@_report.ExportEvents" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="ExportedAtUtc" Title="@L["ColExportedAt"]" />
                    <RadzenDataFilterProperty Property="ExportedByUserName" Title="@L["ColExportedBy"]" />
                    <RadzenDataFilterProperty Property="CaseReference" Title="@L["ColCaseReference"]" />
                    <RadzenDataFilterProperty Property="RecipientDescription" Title="@L["ColRecipient"]" />
                    <RadzenDataFilterProperty Property="ItemCount" Title="@L["ColItemCount"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="AccessControlReport.ExportEvent" Data="@_exportEventsFilter?.View"
                AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="AccessControlReport.ExportEvent" Property="ExportedAtUtc" Title="@L["ColExportedAt"]" />
                    <RadzenDataGridColumn TItem="AccessControlReport.ExportEvent" Property="ExportedByUserName" Title="@L["ColExportedBy"]" />
                    <RadzenDataGridColumn TItem="AccessControlReport.ExportEvent" Property="CaseReference" Title="@L["ColCaseReference"]">
                        <Template Context="row">@(row.CaseReference ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AccessControlReport.ExportEvent" Property="RecipientDescription" Title="@L["ColRecipient"]">
                        <Template Context="row">@(row.RecipientDescription ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AccessControlReport.ExportEvent" Property="ItemCount" Title="@L["ColItemCount"]" />
                </Columns>
            </RadzenDataGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private AccessControlReport? _report;
    private RadzenDataFilter<AccessControlReport.AccessEvent>? _accessEventsFilter;
    private RadzenDataFilter<AccessControlReport.ExportEvent>? _exportEventsFilter;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildAccessControlReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
