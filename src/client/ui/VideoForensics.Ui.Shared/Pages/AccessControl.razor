@page "/analyze/access-control"
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Access Control Report</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">You are not signed in. <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="Sign in" /> to view access control data.</RadzenAlert>
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Class="mb-4">
        <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceId" Data="@DeviceOptions"
            TextProperty="Value" ValueProperty="Key" Placeholder="(All devices)" />
        <label>From: <input type="date" @bind="_fromDate" /></label>
        <label>To: <input type="date" @bind="_toDate" /></label>
        <RadzenButton Text="Run Report" Click="RunReportAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </RadzenStack>

    @if (_report is not null)
    {
        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Access Events</RadzenText>
        @if (_report.AccessEvents.Count == 0)
        {
            <RadzenText>No access events found in this range.</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_accessEventsFilter" TItem="AccessControlReport.AccessEvent" Data="@_report.AccessEvents" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="AccessedAtUtc" Title="Accessed At" />
                    <RadzenDataFilterProperty Property="Actor" Title="Actor" />
                    <RadzenDataFilterProperty Property="Action" Title="Action" />
                    <RadzenDataFilterProperty Property="EntityType" Title="Entity Type" />
                    <RadzenDataFilterProperty Property="Details" Title="Details" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="AccessControlReport.AccessEvent" Data="@_accessEventsFilter?.View"
                AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="AccessControlReport.AccessEvent" Property="AccessedAtUtc" Title="Accessed At" />
                    <RadzenDataGridColumn TItem="AccessControlReport.AccessEvent" Property="Actor" Title="Actor" />
                    <RadzenDataGridColumn TItem="AccessControlReport.AccessEvent" Property="Action" Title="Action" />
                    <RadzenDataGridColumn TItem="AccessControlReport.AccessEvent" Property="EntityType" Title="Entity Type" />
                    <RadzenDataGridColumn TItem="AccessControlReport.AccessEvent" Property="Details" Title="Details">
                        <Template Context="row">@(row.Details ?? "-")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Export Events</RadzenText>
        @if (_report.ExportEvents.Count == 0)
        {
            <RadzenText>No export events found in this range.</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_exportEventsFilter" TItem="AccessControlReport.ExportEvent" Data="@_report.ExportEvents" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="ExportedAtUtc" Title="Exported At" />
                    <RadzenDataFilterProperty Property="ExportedByUserName" Title="Exported By" />
                    <RadzenDataFilterProperty Property="CaseReference" Title="Case Reference" />
                    <RadzenDataFilterProperty Property="RecipientDescription" Title="Recipient" />
                    <RadzenDataFilterProperty Property="ItemCount" Title="Item Count" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="AccessControlReport.ExportEvent" Data="@_exportEventsFilter?.View"
                AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="AccessControlReport.ExportEvent" Property="ExportedAtUtc" Title="Exported At" />
                    <RadzenDataGridColumn TItem="AccessControlReport.ExportEvent" Property="ExportedByUserName" Title="Exported By" />
                    <RadzenDataGridColumn TItem="AccessControlReport.ExportEvent" Property="CaseReference" Title="Case Reference">
                        <Template Context="row">@(row.CaseReference ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AccessControlReport.ExportEvent" Property="RecipientDescription" Title="Recipient">
                        <Template Context="row">@(row.RecipientDescription ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="AccessControlReport.ExportEvent" Property="ItemCount" Title="Item Count" />
                </Columns>
            </RadzenDataGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private AccessControlReport? _report;
    private RadzenDataFilter<AccessControlReport.AccessEvent>? _accessEventsFilter;
    private RadzenDataFilter<AccessControlReport.ExportEvent>? _exportEventsFilter;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildAccessControlReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
