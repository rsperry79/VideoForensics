@page "/settings/infrastructure"
@using VideoForensics.Client.Core.Tools
@inject IProviderAuthService AuthService
@inject IForensicsConfiguration Config
@inject ConfigToolsOrchestrator ConfigTools

<MudText Typo="Typo.h4" Class="mb-4">Infrastructure Settings</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudAlert Severity="Severity.Info">
        You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to change infrastructure settings.
    </MudAlert>
}
else
{
    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Data-at-Rest Encryption</MudText>
    <MudAlert Severity="Severity.Warning" Class="mb-4">
        <strong>Neither the database nor downloaded media files are encrypted by this application.</strong>
        An application-level database encryption approach (SQLCipher) was evaluated and found to
        silently fail to apply schema changes under this platform's current SQLite provider version -
        a data-integrity risk unacceptable for evidence storage, so it was not shipped. Until a safe
        approach is available, protecting this data at rest is the owner's responsibility: enable
        full-disk encryption (BitLocker on Windows, LUKS on Linux) on the drive holding
        <code>%AppData%\VideoForensics</code> and your configured download location, and secure
        physical access to this machine.
    </MudAlert>

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Key Storage Provider</MudText>
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudSelect T="KeyStorageProvider" @bind-Value="_keyStorageProvider" Label="Key Storage Provider" Variant="Variant.Outlined" Style="max-width: 260px;">
                @foreach (var provider in Enum.GetValues<KeyStorageProvider>())
                {
                    <MudSelectItem Value="@provider">@provider</MudSelectItem>
                }
            </MudSelect>
            <MudButton OnClick="SaveKeyStorageProviderAsync" Variant="Variant.Filled" Color="Color.Primary">Save</MudButton>
            @if (_keyStorageProviderMessage is not null)
            {
                <MudText Color="@(_keyStorageProviderSuccess ? Color.Success : Color.Error)" Typo="Typo.caption">@_keyStorageProviderMessage</MudText>
            }
        </MudStack>
    </MudPaper>

    <MudText Typo="Typo.h6" Class="mt-4 mb-2">Factory Reset</MudText>
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        @if (!_showFactoryResetConfirm)
        {
            <MudButton OnClick="() => _showFactoryResetConfirm = true" Variant="Variant.Filled" Color="Color.Error">Factory Reset</MudButton>
        }
        else
        {
            <MudAlert Severity="Severity.Error" Class="mb-2">
                <strong>This will permanently delete ALL data. This cannot be undone.</strong>
            </MudAlert>
            <MudStack Row="true">
                <MudButton OnClick="ConfirmFactoryResetAsync" Disabled="@_factoryResetting" Variant="Variant.Filled" Color="Color.Error">Yes, delete everything</MudButton>
                <MudButton OnClick="() => _showFactoryResetConfirm = false" Disabled="@_factoryResetting" Variant="Variant.Outlined">Cancel</MudButton>
            </MudStack>
        }

        @if (_factoryResetMessage is not null)
        {
            <MudText Color="@(_factoryResetSuccess ? Color.Success : Color.Error)" Class="mt-2"><strong>@_factoryResetMessage</strong></MudText>
        }
    </MudPaper>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    private KeyStorageProvider _keyStorageProvider;
    private bool _keyStorageProviderSuccess;
    private string? _keyStorageProviderMessage;

    private bool _showFactoryResetConfirm;
    private bool _factoryResetting;
    private bool _factoryResetSuccess;
    private string? _factoryResetMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                _keyStorageProvider = Config.KeyStorageProvider;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveKeyStorageProviderAsync()
    {
        (_keyStorageProviderSuccess, _keyStorageProviderMessage) = await ConfigTools.SetKeyStorageProviderAsync(Config, _keyStorageProvider, CancellationToken.None);
    }

    private async Task ConfirmFactoryResetAsync()
    {
        _factoryResetting = true;
        try
        {
            (_factoryResetSuccess, _factoryResetMessage) = await ConfigTools.FactoryResetAsync(CancellationToken.None);
        }
        finally
        {
            _factoryResetting = false;
            _showFactoryResetConfirm = false;
        }
    }
}
