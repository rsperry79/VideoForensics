@page "/settings/infrastructure"
@using VideoForensics.Client.Core.Tools
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject IForensicsConfiguration Config
@inject ConfigToolsOrchestrator ConfigTools
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SettingsInfrastructure> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToChangeSettings"]
    </div>
}
else
{
    <h6 class="mt-4 mb-2">@L["DataEncryptionSection"]</h6>
    <div class="alert alert-warning mb-4">
        <strong>@L["EncryptionWarning"]</strong>
    </div>

    <h6 class="mt-4 mb-2">@L["KeyStorageSection"]</h6>
    <div class="card mb-4">
        <div class="card-body pa-4">
            <div class="d-flex flex-row gap-2">
                <SfDropDownList TValue="KeyStorageProvider" TItem="KeyStorageProvider" @bind-Value="_keyStorageProvider" DataSource="@(Enum.GetValues<KeyStorageProvider>())" Style="max-width: 260px;" />
                <SfButton Content="@L["SaveButton"]" OnClick="SaveKeyStorageProviderAsync" CssClass="e-primary" />
                @if (_keyStorageProviderMessage is not null)
                {
                    <span style="@(_keyStorageProviderSuccess ? "color: green;" : "color: red;")">@_keyStorageProviderMessage</span>
                }
            </div>
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["FactoryResetSection"]</h6>
    <div class="card mb-4">
        <div class="card-body pa-4">
            @if (!_showFactoryResetConfirm)
            {
                <SfButton Content="@L["FactoryResetButton"]" OnClick="() => _showFactoryResetConfirm = true" CssClass="e-danger" />
            }
            else
            {
                <div class="alert alert-danger mb-2">
                    <strong>@L["FactoryResetWarning"]</strong>
                </div>
                <div class="d-flex flex-row gap-2">
                    <SfButton Content="@L["ConfirmDelete"]" OnClick="ConfirmFactoryResetAsync" Disabled="@_factoryResetting" CssClass="e-danger" />
                    <SfButton Content="@L["CancelButton"]" OnClick="() => _showFactoryResetConfirm = false" Disabled="@_factoryResetting" CssClass="e-flat" />
                </div>
            }

            @if (_factoryResetMessage is not null)
            {
                <span style="@(_factoryResetSuccess ? "color: green;" : "color: red;")" class="mt-2"><strong>@_factoryResetMessage</strong></span>
            }
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    private KeyStorageProvider _keyStorageProvider;
    private bool _keyStorageProviderSuccess;
    private string? _keyStorageProviderMessage;

    private bool _showFactoryResetConfirm;
    private bool _factoryResetting;
    private bool _factoryResetSuccess;
    private string? _factoryResetMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                _keyStorageProvider = Config.KeyStorageProvider;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveKeyStorageProviderAsync()
    {
        (_keyStorageProviderSuccess, _keyStorageProviderMessage) = await ConfigTools.SetKeyStorageProviderAsync(Config, _keyStorageProvider, CancellationToken.None);
    }

    private async Task ConfirmFactoryResetAsync()
    {
        _factoryResetting = true;
        try
        {
            (_factoryResetSuccess, _factoryResetMessage) = await ConfigTools.FactoryResetAsync(CancellationToken.None);
        }
        finally
        {
            _factoryResetting = false;
            _showFactoryResetConfirm = false;
        }
    }
}
