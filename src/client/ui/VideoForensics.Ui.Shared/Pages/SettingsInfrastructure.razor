@page "/settings/infrastructure"
@using VideoForensics.Client.Core.Tools
@inject IProviderAuthService AuthService
@inject IForensicsConfiguration Config
@inject ConfigToolsOrchestrator ConfigTools
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Infrastructure Settings</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        You are not signed in. <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="Sign in" /> to change infrastructure settings.
    </RadzenAlert>
}
else
{
    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">Data-at-Rest Encryption</RadzenText>
    <RadzenAlert AlertStyle="AlertStyle.Warning" class="mb-4">
        <strong>Neither the database nor downloaded media files are encrypted by this application.</strong>
        An application-level database encryption approach (SQLCipher) was evaluated and found to
        silently fail to apply schema changes under this platform's current SQLite provider version -
        a data-integrity risk unacceptable for evidence storage, so it was not shipped. Until a safe
        approach is available, protecting this data at rest is the owner's responsibility: enable
        full-disk encryption (BitLocker on Windows, LUKS on Linux) on the drive holding
        <code>%AppData%\VideoForensics</code> and your configured download location, and secure
        physical access to this machine.
    </RadzenAlert>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">Key Storage Provider</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack Orientation="Orientation.Horizontal">
            <RadzenDropDown TValue="KeyStorageProvider" @bind-Value="_keyStorageProvider" Data="@(Enum.GetValues<KeyStorageProvider>())" Style="max-width: 260px;" />
            <RadzenButton Text="Save" Click="SaveKeyStorageProviderAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            @if (_keyStorageProviderMessage is not null)
            {
                <RadzenText style="@(_keyStorageProviderSuccess ? "color: green;" : "color: red;")">@_keyStorageProviderMessage</RadzenText>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">Factory Reset</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        @if (!_showFactoryResetConfirm)
        {
            <RadzenButton Text="Factory Reset" Click="() => _showFactoryResetConfirm = true" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" class="mb-2">
                <strong>This will permanently delete ALL data. This cannot be undone.</strong>
            </RadzenAlert>
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenButton Text="Yes, delete everything" Click="ConfirmFactoryResetAsync" Disabled="@_factoryResetting" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                <RadzenButton Text="Cancel" Click="() => _showFactoryResetConfirm = false" Disabled="@_factoryResetting" Variant="Variant.Outlined" />
            </RadzenStack>
        }

        @if (_factoryResetMessage is not null)
        {
            <RadzenText style="@(_factoryResetSuccess ? "color: green;" : "color: red;")" class="mt-2"><strong>@_factoryResetMessage</strong></RadzenText>
        }
    </RadzenCard>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    private KeyStorageProvider _keyStorageProvider;
    private bool _keyStorageProviderSuccess;
    private string? _keyStorageProviderMessage;

    private bool _showFactoryResetConfirm;
    private bool _factoryResetting;
    private bool _factoryResetSuccess;
    private string? _factoryResetMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                _keyStorageProvider = Config.KeyStorageProvider;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveKeyStorageProviderAsync()
    {
        (_keyStorageProviderSuccess, _keyStorageProviderMessage) = await ConfigTools.SetKeyStorageProviderAsync(Config, _keyStorageProvider, CancellationToken.None);
    }

    private async Task ConfirmFactoryResetAsync()
    {
        _factoryResetting = true;
        try
        {
            (_factoryResetSuccess, _factoryResetMessage) = await ConfigTools.FactoryResetAsync(CancellationToken.None);
        }
        finally
        {
            _factoryResetting = false;
            _showFactoryResetConfirm = false;
        }
    }
}
