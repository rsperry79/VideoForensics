@page "/settings/infrastructure"
@using VideoForensics.Client.Core.Tools
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject IForensicsConfiguration Config
@inject ConfigToolsOrchestrator ConfigTools
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SettingsInfrastructure> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        @L["NotSignedIn"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="@L["SignIn"]" /> @L["SignInToChangeSettings"]
    </RadzenAlert>
}
else
{
    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">@L["DataEncryptionSection"]</RadzenText>
    <RadzenAlert AlertStyle="AlertStyle.Warning" class="mb-4">
        <strong>@L["EncryptionWarning"]</strong>
    </RadzenAlert>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">@L["KeyStorageSection"]</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack Orientation="Orientation.Horizontal">
            <RadzenDropDown TValue="KeyStorageProvider" @bind-Value="_keyStorageProvider" Data="@(Enum.GetValues<KeyStorageProvider>())" Style="max-width: 260px;" />
            <RadzenButton Text="@L["SaveButton"]" Click="SaveKeyStorageProviderAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            @if (_keyStorageProviderMessage is not null)
            {
                <RadzenText style="@(_keyStorageProviderSuccess ? "color: green;" : "color: red;")">@_keyStorageProviderMessage</RadzenText>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">@L["FactoryResetSection"]</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        @if (!_showFactoryResetConfirm)
        {
            <RadzenButton Text="@L["FactoryResetButton"]" Click="() => _showFactoryResetConfirm = true" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" class="mb-2">
                <strong>@L["FactoryResetWarning"]</strong>
            </RadzenAlert>
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenButton Text="@L["ConfirmDelete"]" Click="ConfirmFactoryResetAsync" Disabled="@_factoryResetting" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Filled" />
                <RadzenButton Text="@L["CancelButton"]" Click="() => _showFactoryResetConfirm = false" Disabled="@_factoryResetting" Variant="Variant.Outlined" />
            </RadzenStack>
        }

        @if (_factoryResetMessage is not null)
        {
            <RadzenText style="@(_factoryResetSuccess ? "color: green;" : "color: red;")" class="mt-2"><strong>@_factoryResetMessage</strong></RadzenText>
        }
    </RadzenCard>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    private KeyStorageProvider _keyStorageProvider;
    private bool _keyStorageProviderSuccess;
    private string? _keyStorageProviderMessage;

    private bool _showFactoryResetConfirm;
    private bool _factoryResetting;
    private bool _factoryResetSuccess;
    private string? _factoryResetMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                _keyStorageProvider = Config.KeyStorageProvider;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveKeyStorageProviderAsync()
    {
        (_keyStorageProviderSuccess, _keyStorageProviderMessage) = await ConfigTools.SetKeyStorageProviderAsync(Config, _keyStorageProvider, CancellationToken.None);
    }

    private async Task ConfirmFactoryResetAsync()
    {
        _factoryResetting = true;
        try
        {
            (_factoryResetSuccess, _factoryResetMessage) = await ConfigTools.FactoryResetAsync(CancellationToken.None);
        }
        finally
        {
            _factoryResetting = false;
            _showFactoryResetConfirm = false;
        }
    }
}
