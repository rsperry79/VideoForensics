@page "/analyze/chain-of-custody"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ChainOfCustody> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Warning">@L["NotSignedIn"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="@L["SignIn"]" /> @L["SignInToViewChainOfCustody"]</RadzenAlert>
}
else
{
    <RadzenStack Orientation="Orientation.Vertical" Gap="0.5rem" Class="mb-4">
        <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceId" Data="@DeviceOptions"
            TextProperty="Value" ValueProperty="Key" Placeholder="@L["AllDevicesPlaceholder"]" />
        <label>@L["FromLabel"] <input type="date" @bind="_fromDate" /></label>
        <label>@L["ToLabel"] <input type="date" @bind="_toDate" /></label>
        <RadzenButton Text="@L["RunReport"]" Click="RunReportAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
    </RadzenStack>

    @if (_report is not null)
    {
        @if (_report.ChainIntegrityVerified)
        {
            <RadzenAlert AlertStyle="AlertStyle.Success">@L["ChainIntegrityVerified"]</RadzenAlert>
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@L["ChainIntegrityFailed", _report.ChainVerificationStatus]</RadzenAlert>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["AuditTrailTitle"]</RadzenText>
        @if (_report.AuditTrail.Count == 0)
        {
            <RadzenText>@L["NoAuditTrailFound"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_auditTrailFilter" TItem="ActionLogEntry" Data="@_report.AuditTrail" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="TimestampUtc" Title="@L["ColTimestamp"]" />
                    <RadzenDataFilterProperty Property="Actor" Title="@L["ColActor"]" />
                    <RadzenDataFilterProperty Property="ActorType" Title="@L["ColActorType"]" />
                    <RadzenDataFilterProperty Property="Action" Title="@L["ColAction"]" />
                    <RadzenDataFilterProperty Property="EntityType" Title="@L["ColEntityType"]" />
                    <RadzenDataFilterProperty Property="EntityId" Title="@L["ColEntityId"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="ActionLogEntry" Data="@_auditTrailFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="TimestampUtc" Title="@L["ColTimestamp"]" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="Actor" Title="@L["ColActor"]" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="ActorType" Title="@L["ColActorType"]" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="Action" Title="@L["ColAction"]" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Property="EntityType" Title="@L["ColEntityType"]" />
                    <RadzenDataGridColumn TItem="ActionLogEntry" Title="@L["ColEntityId"]">
                        <Template Context="entry">@(entry.EntityId?.ToString("N")[..8] ?? "-")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private ChainOfCustodyReport? _report;
    private RadzenDataFilter<ActionLogEntry>? _auditTrailFilter;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildChainOfCustodyReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
