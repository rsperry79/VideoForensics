@page "/analyze/chain-of-custody"
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository

<MudText Typo="Typo.h4" Class="mb-4">Chain of Custody Report</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudAlert Severity="Severity.Warning">You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to view the chain of custody.</MudAlert>
}
else
{
    <MudStack Row="false" Spacing="2" Class="mb-4">
        <MudSelect T="string" @bind-Value="_selectedDeviceId" Label="Device" Variant="Variant.Outlined">
            <MudSelectItem Value="@("")">(All devices)</MudSelectItem>
            @foreach (var device in _devices)
            {
                <MudSelectItem Value="@(device.Id.ToString())">@device.Name</MudSelectItem>
            }
        </MudSelect>
        <label>From: <input type="date" @bind="_fromDate" /></label>
        <label>To: <input type="date" @bind="_toDate" /></label>
        <MudButton OnClick="RunReportAsync" Variant="Variant.Filled" Color="Color.Primary">Run Report</MudButton>
    </MudStack>

    @if (_report is not null)
    {
        @if (_report.ChainIntegrityVerified)
        {
            <MudAlert Severity="Severity.Success">Chain integrity verified</MudAlert>
        }
        else
        {
            <MudAlert Severity="Severity.Error">Chain integrity FAILED: @_report.ChainVerificationStatus</MudAlert>
        }

        <MudText Typo="Typo.h5" Class="mt-4 mb-2">Audit Trail</MudText>
        @if (_report.AuditTrail.Count == 0)
        {
            <MudText>No audit trail entries found in this range.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true">
                <thead>
                    <tr>
                        <th>Timestamp</th>
                        <th>Actor</th>
                        <th>Actor Type</th>
                        <th>Action</th>
                        <th>Entity Type</th>
                        <th>Entity ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var entry in _report.AuditTrail)
                    {
                        <tr>
                            <td>@entry.TimestampUtc</td>
                            <td>@entry.Actor</td>
                            <td>@entry.ActorType</td>
                            <td>@entry.Action</td>
                            <td>@entry.EntityType</td>
                            <td>@(entry.EntityId?.ToString("N")[..8] ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private ChainOfCustodyReport? _report;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildChainOfCustodyReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
