@page "/analyze/jamming"
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Client.Core.Tools
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject JammingToolsOrchestrator JammingTools

<MudText Typo="Typo.h4" Class="mb-4">Jamming Analysis</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudAlert Severity="Severity.Info">
        You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to analyze jamming.
    </MudAlert>
}
else
{
    <MudStack Spacing="3" Class="mb-4">
        <MudSelect T="string" @bind-Value="_selectedDeviceIdStr" Label="Device" Variant="Variant.Outlined">
            <MudSelectItem Value="@("")">-- Select a device --</MudSelectItem>
            @foreach (var device in _devices)
            {
                <MudSelectItem Value="@device.Id.ToString()">@device.Name</MudSelectItem>
            }
        </MudSelect>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
            <input type="date" @bind="_fromDate" />
            <input type="date" @bind="_toDate" />
            <MudButton OnClick="AnalyzeAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_analyzing || string.IsNullOrEmpty(_selectedDeviceIdStr))">Analyze</MudButton>
        </MudStack>

        @if (!string.IsNullOrEmpty(_analyzeError))
        {
            <MudAlert Severity="Severity.Error">@_analyzeError</MudAlert>
        }
    </MudStack>

    @if (_report is not null)
    {
        <MudText><strong>@_report.Message</strong></MudText>

        @if (_report.Incidents.Count > 0)
        {
            <MudSimpleTable Hover="true" Dense="true">
                <thead>
                    <tr>
                        <th>Start</th>
                        <th>End</th>
                        <th>Affected Events</th>
                        <th>Avg Degradation (dB)</th>
                        <th>Confidence</th>
                        <th>Source</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var incident in _report.Incidents)
                    {
                        <tr>
                            <td>@incident.StartUtc</td>
                            <td>@incident.EndUtc</td>
                            <td>@incident.AffectedEventCount</td>
                            <td>@incident.AverageDegradationDb.ToString("F1")</td>
                            <td>@incident.Confidence</td>
                            <td>@incident.Source</td>
                            <td>@incident.Notes</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }

        <MudText Typo="Typo.h5" Class="mt-4 mb-2">Record Manual Incident</MudText>
        <MudStack Spacing="3" Class="mb-4">
            <div>
                <label for="startUtc">Start (UTC)</label>
                <input id="startUtc" type="datetime-local" @bind="_manualStartUtc" />
            </div>
            <div>
                <label for="endUtc">End (UTC)</label>
                <input id="endUtc" type="datetime-local" @bind="_manualEndUtc" />
            </div>
            <MudNumericField @bind-Value="_manualAffectedEventCount" Label="Affected Event Count" Variant="Variant.Outlined" />
            <MudNumericField @bind-Value="_manualAverageDegradationDb" Label="Average Degradation (dB)" Variant="Variant.Outlined" />
            <MudSelect T="JammingConfidenceLevel" @bind-Value="_manualConfidence" Label="Confidence" Variant="Variant.Outlined">
                @foreach (var level in Enum.GetValues<JammingConfidenceLevel>())
                {
                    <MudSelectItem Value="@level">@level</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_manualNotes" Label="Notes" Variant="Variant.Outlined" Lines="3" />
            <MudButton OnClick="RecordIncidentAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_recording">Record Incident</MudButton>

            @if (!string.IsNullOrEmpty(_recordMessage))
            {
                <MudAlert Severity="@(_recordSuccess == true ? Severity.Success : Severity.Error)">@_recordMessage</MudAlert>
            }
        </MudStack>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceIdStr = string.Empty;

    private DateTime _fromDate = DateTime.Today.AddDays(-90);
    private DateTime _toDate = DateTime.Today;

    private bool _analyzing;
    private string? _analyzeError;
    private JammingAnalysisReport? _report;

    private DateTime _manualStartUtc = DateTime.UtcNow.AddHours(-1);
    private DateTime _manualEndUtc = DateTime.UtcNow;
    private int _manualAffectedEventCount = 1;
    private double _manualAverageDegradationDb = 10;
    private JammingConfidenceLevel _manualConfidence = JammingConfidenceLevel.Low;
    private string _manualNotes = string.Empty;
    private bool _recording;
    private string? _recordMessage;
    private bool? _recordSuccess;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AnalyzeAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _analyzing = true;
        _analyzeError = null;
        try
        {
            _report = await JammingTools.AnalyzeJammingAsync(deviceId, _fromDate, _toDate, CancellationToken.None);
            if (!_report.Success)
            {
                _analyzeError = _report.ErrorMessage ?? "Analysis failed.";
            }
        }
        finally
        {
            _analyzing = false;
        }
    }

    private async Task RecordIncidentAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _recording = true;
        _recordMessage = null;
        _recordSuccess = null;
        try
        {
            var (success, message, _) = await JammingTools.RecordJammingIncidentAsync(
                deviceId,
                _manualStartUtc,
                _manualEndUtc,
                _manualAffectedEventCount,
                _manualAverageDegradationDb,
                _manualConfidence,
                string.IsNullOrWhiteSpace(_manualNotes) ? null : _manualNotes,
                CancellationToken.None);

            _recordSuccess = success;
            _recordMessage = message;

            if (success)
            {
                _report = await JammingTools.AnalyzeJammingAsync(deviceId, _fromDate, _toDate, CancellationToken.None);
            }
        }
        finally
        {
            _recording = false;
        }
    }
}
