@page "/analyze/jamming"
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Client.Core.Tools
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using Syncfusion.Blazor.QueryBuilder
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject JammingToolsOrchestrator JammingTools
@inject NavigationManager NavigationManager
@inject IStringLocalizer<JammingAnalysis> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToAnalyzeJamming"]
    </div>
}
else
{
    <PageRightPanelContent>
        <div class="right-panel-section">
            <small>@L["Title"]</small>
            <div class="d-flex flex-column gap-2">
                <SfDropDownList TValue="string" TItem="KeyValuePair<string,string>" @bind-Value="_selectedDeviceIdStr" DataSource="@(DeviceOptions.ToList())"
                    Placeholder="@L["SelectDevice"]"><DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings></SfDropDownList>
                <div class="d-flex flex-row gap-2">
                    <input type="date" @bind="_fromDate" />
                    <input type="date" @bind="_toDate" />
                    <SfButton Content="@L["Analyze"]" OnClick="AnalyzeAsync" CssClass="e-primary" Disabled="@(_analyzing || string.IsNullOrEmpty(_selectedDeviceIdStr))" />
                </div>

                @if (!string.IsNullOrEmpty(_analyzeError))
                {
                    <div class="alert alert-danger">@_analyzeError</div>
                }
            </div>
        </div>

        @if (_report is not null && _report.Incidents.Count > 0)
        {
            <div class="right-panel-section">
                <small>@L["ColStart"]</small>
                <SfQueryBuilder @ref="_incidentsFilter" TValue="JammingIncidentRecord">
                    <QueryBuilderColumns>
                        <QueryBuilderColumn Field="StartUtc" Label="@L["ColStart"]" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Date" />
                        <QueryBuilderColumn Field="EndUtc" Label="@L["ColEnd"]" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Date" />
                        <QueryBuilderColumn Field="AffectedEventCount" Label="@L["ColAffectedEvents"]" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Number" />
                        <QueryBuilderColumn Field="AverageDegradationDb" Label="@L["ColAvgDegradation"]" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Number" />
                        <QueryBuilderColumn Field="Confidence" Label="@L["ColConfidence"]" />
                        <QueryBuilderColumn Field="Source" Label="@L["ColSource"]" />
                        <QueryBuilderColumn Field="Notes" Label="@L["ColNotes"]" />
                    </QueryBuilderColumns>
                </SfQueryBuilder>
                <SfButton Content="@L["ApplyFilter"]" OnClick="@(() => ApplyIncidentsFilterAsync())" CssClass="e-primary mt-2" />
            </div>
        }
    </PageRightPanelContent>

    @if (_report is not null)
    {
        <span><strong>@_report.Message</strong></span>

        @if (_report.Incidents.Count > 0)
        {
            <SfGrid TValue="JammingIncidentRecord" DataSource="@_filteredIncidents" AllowSorting="true" AllowPaging="true">
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(JammingIncidentRecord.StartUtc)" HeaderText="@L["ColStart"]" />
                    <GridColumn Field="@nameof(JammingIncidentRecord.EndUtc)" HeaderText="@L["ColEnd"]" />
                    <GridColumn Field="@nameof(JammingIncidentRecord.AffectedEventCount)" HeaderText="@L["ColAffectedEvents"]" />
                    <GridColumn HeaderText="@L["ColAvgDegradation"]">
                        <Template>
                            @{
                                var incident = (JammingIncidentRecord)context;
                                @(incident.AverageDegradationDb.ToString("F1"))
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(JammingIncidentRecord.Confidence)" HeaderText="@L["ColConfidence"]" />
                    <GridColumn Field="@nameof(JammingIncidentRecord.Source)" HeaderText="@L["ColSource"]" />
                    <GridColumn Field="@nameof(JammingIncidentRecord.Notes)" HeaderText="@L["ColNotes"]" />
                </GridColumns>
            </SfGrid>
        }

        <h5 class="mt-4 mb-2">@L["RecordManualIncident"]</h5>
        <div class="d-flex flex-column gap-2">
            <div>
                <label for="startUtc">@L["LabelStartUtc"]</label>
                <input type="datetime-local" @bind="_manualStartUtc" />
            </div>
            <div>
                <label for="endUtc">@L["LabelEndUtc"]</label>
                <input type="datetime-local" @bind="_manualEndUtc" />
            </div>
            <div>
                <label>@L["LabelAffectedEventCount"]</label>
                <input type="number" @bind="_manualAffectedEventCount" />
            </div>
            <div>
                <label>@L["LabelAvgDegradation"]</label>
                <input type="number" step="0.1" @bind="_manualAverageDegradationDb" />
            </div>
            <SfDropDownList TValue="JammingConfidenceLevel" TItem="JammingConfidenceLevel" @bind-Value="_manualConfidence" DataSource="@(Enum.GetValues<JammingConfidenceLevel>().ToList())" />
            <textarea @bind="_manualNotes" rows="3" placeholder="@L["ColNotes"]" class="form-control"></textarea>
            <SfButton Content="@L["RecordIncident"]" OnClick="RecordIncidentAsync" CssClass="e-primary" Disabled="@_recording" />

            @if (!string.IsNullOrEmpty(_recordMessage))
            {
                <div class="alert @(_recordSuccess == true ? "alert-success" : "alert-danger")">@_recordMessage</div>
            }
        </div>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceIdStr = string.Empty;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    private DateTime _fromDate = DateTime.Today.AddDays(-90);
    private DateTime _toDate = DateTime.Today;

    private bool _analyzing;
    private string? _analyzeError;
    private JammingAnalysisReport? _report;
    private SfQueryBuilder<JammingIncidentRecord>? _incidentsFilter;
    private IEnumerable<JammingIncidentRecord> _filteredIncidents = new List<JammingIncidentRecord>();

    private DateTime _manualStartUtc = DateTime.UtcNow.AddHours(-1);
    private DateTime _manualEndUtc = DateTime.UtcNow;
    private int _manualAffectedEventCount = 1;
    private double _manualAverageDegradationDb = 10;
    private JammingConfidenceLevel _manualConfidence = JammingConfidenceLevel.Low;
    private string _manualNotes = string.Empty;
    private bool _recording;
    private string? _recordMessage;
    private bool? _recordSuccess;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AnalyzeAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _analyzing = true;
        _analyzeError = null;
        try
        {
            _report = await JammingTools.AnalyzeJammingAsync(deviceId, _fromDate, _toDate, CancellationToken.None);
            if (!_report.Success)
            {
                _analyzeError = _report.ErrorMessage ?? L["AnalysisFailed"].Value;
            }
            else if (_report.Incidents.Count > 0)
            {
                _filteredIncidents = _report.Incidents;
            }
        }
        finally
        {
            _analyzing = false;
        }
    }

    private async Task ApplyIncidentsFilterAsync()
    {
        if (_incidentsFilter is not null && _report?.Incidents is not null)
        {
            var result = await _incidentsFilter.GetFilteredRecordsAsync();
            _filteredIncidents = result?.ToList() ?? _report.Incidents;
        }
    }

    private async Task RecordIncidentAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _recording = true;
        _recordMessage = null;
        _recordSuccess = null;
        try
        {
            var (success, message, _) = await JammingTools.RecordJammingIncidentAsync(
                deviceId,
                _manualStartUtc,
                _manualEndUtc,
                _manualAffectedEventCount,
                _manualAverageDegradationDb,
                _manualConfidence,
                string.IsNullOrWhiteSpace(_manualNotes) ? null : _manualNotes,
                CancellationToken.None);

            _recordSuccess = success;
            _recordMessage = message;

            if (success)
            {
                _report = await JammingTools.AnalyzeJammingAsync(deviceId, _fromDate, _toDate, CancellationToken.None);
                if (_report?.Incidents.Count > 0)
                {
                    _filteredIncidents = _report.Incidents;
                }
            }
        }
        finally
        {
            _recording = false;
        }
    }
}
