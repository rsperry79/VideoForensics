@page "/analyze/jamming"
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Client.Core.Tools
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject JammingToolsOrchestrator JammingTools
@inject NavigationManager NavigationManager
@inject IStringLocalizer<JammingAnalysis> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        @L["NotSignedIn"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="@L["SignIn"]" /> @L["SignInToAnalyzeJamming"]
    </RadzenAlert>
}
else
{
    <RadzenStack>
        <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceIdStr" Data="@DeviceOptions"
            TextProperty="Value" ValueProperty="Key" Placeholder="@L["SelectDevice"]" />
        <RadzenStack Orientation="Orientation.Horizontal">
            <input type="date" @bind="_fromDate" />
            <input type="date" @bind="_toDate" />
            <RadzenButton Text="@L["Analyze"]" Click="AnalyzeAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" Disabled="@(_analyzing || string.IsNullOrEmpty(_selectedDeviceIdStr))" />
        </RadzenStack>

        @if (!string.IsNullOrEmpty(_analyzeError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@_analyzeError</RadzenAlert>
        }
    </RadzenStack>

    @if (_report is not null)
    {
        <RadzenText><strong>@_report.Message</strong></RadzenText>

        @if (_report.Incidents.Count > 0)
        {
            <RadzenDataFilter @ref="_incidentsFilter" TItem="JammingIncidentRecord" Data="@_report.Incidents" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="StartUtc" Title="@L["ColStart"]" />
                    <RadzenDataFilterProperty Property="EndUtc" Title="@L["ColEnd"]" />
                    <RadzenDataFilterProperty Property="AffectedEventCount" Title="@L["ColAffectedEvents"]" />
                    <RadzenDataFilterProperty Property="AverageDegradationDb" Title="@L["ColAvgDegradation"]" />
                    <RadzenDataFilterProperty Property="Confidence" Title="@L["ColConfidence"]" />
                    <RadzenDataFilterProperty Property="Source" Title="@L["ColSource"]" />
                    <RadzenDataFilterProperty Property="Notes" Title="@L["ColNotes"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="JammingIncidentRecord" Data="@_incidentsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="JammingIncidentRecord" Property="StartUtc" Title="@L["ColStart"]" />
                    <RadzenDataGridColumn TItem="JammingIncidentRecord" Property="EndUtc" Title="@L["ColEnd"]" />
                    <RadzenDataGridColumn TItem="JammingIncidentRecord" Property="AffectedEventCount" Title="@L["ColAffectedEvents"]" />
                    <RadzenDataGridColumn TItem="JammingIncidentRecord" Title="@L["ColAvgDegradation"]">
                        <Template Context="incident">@incident.AverageDegradationDb.ToString("F1")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="JammingIncidentRecord" Property="Confidence" Title="@L["ColConfidence"]" />
                    <RadzenDataGridColumn TItem="JammingIncidentRecord" Property="Source" Title="@L["ColSource"]" />
                    <RadzenDataGridColumn TItem="JammingIncidentRecord" Property="Notes" Title="@L["ColNotes"]" />
                </Columns>
            </RadzenDataGrid>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["RecordManualIncident"]</RadzenText>
        <RadzenStack>
            <div>
                <label for="startUtc">@L["LabelStartUtc"]</label>
                <RadzenDatePicker TValue="DateTime" @bind-Value="_manualStartUtc" ShowTime="true" />
            </div>
            <div>
                <label for="endUtc">@L["LabelEndUtc"]</label>
                <RadzenDatePicker TValue="DateTime" @bind-Value="_manualEndUtc" ShowTime="true" />
            </div>
            <div>
                <label>@L["LabelAffectedEventCount"]</label>
                <RadzenNumeric TValue="int" @bind-Value="_manualAffectedEventCount" />
            </div>
            <div>
                <label>@L["LabelAvgDegradation"]</label>
                <RadzenNumeric TValue="double" @bind-Value="_manualAverageDegradationDb" />
            </div>
            <RadzenDropDown TValue="JammingConfidenceLevel" @bind-Value="_manualConfidence" Data="@(Enum.GetValues<JammingConfidenceLevel>())" />
            <RadzenTextArea @bind-Value="_manualNotes" Rows="3" Placeholder="@L["ColNotes"]" />
            <RadzenButton Text="@L["RecordIncident"]" Click="RecordIncidentAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" Disabled="@_recording" />

            @if (!string.IsNullOrEmpty(_recordMessage))
            {
                <RadzenAlert AlertStyle="@(_recordSuccess == true ? AlertStyle.Success : AlertStyle.Danger)">@_recordMessage</RadzenAlert>
            }
        </RadzenStack>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceIdStr = string.Empty;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    private DateTime _fromDate = DateTime.Today.AddDays(-90);
    private DateTime _toDate = DateTime.Today;

    private bool _analyzing;
    private string? _analyzeError;
    private JammingAnalysisReport? _report;
    private RadzenDataFilter<JammingIncidentRecord>? _incidentsFilter;

    private DateTime _manualStartUtc = DateTime.UtcNow.AddHours(-1);
    private DateTime _manualEndUtc = DateTime.UtcNow;
    private int _manualAffectedEventCount = 1;
    private double _manualAverageDegradationDb = 10;
    private JammingConfidenceLevel _manualConfidence = JammingConfidenceLevel.Low;
    private string _manualNotes = string.Empty;
    private bool _recording;
    private string? _recordMessage;
    private bool? _recordSuccess;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AnalyzeAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _analyzing = true;
        _analyzeError = null;
        try
        {
            _report = await JammingTools.AnalyzeJammingAsync(deviceId, _fromDate, _toDate, CancellationToken.None);
            if (!_report.Success)
            {
                _analyzeError = _report.ErrorMessage ?? L["AnalysisFailed"].Value;
            }
        }
        finally
        {
            _analyzing = false;
        }
    }

    private async Task RecordIncidentAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _recording = true;
        _recordMessage = null;
        _recordSuccess = null;
        try
        {
            var (success, message, _) = await JammingTools.RecordJammingIncidentAsync(
                deviceId,
                _manualStartUtc,
                _manualEndUtc,
                _manualAffectedEventCount,
                _manualAverageDegradationDb,
                _manualConfidence,
                string.IsNullOrWhiteSpace(_manualNotes) ? null : _manualNotes,
                CancellationToken.None);

            _recordSuccess = success;
            _recordMessage = message;

            if (success)
            {
                _report = await JammingTools.AnalyzeJammingAsync(deviceId, _fromDate, _toDate, CancellationToken.None);
            }
        }
        finally
        {
            _recording = false;
        }
    }
}
