@page "/analyze/jamming"
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Client.Core.Tools
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject JammingToolsOrchestrator JammingTools
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Jamming Analysis</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        You are not signed in. <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="Sign in" /> to analyze jamming.
    </RadzenAlert>
}
else
{
    <RadzenStack>
        <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceIdStr" Data="@DeviceOptions"
            TextProperty="Value" ValueProperty="Key" Placeholder="-- Select a device --" />
        <RadzenStack Orientation="Orientation.Horizontal">
            <input type="date" @bind="_fromDate" />
            <input type="date" @bind="_toDate" />
            <RadzenButton Text="Analyze" Click="AnalyzeAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" Disabled="@(_analyzing || string.IsNullOrEmpty(_selectedDeviceIdStr))" />
        </RadzenStack>

        @if (!string.IsNullOrEmpty(_analyzeError))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@_analyzeError</RadzenAlert>
        }
    </RadzenStack>

    @if (_report is not null)
    {
        <RadzenText><strong>@_report.Message</strong></RadzenText>

        @if (_report.Incidents.Count > 0)
        {
            <table>
                <thead>
                    <tr>
                        <th>Start</th>
                        <th>End</th>
                        <th>Affected Events</th>
                        <th>Avg Degradation (dB)</th>
                        <th>Confidence</th>
                        <th>Source</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var incident in _report.Incidents)
                    {
                        <tr>
                            <td>@incident.StartUtc</td>
                            <td>@incident.EndUtc</td>
                            <td>@incident.AffectedEventCount</td>
                            <td>@incident.AverageDegradationDb.ToString("F1")</td>
                            <td>@incident.Confidence</td>
                            <td>@incident.Source</td>
                            <td>@incident.Notes</td>
                        </tr>
                    }
                </tbody>
            </table>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Record Manual Incident</RadzenText>
        <RadzenStack>
            <div>
                <label for="startUtc">Start (UTC)</label>
                <RadzenDatePicker TValue="DateTime" @bind-Value="_manualStartUtc" ShowTime="true" />
            </div>
            <div>
                <label for="endUtc">End (UTC)</label>
                <RadzenDatePicker TValue="DateTime" @bind-Value="_manualEndUtc" ShowTime="true" />
            </div>
            <div>
                <label>Affected Event Count</label>
                <RadzenNumeric TValue="int" @bind-Value="_manualAffectedEventCount" />
            </div>
            <div>
                <label>Average Degradation (dB)</label>
                <RadzenNumeric TValue="double" @bind-Value="_manualAverageDegradationDb" />
            </div>
            <RadzenDropDown TValue="JammingConfidenceLevel" @bind-Value="_manualConfidence" Data="@(Enum.GetValues<JammingConfidenceLevel>())" />
            <RadzenTextArea @bind-Value="_manualNotes" Rows="3" Placeholder="Notes" />
            <RadzenButton Text="Record Incident" Click="RecordIncidentAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" Disabled="@_recording" />

            @if (!string.IsNullOrEmpty(_recordMessage))
            {
                <RadzenAlert AlertStyle="@(_recordSuccess == true ? AlertStyle.Success : AlertStyle.Danger)">@_recordMessage</RadzenAlert>
            }
        </RadzenStack>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceIdStr = string.Empty;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    private DateTime _fromDate = DateTime.Today.AddDays(-90);
    private DateTime _toDate = DateTime.Today;

    private bool _analyzing;
    private string? _analyzeError;
    private JammingAnalysisReport? _report;

    private DateTime _manualStartUtc = DateTime.UtcNow.AddHours(-1);
    private DateTime _manualEndUtc = DateTime.UtcNow;
    private int _manualAffectedEventCount = 1;
    private double _manualAverageDegradationDb = 10;
    private JammingConfidenceLevel _manualConfidence = JammingConfidenceLevel.Low;
    private string _manualNotes = string.Empty;
    private bool _recording;
    private string? _recordMessage;
    private bool? _recordSuccess;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AnalyzeAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _analyzing = true;
        _analyzeError = null;
        try
        {
            _report = await JammingTools.AnalyzeJammingAsync(deviceId, _fromDate, _toDate, CancellationToken.None);
            if (!_report.Success)
            {
                _analyzeError = _report.ErrorMessage ?? "Analysis failed.";
            }
        }
        finally
        {
            _analyzing = false;
        }
    }

    private async Task RecordIncidentAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _recording = true;
        _recordMessage = null;
        _recordSuccess = null;
        try
        {
            var (success, message, _) = await JammingTools.RecordJammingIncidentAsync(
                deviceId,
                _manualStartUtc,
                _manualEndUtc,
                _manualAffectedEventCount,
                _manualAverageDegradationDb,
                _manualConfidence,
                string.IsNullOrWhiteSpace(_manualNotes) ? null : _manualNotes,
                CancellationToken.None);

            _recordSuccess = success;
            _recordMessage = message;

            if (success)
            {
                _report = await JammingTools.AnalyzeJammingAsync(deviceId, _fromDate, _toDate, CancellationToken.None);
            }
        }
        finally
        {
            _recording = false;
        }
    }
}
