@page "/settings/notifications"
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using Syncfusion.Blazor.QueryBuilder
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject IStringLocalizer<Notifications> L

<h4 class="mb-4">@L["Title"]</h4>

@if (!SessionState.IsSignedIn)
{
    <div class="alert alert-info mb-4">
        <a href="/device-signin">@L["SignInWithPasskey"]</a> @L["ToManageNotifications"]
    </div>
}

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_authError is not null)
{
    <div class="alert alert-danger mb-2">@_authError</div>
    <p>
        @L["NotAuthorized"] <a href="/device-signin">@L["SignInWithPasskey"]</a> @L["SignInRequired"]
    </p>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else
{
    <h6 class="mt-4 mb-2">@L["EmailSection"]</h6>
    <div class="card border pa-4 mb-4">
        <div class="d-flex flex-column gap-2">
            <p>
                @L["EmailDescription"]
            </p>
            <SfCheckBox TChecked="bool" @bind-Checked="_enableEmail" Label="@L["EnableEmailNotifications"].Value" />
            <div class="d-flex flex-row gap-2">
                <div>
                    <label>@L["LabelSmtpHost"]</label>
                    <input type="text" class="form-control" @bind="_smtpHost" style="max-width: 260px;" />
                </div>
                <div>
                    <label>@L["LabelPort"]</label>
                    <input type="number" class="form-control" @bind="_smtpPort" style="max-width: 120px;" />
                </div>
                <SfCheckBox TChecked="bool" @bind-Checked="_smtpUseTls" Label="@L["LabelUseStarttls"].Value" />
            </div>
            <div class="d-flex flex-row gap-2">
                <div>
                    <label>@L["LabelSmtpUsername"]</label>
                    <input type="text" class="form-control" @bind="_smtpUsername" style="max-width: 260px;" />
                </div>
                <div>
                    <label>@L["LabelSmtpPassword"]</label>
                    <input type="password" class="form-control" @bind="_smtpPassword" placeholder="@L["PlaceholderPassword"]" style="max-width: 260px;" />
                </div>
            </div>
            <div class="d-flex flex-row gap-2">
                <div>
                    <label>@L["LabelFromAddress"]</label>
                    <input type="text" class="form-control" @bind="_smtpFromAddress" style="max-width: 300px;" />
                </div>
                <div>
                    <label>@L["LabelNotifyAddress"]</label>
                    <input type="text" class="form-control" @bind="_recipientEmail" style="max-width: 300px;" />
                </div>
            </div>
            <div class="d-flex flex-row gap-2">
                <SfButton Content="@(_isSaving ? L["SavingButton"] : L["SaveButton"])" OnClick="SaveSettingsAsync" CssClass="e-primary" Disabled="@_isSaving" />
                <SfButton Content="@(_isSendingTest ? L["SendingTestButton"] : L["SendTestEmailButton"])" OnClick="SendTestEmailAsync" CssClass="e-flat" Disabled="@_isSendingTest" />
            </div>
            @if (_settingsMessage is not null)
            {
                <span style="color: @(_settingsSuccess ? "#4caf50" : "#f44336")">@_settingsMessage</span>
            }
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["UrgentEventOverrides"]</h6>
    <div class="card border pa-4 mb-4">
        <p class="mb-2">
            @L["UrgencyDescription"]
        </p>
        @if (_urgencyRows.Count == 0)
        {
            <p>@L["NoEventTypes"]</p>
        }
        else
        {
            <PageRightPanelContent>
                <div class="right-panel-section">
                    <small>@L["UrgentEventOverrides"]</small>
                    <SfQueryBuilder @ref="_urgencyRowsFilter" TValue="UrgencyRow" class="mb-2">
                        <QueryBuilderColumns>
                            <QueryBuilderColumn Field="EventType" Label="@L["ColEventType"]" />
                            <QueryBuilderColumn Field="DefaultUrgent" Label="@L["ColDefault"]" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" />
                            <QueryBuilderColumn Field="EffectiveUrgent" Label="@L["ColEffective"]" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" />
                        </QueryBuilderColumns>
                    </SfQueryBuilder>
                    <SfButton Content="@L["ApplyFilter"]" OnClick="@(() => ApplyUrgencyFilterAsync())" CssClass="e-primary mt-2" />
                </div>
            </PageRightPanelContent>
            <SfGrid TValue="UrgencyRow" DataSource="@_filteredUrgencyRows" AllowSorting="true" AllowPaging="true">
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(UrgencyRow.EventType)" HeaderText="@L["ColEventType"]" />
                    <GridColumn HeaderText="@L["ColDefault"]" AllowSorting="false" AllowFiltering="false">
                        <Template>
                            @{
                                var row = (UrgencyRow)context;
                                @(row.DefaultUrgent ? L["Urgent"] : L["Routine"])
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColEffective"]" AllowSorting="false" AllowFiltering="false">
                        <Template>
                            @{
                                var row = (UrgencyRow)context;
                                <label><SfCheckBox TChecked="bool" Checked="@row.EffectiveUrgent" CheckedChanged="@(v => SetOverrideAsync(row.EventType, v))" /> @(row.EffectiveUrgent ? L["Urgent"] : L["Routine"])</label>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="" AllowSorting="false" AllowFiltering="false">
                        <Template>
                            @{
                                var row = (UrgencyRow)context;
                                @if (row.OverrideUrgent is not null)
                                {
                                    <SfButton Content="@L["ResetToDefault"]" OnClick="@(() => ClearOverrideAsync(row.EventType))" CssClass="e-flat" />
                                }
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        }
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSendingTest;
    private string? _authError;
    private string? _loadError;
    private string? _settingsMessage;
    private bool _settingsSuccess;

    private bool _enableEmail;
    private string _smtpHost = "";
    private int _smtpPort = 587;
    private bool _smtpUseTls = true;
    private string _smtpUsername = "";
    private string _smtpPassword = "";
    private string _smtpFromAddress = "";
    private string _recipientEmail = "";

    private record UrgencyRow(string EventType, bool DefaultUrgent, bool? OverrideUrgent, bool EffectiveUrgent);
    private List<UrgencyRow> _urgencyRows = new();
    private SfQueryBuilder<UrgencyRow>? _urgencyRowsFilter;
    private IEnumerable<UrgencyRow> _filteredUrgencyRows = new List<UrgencyRow>();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        try
        {
            var client = CreateClient();

            var settingsResponse = await client.GetAsync("api/notifications/settings");
            if (settingsResponse.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = L["NotAuthorizedToView"];
                return;
            }

            settingsResponse.EnsureSuccessStatusCode();
            var settings = await settingsResponse.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            _enableEmail = settings.GetProperty("enableEmailNotifications").GetBoolean();
            _smtpHost = settings.GetProperty("smtpHost").GetString() ?? "";
            _smtpPort = settings.GetProperty("smtpPort").GetInt32();
            _smtpUseTls = settings.GetProperty("smtpUseTls").GetBoolean();
            _smtpUsername = settings.GetProperty("smtpUsername").GetString() ?? "";
            _smtpFromAddress = settings.GetProperty("smtpFromAddress").GetString() ?? "";
            _recipientEmail = settings.GetProperty("notificationRecipientEmail").GetString() ?? "";
            _smtpPassword = "";

            var overridesResponse = await client.GetAsync("api/notifications/urgency-overrides");
            if (overridesResponse.IsSuccessStatusCode)
            {
                var rows = await overridesResponse.Content.ReadFromJsonAsync<List<System.Text.Json.JsonElement>>();
                _urgencyRows = (rows ?? new()).Select(r => new UrgencyRow(
                    r.GetProperty("eventType").GetString()!,
                    r.GetProperty("defaultUrgent").GetBoolean(),
                    r.GetProperty("overrideUrgent").ValueKind == System.Text.Json.JsonValueKind.Null ? null : r.GetProperty("overrideUrgent").GetBoolean(),
                    r.GetProperty("effectiveUrgent").GetBoolean()
                )).ToList();
                _filteredUrgencyRows = _urgencyRows;
            }
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToLoadSettings", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveSettingsAsync()
    {
        _isSaving = true;
        _settingsMessage = null;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsJsonAsync("api/notifications/settings", new
            {
                enableEmailNotifications = _enableEmail,
                smtpHost = _smtpHost,
                smtpPort = _smtpPort,
                smtpUseTls = _smtpUseTls,
                smtpUsername = _smtpUsername,
                smtpPassword = string.IsNullOrEmpty(_smtpPassword) ? null : _smtpPassword,
                smtpFromAddress = _smtpFromAddress,
                notificationRecipientEmail = _recipientEmail
            });

            if (!response.IsSuccessStatusCode)
            {
                _settingsSuccess = false;
                _settingsMessage = L["SaveFailed", response.StatusCode.ToString()];
                return;
            }

            _smtpPassword = "";
            _settingsSuccess = true;
            _settingsMessage = L["Saved"];
        }
        catch (Exception ex)
        {
            _settingsSuccess = false;
            _settingsMessage = L["SaveFailed", ex.Message];
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SendTestEmailAsync()
    {
        _isSendingTest = true;
        _settingsMessage = null;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsync("api/notifications/test-email", null);
            if (!response.IsSuccessStatusCode)
            {
                var body = await SafeReadErrorAsync(response);
                _settingsSuccess = false;
                _settingsMessage = body ?? L["TestEmailFailed", response.StatusCode.ToString()];
                return;
            }

            _settingsSuccess = true;
            _settingsMessage = L["TestEmailSent"];
        }
        catch (Exception ex)
        {
            _settingsSuccess = false;
            _settingsMessage = L["TestEmailFailed", ex.Message];
        }
        finally
        {
            _isSendingTest = false;
        }
    }

    private async Task SetOverrideAsync(string eventType, bool isUrgent)
    {
        try
        {
            var client = CreateClient();
            await client.PostAsJsonAsync("api/notifications/urgency-overrides/set", new { eventType, isUrgent });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _settingsSuccess = false;
            _settingsMessage = L["FailedToUpdateOverride", ex.Message];
        }
    }

    private async Task ClearOverrideAsync(string eventType)
    {
        try
        {
            var client = CreateClient();
            await client.PostAsJsonAsync("api/notifications/urgency-overrides/clear", new { eventType });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _settingsSuccess = false;
            _settingsMessage = L["FailedToClearOverride", ex.Message];
        }
    }

    private async Task ApplyUrgencyFilterAsync()
    {
        if (_urgencyRowsFilter is not null)
        {
            var result = await _urgencyRowsFilter.GetFilteredRecordsAsync();
            _filteredUrgencyRows = result?.ToList() ?? _urgencyRows;
        }
    }

    private static async Task<string?> SafeReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var doc = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            return doc is not null && doc.TryGetValue("error", out var msg) ? msg : null;
        }
        catch
        {
            return null;
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }
}
