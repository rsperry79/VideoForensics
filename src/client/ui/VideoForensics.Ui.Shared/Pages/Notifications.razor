@page "/settings/notifications"
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject IStringLocalizer<Notifications> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (!SessionState.IsSignedIn)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" class="mb-4">
        <RadzenLink Path="/device-signin" Text="@L["SignInWithPasskey"]" /> @L["ToManageNotifications"]
    </RadzenAlert>
}

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (_authError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" class="mb-2">@_authError</RadzenAlert>
    <RadzenText>
        @L["NotAuthorized"] <RadzenLink Path="/device-signin" Text="@L["SignInWithPasskey"]" /> @L["SignInRequired"]
    </RadzenText>
}
else if (_loadError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">@_loadError</RadzenAlert>
}
else
{
    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">@L["EmailSection"]</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack>
            <RadzenText>
                @L["EmailDescription"]
            </RadzenText>
            <label><RadzenCheckBox TValue="bool" @bind-Value="_enableEmail" /> @L["EnableEmailNotifications"]</label>
            <RadzenStack Orientation="Orientation.Horizontal">
                <div>
                    <label>@L["LabelSmtpHost"]</label>
                    <RadzenTextBox @bind-Value="_smtpHost" style="max-width: 260px;" />
                </div>
                <div>
                    <label>@L["LabelPort"]</label>
                    <RadzenNumeric TValue="int" @bind-Value="_smtpPort" style="max-width: 120px;" />
                </div>
                <label><RadzenCheckBox TValue="bool" @bind-Value="_smtpUseTls" /> @L["LabelUseStarttls"]</label>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal">
                <div>
                    <label>@L["LabelSmtpUsername"]</label>
                    <RadzenTextBox @bind-Value="_smtpUsername" style="max-width: 260px;" />
                </div>
                <div>
                    <label>@L["LabelSmtpPassword"]</label>
                    <input type="password" @bind="_smtpPassword" placeholder="@L["PlaceholderPassword"]" style="max-width: 260px;" />
                </div>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal">
                <div>
                    <label>@L["LabelFromAddress"]</label>
                    <RadzenTextBox @bind-Value="_smtpFromAddress" style="max-width: 300px;" />
                </div>
                <div>
                    <label>@L["LabelNotifyAddress"]</label>
                    <RadzenTextBox @bind-Value="_recipientEmail" style="max-width: 300px;" />
                </div>
            </RadzenStack>
            <RadzenStack Orientation="Orientation.Horizontal">
                <RadzenButton Text="@(_isSaving ? L["SavingButton"] : L["SaveButton"])" Click="SaveSettingsAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" Disabled="@_isSaving" />
                <RadzenButton Text="@(_isSendingTest ? L["SendingTestButton"] : L["SendTestEmailButton"])" Click="SendTestEmailAsync" Variant="Variant.Outlined" Disabled="@_isSendingTest" />
            </RadzenStack>
            @if (_settingsMessage is not null)
            {
                <span style="color: @(_settingsSuccess ? "#4caf50" : "#f44336")">@_settingsMessage</span>
            }
        </RadzenStack>
    </RadzenCard>

    <RadzenText TextStyle="TextStyle.H6" class="mt-4 mb-2">@L["UrgentEventOverrides"]</RadzenText>
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenText class="mb-2">
            @L["UrgencyDescription"]
        </RadzenText>
        @if (_urgencyRows.Count == 0)
        {
            <RadzenText>@L["NoEventTypes"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_urgencyRowsFilter" TItem="UrgencyRow" Data="@_urgencyRows" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="EventType" Title="@L["ColEventType"]" />
                    <RadzenDataFilterProperty Property="DefaultUrgent" Title="@L["ColDefault"]" />
                    <RadzenDataFilterProperty Property="EffectiveUrgent" Title="@L["ColEffective"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="UrgencyRow" Data="@_urgencyRowsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
                <Columns>
                    <RadzenDataGridColumn TItem="UrgencyRow" Property="EventType" Title="@L["ColEventType"]" />
                    <RadzenDataGridColumn TItem="UrgencyRow" Title="@L["ColDefault"]" Sortable="false" Filterable="false">
                        <Template Context="context">@(context.DefaultUrgent ? L["Urgent"] : L["Routine"])</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="UrgencyRow" Title="@L["ColEffective"]" Sortable="false" Filterable="false">
                        <Template Context="context">
                            <label><RadzenCheckBox TValue="bool" Value="@context.EffectiveUrgent" ValueChanged="@(v => SetOverrideAsync(context.EventType, v))" /> @(context.EffectiveUrgent ? L["Urgent"] : L["Routine"])</label>
                        </Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="UrgencyRow" Title="" Sortable="false" Filterable="false">
                        <Template Context="context">
                            @if (context.OverrideUrgent is not null)
                            {
                                <RadzenButton Text="@L["ResetToDefault"]" Click="@(() => ClearOverrideAsync(context.EventType))" Variant="Variant.Text" />
                            }
                        </Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    </RadzenCard>
}

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isSendingTest;
    private string? _authError;
    private string? _loadError;
    private string? _settingsMessage;
    private bool _settingsSuccess;

    private bool _enableEmail;
    private string _smtpHost = "";
    private int _smtpPort = 587;
    private bool _smtpUseTls = true;
    private string _smtpUsername = "";
    private string _smtpPassword = "";
    private string _smtpFromAddress = "";
    private string _recipientEmail = "";

    private record UrgencyRow(string EventType, bool DefaultUrgent, bool? OverrideUrgent, bool EffectiveUrgent);
    private List<UrgencyRow> _urgencyRows = new();
    private RadzenDataFilter<UrgencyRow>? _urgencyRowsFilter;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        try
        {
            var client = CreateClient();

            var settingsResponse = await client.GetAsync("api/notifications/settings");
            if (settingsResponse.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = L["NotAuthorizedToView"];
                return;
            }

            settingsResponse.EnsureSuccessStatusCode();
            var settings = await settingsResponse.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            _enableEmail = settings.GetProperty("enableEmailNotifications").GetBoolean();
            _smtpHost = settings.GetProperty("smtpHost").GetString() ?? "";
            _smtpPort = settings.GetProperty("smtpPort").GetInt32();
            _smtpUseTls = settings.GetProperty("smtpUseTls").GetBoolean();
            _smtpUsername = settings.GetProperty("smtpUsername").GetString() ?? "";
            _smtpFromAddress = settings.GetProperty("smtpFromAddress").GetString() ?? "";
            _recipientEmail = settings.GetProperty("notificationRecipientEmail").GetString() ?? "";
            _smtpPassword = "";

            var overridesResponse = await client.GetAsync("api/notifications/urgency-overrides");
            if (overridesResponse.IsSuccessStatusCode)
            {
                var rows = await overridesResponse.Content.ReadFromJsonAsync<List<System.Text.Json.JsonElement>>();
                _urgencyRows = (rows ?? new()).Select(r => new UrgencyRow(
                    r.GetProperty("eventType").GetString()!,
                    r.GetProperty("defaultUrgent").GetBoolean(),
                    r.GetProperty("overrideUrgent").ValueKind == System.Text.Json.JsonValueKind.Null ? null : r.GetProperty("overrideUrgent").GetBoolean(),
                    r.GetProperty("effectiveUrgent").GetBoolean()
                )).ToList();
            }
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToLoadSettings", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveSettingsAsync()
    {
        _isSaving = true;
        _settingsMessage = null;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsJsonAsync("api/notifications/settings", new
            {
                enableEmailNotifications = _enableEmail,
                smtpHost = _smtpHost,
                smtpPort = _smtpPort,
                smtpUseTls = _smtpUseTls,
                smtpUsername = _smtpUsername,
                smtpPassword = string.IsNullOrEmpty(_smtpPassword) ? null : _smtpPassword,
                smtpFromAddress = _smtpFromAddress,
                notificationRecipientEmail = _recipientEmail
            });

            if (!response.IsSuccessStatusCode)
            {
                _settingsSuccess = false;
                _settingsMessage = L["SaveFailed", response.StatusCode.ToString()];
                return;
            }

            _smtpPassword = "";
            _settingsSuccess = true;
            _settingsMessage = L["Saved"];
        }
        catch (Exception ex)
        {
            _settingsSuccess = false;
            _settingsMessage = L["SaveFailed", ex.Message];
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SendTestEmailAsync()
    {
        _isSendingTest = true;
        _settingsMessage = null;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsync("api/notifications/test-email", null);
            if (!response.IsSuccessStatusCode)
            {
                var body = await SafeReadErrorAsync(response);
                _settingsSuccess = false;
                _settingsMessage = body ?? L["TestEmailFailed", response.StatusCode.ToString()];
                return;
            }

            _settingsSuccess = true;
            _settingsMessage = L["TestEmailSent"];
        }
        catch (Exception ex)
        {
            _settingsSuccess = false;
            _settingsMessage = L["TestEmailFailed", ex.Message];
        }
        finally
        {
            _isSendingTest = false;
        }
    }

    private async Task SetOverrideAsync(string eventType, bool isUrgent)
    {
        try
        {
            var client = CreateClient();
            await client.PostAsJsonAsync("api/notifications/urgency-overrides/set", new { eventType, isUrgent });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _settingsSuccess = false;
            _settingsMessage = L["FailedToUpdateOverride", ex.Message];
        }
    }

    private async Task ClearOverrideAsync(string eventType)
    {
        try
        {
            var client = CreateClient();
            await client.PostAsJsonAsync("api/notifications/urgency-overrides/clear", new { eventType });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _settingsSuccess = false;
            _settingsMessage = L["FailedToClearOverride", ex.Message];
        }
    }

    private static async Task<string?> SafeReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var doc = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            return doc is not null && doc.TryGetValue("error", out var msg) ? msg : null;
        }
        catch
        {
            return null;
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }
}
