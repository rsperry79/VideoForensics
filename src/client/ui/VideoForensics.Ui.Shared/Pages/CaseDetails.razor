@page "/cases/{CaseId:guid}"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Ui.Shared.Components.Inspector
@using VideoForensics.Ui.Shared.Components.Scope
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Services.Cases
@using VideoForensics.Ui.Shared.Services.Inspector
@using VideoForensics.Ui.Shared.Services.Scope
@implements IAsyncDisposable
@inject ICaseRepository CaseRepository
@inject IDeviceRepository DeviceRepository
@inject IEventRepository EventRepository
@inject IMediaItemRepository MediaItemRepository
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject CaseState CaseState
@inject InspectorState InspectorState
@inject IStringLocalizer<CaseDetails> L

<div style="display: grid; grid-template-columns: 1fr 280px; gap: 16px; height: 100%;">
    <div style="overflow: auto;">
        <h4 class="mb-4">
    @if (_case is not null)
    {
        <span>@_case.CaseNumber · @_case.Title</span>
        <span class="badge" style="background-color: @(_case.Status == CaseStatus.Closed ? "#6c757d" : "#198754")">
            @StatusText(_case.Status)
        </span>
    }
    else
    {
        <span>@L["CaseDetailsTitle"]</span>
    }
</h4>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_case is null)
{
    <div class="alert alert-warning">@L["CaseNotFound"]</div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header">@L["CaseInformation"]</div>
                <div class="card-body">
                    <p><strong>@L["CaseNumberLabel"]</strong> @_case.CaseNumber</p>
                    <p><strong>@L["TitleLabel"]</strong> @_case.Title</p>
                    <p><strong>@L["StatusLabel"]</strong> @StatusText(_case.Status)</p>
                    <p><strong>@L["CreatedLabel"]</strong> @_case.CreatedAtUtc:u</p>
                    <p><strong>@L["UpdatedLabel"]</strong> @_case.UpdatedAtUtc:u</p>
                    @if (!string.IsNullOrEmpty(_case.Description))
                    {
                        <p><strong>@L["DescriptionLabel"]</strong> @_case.Description</p>
                    }
                </div>
            </div>

            @if (_case.Status == CaseStatus.Open)
            {
                <div class="mt-3">
                    @if (CanClose)
                    {
                        <button class="btn btn-danger" @onclick="CloseCase" data-testid="close-case">@L["CloseCase"]</button>
                    }
                    <button class="btn btn-primary" @onclick="ActivateCase" data-testid="activate-case">@L["WorkOnCase"]</button>
                </div>
            }
            else if (_case.Status == CaseStatus.Closed && CanClose)
            {
                <div class="mt-3">
                    <button class="btn btn-success" @onclick="ReopenCase" data-testid="reopen-case">@L["ReopenCase"]</button>
                </div>
            }
        </div>

        <div class="col-md-6">
            <div class="card">
                <div class="card-header">@L["ScopeHeading"]</div>
                <div class="card-body">
                    <p><strong>@L["DevicesLabel"]</strong></p>
                    <ul class="list-unstyled">
                        @if (_case.ScopeFromUtc is null && _case.ScopeToUtc is null)
                        {
                            <li>@L["NoSavedScope"]</li>
                        }
                        else
                        {
                            <li>@(L["ScopeWindow", _case.ScopeFromUtc?.ToString("u") ?? "", _case.ScopeToUtc?.ToString("u") ?? ""])</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>@L["PinnedItems"]</span>
            <div>
                <label class="form-check-label">
                    <input type="checkbox" class="form-check-input" @onchange="OnShowRemovedChanged" data-testid="show-removed" />
                    @L["ShowRemoved"]
                </label>
            </div>
        </div>
        <div class="card-body">
            @if (_caseItems is null)
            {
                <p>@L["LoadingItems"]</p>
            }
            else if (_caseItems.Count == 0)
            {
                <p>@L["NoPinnedItems"]</p>
            }
            else
            {
                <ForensicGrid TItem="CaseItemRow"
                              DataSource="@_caseItems"
                              OnRowSelected="@OnItemSelected"
                              ToInspector="@(row => InspectorModelFromItem(row))">
                    <Columns>
                        <GridColumn Field="@nameof(CaseItemRow.Kind)" HeaderText="@L["ColumnKind"]" Width="100"></GridColumn>
                        <GridColumn Field="@nameof(CaseItemRow.Label)" HeaderText="@L["ColumnLabel"]" Width="250"></GridColumn>
                        <GridColumn Field="@nameof(CaseItemRow.Reason)" HeaderText="@L["ColumnReason"]" Width="200"></GridColumn>
                        <GridColumn Field="@nameof(CaseItemRow.AddedBy)" HeaderText="@L["ColumnAddedBy"]" Width="120"></GridColumn>
                        <GridColumn Field="@nameof(CaseItemRow.AddedAtUtc)" HeaderText="@L["ColumnAddedAt"]" Width="150" Format="@("u")"></GridColumn>
                        <GridColumn Field="@nameof(CaseItemRow.Integrity)" HeaderText="@L["ColumnIntegrity"]" Width="100"></GridColumn>
                    </Columns>
                </ForensicGrid>

                @if (CanEdit && _selectedItem is not null && _case.Status != CaseStatus.Closed)
                {
                    <div class="mt-3">
                        <input type="text" class="form-control mb-2" placeholder="@L["RemovalReasonPlaceholder"]" @bind="_removalReason" data-testid="remove-reason" />
                        <button class="btn btn-danger" @onclick="RemoveItem" data-testid="remove-pin">@L["RemovePin"]</button>
                    </div>
                }
            }
        </div>
    </div>
}
    </div>
    <div style="overflow: auto;">
        <ScopeRail />
    </div>
</div>

@code {
    [Parameter]
    public Guid CaseId { get; set; }

    private ForensicCase? _case;
    private IReadOnlyList<CaseItemRow>? _caseItems;
    private CaseItemRow? _selectedItem;
    private bool _showRemoved = false;
    private string? _error;
    private string _removalReason = "";

    private string StatusText(CaseStatus status) => status switch
    {
        CaseStatus.Open => L["StatusOpen"],
        CaseStatus.Closed => L["StatusClosed"],
        _ => status.ToString()
    };

    private bool CanEdit =>
        SessionState.OperatorId.HasValue &&
        Enum.TryParse(SessionState.Role, out OperatorRole role) &&
        role >= OperatorRole.Review;

    /// <summary>
    /// Closing/reopening a case is an evidence-lifecycle action (see <see cref="OperatorRole"/>),
    /// which requires Admin or above - Review may pin/annotate but may not close or reopen a case.
    /// </summary>
    private bool CanClose =>
        SessionState.OperatorId.HasValue &&
        Enum.TryParse(SessionState.Role, out OperatorRole role) &&
        role >= OperatorRole.Admin;

    protected override async Task OnInitializedAsync()
    {
        await LoadCaseDetails();
    }

    private async Task LoadCaseDetails()
    {
        try
        {
            _case = await CaseRepository.GetAsync(CaseId, CancellationToken.None);
            if (_case is null)
            {
                _error = null;
                return;
            }

            await LoadCaseItems();
        }
        catch (Exception ex)
        {
            _error = L["FailedToLoadCase", ex.Message].Value;
        }
    }

    private async Task LoadCaseItems()
    {
        try
        {
            var items = await CaseRepository.ListItemsAsync(CaseId, _showRemoved, CancellationToken.None);
            var rows = new List<CaseItemRow>();

            foreach (var item in items)
            {
                var label = await GetItemLabel(item);
                var integrity = await GetItemIntegrity(item);

                rows.Add(new CaseItemRow
                {
                    Id = item.Id,
                    Kind = item.Kind,
                    Label = label,
                    Reason = item.Reason,
                    AddedBy = item.AddedBy,
                    AddedAtUtc = item.AddedAtUtc,
                    Integrity = integrity,
                    Item = item
                });
            }

            _caseItems = rows;
        }
        catch (Exception ex)
        {
            _error = L["FailedToLoadCaseItems", ex.Message].Value;
        }
    }

    private async Task<string> GetItemLabel(CaseItem item)
    {
        try
        {
            if (item.Kind == CaseItemKind.Event && item.EventId.HasValue)
            {
                var @event = await EventRepository.GetAsync(item.EventId.Value, CancellationToken.None);
                if (@event is not null)
                {
                    return $"{@event.EventType} · {@event.OccurredAtUtc:u}";
                }
            }
            else if (item.Kind == CaseItemKind.Media && item.MediaItemId.HasValue)
            {
                var media = await MediaItemRepository.GetAsync(item.MediaItemId.Value, CancellationToken.None);
                if (media is not null)
                {
                    return media.FileName;
                }
            }
        }
        catch
        {
            // Ignore errors, return "Unavailable" below
        }

        return L["Unavailable"];
    }

    private async Task<PinIntegrity> GetItemIntegrity(CaseItem item)
    {
        try
        {
            if (item.Kind == CaseItemKind.Media && item.MediaItemId.HasValue)
            {
                var media = await MediaItemRepository.GetAsync(item.MediaItemId.Value, CancellationToken.None);
                return CaseItemIntegrity.Compare(item, media);
            }
        }
        catch
        {
            // Ignore errors
        }

        return CaseItemIntegrity.Compare(item, null);
    }

    private void OnItemSelected(CaseItemRow row)
    {
        _selectedItem = row;
        InspectorState.Show(InspectorModelFromItem(row));
    }

    private InspectorModel InspectorModelFromItem(CaseItemRow row)
    {
        var provenance = new List<KeyValuePair<string, string>>
        {
            new(L["ColumnReason"], row.Reason),
            new(L["ColumnAddedBy"], row.AddedBy),
            new(L["ColumnAddedAt"], row.AddedAtUtc.ToString("u")),
            new(L["ColumnIntegrity"], row.Integrity.ToString())
        };

        return new InspectorModel(
            row.Label,
            new { Kind = row.Kind.ToString(), Label = row.Label, Integrity = row.Integrity.ToString() },
            Provenance: provenance);
    }

    private async Task RemoveItem()
    {
        if (_selectedItem is null || string.IsNullOrWhiteSpace(_removalReason))
        {
            return;
        }

        try
        {
            await CaseRepository.RemoveItemAsync(
                _selectedItem.Id,
                SessionState.OperatorId.ToString(),
                _removalReason.Trim(),
                CancellationToken.None);

            _removalReason = "";
            _selectedItem = null;
            await LoadCaseItems();
        }
        catch (Exception ex)
        {
            _error = L["FailedToRemoveItem", ex.Message].Value;
        }
    }

    private async Task ActivateCase()
    {
        if (_case is null)
        {
            return;
        }

        try
        {
            await CaseState.ActivateAsync(_case.Id, CancellationToken.None);
            var evidenceUrl = NavigationManager.ToAbsoluteUri("/evidence").ToString();
            var url = CaseUrl.Merge(evidenceUrl, _case.Id);
            NavigationManager.NavigateTo(url);
        }
        catch (Exception ex)
        {
            _error = L["FailedToActivateCase", ex.Message].Value;
        }
    }

    private async Task CloseCase()
    {
        if (_case is null)
        {
            return;
        }

        try
        {
            await CaseRepository.CloseAsync(_case.Id, SessionState.OperatorId.ToString(), CancellationToken.None);
            await LoadCaseDetails();
        }
        catch (Exception ex)
        {
            _error = L["FailedToCloseCase", ex.Message].Value;
        }
    }

    private async Task ReopenCase()
    {
        if (_case is null)
        {
            return;
        }

        try
        {
            await CaseRepository.ReopenAsync(_case.Id, SessionState.OperatorId.ToString(), CancellationToken.None);
            await LoadCaseDetails();
        }
        catch (Exception ex)
        {
            _error = L["FailedToReopenCase", ex.Message].Value;
        }
    }

    private async Task OnShowRemovedChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        _showRemoved = (bool?)args.Value ?? false;
        await LoadCaseItems();
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        await Task.CompletedTask;
    }

    // Internal (not private) so bUnit tests in VideoForensics.Ui.Shared.Tests can reference
    // ForensicGrid<CaseItemRow> directly via InternalsVisibleTo.
    internal record CaseItemRow
    {
        public Guid Id { get; set; }
        public CaseItemKind Kind { get; set; }
        public string Label { get; set; } = "";
        public string Reason { get; set; } = "";
        public string AddedBy { get; set; } = "";
        public DateTime AddedAtUtc { get; set; }
        public PinIntegrity Integrity { get; set; }
        public CaseItem Item { get; set; } = null!;
    }
}
