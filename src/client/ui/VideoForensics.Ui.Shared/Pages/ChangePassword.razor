@page "/change-password"
@layout MinimalLayout
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@inject WebAuthnClient WebAuthn
@inject PairedSessionState SessionState
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ChangePassword> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_notSignedIn)
{
    <div class="alert alert-warning">@L["NotSignedInWarning"]</div>
}
else
{
    <p>@L["Description"]</p>

    <div class="d-flex flex-column gap-3">
        <!-- Current Password (only if not in forced-change mode) -->
        @if (!SessionState.MustChangePassword)
        {
            <div>
                <label>@L["CurrentPasswordLabel"]</label>
                <SfTextBox Value="@_currentPassword" ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => _currentPassword = e.Value)" Placeholder="@L["CurrentPasswordPlaceholder"]" Type="Syncfusion.Blazor.Inputs.InputType.Password" />
            </div>
        }

        <!-- New Password -->
        <div>
            <label>@L["NewPasswordLabel"]</label>
            <SfTextBox Value="@_newPassword" ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => { _newPassword = e.Value; UpdateMismatch(); })" Placeholder="@L["NewPasswordPlaceholder"]" Type="Syncfusion.Blazor.Inputs.InputType.Password" />
        </div>

        <!-- Confirm New Password -->
        <div>
            <label>@L["ConfirmPasswordLabel"]</label>
            <SfTextBox Value="@_confirmPassword" ValueChange="@((Syncfusion.Blazor.Inputs.ChangedEventArgs e) => { _confirmPassword = e.Value; UpdateMismatch(); })" Placeholder="@L["ConfirmPasswordPlaceholder"]" Type="Syncfusion.Blazor.Inputs.InputType.Password" />
        </div>

        @if (_passwordMismatch)
        {
            <div class="alert alert-warning">@L["PasswordMismatchError"]</div>
        }

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        <SfButton Content="@(_isChanging ? L["ChangeWaiting"] : L["ChangeButton"])" OnClick="ChangePasswordAsync" CssClass="e-primary" Disabled="@(_isChanging || _isFormInvalid)" />
    </div>
}

@code {
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string _confirmPassword = string.Empty;
    private bool _isChanging;
    private bool _passwordMismatch;
    private bool _notSignedIn;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();

            if (!SessionState.IsSignedIn)
            {
                _notSignedIn = true;
                StateHasChanged();
                // Redirect to device-signin after a brief moment so user sees the warning
                await Task.Delay(2000);
                NavigationManager.NavigateTo("/device-signin", replace: true);
                return;
            }

            StateHasChanged();
        }
    }

    /// <summary>Pure (side-effect-free) form-completeness check for the button's Disabled binding, which Blazor re-evaluates on every render - a side-effecting check here previously left a stale mismatch message on screen (see IsFormValid).</summary>
    private bool _isFormInvalid =>
        string.IsNullOrWhiteSpace(_newPassword)
        || string.IsNullOrWhiteSpace(_confirmPassword)
        || (!SessionState.MustChangePassword && string.IsNullOrWhiteSpace(_currentPassword));

    /// <summary>Full validity check, including the password-match comparison, run only at submit time (has the side effect of updating _passwordMismatch for display).</summary>
    private bool IsFormValid()
    {
        UpdateMismatch();
        return !_passwordMismatch && !_isFormInvalid;
    }

    /// <summary>Recomputes the live mismatch banner as the operator types, called from each password field's ValueChange (fires per keystroke, unlike @bind-Value's default blur-based sync).</summary>
    private void UpdateMismatch()
    {
        _passwordMismatch = !string.IsNullOrEmpty(_confirmPassword) && _newPassword != _confirmPassword;
    }

    private async Task ChangePasswordAsync()
    {
        if (!IsFormValid())
        {
            return;
        }

        _isChanging = true;
        _error = null;
        _passwordMismatch = false;

        try
        {
            string? currentPassword = SessionState.MustChangePassword ? null : _currentPassword;
            var (success, errorMessage, newSessionToken) =
                await WebAuthn.ChangePasswordAsync(SessionState.SessionToken!, currentPassword, _newPassword);

            if (!success)
            {
                _error = errorMessage ?? L["ChangePasswordFailed"];
                return;
            }

            // Update session with new token and clear MustChangePassword flag
            await SessionState.SetAsync(newSessionToken!, SessionState.OperatorId!.Value, SessionState.Role!, mustChangePassword: false);

            // Navigate to home or devices page
            NavigationManager.NavigateTo("/settings/devices");
        }
        catch (Exception ex)
        {
            _error = L["ChangePasswordFailed", ex.Message];
        }
        finally
        {
            _isChanging = false;
        }
    }
}
