@page "/tools/import-export"
@using Microsoft.Extensions.Localization
@inject IBackupExportService BackupExportService
@inject IBackupImportService BackupImportService
@inject IStringLocalizer<ImportExport> L

<RadzenText TextStyle="TextStyle.H4" Class="mb-4">@L["Title"]</RadzenText>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mb-2">@L["ExportSectionTitle"]</RadzenText>

    <div>
        <RadzenButton Text="@L["PrepareForExport"]" Click="PrepareAsync" Disabled="@_isPreparing" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Secondary" />
    </div>

    @if (_prepareResult is not null)
    {
        <div class="mt-2">
            <RadzenText>@L["Validated"] @_prepareResult.Validated</RadzenText>
            <RadzenText>@L["Backfilled"] @_prepareResult.Backfilled</RadzenText>
            <RadzenText>@L["MissingMedia"] @_prepareResult.MissingMedia</RadzenText>
            <RadzenText>@L["UnrecoverableSidecars"] @_prepareResult.MissingSidecarUnrecoverable</RadzenText>
            @foreach (var detail in _prepareResult.Details)
            {
                <RadzenText Class="mt-1">@detail</RadzenText>
            }
        </div>
    }

    <div class="mt-4">
        <RadzenTextBox @bind-Value="_exportOutputDirectory" Placeholder="@L["OutputDirectoryPlaceholder"]" Disabled="@_isExporting" />
    </div>
    <div>
        <RadzenButton Text="@L["ExportBackup"]" Click="ExportAsync" Disabled="@_isExporting" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" />
    </div>

    @if (_exportResult is not null)
    {
        @if (_exportResult.Success)
        {
            <div class="mt-2">
                <RadzenText>@L["BackupCreated"] @_exportResult.ArchivePath</RadzenText>
                <RadzenText>@L["SHA256"] @_exportResult.ArchiveSha256Hash</RadzenText>
                <RadzenText>@L["ExportSummary", _exportResult.ProviderAccountCount, _exportResult.LocationCount, _exportResult.DeviceCount, _exportResult.EventCount, _exportResult.MediaItemCount]</RadzenText>
            </div>
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-2">@_exportResult.ErrorMessage</RadzenAlert>
        }
    }
</RadzenCard>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mb-2">@L["ImportSectionTitle"]</RadzenText>

    <div>
        <RadzenTextBox @bind-Value="_backupZipPath" Placeholder="@L["BackupZipPathPlaceholder"]" Disabled="@_isImporting" />
    </div>
    <div>
        <RadzenTextBox @bind-Value="_mediaRootPath" Placeholder="@L["MediaRootFolderPlaceholder"]" Disabled="@_isImporting" />
    </div>
    <div>
        <RadzenButton Text="@L["Import"]" Click="ImportAsync" Disabled="@_isImporting" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" />
    </div>

    @if (_importResult is not null)
    {
        @if (_importResult.Success)
        {
            <div class="mt-2">
                <RadzenText>@L["ProviderAccountsSummary", _importResult.ProviderAccounts.Inserted, _importResult.ProviderAccounts.SkippedExisting, _importResult.ProviderAccounts.SkippedOrphaned]</RadzenText>
                <RadzenText>@L["LocationsSummary", _importResult.Locations.Inserted, _importResult.Locations.SkippedExisting, _importResult.Locations.SkippedOrphaned]</RadzenText>
                <RadzenText>@L["DevicesSummary", _importResult.Devices.Inserted, _importResult.Devices.SkippedExisting, _importResult.Devices.SkippedOrphaned]</RadzenText>
                <RadzenText>@L["EventsSummary", _importResult.Events.Inserted, _importResult.Events.SkippedExisting, _importResult.Events.SkippedOrphaned]</RadzenText>
                <RadzenText>@L["DownloadEventsSummary", _importResult.DownloadEvents.Inserted, _importResult.DownloadEvents.SkippedExisting, _importResult.DownloadEvents.SkippedOrphaned]</RadzenText>
                <RadzenText>@L["MediaItemsSummary", _importResult.MediaItems.Inserted, _importResult.MediaItems.SkippedExisting, _importResult.MediaItems.SkippedOrphaned, _importResult.MediaItems.IntegrityIssues]</RadzenText>
                @foreach (var detail in _importResult.Details)
                {
                    <RadzenText Class="mt-1">@detail</RadzenText>
                }
            </div>
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-2">@_importResult.ErrorMessage</RadzenAlert>
        }
    }
</RadzenCard>

@code {
    private bool _isPreparing;
    private bool _isExporting;
    private bool _isImporting;

    private PrepareExportResult? _prepareResult;
    private BackupExportResult? _exportResult;
    private BackupImportResult? _importResult;

    private string _exportOutputDirectory = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
        "VideoForensics",
        "Backups");

    private string _backupZipPath = "";
    private string _mediaRootPath = "";

    private async Task PrepareAsync()
    {
        _isPreparing = true;
        _prepareResult = null;
        try
        {
            _prepareResult = await BackupExportService.PrepareForExportAsync(CancellationToken.None);
        }
        finally
        {
            _isPreparing = false;
        }
    }

    private async Task ExportAsync()
    {
        _isExporting = true;
        _exportResult = null;
        try
        {
            _exportResult = await BackupExportService.ExportBackupAsync(_exportOutputDirectory, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _exportResult = new BackupExportResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task ImportAsync()
    {
        _isImporting = true;
        _importResult = null;
        try
        {
            _importResult = await BackupImportService.ImportBackupAsync(_backupZipPath, _mediaRootPath, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _importResult = new BackupImportResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            _isImporting = false;
        }
    }
}
