@page "/devices/config"
@using VideoForensics.Data.Common.Entities
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject IDeviceConfigRepository DeviceConfigRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<DeviceConfig> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenText>@L["NotSignedIn"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="@L["SignIn"]" /> @L["SignInToViewConfig"]</RadzenText>
}
else
{
    <div class="device-config-form">
        <div>
            <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceIdStr" Data="@DeviceOptions"
                TextProperty="Value" ValueProperty="Key" Placeholder="@L["SelectDevice"]" />
        </div>
        <div>
            <RadzenButton Text="@L["LoadConfiguration"]" Click="LoadConfigAsync" Disabled="@(_loading || string.IsNullOrEmpty(_selectedDeviceIdStr))" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert>
        }
    </div>

    @if (_loadedOnce)
    {
        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["LatestConfiguration"]</RadzenText>
        @if (_latest is null)
        {
            <RadzenText>@L["NoConfigSnapshot"]</RadzenText>
        }
        else
        {
            <RadzenDataGrid TItem="DeviceConfigSnapshot" Data="@(new[] { _latest })" AllowPaging="false">
                <Columns>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Property="@nameof(DeviceConfigSnapshot.CapturedAtUtc)" Title="@L["ColCapturedAt"]" />
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="@L["ColMotionDetectionEnabled"]">
                        <Template Context="snapshot">@(snapshot.MotionDetectionEnabled?.ToString() ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="@L["ColMotionSensitivity"]">
                        <Template Context="snapshot">@(snapshot.MotionSensitivity ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="@L["ColRecordingMode"]">
                        <Template Context="snapshot">@(snapshot.RecordingMode ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Property="@nameof(DeviceConfigSnapshot.Source)" Title="@L["ColSource"]" />
                </Columns>
            </RadzenDataGrid>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["History"]</RadzenText>
        @if (_history.Count == 0)
        {
            <RadzenText>@L["NoConfigHistory"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_historyFilter" TItem="DeviceConfigSnapshot" Data="@_history.OrderByDescending(s => s.CapturedAtUtc)" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="CapturedAtUtc" Title="@L["ColCapturedAt"]" />
                    <RadzenDataFilterProperty Property="MotionDetectionEnabled" Title="@L["ColMotionDetectionEnabled"]" />
                    <RadzenDataFilterProperty Property="MotionSensitivity" Title="@L["ColMotionSensitivity"]" />
                    <RadzenDataFilterProperty Property="RecordingMode" Title="@L["ColRecordingMode"]" />
                    <RadzenDataFilterProperty Property="Source" Title="@L["ColSource"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="DeviceConfigSnapshot" Data="@_historyFilter?.View" AllowPaging="true" PageSize="20" AllowSorting="true">
                <Columns>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Property="@nameof(DeviceConfigSnapshot.CapturedAtUtc)" Title="@L["ColCapturedAt"]" />
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="@L["ColMotionDetectionEnabled"]">
                        <Template Context="snapshot">@(snapshot.MotionDetectionEnabled?.ToString() ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="@L["ColMotionSensitivity"]">
                        <Template Context="snapshot">@(snapshot.MotionSensitivity ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="@L["ColRecordingMode"]">
                        <Template Context="snapshot">@(snapshot.RecordingMode ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Property="@nameof(DeviceConfigSnapshot.Source)" Title="@L["ColSource"]" />
                </Columns>
            </RadzenDataGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceIdStr = string.Empty;

    private bool _loading;
    private bool _loadedOnce;
    private string? _error;
    private DeviceConfigSnapshot? _latest;
    private List<DeviceConfigSnapshot> _history = new();
    private RadzenDataFilter<DeviceConfigSnapshot>? _historyFilter;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadConfigAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _latest = await DeviceConfigRepository.GetLatestAsync(deviceId, CancellationToken.None);
            var history = await DeviceConfigRepository.GetHistoryAsync(deviceId, CancellationToken.None);
            _history = history.ToList();
            _loadedOnce = true;
        }
        catch (Exception ex)
        {
            _error = L["FailedToLoadConfig", ex.Message];
        }
        finally
        {
            _loading = false;
        }
    }
}
