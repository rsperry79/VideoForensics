@page "/devices/config"
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject IDeviceConfigRepository DeviceConfigRepository

<MudText Typo="Typo.h4" Class="mb-4">Device Configuration</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudText>You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to view device configuration.</MudText>
}
else
{
    <div class="device-config-form">
        <div>
            <MudSelect T="string" @bind-Value="_selectedDeviceIdStr" Label="Device" Variant="Variant.Outlined">
                <MudSelectItem Value="@("")">-- Select a device --</MudSelectItem>
                @foreach (var device in _devices)
                {
                    <MudSelectItem Value="@(device.Id.ToString())">@device.Name</MudSelectItem>
                }
            </MudSelect>
        </div>
        <div>
            <MudButton OnClick="LoadConfigAsync" Disabled="@(_loading || string.IsNullOrEmpty(_selectedDeviceIdStr))" Variant="Variant.Filled" Color="Color.Primary">Load Configuration</MudButton>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
    </div>

    @if (_loadedOnce)
    {
        <MudText Typo="Typo.h5" Class="mt-4 mb-2">Latest Configuration</MudText>
        @if (_latest is null)
        {
            <MudText>No configuration snapshot found for this device.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true">
                <thead>
                    <tr>
                        <th>Captured At (UTC)</th>
                        <th>Motion Detection Enabled</th>
                        <th>Motion Sensitivity</th>
                        <th>Recording Mode</th>
                        <th>Source</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@_latest.CapturedAtUtc</td>
                        <td>@(_latest.MotionDetectionEnabled?.ToString() ?? "-")</td>
                        <td>@(_latest.MotionSensitivity ?? "-")</td>
                        <td>@(_latest.RecordingMode ?? "-")</td>
                        <td>@_latest.Source</td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        }

        <MudText Typo="Typo.h5" Class="mt-4 mb-2">History</MudText>
        @if (_history.Count == 0)
        {
            <MudText>No configuration history found for this device.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true">
                <thead>
                    <tr>
                        <th>Captured At (UTC)</th>
                        <th>Motion Detection Enabled</th>
                        <th>Motion Sensitivity</th>
                        <th>Recording Mode</th>
                        <th>Source</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var snapshot in _history.OrderByDescending(s => s.CapturedAtUtc))
                    {
                        <tr>
                            <td>@snapshot.CapturedAtUtc</td>
                            <td>@(snapshot.MotionDetectionEnabled?.ToString() ?? "-")</td>
                            <td>@(snapshot.MotionSensitivity ?? "-")</td>
                            <td>@(snapshot.RecordingMode ?? "-")</td>
                            <td>@snapshot.Source</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceIdStr = string.Empty;

    private bool _loading;
    private bool _loadedOnce;
    private string? _error;
    private DeviceConfigSnapshot? _latest;
    private List<DeviceConfigSnapshot> _history = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadConfigAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _latest = await DeviceConfigRepository.GetLatestAsync(deviceId, CancellationToken.None);
            var history = await DeviceConfigRepository.GetHistoryAsync(deviceId, CancellationToken.None);
            _history = history.ToList();
            _loadedOnce = true;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load configuration: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
