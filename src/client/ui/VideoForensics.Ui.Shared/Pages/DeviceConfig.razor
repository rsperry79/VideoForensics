@page "/devices/config"
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject IDeviceConfigRepository DeviceConfigRepository

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Device Configuration</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenText>You are not signed in. <RadzenLink Path="/signin" Text="Sign in" /> to view device configuration.</RadzenText>
}
else
{
    <div class="device-config-form">
        <div>
            <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceIdStr" Data="@DeviceOptions"
                TextProperty="Value" ValueProperty="Key" Placeholder="-- Select a device --" />
        </div>
        <div>
            <RadzenButton Text="Load Configuration" Click="LoadConfigAsync" Disabled="@(_loading || string.IsNullOrEmpty(_selectedDeviceIdStr))" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert>
        }
    </div>

    @if (_loadedOnce)
    {
        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Latest Configuration</RadzenText>
        @if (_latest is null)
        {
            <RadzenText>No configuration snapshot found for this device.</RadzenText>
        }
        else
        {
            <RadzenDataGrid TItem="DeviceConfigSnapshot" Data="@(new[] { _latest })" AllowPaging="false">
                <Columns>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Property="@nameof(DeviceConfigSnapshot.CapturedAtUtc)" Title="Captured At (UTC)" />
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="Motion Detection Enabled">
                        <Template Context="snapshot">@(snapshot.MotionDetectionEnabled?.ToString() ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="Motion Sensitivity">
                        <Template Context="snapshot">@(snapshot.MotionSensitivity ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="Recording Mode">
                        <Template Context="snapshot">@(snapshot.RecordingMode ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Property="@nameof(DeviceConfigSnapshot.Source)" Title="Source" />
                </Columns>
            </RadzenDataGrid>
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">History</RadzenText>
        @if (_history.Count == 0)
        {
            <RadzenText>No configuration history found for this device.</RadzenText>
        }
        else
        {
            <RadzenDataGrid TItem="DeviceConfigSnapshot" Data="@_history.OrderByDescending(s => s.CapturedAtUtc)" AllowPaging="true" PageSize="20" AllowSorting="true">
                <Columns>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Property="@nameof(DeviceConfigSnapshot.CapturedAtUtc)" Title="Captured At (UTC)" />
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="Motion Detection Enabled">
                        <Template Context="snapshot">@(snapshot.MotionDetectionEnabled?.ToString() ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="Motion Sensitivity">
                        <Template Context="snapshot">@(snapshot.MotionSensitivity ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Title="Recording Mode">
                        <Template Context="snapshot">@(snapshot.RecordingMode ?? "-")</Template>
                    </RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="DeviceConfigSnapshot" Property="@nameof(DeviceConfigSnapshot.Source)" Title="Source" />
                </Columns>
            </RadzenDataGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceIdStr = string.Empty;

    private bool _loading;
    private bool _loadedOnce;
    private string? _error;
    private DeviceConfigSnapshot? _latest;
    private List<DeviceConfigSnapshot> _history = new();

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadConfigAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _latest = await DeviceConfigRepository.GetLatestAsync(deviceId, CancellationToken.None);
            var history = await DeviceConfigRepository.GetHistoryAsync(deviceId, CancellationToken.None);
            _history = history.ToList();
            _loadedOnce = true;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load configuration: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }
}
