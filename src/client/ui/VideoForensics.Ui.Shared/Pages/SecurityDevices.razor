@page "/settings/devices"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Layout.RightPanel
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject WebAuthnClient WebAuthn
@inject IStringLocalizer<SecurityDevices> L

<h4 class="mb-4">@L["Title"]</h4>

@if (!SessionState.IsSignedIn)
{
    <div class="alert alert-info mb-4">
        <a href="/device-signin">Sign in with your passkey</a> @L["SignInToManage"]
    </div>
}

<h6 class="mt-4 mb-2">@L["AddClientHeading"]</h6>
<div class="d-flex flex-row gap-2 mb-4">
    <SfButton Content="@(_isInitiatingPairing ? L["GeneratingButton"] : L["GenerateQrButton"])" OnClick="InitiatePairingAsync" Disabled="@_isInitiatingPairing" CssClass="e-primary" />
</div>
@if (_pairingError is not null)
{
    <div class="alert alert-danger mb-4">@_pairingError</div>
}
@if (_pairingToken is not null)
{
    <div class="border rounded pa-4 mb-4">
        <img src="@QrCodeUrl" alt="Pairing QR code" width="240" height="240" />
        <span class="mt-2 d-block">@L["QrInstructions"]</span>
        <span><code>@PairingUrl</code></span>
        <span>@L["ExpiresMessage", _pairingExpiresAtUtc]</span>
    </div>
}

<h6 class="mt-4 mb-2">@L["CurrentlyPairedHeading"]</h6>
<div class="d-flex flex-row gap-2 mb-2">
    <SfButton Content="@L["RefreshButton"]" OnClick="LoadAsync" Disabled="@_isLoading" CssClass="e-flat" />
</div>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_authError is not null)
{
    <div class="alert alert-danger mb-2">@_authError</div>
    <span>@L["NotAuthorizedMessage"]</span>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else if (_devices is null || _devices.Count == 0)
{
    <span>@L["NoPairedDevices"]</span>
}
else
{
    <SfGrid TValue="PairedDevice" DataSource="@_filteredDevices" AllowSorting="true" AllowPaging="true" AllowFiltering="true">
        <GridPageSettings PageSize="20"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(PairedDevice.DeviceName)" HeaderText="@L["ColDeviceName"]" />
            <GridColumn Field="@nameof(PairedDevice.Role)" HeaderText="@L["ColRole"]" />
            <GridColumn Field="@nameof(PairedDevice.PairedAtUtc)" HeaderText="@L["ColPairedAt"]" />
            <GridColumn HeaderText="@L["ColLastSeenUtc"]">
                <Template>
                    @{
                        var device = (PairedDevice)context;
                        @(device.LastSeenAtUtc?.ToString() ?? L["NotAvailable"].Value)
                    }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="@L["ColLastSeenIp"]">
                <Template>
                    @{
                        var device = (PairedDevice)context;
                        @(device.LastSeenIp ?? L["NotAvailable"].Value)
                    }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="@L["ColLastSeenTier"]">
                <Template>
                    @{
                        var device = (PairedDevice)context;
                        @(device.LastSeenTier?.ToString() ?? L["NotAvailable"].Value)
                    }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="@L["ColStatus"]" AllowSorting="false">
                <Template>
                    @{
                        var device = (PairedDevice)context;
                        @if (device.IsActive)
                        {
                            <span style="color: var(--sf-success);">@L["StatusActive"]</span>
                        }
                        else
                        {
                            <span style="color: var(--sf-danger);">@L["StatusRevoked", device.RevokedReason]</span>
                        }
                    }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="" AllowSorting="false">
                <Template>
                    @{
                        var device = (PairedDevice)context;
                        @if (device.IsActive)
                        {
                            <SfButton Content="@L["RevokeButton"]" OnClick="() => BeginRevoke(device.Id)" CssClass="e-danger" />
                            @if (_pendingRevokeDeviceId == device.Id)
                            {
                                <div class="d-flex flex-row gap-2 align-items-center mt-2">
                                    <input type="text" @bind="_reasonInput" placeholder="@L["ReasonPlaceholder"]" style="max-width: 260px;" class="form-control" />
                                    <SfButton Content="@L["ConfirmButton"]" OnClick="() => ConfirmRevoke(device.Id)" CssClass="e-danger" />
                                    <SfButton Content="@L["CancelButton"]" OnClick="CancelPending" CssClass="e-flat" />
                                </div>
                            }
                        }
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
}

@if (_actionError is not null)
{
    <div class="alert alert-danger mt-4">@_actionError</div>
}

@code {
    private bool _isLoading = true;
    private List<PairedDevice>? _devices = new();
    private IEnumerable<PairedDevice> _filteredDevices = new List<PairedDevice>();
    private string? _authError;
    private string? _loadError;
    private string? _actionError;
    private Guid? _pendingRevokeDeviceId;
    private string _reasonInput = string.Empty;
    private bool _isInitiatingPairing;
    private string? _pairingError;
    private string? _pairingToken;
    private DateTime? _pairingExpiresAtUtc;

    private string PairingUrl => $"{NavigationManager.BaseUri.TrimEnd('/')}/pair?token={_pairingToken}";
    private string QrCodeUrl => $"api/pairing/{_pairingToken}/qrcode.png";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - the session (and
        // therefore the Authorization header LoadAsync needs) can only be read from localStorage
        // once the interactive circuit is actually connected, hence the re-load + re-fetch here
        // rather than in OnInitializedAsync.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task InitiatePairingAsync()
    {
        _isInitiatingPairing = true;
        _pairingError = null;
        _pairingToken = null;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsync("api/pairing/initiate", null);
            if (!response.IsSuccessStatusCode)
            {
                _pairingError = await SafeReadErrorAsync(response) ?? L["PairingError1", response.StatusCode];
                return;
            }

            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            _pairingToken = body.GetProperty("token").GetString();
            _pairingExpiresAtUtc = body.GetProperty("expiresAtUtc").GetDateTime();
        }
        catch (Exception ex)
        {
            _pairingError = L["PairingError2", ex.Message];
        }
        finally
        {
            _isInitiatingPairing = false;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        _actionError = null;
        try
        {
            var client = CreateClient();
            var response = await client.GetAsync("api/devices-management/paired-devices");
            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = L["NotAuthorizedToView"];
                _devices = null;
                return;
            }

            response.EnsureSuccessStatusCode();
            _devices = await response.Content.ReadFromJsonAsync<List<PairedDevice>>(JsonOptions);
            _filteredDevices = _devices ?? new List<PairedDevice>();
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToLoad", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BeginRevoke(Guid deviceId)
    {
        _pendingRevokeDeviceId = deviceId;
        _reasonInput = string.Empty;
        _actionError = null;
    }

    private void CancelPending()
    {
        _pendingRevokeDeviceId = null;
        _reasonInput = string.Empty;
    }

    private async Task ConfirmRevoke(Guid deviceId)
    {
        if (string.IsNullOrWhiteSpace(_reasonInput))
        {
            return;
        }

        if (SessionState.SessionToken is null)
        {
            _actionError = L["SignInFirstError"];
            return;
        }

        _actionError = null;
        try
        {
            // Revocation is high-risk (plan §5.7) - a fresh passkey assertion is required at the
            // moment of the action, not just an already-open session.
            var stepUpToken = await WebAuthn.StepUpAsync(SessionState.SessionToken);

            var client = CreateClient();
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            var response = await client.PostAsJsonAsync($"api/devices-management/paired-devices/{deviceId}/revoke", new { reason = _reasonInput });
            if (!response.IsSuccessStatusCode)
            {
                var body = await SafeReadErrorAsync(response);
                _actionError = body ?? L["RevokeFailed1", response.StatusCode];
                return;
            }

            CancelPending();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = L["RevokeFailed2", ex.Message];
        }
    }

    private static async Task<string?> SafeReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var doc = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>(JsonOptions);
            return doc is not null && doc.TryGetValue("error", out var msg) ? msg : null;
        }
        catch
        {
            return null;
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
}
