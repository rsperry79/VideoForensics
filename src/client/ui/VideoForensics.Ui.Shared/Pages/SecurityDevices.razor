@page "/settings/devices"
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Services
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject WebAuthnClient WebAuthn

<RadzenText TextStyle="TextStyle.H4" Class="mb-4">Paired Devices</RadzenText>

@if (!SessionState.IsSignedIn)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Class="mb-4">
        <RadzenLink Path="/device-signin" Text="Sign in with your passkey" /> to manage paired devices.
    </RadzenAlert>
}

<RadzenText TextStyle="TextStyle.H6" Class="mt-4 mb-2">Add Client</RadzenText>
<RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Class="mb-4">
    <RadzenButton Text="@(_isInitiatingPairing ? "Generating..." : "Generate Pairing QR Code")" Click="InitiatePairingAsync" Disabled="@_isInitiatingPairing" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" />
</RadzenStack>
@if (_pairingError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mb-4">@_pairingError</RadzenAlert>
}
@if (_pairingToken is not null)
{
    <RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
        <img src="@QrCodeUrl" alt="Pairing QR code" width="240" height="240" />
        <RadzenText Class="mt-2">Scan with the new device's camera, or open this link on it directly:</RadzenText>
        <RadzenText TextStyle="TextStyle.Body2"><code>@PairingUrl</code></RadzenText>
        <RadzenText TextStyle="TextStyle.Body2">Expires at @_pairingExpiresAtUtc UTC (single use, ~2 minutes).</RadzenText>
    </RadzenCard>
}

<RadzenText TextStyle="TextStyle.H6" Class="mt-4 mb-2">Currently Paired</RadzenText>
<RadzenStack Orientation="Orientation.Horizontal" Class="mb-2">
    <RadzenButton Text="Refresh" Click="LoadAsync" Disabled="@_isLoading" Variant="Variant.Outlined" />
</RadzenStack>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (_authError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mb-2">@_authError</RadzenAlert>
    <RadzenText>
        Not authorized. <RadzenLink Path="/device-signin" Text="Sign in with your passkey" /> - a Super Admin device
        signed in via the Local network tier is required to manage paired devices.
    </RadzenText>
}
else if (_loadError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">@_loadError</RadzenAlert>
}
else if (_devices is null || _devices.Count == 0)
{
    <RadzenText>No paired devices found.</RadzenText>
}
else
{
    <RadzenDataFilter @ref="_devicesFilter" TItem="PairedDevice" Data="@_devices" Auto="true" class="mb-2">
        <Properties>
            <RadzenDataFilterProperty Property="DeviceName" Title="Device Name" />
            <RadzenDataFilterProperty Property="Role" Title="Role" />
            <RadzenDataFilterProperty Property="PairedAtUtc" Title="Paired At (UTC)" />
            <RadzenDataFilterProperty Property="LastSeenAtUtc" Title="Last Seen (UTC)" />
            <RadzenDataFilterProperty Property="LastSeenIp" Title="Last Seen IP" />
            <RadzenDataFilterProperty Property="IsActive" Title="Active" />
        </Properties>
    </RadzenDataFilter>
    <RadzenDataGrid TItem="PairedDevice" Data="@_devicesFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
        <Columns>
            <RadzenDataGridColumn TItem="PairedDevice" Property="DeviceName" Title="Device Name" />
            <RadzenDataGridColumn TItem="PairedDevice" Property="Role" Title="Role" />
            <RadzenDataGridColumn TItem="PairedDevice" Property="PairedAtUtc" Title="Paired At (UTC)" />
            <RadzenDataGridColumn TItem="PairedDevice" Title="Last Seen (UTC)">
                <Template Context="context">@(context.LastSeenAtUtc?.ToString() ?? "-")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PairedDevice" Title="Last Seen IP">
                <Template Context="context">@(context.LastSeenIp ?? "-")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PairedDevice" Title="Last Seen Tier">
                <Template Context="context">@(context.LastSeenTier?.ToString() ?? "-")</Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PairedDevice" Title="Status" Sortable="false" Filterable="false">
                <Template Context="context">
                    @if (context.IsActive)
                    {
                        <span style="color: var(--rz-success);">Active</span>
                    }
                    else
                    {
                        <span style="color: var(--rz-danger);">Revoked: @context.RevokedReason</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="PairedDevice" Title="" Sortable="false" Filterable="false">
                <Template Context="context">
                    @if (context.IsActive)
                    {
                        <RadzenButton Text="Revoke" Click="() => BeginRevoke(context.Id)" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" />
                        @if (_pendingRevokeDeviceId == context.Id)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Class="mt-2">
                                <RadzenTextBox @bind-Value="_reasonInput" Placeholder="Reason for revocation" Style="max-width: 260px;" />
                                <RadzenButton Text="Confirm" Click="() => ConfirmRevoke(context.Id)" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" />
                                <RadzenButton Text="Cancel" Click="CancelPending" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                            </RadzenStack>
                        }
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@if (_actionError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-4">@_actionError</RadzenAlert>
}

@code {
    private bool _isLoading = true;
    private List<PairedDevice>? _devices;
    private RadzenDataFilter<PairedDevice>? _devicesFilter;
    private string? _authError;
    private string? _loadError;
    private string? _actionError;
    private Guid? _pendingRevokeDeviceId;
    private string _reasonInput = string.Empty;
    private bool _isInitiatingPairing;
    private string? _pairingError;
    private string? _pairingToken;
    private DateTime? _pairingExpiresAtUtc;

    private string PairingUrl => $"{NavigationManager.BaseUri.TrimEnd('/')}/pair?token={_pairingToken}";
    private string QrCodeUrl => $"api/pairing/{_pairingToken}/qrcode.png";

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - the session (and
        // therefore the Authorization header LoadAsync needs) can only be read from localStorage
        // once the interactive circuit is actually connected, hence the re-load + re-fetch here
        // rather than in OnInitializedAsync.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task InitiatePairingAsync()
    {
        _isInitiatingPairing = true;
        _pairingError = null;
        _pairingToken = null;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsync("api/pairing/initiate", null);
            if (!response.IsSuccessStatusCode)
            {
                _pairingError = await SafeReadErrorAsync(response) ?? $"Could not start pairing: {response.StatusCode}";
                return;
            }

            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            _pairingToken = body.GetProperty("token").GetString();
            _pairingExpiresAtUtc = body.GetProperty("expiresAtUtc").GetDateTime();
        }
        catch (Exception ex)
        {
            _pairingError = $"Could not start pairing: {ex.Message}";
        }
        finally
        {
            _isInitiatingPairing = false;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        _actionError = null;
        try
        {
            var client = CreateClient();
            var response = await client.GetAsync("api/devices-management/paired-devices");
            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = "Not authorized to view paired devices.";
                _devices = null;
                return;
            }

            response.EnsureSuccessStatusCode();
            _devices = await response.Content.ReadFromJsonAsync<List<PairedDevice>>(JsonOptions);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load paired devices: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BeginRevoke(Guid deviceId)
    {
        _pendingRevokeDeviceId = deviceId;
        _reasonInput = string.Empty;
        _actionError = null;
    }

    private void CancelPending()
    {
        _pendingRevokeDeviceId = null;
        _reasonInput = string.Empty;
    }

    private async Task ConfirmRevoke(Guid deviceId)
    {
        if (string.IsNullOrWhiteSpace(_reasonInput))
        {
            return;
        }

        if (SessionState.SessionToken is null)
        {
            _actionError = "Sign in with your passkey first.";
            return;
        }

        _actionError = null;
        try
        {
            // Revocation is high-risk (plan §5.7) - a fresh passkey assertion is required at the
            // moment of the action, not just an already-open session.
            var stepUpToken = await WebAuthn.StepUpAsync(SessionState.SessionToken);

            var client = CreateClient();
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            var response = await client.PostAsJsonAsync($"api/devices-management/paired-devices/{deviceId}/revoke", new { reason = _reasonInput });
            if (!response.IsSuccessStatusCode)
            {
                var body = await SafeReadErrorAsync(response);
                _actionError = body ?? $"Revoke failed: {response.StatusCode}";
                return;
            }

            CancelPending();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = $"Revoke failed: {ex.Message}";
        }
    }

    private static async Task<string?> SafeReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var doc = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>(JsonOptions);
            return doc is not null && doc.TryGetValue("error", out var msg) ? msg : null;
        }
        catch
        {
            return null;
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
}
