@page "/accounts/add"
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using Microsoft.AspNetCore.Components
@inject IProviderAuthService AuthService
@inject IMultiProviderAuthService MultiProviderAuthService
@inject IForensicsConfiguration ForensicsConfig
@inject IForensicsConfigurationService ForensicsConfigService
@inject NavigationManager NavigationManager

<h4 class="mb-4">Add Account</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (_currentStep == 1)
    {
        <div>
            <h5>Select a Provider</h5>
            <p>Choose which video platform to add an account for.</p>
            <div class="provider-list mt-3">
                @if (_availableProviders != null)
                {
                    @foreach (var provider in _availableProviders)
                    {
                        <div class="provider-card mb-2 p-3"
                             style="border: 2px solid @(_selectedProvider == provider ? "#007bff" : "#ddd"); border-radius: 8px; cursor: pointer;"
                             @onclick="() => _selectedProvider = provider">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <input type="radio" name="provider" value="@provider"
                                       @onchange="(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _selectedProvider = e.Value?.ToString()"
                                       checked="@(_selectedProvider == provider)" />
                                <label style="margin: 0; cursor: pointer; flex: 1;">@provider</label>
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="mt-4">
                <SfButton CssClass="e-primary" Content="Next" OnClick="() => _currentStep = 2" Disabled="@string.IsNullOrEmpty(_selectedProvider)" />
                <SfButton CssClass="e-outline ms-2" Content="Cancel" OnClick="GoBack" />
            </div>
        </div>
    }
    else if (_currentStep == 2)
    {
        <div>
            @if (_selectedProvider == "Uniview")
            {
                <h5>Uniview NVR Authentication</h5>
                <p style="color: #666; font-size: 0.95rem;">
                    NVR Host is configured on the server. Enter your local NVR credentials below.
                </p>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <p style="color: red; margin-bottom: 1rem;">@_errorMessage</p>
                }

                <EditForm Model="this" OnValidSubmit="AuthenticateUniviewAsync">
                    <div class="mb-3">
                        <label for="uniview-username">Username:</label>
                        <SfTextBox ID="uniview-username" @bind-Value="_univiewUsername" />
                    </div>
                    <div class="mb-3">
                        <label for="uniview-password">Password:</label>
                        <SfTextBox ID="uniview-password" Type="Syncfusion.Blazor.Inputs.InputType.Password" @bind-Value="_univiewPassword" />
                    </div>
                    <div>
                        <SfButton CssClass="e-primary" type="submit" Disabled="@_isBusy" Content="@(_isBusy ? "Authenticating..." : "Authenticate")" />
                        <SfButton CssClass="e-outline ms-2" type="button" Content="Back" OnClick="() => _currentStep = 1" Disabled="@_isBusy" />
                    </div>
                </EditForm>
            }
            else
            {
                <h5>@_selectedProvider Account</h5>
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <p style="color: red; margin-bottom: 1rem;">@_errorMessage</p>
                }
                <AuthForm IdPrefix="add-account-wizard" SubmitLabel="Add Account"
                          OnAuthenticated="HandleAuthenticationAsync"
                          AvailableProviders="@(new[] { _selectedProvider })" />
                <SfButton CssClass="e-outline mt-2" Content="Back" OnClick="() => { _currentStep = 1; _errorMessage = null; }" Disabled="@_isBusy" />
            }
        </div>
    }
    else if (_currentStep == 3)
    {
        <div class="mt-3">
            @if (_authSuccess)
            {
                <div style="padding: 20px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; color: #155724;">
                    <h5>Success</h5>
                    <p>Account added successfully for @_selectedProvider.</p>
                </div>
                <div class="mt-3">
                    <SfButton CssClass="e-success" Content="Back to Accounts" OnClick="GoBack" />
                </div>
            }
            else
            {
                <div style="padding: 20px; background-color: #f8d7da; border: 1px solid #f5c6cb; border-radius: 8px; color: #721c24;">
                    <h5>Authentication Failed</h5>
                    <p>@_errorMessage</p>
                </div>
                <div class="mt-3">
                    <SfButton CssClass="e-danger" Content="Try Again" OnClick="() => _currentStep = 2" />
                    <SfButton CssClass="e-outline ms-2" Content="Back to Accounts" OnClick="GoBack" />
                </div>
            }
        </div>
    }
}

@code {
    private int _currentStep = 1;
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _selectedProvider;
    private IReadOnlyList<string>? _availableProviders;
    private string? _errorMessage;
    private bool _authSuccess;
    private string _univiewUsername = "";
    private string _univiewPassword = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _availableProviders = await MultiProviderAuthService.GetAvailableProvidersAsync();
            _selectedProvider = _availableProviders?.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Failed to load providers: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AuthenticateUniviewAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            var authService = MultiProviderAuthService.GetService("Uniview");
            var result = await authService.AuthenticateAsync(_univiewUsername, _univiewPassword, CancellationToken.None);

            if (result.Success)
            {
                if (result.ProviderAccountId.HasValue && ForensicsConfig.ActiveProviderAccountId != result.ProviderAccountId)
                {
                    ForensicsConfig.ActiveProviderAccountId = result.ProviderAccountId;
                    await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);
                }

                _authSuccess = true;
                _currentStep = 3;
                _univiewUsername = "";
                _univiewPassword = "";
            }
            else
            {
                _authSuccess = false;
                _errorMessage = result.ErrorMessage ?? "Authentication failed.";
                _currentStep = 3;
            }
        }
        catch (Exception ex)
        {
            _authSuccess = false;
            _errorMessage = $"Authentication failed: {ex.Message}";
            _currentStep = 3;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleAuthenticationAsync(AuthResult result)
    {
        if (result.Success)
        {
            _authSuccess = true;
            _errorMessage = null;
            _currentStep = 3;
        }
        else
        {
            _authSuccess = false;
            _errorMessage = result.ErrorMessage ?? "Authentication failed.";
            _currentStep = 3;
        }
        await Task.CompletedTask;
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/accounts");
    }
}
