@page "/pair"
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Data.Common.Contracts
@using Microsoft.Extensions.Localization
@inject NavigationManager NavigationManager
@inject WebAuthnClient WebAuthn
@inject IOperatorRepository OperatorRepository
@inject IStringLocalizer<Pair> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_initiating)
{
    <div class="d-flex justify-content-center gap-2">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Initiating pairing...</span>
        </div>
        <span>Initiating pairing ceremony...</span>
    </div>
}
else if (_token is null)
{
    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
}
else if (_result is not null)
{
    @if (_result.IsApproved)
    {
        <div class="alert alert-success">
            @L["SuccessAlert", _result.Role]
            You can now <a href="/device-signin">@L["SignInLink"]</a>.
        </div>
    }
    else
    {
        <div class="alert alert-success">
            Account created successfully! Your account is awaiting admin approval. You will be notified once approved — please try signing in again later.
        </div>
    }
}
else
{
    <div class="d-flex flex-column gap-2">
        <span>@L["Instructions"]</span>
        <div>
            <label>@L["OperatorNameLabel"]</label>
            <SfTextBox @bind-Value="_operatorDisplayName" Placeholder="@L["OperatorNamePlaceholder"]" />
        </div>
        <div>
            <label>@L["DeviceNameLabel"]</label>
            <SfTextBox @bind-Value="_deviceName" Placeholder="@L["DeviceNamePlaceholder"]" />
        </div>
        <SfButton Content="@(_isPairing ? L["PairWaiting"] : L["PairButton"])" OnClick="PairAsync" CssClass="e-primary" Disabled="@(_isPairing || string.IsNullOrWhiteSpace(_operatorDisplayName) || string.IsNullOrWhiteSpace(_deviceName))" />

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }
    </div>
}

@code {
    private string? _token;
    private string _operatorDisplayName = string.Empty;
    private string _deviceName = string.Empty;
    private bool _isPairing;
    private bool _initiating;
    private string? _error;
    private RegistrationResult? _result;
    private bool _isBootstrap;

    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _token = query["token"];

        // Determine if this is the bootstrap (first-run) scenario
        _isBootstrap = await OperatorRepository.IsEmptyAsync(CancellationToken.None);

        // If no token provided, initiate the pairing ceremony (bootstrap or self-service)
        if (_token is null)
        {
            await InitiatePairingAsync();
        }
    }

    private async Task InitiatePairingAsync()
    {
        _initiating = true;
        _error = null;
        try
        {
            using var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
            var response = await client.PostAsync("api/v1/pairing/initiate", null);

            if (!response.IsSuccessStatusCode)
            {
                _error = $"Failed to initiate pairing: {response.StatusCode}";
                return;
            }

            var responseContent = await response.Content.ReadFromJsonAsync<InitiateResponse>();
            if (responseContent?.Token is not null)
            {
                _token = responseContent.Token;
            }
            else
            {
                _error = "Invalid response from pairing initiate endpoint";
            }
        }
        catch (Exception ex)
        {
            _error = $"Error initiating pairing: {ex.Message}";
        }
        finally
        {
            _initiating = false;
        }
    }

    private async Task PairAsync()
    {
        if (_token is null)
        {
            return;
        }

        _isPairing = true;
        _error = null;
        try
        {
            if (!await WebAuthn.IsAvailableAsync())
            {
                _error = L["WebAuthnNotSupported"];
                return;
            }

            _result = await WebAuthn.CompleteRegistrationAsync(_token, _operatorDisplayName.Trim(), _deviceName.Trim());
        }
        catch (Exception ex)
        {
            _error = L["PairingFailed", ex.Message];
        }
        finally
        {
            _isPairing = false;
        }
    }

    private record InitiateResponse(string? Token, DateTime ExpiresAtUtc, string? Role);
}
