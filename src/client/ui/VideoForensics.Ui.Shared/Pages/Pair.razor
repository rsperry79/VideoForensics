@page "/pair"
@using VideoForensics.Ui.Shared.Services
@inject NavigationManager NavigationManager
@inject WebAuthnClient WebAuthn

<MudText Typo="Typo.h4" Class="mb-4">Pair This Device</MudText>

@if (_token is null)
{
    <MudAlert Severity="Severity.Error">No pairing token in the URL. Scan the QR code shown on the server's Paired Devices screen, or open the link it displays.</MudAlert>
}
else if (_result is not null)
{
    <MudAlert Severity="Severity.Success">
        Device paired successfully as <strong>@_result.Value.Role</strong>.
        You can now <MudLink Href="/device-signin">sign in with your passkey</MudLink>.
    </MudAlert>
}
else
{
    <MudStack Spacing="3" Class="mb-4">
        <MudText>Choose who this device is for, then confirm with your platform authenticator (Windows Hello, Touch ID, or a security key).</MudText>
        <MudTextField @bind-Value="_operatorDisplayName" Label="Your name" Variant="Variant.Outlined" Placeholder="e.g. Jane Doe" @oninput="@((ChangeEventArgs e) => _operatorDisplayName = (string?)e.Value ?? string.Empty)" />
        <MudTextField @bind-Value="_deviceName" Label="Device name" Variant="Variant.Outlined" Placeholder="e.g. Jane's Laptop" @oninput="@((ChangeEventArgs e) => _deviceName = (string?)e.Value ?? string.Empty)" />
        <MudButton OnClick="PairAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_isPairing || string.IsNullOrWhiteSpace(_operatorDisplayName) || string.IsNullOrWhiteSpace(_deviceName))">
            @(_isPairing ? "Waiting for passkey..." : "Pair Device")
        </MudButton>

        @if (_error is not null)
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
    </MudStack>
}

@code {
    private string? _token;
    private string _operatorDisplayName = string.Empty;
    private string _deviceName = string.Empty;
    private bool _isPairing;
    private string? _error;
    private (Guid OperatorId, Guid PairedDeviceId, string Role)? _result;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _token = query["token"];
    }

    private async Task PairAsync()
    {
        if (_token is null)
        {
            return;
        }

        _isPairing = true;
        _error = null;
        try
        {
            if (!await WebAuthn.IsAvailableAsync())
            {
                _error = "This browser does not support WebAuthn/passkeys. Use a modern Chrome, Edge, Firefox, or Safari.";
                return;
            }

            _result = await WebAuthn.CompleteRegistrationAsync(_token, _operatorDisplayName.Trim(), _deviceName.Trim());
        }
        catch (Exception ex)
        {
            _error = $"Pairing failed: {ex.Message}";
        }
        finally
        {
            _isPairing = false;
        }
    }
}
