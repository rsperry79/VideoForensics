@page "/pair"
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@inject NavigationManager NavigationManager
@inject WebAuthnClient WebAuthn
@inject IStringLocalizer<Pair> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_token is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">@L["NoTokenAlert"]</RadzenAlert>
}
else if (_result is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Success">
        @L["SuccessAlert", _result.Value.Role]
        You can now <RadzenLink Path="/device-signin" Text="@L["SignInLink"]" />.
    </RadzenAlert>
}
else
{
    <RadzenStack>
        <RadzenText>@L["Instructions"]</RadzenText>
        <div>
            <label>@L["OperatorNameLabel"]</label>
            <RadzenTextBox @bind-Value="_operatorDisplayName" Placeholder="@L["OperatorNamePlaceholder"]" />
        </div>
        <div>
            <label>@L["DeviceNameLabel"]</label>
            <RadzenTextBox @bind-Value="_deviceName" Placeholder="@L["DeviceNamePlaceholder"]" />
        </div>
        <RadzenButton Text="@(_isPairing ? L["PairWaiting"] : L["PairButton"])" Click="PairAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" Disabled="@(_isPairing || string.IsNullOrWhiteSpace(_operatorDisplayName) || string.IsNullOrWhiteSpace(_deviceName))" />

        @if (_error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert>
        }
    </RadzenStack>
}

@code {
    private string? _token;
    private string _operatorDisplayName = string.Empty;
    private string _deviceName = string.Empty;
    private bool _isPairing;
    private string? _error;
    private (Guid OperatorId, Guid PairedDeviceId, string Role)? _result;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _token = query["token"];
    }

    private async Task PairAsync()
    {
        if (_token is null)
        {
            return;
        }

        _isPairing = true;
        _error = null;
        try
        {
            if (!await WebAuthn.IsAvailableAsync())
            {
                _error = L["WebAuthnNotSupported"];
                return;
            }

            _result = await WebAuthn.CompleteRegistrationAsync(_token, _operatorDisplayName.Trim(), _deviceName.Trim());
        }
        catch (Exception ex)
        {
            _error = L["PairingFailed", ex.Message];
        }
        finally
        {
            _isPairing = false;
        }
    }
}
