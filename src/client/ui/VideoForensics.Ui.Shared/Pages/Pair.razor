@page "/pair"
@using VideoForensics.Ui.Shared.Services
@inject NavigationManager NavigationManager
@inject WebAuthnClient WebAuthn

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Pair This Device</RadzenText>

@if (_token is null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">No pairing token in the URL. Scan the QR code shown on the server's Paired Devices screen, or open the link it displays.</RadzenAlert>
}
else if (_result is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Success">
        Device paired successfully as <strong>@_result.Value.Role</strong>.
        You can now <RadzenLink Path="/device-signin" Text="sign in with your passkey" />.
    </RadzenAlert>
}
else
{
    <RadzenStack>
        <RadzenText>Choose who this device is for, then confirm with your platform authenticator (Windows Hello, Touch ID, or a security key).</RadzenText>
        <div>
            <label>Your name</label>
            <RadzenTextBox @bind-Value="_operatorDisplayName" Placeholder="e.g. Jane Doe" />
        </div>
        <div>
            <label>Device name</label>
            <RadzenTextBox @bind-Value="_deviceName" Placeholder="e.g. Jane's Laptop" />
        </div>
        <RadzenButton Text="@(_isPairing ? "Waiting for passkey..." : "Pair Device")" Click="PairAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" Disabled="@(_isPairing || string.IsNullOrWhiteSpace(_operatorDisplayName) || string.IsNullOrWhiteSpace(_deviceName))" />

        @if (_error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert>
        }
    </RadzenStack>
}

@code {
    private string? _token;
    private string _operatorDisplayName = string.Empty;
    private string _deviceName = string.Empty;
    private bool _isPairing;
    private string? _error;
    private (Guid OperatorId, Guid PairedDeviceId, string Role)? _result;

    protected override void OnInitialized()
    {
        var uri = new Uri(NavigationManager.Uri);
        var query = System.Web.HttpUtility.ParseQueryString(uri.Query);
        _token = query["token"];
    }

    private async Task PairAsync()
    {
        if (_token is null)
        {
            return;
        }

        _isPairing = true;
        _error = null;
        try
        {
            if (!await WebAuthn.IsAvailableAsync())
            {
                _error = "This browser does not support WebAuthn/passkeys. Use a modern Chrome, Edge, Firefox, or Safari.";
                return;
            }

            _result = await WebAuthn.CompleteRegistrationAsync(_token, _operatorDisplayName.Trim(), _deviceName.Trim());
        }
        catch (Exception ex)
        {
            _error = $"Pairing failed: {ex.Message}";
        }
        finally
        {
            _isPairing = false;
        }
    }
}
