@page "/analyze/signal-anomalies"
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository

<MudText Typo="Typo.h4" Class="mb-4">Signal Anomaly Report</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudAlert Severity="Severity.Info">
        You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to view signal anomalies.
    </MudAlert>
}
else
{
    <MudPaper Class="pa-4 mb-4" Outlined="true">
        <MudStack>
            <MudSelect T="string" @bind-Value="_selectedDeviceId" Label="Device">
                <MudSelectItem Value="@("")">(All devices)</MudSelectItem>
                @foreach (var device in _devices)
                {
                    <MudSelectItem Value="@device.Id.ToString()">@device.Name</MudSelectItem>
                }
            </MudSelect>
            <label>
                From: <input type="date" @bind="_fromDate" />
            </label>
            <label>
                To: <input type="date" @bind="_toDate" />
            </label>
            <MudButton OnClick="RunReportAsync" Variant="Variant.Filled" Color="Color.Primary">Run Report</MudButton>
        </MudStack>
    </MudPaper>

    @if (_report is not null)
    {
        <MudText Typo="Typo.h5" Class="mt-4 mb-2">Anomalies by Device</MudText>
        @if (_report.AnomaliesByDevice.Count == 0)
        {
            <MudText>No signal anomalies found in this range.</MudText>
        }
        else
        {
            @foreach (var deviceFindings in _report.AnomaliesByDevice)
            {
                <MudText Typo="Typo.h6">@deviceFindings.DeviceName</MudText>
                <MudSimpleTable Hover="true" Dense="true">
                    <thead>
                        <tr>
                            <th>Occurred At</th>
                            <th>Anomaly Type</th>
                            <th>Description</th>
                            <th>RSSI</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var anomaly in deviceFindings.Anomalies)
                        {
                            <tr>
                                <td>@anomaly.OccurredAtUtc</td>
                                <td>@anomaly.AnomalyType</td>
                                <td>@(anomaly.Description ?? "-")</td>
                                <td>@(anomaly.RssiValue?.ToString() ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        }

        <MudText Typo="Typo.h5" Class="mt-4 mb-2">Jamming Summary</MudText>
        @if (_report.JammingByDevice.Count == 0)
        {
            <MudText>No jamming incidents found in this range.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true">
                <thead>
                    <tr>
                        <th>Device</th>
                        <th>Incident Count</th>
                        <th>Total Jammed (min)</th>
                        <th>Avg Degradation (dB)</th>
                        <th>Max Degradation (dB)</th>
                        <th>First Incident</th>
                        <th>Last Incident</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var jamming in _report.JammingByDevice)
                    {
                        <tr>
                            <td>@jamming.DeviceName</td>
                            <td>@jamming.IncidentCount</td>
                            <td>@jamming.TotalJammedDurationMinutes</td>
                            <td>@jamming.AverageDegradationDb</td>
                            <td>@jamming.MaxDegradationDb</td>
                            <td>@(jamming.FirstIncidentUtc?.ToString() ?? "-")</td>
                            <td>@(jamming.LastIncidentUtc?.ToString() ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private SignalAnomalyReport? _report;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildSignalAnomalyReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
