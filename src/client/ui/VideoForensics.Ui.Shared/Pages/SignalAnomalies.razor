@page "/analyze/signal-anomalies"
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Signal Anomaly Report</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        You are not signed in. <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="Sign in" /> to view signal anomalies.
    </RadzenAlert>
}
else
{
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack>
            <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceId" Data="@DeviceOptions"
                TextProperty="Value" ValueProperty="Key" Placeholder="(All devices)" />
            <label>
                From: <RadzenDatePicker TValue="DateTime" @bind-Value="_fromDate" />
            </label>
            <label>
                To: <RadzenDatePicker TValue="DateTime" @bind-Value="_toDate" />
            </label>
            <RadzenButton Text="Run Report" Click="RunReportAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </RadzenStack>
    </RadzenCard>

    @if (_report is not null)
    {
        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Anomalies by Device</RadzenText>
        @if (_report.AnomaliesByDevice.Count == 0)
        {
            <RadzenText>No signal anomalies found in this range.</RadzenText>
        }
        else
        {
            @foreach (var deviceFindings in _report.AnomaliesByDevice)
            {
                <RadzenText TextStyle="TextStyle.H6">@deviceFindings.DeviceName</RadzenText>
                <RadzenDataGrid TItem="SignalAnomalyReport.SignalAnomaly" Data="@deviceFindings.Anomalies" AllowPaging="true" PageSize="20" AllowSorting="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="SignalAnomalyReport.SignalAnomaly" Property="@nameof(SignalAnomalyReport.SignalAnomaly.OccurredAtUtc)" Title="Occurred At" />
                        <RadzenDataGridColumn TItem="SignalAnomalyReport.SignalAnomaly" Property="@nameof(SignalAnomalyReport.SignalAnomaly.AnomalyType)" Title="Anomaly Type" />
                        <RadzenDataGridColumn TItem="SignalAnomalyReport.SignalAnomaly" Title="Description"><Template Context="anomaly">@(anomaly.Description ?? "-")</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SignalAnomalyReport.SignalAnomaly" Title="RSSI"><Template Context="anomaly">@(anomaly.RssiValue?.ToString() ?? "-")</Template></RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Jamming Summary</RadzenText>
        @if (_report.JammingByDevice.Count == 0)
        {
            <RadzenText>No jamming incidents found in this range.</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_jammingByDeviceFilter" TItem="SignalAnomalyReport.JammingSummaryEntry" Data="@_report.JammingByDevice" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="DeviceName" Title="Device" />
                    <RadzenDataFilterProperty Property="IncidentCount" Title="Incident Count" />
                    <RadzenDataFilterProperty Property="TotalJammedDurationMinutes" Title="Total Jammed (min)" />
                    <RadzenDataFilterProperty Property="AverageDegradationDb" Title="Avg Degradation (dB)" />
                    <RadzenDataFilterProperty Property="MaxDegradationDb" Title="Max Degradation (dB)" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="SignalAnomalyReport.JammingSummaryEntry" Data="@_jammingByDeviceFilter?.View" AllowPaging="true" PageSize="20" AllowSorting="true">
                <Columns>
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Property="@nameof(SignalAnomalyReport.JammingSummaryEntry.DeviceName)" Title="Device" />
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Property="@nameof(SignalAnomalyReport.JammingSummaryEntry.IncidentCount)" Title="Incident Count" />
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Property="@nameof(SignalAnomalyReport.JammingSummaryEntry.TotalJammedDurationMinutes)" Title="Total Jammed (min)" />
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Property="@nameof(SignalAnomalyReport.JammingSummaryEntry.AverageDegradationDb)" Title="Avg Degradation (dB)" />
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Property="@nameof(SignalAnomalyReport.JammingSummaryEntry.MaxDegradationDb)" Title="Max Degradation (dB)" />
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Title="First Incident"><Template Context="jamming">@(jamming.FirstIncidentUtc?.ToString() ?? "-")</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Title="Last Incident"><Template Context="jamming">@(jamming.LastIncidentUtc?.ToString() ?? "-")</Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private SignalAnomalyReport? _report;
    private RadzenDataFilter<SignalAnomalyReport.JammingSummaryEntry>? _jammingByDeviceFilter;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildSignalAnomalyReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
