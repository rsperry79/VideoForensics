@page "/analyze/signal-anomalies"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SignalAnomalies> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        @L["NotSignedInMessage"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="Sign in" />
    </RadzenAlert>
}
else
{
    <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
        <RadzenStack>
            <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceId" Data="@DeviceOptions"
                TextProperty="Value" ValueProperty="Key" Placeholder="@L["DeviceFilter"]" />
            <label>
                @L["FromLabel"] <RadzenDatePicker TValue="DateTime" @bind-Value="_fromDate" />
            </label>
            <label>
                @L["ToLabel"] <RadzenDatePicker TValue="DateTime" @bind-Value="_toDate" />
            </label>
            <RadzenButton Text="@L["RunReportButton"]" Click="RunReportAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
        </RadzenStack>
    </RadzenCard>

    @if (_report is not null)
    {
        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["AnomaliesByDeviceHeading"]</RadzenText>
        @if (_report.AnomaliesByDevice.Count == 0)
        {
            <RadzenText>@L["NoAnomaliesFound"]</RadzenText>
        }
        else
        {
            @foreach (var deviceFindings in _report.AnomaliesByDevice)
            {
                <RadzenText TextStyle="TextStyle.H6">@deviceFindings.DeviceName</RadzenText>
                <RadzenDataGrid TItem="SignalAnomalyReport.SignalAnomaly" Data="@deviceFindings.Anomalies" AllowPaging="true" PageSize="20" AllowSorting="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="SignalAnomalyReport.SignalAnomaly" Property="@nameof(SignalAnomalyReport.SignalAnomaly.OccurredAtUtc)" Title="@L["ColOccurredAt"]" />
                        <RadzenDataGridColumn TItem="SignalAnomalyReport.SignalAnomaly" Property="@nameof(SignalAnomalyReport.SignalAnomaly.AnomalyType)" Title="@L["ColAnomalyType"]" />
                        <RadzenDataGridColumn TItem="SignalAnomalyReport.SignalAnomaly" Title="@L["ColDescription"]"><Template Context="anomaly">@(anomaly.Description ?? L["NotAvailable"].Value)</Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="SignalAnomalyReport.SignalAnomaly" Title="@L["ColRssi"]"><Template Context="anomaly">@(anomaly.RssiValue?.ToString() ?? L["NotAvailable"].Value)</Template></RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        }

        <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["JammingSummaryHeading"]</RadzenText>
        @if (_report.JammingByDevice.Count == 0)
        {
            <RadzenText>@L["NoJammingFound"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_jammingByDeviceFilter" TItem="SignalAnomalyReport.JammingSummaryEntry" Data="@_report.JammingByDevice" Auto="true" class="mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="DeviceName" Title="@L["ColDevice"]" />
                    <RadzenDataFilterProperty Property="IncidentCount" Title="@L["ColIncidentCount"]" />
                    <RadzenDataFilterProperty Property="TotalJammedDurationMinutes" Title="@L["ColTotalJammedMin"]" />
                    <RadzenDataFilterProperty Property="AverageDegradationDb" Title="@L["ColAvgDegradation"]" />
                    <RadzenDataFilterProperty Property="MaxDegradationDb" Title="@L["ColMaxDegradation"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="SignalAnomalyReport.JammingSummaryEntry" Data="@_jammingByDeviceFilter?.View" AllowPaging="true" PageSize="20" AllowSorting="true">
                <Columns>
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Property="@nameof(SignalAnomalyReport.JammingSummaryEntry.DeviceName)" Title="@L["ColDevice"]" />
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Property="@nameof(SignalAnomalyReport.JammingSummaryEntry.IncidentCount)" Title="@L["ColIncidentCount"]" />
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Property="@nameof(SignalAnomalyReport.JammingSummaryEntry.TotalJammedDurationMinutes)" Title="@L["ColTotalJammedMin"]" />
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Property="@nameof(SignalAnomalyReport.JammingSummaryEntry.AverageDegradationDb)" Title="@L["ColAvgDegradation"]" />
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Property="@nameof(SignalAnomalyReport.JammingSummaryEntry.MaxDegradationDb)" Title="@L["ColMaxDegradation"]" />
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Title="@L["ColFirstIncident"]"><Template Context="jamming">@(jamming.FirstIncidentUtc?.ToString() ?? L["NotAvailable"].Value)</Template></RadzenDataGridColumn>
                    <RadzenDataGridColumn TItem="SignalAnomalyReport.JammingSummaryEntry" Title="@L["ColLastIncident"]"><Template Context="jamming">@(jamming.LastIncidentUtc?.ToString() ?? L["NotAvailable"].Value)</Template></RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private SignalAnomalyReport? _report;
    private RadzenDataFilter<SignalAnomalyReport.JammingSummaryEntry>? _jammingByDeviceFilter;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildSignalAnomalyReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }
}
