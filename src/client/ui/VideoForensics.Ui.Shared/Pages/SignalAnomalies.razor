@page "/analyze/signal-anomalies"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@inject IProviderAuthService AuthService
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SignalAnomalies> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedInMessage"] <a href="@NavigationManager.SignInPathWithReturnUrl()">Sign in</a>
    </div>
}
else
{
    <PageRightPanelContent>
        <div class="right-panel-section">
            <small>@L["FiltersLabel"]</small>
            <div class="d-flex flex-column gap-2">
                <SfDropDownList TValue="string" TItem="KeyValuePair<string, string>" @bind-Value="_selectedDeviceId" DataSource="@DeviceOptions" Placeholder="@L["DeviceFilter"]">
                    <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
                </SfDropDownList>
                <label>
                    @L["FromLabel"] <SfDatePicker TValue="DateTime" @bind-Value="_fromDate" CssClass="w-100" />
                </label>
                <label>
                    @L["ToLabel"] <SfDatePicker TValue="DateTime" @bind-Value="_toDate" CssClass="w-100" />
                </label>
                <SfButton Content="@L["RunReportButton"]" OnClick="RunReportAsync" CssClass="e-primary" />
            </div>
        </div>

    </PageRightPanelContent>

    @if (_report is not null)
    {
        <h5 class="mt-4 mb-2">@L["AnomaliesByDeviceHeading"]</h5>
        @if (_report.AnomaliesByDevice.Count == 0)
        {
            <span>@L["NoAnomaliesFound"]</span>
        }
        else
        {
            @foreach (var deviceFindings in _report.AnomaliesByDevice)
            {
                <h6>@deviceFindings.DeviceName</h6>
                <SfGrid TValue="SignalAnomalyReport.SignalAnomaly" DataSource="@deviceFindings.Anomalies" AllowPaging="true" AllowSorting="true" AllowResizing="true">
                    <GridPageSettings PageSize="20"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(SignalAnomalyReport.SignalAnomaly.OccurredAtUtc)" HeaderText="@L["ColOccurredAt"]" MinWidth="100" />
                        <GridColumn Field="@nameof(SignalAnomalyReport.SignalAnomaly.AnomalyType)" HeaderText="@L["ColAnomalyType"]" MinWidth="100" />
                        <GridColumn HeaderText="@L["ColDescription"]" MinWidth="100">
                            <Template>
                                @{
                                    var anomaly = (SignalAnomalyReport.SignalAnomaly)context;
                                    @(anomaly.Description ?? L["NotAvailable"].Value)
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn HeaderText="@L["ColRssi"]" MinWidth="100">
                            <Template>
                                @{
                                    var anomaly = (SignalAnomalyReport.SignalAnomaly)context;
                                    @(anomaly.RssiValue?.ToString() ?? L["NotAvailable"].Value)
                                }
                            </Template>
                        </GridColumn>
                    </GridColumns>
                </SfGrid>
            }
        }

        <h5 class="mt-4 mb-2">@L["JammingSummaryHeading"]</h5>
        @if (_report.JammingByDevice.Count == 0)
        {
            <span>@L["NoJammingFound"]</span>
        }
        else
        {
            <SfGrid TValue="SignalAnomalyReport.JammingSummaryEntry" DataSource="@_filteredJammingByDevice" AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowResizing="true">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(SignalAnomalyReport.JammingSummaryEntry.DeviceName)" HeaderText="@L["ColDevice"]" MinWidth="100" />
                    <GridColumn Field="@nameof(SignalAnomalyReport.JammingSummaryEntry.IncidentCount)" HeaderText="@L["ColIncidentCount"]" MinWidth="100" />
                    <GridColumn Field="@nameof(SignalAnomalyReport.JammingSummaryEntry.TotalJammedDurationMinutes)" HeaderText="@L["ColTotalJammedMin"]" MinWidth="100" />
                    <GridColumn Field="@nameof(SignalAnomalyReport.JammingSummaryEntry.AverageDegradationDb)" HeaderText="@L["ColAvgDegradation"]" MinWidth="100" />
                    <GridColumn Field="@nameof(SignalAnomalyReport.JammingSummaryEntry.MaxDegradationDb)" HeaderText="@L["ColMaxDegradation"]" MinWidth="100" />
                    <GridColumn HeaderText="@L["ColFirstIncident"]" MinWidth="100">
                        <Template>
                            @{
                                var jamming = (SignalAnomalyReport.JammingSummaryEntry)context;
                                @(jamming.FirstIncidentUtc?.ToString() ?? L["NotAvailable"].Value)
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColLastIncident"]" MinWidth="100">
                        <Template>
                            @{
                                var jamming = (SignalAnomalyReport.JammingSummaryEntry)context;
                                @(jamming.LastIncidentUtc?.ToString() ?? L["NotAvailable"].Value)
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private SignalAnomalyReport? _report;
    private IEnumerable<SignalAnomalyReport.JammingSummaryEntry> _filteredJammingByDevice = new List<SignalAnomalyReport.JammingSummaryEntry>();

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildSignalAnomalyReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);

        if (_report?.JammingByDevice != null)
        {
            _filteredJammingByDevice = _report.JammingByDevice;
        }
    }

}
