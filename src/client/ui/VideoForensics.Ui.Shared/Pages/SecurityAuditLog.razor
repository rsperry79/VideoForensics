@page "/settings/security-log"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Layout.RightPanel
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject IStringLocalizer<SecurityAuditLog> L

<h4 class="mb-4">@L["Title"]</h4>

<PageRightPanelContent>
    <div class="right-panel-section">
        <span class="d-block mb-2">@L["OperatorIdLabel"]</span>
        <div class="d-flex flex-row gap-2 align-items-center mb-2">
            <SfTextBox @bind-Value="_operatorIdInput" Placeholder="@L["OperatorIdPlaceholder"]" />
            <SfButton Content="@L["RefreshButton"]" OnClick="@LoadAsync" Disabled="@_isLoading" />
        </div>
    </div>
</PageRightPanelContent>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_authError is not null)
{
    <div class="alert alert-danger mb-2">@_authError</div>
    <span>@L["NotAuthorizedMessage"]</span>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else if (_entries is null || _entries.Count == 0)
{
    <span>@L["NoEntriesFound"]</span>
}
else
{
    <SfGrid TValue="SecurityAuditLogEntry" DataSource="@_filteredEntries" AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowResizing="true">
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
        <GridPageSettings PageSize="20"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(SecurityAuditLogEntry.TimestampUtc)" HeaderText="@L["ColTimestamp"]" MinWidth="100" />
            <GridColumn Field="@nameof(SecurityAuditLogEntry.EventType)" HeaderText="@L["ColEventType"]" MinWidth="100" />
            <GridColumn HeaderText="@L["ColOperatorId"]" MinWidth="100">
                <Template>
                    @{
                        var entry = (SecurityAuditLogEntry)context;
                        var operatorName = entry.OperatorId.HasValue && _operatorLookup.TryGetValue(entry.OperatorId.Value, out var opName)
                            ? opName
                            : entry.OperatorId?.ToString("N")?[..8] ?? L["NotAvailable"].Value;
                        @operatorName
                    }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="@L["ColPairedDeviceId"]" MinWidth="100">
                <Template>
                    @{
                        var entry = (SecurityAuditLogEntry)context;
                        var deviceName = entry.PairedDeviceId.HasValue && _pairedDeviceLookup.TryGetValue(entry.PairedDeviceId.Value, out var devName)
                            ? devName
                            : entry.PairedDeviceId?.ToString("N")?[..8] ?? L["NotAvailable"].Value;
                        @deviceName
                    }
                </Template>
            </GridColumn>
            <GridColumn Field="@nameof(SecurityAuditLogEntry.SourceIp)" HeaderText="@L["ColSourceIp"]" MinWidth="100" />
            <GridColumn HeaderText="@L["ColDetails"]" MinWidth="100">
                <Template>
                    @{
                        var row = (SecurityAuditLogEntry)context;
                        @(row.Details ?? L["NotAvailable"].Value)
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private bool _isLoading = true;
    private List<SecurityAuditLogEntry>? _entries;
    private IEnumerable<SecurityAuditLogEntry> _filteredEntries = new List<SecurityAuditLogEntry>();
    private string? _authError;
    private string? _loadError;
    private string _operatorIdInput = string.Empty;
    private Dictionary<Guid, string> _operatorLookup = new();
    private Dictionary<Guid, string> _pairedDeviceLookup = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        try
        {
            var client = CreateClient();

            // Fetch operators
            try
            {
                var operatorResponse = await client.GetAsync("api/devices-management/operators");
                if (operatorResponse.IsSuccessStatusCode)
                {
                    var operators = await operatorResponse.Content.ReadFromJsonAsync<List<VideoForensics.Data.Common.Entities.Operator>>(JsonOptions);
                    if (operators is not null)
                    {
                        _operatorLookup = operators.ToDictionary(o => o.Id, o => o.DisplayName);
                    }
                }
            }
            catch { /* Ignore operator fetch errors */ }

            // Fetch paired devices
            try
            {
                var deviceResponse = await client.GetAsync("api/devices-management/paired-devices");
                if (deviceResponse.IsSuccessStatusCode)
                {
                    var devices = await deviceResponse.Content.ReadFromJsonAsync<List<VideoForensics.Data.Common.Entities.PairedDevice>>(JsonOptions);
                    if (devices is not null)
                    {
                        _pairedDeviceLookup = devices.ToDictionary(d => d.Id, d => d.DeviceName);
                    }
                }
            }
            catch { /* Ignore device fetch errors */ }

            var url = "api/security-audit-log";
            if (Guid.TryParse(_operatorIdInput, out var operatorId))
            {
                url += $"?operatorId={operatorId}";
            }

            var response = await client.GetAsync(url);
            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = L["NotAuthorizedToView"];
                _entries = null;
                return;
            }

            response.EnsureSuccessStatusCode();
            _entries = await response.Content.ReadFromJsonAsync<List<SecurityAuditLogEntry>>(JsonOptions);
            _filteredEntries = _entries?.OrderByDescending(e => e.TimestampUtc).AsEnumerable() ?? new List<SecurityAuditLogEntry>();
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToLoad", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
}
