@page "/settings/security-log"
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Services
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState

<MudText Typo="Typo.h4" Class="mb-4">Security Audit Log</MudText>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudTextField @bind-Value="_operatorIdInput" Label="Operator Id" Placeholder="(optional) filter by operator id" Variant="Variant.Outlined" Immediate="true" Style="max-width: 320px;" />
    <MudButton OnClick="LoadAsync" Disabled="@_isLoading" Variant="Variant.Outlined">Refresh</MudButton>
</MudStack>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_authError is not null)
{
    <MudAlert Severity="Severity.Error" Class="mb-2">@_authError</MudAlert>
    <MudText>
        Not authorized. <MudLink Href="/device-signin">Sign in with your passkey</MudLink> - an Admin (or higher)
        device is required to view the security audit log.
    </MudText>
}
else if (_loadError is not null)
{
    <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
}
else if (_entries is null || _entries.Count == 0)
{
    <MudText>No audit log entries found.</MudText>
}
else
{
    <MudTable Items="@_entries.OrderByDescending(e => e.TimestampUtc)" Hover="true" Dense="true">
        <HeaderContent>
            <MudTh>Timestamp (UTC)</MudTh>
            <MudTh>Event Type</MudTh>
            <MudTh>Operator Id</MudTh>
            <MudTh>Paired Device Id</MudTh>
            <MudTh>Source IP</MudTh>
            <MudTh>Details</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Timestamp (UTC)" Style="@(context.IsUrgent ? "color:var(--mud-palette-error);font-weight:bold" : null)">@context.TimestampUtc</MudTd>
            <MudTd DataLabel="Event Type" Style="@(context.IsUrgent ? "color:var(--mud-palette-error);font-weight:bold" : null)">@context.EventType</MudTd>
            <MudTd DataLabel="Operator Id" Style="@(context.IsUrgent ? "color:var(--mud-palette-error);font-weight:bold" : null)">@(context.OperatorId?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="Paired Device Id" Style="@(context.IsUrgent ? "color:var(--mud-palette-error);font-weight:bold" : null)">@(context.PairedDeviceId?.ToString() ?? "-")</MudTd>
            <MudTd DataLabel="Source IP" Style="@(context.IsUrgent ? "color:var(--mud-palette-error);font-weight:bold" : null)">@(context.SourceIp ?? "-")</MudTd>
            <MudTd DataLabel="Details" Style="@(context.IsUrgent ? "color:var(--mud-palette-error);font-weight:bold" : null)">@(context.Details ?? "-")</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool _isLoading = true;
    private List<SecurityAuditLogEntry>? _entries;
    private string? _authError;
    private string? _loadError;
    private string _operatorIdInput = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        try
        {
            var client = CreateClient();
            var url = "api/security-audit-log";
            if (Guid.TryParse(_operatorIdInput, out var operatorId))
            {
                url += $"?operatorId={operatorId}";
            }

            var response = await client.GetAsync(url);
            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = "Not authorized to view the security audit log.";
                _entries = null;
                return;
            }

            response.EnsureSuccessStatusCode();
            _entries = await response.Content.ReadFromJsonAsync<List<SecurityAuditLogEntry>>(JsonOptions);
        }
        catch (Exception ex)
        {
            _loadError = $"Failed to load security audit log: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
}
