@page "/live-view"
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Client.Common.Contracts
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using VideoForensics.Ui.Shared.Contracts
@using VideoForensics.Ui.Shared.Services
@implements IAsyncDisposable

@inject ILiveViewSessionService LiveViewSessionService
@inject ILiveViewSessionSource LiveViewSessionSource
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IJSRuntime JsRuntime
@inject IStringLocalizer<LiveView> L
@inject ILogger<LiveView> Logger

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a>
    </div>
}
else
{
    <PageRightPanelContent>
        <div class="right-panel-section">
            <small>@L["Title"]</small>
            <div class="d-flex flex-column gap-2">
                <SfDropDownList TValue="string" TItem="KeyValuePair<string, string>"
                    @bind-Value="_selectedDeviceIdStr"
                    DataSource="@(DeviceOptions.ToList())"
                    Placeholder="@L["SelectDevice"]">
                    <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
                </SfDropDownList>

                <div class="d-flex flex-row gap-2">
                    <SfButton Content="@(_isConnected ? L["Stop"] : L["Start"])"
                        OnClick="@(async () => await ToggleLiveViewAsync())"
                        CssClass="@(_isConnected ? "e-danger" : "e-primary")"
                        Disabled="@(_isToggling || string.IsNullOrEmpty(_selectedDeviceIdStr))" />
                </div>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger">@_error</div>
                }

                @if (_isConnected)
                {
                    <div class="alert alert-success">@L["Connected"]</div>
                }
            </div>
        </div>

        @if (_selectedSessionId.HasValue)
        {
            <div class="right-panel-section">
                <small>@L["TelemetryHeading"]</small>
                @if (_latestTelemetry is null)
                {
                    <div class="text-muted small">@L["NoDataYet"]</div>
                }
                else
                {
                    <dl class="row small mb-0">
                        <dt class="col-7">@L["LossLabel"]</dt>
                        <dd class="col-5">@TelemetryText(LiveViewTelemetryFormatter.FormatLossPercent(_latestTelemetry.FractionLost))</dd>

                        <dt class="col-7">@L["PacketsLostLabel"]</dt>
                        <dd class="col-5">@TelemetryText(LiveViewTelemetryFormatter.FormatCount(_latestTelemetry.CumulativePacketsLost))</dd>

                        <dt class="col-7">@L["JitterLabel"]</dt>
                        <dd class="col-5">@TelemetryText(LiveViewTelemetryFormatter.FormatCount(_latestTelemetry.JitterTicks))</dd>

                        <dt class="col-7">@L["BitrateLabel"]</dt>
                        <dd class="col-5">@TelemetryText(LiveViewTelemetryFormatter.FormatKilobitsPerSecond(_latestTelemetry.BitrateBps))</dd>

                        <dt class="col-7">@L["ScoreLabel"]</dt>
                        <dd class="col-5">@TelemetryText(LiveViewTelemetryFormatter.FormatScore(_latestTelemetry.InterferenceScore))</dd>
                    </dl>
                }
            </div>
        }
    </PageRightPanelContent>

    <div class="live-view-container">
        <video id="liveViewPlayer" class="live-view-video" autoplay playsinline muted></video>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated = false;
    private bool _isConnected = false;
    private bool _isToggling = false;
    private string? _selectedDeviceIdStr;
    private Guid? _selectedSessionId;
    private string? _error;
    private Dictionary<string, string> DeviceOptions { get; set; } = new();

    private object? _hubConnection;
    private IJSObjectReference? _jsModule;
    private readonly LiveViewActivationWaiter _activationWaiter = new();
    private IDisposable? _telemetrySubscription;
    private LiveViewTelemetrySample? _latestTelemetry;

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _isAuthenticated = true; // Assume authenticated since @attribute [Authorize] gates the page

        try
        {
            // Load available devices
            var devices = await DeviceRepository.ListAsync(System.Threading.CancellationToken.None);
            DeviceOptions = devices
                .ToDictionary(d => d.Id.ToString(), d => d.Name ?? $"Device {d.ProviderDeviceId}")
                .OrderBy(kv => kv.Value)
                .ToDictionary(kv => kv.Key, kv => kv.Value);

            // Load JavaScript module
            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./js/liveview.js");

            // Initialize SignalR connection via JS
            _hubConnection = await _jsModule.InvokeAsync<dynamic>("initializeHubConnection", NavigationManager.ToAbsoluteUri("/hubs/liveview-signaling").ToString());

            // Set up ICE candidate handler via JS
            await _jsModule.InvokeVoidAsync("setupIceCandidateHandler", _jsModule);
        }
        catch (Exception ex)
        {
            _error = L["ErrorInitializing", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ToggleLiveViewAsync()
    {
        try
        {
            _isToggling = true;
            _error = null;

            if (_isConnected)
            {
                // Stop the session
                if (_selectedSessionId.HasValue)
                {
                    await LiveViewSessionService.StopAsync(
                        _selectedSessionId.Value,
                        "ManualStop",
                        System.Threading.CancellationToken.None);

                    await UnsubscribeFromSessionAsync(_selectedSessionId.Value);
                    _selectedSessionId = null;
                    _isConnected = false;
                }
            }
            else
            {
                // Start new session
                if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
                {
                    _error = L["InvalidDevice"];
                    return;
                }

                var session = await LiveViewSessionService.StartAsync(
                    deviceId,
                    LiveViewTriggerReason.Manual,
                    null,
                    System.Threading.CancellationToken.None);

                _selectedSessionId = session.Id;
                SubscribeToTelemetry(session.Id);

                // Always wait, even when the start response is already Active. The waiter joins the session's push
                // group before its race-guard read, so telemetry arrives for a session that was Active at start.
                LiveViewSession? active = await _activationWaiter.WaitForActiveAsync(
                    session.Id,
                    LiveViewSessionSource,
                    ct => LiveViewSessionService.GetActiveSessionAsync(deviceId, ct),
                    LiveViewActivationWaiter.DefaultTimeout,
                    System.Threading.CancellationToken.None);

                if (active is null)
                {
                    _error = L["SessionFailedToConnect"];
                    await UnsubscribeFromSessionAsync(session.Id);
                    _selectedSessionId = null;
                    return;
                }

                // Start WebRTC stream
                if (_jsModule != null && _hubConnection != null)
                {
                    await _jsModule.InvokeVoidAsync(
                        "startLiveView",
                        _hubConnection,
                        active.Id,
                        "liveViewPlayer");
                    _isConnected = true;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            _isConnected = false;
            if (_selectedSessionId.HasValue)
                await UnsubscribeFromSessionAsync(_selectedSessionId.Value);
            _selectedSessionId = null;
        }
        finally
        {
            _isToggling = false;
        }
    }

    private async Task CleanupAsync()
    {
        if (_isConnected && _selectedSessionId.HasValue)
        {
            try
            {
                await LiveViewSessionService.StopAsync(
                    _selectedSessionId.Value,
                    "PageDisposed",
                    System.Threading.CancellationToken.None);
            }
            catch { }
        }

        if (_selectedSessionId.HasValue)
            await UnsubscribeFromSessionAsync(_selectedSessionId.Value);

        DisposeTelemetrySubscription();

        if (_jsModule is not null)
            await _jsModule.DisposeAsync();
    }

    // Leaving the push group is best effort: the page is already leaving this session. A failure is logged and does not
    // block the stop or dispose, since the hub drops group membership on disconnect anyway.
    private async Task UnsubscribeFromSessionAsync(Guid sessionId)
    {
        DisposeTelemetrySubscription();

        try
        {
            await LiveViewSessionSource.UnsubscribeAsync(sessionId, System.Threading.CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Could not leave the live-view push group for a session");
        }
    }

    // Telemetry arrives on a hub thread, so the update is marshalled onto the component's dispatcher. Samples for
    // any other session are ignored, so a stale push cannot overwrite the session on screen.
    private void SubscribeToTelemetry(Guid sessionId)
    {
        DisposeTelemetrySubscription();
        _telemetrySubscription = LiveViewSessionSource.Telemetry.Subscribe(sample =>
        {
            if (sample.SessionId != sessionId)
            {
                return;
            }

            _ = InvokeAsync(() =>
            {
                _latestTelemetry = sample;
                StateHasChanged();
            });
        });
    }

    private void DisposeTelemetrySubscription()
    {
        _telemetrySubscription?.Dispose();
        _telemetrySubscription = null;
        _latestTelemetry = null;
    }

    // A value the formatter could not produce is a resource key; everything else is already invariant-formatted text.
    private string TelemetryText(string text) =>
        text == LiveViewTelemetryFormatter.NotAvailableKey ? L[text].Value : text;

    public async ValueTask DisposeAsync()
    {
        await CleanupAsync();
    }
}

<style>
.live-view-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    height: 100%;
    background-color: #000;
}

.live-view-video {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
}
</style>
