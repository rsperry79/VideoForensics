@page "/welcome"
@layout MinimalLayout
@using VideoForensics.Ui.Shared.Services
@inject NavigationManager NavigationManager
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Welcome> L

<p class="card-text text-center text-muted mb-5">@L["WelcomeMessage"]</p>

<div class="d-flex flex-column gap-3">
    <SfButton CssClass="btn-primary btn-lg" OnClick="@(() => NavigationManager.NavigateTo("/signin"))">
        @L["Login"]
    </SfButton>
    <SfButton CssClass="btn-outline-primary btn-lg" OnClick="@(() => NavigationManager.NavigateTo("/register"))">
        @L["CreateNewAccount"]
    </SfButton>
</div>
