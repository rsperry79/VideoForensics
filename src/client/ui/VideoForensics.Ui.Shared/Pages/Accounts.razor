@page "/accounts"
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@inject IProviderAccountRepository ProviderAccountRepository
@inject IUserRepository UserRepository
@inject IProviderAuthService AuthService
@inject IMultiProviderAuthService MultiProviderAuthService
@inject IForensicsConfiguration ForensicsConfig
@inject IForensicsConfigurationService ForensicsConfigService
@inject IStringLocalizer<Accounts> L
@inject NavigationManager NavigationManager

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <p>@_statusMessage</p>
    }

    @if (_rows.Count == 0)
    {
        <p>@L["NoAccountsLinked"]</p>
    }
    else
    {
        <SfGrid TValue="AccountRow" DataSource="@_filteredRows" AllowSorting="true" AllowPaging="true" AllowFiltering="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
            <GridPageSettings PageSize="20"></GridPageSettings>
            <GridColumns>
                <GridColumn HeaderText="" Width="60px" AllowSorting="false" AllowFiltering="false">
                    <Template>
                        @{
                            var row = (AccountRow)context;
                            @if (!string.IsNullOrEmpty(row.Account.LastErrorMessage))
                            {
                                <i class="material-icons" style="color: #d32f2f; cursor: help;" title="@($"{row.Account.LastErrorMessage}\n(as of {row.Account.LastErrorUtc?.ToString() ?? "unknown"})")">error</i>
                            }
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="DisplayName" HeaderText="@L["ColDisplayName"]" />
                <GridColumn Field="Account.ProviderName" HeaderText="@L["ColProvider"]" />
                <GridColumn Field="Account.LinkedUtc" HeaderText="@L["ColLinked"]" />
                <GridColumn HeaderText="@L["ColLastAuth"]">
                    <Template>
                        @{
                            var row = (AccountRow)context;
                            @(row.Account.LastSuccessfulAuthUtc?.ToString() ?? "-")
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="@L["ColActive"]">
                    <Template>
                        @{
                            var row = (AccountRow)context;
                            @(row.Account.Id == ForensicsConfig.ActiveProviderAccountId ? L["Yes"] : "")
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="">
                    <Template>
                        @{
                            var row = (AccountRow)context;
                            @if (_confirmingRemoveId == row.Account.Id)
                            {
                                <div class="d-flex gap-2">
                                    <p>@L["AreYouSure"]</p>
                                    <SfButton Content="@L["Yes"]" OnClick="() => RemoveAccountAsync(row.Account.Id)" Disabled="@_isBusy" CssClass="e-success" />
                                    <SfButton Content="@L["No"]" OnClick="() => _confirmingRemoveId = null" Disabled="@_isBusy" CssClass="e-outline" />
                                </div>
                            }
                            else
                            {
                                <div class="d-flex gap-2">
                                    <SfButton Content="@L["Details"]" OnClick="@((UIMouseEventArgs) => GoToAccountDetailsAsync(row.Account.Id))" Disabled="@_isBusy" CssClass="e-info" />
                                    <SfButton Content="@L["Schedule"]" OnClick="@((UIMouseEventArgs) => GoToAccountScheduleAsync(row.Account.Id))" Disabled="@_isBusy" CssClass="e-info" />
                                    <SfButton Content="@L["Select"]" OnClick="() => SelectAccountAsync(row.Account.Id)" Disabled="@_isBusy" CssClass="e-primary" />
                                    <SfButton Content="@L["Remove"]" OnClick="() => _confirmingRemoveId = row.Account.Id" Disabled="@_isBusy" CssClass="e-danger" />
                                </div>
                            }
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }
}

<div class="mt-4">
    <SfButton CssClass="e-primary" Content="@L["AddAccount"]" OnClick="GoToAddAccount" />
</div>

@code {
    private sealed record AccountRow(VideoForensics.Data.Common.Entities.ProviderAccount Account, string DisplayName);

    private List<AccountRow> _rows = new();
    private IEnumerable<AccountRow> _filteredRows = new List<AccountRow>();
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _statusMessage;
    private Guid? _confirmingRemoveId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        try
        {
            var accounts = await ProviderAccountRepository.ListAsync(CancellationToken.None);
            var rows = new List<AccountRow>();
            foreach (var account in accounts)
            {
                string displayName = account.ProviderName;
                try
                {
                    var user = await UserRepository.GetAsync(account.UserId, CancellationToken.None);
                    if (user is not null)
                    {
                        displayName = user.DisplayName;
                    }
                }
                catch
                {
                    // Fall back to ProviderName if user lookup fails for any reason.
                }

                rows.Add(new AccountRow(account, displayName));
            }

            _rows = rows;
            _filteredRows = _rows;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectAccountAsync(Guid accountId)
    {
        _isBusy = true;
        _statusMessage = null;
        try
        {
            ForensicsConfig.ActiveProviderAccountId = accountId;
            try
            {
                await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);
            }
            catch (NotSupportedException)
            {
                _statusMessage = L["ConfigurationNotSupported"]?.Value ?? "This setting can only be changed from the server directly.";
                return;
            }

            var resumed = await AuthService.RestoreFromSavedCredentialsAsync(accountId);
            _statusMessage = resumed
                ? L["SwitchedAndResumed"]
                : L["SwitchedNotResumed"];
        }
        catch (Exception ex)
        {
            _statusMessage = L["CouldNotSwitch", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RemoveAccountAsync(Guid accountId)
    {
        _isBusy = true;
        _confirmingRemoveId = null;
        _statusMessage = null;
        try
        {
            await ProviderAccountRepository.DeleteAsync(accountId, CancellationToken.None);

            if (ForensicsConfig.ActiveProviderAccountId == accountId)
            {
                ForensicsConfig.ActiveProviderAccountId = null;
                try
                {
                    await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);
                }
                catch (NotSupportedException)
                {
                    _statusMessage = L["ConfigurationNotSupported"]?.Value ?? "This setting can only be changed from the server directly.";
                    return;
                }
            }

            await LoadAccountsAsync();
            _statusMessage = L["AccountRemoved"];
        }
        catch (Exception ex)
        {
            _statusMessage = L["CouldNotRemove", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private void GoToAddAccount()
    {
        NavigationManager.NavigateTo("/accounts/add");
    }

    private async Task HandleAccountAddedAsync(AuthResult result)
    {
        _statusMessage = L["AccountAdded"];
        await LoadAccountsAsync();
    }

    private void GoToAccountDetailsAsync(Guid accountId)
    {
        NavigationManager.NavigateTo($"/accounts/{accountId}");
    }

    private void GoToAccountScheduleAsync(Guid accountId)
    {
        NavigationManager.NavigateTo($"/accounts/{accountId}/schedule");
    }
}
