@page "/accounts"
@using Microsoft.Extensions.Localization
@inject IProviderAccountRepository ProviderAccountRepository
@inject IUserRepository UserRepository
@inject IProviderAuthService AuthService
@inject IForensicsConfiguration ForensicsConfig
@inject IForensicsConfigurationService ForensicsConfigService
@inject IStringLocalizer<Accounts> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else
{
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <RadzenText>@_statusMessage</RadzenText>
    }

    @if (_rows.Count == 0)
    {
        <RadzenText>@L["NoAccountsLinked"]</RadzenText>
    }
    else
    {
        <RadzenDataFilter @ref="_rowsFilter" TItem="AccountRow" Data="@_rows" Auto="true" class="mb-2">
            <Properties>
                <RadzenDataFilterProperty Property="DisplayName" Title="@L["ColDisplayName"]" />
                <RadzenDataFilterProperty Property="Account.ProviderName" Title="@L["ColProvider"]" />
                <RadzenDataFilterProperty Property="Account.LinkedUtc" Title="@L["ColLinked"]" />
                <RadzenDataFilterProperty Property="Account.LastSuccessfulAuthUtc" Title="@L["ColLastAuth"]" />
            </Properties>
        </RadzenDataFilter>
        <RadzenDataGrid TItem="AccountRow" Data="@_rowsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
            <Columns>
                <RadzenDataGridColumn TItem="AccountRow" Property="DisplayName" Title="@L["ColDisplayName"]" />
                <RadzenDataGridColumn TItem="AccountRow" Property="Account.ProviderName" Title="@L["ColProvider"]" />
                <RadzenDataGridColumn TItem="AccountRow" Property="Account.LinkedUtc" Title="@L["ColLinked"]" />
                <RadzenDataGridColumn TItem="AccountRow" Title="@L["ColLastAuth"]">
                    <Template Context="row">@(row.Account.LastSuccessfulAuthUtc?.ToString() ?? "-")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AccountRow" Title="@L["ColActive"]" Sortable="false" Filterable="false">
                    <Template Context="row">@(row.Account.Id == ForensicsConfig.ActiveProviderAccountId ? L["Yes"] : "")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AccountRow" Title="" Sortable="false" Filterable="false">
                    <Template Context="row">
                        <RadzenButton Text="@L["Select"]" Click="() => SelectAccountAsync(row.Account.Id)" Disabled="@_isBusy" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                        @if (_confirmingRemoveId == row.Account.Id)
                        {
                            <RadzenText>@L["AreYouSure"]</RadzenText>
                            <RadzenButton Text="@L["Yes"]" Click="() => RemoveAccountAsync(row.Account.Id)" Disabled="@_isBusy" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" />
                            <RadzenButton Text="@L["No"]" Click="() => _confirmingRemoveId = null" Disabled="@_isBusy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" />
                        }
                        else
                        {
                            <RadzenButton Text="@L["Remove"]" Click="() => _confirmingRemoveId = row.Account.Id" Disabled="@_isBusy" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}

<RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["AddAccount"]</RadzenText>
<AuthForm IdPrefix="addaccount" SubmitLabel="@L["AddAccount"]" OnAuthenticated="HandleAccountAddedAsync" />

@code {
    private sealed record AccountRow(VideoForensics.Data.Common.Entities.ProviderAccount Account, string DisplayName);

    private List<AccountRow> _rows = new();
    private RadzenDataFilter<AccountRow>? _rowsFilter;
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _statusMessage;
    private Guid? _confirmingRemoveId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        try
        {
            var accounts = await ProviderAccountRepository.ListAsync(CancellationToken.None);
            var rows = new List<AccountRow>();
            foreach (var account in accounts)
            {
                string displayName = account.ProviderName;
                try
                {
                    var user = await UserRepository.GetAsync(account.UserId, CancellationToken.None);
                    if (user is not null)
                    {
                        displayName = user.DisplayName;
                    }
                }
                catch
                {
                    // Fall back to ProviderName if user lookup fails for any reason.
                }

                rows.Add(new AccountRow(account, displayName));
            }

            _rows = rows;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectAccountAsync(Guid accountId)
    {
        _isBusy = true;
        _statusMessage = null;
        try
        {
            ForensicsConfig.ActiveProviderAccountId = accountId;
            await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);

            var resumed = await AuthService.RestoreFromSavedCredentialsAsync(accountId);
            _statusMessage = resumed
                ? L["SwitchedAndResumed"]
                : L["SwitchedNotResumed"];
        }
        catch (Exception ex)
        {
            _statusMessage = L["CouldNotSwitch", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RemoveAccountAsync(Guid accountId)
    {
        _isBusy = true;
        _confirmingRemoveId = null;
        _statusMessage = null;
        try
        {
            await ProviderAccountRepository.DeleteAsync(accountId, CancellationToken.None);

            if (ForensicsConfig.ActiveProviderAccountId == accountId)
            {
                ForensicsConfig.ActiveProviderAccountId = null;
                await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);
            }

            await LoadAccountsAsync();
            _statusMessage = L["AccountRemoved"];
        }
        catch (Exception ex)
        {
            _statusMessage = L["CouldNotRemove", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleAccountAddedAsync(AuthResult result)
    {
        _statusMessage = L["AccountAdded"];
        await LoadAccountsAsync();
    }
}
