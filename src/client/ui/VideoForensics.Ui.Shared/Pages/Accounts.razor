@page "/accounts"
@inject IProviderAccountRepository ProviderAccountRepository
@inject IUserRepository UserRepository
@inject IProviderAuthService AuthService
@inject IForensicsConfiguration ForensicsConfig
@inject IForensicsConfigurationService ForensicsConfigService

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Accounts</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else
{
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <RadzenText>@_statusMessage</RadzenText>
    }

    @if (_rows.Count == 0)
    {
        <RadzenText>No accounts linked yet.</RadzenText>
    }
    else
    {
        <RadzenDataFilter @ref="_rowsFilter" TItem="AccountRow" Data="@_rows" Auto="true" class="mb-2">
            <Properties>
                <RadzenDataFilterProperty Property="DisplayName" Title="Display Name" />
                <RadzenDataFilterProperty Property="Account.ProviderName" Title="Provider" />
                <RadzenDataFilterProperty Property="Account.LinkedUtc" Title="Linked" />
                <RadzenDataFilterProperty Property="Account.LastSuccessfulAuthUtc" Title="Last Auth" />
            </Properties>
        </RadzenDataFilter>
        <RadzenDataGrid TItem="AccountRow" Data="@_rowsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
            <Columns>
                <RadzenDataGridColumn TItem="AccountRow" Property="DisplayName" Title="Display Name" />
                <RadzenDataGridColumn TItem="AccountRow" Property="Account.ProviderName" Title="Provider" />
                <RadzenDataGridColumn TItem="AccountRow" Property="Account.LinkedUtc" Title="Linked" />
                <RadzenDataGridColumn TItem="AccountRow" Title="Last Auth">
                    <Template Context="row">@(row.Account.LastSuccessfulAuthUtc?.ToString() ?? "-")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AccountRow" Title="Active" Sortable="false" Filterable="false">
                    <Template Context="row">@(row.Account.Id == ForensicsConfig.ActiveProviderAccountId ? "Yes" : "")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="AccountRow" Title="" Sortable="false" Filterable="false">
                    <Template Context="row">
                        <RadzenButton Text="Select" Click="() => SelectAccountAsync(row.Account.Id)" Disabled="@_isBusy" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
                        @if (_confirmingRemoveId == row.Account.Id)
                        {
                            <RadzenText>Are you sure?</RadzenText>
                            <RadzenButton Text="Yes" Click="() => RemoveAccountAsync(row.Account.Id)" Disabled="@_isBusy" ButtonStyle="ButtonStyle.Success" Variant="Variant.Outlined" />
                            <RadzenButton Text="No" Click="() => _confirmingRemoveId = null" Disabled="@_isBusy" ButtonStyle="ButtonStyle.Light" Variant="Variant.Outlined" />
                        }
                        else
                        {
                            <RadzenButton Text="Remove" Click="() => _confirmingRemoveId = row.Account.Id" Disabled="@_isBusy" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" />
                        }
                    </Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}

<RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">Add Account</RadzenText>
<AuthForm IdPrefix="addaccount" SubmitLabel="Add Account" OnAuthenticated="HandleAccountAddedAsync" />

@code {
    private sealed record AccountRow(VideoForensics.Data.Common.Entities.ProviderAccount Account, string DisplayName);

    private List<AccountRow> _rows = new();
    private RadzenDataFilter<AccountRow>? _rowsFilter;
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _statusMessage;
    private Guid? _confirmingRemoveId;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        try
        {
            var accounts = await ProviderAccountRepository.ListAsync(CancellationToken.None);
            var rows = new List<AccountRow>();
            foreach (var account in accounts)
            {
                string displayName = account.ProviderName;
                try
                {
                    var user = await UserRepository.GetAsync(account.UserId, CancellationToken.None);
                    if (user is not null)
                    {
                        displayName = user.DisplayName;
                    }
                }
                catch
                {
                    // Fall back to ProviderName if user lookup fails for any reason.
                }

                rows.Add(new AccountRow(account, displayName));
            }

            _rows = rows;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectAccountAsync(Guid accountId)
    {
        _isBusy = true;
        _statusMessage = null;
        try
        {
            ForensicsConfig.ActiveProviderAccountId = accountId;
            await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);

            var resumed = await AuthService.RestoreFromSavedCredentialsAsync(accountId);
            _statusMessage = resumed
                ? "Switched active account and resumed session."
                : "Switched active account, but the saved session could not be resumed. You may need to sign in again.";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Could not switch account: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task RemoveAccountAsync(Guid accountId)
    {
        _isBusy = true;
        _confirmingRemoveId = null;
        _statusMessage = null;
        try
        {
            await ProviderAccountRepository.DeleteAsync(accountId, CancellationToken.None);

            if (ForensicsConfig.ActiveProviderAccountId == accountId)
            {
                ForensicsConfig.ActiveProviderAccountId = null;
                await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);
            }

            await LoadAccountsAsync();
            _statusMessage = "Account removed.";
        }
        catch (Exception ex)
        {
            _statusMessage = $"Could not remove account: {ex.Message}";
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleAccountAddedAsync(AuthResult result)
    {
        _statusMessage = "Account added.";
        await LoadAccountsAsync();
    }
}
