@page "/signin"
@inject IProviderAuthService AuthService
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Sign In</RadzenText>

@if (_restoringSession)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else
{
    @if (!string.IsNullOrEmpty(_restoreErrorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger">@_restoreErrorMessage</RadzenAlert>
    }

    <AuthForm IdPrefix="signin" SubmitLabel="Sign In" OnAuthenticated="HandleAuthenticated" />
}

@code {
    private bool _restoringSession = true;
    private string? _restoreErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await AuthService.RestoreFromSavedCredentialsAsync())
            {
                NavigationManager.NavigateTo("/");
                return;
            }
        }
        catch (Exception ex)
        {
            // A fresh install legitimately has no saved credentials - RestoreFromSavedCredentialsAsync
            // returning false is expected and not surfaced as an error. Only an actual exception here
            // (e.g. a corrupt credential store) is worth telling the user about.
            _restoreErrorMessage = $"Could not check for a saved session: {ex.Message}";
        }
        finally
        {
            _restoringSession = false;
        }
    }

    private void HandleAuthenticated(AuthResult result)
    {
        NavigationManager.NavigateTo("/");
    }
}
