@page "/signin"
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SignIn> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_restoringSession)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else
{
    @if (!string.IsNullOrEmpty(_restoreErrorMessage))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger">@_restoreErrorMessage</RadzenAlert>
    }

    <AuthForm IdPrefix="signin" SubmitLabel="@L["Title"]" OnAuthenticated="HandleAuthenticated" />
}

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    private bool _restoringSession = true;
    private string? _restoreErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (await AuthService.RestoreFromSavedCredentialsAsync())
            {
                NavigationManager.NavigateTo(GetReturnUrl());
                return;
            }
        }
        catch (Exception ex)
        {
            // A fresh install legitimately has no saved credentials - RestoreFromSavedCredentialsAsync
            // returning false is expected and not surfaced as an error. Only an actual exception here
            // (e.g. a corrupt credential store) is worth telling the user about.
            _restoreErrorMessage = L["CouldNotCheckSavedSession", ex.Message].Value;
        }
        finally
        {
            _restoringSession = false;
        }
    }

    private void HandleAuthenticated(AuthResult result)
    {
        NavigationManager.NavigateTo(GetReturnUrl());
    }

    // Every "You are not signed in" prompt across the app links here with a returnUrl pointing back
    // at itself (e.g. Events.razor -> "/signin?returnUrl=%2Fevents") so signing in doesn't strand the
    // user on the dashboard - only trust a same-app relative path, never an absolute/external URL a
    // crafted link could smuggle in via the query string.
    private string GetReturnUrl()
    {
        if (ReturnUrl is not null && Uri.TryCreate(ReturnUrl, UriKind.Relative, out _))
        {
            return ReturnUrl;
        }

        return "/";
    }
}
