@page "/settings/auth-methods"
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject ISelfApiHttpClientFactory ClientFactory
@inject IStringLocalizer<SecurityAuthMethods> L

<div class="d-flex align-items-center gap-2 mb-4">
    <h4 class="mb-0">@L["Title"]</h4>
</div>

@if (!SessionState.IsSignedIn)
{
    <div class="alert alert-info mb-4">
        <a href="/device-signin">@L["SignInPrompt"]</a> @L["SignInToManage"]
    </div>
}

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_authError is not null)
{
    <div class="alert alert-danger mb-2">@_authError</div>
    <span>@L["AuthErrorDescription"]</span>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else
{
    <!-- Authentication Methods Settings -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">@L["PasswordMethodLabel"]</label>
                <div>
                    <SfCheckBox TChecked="bool" @bind-Checked="_passwordEnabled" Label="@L["EnablePasswordLabel"].Value" />
                </div>
                <small class="d-block mt-2 text-muted">@L["PasswordMethodHelp"]</small>
            </div>

            <div class="mb-3">
                <label class="form-label">@L["PasskeyMethodLabel"]</label>
                <div>
                    <SfCheckBox TChecked="bool" @bind-Checked="_passkeyEnabled" Label="@L["EnablePasskeyLabel"].Value" />
                </div>
                <small class="d-block mt-2 text-muted">@L["PasskeyMethodHelp"]</small>
            </div>

            <div class="mt-4">
                <SfButton Content="@(_isSaving ? L["SavingButton"] : L["SaveButton"])" OnClick="SaveAsync" Disabled="@_isSaving" CssClass="e-primary" />
            </div>

            @if (_saveMessage is not null)
            {
                <span style="color: @(_saveSuccess ? "#4caf50" : "#f44336")" class="mt-3 d-block">@_saveMessage</span>
            }
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _authError;
    private string? _loadError;
    private bool _passwordEnabled;
    private bool _passkeyEnabled;
    private bool _saveSuccess;
    private string? _saveMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;

        try
        {
            if (!SessionState.IsSignedIn)
            {
                _isLoading = false;
                return;
            }

            try
            {
                var client = CreateClient();
                var response = await client.GetAsync("/api/v1/auth-methods/settings");
                if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
                {
                    _authError = L["AuthUnauthorized"];
                    _isLoading = false;
                    return;
                }

                response.EnsureSuccessStatusCode();
                var dto = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>(JsonOptions);
                _passwordEnabled = dto.GetProperty("passwordEnabled").GetBoolean();
                _passkeyEnabled = dto.GetProperty("passkeyEnabled").GetBoolean();
            }
            catch (HttpRequestException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = L["AuthUnauthorized"];
                _isLoading = false;
                return;
            }
            catch (Exception ex)
            {
                _loadError = L["LoadFailed", ex.Message];
            }

            _isLoading = false;
        }
        catch (Exception ex)
        {
            _loadError = L["UnexpectedError", ex.Message];
            _isLoading = false;
        }
    }

    private async Task SaveAsync()
    {
        // Validate that at least one method is enabled
        if (!_passwordEnabled && !_passkeyEnabled)
        {
            _saveSuccess = false;
            _saveMessage = L["ValidationError"];
            return;
        }

        _isSaving = true;
        _saveMessage = null;

        try
        {
            var client = CreateClient();
            var updateRequest = new
            {
                passwordEnabled = _passwordEnabled,
                passkeyEnabled = _passkeyEnabled
            };

            var response = await client.PutAsJsonAsync("/api/v1/auth-methods/settings", updateRequest);

            if (!response.IsSuccessStatusCode)
            {
                var error = await response.Content.ReadAsStringAsync();
                _saveSuccess = false;
                _saveMessage = L["SaveFailed", response.StatusCode];
                return;
            }

            _saveSuccess = true;
            _saveMessage = L["SaveSuccess"];
        }
        catch (Exception ex)
        {
            _saveSuccess = false;
            _saveMessage = L["SaveFailed", ex.Message];
        }
        finally
        {
            _isSaving = false;
        }
    }

    private HttpClient CreateClient() => ClientFactory.CreateClient();

    private static System.Text.Json.JsonSerializerOptions JsonOptions => new() { PropertyNameCaseInsensitive = true };
}
