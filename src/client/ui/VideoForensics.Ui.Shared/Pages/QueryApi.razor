@page "/query"
@inject IProviderAuthService AuthService
@inject IDeviceDiscoveryService DeviceDiscoveryService
@inject IEventAndConfigService EventAndConfigService

<RadzenText TextStyle="TextStyle.H4" Class="mb-4">Query API</RadzenText>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mt-4 mb-2">Account Status</RadzenText>
    <RadzenButton Text="Check Status" Click="RunAccountStatus" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" />
    @if (_accountStatus is not null)
    {
        <RadzenText Class="mt-2">@_accountStatus</RadzenText>
    }
</RadzenCard>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mt-4 mb-2">Locations</RadzenText>
    <RadzenButton Text="Get Locations" Click="RunLocationsAsync" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Disabled="@_locationsLoading" />
    @if (!string.IsNullOrEmpty(_locationsError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-2">@_locationsError</RadzenAlert>
    }
    @if (_locations is not null)
    {
        @if (_locations.Count == 0)
        {
            <RadzenText Class="mt-2">No locations found.</RadzenText>
        }
        else
        {
            <RadzenDataGrid TItem="Location" Data="@_locations" AllowPaging="true" PageSize="20" AllowSorting="true" Class="mt-2">
                <Columns>
                    <RadzenDataGridColumn TItem="Location" Property="@nameof(Location.Id)" Title="Id" />
                    <RadzenDataGridColumn TItem="Location" Property="@nameof(Location.Name)" Title="Name" />
                    <RadzenDataGridColumn TItem="Location" Property="@nameof(Location.Address)" Title="Address" />
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenCard>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mt-4 mb-2">Devices</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <label>Location Id</label>
        <RadzenTextBox @bind-Value="_locationIdInput" Placeholder="Location Id" Style="max-width: 200px;" />
        <RadzenButton Text="Get Devices" Click="RunDevicesAsync" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Disabled="@(_devicesLoading || string.IsNullOrWhiteSpace(_locationIdInput))" />
    </RadzenStack>
    @if (!string.IsNullOrEmpty(_devicesError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-2">@_devicesError</RadzenAlert>
    }
    @if (_devices is not null)
    {
        @if (_devices.Count == 0)
        {
            <RadzenText Class="mt-2">No devices found.</RadzenText>
        }
        else
        {
            <RadzenDataGrid TItem="Device" Data="@_devices" AllowPaging="true" PageSize="20" AllowSorting="true" Class="mt-2">
                <Columns>
                    <RadzenDataGridColumn TItem="Device" Property="@nameof(Device.Id)" Title="Id" />
                    <RadzenDataGridColumn TItem="Device" Property="@nameof(Device.Name)" Title="Name" />
                    <RadzenDataGridColumn TItem="Device" Property="@nameof(Device.Type)" Title="Type" />
                    <RadzenDataGridColumn TItem="Device" Title="Online">
                        <Template Context="row">@(row.IsOnline ? "Yes" : "No")</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenCard>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mt-4 mb-2">Device Events</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <label>Device Id</label>
        <RadzenTextBox @bind-Value="_eventsDeviceIdInput" Placeholder="Device Id" Style="max-width: 200px;" />
        <label>From</label>
        <RadzenDatePicker TValue="DateTime" @bind-Value="_eventsFromDate" />
        <label>To</label>
        <RadzenDatePicker TValue="DateTime" @bind-Value="_eventsToDate" />
        <RadzenButton Text="Get Events" Click="RunEventsAsync" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Disabled="@(_eventsLoading || string.IsNullOrWhiteSpace(_eventsDeviceIdInput))" />
    </RadzenStack>
    @if (!string.IsNullOrEmpty(_eventsError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-2">@_eventsError</RadzenAlert>
    }
    @if (_events is not null)
    {
        @if (_events.Count == 0)
        {
            <RadzenText Class="mt-2">No events found.</RadzenText>
        }
        else
        {
            <RadzenDataGrid TItem="DeviceEvent" Data="@_events" AllowPaging="true" PageSize="20" AllowSorting="true" Class="mt-2">
                <Columns>
                    <RadzenDataGridColumn TItem="DeviceEvent" Property="@nameof(DeviceEvent.Id)" Title="Id" />
                    <RadzenDataGridColumn TItem="DeviceEvent" Property="@nameof(DeviceEvent.EventType)" Title="Event Type" />
                    <RadzenDataGridColumn TItem="DeviceEvent" Property="@nameof(DeviceEvent.Timestamp)" Title="Timestamp" />
                    <RadzenDataGridColumn TItem="DeviceEvent" Property="@nameof(DeviceEvent.SnapshotUrl)" Title="Snapshot URL" />
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenCard>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mt-4 mb-2">Device Config</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <label>Device Id</label>
        <RadzenTextBox @bind-Value="_configDeviceIdInput" Placeholder="Device Id" Style="max-width: 200px;" />
        <RadzenButton Text="Get Config" Click="RunDeviceConfigAsync" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Disabled="@(_configLoading || string.IsNullOrWhiteSpace(_configDeviceIdInput))" />
    </RadzenStack>
    @if (!string.IsNullOrEmpty(_configError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-2">@_configError</RadzenAlert>
    }
    @if (_configLoadedOnce)
    {
        @if (_config is null)
        {
            <RadzenText Class="mt-2">No configuration found for this device.</RadzenText>
        }
        else
        {
            <RadzenDataGrid TItem="VideoForensics.Providers.Common.Contracts.DeviceConfig" Data="@(new List<VideoForensics.Providers.Common.Contracts.DeviceConfig> { _config })" Class="mt-2">
                <Columns>
                    <RadzenDataGridColumn TItem="VideoForensics.Providers.Common.Contracts.DeviceConfig" Property="@nameof(VideoForensics.Providers.Common.Contracts.DeviceConfig.MotionDetectionEnabled)" Title="Motion Detection Enabled" />
                    <RadzenDataGridColumn TItem="VideoForensics.Providers.Common.Contracts.DeviceConfig" Property="@nameof(VideoForensics.Providers.Common.Contracts.DeviceConfig.MotionSensitivity)" Title="Motion Sensitivity" />
                    <RadzenDataGridColumn TItem="VideoForensics.Providers.Common.Contracts.DeviceConfig" Property="@nameof(VideoForensics.Providers.Common.Contracts.DeviceConfig.RecordingMode)" Title="Recording Mode" />
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenCard>

@code {
    // Account Status
    private string? _accountStatus;

    private void RunAccountStatus()
    {
        _accountStatus = AuthService.GetAuthStatus();
    }

    // Locations
    private bool _locationsLoading;
    private string? _locationsError;
    private List<Location>? _locations;

    private async Task RunLocationsAsync()
    {
        _locationsLoading = true;
        _locationsError = null;
        try
        {
            var locations = await DeviceDiscoveryService.GetLocationsAsync(CancellationToken.None);
            _locations = locations.ToList();
        }
        catch (Exception ex)
        {
            _locationsError = $"Failed to get locations: {ex.Message}";
        }
        finally
        {
            _locationsLoading = false;
        }
    }

    // Devices
    private string _locationIdInput = string.Empty;
    private bool _devicesLoading;
    private string? _devicesError;
    private List<Device>? _devices;

    private async Task RunDevicesAsync()
    {
        _devicesLoading = true;
        _devicesError = null;
        try
        {
            var devices = await DeviceDiscoveryService.GetDevicesAsync(_locationIdInput, CancellationToken.None);
            _devices = devices.ToList();
        }
        catch (Exception ex)
        {
            _devicesError = $"Failed to get devices: {ex.Message}";
        }
        finally
        {
            _devicesLoading = false;
        }
    }

    // Device Events
    private string _eventsDeviceIdInput = string.Empty;
    private DateTime _eventsFromDate = DateTime.Today.AddDays(-90);
    private DateTime _eventsToDate = DateTime.Today;
    private bool _eventsLoading;
    private string? _eventsError;
    private List<DeviceEvent>? _events;

    private async Task RunEventsAsync()
    {
        _eventsLoading = true;
        _eventsError = null;
        try
        {
            var events = await EventAndConfigService.GetEventsAsync(_eventsDeviceIdInput, _eventsFromDate, _eventsToDate, null, CancellationToken.None);
            _events = events.ToList();
        }
        catch (Exception ex)
        {
            _eventsError = $"Failed to get events: {ex.Message}";
        }
        finally
        {
            _eventsLoading = false;
        }
    }

    // Device Config
    private string _configDeviceIdInput = string.Empty;
    private bool _configLoading;
    private bool _configLoadedOnce;
    private string? _configError;
    private VideoForensics.Providers.Common.Contracts.DeviceConfig? _config;

    private async Task RunDeviceConfigAsync()
    {
        _configLoading = true;
        _configError = null;
        try
        {
            _config = await EventAndConfigService.GetDeviceConfigAsync(_configDeviceIdInput, CancellationToken.None);
            _configLoadedOnce = true;
        }
        catch (Exception ex)
        {
            _configError = $"Failed to get device config: {ex.Message}";
        }
        finally
        {
            _configLoading = false;
        }
    }
}
