@page "/query"
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using Syncfusion.Blazor.QueryBuilder
@inject IProviderAuthService AuthService
@inject IDeviceDiscoveryService DeviceDiscoveryService
@inject IEventAndConfigService EventAndConfigService
@inject IStringLocalizer<QueryApi> L

<h4 class="mb-4">@L["Title"]</h4>

<PageRightPanelContent>
    <div class="right-panel-section">
        <small>@L["Locations"]</small>
        <SfQueryBuilder @ref="_locationsFilter" TValue="Location">
            <QueryBuilderColumns>
                <QueryBuilderColumn Field="Id" Label="@L["ColId"]" />
                <QueryBuilderColumn Field="Name" Label="@L["ColName"]" />
                <QueryBuilderColumn Field="Address" Label="@L["ColAddress"]" />
            </QueryBuilderColumns>
        </SfQueryBuilder>
        <SfButton Content="@L["ApplyFilter"]" OnClick="@(() => ApplyLocationsFilterAsync())" CssClass="e-primary mt-2" />
    </div>

    <div class="right-panel-section">
        <small>@L["Devices"]</small>
        <div class="d-flex flex-column gap-2 mb-2">
            <div>
                <label>@L["LabelLocationId"]</label>
                <SfTextBox @bind-Value="_locationIdInput" Placeholder="@L["PlaceholderLocationId"]" CssClass="w-100" />
            </div>
            <SfQueryBuilder @ref="_devicesFilter" TValue="Device" Class="mt-2">
                <QueryBuilderColumns>
                    <QueryBuilderColumn Field="Id" Label="@L["ColId"]" />
                    <QueryBuilderColumn Field="Name" Label="@L["ColName"]" />
                    <QueryBuilderColumn Field="Type" Label="@L["ColType"]" />
                    <QueryBuilderColumn Field="IsOnline" Label="@L["ColOnline"]" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" />
                </QueryBuilderColumns>
            </SfQueryBuilder>
            <SfButton Content="@L["ApplyFilter"]" OnClick="@(() => ApplyDevicesFilterAsync())" CssClass="e-primary mt-2" />
        </div>
    </div>

    <div class="right-panel-section">
        <small>@L["DeviceEvents"]</small>
        <div class="d-flex flex-column gap-2 mb-2">
            <div>
                <label>@L["LabelDeviceId"]</label>
                <SfTextBox @bind-Value="_eventsDeviceIdInput" Placeholder="@L["PlaceholderDeviceId"]" CssClass="w-100" />
            </div>
            <div>
                <label>@L["LabelFrom"]</label>
                <input type="date" @bind="_eventsFromDate" class="w-100" />
            </div>
            <div>
                <label>@L["LabelTo"]</label>
                <input type="date" @bind="_eventsToDate" class="w-100" />
            </div>
            <SfQueryBuilder @ref="_eventsFilter" TValue="DeviceEvent" Class="mt-2">
                <QueryBuilderColumns>
                    <QueryBuilderColumn Field="Id" Label="@L["ColId"]" />
                    <QueryBuilderColumn Field="EventType" Label="@L["ColEventType"]" />
                    <QueryBuilderColumn Field="Timestamp" Label="@L["ColTimestamp"]" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Date" />
                    <QueryBuilderColumn Field="SnapshotUrl" Label="@L["ColSnapshotUrl"]" />
                </QueryBuilderColumns>
            </SfQueryBuilder>
            <SfButton Content="@L["ApplyFilter"]" OnClick="@(() => ApplyEventsFilterAsync())" CssClass="e-primary mt-2" />
        </div>
    </div>
</PageRightPanelContent>

<div class="card border rounded pa-4 mb-4">
    <h5 class="mt-4 mb-2">@L["AccountStatus"]</h5>
    <SfButton Content="@L["CheckStatus"]" OnClick="RunAccountStatus" CssClass="e-primary" />
    @if (_accountStatus is not null)
    {
        <p class="mt-2">@_accountStatus</p>
    }
</div>

<div class="card border rounded pa-4 mb-4">
    <h5 class="mt-4 mb-2">@L["Locations"]</h5>
    <SfButton Content="@L["GetLocations"]" OnClick="RunLocationsAsync" CssClass="e-primary" Disabled="@_locationsLoading" />
    @if (!string.IsNullOrEmpty(_locationsError))
    {
        <div class="alert alert-danger mt-2">@_locationsError</div>
    }
    @if (_locations is not null)
    {
        @if (_locations.Count == 0)
        {
            <p class="mt-2">@L["NoLocationsFound"]</p>
        }
        else
        {
            <SfGrid TValue="Location" DataSource="@_filteredLocations" AllowPaging="true" AllowSorting="true" Class="mt-2">
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(Location.Id)" HeaderText="@L["ColId"]" />
                    <GridColumn Field="@nameof(Location.Name)" HeaderText="@L["ColName"]" />
                    <GridColumn Field="@nameof(Location.Address)" HeaderText="@L["ColAddress"]" />
                </GridColumns>
            </SfGrid>
        }
    }
</div>

<div class="card border rounded pa-4 mb-4">
    <h5 class="mt-4 mb-2">@L["Devices"]</h5>
    <SfButton Content="@L["GetDevices"]" OnClick="RunDevicesAsync" CssClass="e-primary" Disabled="@(_devicesLoading || string.IsNullOrWhiteSpace(_locationIdInput))" />
    @if (!string.IsNullOrEmpty(_devicesError))
    {
        <div class="alert alert-danger mt-2">@_devicesError</div>
    }
    @if (_devices is not null)
    {
        @if (_devices.Count == 0)
        {
            <p class="mt-2">@L["NoDevicesFound"]</p>
        }
        else
        {
            <SfGrid TValue="Device" DataSource="@_filteredDevices" AllowPaging="true" AllowSorting="true" Class="mt-2">
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(Device.Id)" HeaderText="@L["ColId"]" />
                    <GridColumn Field="@nameof(Device.Name)" HeaderText="@L["ColName"]" />
                    <GridColumn Field="@nameof(Device.Type)" HeaderText="@L["ColType"]" />
                    <GridColumn HeaderText="@L["ColOnline"]">
                        <Template>
                            @{
                                var device = (Device)context;
                                @(device.IsOnline ? L["Yes"] : L["No"])
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        }
    }
</div>

<div class="card border rounded pa-4 mb-4">
    <h5 class="mt-4 mb-2">@L["DeviceEvents"]</h5>
    <SfButton Content="@L["GetEvents"]" OnClick="RunEventsAsync" CssClass="e-primary" Disabled="@(_eventsLoading || string.IsNullOrWhiteSpace(_eventsDeviceIdInput))" />
    @if (!string.IsNullOrEmpty(_eventsError))
    {
        <div class="alert alert-danger mt-2">@_eventsError</div>
    }
    @if (_events is not null)
    {
        @if (_events.Count == 0)
        {
            <p class="mt-2">@L["NoEventsFound"]</p>
        }
        else
        {
            <SfGrid TValue="DeviceEvent" DataSource="@_filteredEvents" AllowPaging="true" AllowSorting="true" Class="mt-2">
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(DeviceEvent.Id)" HeaderText="@L["ColId"]" />
                    <GridColumn Field="@nameof(DeviceEvent.EventType)" HeaderText="@L["ColEventType"]" />
                    <GridColumn Field="@nameof(DeviceEvent.Timestamp)" HeaderText="@L["ColTimestamp"]" />
                    <GridColumn Field="@nameof(DeviceEvent.SnapshotUrl)" HeaderText="@L["ColSnapshotUrl"]" />
                </GridColumns>
            </SfGrid>
        }
    }
</div>

<div class="card border rounded pa-4 mb-4">
    <h5 class="mt-4 mb-2">@L["DeviceConfig"]</h5>
    <div class="d-flex flex-row gap-2 mb-2">
        <label>@L["LabelDeviceId"]</label>
        <SfTextBox @bind-Value="_configDeviceIdInput" Placeholder="@L["PlaceholderDeviceId"]" CssClass="w-100" Style="max-width: 200px;" />
        <SfButton Content="@L["GetConfig"]" OnClick="RunDeviceConfigAsync" CssClass="e-primary" Disabled="@(_configLoading || string.IsNullOrWhiteSpace(_configDeviceIdInput))" />
    </div>
    @if (!string.IsNullOrEmpty(_configError))
    {
        <div class="alert alert-danger mt-2">@_configError</div>
    }
    @if (_configLoadedOnce)
    {
        @if (_config is null)
        {
            <p class="mt-2">@L["NoConfigFound"]</p>
        }
        else
        {
            <SfGrid TValue="VideoForensics.Providers.Common.Contracts.DeviceConfig" DataSource="@(new List<VideoForensics.Providers.Common.Contracts.DeviceConfig> { _config })" Class="mt-2">
                <GridColumns>
                    <GridColumn Field="@nameof(VideoForensics.Providers.Common.Contracts.DeviceConfig.MotionDetectionEnabled)" HeaderText="@L["ColMotionDetectionEnabled"]" />
                    <GridColumn Field="@nameof(VideoForensics.Providers.Common.Contracts.DeviceConfig.MotionSensitivity)" HeaderText="@L["ColMotionSensitivity"]" />
                    <GridColumn Field="@nameof(VideoForensics.Providers.Common.Contracts.DeviceConfig.RecordingMode)" HeaderText="@L["ColRecordingMode"]" />
                </GridColumns>
            </SfGrid>
        }
    }
</div>

@code {
    // Account Status
    private string? _accountStatus;

    private void RunAccountStatus()
    {
        _accountStatus = AuthService.GetAuthStatus();
    }

    // Locations
    private bool _locationsLoading;
    private string? _locationsError;
    private List<Location>? _locations;
    private SfQueryBuilder<Location>? _locationsFilter;
    private IEnumerable<Location> _filteredLocations = new List<Location>();

    private async Task RunLocationsAsync()
    {
        _locationsLoading = true;
        _locationsError = null;
        try
        {
            var locations = await DeviceDiscoveryService.GetLocationsAsync(CancellationToken.None);
            _locations = locations.ToList();
            _filteredLocations = _locations;
        }
        catch (Exception ex)
        {
            _locationsError = L["FailedToGetLocations", ex.Message];
        }
        finally
        {
            _locationsLoading = false;
        }
    }

    private async Task ApplyLocationsFilterAsync()
    {
        if (_locationsFilter is not null)
        {
            var result = await _locationsFilter.GetFilteredRecordsAsync();
            _filteredLocations = result?.ToList() ?? (_locations ?? new());
        }
    }

    // Devices
    private string _locationIdInput = string.Empty;
    private bool _devicesLoading;
    private string? _devicesError;
    private List<Device>? _devices;
    private SfQueryBuilder<Device>? _devicesFilter;
    private IEnumerable<Device> _filteredDevices = new List<Device>();

    private async Task RunDevicesAsync()
    {
        _devicesLoading = true;
        _devicesError = null;
        try
        {
            var devices = await DeviceDiscoveryService.GetDevicesAsync(_locationIdInput, CancellationToken.None);
            _devices = devices.ToList();
            _filteredDevices = _devices;
        }
        catch (Exception ex)
        {
            _devicesError = L["FailedToGetDevices", ex.Message];
        }
        finally
        {
            _devicesLoading = false;
        }
    }

    private async Task ApplyDevicesFilterAsync()
    {
        if (_devicesFilter is not null)
        {
            var result = await _devicesFilter.GetFilteredRecordsAsync();
            _filteredDevices = result?.ToList() ?? (_devices ?? new());
        }
    }

    // Device Events
    private string _eventsDeviceIdInput = string.Empty;
    private DateTime _eventsFromDate = DateTime.Today.AddDays(-90);
    private DateTime _eventsToDate = DateTime.Today;
    private bool _eventsLoading;
    private string? _eventsError;
    private List<DeviceEvent>? _events;
    private SfQueryBuilder<DeviceEvent>? _eventsFilter;
    private IEnumerable<DeviceEvent> _filteredEvents = new List<DeviceEvent>();

    private async Task RunEventsAsync()
    {
        _eventsLoading = true;
        _eventsError = null;
        try
        {
            var events = await EventAndConfigService.GetEventsAsync(_eventsDeviceIdInput, _eventsFromDate, _eventsToDate, null, CancellationToken.None);
            _events = events.ToList();
            _filteredEvents = _events;
        }
        catch (Exception ex)
        {
            _eventsError = L["FailedToGetEvents", ex.Message];
        }
        finally
        {
            _eventsLoading = false;
        }
    }

    private async Task ApplyEventsFilterAsync()
    {
        if (_eventsFilter is not null)
        {
            var result = await _eventsFilter.GetFilteredRecordsAsync();
            _filteredEvents = result?.ToList() ?? (_events ?? new());
        }
    }

    // Device Config
    private string _configDeviceIdInput = string.Empty;
    private bool _configLoading;
    private bool _configLoadedOnce;
    private string? _configError;
    private VideoForensics.Providers.Common.Contracts.DeviceConfig? _config;

    private async Task RunDeviceConfigAsync()
    {
        _configLoading = true;
        _configError = null;
        try
        {
            _config = await EventAndConfigService.GetDeviceConfigAsync(_configDeviceIdInput, CancellationToken.None);
            _configLoadedOnce = true;
        }
        catch (Exception ex)
        {
            _configError = L["FailedToGetConfig", ex.Message];
        }
        finally
        {
            _configLoading = false;
        }
    }
}
