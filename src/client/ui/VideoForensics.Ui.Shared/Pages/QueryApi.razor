@page "/query"
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject IDeviceDiscoveryService DeviceDiscoveryService
@inject IEventAndConfigService EventAndConfigService
@inject IStringLocalizer<QueryApi> L

<RadzenText TextStyle="TextStyle.H4" Class="mb-4">@L["Title"]</RadzenText>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mt-4 mb-2">@L["AccountStatus"]</RadzenText>
    <RadzenButton Text="@L["CheckStatus"]" Click="RunAccountStatus" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" />
    @if (_accountStatus is not null)
    {
        <RadzenText Class="mt-2">@_accountStatus</RadzenText>
    }
</RadzenCard>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mt-4 mb-2">@L["Locations"]</RadzenText>
    <RadzenButton Text="@L["GetLocations"]" Click="RunLocationsAsync" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Disabled="@_locationsLoading" />
    @if (!string.IsNullOrEmpty(_locationsError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-2">@_locationsError</RadzenAlert>
    }
    @if (_locations is not null)
    {
        @if (_locations.Count == 0)
        {
            <RadzenText Class="mt-2">@L["NoLocationsFound"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_locationsFilter" TItem="Location" Data="@_locations" Auto="true" Class="mt-2 mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="Id" Title="@L["ColId"]" />
                    <RadzenDataFilterProperty Property="Name" Title="@L["ColName"]" />
                    <RadzenDataFilterProperty Property="Address" Title="@L["ColAddress"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="Location" Data="@_locationsFilter?.View" AllowPaging="true" PageSize="20" AllowSorting="true" Class="mt-2">
                <Columns>
                    <RadzenDataGridColumn TItem="Location" Property="@nameof(Location.Id)" Title="@L["ColId"]" />
                    <RadzenDataGridColumn TItem="Location" Property="@nameof(Location.Name)" Title="@L["ColName"]" />
                    <RadzenDataGridColumn TItem="Location" Property="@nameof(Location.Address)" Title="@L["ColAddress"]" />
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenCard>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mt-4 mb-2">@L["Devices"]</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <label>@L["LabelLocationId"]</label>
        <RadzenTextBox @bind-Value="_locationIdInput" Placeholder="@L["PlaceholderLocationId"]" Style="max-width: 200px;" />
        <RadzenButton Text="@L["GetDevices"]" Click="RunDevicesAsync" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Disabled="@(_devicesLoading || string.IsNullOrWhiteSpace(_locationIdInput))" />
    </RadzenStack>
    @if (!string.IsNullOrEmpty(_devicesError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-2">@_devicesError</RadzenAlert>
    }
    @if (_devices is not null)
    {
        @if (_devices.Count == 0)
        {
            <RadzenText Class="mt-2">@L["NoDevicesFound"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_devicesFilter" TItem="Device" Data="@_devices" Auto="true" Class="mt-2 mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="Id" Title="@L["ColId"]" />
                    <RadzenDataFilterProperty Property="Name" Title="@L["ColName"]" />
                    <RadzenDataFilterProperty Property="Type" Title="@L["ColType"]" />
                    <RadzenDataFilterProperty Property="IsOnline" Title="@L["ColOnline"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="Device" Data="@_devicesFilter?.View" AllowPaging="true" PageSize="20" AllowSorting="true" Class="mt-2">
                <Columns>
                    <RadzenDataGridColumn TItem="Device" Property="@nameof(Device.Id)" Title="@L["ColId"]" />
                    <RadzenDataGridColumn TItem="Device" Property="@nameof(Device.Name)" Title="@L["ColName"]" />
                    <RadzenDataGridColumn TItem="Device" Property="@nameof(Device.Type)" Title="@L["ColType"]" />
                    <RadzenDataGridColumn TItem="Device" Title="@L["ColOnline"]">
                        <Template Context="row">@(row.IsOnline ? L["Yes"] : L["No"])</Template>
                    </RadzenDataGridColumn>
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenCard>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mt-4 mb-2">@L["DeviceEvents"]</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <label>@L["LabelDeviceId"]</label>
        <RadzenTextBox @bind-Value="_eventsDeviceIdInput" Placeholder="@L["PlaceholderDeviceId"]" Style="max-width: 200px;" />
        <label>@L["LabelFrom"]</label>
        <RadzenDatePicker TValue="DateTime" @bind-Value="_eventsFromDate" />
        <label>@L["LabelTo"]</label>
        <RadzenDatePicker TValue="DateTime" @bind-Value="_eventsToDate" />
        <RadzenButton Text="@L["GetEvents"]" Click="RunEventsAsync" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Disabled="@(_eventsLoading || string.IsNullOrWhiteSpace(_eventsDeviceIdInput))" />
    </RadzenStack>
    @if (!string.IsNullOrEmpty(_eventsError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-2">@_eventsError</RadzenAlert>
    }
    @if (_events is not null)
    {
        @if (_events.Count == 0)
        {
            <RadzenText Class="mt-2">@L["NoEventsFound"]</RadzenText>
        }
        else
        {
            <RadzenDataFilter @ref="_eventsFilter" TItem="DeviceEvent" Data="@_events" Auto="true" Class="mt-2 mb-2">
                <Properties>
                    <RadzenDataFilterProperty Property="Id" Title="@L["ColId"]" />
                    <RadzenDataFilterProperty Property="EventType" Title="@L["ColEventType"]" />
                    <RadzenDataFilterProperty Property="Timestamp" Title="@L["ColTimestamp"]" />
                    <RadzenDataFilterProperty Property="SnapshotUrl" Title="@L["ColSnapshotUrl"]" />
                </Properties>
            </RadzenDataFilter>
            <RadzenDataGrid TItem="DeviceEvent" Data="@_eventsFilter?.View" AllowPaging="true" PageSize="20" AllowSorting="true" Class="mt-2">
                <Columns>
                    <RadzenDataGridColumn TItem="DeviceEvent" Property="@nameof(DeviceEvent.Id)" Title="@L["ColId"]" />
                    <RadzenDataGridColumn TItem="DeviceEvent" Property="@nameof(DeviceEvent.EventType)" Title="@L["ColEventType"]" />
                    <RadzenDataGridColumn TItem="DeviceEvent" Property="@nameof(DeviceEvent.Timestamp)" Title="@L["ColTimestamp"]" />
                    <RadzenDataGridColumn TItem="DeviceEvent" Property="@nameof(DeviceEvent.SnapshotUrl)" Title="@L["ColSnapshotUrl"]" />
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenCard>

<RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
    <RadzenText TextStyle="TextStyle.H5" Class="mt-4 mb-2">@L["DeviceConfig"]</RadzenText>
    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <label>@L["LabelDeviceId"]</label>
        <RadzenTextBox @bind-Value="_configDeviceIdInput" Placeholder="@L["PlaceholderDeviceId"]" Style="max-width: 200px;" />
        <RadzenButton Text="@L["GetConfig"]" Click="RunDeviceConfigAsync" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" Disabled="@(_configLoading || string.IsNullOrWhiteSpace(_configDeviceIdInput))" />
    </RadzenStack>
    @if (!string.IsNullOrEmpty(_configError))
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-2">@_configError</RadzenAlert>
    }
    @if (_configLoadedOnce)
    {
        @if (_config is null)
        {
            <RadzenText Class="mt-2">@L["NoConfigFound"]</RadzenText>
        }
        else
        {
            <RadzenDataGrid TItem="VideoForensics.Providers.Common.Contracts.DeviceConfig" Data="@(new List<VideoForensics.Providers.Common.Contracts.DeviceConfig> { _config })" Class="mt-2">
                <Columns>
                    <RadzenDataGridColumn TItem="VideoForensics.Providers.Common.Contracts.DeviceConfig" Property="@nameof(VideoForensics.Providers.Common.Contracts.DeviceConfig.MotionDetectionEnabled)" Title="@L["ColMotionDetectionEnabled"]" />
                    <RadzenDataGridColumn TItem="VideoForensics.Providers.Common.Contracts.DeviceConfig" Property="@nameof(VideoForensics.Providers.Common.Contracts.DeviceConfig.MotionSensitivity)" Title="@L["ColMotionSensitivity"]" />
                    <RadzenDataGridColumn TItem="VideoForensics.Providers.Common.Contracts.DeviceConfig" Property="@nameof(VideoForensics.Providers.Common.Contracts.DeviceConfig.RecordingMode)" Title="@L["ColRecordingMode"]" />
                </Columns>
            </RadzenDataGrid>
        }
    }
</RadzenCard>

@code {
    // Account Status
    private string? _accountStatus;

    private void RunAccountStatus()
    {
        _accountStatus = AuthService.GetAuthStatus();
    }

    // Locations
    private bool _locationsLoading;
    private string? _locationsError;
    private List<Location>? _locations;
    private RadzenDataFilter<Location>? _locationsFilter;

    private async Task RunLocationsAsync()
    {
        _locationsLoading = true;
        _locationsError = null;
        try
        {
            var locations = await DeviceDiscoveryService.GetLocationsAsync(CancellationToken.None);
            _locations = locations.ToList();
        }
        catch (Exception ex)
        {
            _locationsError = L["FailedToGetLocations", ex.Message];
        }
        finally
        {
            _locationsLoading = false;
        }
    }

    // Devices
    private string _locationIdInput = string.Empty;
    private bool _devicesLoading;
    private string? _devicesError;
    private List<Device>? _devices;
    private RadzenDataFilter<Device>? _devicesFilter;

    private async Task RunDevicesAsync()
    {
        _devicesLoading = true;
        _devicesError = null;
        try
        {
            var devices = await DeviceDiscoveryService.GetDevicesAsync(_locationIdInput, CancellationToken.None);
            _devices = devices.ToList();
        }
        catch (Exception ex)
        {
            _devicesError = L["FailedToGetDevices", ex.Message];
        }
        finally
        {
            _devicesLoading = false;
        }
    }

    // Device Events
    private string _eventsDeviceIdInput = string.Empty;
    private DateTime _eventsFromDate = DateTime.Today.AddDays(-90);
    private DateTime _eventsToDate = DateTime.Today;
    private bool _eventsLoading;
    private string? _eventsError;
    private List<DeviceEvent>? _events;
    private RadzenDataFilter<DeviceEvent>? _eventsFilter;

    private async Task RunEventsAsync()
    {
        _eventsLoading = true;
        _eventsError = null;
        try
        {
            var events = await EventAndConfigService.GetEventsAsync(_eventsDeviceIdInput, _eventsFromDate, _eventsToDate, null, CancellationToken.None);
            _events = events.ToList();
        }
        catch (Exception ex)
        {
            _eventsError = L["FailedToGetEvents", ex.Message];
        }
        finally
        {
            _eventsLoading = false;
        }
    }

    // Device Config
    private string _configDeviceIdInput = string.Empty;
    private bool _configLoading;
    private bool _configLoadedOnce;
    private string? _configError;
    private VideoForensics.Providers.Common.Contracts.DeviceConfig? _config;

    private async Task RunDeviceConfigAsync()
    {
        _configLoading = true;
        _configError = null;
        try
        {
            _config = await EventAndConfigService.GetDeviceConfigAsync(_configDeviceIdInput, CancellationToken.None);
            _configLoadedOnce = true;
        }
        catch (Exception ex)
        {
            _configError = L["FailedToGetConfig", ex.Message];
        }
        finally
        {
            _configLoading = false;
        }
    }
}
