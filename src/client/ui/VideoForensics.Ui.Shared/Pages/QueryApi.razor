@page "/query"
@inject IProviderAuthService AuthService
@inject IDeviceDiscoveryService DeviceDiscoveryService
@inject IEventAndConfigService EventAndConfigService

<MudText Typo="Typo.h4" Class="mb-4">Query API</MudText>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h5" Class="mt-4 mb-2">Account Status</MudText>
    <MudButton OnClick="RunAccountStatus" Variant="Variant.Filled" Color="Color.Primary">Check Status</MudButton>
    @if (_accountStatus is not null)
    {
        <MudText Class="mt-2">@_accountStatus</MudText>
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h5" Class="mt-4 mb-2">Locations</MudText>
    <MudButton OnClick="RunLocationsAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_locationsLoading">Get Locations</MudButton>
    @if (!string.IsNullOrEmpty(_locationsError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_locationsError</MudAlert>
    }
    @if (_locations is not null)
    {
        @if (_locations.Count == 0)
        {
            <MudText Class="mt-2">No locations found.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true" Class="mt-2">
                <thead>
                    <tr><th>Id</th><th>Name</th><th>Address</th></tr>
                </thead>
                <tbody>
                    @foreach (var location in _locations)
                    {
                        <tr>
                            <td>@location.Id</td>
                            <td>@location.Name</td>
                            <td>@(location.Address ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h5" Class="mt-4 mb-2">Devices</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudTextField @bind-Value="_locationIdInput" Label="Location Id" Variant="Variant.Outlined" Style="max-width: 200px;" />
        <MudButton OnClick="RunDevicesAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_devicesLoading || string.IsNullOrWhiteSpace(_locationIdInput))">Get Devices</MudButton>
    </MudStack>
    @if (!string.IsNullOrEmpty(_devicesError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_devicesError</MudAlert>
    }
    @if (_devices is not null)
    {
        @if (_devices.Count == 0)
        {
            <MudText Class="mt-2">No devices found.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true" Class="mt-2">
                <thead>
                    <tr><th>Id</th><th>Name</th><th>Type</th><th>Online</th></tr>
                </thead>
                <tbody>
                    @foreach (var device in _devices)
                    {
                        <tr>
                            <td>@device.Id</td>
                            <td>@device.Name</td>
                            <td>@device.Type</td>
                            <td>@(device.IsOnline ? "Yes" : "No")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h5" Class="mt-4 mb-2">Device Events</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudTextField @bind-Value="_eventsDeviceIdInput" Label="Device Id" Variant="Variant.Outlined" Style="max-width: 200px;" />
        <input type="date" @bind="_eventsFromDate" />
        <input type="date" @bind="_eventsToDate" />
        <MudButton OnClick="RunEventsAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_eventsLoading || string.IsNullOrWhiteSpace(_eventsDeviceIdInput))">Get Events</MudButton>
    </MudStack>
    @if (!string.IsNullOrEmpty(_eventsError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_eventsError</MudAlert>
    }
    @if (_events is not null)
    {
        @if (_events.Count == 0)
        {
            <MudText Class="mt-2">No events found.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true" Class="mt-2">
                <thead>
                    <tr><th>Id</th><th>Event Type</th><th>Timestamp</th><th>Snapshot URL</th></tr>
                </thead>
                <tbody>
                    @foreach (var evt in _events)
                    {
                        <tr>
                            <td>@evt.Id</td>
                            <td>@evt.EventType</td>
                            <td>@evt.Timestamp</td>
                            <td>@(evt.SnapshotUrl ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
</MudPaper>

<MudPaper Class="pa-4 mb-4" Outlined="true">
    <MudText Typo="Typo.h5" Class="mt-4 mb-2">Device Config</MudText>
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-2">
        <MudTextField @bind-Value="_configDeviceIdInput" Label="Device Id" Variant="Variant.Outlined" Style="max-width: 200px;" />
        <MudButton OnClick="RunDeviceConfigAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@(_configLoading || string.IsNullOrWhiteSpace(_configDeviceIdInput))">Get Config</MudButton>
    </MudStack>
    @if (!string.IsNullOrEmpty(_configError))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_configError</MudAlert>
    }
    @if (_configLoadedOnce)
    {
        @if (_config is null)
        {
            <MudText Class="mt-2">No configuration found for this device.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true" Class="mt-2">
                <thead>
                    <tr><th>Motion Detection Enabled</th><th>Motion Sensitivity</th><th>Recording Mode</th></tr>
                </thead>
                <tbody>
                    <tr>
                        <td>@_config.MotionDetectionEnabled</td>
                        <td>@_config.MotionSensitivity</td>
                        <td>@(_config.RecordingMode ?? "-")</td>
                    </tr>
                </tbody>
            </MudSimpleTable>
        }
    }
</MudPaper>

@code {
    // Account Status
    private string? _accountStatus;

    private void RunAccountStatus()
    {
        _accountStatus = AuthService.GetAuthStatus();
    }

    // Locations
    private bool _locationsLoading;
    private string? _locationsError;
    private List<Location>? _locations;

    private async Task RunLocationsAsync()
    {
        _locationsLoading = true;
        _locationsError = null;
        try
        {
            var locations = await DeviceDiscoveryService.GetLocationsAsync(CancellationToken.None);
            _locations = locations.ToList();
        }
        catch (Exception ex)
        {
            _locationsError = $"Failed to get locations: {ex.Message}";
        }
        finally
        {
            _locationsLoading = false;
        }
    }

    // Devices
    private string _locationIdInput = string.Empty;
    private bool _devicesLoading;
    private string? _devicesError;
    private List<Device>? _devices;

    private async Task RunDevicesAsync()
    {
        _devicesLoading = true;
        _devicesError = null;
        try
        {
            var devices = await DeviceDiscoveryService.GetDevicesAsync(_locationIdInput, CancellationToken.None);
            _devices = devices.ToList();
        }
        catch (Exception ex)
        {
            _devicesError = $"Failed to get devices: {ex.Message}";
        }
        finally
        {
            _devicesLoading = false;
        }
    }

    // Device Events
    private string _eventsDeviceIdInput = string.Empty;
    private DateTime _eventsFromDate = DateTime.Today.AddDays(-90);
    private DateTime _eventsToDate = DateTime.Today;
    private bool _eventsLoading;
    private string? _eventsError;
    private List<DeviceEvent>? _events;

    private async Task RunEventsAsync()
    {
        _eventsLoading = true;
        _eventsError = null;
        try
        {
            var events = await EventAndConfigService.GetEventsAsync(_eventsDeviceIdInput, _eventsFromDate, _eventsToDate, null, CancellationToken.None);
            _events = events.ToList();
        }
        catch (Exception ex)
        {
            _eventsError = $"Failed to get events: {ex.Message}";
        }
        finally
        {
            _eventsLoading = false;
        }
    }

    // Device Config
    private string _configDeviceIdInput = string.Empty;
    private bool _configLoading;
    private bool _configLoadedOnce;
    private string? _configError;
    private VideoForensics.Providers.Common.Contracts.DeviceConfig? _config;

    private async Task RunDeviceConfigAsync()
    {
        _configLoading = true;
        _configError = null;
        try
        {
            _config = await EventAndConfigService.GetDeviceConfigAsync(_configDeviceIdInput, CancellationToken.None);
            _configLoadedOnce = true;
        }
        catch (Exception ex)
        {
            _configError = $"Failed to get device config: {ex.Message}";
        }
        finally
        {
            _configLoading = false;
        }
    }
}
