@page "/device-signin"
@using VideoForensics.Ui.Shared.Services
@inject WebAuthnClient WebAuthn
@inject PairedSessionState SessionState
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4" Class="mb-4">Device Sign-In</MudText>

@if (SessionState.IsSignedIn)
{
    <MudAlert Severity="Severity.Success">Signed in as operator @SessionState.OperatorId (@SessionState.Role).</MudAlert>
    <MudButton OnClick="SignOutAsync" Variant="Variant.Outlined" Color="Color.Secondary">Sign out</MudButton>
}
else
{
    <MudText>Sign in on this already-paired device with your passkey. If this device has not been paired yet, ask a Super Admin to generate a pairing QR code from the Paired Devices screen.</MudText>

    <MudButton OnClick="SignInAsync" Disabled="@_isSigningIn" Variant="Variant.Filled" Color="Color.Primary">
        @(_isSigningIn ? "Waiting for passkey..." : "Sign in with Passkey")
    </MudButton>

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }
}

@code {
    private bool _isSigningIn;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            StateHasChanged();
        }
    }

    private async Task SignInAsync()
    {
        _isSigningIn = true;
        _error = null;
        try
        {
            if (!await WebAuthn.IsAvailableAsync())
            {
                _error = "This browser does not support WebAuthn/passkeys. Use a modern Chrome, Edge, Firefox, or Safari.";
                return;
            }

            var (sessionToken, operatorId, role) = await WebAuthn.SignInAsync();
            await SessionState.SetAsync(sessionToken, operatorId, role);
            NavigationManager.NavigateTo("/settings/devices");
        }
        catch (Exception ex)
        {
            _error = $"Sign-in failed: {ex.Message}";
        }
        finally
        {
            _isSigningIn = false;
        }
    }

    private async Task SignOutAsync()
    {
        await SessionState.ClearAsync();
    }
}
