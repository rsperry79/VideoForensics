@page "/device-signin"
@layout MinimalLayout
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@inject WebAuthnClient WebAuthn
@inject PairedSessionState SessionState
@inject NavigationManager NavigationManager
@inject IStringLocalizer<DeviceSignIn> L

<h4 class="mb-4">@L["Title"]</h4>

@if (SessionState.IsSignedIn)
{
    <div class="alert alert-success">@L["SignedInAlert", SessionState.OperatorId, SessionState.Role]</div>
    <div class="d-flex gap-2">
        <SfButton Content="@L["GoToDashboard"]" OnClick="@(() => NavigationManager.NavigateTo("/"))" CssClass="e-primary" />
        <SfButton Content="@L["SignOut"]" OnClick="SignOutAsync" CssClass="e-flat" />
    </div>
}
else
{
    <p>@L["SignInDescription"]</p>

    <div class="d-flex flex-column gap-3">
        <!-- Password/Username Login -->
        <div class="d-flex flex-column gap-2">
            <div>
                <label>@L["UsernameLabel"]</label>
                <SfTextBox @bind-Value="_username" Placeholder="@L["UsernamePlaceholder"]" />
            </div>
            <div>
                <label>@L["PasswordLabel"]</label>
                <SfTextBox @bind-Value="_password" Placeholder="@L["PasswordPlaceholder"]" Type="Syncfusion.Blazor.Inputs.InputType.Password" />
            </div>
            <div class="d-flex gap-2">
                <SfButton Content="@(_isSigningInWithPassword ? L["SignInWaiting"] : L["SignInButton"])" OnClick="SignInWithPasswordAsync" CssClass="e-primary" Disabled="@(_isSigningInWithPassword || string.IsNullOrWhiteSpace(_username) || string.IsNullOrWhiteSpace(_password))" />

                @if (_webAuthnAvailable && !string.IsNullOrWhiteSpace(_username))
                {
                    <SfButton Content="@L["SignInWithPasskeyButton"]" OnClick="SignInWithPasskeyAsync" CssClass="e-outline" Disabled="@_isSigningInWithPasskey" />
                }
            </div>
        </div>

        @if (_error is not null)
        {
            <div class="alert alert-danger">@_error</div>
        }

        <!-- Register link -->
        <div class="text-center">
            <p>@L["NoAccountText"] <a href="/register">@L["RegisterLink"]</a></p>
        </div>
    </div>
}

@code {
    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _isSigningInWithPassword;
    private bool _isSigningInWithPasskey;
    private bool _webAuthnAvailable;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            _webAuthnAvailable = await WebAuthn.IsAvailableAsync();
            StateHasChanged();
        }
    }

    private async Task SignInWithPasswordAsync()
    {
        _isSigningInWithPassword = true;
        _error = null;
        try
        {
            var (success, errorMessage, sessionToken, operatorId, role, mustChangePassword) =
                await WebAuthn.SignInWithPasswordAsync(_username.Trim(), _password);

            if (!success)
            {
                _error = errorMessage ?? L["SignInFailed"];
                return;
            }

            await SessionState.SetAsync(sessionToken!, operatorId, role, mustChangePassword);

            if (mustChangePassword)
            {
                NavigationManager.NavigateTo("/change-password");
            }
            else
            {
                NavigationManager.NavigateTo("/settings/devices");
            }
        }
        catch (Exception ex)
        {
            _error = L["SignInFailed", ex.Message];
        }
        finally
        {
            _isSigningInWithPassword = false;
        }
    }

    private async Task SignInWithPasskeyAsync()
    {
        _isSigningInWithPasskey = true;
        _error = null;
        try
        {
            var (success, errorMessage, sessionToken, operatorId, role) =
                await WebAuthn.SignInWithUsernameAsync(_username.Trim());

            if (!success)
            {
                _error = errorMessage ?? L["SignInFailed"];
                return;
            }

            await SessionState.SetAsync(sessionToken!, operatorId, role, mustChangePassword: false);
            NavigationManager.NavigateTo("/settings/devices");
        }
        catch (Exception ex)
        {
            _error = L["SignInFailed", ex.Message];
        }
        finally
        {
            _isSigningInWithPasskey = false;
        }
    }

    private async Task SignOutAsync()
    {
        await SessionState.ClearAsync();
    }
}
