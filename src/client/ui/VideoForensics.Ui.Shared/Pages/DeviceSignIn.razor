@page "/device-signin"
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@inject WebAuthnClient WebAuthn
@inject PairedSessionState SessionState
@inject NavigationManager NavigationManager
@inject IStringLocalizer<DeviceSignIn> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (SessionState.IsSignedIn)
{
    <RadzenAlert AlertStyle="AlertStyle.Success">@L["SignedInAlert", SessionState.OperatorId, SessionState.Role]</RadzenAlert>
    <RadzenButton Text="@L["SignOut"]" Click="SignOutAsync" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" />
}
else
{
    <RadzenText>@L["SignInDescription"]</RadzenText>

    <RadzenButton Click="SignInAsync" Disabled="@_isSigningIn" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled">
        @(_isSigningIn ? L["SignInWaiting"] : L["SignInButton"])
    </RadzenButton>

    @if (_error is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger">@_error</RadzenAlert>
    }
}

@code {
    private bool _isSigningIn;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            StateHasChanged();
        }
    }

    private async Task SignInAsync()
    {
        _isSigningIn = true;
        _error = null;
        try
        {
            if (!await WebAuthn.IsAvailableAsync())
            {
                _error = L["WebAuthnNotSupported"];
                return;
            }

            var (sessionToken, operatorId, role) = await WebAuthn.SignInAsync();
            await SessionState.SetAsync(sessionToken, operatorId, role);
            NavigationManager.NavigateTo("/settings/devices");
        }
        catch (Exception ex)
        {
            _error = L["SignInFailed", ex.Message];
        }
        finally
        {
            _isSigningIn = false;
        }
    }

    private async Task SignOutAsync()
    {
        await SessionState.ClearAsync();
    }
}
