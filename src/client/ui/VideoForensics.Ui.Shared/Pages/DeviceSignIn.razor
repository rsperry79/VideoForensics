@page "/device-signin"
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@inject WebAuthnClient WebAuthn
@inject PairedSessionState SessionState
@inject NavigationManager NavigationManager
@inject IStringLocalizer<DeviceSignIn> L

<h4 class="mb-4">@L["Title"]</h4>

@if (SessionState.IsSignedIn)
{
    <div class="alert alert-success">@L["SignedInAlert", SessionState.OperatorId, SessionState.Role]</div>
    <SfButton Content="@L["SignOut"]" OnClick="SignOutAsync" CssClass="e-flat" />
}
else
{
    <p>@L["SignInDescription"]</p>

    <SfButton OnClick="SignInAsync" Disabled="@_isSigningIn" CssClass="e-primary">
        @(_isSigningIn ? L["SignInWaiting"] : L["SignInButton"])
    </SfButton>

    @if (_error is not null)
    {
        <div class="alert alert-danger">@_error</div>
    }
}

@code {
    private bool _isSigningIn;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            StateHasChanged();
        }
    }

    private async Task SignInAsync()
    {
        _isSigningIn = true;
        _error = null;
        try
        {
            if (!await WebAuthn.IsAvailableAsync())
            {
                _error = L["WebAuthnNotSupported"];
                return;
            }

            var (sessionToken, operatorId, role) = await WebAuthn.SignInAsync();
            await SessionState.SetAsync(sessionToken, operatorId, role);
            NavigationManager.NavigateTo("/settings/devices");
        }
        catch (Exception ex)
        {
            _error = L["SignInFailed", ex.Message];
        }
        finally
        {
            _isSigningIn = false;
        }
    }

    private async Task SignOutAsync()
    {
        await SessionState.ClearAsync();
    }
}
