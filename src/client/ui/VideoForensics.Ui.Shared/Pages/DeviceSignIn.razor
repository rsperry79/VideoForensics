@page "/device-signin"
@using VideoForensics.Ui.Shared.Services
@inject WebAuthnClient WebAuthn
@inject PairedSessionState SessionState
@inject NavigationManager NavigationManager

<h1>Device Sign-In</h1>

@if (SessionState.IsSignedIn)
{
    <p style="color:green">Signed in as operator @SessionState.OperatorId (@SessionState.Role).</p>
    <button @onclick="SignOutAsync">Sign out</button>
}
else
{
    <p>Sign in on this already-paired device with your passkey. If this device has not been paired yet, ask a Super Admin to generate a pairing QR code from the Paired Devices screen.</p>

    <button @onclick="SignInAsync" disabled="@_isSigningIn">
        @(_isSigningIn ? "Waiting for passkey..." : "Sign in with Passkey")
    </button>

    @if (_error is not null)
    {
        <p style="color:red">@_error</p>
    }
}

@code {
    private bool _isSigningIn;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            StateHasChanged();
        }
    }

    private async Task SignInAsync()
    {
        _isSigningIn = true;
        _error = null;
        try
        {
            if (!await WebAuthn.IsAvailableAsync())
            {
                _error = "This browser does not support WebAuthn/passkeys. Use a modern Chrome, Edge, Firefox, or Safari.";
                return;
            }

            var (sessionToken, operatorId, role) = await WebAuthn.SignInAsync();
            await SessionState.SetAsync(sessionToken, operatorId, role);
            NavigationManager.NavigateTo("/settings/devices");
        }
        catch (Exception ex)
        {
            _error = $"Sign-in failed: {ex.Message}";
        }
        finally
        {
            _isSigningIn = false;
        }
    }

    private async Task SignOutAsync()
    {
        await SessionState.ClearAsync();
    }
}
