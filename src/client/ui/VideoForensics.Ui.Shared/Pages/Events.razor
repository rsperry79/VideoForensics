@page "/events"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Client.Common
@using VideoForensics.Client.Common.Contracts
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@inject IProviderAuthService AuthService
@inject IMediaContentUrlProvider MediaUrlProvider
@inject IDeviceRepository DeviceRepository
@inject IEventRepository EventRepository
@inject IReportGenerationService ReportGenerationService
@inject ILegalHoldRepository LegalHoldRepository
@inject IEvidenceValidationService EvidenceValidationService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Events> L

<h4 class="mb-4">@L["Title"]</h4>

<SfToast @ref="_toastRef" />

<SfDialog @bind-Visible="_eventDetailsDialogVisible" Header="@L["EventDetailsTitle"]" Width="600px" IsModal="true" Resizable="true" Draggable="true">
    @if (_currentEventRow is not null)
    {
        <EventDetailsDialog
            EventType="@_currentEventRow.EventType"
            OccurredAtUtc="@_currentEventRow.OccurredAtUtc"
            DiscoveredAtUtc="@_currentEventRow.DiscoveredAtUtc"
            DownloadedAtUtc="@_currentEventRow.DownloadedAtUtc"
            ProviderEventId="@_currentEventRow.ProviderEventId"
            SnapshotUrl="@_currentEventRow.Event.SnapshotUrl"
            MediaItemId="@(_currentEventRow.MediaItem?.Id)"
            FileName="@(_currentEventRow.MediaItem?.FileName)"
            MediaFormat="@(_currentEventRow.MediaItem?.MediaFormat)"
            FileSizeBytes="@(_currentEventRow.MediaItem?.FileSizeBytes ?? 0L)"
            Resolution="@(_currentEventRow.MediaItem?.Resolution)"
            IntegrityStatusText="@_currentEventDetailsIntegrityStatus"
            LegalHoldStatusText="@_currentEventDetailsLegalHoldStatus"
            ContentUrl="@_currentContentUrl"
            OnClosed="OnEventDetailsDialogClosed" />
    }
</SfDialog>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <p>@L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToBrowseEvents"]</p>
}
else
{
    <PageRightPanelContent>
        <div class="right-panel-section">
            <h6>@L["Title"]</h6>
            <div class="d-flex flex-column" style="gap: 0.5rem;">
                <SfDropDownList TValue="string" TItem="KeyValuePair<string,string>" @bind-Value="_selectedDeviceIdStr" DataSource="@DeviceOptions"
                    ValueChange="LoadEventsAsync" Placeholder="@L["SelectADevice"]" Style="min-width: 220px;">
                    <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
                </SfDropDownList>
                <label>@L["FromLabel"] <SfDatePicker TValue="DateTime" @bind-Value="_fromDate" ValueChange="LoadEventsAsync" Disabled="@_onlyUnansweredOrFlagged" /></label>
                <label>@L["ToLabel"] <SfDatePicker TValue="DateTime" @bind-Value="_toDate" ValueChange="LoadEventsAsync" Disabled="@_onlyUnansweredOrFlagged" /></label>
                <SfCheckBox TChecked="bool" @bind-Checked="_onlyUnansweredOrFlagged" @bind-Checked:after="LoadEventsAsync" Label="@L["ShowOnlyUnansweredOrFlagged"].Value" />
            </div>
        </div>
    </PageRightPanelContent>

    <div style="display: flex; flex-direction: column; gap: 0.75rem;" class="mb-4">
        <div style="display: flex; flex-direction: row; align-items: center; gap: 1rem; flex-wrap: wrap;">
            <SfButton Content="@L["LoadEvents"]" OnClick="LoadEventsAsync" Disabled="@(_loadingEvents || string.IsNullOrEmpty(_selectedDeviceIdStr))" CssClass="e-primary" />
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div style="color: #d32f2f; padding: 12px; background-color: #ffebee; border-radius: 4px;">@_error</div>
        }

        @if (_pendingHoldRow is not null || _pendingReleaseRow is not null)
        {
            <div style="display: flex; flex-direction: row; align-items: center; gap: 0.5rem;">
                <SfTextBox @bind-Value="_holdReasonInput" Placeholder="@(_pendingHoldRow is not null ? L["ReasonForHold"].Value : L["ReasonForRelease"].Value)" Style="max-width: 260px;" />
                <SfButton Content="@L["Confirm"]" OnClick="ConfirmPendingHoldActionAsync" CssClass="e-primary e-small" />
                <SfButton Content="@L["Cancel"]" OnClick="CancelPendingHoldAction" CssClass="e-flat e-small" />
            </div>
        }
    </div>

    @if (_rows is not null)
    {
        @if (_rows.Count == 0)
        {
            <p>@L["NoEventsFound"]</p>
        }
        else
        {
            <SfGrid @ref="_grid" TValue="EventRow" DataSource="@_filteredRows" AllowPaging="true" AllowSorting="true" AllowFiltering="true" ContextMenuItems="@ContextMenuItems" ContextMenuItemClicked="OnGridContextMenuClicked" AllowResizing="true">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn HeaderText="" Width="60px" AllowSorting="false" AllowFiltering="false">
                        <Template>
                            @{
                                var row = (EventRow)context;
                                @if (row.MediaItem is not null && MediaFormatHelper.IsImage(row.MediaItem.MediaFormat) && _mediaUrls.TryGetValue(row.MediaItem.Id, out var url))
                                {
                                    <img src="@url" alt="" style="width: 48px; height: 36px; object-fit: cover; border-radius: 2px;" />
                                }
                                else if (row.MediaItem is not null && MediaFormatHelper.IsVideo(row.MediaItem.MediaFormat))
                                {
                                    <i class="material-icons">videocam</i>
                                }
                                else if (row.MediaItem is not null && MediaFormatHelper.IsImage(row.MediaItem.MediaFormat))
                                {
                                    <i class="material-icons">image</i>
                                }
                                else
                                {
                                    <i class="material-icons">event</i>
                                }
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="" Width="60px" AllowSorting="false" AllowFiltering="false">
                        <Template>
                            @{
                                var row = (EventRow)context;
                                <SfButton OnClick="@(() => OpenDetailsDialogAsync(row))"
                                    Disabled="@(row.MediaItem is null)" CssClass="e-flat">
                                    <span class="material-icons" style="font-size: 18px;">play_arrow</span>
                                </SfButton>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(EventRow.EventType)" HeaderText="@L["ColEventType"]" Width="140px" />
                    <GridColumn Field="@nameof(EventRow.OccurredAtUtc)" HeaderText="@L["ColOccurredAt"]" Width="170px" />
                    <GridColumn Field="@nameof(EventRow.DiscoveredAtUtc)" HeaderText="@L["ColDiscoveredAt"]" Width="170px" />
                    <GridColumn HeaderText="@L["ColDownloadedAt"]" Width="170px">
                        <Template>
                            @{
                                var row = (EventRow)context;
                                @(row.DownloadedAtUtc?.ToString() ?? L["NotAvailable"])
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColMediaFormat"]" Width="110px">
                        <Template>
                            @{
                                var row = (EventRow)context;
                                @(row.MediaItem?.MediaFormat ?? L["NotAvailable"])
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColIntegrity"]" Width="120px">
                        <Template>
                            @{
                                var row = (EventRow)context;
                                var (statusText, statusColor) = row.MediaItem is null
                                    ? (L["NotAvailable"].Value, "inherit")
                                    : DetermineMediaStatus(row.MediaItem.Id, _integrityRecords);
                                <span style="@($"color:{statusColor}")">@statusText</span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColLegalHold"]" Width="110px">
                        <Template>
                            @{
                                var row = (EventRow)context;
                                @(row.MediaItem is not null && _activeHoldsByMediaItemId.ContainsKey(row.MediaItem.Id) ? L["OnHold"] : L["NotAvailable"])
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(EventRow.ProviderEventId)" HeaderText="@L["ColProviderEventId"]" Width="140px" />
                </GridColumns>
            </SfGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceIdStr = string.Empty;

    private DateTime _fromDate = DateTime.Today.AddDays(-90);
    private DateTime _toDate = DateTime.Today;
    private bool _onlyUnansweredOrFlagged;

    private bool _loadingEvents;
    private string? _error;
    private List<EventRow>? _rows;
    private IEnumerable<EventRow> _filteredRows = new List<EventRow>();
    private IList<EventRow>? _selectedRows;
    private SfGrid<EventRow>? _grid;

    private SfToast? _toastRef;
    private bool _eventDetailsDialogVisible;
    private EventRow? _currentEventRow;
    private string _currentEventDetailsIntegrityStatus = string.Empty;
    private string _currentEventDetailsLegalHoldStatus = string.Empty;
    private string? _currentContentUrl;

    private Dictionary<Guid, string> _mediaUrls = new();

    private List<object>? ContextMenuItems => new List<object>
    {
        new { Text = L["ViewDetails"], Id = "details" },
        new { Text = L["ExportSelected"], Id = "export" },
        new { Text = L["PlaceLegalHold"], Id = "hold" },
        new { Text = L["ReleaseLegalHold"], Id = "release" },
        new { Text = L["VerifyIntegrityDevice"], Id = "verify" },
    };

    private Dictionary<Guid, LegalHold> _activeHoldsByMediaItemId = new();
    private IReadOnlyList<IntegrityRecord> _integrityRecords = new List<IntegrityRecord>();
    private EventRow? _pendingHoldRow;
    private EventRow? _pendingReleaseRow;
    private string _holdReasonInput = string.Empty;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    private sealed class EventRow
    {
        public required Event Event { get; init; }
        public MediaItem? MediaItem { get; set; }

        public string EventType => Event.EventType;
        public DateTime OccurredAtUtc => Event.OccurredAtUtc;
        public DateTime DiscoveredAtUtc => Event.DiscoveredAtUtc;
        public DateTime? DownloadedAtUtc => Event.DownloadedAtUtc;
        public string ProviderEventId => Event.ProviderEventId;
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadEventsAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _loadingEvents = true;
        _error = null;
        _selectedRows = null;
        try
        {
            var events = _onlyUnansweredOrFlagged
                ? await EventRepository.ListUnansweredOrFlaggedAsync(deviceId, CancellationToken.None)
                : await EventRepository.ListByDeviceAndDateRangeAsync(deviceId, _fromDate, _toDate, CancellationToken.None);

            var rows = events.Select(e => new EventRow { Event = e }).ToList();

            // The "unanswered/flagged" filter has no natural date range, so the evidence-review
            // join (which requires one) is skipped there - those rows show media/hold columns as
            // "-" until the operator switches to a date-range load.
            if (!_onlyUnansweredOrFlagged)
            {
                var report = await ReportGenerationService.BuildEvidenceReviewAsync(deviceId, _fromDate, _toDate, CancellationToken.None);
                var mediaByDownloadEventId = report.MediaItems
                    .Where(m => m.DownloadEventId.HasValue)
                    .ToDictionary(m => m.DownloadEventId!.Value);

                foreach (var row in rows)
                {
                    if (mediaByDownloadEventId.TryGetValue(row.Event.Id, out var mediaItem))
                    {
                        row.MediaItem = mediaItem;
                    }
                }

                var mediaItemIds = rows.Where(r => r.MediaItem is not null).Select(r => r.MediaItem!.Id).ToList();
                var activeHolds = await LegalHoldRepository.GetActiveByMediaItemIdsAsync(mediaItemIds, CancellationToken.None);
                _activeHoldsByMediaItemId = activeHolds.ToDictionary(h => h.MediaItemId);
                _integrityRecords = report.IntegrityRecords;
            }
            else
            {
                _activeHoldsByMediaItemId = new Dictionary<Guid, LegalHold>();
                _integrityRecords = new List<IntegrityRecord>();
            }

            _rows = rows;
            _filteredRows = rows;

            // Load media content URLs for thumbnails
            var mediaItemIdsForUrls = rows.Where(r => r.MediaItem is not null).Select(r => r.MediaItem!.Id).ToList();
            if (mediaItemIdsForUrls.Count > 0)
            {
                try
                {
                    _mediaUrls = (await MediaUrlProvider.GetContentUrlsAsync(mediaItemIdsForUrls, CancellationToken.None)).ToDictionary(kvp => kvp.Key, kvp => kvp.Value);
                }
                catch (Exception ex)
                {
                    _error = L["FailedToLoadEvents", ex.Message];
                    _mediaUrls = new Dictionary<Guid, string>();
                }
            }
            else
            {
                _mediaUrls = new Dictionary<Guid, string>();
            }
        }
        catch (Exception ex)
        {
            _error = L["FailedToLoadEvents", ex.Message];
        }
        finally
        {
            _loadingEvents = false;
        }
    }

    private async Task OnGridContextMenuClicked(Syncfusion.Blazor.Grids.ContextMenuClickEventArgs<EventRow> args)
    {
        // Get the row from selected rows (grid should have the row selected when context menu is opened)
        if (_selectedRows is { Count: > 0 } && _selectedRows[0] is EventRow row)
        {
            switch (args.Item?.Id)
            {
                case "details":
                    await OpenDetailsDialogAsync(row);
                    break;
                case "export":
                    await ExportRows(row);
                    break;
                case "hold":
                    BeginPlaceHold(row);
                    break;
                case "release":
                    BeginRelease(row);
                    break;
                case "verify":
                    await VerifyIntegrityForDeviceAsync(row);
                    break;
            }

            StateHasChanged();
        }
    }

    private async Task ExportRows(EventRow contextRow)
    {
        var ids = (_selectedRows is { Count: > 0 } ? _selectedRows : new List<EventRow> { contextRow })
            .Where(r => r.MediaItem is not null)
            .Select(r => r.MediaItem!.Id)
            .Distinct()
            .ToList();

        if (ids.Count == 0)
        {
            if (_toastRef is not null)
            {
                await _toastRef.ShowAsync(new ToastModel { Title = L["NothingToExport"], Content = L["NoSelectedRowsHaveMedia"], Icon = "e-warning" });
            }
            return;
        }

        var idsParam = string.Join(",", ids);
        NavigationManager.NavigateTo($"/review/export?ids={Uri.EscapeDataString(idsParam)}");
    }

    private void BeginPlaceHold(EventRow row)
    {
        _pendingHoldRow = row;
        _pendingReleaseRow = null;
        _holdReasonInput = string.Empty;
    }

    private void BeginRelease(EventRow row)
    {
        _pendingReleaseRow = row;
        _pendingHoldRow = null;
        _holdReasonInput = string.Empty;
    }

    private void CancelPendingHoldAction()
    {
        _pendingHoldRow = null;
        _pendingReleaseRow = null;
        _holdReasonInput = string.Empty;
    }

    private async Task ConfirmPendingHoldActionAsync()
    {
        if (string.IsNullOrWhiteSpace(_holdReasonInput))
        {
            return;
        }

        if (_pendingHoldRow?.MediaItem is not null)
        {
            var hold = await LegalHoldRepository.PlaceAsync(_pendingHoldRow.MediaItem.Id, _holdReasonInput, Environment.UserName, CancellationToken.None);
            _activeHoldsByMediaItemId[_pendingHoldRow.MediaItem.Id] = hold;
            if (_toastRef is not null)
            {
                await _toastRef.ShowAsync(new ToastModel { Title = L["LegalHoldPlaced"], Icon = "e-success" });
            }
        }
        else if (_pendingReleaseRow?.MediaItem is not null && _activeHoldsByMediaItemId.TryGetValue(_pendingReleaseRow.MediaItem.Id, out var activeHold))
        {
            await LegalHoldRepository.ReleaseAsync(activeHold.Id, Environment.UserName, _holdReasonInput, CancellationToken.None);
            _activeHoldsByMediaItemId.Remove(_pendingReleaseRow.MediaItem.Id);
            if (_toastRef is not null)
            {
                await _toastRef.ShowAsync(new ToastModel { Title = L["LegalHoldReleased"], Icon = "e-success" });
            }
        }

        CancelPendingHoldAction();
    }


    private async Task OpenDetailsDialogAsync(EventRow row)
    {
        var (statusText, _) = row.MediaItem is null ? (L["NotAvailable"].Value, "inherit") : DetermineMediaStatus(row.MediaItem.Id, _integrityRecords);
        var holdText = row.MediaItem is not null && _activeHoldsByMediaItemId.ContainsKey(row.MediaItem.Id) ? L["OnHold"].Value : L["NotAvailable"].Value;

        _currentEventRow = row;
        _currentEventDetailsIntegrityStatus = statusText;
        _currentEventDetailsLegalHoldStatus = holdText;

        // Fetch a fresh URL for the dialog (tickets expire after 10 minutes)
        _currentContentUrl = null;
        if (row.MediaItem?.Id is { } mediaItemId)
        {
            try
            {
                var urls = await MediaUrlProvider.GetContentUrlsAsync(new[] { mediaItemId }, CancellationToken.None);
                urls.TryGetValue(mediaItemId, out _currentContentUrl);
            }
            catch
            {
                // If URL fetch fails, dialog will show "Media preview unavailable"
                _currentContentUrl = null;
            }
        }

        _eventDetailsDialogVisible = true;
    }

    private Task OnEventDetailsDialogClosed()
    {
        _eventDetailsDialogVisible = false;
        _currentEventRow = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task VerifyIntegrityForDeviceAsync(EventRow row)
    {
        if (row.MediaItem is null)
        {
            return;
        }

        var results = await EvidenceValidationService.VerifyLocalIntegrityAsync(row.Event.DeviceId, CancellationToken.None);
        var failed = results.Count(r => r.Status != "verified");
        if (_toastRef is not null)
        {
            await _toastRef.ShowAsync(new ToastModel
            {
                Title = L["IntegrityVerificationComplete"],
                Content = L["FilesVerifiedForDevice", results.Count - failed, results.Count],
                Icon = failed == 0 ? "e-success" : "e-warning"
            });
        }
    }

    // Mirrors ForensicReportRenderer.DetermineMediaStatus (src/client/VideoForensics/ForensicReportRenderer.cs)
    private (string Text, string Color) DetermineMediaStatus(Guid mediaId, IReadOnlyList<IntegrityRecord> integrityRecords)
    {
        var record = integrityRecords.FirstOrDefault(r => r.MediaItemId == mediaId);

        if (record == null)
        {
            return (L["NotVerified"], "goldenrod");
        }

        if (!record.Passed)
        {
            return (L["IntegrityFailed"], "red");
        }

        return (L["Verified"], "green");
    }
}
