@page "/settings/operators"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Services
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject WebAuthnClient WebAuthn
@inject IStringLocalizer<SecurityOperators> L

<RadzenText TextStyle="TextStyle.H4" Class="mb-4">@L["Title"]</RadzenText>

@if (!SessionState.IsSignedIn)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Class="mb-4">
        <RadzenLink Path="/device-signin" Text="Sign in with your passkey" /> @L["SignInToManage"]
    </RadzenAlert>
}

<RadzenStack Orientation="Orientation.Horizontal" Class="mb-2">
    <RadzenButton Text="@L["RefreshButton"]" Click="LoadAsync" Disabled="@_isLoading" Variant="Variant.Outlined" />
</RadzenStack>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (_authError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mb-2">@_authError</RadzenAlert>
    <RadzenText>@L["NotAuthorizedMessage"]</RadzenText>
}
else if (_loadError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">@_loadError</RadzenAlert>
}
else if (_operators is null || _operators.Count == 0)
{
    <RadzenText>@L["NoOperatorsFound"]</RadzenText>
}
else
{
    <RadzenDataFilter @ref="_operatorsFilter" TItem="Operator" Data="@_operators" Auto="true" class="mb-2">
        <Properties>
            <RadzenDataFilterProperty Property="DisplayName" Title="@L["ColDisplayName"]" />
            <RadzenDataFilterProperty Property="CreatedAtUtc" Title="@L["ColCreatedAt"]" />
            <RadzenDataFilterProperty Property="Active" Title="@L["ColActive"]" />
        </Properties>
    </RadzenDataFilter>
    <RadzenDataGrid TItem="Operator" Data="@_operatorsFilter?.View" AllowSorting="true" AllowPaging="true" PageSize="20">
        <Columns>
            <RadzenDataGridColumn TItem="Operator" Property="DisplayName" Title="@L["ColDisplayName"]" />
            <RadzenDataGridColumn TItem="Operator" Property="CreatedAtUtc" Title="@L["ColCreatedAt"]" />
            <RadzenDataGridColumn TItem="Operator" Title="@L["ColActive"]" Sortable="false" Filterable="false">
                <Template Context="context">
                    @if (context.Active)
                    {
                        <span style="color: var(--rz-success);">@L["StatusActive"]</span>
                    }
                    else
                    {
                        <span style="color: var(--rz-danger);">@L["StatusInactive"]</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Operator" Title="" Sortable="false" Filterable="false">
                <Template Context="context">
                    @if (context.Active)
                    {
                        <RadzenButton Text="@L["DeactivateButton"]" Click="() => BeginDeactivate(context.Id)" Variant="Variant.Outlined" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" />
                        @if (_pendingDeactivateOperatorId == context.Id)
                        {
                            <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center" Class="mt-2">
                                <RadzenTextBox @bind-Value="_reasonInput" Placeholder="@L["ReasonPlaceholder"]" Style="max-width: 260px;" />
                                <RadzenButton Text="@L["ConfirmButton"]" Click="() => ConfirmDeactivate(context.Id)" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Danger" Size="ButtonSize.Small" />
                                <RadzenButton Text="@L["CancelButton"]" Click="CancelPending" Variant="Variant.Outlined" Size="ButtonSize.Small" />
                            </RadzenStack>
                        }
                    }
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}

@if (_actionError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-4">@_actionError</RadzenAlert>
}

@code {
    private bool _isLoading = true;
    private List<Operator>? _operators;
    private RadzenDataFilter<Operator>? _operatorsFilter;
    private string? _authError;
    private string? _loadError;
    private string? _actionError;
    private Guid? _pendingDeactivateOperatorId;
    private string _reasonInput = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        _actionError = null;
        try
        {
            var client = CreateClient();
            var response = await client.GetAsync("api/devices-management/operators");
            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = L["NotAuthorizedToView"];
                _operators = null;
                return;
            }

            response.EnsureSuccessStatusCode();
            _operators = await response.Content.ReadFromJsonAsync<List<Operator>>(JsonOptions);
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToLoad", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void BeginDeactivate(Guid operatorId)
    {
        _pendingDeactivateOperatorId = operatorId;
        _reasonInput = string.Empty;
        _actionError = null;
    }

    private void CancelPending()
    {
        _pendingDeactivateOperatorId = null;
        _reasonInput = string.Empty;
    }

    private async Task ConfirmDeactivate(Guid operatorId)
    {
        if (string.IsNullOrWhiteSpace(_reasonInput))
        {
            return;
        }

        if (SessionState.SessionToken is null)
        {
            _actionError = L["SignInFirstError"];
            return;
        }

        _actionError = null;
        try
        {
            // Deactivation is high-risk (plan §5.7) - a fresh passkey assertion is required at the
            // moment of the action, not just an already-open session.
            var stepUpToken = await WebAuthn.StepUpAsync(SessionState.SessionToken);

            var client = CreateClient();
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            var response = await client.PostAsJsonAsync($"api/devices-management/operators/{operatorId}/deactivate", new { reason = _reasonInput });
            if (!response.IsSuccessStatusCode)
            {
                var body = await SafeReadErrorAsync(response);
                _actionError = body ?? L["DeactivateFailed1", response.StatusCode];
                return;
            }

            CancelPending();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = L["DeactivateFailed2", ex.Message];
        }
    }

    private static async Task<string?> SafeReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var doc = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>(JsonOptions);
            return doc is not null && doc.TryGetValue("error", out var msg) ? msg : null;
        }
        catch
        {
            return null;
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };
}
