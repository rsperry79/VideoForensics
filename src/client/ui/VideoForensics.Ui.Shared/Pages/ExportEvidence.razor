@page "/review/export"
@inject IProviderAuthService AuthService
@inject IEvidenceExportService EvidenceExportService
@inject NavigationManager NavigationManager

<h1>Export Evidence</h1>

@if (_isLoading)
{
    <p>Loading...</p>
}
else if (!_isAuthenticated)
{
    <p>You are not signed in. <a href="/signin">Sign in</a> to export evidence.</p>
}
else if (_mediaItemIds.Count == 0)
{
    <p>No items selected - go to <a href="/review">Review Evidence</a> and select items to export.</p>
}
else
{
    <p>@_mediaItemIds.Count item(s) selected for export.</p>

    <div>
        <label>
            Case reference:
            <input type="text" @bind="_caseReference" disabled="@_isExporting" />
        </label>
    </div>
    <div>
        <label>
            Recipient description:
            <input type="text" @bind="_recipientDescription" disabled="@_isExporting" />
        </label>
    </div>
    <div>
        <label>
            Passphrase:
            <input type="password" @bind="_passphrase" disabled="@_isExporting" />
        </label>
    </div>
    <div>
        <label>
            Output directory:
            <input type="text" @bind="_outputDirectory" disabled="@_isExporting" style="width: 30em;" />
        </label>
    </div>
    <div>
        <button @onclick="ExportAsync" disabled="@_isExporting">
            @(_isExporting ? "Exporting..." : "Export")
        </button>
    </div>

    @if (_result is not null)
    {
        @if (_result.Success)
        {
            <div>
                <p>Export succeeded.</p>
                <p>Archive path: @_result.ArchivePath</p>
                <p>SHA-256 hash: @_result.ArchiveSha256Hash</p>
                <p>Items included: @_result.ItemsIncluded</p>
                @if (_result.ItemsExcludedForFailedIntegrity.Count > 0)
                {
                    <p>Items excluded for failed integrity: @_result.ItemsExcludedForFailedIntegrity.Count</p>
                }
            </div>
        }
        else
        {
            <p style="color:red">Export failed: @_result.ErrorMessage</p>
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isExporting;
    private List<Guid> _mediaItemIds = new();
    private ExportResult? _result;

    private string? _caseReference;
    private string? _recipientDescription;
    private string? _passphrase;
    private string _outputDirectory = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
        "VideoForensics",
        "Exports");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mediaItemIds = ParseIds(Ids);
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static List<Guid> ParseIds(string? ids)
    {
        if (string.IsNullOrWhiteSpace(ids))
        {
            return new List<Guid>();
        }

        var result = new List<Guid>();
        foreach (var part in ids.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (Guid.TryParse(part, out var id))
            {
                result.Add(id);
            }
        }

        return result;
    }

    private async Task ExportAsync()
    {
        _isExporting = true;
        _result = null;
        try
        {
            _result = await EvidenceExportService.ExportEvidenceAsync(
                _mediaItemIds,
                _outputDirectory,
                string.IsNullOrWhiteSpace(_caseReference) ? null : _caseReference,
                string.IsNullOrWhiteSpace(_recipientDescription) ? null : _recipientDescription,
                string.IsNullOrWhiteSpace(_passphrase) ? null : _passphrase,
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            _result = new ExportResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            _isExporting = false;
        }
    }
}
