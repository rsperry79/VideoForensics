@page "/review/export"
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject IEvidenceExportService EvidenceExportService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ExportEvidence> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenText>@L["NotSignedIn"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="@L["SignIn"]" /> @L["SignInToExport"]</RadzenText>
}
else if (_mediaItemIds.Count == 0)
{
    <RadzenText>@L["NoItemsSelectedPrefix"] <RadzenLink Path="/events" Text="@L["EventsLink"]" /> @L["NoItemsSelectedSuffix"]</RadzenText>
}
else
{
    <RadzenText>@L["ItemsSelectedMessage", _mediaItemIds.Count]</RadzenText>

    <div>
        <RadzenTextBox @bind-Value="_caseReference" Placeholder="@L["CaseReferencePlaceholder"]" Disabled="@_isExporting" />
    </div>
    <div>
        <RadzenTextBox @bind-Value="_recipientDescription" Placeholder="@L["RecipientDescriptionPlaceholder"]" Disabled="@_isExporting" />
    </div>
    <div>
        <input type="password" @bind="_passphrase" placeholder="@L["PassphrasePlaceholder"].Value" disabled="@_isExporting" />
    </div>
    <div>
        <RadzenTextBox @bind-Value="_outputDirectory" Placeholder="@L["OutputDirectoryPlaceholder"]" Disabled="@_isExporting" />
    </div>
    <div>
        <RadzenButton Click="ExportAsync" Disabled="@_isExporting" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled">
            @(_isExporting ? L["ExportingButton"] : L["ExportButton"])
        </RadzenButton>
    </div>

    @if (_result is not null)
    {
        @if (_result.Success)
        {
            <div>
                <RadzenText>@L["ExportSucceeded"]</RadzenText>
                <RadzenText>@L["ArchivePath"] @_result.ArchivePath</RadzenText>
                <RadzenText>@L["ArchiveSha256"] @_result.ArchiveSha256Hash</RadzenText>
                <RadzenText>@L["ItemsIncluded"] @_result.ItemsIncluded</RadzenText>
                @if (_result.ItemsExcludedForFailedIntegrity.Count > 0)
                {
                    <RadzenText>@L["ItemsExcludedForFailedIntegrity"] @_result.ItemsExcludedForFailedIntegrity.Count</RadzenText>
                }
            </div>
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">@L["ExportFailed", _result.ErrorMessage]</RadzenAlert>
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isExporting;
    private List<Guid> _mediaItemIds = new();
    private ExportResult? _result;

    private string? _caseReference;
    private string? _recipientDescription;
    private string? _passphrase;
    private string _outputDirectory = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
        "VideoForensics",
        "Exports");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mediaItemIds = ParseIds(Ids);
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static List<Guid> ParseIds(string? ids)
    {
        if (string.IsNullOrWhiteSpace(ids))
        {
            return new List<Guid>();
        }

        var result = new List<Guid>();
        foreach (var part in ids.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (Guid.TryParse(part, out var id))
            {
                result.Add(id);
            }
        }

        return result;
    }

    private async Task ExportAsync()
    {
        _isExporting = true;
        _result = null;
        try
        {
            _result = await EvidenceExportService.ExportEvidenceAsync(
                _mediaItemIds,
                _outputDirectory,
                string.IsNullOrWhiteSpace(_caseReference) ? null : _caseReference,
                string.IsNullOrWhiteSpace(_recipientDescription) ? null : _recipientDescription,
                string.IsNullOrWhiteSpace(_passphrase) ? null : _passphrase,
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            _result = new ExportResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            _isExporting = false;
        }
    }
}
