@page "/review/export"
@inject IProviderAuthService AuthService
@inject IEvidenceExportService EvidenceExportService
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4" Class="mb-4">Export Evidence</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudText>You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to export evidence.</MudText>
}
else if (_mediaItemIds.Count == 0)
{
    <MudText>No items selected - go to <MudLink Href="/review">Review Evidence</MudLink> and select items to export.</MudText>
}
else
{
    <MudText>@_mediaItemIds.Count item(s) selected for export.</MudText>

    <div>
        <MudTextField @bind-Value="_caseReference" Label="Case reference" Variant="Variant.Outlined" Disabled="@_isExporting" />
    </div>
    <div>
        <MudTextField @bind-Value="_recipientDescription" Label="Recipient description" Variant="Variant.Outlined" Disabled="@_isExporting" />
    </div>
    <div>
        <MudTextField @bind-Value="_passphrase" InputType="InputType.Password" Label="Passphrase" Variant="Variant.Outlined" Disabled="@_isExporting" />
    </div>
    <div>
        <MudTextField @bind-Value="_outputDirectory" Label="Output directory" Variant="Variant.Outlined" Disabled="@_isExporting" />
    </div>
    <div>
        <MudButton OnClick="ExportAsync" Disabled="@_isExporting" Variant="Variant.Filled" Color="Color.Primary">
            @(_isExporting ? "Exporting..." : "Export")
        </MudButton>
    </div>

    @if (_result is not null)
    {
        @if (_result.Success)
        {
            <div>
                <MudText>Export succeeded.</MudText>
                <MudText>Archive path: @_result.ArchivePath</MudText>
                <MudText>SHA-256 hash: @_result.ArchiveSha256Hash</MudText>
                <MudText>Items included: @_result.ItemsIncluded</MudText>
                @if (_result.ItemsExcludedForFailedIntegrity.Count > 0)
                {
                    <MudText>Items excluded for failed integrity: @_result.ItemsExcludedForFailedIntegrity.Count</MudText>
                }
            </div>
        }
        else
        {
            <MudAlert Severity="Severity.Error">Export failed: @_result.ErrorMessage</MudAlert>
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isExporting;
    private List<Guid> _mediaItemIds = new();
    private ExportResult? _result;

    private string? _caseReference;
    private string? _recipientDescription;
    private string? _passphrase;
    private string _outputDirectory = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
        "VideoForensics",
        "Exports");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mediaItemIds = ParseIds(Ids);
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static List<Guid> ParseIds(string? ids)
    {
        if (string.IsNullOrWhiteSpace(ids))
        {
            return new List<Guid>();
        }

        var result = new List<Guid>();
        foreach (var part in ids.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (Guid.TryParse(part, out var id))
            {
                result.Add(id);
            }
        }

        return result;
    }

    private async Task ExportAsync()
    {
        _isExporting = true;
        _result = null;
        try
        {
            _result = await EvidenceExportService.ExportEvidenceAsync(
                _mediaItemIds,
                _outputDirectory,
                string.IsNullOrWhiteSpace(_caseReference) ? null : _caseReference,
                string.IsNullOrWhiteSpace(_recipientDescription) ? null : _recipientDescription,
                string.IsNullOrWhiteSpace(_passphrase) ? null : _passphrase,
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            _result = new ExportResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            _isExporting = false;
        }
    }
}
