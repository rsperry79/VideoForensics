@page "/review/export"
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject IEvidenceExportService EvidenceExportService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ExportEvidence> L

<Breadcrumb Items="@_breadcrumbItems" />

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <span>@L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToExport"]</span>
}
else if (_mediaItemIds.Count == 0)
{
    <span>@L["NoItemsSelectedPrefix"] <a href="/events">@L["EventsLink"]</a> @L["NoItemsSelectedSuffix"]</span>
}
else
{
    <span>@L["ItemsSelectedMessage", _mediaItemIds.Count]</span>

    <div>
        <SfTextBox @bind-Value="_caseReference" Placeholder="@L["CaseReferencePlaceholder"]" Enabled="@(!_isExporting)" />
    </div>
    <div>
        <SfTextBox @bind-Value="_recipientDescription" Placeholder="@L["RecipientDescriptionPlaceholder"]" Enabled="@(!_isExporting)" />
    </div>
    <div>
        <SfTextBox @bind-Value="_passphrase" Type="Syncfusion.Blazor.Inputs.InputType.Password" Placeholder="@L["PassphrasePlaceholder"].Value" Enabled="@(!_isExporting)" />
    </div>
    <div>
        <SfTextBox @bind-Value="_outputDirectory" Placeholder="@L["OutputDirectoryPlaceholder"]" Enabled="@(!_isExporting)" />
    </div>
    <div>
        <SfButton OnClick="ExportAsync" Disabled="@_isExporting" CssClass="e-primary">
            @(_isExporting ? L["ExportingButton"] : L["ExportButton"])
        </SfButton>
    </div>

    @if (_result is not null)
    {
        @if (_result.Success)
        {
            <div>
                <span>@L["ExportSucceeded"]</span>
                <span>@L["ArchivePath"] @_result.ArchivePath</span>
                <span>@L["ArchiveSha256"] @_result.ArchiveSha256Hash</span>
                <span>@L["ItemsIncluded"] @_result.ItemsIncluded</span>
                @if (_result.ItemsExcludedForFailedIntegrity.Count > 0)
                {
                    <span>@L["ItemsExcludedForFailedIntegrity"] @_result.ItemsExcludedForFailedIntegrity.Count</span>
                }
            </div>
        }
        else
        {
            <div class="alert alert-danger">@L["ExportFailed", _result.ErrorMessage]</div>
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    private List<(string Label, string? Url)> _breadcrumbItems = new() { ("Events", "/events"), ("Export Evidence", null) };
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isExporting;
    private List<Guid> _mediaItemIds = new();
    private ExportResult? _result;

    private string? _caseReference;
    private string? _recipientDescription;
    private string? _passphrase;
    private string _outputDirectory = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
        "VideoForensics",
        "Exports");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mediaItemIds = ParseIds(Ids);
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static List<Guid> ParseIds(string? ids)
    {
        if (string.IsNullOrWhiteSpace(ids))
        {
            return new List<Guid>();
        }

        var result = new List<Guid>();
        foreach (var part in ids.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (Guid.TryParse(part, out var id))
            {
                result.Add(id);
            }
        }

        return result;
    }

    private async Task ExportAsync()
    {
        _isExporting = true;
        _result = null;
        try
        {
            _result = await EvidenceExportService.ExportEvidenceAsync(
                _mediaItemIds,
                _outputDirectory,
                string.IsNullOrWhiteSpace(_caseReference) ? null : _caseReference,
                string.IsNullOrWhiteSpace(_recipientDescription) ? null : _recipientDescription,
                string.IsNullOrWhiteSpace(_passphrase) ? null : _passphrase,
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            _result = new ExportResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            _isExporting = false;
        }
    }
}
