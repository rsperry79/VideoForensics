@page "/review/export"
@inject IProviderAuthService AuthService
@inject IEvidenceExportService EvidenceExportService
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" class="mb-4">Export Evidence</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenText>You are not signed in. <RadzenLink Path="/signin" Text="Sign in" /> to export evidence.</RadzenText>
}
else if (_mediaItemIds.Count == 0)
{
    <RadzenText>No items selected - go to <RadzenLink Path="/events" Text="Events" /> and select items to export.</RadzenText>
}
else
{
    <RadzenText>@_mediaItemIds.Count item(s) selected for export.</RadzenText>

    <div>
        <RadzenTextBox @bind-Value="_caseReference" Placeholder="Case reference" Disabled="@_isExporting" />
    </div>
    <div>
        <RadzenTextBox @bind-Value="_recipientDescription" Placeholder="Recipient description" Disabled="@_isExporting" />
    </div>
    <div>
        <input type="password" @bind="_passphrase" disabled="@_isExporting" />
    </div>
    <div>
        <RadzenTextBox @bind-Value="_outputDirectory" Placeholder="Output directory" Disabled="@_isExporting" />
    </div>
    <div>
        <RadzenButton Click="ExportAsync" Disabled="@_isExporting" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled">
            @(_isExporting ? "Exporting..." : "Export")
        </RadzenButton>
    </div>

    @if (_result is not null)
    {
        @if (_result.Success)
        {
            <div>
                <RadzenText>Export succeeded.</RadzenText>
                <RadzenText>Archive path: @_result.ArchivePath</RadzenText>
                <RadzenText>SHA-256 hash: @_result.ArchiveSha256Hash</RadzenText>
                <RadzenText>Items included: @_result.ItemsIncluded</RadzenText>
                @if (_result.ItemsExcludedForFailedIntegrity.Count > 0)
                {
                    <RadzenText>Items excluded for failed integrity: @_result.ItemsExcludedForFailedIntegrity.Count</RadzenText>
                }
            </div>
        }
        else
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger">Export failed: @_result.ErrorMessage</RadzenAlert>
        }
    }
}

@code {
    [SupplyParameterFromQuery(Name = "ids")]
    public string? Ids { get; set; }

    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isExporting;
    private List<Guid> _mediaItemIds = new();
    private ExportResult? _result;

    private string? _caseReference;
    private string? _recipientDescription;
    private string? _passphrase;
    private string _outputDirectory = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
        "VideoForensics",
        "Exports");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _mediaItemIds = ParseIds(Ids);
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static List<Guid> ParseIds(string? ids)
    {
        if (string.IsNullOrWhiteSpace(ids))
        {
            return new List<Guid>();
        }

        var result = new List<Guid>();
        foreach (var part in ids.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (Guid.TryParse(part, out var id))
            {
                result.Add(id);
            }
        }

        return result;
    }

    private async Task ExportAsync()
    {
        _isExporting = true;
        _result = null;
        try
        {
            _result = await EvidenceExportService.ExportEvidenceAsync(
                _mediaItemIds,
                _outputDirectory,
                string.IsNullOrWhiteSpace(_caseReference) ? null : _caseReference,
                string.IsNullOrWhiteSpace(_recipientDescription) ? null : _recipientDescription,
                string.IsNullOrWhiteSpace(_passphrase) ? null : _passphrase,
                CancellationToken.None);
        }
        catch (Exception ex)
        {
            _result = new ExportResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            _isExporting = false;
        }
    }
}
