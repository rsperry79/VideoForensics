@page "/settings/remote-access"
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject WebAuthnClient WebAuthn
@inject IStringLocalizer<RemoteAccess> L

<RadzenText TextStyle="TextStyle.H4" Class="mb-4">@L["Title"]</RadzenText>

@if (!SessionState.IsSignedIn)
{
    <RadzenAlert AlertStyle="AlertStyle.Info" Class="mb-4">
        <RadzenLink Path="/device-signin" Text="@L["SignInPrompt"]" /> @L["SignInToManage"]
    </RadzenAlert>
}

<RadzenAlert AlertStyle="AlertStyle.Warning" Class="mb-4">
    @L["WarningText"]
</RadzenAlert>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (_authError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mb-2">@_authError</RadzenAlert>
    <RadzenText>
        @L["AuthErrorHeader"] <RadzenLink Path="/device-signin" Text="@L["SignInPrompt"]" /> @L["AuthErrorDescription"]
    </RadzenText>
}
else if (_loadError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger">@_loadError</RadzenAlert>
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" Class="mb-2">
        <RadzenButton Text="@L["RefreshButton"]" Click="LoadStatusAsync" Disabled="@_isLoading" Variant="Variant.Outlined" />
    </RadzenStack>

    @if (!_installed)
    {
        <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mb-4">
            <code>cloudflared</code> @L["CloudflaredNotFoundPrefix"]
            <RadzenLink Path="https://developers.cloudflare.com/cloudflare-one/connections/connect-networks/downloads/" Text="@L["CloudflaredDownloadLink"]" />
            @L["CloudflaredNotFoundSuffix"]
        </RadzenAlert>
    }
    else
    {
        <RadzenText TextStyle="TextStyle.H6" Class="mt-4 mb-2">@L["CurrentStatus"]</RadzenText>
        <RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
            <RadzenStack>
                <RadzenText>
                    @L["StatusLabel"] <RadzenBadge BadgeStyle="@StatusBadgeStyle" Text="@_status" />
                    @if (_kind != "None")
                    {
                        <span>(@_kind)</span>
                    }
                </RadzenText>
                @if (_publicUrl is not null)
                {
                    <RadzenText>@L["PublicUrlLabel"] <RadzenLink Path="@_publicUrl" Text="@_publicUrl" /></RadzenText>
                }
                @if (_tunnelErrorMessage is not null)
                {
                    <RadzenText>@_tunnelErrorMessage</RadzenText>
                }
                @if (_status is "Running" or "Starting")
                {
                    <RadzenButton Text="@L["StopTunnelButton"]" Click="StopAsync" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Danger" Style="width: fit-content;" />
                }
                @if (_recentLogLines.Count > 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2" Class="mt-2">@L["RecentLogLabel"]</RadzenText>
                    <pre style="max-height: 200px; overflow-y: auto; background: var(--rz-base-100); padding: 8px; font-size: 0.75rem;">@string.Join("\n", _recentLogLines)</pre>
                }
            </RadzenStack>
        </RadzenCard>

        @if (_status is "Stopped" or "Failed")
        {
            <RadzenText TextStyle="TextStyle.H6" Class="mt-4 mb-2">@L["QuickTunnelHeading"]</RadzenText>
            <RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
                <RadzenText Class="mb-2">
                    @L["QuickTunnelDescription"]
                </RadzenText>
                <RadzenButton Text="@(_isActing ? L["StartingQuickTunnelButton"] : L["StartQuickTunnelButton"])" Click="StartQuickTunnelAsync" Disabled="@_isActing" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" />
            </RadzenCard>

            <RadzenText TextStyle="TextStyle.H6" Class="mt-4 mb-2">@L["NamedTunnelHeading"]</RadzenText>
            <RadzenCard Variant="Variant.Outlined" Class="pa-4 mb-4">
                <RadzenText Class="mb-2">
                    @L["NamedTunnelDescription"]
                </RadzenText>
                @if (_namedTunnels.Count == 0)
                {
                    <RadzenText TextStyle="TextStyle.Body2">@L["NoNamedTunnels"]</RadzenText>
                }
                else
                {
                    <RadzenStack Orientation="Orientation.Horizontal" AlignItems="AlignItems.Center">
                        <label>@L["TunnelLabel"]</label>
                        <RadzenDropDown TValue="string" @bind-Value="_selectedNamedTunnel" Data="@_namedTunnels" Placeholder="@L["SelectTunnelPlaceholder"]" Style="max-width: 260px;" />
                        <RadzenButton Text="@(_isActing ? L["StartingNamedTunnelButton"] : L["StartNamedTunnelButton"])" Click="StartNamedTunnelAsync" Disabled="@(_isActing || _selectedNamedTunnel is null)" Variant="Variant.Filled" ButtonStyle="ButtonStyle.Primary" />
                    </RadzenStack>
                }
            </RadzenCard>
        }
    }
}

@if (_actionError is not null)
{
    <RadzenAlert AlertStyle="AlertStyle.Danger" Class="mt-4">@_actionError</RadzenAlert>
}

@code {
    private bool _isLoading = true;
    private bool _isActing;
    private string? _authError;
    private string? _loadError;
    private string? _actionError;

    private bool _installed;
    private string _kind = "None";
    private string _status = "Stopped";
    private string? _publicUrl;
    private string? _tunnelErrorMessage;
    private List<string> _recentLogLines = new();
    private List<string> _namedTunnels = new();
    private string? _selectedNamedTunnel;

    private BadgeStyle StatusBadgeStyle => _status switch
    {
        "Running" => BadgeStyle.Success,
        "Starting" => BadgeStyle.Info,
        "Failed" => BadgeStyle.Danger,
        _ => BadgeStyle.Light
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadStatusAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadStatusAsync();
            StateHasChanged();
        }
    }

    private async Task LoadStatusAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        try
        {
            var client = CreateClient();
            var response = await client.GetAsync("api/remote-access/status");
            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = L["AuthUnauthorized"];
                return;
            }

            response.EnsureSuccessStatusCode();
            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            _installed = body.GetProperty("installed").GetBoolean();
            _kind = body.GetProperty("kind").GetString() ?? "None";
            _status = body.GetProperty("status").GetString() ?? "Stopped";
            _publicUrl = body.GetProperty("publicUrl").ValueKind == System.Text.Json.JsonValueKind.Null ? null : body.GetProperty("publicUrl").GetString();
            _tunnelErrorMessage = body.GetProperty("errorMessage").ValueKind == System.Text.Json.JsonValueKind.Null ? null : body.GetProperty("errorMessage").GetString();
            _recentLogLines = body.GetProperty("recentLogLines").EnumerateArray().Select(e => e.GetString() ?? "").ToList();

            if (_installed && _status is "Stopped" or "Failed")
            {
                var namedResponse = await client.GetAsync("api/remote-access/named-tunnels");
                if (namedResponse.IsSuccessStatusCode)
                {
                    _namedTunnels = (await namedResponse.Content.ReadFromJsonAsync<List<string>>()) ?? new();
                    _selectedNamedTunnel = _namedTunnels.FirstOrDefault();
                }
            }
        }
        catch (Exception ex)
        {
            _loadError = L["LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task StartQuickTunnelAsync()
    {
        await RunStepUpGatedActionAsync("api/remote-access/quick-tunnel/start", null);
    }

    private async Task StartNamedTunnelAsync()
    {
        if (_selectedNamedTunnel is null)
        {
            return;
        }

        await RunStepUpGatedActionAsync("api/remote-access/named-tunnel/start", new { name = _selectedNamedTunnel });
    }

    private async Task RunStepUpGatedActionAsync(string url, object? body)
    {
        if (SessionState.SessionToken is null)
        {
            _actionError = L["SignInRequired"];
            return;
        }

        _isActing = true;
        _actionError = null;
        try
        {
            // Starting a tunnel exposes this server to the internet - a fresh passkey assertion is
            // required at the moment of the action, not just an already-open session (plan §5.7).
            var stepUpToken = await WebAuthn.StepUpAsync(SessionState.SessionToken);

            var client = CreateClient();
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            var response = body is null
                ? await client.PostAsync(url, null)
                : await client.PostAsJsonAsync(url, body);

            if (!response.IsSuccessStatusCode)
            {
                var errorBody = await SafeReadErrorAsync(response);
                _actionError = errorBody ?? L["ActionFailed", response.StatusCode.ToString()];
                return;
            }

            await LoadStatusAsync();
        }
        catch (Exception ex)
        {
            _actionError = L["ActionFailed", ex.Message];
        }
        finally
        {
            _isActing = false;
        }
    }

    private async Task StopAsync()
    {
        _actionError = null;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsync("api/remote-access/stop", null);
            if (!response.IsSuccessStatusCode)
            {
                _actionError = await SafeReadErrorAsync(response) ?? L["StopFailed", response.StatusCode.ToString()];
                return;
            }

            await LoadStatusAsync();
        }
        catch (Exception ex)
        {
            _actionError = L["StopFailed", ex.Message];
        }
    }

    private static async Task<string?> SafeReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var doc = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            return doc is not null && doc.TryGetValue("error", out var msg) ? msg : null;
        }
        catch
        {
            return null;
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }
}
