@page "/events"
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject IEventRepository EventRepository

<MudText Typo="Typo.h4" Class="mb-4">Browse Events</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudAlert Severity="Severity.Warning">You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to browse events.</MudAlert>
}
else
{
    <MudStack Row="false" Spacing="2" Class="mb-4">
        <MudSelect T="string" @bind-Value="_selectedDeviceIdStr" Label="Device" Variant="Variant.Outlined">
            <MudSelectItem Value="@("")">-- Select a device --</MudSelectItem>
            @foreach (var device in _devices)
            {
                <MudSelectItem Value="@(device.Id.ToString())">@device.Name</MudSelectItem>
            }
        </MudSelect>
        <label>From: <input type="date" @bind="_fromDate" disabled="@_onlyUnansweredOrFlagged" /></label>
        <label>To: <input type="date" @bind="_toDate" disabled="@_onlyUnansweredOrFlagged" /></label>
        <MudCheckBox @bind-Value="_onlyUnansweredOrFlagged" Label="Show only unanswered/flagged" />
        <MudButton OnClick="LoadEventsAsync" Disabled="@(_loadingEvents || string.IsNullOrEmpty(_selectedDeviceIdStr))" Variant="Variant.Filled" Color="Color.Primary">Load Events</MudButton>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error">@_error</MudAlert>
        }
    </MudStack>

    @if (_events is not null)
    {
        @if (_events.Count == 0)
        {
            <MudText>No events found.</MudText>
        }
        else
        {
            <MudSimpleTable Hover="true" Dense="true">
                <thead>
                    <tr>
                        <th>Event Type</th>
                        <th>Occurred At (UTC)</th>
                        <th>Discovered At (UTC)</th>
                        <th>Downloaded At (UTC)</th>
                        <th>Snapshot URL</th>
                        <th>Provider Event ID</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evt in _events)
                    {
                        <tr>
                            <td>@evt.EventType</td>
                            <td>@evt.OccurredAtUtc</td>
                            <td>@evt.DiscoveredAtUtc</td>
                            <td>@(evt.DownloadedAtUtc?.ToString() ?? "-")</td>
                            <td>@evt.SnapshotUrl</td>
                            <td>@evt.ProviderEventId</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceIdStr = string.Empty;

    private DateTime _fromDate = DateTime.Today.AddDays(-90);
    private DateTime _toDate = DateTime.Today;
    private bool _onlyUnansweredOrFlagged;

    private bool _loadingEvents;
    private string? _error;
    private List<Event>? _events;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadEventsAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _loadingEvents = true;
        _error = null;
        try
        {
            var events = _onlyUnansweredOrFlagged
                ? await EventRepository.ListUnansweredOrFlaggedAsync(deviceId, CancellationToken.None)
                : await EventRepository.ListByDeviceAndDateRangeAsync(deviceId, _fromDate, _toDate, CancellationToken.None);

            _events = events.ToList();
        }
        catch (Exception ex)
        {
            _error = $"Failed to load events: {ex.Message}";
        }
        finally
        {
            _loadingEvents = false;
        }
    }
}
