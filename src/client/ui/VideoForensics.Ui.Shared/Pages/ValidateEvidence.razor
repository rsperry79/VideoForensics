@page "/analyze/validate/integrity"
@page "/analyze/validate/reconcile"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IEvidenceValidationService EvidenceValidationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ValidateEvidence> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        @L["NotSignedInMessage"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="Sign in" />
    </RadzenAlert>
}
else
{
    <RadzenStack Orientation="Orientation.Horizontal" class="mb-4">
        <RadzenButton Text="@L["VerifyIntegrityTab"]" Click='() => _activeTab = "integrity"' Variant='@(_activeTab == "integrity" ? Variant.Filled : Variant.Outlined)' ButtonStyle='@(_activeTab == "integrity" ? ButtonStyle.Primary : ButtonStyle.Light)' />
        <RadzenButton Text="@L["ReconcileTab"]" Click='() => _activeTab = "reconcile"' Variant='@(_activeTab == "reconcile" ? Variant.Filled : Variant.Outlined)' ButtonStyle='@(_activeTab == "reconcile" ? ButtonStyle.Primary : ButtonStyle.Light)' />
    </RadzenStack>

    @if (_activeTab == "integrity")
    {
        <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
            <RadzenStack>
                <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceId" Data="@DeviceOptions"
                    TextProperty="Value" ValueProperty="Key" Placeholder="@L["AllDevicesFilter"]" />
                <RadzenButton Text="@L["VerifyButton"]" Click="VerifyIntegrityAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            </RadzenStack>
        </RadzenCard>

        @if (_verificationResults is not null)
        {
            @if (_verificationResults.Count == 0)
            {
                <RadzenText>@L["NoMediaFound"]</RadzenText>
            }
            else
            {
                <RadzenDataFilter @ref="_verificationResultsFilter" TItem="MediaVerificationResult" Data="@_verificationResults" Auto="true" class="mb-2">
                    <Properties>
                        <RadzenDataFilterProperty Property="FileName" Title="@L["ColFileName"]" />
                        <RadzenDataFilterProperty Property="Status" Title="@L["ColStatus"]" />
                        <RadzenDataFilterProperty Property="FailureReason" Title="@L["ColFailureReason"]" />
                    </Properties>
                </RadzenDataFilter>
                <RadzenDataGrid TItem="MediaVerificationResult" Data="@_verificationResultsFilter?.View" AllowPaging="true" PageSize="20" AllowSorting="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="MediaVerificationResult" Property="@nameof(MediaVerificationResult.FileName)" Title="@L["ColFileName"]" />
                        <RadzenDataGridColumn TItem="MediaVerificationResult" Title="@L["ColStatus"]"><Template Context="result"><span style="color:@StatusColor(result.Status)">@result.Status</span></Template></RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="MediaVerificationResult" Property="@nameof(MediaVerificationResult.FailureReason)" Title="@L["ColFailureReason"]" />
                    </Columns>
                </RadzenDataGrid>
            }
        }
    }
    else
    {
        <RadzenCard Variant="Variant.Outlined" class="pa-4 mb-4">
            <RadzenStack>
                <RadzenDropDown TValue="string" @bind-Value="_selectedDeviceId" Data="@DeviceOptions"
                    TextProperty="Value" ValueProperty="Key" Placeholder="@L["SelectDeviceFilter"]" />
                <label>@L["ProviderDeviceIdLabel"]</label> <RadzenTextBox @bind-Value="_providerDeviceId" Placeholder="@L["ProviderDeviceIdPlaceholder"]" />
                <label>
                    @L["FromLabel"] <RadzenDatePicker TValue="DateTime" @bind-Value="_fromDate" />
                </label>
                <label>
                    @L["ToLabel"] <RadzenDatePicker TValue="DateTime" @bind-Value="_toDate" />
                </label>
                <RadzenButton Text="@L["ReconcileButton"]" Click="ReconcileAsync" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Filled" />
            </RadzenStack>
        </RadzenCard>

        @if (_discrepancies is not null)
        {
            @if (_discrepancies.Count == 0)
            {
                <RadzenText>@L["NoDiscrepanciesFound"]</RadzenText>
            }
            else
            {
                <RadzenDataFilter @ref="_discrepanciesFilter" TItem="ReconciliationDiscrepancy" Data="@_discrepancies" Auto="true" class="mb-2">
                    <Properties>
                        <RadzenDataFilterProperty Property="Type" Title="@L["ColType"]" />
                        <RadzenDataFilterProperty Property="ProviderEventId" Title="@L["ColProviderEventId"]" />
                        <RadzenDataFilterProperty Property="FieldName" Title="@L["ColField"]" />
                        <RadzenDataFilterProperty Property="StoredValue" Title="@L["ColStoredValue"]" />
                        <RadzenDataFilterProperty Property="ProviderValue" Title="@L["ColProviderValue"]" />
                    </Properties>
                </RadzenDataFilter>
                <RadzenDataGrid TItem="ReconciliationDiscrepancy" Data="@_discrepanciesFilter?.View" AllowPaging="true" PageSize="20" AllowSorting="true">
                    <Columns>
                        <RadzenDataGridColumn TItem="ReconciliationDiscrepancy" Property="@nameof(ReconciliationDiscrepancy.Type)" Title="@L["ColType"]" />
                        <RadzenDataGridColumn TItem="ReconciliationDiscrepancy" Property="@nameof(ReconciliationDiscrepancy.ProviderEventId)" Title="@L["ColProviderEventId"]" />
                        <RadzenDataGridColumn TItem="ReconciliationDiscrepancy" Property="@nameof(ReconciliationDiscrepancy.FieldName)" Title="@L["ColField"]" />
                        <RadzenDataGridColumn TItem="ReconciliationDiscrepancy" Property="@nameof(ReconciliationDiscrepancy.StoredValue)" Title="@L["ColStoredValue"]" />
                        <RadzenDataGridColumn TItem="ReconciliationDiscrepancy" Property="@nameof(ReconciliationDiscrepancy.ProviderValue)" Title="@L["ColProviderValue"]" />
                    </Columns>
                </RadzenDataGrid>
            }
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private string _providerDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private string _activeTab = "integrity";
    private IReadOnlyList<MediaVerificationResult>? _verificationResults;
    private IReadOnlyList<ReconciliationDiscrepancy>? _discrepancies;
    private RadzenDataFilter<MediaVerificationResult>? _verificationResultsFilter;
    private RadzenDataFilter<ReconciliationDiscrepancy>? _discrepanciesFilter;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _activeTab = NavigationManager.Uri.Contains("reconcile", StringComparison.OrdinalIgnoreCase)
                ? "reconcile"
                : "integrity";

            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();

                // Deliberately NOT auto-run on load, unlike the read-only report pages: verifying
                // hashes every media file's bytes from disk, which is expensive across a whole
                // library (thousands of files) - it must be an explicit, on-demand action.
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task VerifyIntegrityAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _verificationResults = await EvidenceValidationService.VerifyLocalIntegrityAsync(deviceId, CancellationToken.None);
    }

    private async Task ReconcileAsync()
    {
        if (!Guid.TryParse(_selectedDeviceId, out var deviceId) || string.IsNullOrWhiteSpace(_providerDeviceId))
        {
            return;
        }

        _discrepancies = await EvidenceValidationService.ReconcileWithProviderAsync(
            deviceId,
            _providerDeviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }

    private static string StatusColor(string status) => status switch
    {
        "verified" => "green",
        "failed" => "red",
        "missing" => "goldenrod",
        _ => "black",
    };
}
