@page "/analyze/validate/integrity"
@page "/analyze/validate/reconcile"
@using VideoForensics.Data.Common.Entities
@inject IProviderAuthService AuthService
@inject IEvidenceValidationService EvidenceValidationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4" Class="mb-4">Validate Evidence</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudAlert Severity="Severity.Info">
        You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to validate evidence.
    </MudAlert>
}
else
{
    <MudStack Row="true" Class="mb-4">
        <MudButton OnClick='() => _activeTab = "integrity"' Variant='@(_activeTab == "integrity" ? Variant.Filled : Variant.Outlined)' Color='@(_activeTab == "integrity" ? Color.Primary : Color.Default)'>Verify Integrity</MudButton>
        <MudButton OnClick='() => _activeTab = "reconcile"' Variant='@(_activeTab == "reconcile" ? Variant.Filled : Variant.Outlined)' Color='@(_activeTab == "reconcile" ? Color.Primary : Color.Default)'>Reconcile with Provider</MudButton>
    </MudStack>

    @if (_activeTab == "integrity")
    {
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudStack>
                <MudSelect T="string" @bind-Value="_selectedDeviceId" Label="Device">
                    <MudSelectItem Value="@("")">(All devices)</MudSelectItem>
                    @foreach (var device in _devices)
                    {
                        <MudSelectItem Value="@device.Id.ToString()">@device.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton OnClick="VerifyIntegrityAsync" Variant="Variant.Filled" Color="Color.Primary">Verify</MudButton>
            </MudStack>
        </MudPaper>

        @if (_verificationResults is not null)
        {
            @if (_verificationResults.Count == 0)
            {
                <MudText>No media items found to verify.</MudText>
            }
            else
            {
                <MudSimpleTable Hover="true" Dense="true">
                    <thead>
                        <tr>
                            <th>File Name</th>
                            <th>Status</th>
                            <th>Failure Reason</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var result in _verificationResults)
                        {
                            <tr>
                                <td>@result.FileName</td>
                                <td style="color:@StatusColor(result.Status)">@result.Status</td>
                                <td>@(result.FailureReason ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        }
    }
    else
    {
        <MudPaper Class="pa-4 mb-4" Outlined="true">
            <MudStack>
                <MudSelect T="string" @bind-Value="_selectedDeviceId" Label="Device">
                    <MudSelectItem Value="@("")">(Select a device)</MudSelectItem>
                    @foreach (var device in _devices)
                    {
                        <MudSelectItem Value="@device.Id.ToString()">@device.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudTextField @bind-Value="_providerDeviceId" Label="Provider Device ID" Variant="Variant.Outlined" />
                <label>
                    From: <input type="date" @bind="_fromDate" />
                </label>
                <label>
                    To: <input type="date" @bind="_toDate" />
                </label>
                <MudButton OnClick="ReconcileAsync" Variant="Variant.Filled" Color="Color.Primary">Reconcile</MudButton>
            </MudStack>
        </MudPaper>

        @if (_discrepancies is not null)
        {
            @if (_discrepancies.Count == 0)
            {
                <MudText>No discrepancies found.</MudText>
            }
            else
            {
                <MudSimpleTable Hover="true" Dense="true">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Provider Event ID</th>
                            <th>Field</th>
                            <th>Stored Value</th>
                            <th>Provider Value</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var discrepancy in _discrepancies)
                        {
                            <tr>
                                <td>@discrepancy.Type</td>
                                <td>@discrepancy.ProviderEventId</td>
                                <td>@(discrepancy.FieldName ?? "-")</td>
                                <td>@(discrepancy.StoredValue ?? "-")</td>
                                <td>@(discrepancy.ProviderValue ?? "-")</td>
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            }
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private string _providerDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private string _activeTab = "integrity";
    private IReadOnlyList<MediaVerificationResult>? _verificationResults;
    private IReadOnlyList<ReconciliationDiscrepancy>? _discrepancies;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _activeTab = NavigationManager.Uri.Contains("reconcile", StringComparison.OrdinalIgnoreCase)
                ? "reconcile"
                : "integrity";

            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();

                // Deliberately NOT auto-run on load, unlike the read-only report pages: verifying
                // hashes every media file's bytes from disk, which is expensive across a whole
                // library (thousands of files) - it must be an explicit, on-demand action.
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task VerifyIntegrityAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _verificationResults = await EvidenceValidationService.VerifyLocalIntegrityAsync(deviceId, CancellationToken.None);
    }

    private async Task ReconcileAsync()
    {
        if (!Guid.TryParse(_selectedDeviceId, out var deviceId) || string.IsNullOrWhiteSpace(_providerDeviceId))
        {
            return;
        }

        _discrepancies = await EvidenceValidationService.ReconcileWithProviderAsync(
            deviceId,
            _providerDeviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
    }

    private static string StatusColor(string status) => status switch
    {
        "verified" => "green",
        "failed" => "red",
        "missing" => "goldenrod",
        _ => "black",
    };
}
