@page "/collect/videos"
@inject IProviderAuthService AuthService
@inject IVideoDownloadService DownloadService

<MudText Typo="Typo.h4" Class="mb-4">Collect Videos</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudText>You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to collect videos.</MudText>
}
else
{
    <div class="collect-form">
        <div>
            <MudTextField @bind-Value="_outputPath" Label="Output Path" Variant="Variant.Outlined" Disabled="@_isDownloading" />
        </div>
        <div>
            <label for="startDate">Start Date</label>
            <input id="startDate" type="date" @bind="_startDate" disabled="@_isDownloading" />
        </div>
        <div>
            <label for="endDate">End Date</label>
            <input id="endDate" type="date" @bind="_endDate" disabled="@_isDownloading" />
        </div>
        <div>
            <MudCheckBox @bind-Value="_force" Label="Force full re-scan" Disabled="@_isDownloading" />
        </div>
        <div>
            <MudButton OnClick="StartDownloadAsync" Disabled="@_isDownloading" Variant="Variant.Filled" Color="Color.Primary">Start Download</MudButton>
        </div>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        @if (_downloadCompleted)
        {
            <MudText>@(_downloadSucceeded ? "Download completed." : "Download finished with errors.")</MudText>
        }
    </div>

    <DownloadProgressPanel IsActive="_isDownloading" DownloadService="DownloadService" />
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isDownloading;
    private bool _downloadCompleted;
    private bool _downloadSucceeded;
    private string? _errorMessage;

    private string _outputPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "VideoForensics", "Downloads");
    private DateTime _startDate = DateTime.Today.AddDays(-90);
    private DateTime _endDate = DateTime.Today;
    private bool _force;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task StartDownloadAsync()
    {
        _errorMessage = null;
        _downloadCompleted = false;
        _isDownloading = true;

        var outputPath = _outputPath;
        var startDate = _startDate;
        var endDate = _endDate;
        var force = _force;

        _ = Task.Run(async () =>
        {
            try
            {
                await DownloadService.PreScanAsync(outputPath, startDate, endDate, force, CancellationToken.None);
                var success = await DownloadService.DownloadVideosAsync(outputPath, startDate, endDate, force);

                await InvokeAsync(() =>
                {
                    _downloadSucceeded = success;
                    _downloadCompleted = true;
                    if (!success)
                    {
                        _errorMessage = DownloadService.GetLastError() ?? "Download failed.";
                    }
                    _isDownloading = false;
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = $"Download failed: {ex.Message}";
                    _downloadCompleted = true;
                    _downloadSucceeded = false;
                    _isDownloading = false;
                    StateHasChanged();
                });
            }
        });
    }
}
