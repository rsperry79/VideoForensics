@page "/workflow"
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Workflow> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToUseWorkflow"]
    </div>
}
else
{
    <ol class="workflow-steps">
        <li>
            <h5 class="mt-4 mb-2">@L["Step1Title"]</h5>
            <span>@L["Step1Description"]</span>
            <a href="/accounts">@L["GoToAccounts"]</a>
        </li>
        <li>
            <h5 class="mt-4 mb-2">@L["Step2Title"]</h5>
            <span>@L["Step2Description"]</span>
            <a href="/collect/videos">@L["CollectVideos"]</a>
            &nbsp;|&nbsp;
            <a href="/collect/snapshots">@L["CollectSnapshots"]</a>
        </li>
        <li>
            <h5 class="mt-4 mb-2">@L["Step3Title"]</h5>
            <span>@L["Step3Description"]</span>
            <a href="/events">@L["GoToEvents"]</a>
        </li>
        <li>
            <h5 class="mt-4 mb-2">@L["Step4Title"]</h5>
            <span>@L["Step4Description"]</span>
            <a href="/analyze/validate/integrity">@L["GoToIntegrityValidation"]</a>
        </li>
        <li>
            <h5 class="mt-4 mb-2">@L["Step5Title"]</h5>
            <span>@L["Step5Description"]</span>
            <a href="/analyze/reports">@L["Reports"]</a>
            &nbsp;|&nbsp;
            <a href="/analyze/jamming">@L["JammingAnalysis"]</a>
            &nbsp;|&nbsp;
            <a href="/analyze/signal-anomalies">@L["SignalAnomalies"]</a>
        </li>
        <li>
            <h5 class="mt-4 mb-2">@L["Step6Title"]</h5>
            <span>@L["Step6Description"]</span>
            <a href="/review/export">@L["GoToExport"]</a>
        </li>
    </ol>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }
}
