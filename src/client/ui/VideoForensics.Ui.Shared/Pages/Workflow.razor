@page "/workflow"
@inject IProviderAuthService AuthService
@inject NavigationManager NavigationManager

<MudText Typo="Typo.h4" Class="mb-4">Full Forensic Workflow</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudAlert Severity="Severity.Info">
        You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to use the workflow.
    </MudAlert>
}
else
{
    <ol class="workflow-steps">
        <li>
            <MudText Typo="Typo.h5" Class="mt-4 mb-2">1. Sign in / select account</MudText>
            <MudText>Choose which provider account this session works against.</MudText>
            <MudLink Href="/accounts">Go to Accounts</MudLink>
        </li>
        <li>
            <MudText Typo="Typo.h5" Class="mt-4 mb-2">2. Collect evidence</MudText>
            <MudText>Download videos and snapshots from your devices.</MudText>
            <MudLink Href="/collect/videos">Collect Videos</MudLink>
            &nbsp;|&nbsp;
            <MudLink Href="/collect/snapshots">Collect Snapshots</MudLink>
        </li>
        <li>
            <MudText Typo="Typo.h5" Class="mt-4 mb-2">3. Review evidence</MudText>
            <MudText>Review collected evidence and manage legal holds.</MudText>
            <MudLink Href="/review">Go to Review</MudLink>
        </li>
        <li>
            <MudText Typo="Typo.h5" Class="mt-4 mb-2">4. Validate evidence</MudText>
            <MudText>Verify the integrity of collected evidence.</MudText>
            <MudLink Href="/analyze/validate/integrity">Go to Integrity Validation</MudLink>
        </li>
        <li>
            <MudText Typo="Typo.h5" Class="mt-4 mb-2">5. Analyze</MudText>
            <MudText>Generate reports and analyze jamming and signal anomalies.</MudText>
            <MudLink Href="/analyze/reports">Reports</MudLink>
            &nbsp;|&nbsp;
            <MudLink Href="/analyze/jamming">Jamming Analysis</MudLink>
            &nbsp;|&nbsp;
            <MudLink Href="/analyze/signal-anomalies">Signal Anomalies</MudLink>
        </li>
        <li>
            <MudText Typo="Typo.h5" Class="mt-4 mb-2">6. Export</MudText>
            <MudText>Export the reviewed evidence for delivery.</MudText>
            <MudLink Href="/review/export">Go to Export</MudLink>
        </li>
    </ol>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }
}
