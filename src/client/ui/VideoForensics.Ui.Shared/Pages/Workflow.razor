@page "/workflow"
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Workflow> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenAlert AlertStyle="AlertStyle.Info">
        @L["NotSignedIn"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="@L["SignIn"]" /> @L["SignInToUseWorkflow"]
    </RadzenAlert>
}
else
{
    <ol class="workflow-steps">
        <li>
            <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["Step1Title"]</RadzenText>
            <RadzenText>@L["Step1Description"]</RadzenText>
            <RadzenLink Path="/accounts" Text="@L["GoToAccounts"]" />
        </li>
        <li>
            <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["Step2Title"]</RadzenText>
            <RadzenText>@L["Step2Description"]</RadzenText>
            <RadzenLink Path="/collect/videos" Text="@L["CollectVideos"]" />
            &nbsp;|&nbsp;
            <RadzenLink Path="/collect/snapshots" Text="@L["CollectSnapshots"]" />
        </li>
        <li>
            <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["Step3Title"]</RadzenText>
            <RadzenText>@L["Step3Description"]</RadzenText>
            <RadzenLink Path="/events" Text="@L["GoToEvents"]" />
        </li>
        <li>
            <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["Step4Title"]</RadzenText>
            <RadzenText>@L["Step4Description"]</RadzenText>
            <RadzenLink Path="/analyze/validate/integrity" Text="@L["GoToIntegrityValidation"]" />
        </li>
        <li>
            <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["Step5Title"]</RadzenText>
            <RadzenText>@L["Step5Description"]</RadzenText>
            <RadzenLink Path="/analyze/reports" Text="@L["Reports"]" />
            &nbsp;|&nbsp;
            <RadzenLink Path="/analyze/jamming" Text="@L["JammingAnalysis"]" />
            &nbsp;|&nbsp;
            <RadzenLink Path="/analyze/signal-anomalies" Text="@L["SignalAnomalies"]" />
        </li>
        <li>
            <RadzenText TextStyle="TextStyle.H5" class="mt-4 mb-2">@L["Step6Title"]</RadzenText>
            <RadzenText>@L["Step6Description"]</RadzenText>
            <RadzenLink Path="/review/export" Text="@L["GoToExport"]" />
        </li>
    </ol>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }
}
