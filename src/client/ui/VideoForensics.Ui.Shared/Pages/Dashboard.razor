@page "/"
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager

<RadzenText TextStyle="TextStyle.H4" class="mb-4">VideoForensics</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenText>You are not signed in. <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="Sign in" /> to view your devices.</RadzenText>
}
else
{
    @if (_devices.Count == 0)
    {
        <RadzenText>No devices found yet.</RadzenText>
    }
    else
    {
        <RadzenDataFilter @ref="_devicesFilter" TItem="VideoForensics.Data.Common.Entities.Device" Data="@_devices" Auto="true" class="mb-2">
            <Properties>
                <RadzenDataFilterProperty Property="Name" Title="Name" />
                <RadzenDataFilterProperty Property="Type" Title="Type" />
                <RadzenDataFilterProperty Property="IsOnline" Title="Online" />
                <RadzenDataFilterProperty Property="LastSyncedUtc" Title="Last Synced" />
            </Properties>
        </RadzenDataFilter>
        <RadzenDataGrid TItem="VideoForensics.Data.Common.Entities.Device" Data="@_devicesFilter?.View" AllowPaging="true" PageSize="20" AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn TItem="VideoForensics.Data.Common.Entities.Device" Property="@nameof(VideoForensics.Data.Common.Entities.Device.Name)" Title="Name" />
                <RadzenDataGridColumn TItem="VideoForensics.Data.Common.Entities.Device" Property="@nameof(VideoForensics.Data.Common.Entities.Device.Type)" Title="Type" />
                <RadzenDataGridColumn TItem="VideoForensics.Data.Common.Entities.Device" Title="Online">
                    <Template Context="device">@(device.IsOnline ? "Yes" : "No")</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoForensics.Data.Common.Entities.Device" Title="Last Synced">
                    <Template Context="device">@(device.LastSyncedUtc?.ToString() ?? "-")</Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private RadzenDataFilter<VideoForensics.Data.Common.Entities.Device>? _devicesFilter;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }
}
