@page "/"
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Dashboard> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <p>@L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToViewDevices"]</p>
}
else
{
    @if (_devices.Count == 0)
    {
        <p>@L["NoDevicesFound"]</p>
    }
    else
    {
        <SfGrid TValue="VideoForensics.Data.Common.Entities.Device" DataSource="@_filteredDevices" AllowPaging="true" AllowSorting="true" AllowFiltering="true">
            <GridPageSettings PageSize="20"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(VideoForensics.Data.Common.Entities.Device.Name)" HeaderText="@L["ColumnName"]" />
                <GridColumn Field="@nameof(VideoForensics.Data.Common.Entities.Device.Type)" HeaderText="@L["ColumnType"]" />
                <GridColumn HeaderText="@L["ColumnOnline"]">
                    <Template>
                        @{
                            var device = (VideoForensics.Data.Common.Entities.Device)context;
                            @(device.IsOnline ? L["Yes"] : L["No"])
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="@L["ColumnLastSynced"]">
                    <Template>
                        @{
                            var device = (VideoForensics.Data.Common.Entities.Device)context;
                            @(device.LastSyncedUtc?.ToString() ?? "-")
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private IEnumerable<VideoForensics.Data.Common.Entities.Device> _filteredDevices = new List<VideoForensics.Data.Common.Entities.Device>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                _filteredDevices = _devices;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }
}
