@page "/"
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository

<MudText Typo="Typo.h4" Class="mb-4">VideoForensics</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudText>You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to view your devices.</MudText>
}
else
{
    @if (_devices.Count == 0)
    {
        <MudText>No devices found yet.</MudText>
    }
    else
    {
        <MudSimpleTable Hover="true" Dense="true">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Type</th>
                    <th>Online</th>
                    <th>Last Synced</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var device in _devices)
                {
                    <tr>
                        <td>@device.Name</td>
                        <td>@device.Type</td>
                        <td>@(device.IsOnline ? "Yes" : "No")</td>
                        <td>@(device.LastSyncedUtc?.ToString() ?? "-")</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }
}
