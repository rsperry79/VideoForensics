@page "/"
@using Microsoft.Extensions.Localization
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Dashboard> L

<RadzenText TextStyle="TextStyle.H4" class="mb-4">@L["Title"]</RadzenText>

@if (_isLoading)
{
    <RadzenProgressBarCircular Value="100" Mode="ProgressBarMode.Indeterminate" ShowValue="false" />
}
else if (!_isAuthenticated)
{
    <RadzenText>@L["NotSignedIn"] <RadzenLink Path="@NavigationManager.SignInPathWithReturnUrl()" Text="@L["SignIn"]" /> @L["SignInToViewDevices"]</RadzenText>
}
else
{
    @if (_devices.Count == 0)
    {
        <RadzenText>@L["NoDevicesFound"]</RadzenText>
    }
    else
    {
        <RadzenDataFilter @ref="_devicesFilter" TItem="VideoForensics.Data.Common.Entities.Device" Data="@_devices" Auto="true" class="mb-2">
            <Properties>
                <RadzenDataFilterProperty Property="Name" Title="@L["ColumnName"]" />
                <RadzenDataFilterProperty Property="Type" Title="@L["ColumnType"]" />
                <RadzenDataFilterProperty Property="IsOnline" Title="@L["ColumnOnline"]" />
                <RadzenDataFilterProperty Property="LastSyncedUtc" Title="@L["ColumnLastSynced"]" />
            </Properties>
        </RadzenDataFilter>
        <RadzenDataGrid TItem="VideoForensics.Data.Common.Entities.Device" Data="@_devicesFilter?.View" AllowPaging="true" PageSize="20" AllowSorting="true">
            <Columns>
                <RadzenDataGridColumn TItem="VideoForensics.Data.Common.Entities.Device" Property="@nameof(VideoForensics.Data.Common.Entities.Device.Name)" Title="@L["ColumnName"]" />
                <RadzenDataGridColumn TItem="VideoForensics.Data.Common.Entities.Device" Property="@nameof(VideoForensics.Data.Common.Entities.Device.Type)" Title="@L["ColumnType"]" />
                <RadzenDataGridColumn TItem="VideoForensics.Data.Common.Entities.Device" Title="@L["ColumnOnline"]">
                    <Template Context="device">@(device.IsOnline ? L["Yes"] : L["No"])</Template>
                </RadzenDataGridColumn>
                <RadzenDataGridColumn TItem="VideoForensics.Data.Common.Entities.Device" Title="@L["ColumnLastSynced"]">
                    <Template Context="device">@(device.LastSyncedUtc?.ToString() ?? "-")</Template>
                </RadzenDataGridColumn>
            </Columns>
        </RadzenDataGrid>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private RadzenDataFilter<VideoForensics.Data.Common.Entities.Device>? _devicesFilter;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }
}
