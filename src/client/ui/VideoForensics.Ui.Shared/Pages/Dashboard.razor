@page "/"
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using Syncfusion.Blazor.QueryBuilder
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Dashboard> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <p>@L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToViewDevices"]</p>
}
else
{
    @if (_devices.Count == 0)
    {
        <p>@L["NoDevicesFound"]</p>
    }
    else
    {
        <PageRightPanelContent>
            <div class="right-panel-section">
                <h6>@L["Title"]</h6>
                <SfQueryBuilder @ref="_devicesFilter" TValue="VideoForensics.Data.Common.Entities.Device">
                    <QueryBuilderColumns>
                        <QueryBuilderColumn Field="Name" Label="@L["ColumnName"]" />
                        <QueryBuilderColumn Field="Type" Label="@L["ColumnType"]" />
                        <QueryBuilderColumn Field="IsOnline" Label="@L["ColumnOnline"]" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Boolean" />
                        <QueryBuilderColumn Field="LastSyncedUtc" Label="@L["ColumnLastSynced"]" Type="Syncfusion.Blazor.QueryBuilder.ColumnType.Date" />
                    </QueryBuilderColumns>
                </SfQueryBuilder>
                <SfButton Content="@L["ApplyFilter"]" OnClick="@(() => ApplyDevicesFilterAsync())" CssClass="e-primary mt-2" />
            </div>
        </PageRightPanelContent>
        <SfGrid TValue="VideoForensics.Data.Common.Entities.Device" DataSource="@_filteredDevices" AllowPaging="true" AllowSorting="true">
            <GridPageSettings PageSize="20"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(VideoForensics.Data.Common.Entities.Device.Name)" HeaderText="@L["ColumnName"]" />
                <GridColumn Field="@nameof(VideoForensics.Data.Common.Entities.Device.Type)" HeaderText="@L["ColumnType"]" />
                <GridColumn HeaderText="@L["ColumnOnline"]">
                    <Template>
                        @{
                            var device = (VideoForensics.Data.Common.Entities.Device)context;
                            @(device.IsOnline ? L["Yes"] : L["No"])
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="@L["ColumnLastSynced"]">
                    <Template>
                        @{
                            var device = (VideoForensics.Data.Common.Entities.Device)context;
                            @(device.LastSyncedUtc?.ToString() ?? "-")
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private SfQueryBuilder<VideoForensics.Data.Common.Entities.Device>? _devicesFilter;
    private IEnumerable<VideoForensics.Data.Common.Entities.Device> _filteredDevices = new List<VideoForensics.Data.Common.Entities.Device>();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                _filteredDevices = _devices;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task ApplyDevicesFilterAsync()
    {
        if (_devicesFilter is not null)
        {
            var result = await _devicesFilter.GetFilteredRecordsAsync();
            _filteredDevices = result?.ToList() ?? _devices;
        }
    }
}
