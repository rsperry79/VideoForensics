@page "/collect/snapshots"
@inject IProviderAuthService AuthService
@inject IVideoDownloadService DownloadService

<MudText Typo="Typo.h4" Class="mb-4">Collect Snapshots</MudText>

@if (_isLoading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (!_isAuthenticated)
{
    <MudAlert Severity="Severity.Warning">You are not signed in. <MudLink Href="/signin">Sign in</MudLink> to collect snapshots.</MudAlert>
}
else
{
    <MudStack Row="false" Spacing="2" Class="mb-4">
        <MudTextField @bind-Value="_outputPath" Label="Output Path" Variant="Variant.Outlined" Disabled="@_isDownloading" />
        <MudButton OnClick="StartDownloadAsync" Disabled="@_isDownloading" Variant="Variant.Filled" Color="Color.Primary">Start Download</MudButton>

        @if (!string.IsNullOrEmpty(_errorMessage))
        {
            <MudAlert Severity="Severity.Error">@_errorMessage</MudAlert>
        }

        @if (_downloadCompleted)
        {
            <MudText>@(_downloadSucceeded ? "Snapshot download completed." : "Snapshot download finished with errors.")</MudText>
        }
    </MudStack>

    <DownloadProgressPanel IsActive="_isDownloading" DownloadService="DownloadService" />
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isDownloading;
    private bool _downloadCompleted;
    private bool _downloadSucceeded;
    private string? _errorMessage;

    private string _outputPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "VideoForensics", "Downloads");

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task StartDownloadAsync()
    {
        _errorMessage = null;
        _downloadCompleted = false;
        _isDownloading = true;

        var outputPath = _outputPath;
        // Ring only exposes each device's current/latest snapshot - there is no historical,
        // per-event snapshot API - so "now" for both bounds matches the console app's convention
        // (see MenuManager.DownloadSnapshots).
        var startDate = DateTime.Now;
        var endDate = DateTime.Now;

        _ = Task.Run(async () =>
        {
            try
            {
                var success = await DownloadService.DownloadSnapshotsAsync(outputPath, startDate, endDate);

                await InvokeAsync(() =>
                {
                    _downloadSucceeded = success;
                    _downloadCompleted = true;
                    if (!success)
                    {
                        _errorMessage = DownloadService.GetLastError() ?? "Download failed.";
                    }
                    _isDownloading = false;
                    StateHasChanged();
                });
            }
            catch (Exception ex)
            {
                await InvokeAsync(() =>
                {
                    _errorMessage = $"Download failed: {ex.Message}";
                    _downloadCompleted = true;
                    _downloadSucceeded = false;
                    _isDownloading = false;
                    StateHasChanged();
                });
            }
        });
    }
}
