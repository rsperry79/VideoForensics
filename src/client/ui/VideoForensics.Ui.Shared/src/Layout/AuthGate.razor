@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Resources
@inject PairedSessionState SessionState
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager NavigationManager
@inject WebAuthnClient WebAuthn
@implements IDisposable

@if (_loading)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="text-center">
            <div class="spinner-border mb-3" role="status">
                <span class="visually-hidden">@L["CheckingSession"]</span>
            </div>
            <p>@L["CheckingSession"]</p>
        </div>
    </div>
}
else if (_redirecting)
{
    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="text-center">
            <div class="spinner-border mb-3" role="status">
                <span class="visually-hidden">@L["Redirecting"]</span>
            </div>
            <p>@L["Redirecting"]</p>
        </div>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _loading = true;
    private bool _redirecting = false;
    private bool _sessionConfirmed = false;

    // Routes that do not require authentication
    private static readonly HashSet<string> AllowListedRoutes = new(StringComparer.OrdinalIgnoreCase)
    {
        "/device-signin",
        "/signin",
        "/register",
        "/setup",
        "/awaiting-setup",
        "/change-password"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();

            // Subscribe to navigation changes after session is loaded
            NavigationManager.LocationChanged += HandleLocationChanged;

            // Run the initial authorization check
            await EvaluateAuthorizationAsync();
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Re-evaluate authorization on every navigation
        _ = EvaluateAuthorizationAsync();
    }

    private async Task EvaluateAuthorizationAsync()
    {
        try
        {
            // Get the current route path
            var uri = new Uri(NavigationManager.Uri);
            string path = uri.AbsolutePath;

            // Remove trailing slash if present (except for root)
            if (path.Length > 1 && path.EndsWith("/"))
            {
                path = path[..^1];
            }

            // A limited create-passkey session can reach only the passkey page (and sign-in). Checked before
            // the allow-list because /change-password is allow-listed but is not reachable under the limit.
            if (SessionState.IsSignedIn && SessionState.PasskeySetupOnly && !IsPasskeySetupReachablePath(path))
            {
                _loading = false;
                _redirecting = true;
                NavigationManager.NavigateTo(PasskeySetupPath, replace: true);
            }
            // Check if current route is allow-listed
            else if (AllowListedRoutes.Contains(path))
            {
                // Route is allow-listed, render content normally
                _loading = false;
                _redirecting = false;
            }
            else if (SessionState.IsSignedIn && !_sessionConfirmed && ResolveStaleSessionRedirectTarget(await SessionState.ConfirmSessionAsync()) is { } staleTarget)
            {
                // The stored token is no longer valid server-side (e.g. database reset): clear it and sign in again.
                _loading = false;
                _redirecting = true;
                await SessionState.ClearAsync();
                NavigationManager.NavigateTo(staleTarget, replace: true);
            }
            else if (SessionState.IsSignedIn)
            {
                _sessionConfirmed = true;
                // User is signed in - check if they must change password
                if (SessionState.MustChangePassword && path != "/change-password")
                {
                    // Redirect to change password if not already there
                    _loading = false;
                    _redirecting = true;
                    NavigationManager.NavigateTo("/change-password", replace: true);
                }
                else
                {
                    // User is signed in and route is protected, render content normally
                    _loading = false;
                    _redirecting = false;
                }
            }
            else
            {
                // Not signed in and not on allow-list - determine where to redirect
                _loading = false;
                _redirecting = true;

                (bool isEmpty, bool isLocal) = await WebAuthn.GetSetupStatusAsync();
                NavigationManager.NavigateTo(ResolveBootstrapRedirectTarget(isEmpty, isLocal), replace: true);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            // Log error but don't let it crash the component
            System.Diagnostics.Debug.WriteLine($"Authorization check failed: {ex}");
            // Fail closed: never render protected content after an error; send the visitor to sign-in.
            _loading = false;
            _redirecting = true;
            try
            {
                NavigationManager.NavigateTo(ResolveFailureRedirectTarget(), replace: true);
            }
            catch (Exception navEx)
            {
                System.Diagnostics.Debug.WriteLine($"Fail-closed redirect failed: {navEx}");
            }
            StateHasChanged();
        }
    }

    private const string PasskeySetupPath = "/settings/passkeys?setup=true";

    private static bool IsPasskeySetupReachablePath(string path)
    {
        return string.Equals(path, "/settings/passkeys", StringComparison.OrdinalIgnoreCase)
            || string.Equals(path, "/signin", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }

    /// <summary>True when a route template is reachable while signed out. Shared with PageAccessRouteView so the page guard does not blank these pages.</summary>
    public static bool IsAllowListedRoute(string path) => AllowListedRoutes.Contains(path);

    /// <summary>
    /// Where an unauthenticated visitor on a non-allow-listed route should land, given the current
    /// bootstrap state. Public static (not private) so AuthGateTests.cs can exercise this exact
    /// logic directly rather than duplicating it in the test file.
    /// - No operators exist and this visitor is on the local machine: /setup, for first-run admin
    ///   account creation.
    /// - No operators exist but this visitor is NOT local: /awaiting-setup - don't let a remote
    ///   device win the race to claim the SuperAdmin account (see SetupEndpoints.CreateAdminAsync's
    ///   matching server-side enforcement, and the installer's own warning about this exact race).
    /// - Operators already exist: /signin, the normal sign-in entry point.
    /// </summary>
    public static string ResolveBootstrapRedirectTarget(bool isEmpty, bool isLocal)
    {
        return isEmpty && isLocal ? "/setup"
             : isEmpty ? "/awaiting-setup"
             : "/signin";
    }

    /// <summary>
    /// Redirect target when the authorization check itself throws: always sign-in (fail closed), never a
    /// protected route. Does not consult setup status because that call may be what failed.
    /// </summary>
    public static string ResolveFailureRedirectTarget() => "/signin";

    /// <summary>Sign-in redirect when the server rejected the stored session token; null when it was accepted.</summary>
    public static string? ResolveStaleSessionRedirectTarget(bool sessionConfirmed) => sessionConfirmed ? null : "/signin";
}
