@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Resources
@using VideoForensics.Client.Ui.Shared.Services
@inject IProviderAccountRepository ProviderAccountRepository
@inject IUserRepository UserRepository
@inject IProviderAuthService AuthService
@inject IForensicsConfiguration ForensicsConfig
@inject IForensicsConfigurationService ForensicsConfigService
@inject IStringLocalizer<SharedResources> L
@inject PairedSessionState SessionState
@inject AccountSelectionState AccountSelectionState

@if (SessionState.IsSignedIn)
{
    <div class="right-panel-section">
        <small>@L["Active Account"]</small>
        @if (_isLoading)
        {
            <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
        }
        else if (_rows.Count == 0)
        {
            <small>@L["NoAccountsLinked"]</small>
        }
        else
        {
            <SfDropDownList TValue="Guid?" TItem="AccountRow" Value="@_selectedAccountId" ValueChanged="@(async (Guid? v) => await SelectAccountAsync(v))"
                             DataSource="@_rows" Enabled="@(!_isBusy)" CssClass="w-100">
                <DropDownListFieldSettings Text="DisplayName" Value="Id"></DropDownListFieldSettings>
            </SfDropDownList>
        }
        @if (!string.IsNullOrEmpty(_statusMessage))
        {
            <small>@_statusMessage</small>
        }
    </div>
}

@code {
    private sealed record AccountRow(Guid Id, string DisplayName);

    private List<AccountRow> _rows = new();
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _statusMessage;
    private Guid? _selectedAccountId;

    protected override async Task OnInitializedAsync()
    {
        // Session state must be loaded via EnsureLoadedAsync in OnAfterRenderAsync before IsSignedIn is meaningful.
        // Don't load accounts here yet.
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // IJSRuntime is unavailable during Blazor's static prerender pass, so session state
            // can only be resolved once the circuit is connected.
            await SessionState.EnsureLoadedAsync();

            // Only load accounts if operator is signed in
            if (SessionState.IsSignedIn)
            {
                await LoadAccountsAsync();
                StateHasChanged();
            }
            else
            {
                _isLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        try
        {
            var accounts = await ProviderAccountRepository.ListAsync(CancellationToken.None);
            var rows = new List<AccountRow>();
            foreach (var account in accounts)
            {
                string displayName = account.ProviderName;
                try
                {
                    var user = await UserRepository.GetAsync(account.UserId, CancellationToken.None);
                    if (user is not null)
                    {
                        displayName = user.DisplayName;
                    }
                }
                catch
                {
                    // Fall back to ProviderName if user lookup fails for any reason.
                }

                rows.Add(new AccountRow(account.Id, displayName));
            }

            _rows = rows;
            _selectedAccountId = await AccountSelectionState.GetSelectedAccountIdAsync(rows.Select(r => r.Id).ToList());
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectAccountAsync(Guid? accountId)
    {
        if (accountId is null)
        {
            return;
        }

        _isBusy = true;
        _statusMessage = null;
        try
        {
            _selectedAccountId = accountId;
            await AccountSelectionState.SetSelectedAccountIdAsync(accountId.Value);

            // The server-side active account still drives downloads, so keep it in step with this browser's choice.
            ForensicsConfig.ActiveProviderAccountId = accountId;
            await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);

            var resumed = await AuthService.RestoreFromSavedCredentialsAsync(accountId);
            _statusMessage = resumed
                ? L["SwitchedActiveAccount"].Value
                : L["SwitchedSessionNotResumed"].Value;
        }
        catch (Exception ex)
        {
            _statusMessage = L["CouldNotSwitchAccount", ex.Message].Value;
        }
        finally
        {
            _isBusy = false;
        }
    }
}
