@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Components.Inspector
@implements IDisposable
@inject RightPanelContentService RightPanelContent

<div class="right-panel">
    <InspectorPanel />
    <AccountSwitcher />

    @if (RightPanelContent.Content is not null)
    {
        <div class="right-panel-section right-panel-page-context">
            @RightPanelContent.Content
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        RightPanelContent.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        RightPanelContent.OnChange -= StateHasChanged;
    }
}
