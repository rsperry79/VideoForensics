@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Resources
@implements IDisposable
@inject ThemePreferenceService ThemeService
@inject IStringLocalizer<SharedResources> L

<div class="right-panel-section">
    <small>@L["Theme"]</small>
    <div class="d-flex flex-row gap-2">
        <SfButton Content="@L["Light"]" CssClass="@(ThemeService.Mode == ThemeMode.Light ? "e-primary" : "e-flat")" OnClick="@(async () => await ThemeService.SetModeAsync(ThemeMode.Light))" />
        <SfButton Content="@L["Dark"]" CssClass="@(ThemeService.Mode == ThemeMode.Dark ? "e-primary" : "e-flat")" OnClick="@(async () => await ThemeService.SetModeAsync(ThemeMode.Dark))" />
        <SfButton Content="@L["System"]" CssClass="@(ThemeService.Mode == ThemeMode.System ? "e-primary" : "e-flat")" OnClick="@(async () => await ThemeService.SetModeAsync(ThemeMode.System))" />
    </div>

    <small class="mt-3 d-block">@L["Language"]</small>
    <SfDropDownList TValue="string" TItem="CultureOption" Value="@(ThemeService.CultureName ?? "en-US")"
                     ValueChanged="@(async (string v) => await ThemeService.SetCultureAsync(v))" DataSource="@_availableCultures" CssClass="w-100">
        <DropDownListFieldSettings Text="Name" Value="Code"></DropDownListFieldSettings>
    </SfDropDownList>
</div>

@code {
    private sealed record CultureOption(string Code, string Name);

    private readonly List<CultureOption> _availableCultures = new()
    {
        new("en-US", "English (US)")
    };

    protected override void OnInitialized()
    {
        ThemeService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        ThemeService.OnChange -= StateHasChanged;
    }
}
