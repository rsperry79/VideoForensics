@inherits LayoutComponentBase
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Syncfusion.Blazor.Layouts
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Services.Inspector
@using VideoForensics.Client.Ui.Shared.Services.Scope
@using VideoForensics.Client.Ui.Shared.Layout.RightPanel
@using VideoForensics.Client.Ui.Shared.Layout.LeftPanel
@using VideoForensics.Client.Ui.Shared.Components.Scope
@using VideoForensics.Client.Ui.Shared.Resources
@inject PairedSessionState SessionState
@inject IAppLockPreferencesStore AppLockPreferences
@inject NavigationManager Nav
@inject ThemePreferenceService ThemeService
@inject LayoutPreferencesState LayoutPrefs
@inject IStringLocalizer<SharedResources> L
@inject IServerConnectivityState ConnectivityState
@inject IJSRuntime JS
@using VideoForensics.Client.Ui.Shared.Services.Notices
@inject INoticeRepository NoticeRepository
@inject INoticeDismissalRepository NoticeDismissalRepository
@inject InspectorState InspectorState
@inject ILogger<MainLayout> Logger

<div class="app-layout">
    @if (ConnectivityState.IsUnreachable)
    {
        <div class="alert alert-danger" role="alert" style="margin: 0; border-radius: 0; border: none; padding: 12px 16px;">
            <strong>@L["ServerNotReachableTitle"]</strong> — @L["ServerNotReachableMessage"]
        </div>
    }

    <div class="app-header">
        <div class="app-bar">
            @if (_passkeySetupOnly)
            {
                @* Limited create-passkey session: the only control is sign-out. *@
                <SfButton Content="@L["SignOut"]" OnClick="@SignOutAsync" CssClass="passkey-setup-signout e-flat" />
            }
            else
            {
                <SfButton Content="☰" CssClass="left-nav-toggle e-flat" OnClick="@ToggleLeftNavAsync" title="@L["ToggleNavigation"]" />

                <div class="top-tabs">
                    @foreach (var group in VisibleGroups)
                    {
                        <SfButton Content="@L[group.Text]" OnClick="@(() => Nav.NavigateTo(group.Path))"
                                  CssClass="@("top-tab-button " + (group.Key == ActiveGroup.Key ? "e-primary" : "e-flat"))" />
                    }
                </div>

                <div style="position: relative;">
                    <SfButton Content="🔔" CssClass="notices-toggle e-flat" OnClick="@ToggleNoticesAsync" title="@L["Notices"]" />
                    @if (_undismissedCount > 0)
                    {
                        <span class="notices-badge">@_undismissedCount</span>
                    }
                </div>
                <SfButton Content="⚙" CssClass="right-panel-toggle e-flat" OnClick="@ToggleRightPanelAsync" title="@L["ToggleSettingsPanel"]" />
                <UserMenuButton />
            }
        </div>
    </div>

    @if (_noticesDropdownOpen)
    {
        @* Transparent full-page backdrop: any click outside the dropdown lands here and closes it. *@
        <div class="notices-backdrop" @onclick="ToggleNoticesAsync"></div>
        <div class="notices-dropdown">
            @if (_noticesList.Count > 0)
            {
                <div style="padding: 8px 16px; border-bottom: 1px solid #e0e0e0; text-align: right;">
                    <SfButton Content="@L["ClearAll"]" OnClick="@DismissAllNoticesAsync" CssClass="e-outline e-small" />
                </div>
            }
            <div style="max-height: 400px; overflow-y: auto;">
                @if (_noticesList.Count == 0)
                {
                    <div style="padding: 16px; text-align: center; color: #666;">@L["NoNotices"]</div>
                }
                else
                {
                    @foreach (var notice in _noticesList)
                    {
                        <div style="padding: 12px 16px; border-bottom: 1px solid #e0e0e0; display: flex; justify-content: space-between; align-items: flex-start; gap: 8px;">
                            <div style="flex: 1;">
                                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                    <span class="@GetSeverityBadgeClass(notice.Severity)" style="padding: 2px 6px; border-radius: 3px; font-size: 11px; font-weight: bold;">
                                        @GetSeverityLabel(notice.Severity)
                                    </span>
                                    <strong style="font-size: 13px;">@NoticeActions.Title(notice.EventType)</strong>
                                </div>
                                <div style="font-size: 12px; color: #666; margin-bottom: 4px;" title="@notice.Details">
                                    @(notice.Details?.Length > 80 ? notice.Details.Substring(0, 80) + "..." : notice.Details ?? "")
                                </div>
                                <div style="font-size: 11px; color: #999;">
                                    @GetRelativeTime(notice.TimestampUtc)
                                </div>
                                @{
                                    string? settingsLink = NoticeActions.DeviceSettingsLink(notice.EventType, notice.ActionPath);
                                    string? reviewLink = NoticeActions.ReviewLink(notice.EventType, notice.ActionPath);
                                }
                                @if (settingsLink is not null || reviewLink is not null)
                                {
                                    <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px;">
                                        @if (reviewLink is not null)
                                        {
                                            <a href="@reviewLink" @onclick="ToggleNoticesAsync" class="btn btn-sm btn-outline-danger" data-testid="notice-review">@(notice.EventType == NoticeActions.SignalDeviationEventType ? L["NoticeReviewSignal"] : L["NoticeReview"])</a>
                                        }
                                        @if (settingsLink is not null)
                                        {
                                            <a href="@settingsLink" @onclick="ToggleNoticesAsync" class="btn btn-sm btn-outline-secondary" data-testid="notice-device-settings">@L["NoticeDeviceSettings"]</a>
                                        }
                                    </div>
                                }
                            </div>
                            <SfButton Content="@L["Dismiss"]" OnClick="@(() => DismissNoticeAsync(notice.Id))" CssClass="e-outline e-small" IconCss="e-icons e-close" />
                        </div>
                    }
                }
            </div>
            <div style="padding: 12px 16px; border-top: 1px solid #e0e0e0; text-align: center;">
                <a href="/notices" @onclick="GoToAllNoticesAsync" @onclick:preventDefault="true" style="color: #0066cc; text-decoration: none; font-size: 12px; cursor: pointer;">@L["ViewAll"]</a>
            </div>
        </div>
    }

    <div class="app-body">
        @* Left-nav collapse is driven imperatively via CollapseAsync/ExpandAsync (see
           ToggleLeftNavAsync) rather than by conditionally swapping SplitterPane markup, so the
           pane's shape never changes across renders - Syncfusion's Splitter mutates the DOM via JS
           interop outside Blazor's normal diffing, and swapping pane markup was found (by hand) to
           corrupt the whole page's layout/height on some renders. Only 2 panes here deliberately:
           the right panel is NOT a third SplitterPane. Syncfusion's Splitter always forces its last
           pane to be the flexible/auto one regardless of any Size given to it, so a fixed-width
           resizable pane cannot sit to the right of the flexible content pane in one flat Splitter;
           nesting a second SfSplitter to work around that was also tried and found (by hand) to
           corrupt the outer layout whenever the outer pane collapses/expands. The right panel is
           therefore a plain, hand-rolled resizable div (see wwwroot/scripts/panel-resize.js) rather than
           a Syncfusion component - do not "simplify" this back to a 3-pane or nested Splitter
           without re-testing left-nav collapse AND right-panel drag-resize by hand. *@
        <SfSplitter @ref="_outerSplitter" Height="100%" Width="100%" CssClass="e-splitter-layout" Orientation="Syncfusion.Blazor.Layouts.Orientation.Horizontal">
            <SplitterPanes>
                <SplitterPane Size="@($"{_leftNavWidth}px")" Min="48px" Max="400px" Resizable="false" CssClass="splitter-left-nav">
                    <div style="display: flex; flex-direction: column; height: 100%; overflow: hidden;">
                        <div class="left-nav-items">
                            <NavSectionList Sections="@ActiveGroupSections" CurrentPath="@_currentPath" CurrentQuery="@_currentQuery"
                                            OnItemSelected="@((NavItem item) => Nav.NavigateTo(item.Path))" />
                        </div>
                        <LeftPanelHost />
                    </div>
                </SplitterPane>
                <SplitterPane CssClass="splitter-content-wrapper">
                    <div class="content-wrapper">
                        <MaintenanceBanner />
                        <div class="page-body">
                            @Body
                        </div>
                        @if (!_passkeySetupOnly && !LayoutPrefs.RightPanelCollapsed)
                        {
                            <div id="@_rightPanelHandleId" class="right-panel-handle" title="@L["DragToResize"]"></div>
                            <div id="@_rightPanelId" class="right-panel-fixed" style="@RightPanelStyle">
                                <RightPanelHost />
                            </div>
                        }
                    </div>
                </SplitterPane>
            </SplitterPanes>
        </SfSplitter>
    </div>
</div>
