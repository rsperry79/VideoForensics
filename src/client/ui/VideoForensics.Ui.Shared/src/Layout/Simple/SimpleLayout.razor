@namespace VideoForensics.Client.Ui.Shared.Layout.Simple
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Resources
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Components
@implements IDisposable
@inject PairedSessionState SessionState
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@inject IUiModeService UiModeService

<div class="simple-layout">
    <header class="simple-layout-header">
        <span class="simple-layout-title">VideoForensics</span>
        <div class="simple-layout-buttons">
            @if (!UiModeService.IsLocked && !_passkeySetupOnly)
            {
                <SfButton Content="@L["SimpleStandardView"]" OnClick="@SwitchToStandardAsync" CssClass="simple-layout-standard-button e-flat" />
            }
            <SfButton Content="@L["SignOut"]" OnClick="@SignOutAsync" CssClass="simple-layout-signout e-flat" />
        </div>
    </header>
    <main class="simple-layout-body">
        <div class="simple-layout-content">
            @if (!_passkeySetupOnly && IsHomeRoute())
            {
                <SimpleHome />
            }
            else
            {
                @Body
            }
        </div>
        @if (!_passkeySetupOnly)
        {
            <div class="simple-layout-chat">
                <ChatPanel />
            </div>
        }
    </main>
</div>

@code {
    // Mirrors SessionState.PasskeySetupOnly (limited create-passkey session): the chat panel and the home are hidden, the routed passkey page is not.
    private bool _passkeySetupOnly;

    protected override void OnInitialized()
    {
        _passkeySetupOnly = SessionState.PasskeySetupOnly;
        UiModeService.OnChange += StateHasChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Session state is only readable once the circuit is connected (see MainLayout).
            await SessionState.EnsureLoadedAsync();
            if (_passkeySetupOnly != SessionState.PasskeySetupOnly)
            {
                _passkeySetupOnly = SessionState.PasskeySetupOnly;
                StateHasChanged();
            }
        }
    }

    // Only the home routes get the plain-language home; every other route (sign-in, password change, chat, cases...) renders as routed.
    private bool IsHomeRoute()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        return path.Length == 0 || string.Equals(path, "/media", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _passkeySetupOnly = SessionState.PasskeySetupOnly;
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task SwitchToStandardAsync()
    {
        await UiModeService.SetModeAsync("Standard");
    }

    private async Task SignOutAsync()
    {
        await SessionState.SignOutAsync();
        Nav.NavigateTo("/signin");
    }

    public void Dispose()
    {
        UiModeService.OnChange -= StateHasChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}