@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout
@using VideoForensics.Ui.Shared.Resources
@inject IStringLocalizer<SharedResources> L

<Router AppAssembly="typeof(Layout.MainLayout).Assembly">
    <Found Context="routeData">
        <AuthGate>
            <RouteView RouteData="routeData" DefaultLayout="typeof(Layout.ResponsiveLayout)" />
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </AuthGate>
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(Layout.ResponsiveLayout)">
            <p role="alert">@L["NotFoundMessage"]</p>
        </LayoutView>
    </NotFound>
</Router>
