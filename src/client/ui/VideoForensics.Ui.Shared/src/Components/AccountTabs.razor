@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Pages
@inject IStringLocalizer<AccountDetails> L

<nav class="nav nav-tabs mb-4" aria-label="@L["AccountTabsLabel"]">
    <NavLink class="nav-link" href="@_basePath" Match="NavLinkMatch.All">@L["TabDetails"]</NavLink>
    <NavLink class="nav-link" href="@($"{_basePath}/devices")">@L["TabDevices"]</NavLink>
    <NavLink class="nav-link" href="@($"{_basePath}/cases")">@L["TabCases"]</NavLink>
    <NavLink class="nav-link" href="@($"{_basePath}/sync")">@L["TabSync"]</NavLink>
</nav>

@code {
    [Parameter, EditorRequired]
    public Guid AccountId { get; set; }

    private string _basePath => $"/accounts/{AccountId}";
}
