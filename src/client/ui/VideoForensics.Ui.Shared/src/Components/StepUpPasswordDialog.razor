@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Resources
@using VideoForensics.Ui.Shared.Services
@inject StepUpService StepUp
@inject IStringLocalizer<SharedResources> L
@implements IDisposable

@* Shown only when a password-session operator confirms a destructive change. Passkey sessions never see it. *@
@if (_open)
{
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="stepup-password-title" data-testid="stepup-password-dialog">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="stepup-password-title">@L["StepUpPasswordTitle"]</h5>
                </div>
                <div class="modal-body">
                    <p>@L["StepUpPasswordDescription"]</p>
                    <input type="password" class="form-control" autocomplete="current-password"
                           aria-label="@L["StepUpPasswordLabel"]" placeholder="@L["StepUpPasswordLabel"]"
                           data-testid="stepup-password-input" @bind="_password" @bind:event="oninput" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-testid="stepup-password-cancel" @onclick="Cancel">@L["StepUpCancelButton"]</button>
                    <button type="button" class="btn btn-primary" data-testid="stepup-password-confirm"
                            disabled="@string.IsNullOrEmpty(_password)" @onclick="Confirm">@L["StepUpConfirmButton"]</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool _open;
    private string _password = string.Empty;
    private TaskCompletionSource<string?>? _pending;

    protected override void OnInitialized()
    {
        StepUp.RegisterPasswordPrompt(AskAsync);
    }

    private Task<string?> AskAsync()
    {
        _password = string.Empty;
        _pending = new TaskCompletionSource<string?>(TaskCreationOptions.RunContinuationsAsynchronously);
        _open = true;
        _ = InvokeAsync(StateHasChanged);
        return _pending.Task;
    }

    private void Confirm()
    {
        string password = _password;
        Resolve(password);
    }

    private void Cancel()
    {
        Resolve(null);
    }

    /// <summary>Closes the dialog and hands the answer to the waiting step-up. The typed password is cleared either way.</summary>
    private void Resolve(string? password)
    {
        TaskCompletionSource<string?>? pending = _pending;
        _pending = null;
        _password = string.Empty;
        _open = false;
        _ = pending?.TrySetResult(password);
    }

    public void Dispose()
    {
        // A step-up still waiting on this dialog must not hang once the page or circuit is gone.
        Resolve(null);
    }
}
