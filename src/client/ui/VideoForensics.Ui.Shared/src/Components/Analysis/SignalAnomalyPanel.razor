@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Services.Analysis
@using VideoForensics.Client.Ui.Shared.Services.Scope
@inject IReportGenerationService ReportGenerationService
@inject IStringLocalizer<SignalAnomalyPanel> L

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_report is not null)
{
    <h5 class="mt-4 mb-2">@L["AnomaliesByDeviceHeading"]</h5>
    @if (_report.AnomaliesByDevice.Count == 0)
    {
        <span>@L["NoAnomaliesFound"]</span>
    }
    else
    {
        @foreach (var deviceFindings in _report.AnomaliesByDevice)
        {
            <h6>@deviceFindings.DeviceName</h6>
            <SfGrid TValue="SignalAnomalyReport.SignalAnomaly" DataSource="@deviceFindings.Anomalies" AllowPaging="true" AllowSorting="true" AllowResizing="true">
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(SignalAnomalyReport.SignalAnomaly.OccurredAtUtc)" HeaderText="@L["ColOccurredAt"]" MinWidth="100">
                        <Template>
                            <LocalTimeText Value="@((context as SignalAnomalyReport.SignalAnomaly)!.OccurredAtUtc)" />
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SignalAnomalyReport.SignalAnomaly.AnomalyType)" HeaderText="@L["ColAnomalyType"]" MinWidth="100" />
                    <GridColumn HeaderText="@L["ColDescription"]" MinWidth="100">
                        <Template>
                            @{
                                var anomaly = (SignalAnomalyReport.SignalAnomaly)context;
                                @(anomaly.Description ?? L["NotAvailable"].Value)
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColRssi"]" MinWidth="100">
                        <Template>
                            @{
                                var anomaly = (SignalAnomalyReport.SignalAnomaly)context;
                                @(anomaly.RssiValue?.ToString() ?? L["NotAvailable"].Value)
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        }
    }

    <h5 class="mt-4 mb-2">@L["JammingSummaryHeading"]</h5>
    @if (_report.JammingByDevice.Count == 0)
    {
        <span>@L["NoJammingFound"]</span>
    }
    else
    {
        <SfGrid TValue="SignalAnomalyReport.JammingSummaryEntry" DataSource="@_report.JammingByDevice" AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowResizing="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
            <GridPageSettings PageSize="20"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="@nameof(SignalAnomalyReport.JammingSummaryEntry.DeviceName)" HeaderText="@L["ColDevice"]" MinWidth="100" />
                <GridColumn Field="@nameof(SignalAnomalyReport.JammingSummaryEntry.IncidentCount)" HeaderText="@L["ColIncidentCount"]" MinWidth="100" />
                <GridColumn Field="@nameof(SignalAnomalyReport.JammingSummaryEntry.TotalJammedDurationMinutes)" HeaderText="@L["ColTotalJammedMin"]" MinWidth="100" />
                <GridColumn Field="@nameof(SignalAnomalyReport.JammingSummaryEntry.AverageDegradationDb)" HeaderText="@L["ColAvgDegradation"]" MinWidth="100" />
                <GridColumn Field="@nameof(SignalAnomalyReport.JammingSummaryEntry.MaxDegradationDb)" HeaderText="@L["ColMaxDegradation"]" MinWidth="100" />
                <GridColumn HeaderText="@L["ColFirstIncident"]" MinWidth="100">
                    <Template>
                        <LocalTimeText Value="@((context as SignalAnomalyReport.JammingSummaryEntry)!.FirstIncidentUtc)" Fallback="@L["NotAvailable"].Value" />
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="@L["ColLastIncident"]" MinWidth="100">
                    <Template>
                        <LocalTimeText Value="@((context as SignalAnomalyReport.JammingSummaryEntry)!.LastIncidentUtc)" Fallback="@L["NotAvailable"].Value" />
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }
}

@code {
    [Parameter]
    public ForensicScope Scope { get; set; } = new ForensicScope(new List<Guid>(), DateTime.UtcNow.AddDays(-90), DateTime.UtcNow, null);

    [Parameter]
    public IReadOnlyList<VideoForensics.Data.Common.Entities.Device> Devices { get; set; } = new List<VideoForensics.Data.Common.Entities.Device>();

    private bool _isLoading = true;
    private string? _error;
    private SignalAnomalyReport? _report;
    private ForensicScope _lastLoadedScope = new(new List<Guid>(), DateTime.MinValue, DateTime.MinValue, null);

    protected override async Task OnParametersSetAsync()
    {
        // Only reload if scope actually changed
        if (_lastLoadedScope.Equals(Scope))
        {
            return;
        }

        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        _isLoading = true;
        _error = null;

        try
        {
            // All devices is one server call; each explicit device is requested and the results are merged.
            if (Scope.IncludesAllDevices)
            {
                _report = await ReportGenerationService.BuildSignalAnomalyReportAsync(null, Scope.FromUtc, Scope.ToUtc, CancellationToken.None);
            }
            else
            {
                var reports = new List<SignalAnomalyReport>();
                foreach (var deviceId in Scope.DeviceIds)
                {
                    reports.Add(await ReportGenerationService.BuildSignalAnomalyReportAsync(deviceId, Scope.FromUtc, Scope.ToUtc, CancellationToken.None));
                }

                _report = reports.Count == 0 ? null : AnalysisReportMerge.Merge(reports);
            }

            _lastLoadedScope = Scope;
        }
        catch (Exception ex)
        {
            _error = $"Failed to load report: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
