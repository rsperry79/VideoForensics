@using VideoForensics.Client.Core.Tools
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Services.Scope
@inject JammingToolsOrchestrator JammingTools
@inject PairedSessionState SessionState
@inject IStringLocalizer<JammingPanel> L

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_error != null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (!_readyForAnalysis)
{
    <div class="alert alert-info">
        @L["SelectDevice"]
    </div>
}
else
{
    @* Jamming is per device. The panel analyzes each scoped device and shows one combined list, tagged by device. *@
    @foreach (var failure in _failures)
    {
        <div class="alert alert-warning">@failure</div>
    }

    <span><strong>@L["JammingSummary", _incidents.Count, _analyzedCount]</strong></span>

    @if (_incidents.Count > 0)
    {
        <SfGrid TValue="JammingIncidentRecord" DataSource="@_incidents" AllowSorting="true" AllowPaging="true" AllowFiltering="true" AllowResizing="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
            <GridPageSettings PageSize="20"></GridPageSettings>
            <GridEvents TValue="JammingIncidentRecord" RowSelected="OnIncidentRowSelected"></GridEvents>
            <GridColumns>
                <GridColumn HeaderText="@L["ColDevice"]" MinWidth="100">
                    <Template>
                        @{
                            var incident = (JammingIncidentRecord)context;
                            @(_deviceNames.GetValueOrDefault(incident.DeviceId, incident.DeviceId.ToString("D")[..8]))
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(JammingIncidentRecord.StartUtc)" HeaderText="@L["ColStart"]" MinWidth="100">
                    <Template>
                        <LocalTimeText Value="@((context as JammingIncidentRecord)!.StartUtc)" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(JammingIncidentRecord.EndUtc)" HeaderText="@L["ColEnd"]" MinWidth="100">
                    <Template>
                        <LocalTimeText Value="@((context as JammingIncidentRecord)!.EndUtc)" />
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(JammingIncidentRecord.AffectedEventCount)" HeaderText="@L["ColAffectedEvents"]" MinWidth="100" />
                <GridColumn HeaderText="@L["ColAvgDegradation"]" MinWidth="100">
                    <Template>
                        @{
                            var incident = (JammingIncidentRecord)context;
                            @(incident.AverageDegradationDb.ToString("F1"))
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="@nameof(JammingIncidentRecord.Confidence)" HeaderText="@L["ColConfidence"]" MinWidth="100" />
                <GridColumn Field="@nameof(JammingIncidentRecord.Source)" HeaderText="@L["ColSource"]" MinWidth="100" />
                <GridColumn Field="@nameof(JammingIncidentRecord.Notes)" HeaderText="@L["ColNotes"]" MinWidth="100" />
            </GridColumns>
        </SfGrid>

        @if (_selectedIncidentId is { } selectedIncidentId)
        {
            <JammingNotes JammingIncidentId="@selectedIncidentId" CanAdd="@_canAdd" IsOpen="@true" />
        }
    }

    <h5 class="mt-4 mb-2">@L["RecordManualIncident"]</h5>
    <div class="d-flex flex-column gap-2">
        <div>
            <label>@L["RecordDevice"]</label>
            <SfDropDownList TValue="string" TItem="KeyValuePair<string, string>" @bind-Value="_recordDeviceValue" DataSource="@_recordDeviceOptions">
                <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
            </SfDropDownList>
        </div>
        <div>
            <label for="startUtc">@L["LabelStartUtc"]</label>
            <SfDateTimePicker TValue="DateTime" @bind-Value="_manualStartUtc" />
        </div>
        <div>
            <label for="endUtc">@L["LabelEndUtc"]</label>
            <SfDateTimePicker TValue="DateTime" @bind-Value="_manualEndUtc" />
        </div>
        <div>
            <label>@L["LabelAffectedEventCount"]</label>
            <SfNumericTextBox TValue="int" @bind-Value="_manualAffectedEventCount" />
        </div>
        <div>
            <label>@L["LabelAvgDegradation"]</label>
            <SfNumericTextBox TValue="double" @bind-Value="_manualAverageDegradationDb" Step="0.1" Format="N1" />
        </div>
        <SfDropDownList TValue="JammingConfidenceLevel" TItem="JammingConfidenceLevel" @bind-Value="_manualConfidence" DataSource="@(Enum.GetValues<JammingConfidenceLevel>().ToList())" />
        <SfButton Content="@L["RecordIncident"]" OnClick="RecordIncidentAsync" CssClass="e-primary" Disabled="@_recording" />

        @if (!string.IsNullOrEmpty(_recordMessage))
        {
            <div class="alert @(_recordSuccess == true ? "alert-success" : "alert-danger")">@_recordMessage</div>
        }
    </div>
}

@code {
    [Parameter]
    public ForensicScope Scope { get; set; } = new ForensicScope(new List<Guid>(), DateTime.UtcNow.AddDays(-90), DateTime.UtcNow, null);

    [Parameter]
    public IReadOnlyList<VideoForensics.Data.Common.Entities.Device> Devices { get; set; } = new List<VideoForensics.Data.Common.Entities.Device>();

    private bool _isLoading = true;
    private int _loadVersion;
    private string? _error;
    private bool _readyForAnalysis;
    private int _analyzedCount;
    private readonly List<string> _failures = new();
    private List<JammingIncidentRecord> _incidents = new();
    private Dictionary<Guid, string> _deviceNames = new();
    private ForensicScope _lastLoadedScope = new(new List<Guid>(), DateTime.MinValue, DateTime.MinValue, null);

    private string _recordDeviceValue = string.Empty;
    private DateTime _manualStartUtc = DateTime.UtcNow.AddHours(-1);
    private DateTime _manualEndUtc = DateTime.UtcNow;
    private int _manualAffectedEventCount = 1;
    private double _manualAverageDegradationDb = 10;
    private JammingConfidenceLevel _manualConfidence = JammingConfidenceLevel.Low;
    private bool _recording;
    private string? _recordMessage;
    private bool? _recordSuccess;

    /// <summary>The scoped devices to analyze: the scope's explicit list, or every device when none is listed.</summary>
    private IReadOnlyList<Guid> TargetDeviceIds =>
        Scope.IncludesAllDevices
            ? Devices.Select(d => d.Id).ToList()
            : Scope.DeviceIds.ToList();

    private IEnumerable<KeyValuePair<string, string>> _recordDeviceOptions =>
        TargetDeviceIds.Select(id => new KeyValuePair<string, string>(id.ToString(), NameOf(id)));

    private string NameOf(Guid deviceId) => _deviceNames.GetValueOrDefault(deviceId, deviceId.ToString("D")[..8]);

    /// <summary>The incident whose notes thread is open: the grid row the operator selected, or null for none.</summary>
    private Guid? _selectedIncidentId;

    /// <summary>The signed-in operator's role, or null when it is unknown or not a valid role.</summary>
    private OperatorRole? Role => SessionState.Role is not null && Enum.TryParse<OperatorRole>(SessionState.Role, out OperatorRole role) ? role : null;

    /// <summary>True when the operator holds the Review role or higher, so may record incidents and add notes.</summary>
    private bool _canAdd => Role is { } role && role >= OperatorRole.Review;

    protected override async Task OnInitializedAsync()
    {
        // The role comes from the paired session, which loads on first use; the other review panels do the same.
        await SessionState.EnsureLoadedAsync();
    }

    /// <summary>Opens the notes thread of the incident the operator selected in the grid.</summary>
    private void OnIncidentRowSelected(RowSelectEventArgs<JammingIncidentRecord> args)
    {
        _selectedIncidentId = args.Data?.Id;
    }

    protected override async Task OnParametersSetAsync()
    {
        // Only reload if scope actually changed
        if (_lastLoadedScope.Equals(Scope))
        {
            return;
        }

        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        // Each device is awaited in turn; a newer load (new scope or recorded incident) supersedes this one.
        int version = ++_loadVersion;
        _isLoading = true;
        _error = null;
        _readyForAnalysis = false;
        _analyzedCount = 0;
        _failures.Clear();
        _incidents = new List<JammingIncidentRecord>();
        _selectedIncidentId = null;

        try
        {
            _deviceNames = Devices.ToDictionary(d => d.Id, d => d.Name ?? d.Id.ToString("D")[..8]);
            var targets = TargetDeviceIds;
            if (targets.Count == 0)
            {
                return;
            }

            _readyForAnalysis = true;
            if (!targets.Any(t => t.ToString() == _recordDeviceValue))
            {
                _recordDeviceValue = targets[0].ToString();
            }

            var incidents = new List<JammingIncidentRecord>();
            foreach (var deviceId in targets)
            {
                var report = await JammingTools.AnalyzeJammingAsync(deviceId, Scope.FromUtc, Scope.ToUtc, CancellationToken.None);
                if (version != _loadVersion)
                {
                    return;
                }

                if (!report.Success)
                {
                    _failures.Add(L["DeviceAnalysisFailed", NameOf(deviceId), report.ErrorMessage ?? L["AnalysisFailed"].Value].Value);
                    continue;
                }

                _analyzedCount++;
                incidents.AddRange(report.Incidents);
            }

            if (_analyzedCount == 0)
            {
                _error = _failures.Count > 0 ? _failures[0] : L["AnalysisFailed"].Value;
            }

            _incidents = incidents.OrderByDescending(i => i.StartUtc).ToList();
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            if (version == _loadVersion)
            {
                _error = $"Failed to load jamming analysis: {ex.Message}";
            }
        }
        finally
        {
            if (version == _loadVersion)
            {
                _lastLoadedScope = Scope;
                _isLoading = false;
            }
        }
    }

    private async Task RecordIncidentAsync()
    {
        if (!Guid.TryParse(_recordDeviceValue, out var deviceId) || !TargetDeviceIds.Contains(deviceId))
        {
            _recordMessage = L["InvalidDeviceSelection"];
            _recordSuccess = false;
            return;
        }

        _recording = true;
        _recordMessage = null;
        _recordSuccess = null;

        try
        {
            var (success, message, _) = await JammingTools.RecordJammingIncidentAsync(
                deviceId,
                _manualStartUtc,
                _manualEndUtc,
                _manualAffectedEventCount,
                _manualAverageDegradationDb,
                _manualConfidence,
                null,
                CancellationToken.None);

            _recordSuccess = success;
            _recordMessage = message;

            if (success)
            {
                // The recorded incident belongs to one device; reload every device so the combined list stays whole.
                _lastLoadedScope = new ForensicScope(new List<Guid>(), DateTime.MinValue, DateTime.MinValue, null);
                await LoadReportAsync();
            }
        }
        finally
        {
            _recording = false;
        }
    }
}
