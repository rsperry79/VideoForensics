@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Components.Notes
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Services.Evidence
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@inject ICaseNoteRepository CaseNoteRepository
@inject PairedSessionState SessionState
@inject IStringLocalizer<CaseNotes> L

<NotesPanel LoadNotes="@_loadNotes"
            AddNote="@_addNote"
            AddErrorText="@DescribeAddError"
            CanAdd="@CanAdd"
            IsOpen="@IsOpen" />

@code {
    /// <summary>The case whose notes are listed and to which a note is added.</summary>
    [Parameter, EditorRequired]
    public Guid CaseId { get; set; }

    /// <summary>True when the signed-in operator may add notes. The case page computes this from the Review role.</summary>
    [Parameter]
    public bool CanAdd { get; set; }

    /// <summary>False for a closed case: the notes are shown, but no add form is.</summary>
    [Parameter]
    public bool IsOpen { get; set; }

    private Guid? _boundCaseId;
    private Func<CancellationToken, Task<IReadOnlyList<NoteItem>>> _loadNotes = _ => Task.FromResult<IReadOnlyList<NoteItem>>([]);
    private Func<string, CancellationToken, Task> _addNote = (_, _) => Task.CompletedTask;

    protected override void OnParametersSet()
    {
        // The delegates are rebuilt only when the case changes, so the panel does not reload on every render.
        if (_boundCaseId == CaseId)
        {
            return;
        }

        _boundCaseId = CaseId;
        Guid caseId = CaseId;
        _loadNotes = async ct => (await CaseNoteRepository.ListForCaseAsync(caseId, ct))
            .Select(n => new NoteItem(n.Id, n.AddedBy, n.AddedAtUtc, n.Body))
            .ToList();
        _addNote = AddNoteAsync;
    }

    /// <summary>Sends the trimmed body with the signed-in operator id. A missing sign-in throws, and the panel shows its sign-in text.</summary>
    private Task AddNoteAsync(string body, CancellationToken ct)
    {
        string? actor = EvidenceActions.ResolveOperatorActor(SessionState.OperatorId);
        if (actor is null)
        {
            throw new UnauthorizedAccessException("No operator is signed in.");
        }

        return CaseNoteRepository.AddAsync(CaseId, body.Trim(), actor, ct);
    }

    /// <summary>The one case-specific failure: the case no longer exists. Other failures use the panel's text.</summary>
    private string? DescribeAddError(Exception ex)
    {
        return ex is KeyNotFoundException ? L["CaseNotesNotFound"].Value : null;
    }
}
