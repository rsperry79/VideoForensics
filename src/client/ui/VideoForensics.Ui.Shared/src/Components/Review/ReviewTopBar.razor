@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Pages
@using VideoForensics.Client.Ui.Shared.Components.Review
@using VideoForensics.Client.Ui.Shared.Services.Cases
@using VideoForensics.Client.Ui.Shared.Services.Review
@using VideoForensics.Client.Ui.Shared.Services.Scope
@implements IDisposable
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ReviewCaseMode CaseMode
@inject ReviewPopupState Popups
@inject IStringLocalizer<ReviewPage> L

@if (CaseMode.Active)
{
    <div class="alert alert-info d-flex flex-wrap align-items-center gap-2 w-100 py-2 mb-2" role="status" data-testid="review-case-banner">
        <span>@L["CaseModeBanner", CaseMode.CaseName ?? string.Empty]</span>
        @if (CaseMode.Truncated)
        {
            <span class="small" data-testid="review-case-truncated">@L["CaseModeTruncated", ReviewCaseMode.MaxItemsPerKind]</span>
        }
        <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-testid="review-case-leave" @onclick="OnLeaveCase">@L["CaseModeLeave"]</button>
    </div>
}

<div class="review-top-bar d-flex flex-wrap align-items-center gap-2 mb-3" role="toolbar" aria-label="@L["PageTitle"]" data-testid="review-top-bar" @onkeydown="OnTopBarKeyDown">
    @if (Popups.Open is not null)
    {
        @* Transparent full-page backdrop below the popups: a click outside any popup lands here and closes it. *@
        <div class="review-popup-backdrop" data-testid="review-popup-backdrop" @onclick="ClosePopups"></div>
    }

    <div class="d-flex align-items-center gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="review-back" @onclick="OnBackAsync">@L["Back"]</button>
    </div>

    <div class="d-flex align-items-center gap-2 flex-wrap">
        <select class="form-select form-select-sm" style="width: auto;" data-testid="review-range" aria-label="@L["RangeLabel"]" @onchange="OnRangeChanged">
            <option value="hour" selected="@(CurrentPreset == RangePreset.LastHour)">@L["RangeLastHour"]</option>
            <option value="day" selected="@(CurrentPreset == RangePreset.Last24Hours)">@L["RangeLast24Hours"]</option>
            <option value="week" selected="@(CurrentPreset == RangePreset.Last7Days)">@L["RangeLast7Days"]</option>
        </select>

        <ReviewPendingTags DeviceNames="DeviceNames" />

        <ReviewActionsMenu State="State" />
    </div>
</div>

@code {
    /// <summary>The review state the bar reads and writes.</summary>
    [Parameter, EditorRequired]
    public ReviewPageState State { get; set; } = default!;

    /// <summary>Display name for each camera id.</summary>
    [Parameter]
    public IReadOnlyDictionary<Guid, string> DeviceNames { get; set; } = new Dictionary<Guid, string>();

    /// <summary>The clock the range presets end at. Tests pass a fixed clock; the page uses the system clock.</summary>
    [Parameter]
    public Func<DateTime> UtcNow { get; set; } = static () => DateTime.UtcNow;

    private enum RangePreset
    {
        LastHour,
        Last24Hours,
        Last7Days,
    }

    /// <summary>The preset the current window matches. A window that matches none reads as the 24-hour default.</summary>
    private RangePreset CurrentPreset
    {
        get
        {
            TimeSpan span = State.ToUtc - State.FromUtc;
            TimeSpan tolerance = TimeSpan.FromMinutes(1);
            if (Math.Abs((span - TimeSpan.FromHours(1)).TotalSeconds) < tolerance.TotalSeconds)
            {
                return RangePreset.LastHour;
            }

            return Math.Abs((span - TimeSpan.FromDays(7)).TotalSeconds) < tolerance.TotalSeconds
                ? RangePreset.Last7Days
                : RangePreset.Last24Hours;
        }
    }

    protected override void OnInitialized()
    {
        // A popup left open by an earlier visit to this page must not reopen with the bar.
        Popups.Close();
        State.OnChange += OnStateChanged;
        CaseMode.OnChange += OnStateChanged;
        Popups.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    /// <summary>Closes whichever popup is open. Used by the backdrop click.</summary>
    private void ClosePopups()
    {
        Popups.Close();
    }

    /// <summary>Escape closes the open popup. The key event bubbles up from whichever control has focus inside the bar.</summary>
    private void OnTopBarKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            Popups.Close();
        }
    }

    /// <summary>
    /// Leaves the case view and navigates to the same route without the case parameter. The other query
    /// parameters stay as they are.
    /// </summary>
    private void OnLeaveCase()
    {
        CaseMode.Exit();
        NavigationManager.NavigateTo(ReviewUrl.WithoutCaseView(NavigationManager.Uri));
    }

    /// <summary>
    /// Goes back in browser history. This page is /media itself, so navigating there would not leave it.
    /// A dead circuit or an unavailable JS runtime is ignored: Back then simply does nothing.
    /// </summary>
    private async Task OnBackAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("history.back");
        }
        catch (Microsoft.JSInterop.JSException)
        {
            // The browser refused the call; leave the page where it is.
        }
        catch (Microsoft.JSInterop.JSDisconnectedException)
        {
            // The circuit closed before the call ran.
        }
    }

    private void OnRangeChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        TimeSpan span = PresetSpan(args.Value?.ToString());
        DateTime now = UtcNow();
        State.SetRange(now - span, now);
    }

    private static TimeSpan PresetSpan(string? value)
    {
        return value switch
        {
            "hour" => TimeSpan.FromHours(1),
            "week" => TimeSpan.FromDays(7),
            _ => TimeSpan.FromHours(24),
        };
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
        CaseMode.OnChange -= OnStateChanged;
        Popups.OnChange -= OnStateChanged;
    }
}
