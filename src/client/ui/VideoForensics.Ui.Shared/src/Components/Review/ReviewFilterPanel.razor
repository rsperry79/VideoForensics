@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Common.Viewer
@using VideoForensics.Client.Ui.Shared.Pages
@using VideoForensics.Client.Ui.Shared.Services.Review
@using VideoForensics.Client.Ui.Shared.Services.Scope
@using VideoForensics.Data.Common.Entities
@implements IDisposable
@inject IStringLocalizer<ReviewPage> L

<div class="review-filter-panel p-2" aria-label="@L["FilterTitle"]" data-testid="review-filter-panel">
    <div class="small fw-semibold mb-2">@L["FilterTitle"]</div>

    <label class="form-label small mb-1" for="review-filter-provider-select">@L["FilterProvider"]</label>
    <select id="review-filter-provider-select" class="form-select form-select-sm mb-2" data-testid="review-filter-provider" @onchange="OnProviderChanged">
        <option value="" selected="@(_provider is null)">@L["FilterAllProviders"]</option>
        @foreach (string provider in ProviderNames)
        {
            <option value="@provider" selected="@(_provider == provider)">@provider</option>
        }
    </select>

    <label class="form-label small mb-1" for="review-filter-account-select">@L["FilterAccount"]</label>
    <select id="review-filter-account-select" class="form-select form-select-sm mb-2" data-testid="review-filter-account" @onchange="OnAccountChanged">
        <option value="" selected="@(_account is null)">@L["FilterAllAccounts"]</option>
        @foreach (ProviderAccount account in AccountOptions)
        {
            <option value="@account.Id" selected="@(_account == account.Id)">@AccountName(account)</option>
        }
    </select>

    <ReviewCameraPicker Devices="VisibleIds" DeviceNames="DeviceNames" Selected="_cameras" SelectedChanged="OnCamerasChanged" />

    <small class="d-block my-2" data-testid="review-filter-count">@L["FilterMatchingCameras", MatchingCount]</small>

    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-sm btn-outline-secondary" data-testid="review-filter-reset" @onclick="OnReset">@L["Reset"]</button>
        <button type="button" class="btn btn-sm btn-primary" data-testid="review-filter-apply" disabled="@ApplyDisabled" @onclick="OnApply">@L["Apply"]</button>
    </div>
</div>

@code {
    /// <summary>The review state the panel writes to on Apply.</summary>
    [Parameter, EditorRequired]
    public ReviewPageState State { get; set; } = default!;

    /// <summary>Every camera the page knows about, before any filter.</summary>
    [Parameter]
    public IReadOnlyList<Guid> AllDeviceIds { get; set; } = [];

    /// <summary>Accounts, provider names and device ownership. Null when the ownership load failed, so every camera counts as visible.</summary>
    [Parameter]
    public DeviceOwnershipSnapshot? Ownership { get; set; }

    /// <summary>Display name for each camera id.</summary>
    [Parameter]
    public IReadOnlyDictionary<Guid, string> DeviceNames { get; set; } = new Dictionary<Guid, string>();

    /// <summary>Raised after Apply. Optional: the panel is inline in the right sidebar and has nothing to close.</summary>
    [Parameter]
    public EventCallback OnClose { get; set; }

    // The choices being edited. They reach the review state only when the user presses Apply.
    private string? _provider;
    private Guid? _account;
    private HashSet<Guid> _cameras = [];

    private IReadOnlyList<string> ProviderNames => Ownership?.ProviderNames ?? Array.Empty<string>();

    private IReadOnlyList<ProviderAccount> Accounts => Ownership?.Accounts ?? Array.Empty<ProviderAccount>();

    private IEnumerable<ProviderAccount> AccountOptions => ScopeDeviceFilter.AccountsForProvider(Accounts, _provider);

    // The cameras that follow the pending provider and account choices, in display order.
    private IReadOnlyList<Guid> VisibleIds => ReviewDeviceFilter.VisibleDeviceIds(AllDeviceIds, Ownership?.Ownership, _provider, _account);

    private int MatchingCount => VisibleIds.Count;

    // Only visible cameras count: a pick the filters hide is dropped on Apply.
    private int PickedCount => VisibleIds.Count(_cameras.Contains);

    private bool ApplyDisabled => PickedCount == 0 || PickedCount > CameraSync.MaxTiles;

    // The state filters the edit fields were last seeded from. A different value on a state change means something
    // else (the URL, a restore) set the filters, so the edit fields follow it.
    private (string? Provider, Guid? Account) _seenFilters;
    private IReadOnlyList<Guid> _seenCameras = [];

    protected override void OnInitialized()
    {
        SeedFromState();
        State.OnChange += OnStateChanged;
    }

    private void SeedFromState()
    {
        _provider = State.ProviderFilter;
        _account = State.AccountFilter;
        _seenFilters = (_provider, _account);
        _cameras = State.CameraIds.ToHashSet();
        _seenCameras = State.CameraIds.ToList();
    }

    private void OnStateChanged()
    {
        if ((State.ProviderFilter, State.AccountFilter) == _seenFilters && State.CameraIds.SequenceEqual(_seenCameras))
        {
            return;
        }

        SeedFromState();
        _ = InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }

    private string AccountName(ProviderAccount account)
    {
        return Ownership?.AccountNames.GetValueOrDefault(account.Id, account.ProviderName) ?? account.ProviderName;
    }

    private void OnProviderChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        // The rule clears the account when the newly picked provider does not own it.
        (_provider, _account) = ScopeRailRules.ApplyProviderPick(Accounts, _account, e.Value?.ToString());
        ResetCameras();
    }

    private void OnAccountChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _account = ScopeRailRules.ParseAccountPick(e.Value?.ToString());
        ResetCameras();
    }

    private void OnCamerasChanged(HashSet<Guid> cameras)
    {
        _cameras = cameras;
    }

    // The default pick: every visible camera, up to the tile limit.
    private void ResetCameras()
    {
        _cameras = VisibleIds.Take(CameraSync.MaxTiles).ToHashSet();
    }

    private void OnReset()
    {
        _provider = null;
        _account = null;
        ResetCameras();
    }

    private async Task OnApply()
    {
        if (ApplyDisabled)
        {
            return;
        }

        // Taken before SetFilters, which can change the state cameras and re-seed the pending set.
        List<Guid> chosen = VisibleIds.Where(_cameras.Contains).Take(CameraSync.MaxTiles).ToList();
        State.SetFilters(_provider, _account);
        State.SetCameras(chosen);
        await OnClose.InvokeAsync();
    }
}
