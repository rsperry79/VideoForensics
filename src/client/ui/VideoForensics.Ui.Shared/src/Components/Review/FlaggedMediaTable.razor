@using VideoForensics.Core.Api.Contracts.Repositories
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@using Syncfusion.Blazor.Grids
@using VideoForensics.Client.Ui.Shared.Resources
@using VideoForensics.Client.Ui.Shared.Services.Time
@using VideoForensics.Core.Api.Contracts
@implements IDisposable
@inject IStringLocalizer<SharedResources> L
@inject IMediaFlagRepository MediaFlagRepository
@inject NavigationManager Navigation

<div class="flagged-media-table" data-testid="flagged-media-table" aria-label="@L["FlaggedMediaTableLabel"].Value">
    @if (_loaded && _rows.Count == 0)
    {
        <p class="text-muted small" data-testid="flagged-media-empty">@L["FlaggedMediaEmpty"].Value</p>
    }
    else
    {
        @if (_total > PageSize)
        {
            <p class="small mb-2" data-testid="flagged-media-count">@L["FlaggedMediaShowingCount", PageSize, _total].Value</p>
        }

        <SfGrid TValue="MediaFlagDto" DataSource="@_rows" AllowPaging="true" AllowResizing="true">
            <GridPageSettings PageSize="20"></GridPageSettings>
            <GridEvents TValue="MediaFlagDto" RowSelected="OnRowSelected"></GridEvents>
            <GridColumns>
                <GridColumn HeaderText="@L["FlaggedMediaColRaised"].Value" Width="170">
                    <Template>
                        @{
                            MediaFlagDto flag = (MediaFlagDto)context;
                        }
                        <span>@Zone.Format(flag.RaisedAtUtc, "yyyy-MM-dd HH:mm")</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="@L["FlaggedMediaColType"].Value" Width="180">
                    <Template>
                        @{
                            MediaFlagDto typeFlag = (MediaFlagDto)context;
                        }
                        <span class="d-block" data-testid="flagged-media-event">@EventName(typeFlag.EventType)</span>
                        <span class="d-block small text-muted" data-testid="flagged-media-flag-type">@TypeName(typeFlag.FlagType)</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="@L["FlaggedMediaColDev"].Value" Width="90">
                    <Template>
                        @{
                            MediaFlagDto devFlag = (MediaFlagDto)context;
                        }
                        <span data-testid="flagged-media-dev" title="@L["FlaggedMediaDevTooltip"].Value">@DevText(devFlag.DeviationSigma)</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="@L["FlaggedMediaColCamera"].Value" Width="180">
                    <Template>
                        <span>@CameraName(((MediaFlagDto)context).DeviceId)</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="@L["FlaggedMediaColWindow"].Value" Width="260">
                    <Template>
                        @{
                            MediaFlagDto windowFlag = (MediaFlagDto)context;
                        }
                        <span>@L["FlaggedMediaWindowRange", Zone.Format(windowFlag.WindowStartUtc, "yyyy-MM-dd HH:mm"), Zone.Format(windowFlag.WindowEndUtc, "yyyy-MM-dd HH:mm")].Value</span>
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="@L["FlaggedMediaColStatus"].Value" Width="130">
                    <Template>
                        <span>@StatusName(((MediaFlagDto)context).Status)</span>
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }
</div>

@code {
    /// <summary>The number of flags loaded at once. The repository lists newest first, so these are the newest flags.</summary>
    private const int PageSize = 200;

    /// <summary>Route prefix of the bit rate review page (<c>@page "/bitrate-history/review/{FlagId:guid}"</c>). The flag id follows it.</summary>
    private const string BitrateReviewPathPrefix = "/bitrate-history/review/";

    /// <summary>Route prefix of the RSSI review page (<c>@page "/signal-history/review/{FlagId:guid}"</c>). The flag id follows it.</summary>
    private const string RssiReviewPathPrefix = "/signal-history/review/";

    /// <summary>
    /// The review page for a flag. BitrateCollapse maps to the bit rate review page and
    /// RssiDeviation to the RSSI review page. Other flag types have no review page and return null.
    /// </summary>
    /// <param name="flag">The flag to open.</param>
    /// <returns>The relative review path for the flag, or null when its type has no review page.</returns>
    public static string? ReviewPath(MediaFlagDto flag)
    {
        return flag.FlagType switch
        {
            "BitrateCollapse" => BitrateReviewPathPrefix + flag.Id,
            "RssiDeviation" => RssiReviewPathPrefix + flag.Id,
            _ => null,
        };
    }

    /// <summary>Opens the review page for the clicked row. A flag type with no review page leaves the list where it is.</summary>
    /// <param name="flag">The flag on the clicked row.</param>
    public void OpenFlag(MediaFlagDto flag)
    {
        string? path = ReviewPath(flag);
        if (path is not null)
        {
            Navigation.NavigateTo(path);
        }
    }

    private void OnRowSelected(RowSelectEventArgs<MediaFlagDto> args)
    {
        OpenFlag(args.Data);
    }

    /// <summary>The flag types to list. Each report page passes only its own type.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyCollection<string> Types { get; set; } = [];

    /// <summary>The cameras to list. Null means every camera.</summary>
    [Parameter]
    public IReadOnlyCollection<Guid>? DeviceIds { get; set; }

    /// <summary>Inclusive lower bound on the flag window start.</summary>
    [Parameter]
    public DateTime? FromUtc { get; set; }

    /// <summary>Inclusive upper bound on the flag window start.</summary>
    [Parameter]
    public DateTime? ToUtc { get; set; }

    /// <summary>Camera names by device id. A device without a name shows the "Unknown camera" text.</summary>
    [Parameter]
    public IReadOnlyDictionary<Guid, string>? DeviceNames { get; set; }

    /// <summary>The signed-in user's zone. Until the browser's zone is known, UTC is used.</summary>
    [CascadingParameter]
    private UserTimeZone? UserTz { get; set; }

    private UserTimeZone Zone => UserTz ?? UserTimeZone.Unavailable;

    private List<MediaFlagDto> _rows = [];
    private int _total;
    private bool _loaded;
    private bool _loadedOnce;
    private HashSet<string> _loadedTypes = [];
    private HashSet<Guid>? _loadedDeviceIds;
    private DateTime? _loadedFromUtc;
    private DateTime? _loadedToUtc;
    private CancellationTokenSource? _loadCts;

    protected override async Task OnParametersSetAsync()
    {
        HashSet<string> types = [.. Types];
        HashSet<Guid>? deviceIds = DeviceIds is null ? null : [.. DeviceIds];
        if (_loadedOnce && types.SetEquals(_loadedTypes) && SameDevices(deviceIds) && FromUtc == _loadedFromUtc && ToUtc == _loadedToUtc)
        {
            return;
        }

        _loadedOnce = true;
        _loadedTypes = types;
        _loadedDeviceIds = deviceIds;
        _loadedFromUtc = FromUtc;
        _loadedToUtc = ToUtc;

        _loadCts?.Cancel();
        var cts = new CancellationTokenSource();
        _loadCts = cts;

        var filter = new MediaFlagFilterDto([.. Types], null, DeviceIds is null ? null : [.. DeviceIds], FromUtc, ToUtc);

        MediaFlagPageDto page;
        try
        {
            page = await MediaFlagRepository.ListPageAsync(filter, 0, PageSize, cts.Token);
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            // A newer filter replaced this load before it finished.
            return;
        }

        _rows = [.. page.Items];
        _total = page.TotalCount;
        _loaded = true;
    }

    private bool SameDevices(HashSet<Guid>? deviceIds)
    {
        if (deviceIds is null || _loadedDeviceIds is null)
        {
            return deviceIds is null && _loadedDeviceIds is null;
        }

        return deviceIds.SetEquals(_loadedDeviceIds);
    }

    private string TypeName(string type)
    {
        LocalizedString text = L[$"FlaggedMediaType_{type}"];
        return text.ResourceNotFound ? type.ToString() : text.Value;
    }

    /// <summary>The clip's event type, or the placeholder when the flag has no clip with an event (for example an RSSI flag).</summary>
    private string EventName(string? eventType)
    {
        return string.IsNullOrEmpty(eventType) ? L["FlaggedMediaNoEvent"].Value : eventType;
    }

    /// <summary>The deviation in standard deviations to one decimal, or the placeholder when the flag has no value.</summary>
    private string DevText(double? sigma)
    {
        return sigma is null
            ? L["FlaggedMediaDevEmpty"].Value
            : sigma.Value.ToString("F1", System.Globalization.CultureInfo.CurrentCulture);
    }

    private string StatusName(string status)
    {
        LocalizedString text = L[$"FlaggedMediaStatus_{status}"];
        return text.ResourceNotFound ? status.ToString() : text.Value;
    }

    private string CameraName(Guid deviceId)
    {
        return DeviceNames is not null && DeviceNames.TryGetValue(deviceId, out string? name)
            ? name
            : L["FlaggedMediaUnknownCamera"].Value;
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }
}
