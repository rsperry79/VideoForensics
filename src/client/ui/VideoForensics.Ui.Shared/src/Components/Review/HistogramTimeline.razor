@implements IAsyncDisposable
@using System.Globalization
@using Microsoft.Extensions.Localization
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using VideoForensics.Client.Ui.Shared.Components.Viewer
@using VideoForensics.Client.Ui.Shared.Resources
@using VideoForensics.Client.Ui.Shared.Services.Time
@using VideoForensics.Data.Common.Entities
@inject IStringLocalizer<SharedResources> L

<div class="histogram-timeline" data-testid="histogram-timeline">
    <div class="playback-timeline" data-testid="playback-timeline" role="group" aria-label="@L["PlaybackTimelineLabel"].Value">
        <div class="playback-timeline-transport">
            <SfButton CssClass="e-outline" Content="@(_playing ? L["PlaybackPause"].Value : L["PlaybackPlay"].Value)" data-testid="timeline-play" OnClick="TogglePlayAsync" />
            <SfButton CssClass="e-outline" Content="@L["PlaybackStepBack"].Value" data-testid="timeline-step-back" OnClick="StepBackAsync" />
            <SfButton CssClass="e-outline" Content="@L["PlaybackRate", Rate].Value" data-testid="timeline-rate" OnClick="CycleRateAsync" />
            @if (_nowSeconds is double)
            {
                <span class="playback-timeline-now" data-testid="timeline-now">@L["PlaybackNow", Zone.Format(NowUtc, "yyyy-MM-dd HH:mm:ss")].Value</span>
            }
        </div>
    </div>
    <div class="histogram-timeline-body">
        <div class="histogram-timeline-histogram" data-testid="histogram-timeline-histogram">
            @Histogram
        </div>
        <div class="playback-timeline-overlay">
            <div class="playback-timeline-track">
                <SfSlider TValue="double" Min="_minSeconds" Max="_maxSeconds" Step="1" Value="_position" Enabled="_maxSeconds > _minSeconds">
                    <SliderEvents TValue="double" ValueChange="OnScrubAsync" />
                </SfSlider>
            </div>
            <div class="playback-timeline-markers">
                @foreach (DateTime at in _markTimesInWindow)
                {
                    <span class="playback-timeline-mark" data-testid="timeline-mark" style="left: @MarkTimePercent(at).ToString(CultureInfo.InvariantCulture)%;"></span>
                }
                @foreach (MediaFlag flag in _markersInWindow)
                {
                    <button type="button"
                            class="playback-timeline-marker"
                            data-testid="timeline-marker"
                            style="left: @MarkerPercent(flag).ToString(CultureInfo.InvariantCulture)%;"
                            aria-label="@MarkerLabel(flag)"
                            title="@MarkerLabel(flag)"
                            @onclick="() => OnMarkerClick.InvokeAsync(flag)"></button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private static readonly double[] Rates = [1, 2, 4, 8];

    /// <summary>The player driven by the transport, scrub bar and, through the histogram, its playhead. This component owns no video element.</summary>
    [Parameter, EditorRequired]
    public MediaPlayer Player { get; set; } = default!;

    /// <summary>The start of the timeline window (UTC). The scrub bar's minimum.</summary>
    [Parameter, EditorRequired]
    public DateTime WindowStartUtc { get; set; }

    /// <summary>The end of the timeline window (UTC). The scrub bar's maximum.</summary>
    [Parameter, EditorRequired]
    public DateTime WindowEndUtc { get; set; }

    /// <summary>Flags to draw on the scrub bar. Flags whose window starts outside the timeline window are not drawn.</summary>
    [Parameter]
    public IReadOnlyCollection<MediaFlag> Markers { get; set; } = [];

    /// <summary>Moments to mark on the scrub bar, such as the seconds a bit rate dip starts. Times outside the window are not drawn.</summary>
    [Parameter]
    public IReadOnlyList<DateTime> MarkTimes { get; set; } = [];

    /// <summary>Raised when a flag marker is clicked.</summary>
    [Parameter]
    public EventCallback<MediaFlag> OnMarkerClick { get; set; }

    /// <summary>
    /// Raised when the speed button changes the playback rate (1, 2, 4 or 8). The host applies it to the player's
    /// <c>PlaybackRate</c> parameter, since this component cannot set a parameter on the player it is given.
    /// </summary>
    [Parameter]
    public EventCallback<double> OnRateChange { get; set; }

    /// <summary>The histogram to draw below the scrub timeline. Any chart can be fed here.</summary>
    [Parameter]
    public RenderFragment? Histogram { get; set; }

    /// <summary>The signed-in user's zone. Until the browser's zone is known, UTC is used.</summary>
    [CascadingParameter]
    private UserTimeZone? UserTz { get; set; }

    private UserTimeZone Zone => UserTz ?? UserTimeZone.Unavailable;

    private const double PollIntervalSeconds = 0.25;

    private int _rateIndex;
    private bool _playing;
    private double _minSeconds;
    private double _maxSeconds;
    private double _position;
    private double? _nowSeconds;
    private List<MediaFlag> _markersInWindow = [];
    private List<DateTime> _markTimesInWindow = [];
    private CancellationTokenSource? _pollCts;
    private Task? _pollTask;

    private double Rate => Rates[_rateIndex];

    private DateTime NowUtc => DateTime.UnixEpoch.AddSeconds(_nowSeconds ?? 0);

    protected override void OnInitialized()
    {
        _pollCts = new CancellationTokenSource();
        _pollTask = PollPositionAsync(_pollCts.Token);
    }

    protected override void OnParametersSet()
    {
        _minSeconds = SecondsSinceEpoch(WindowStartUtc);
        _maxSeconds = SecondsSinceEpoch(WindowEndUtc);
        _position = Math.Clamp(_position, _minSeconds, Math.Max(_minSeconds, _maxSeconds));
        _markTimesInWindow = MarkTimes
            .Where(at => at >= WindowStartUtc && at <= WindowEndUtc)
            .ToList();
        _markersInWindow = Markers
            .Where(flag => flag.WindowStartUtc >= WindowStartUtc && flag.WindowStartUtc <= WindowEndUtc)
            .OrderBy(flag => flag.WindowStartUtc)
            .ToList();
    }

    private async Task TogglePlayAsync()
    {
        await Player.TogglePlayAsync();
        _playing = !_playing;
    }

    private async Task StepBackAsync()
    {
        await Player.StepAsync(-10);
        _playing = false;
    }

    private async Task CycleRateAsync()
    {
        _rateIndex = (_rateIndex + 1) % Rates.Length;
        await OnRateChange.InvokeAsync(Rate);
    }

    private async Task OnScrubAsync(SliderChangeEventArgs<double> args)
    {
        _position = args.Value;
        await Player.SeekToUtcAsync(DateTime.UnixEpoch.AddSeconds(args.Value));
    }

    private double MarkTimePercent(DateTime at)
    {
        double span = _maxSeconds - _minSeconds;
        return span <= 0 ? 0 : (SecondsSinceEpoch(at) - _minSeconds) / span * 100;
    }

    private double MarkerPercent(MediaFlag flag)
    {
        double span = _maxSeconds - _minSeconds;
        return span <= 0 ? 0 : (SecondsSinceEpoch(flag.WindowStartUtc) - _minSeconds) / span * 100;
    }

    private string MarkerLabel(MediaFlag flag)
    {
        LocalizedString typeName = L[$"FlaggedMediaType_{flag.FlagType}"];
        string name = typeName.ResourceNotFound ? flag.FlagType.ToString() : typeName.Value;
        return L["PlaybackMarker", name, Zone.Format(flag.WindowStartUtc, "yyyy-MM-dd HH:mm:ss")].Value;
    }

    private async Task PollPositionAsync(CancellationToken cancellationToken)
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(PollIntervalSeconds));
        try
        {
            while (await timer.WaitForNextTickAsync(cancellationToken))
            {
                double? seconds = await Player.GetPlaybackUtcSecondsAsync();
                await InvokeAsync(() =>
                {
                    _nowSeconds = seconds;
                    if (seconds is double value)
                    {
                        _position = Math.Clamp(value, _minSeconds, Math.Max(_minSeconds, _maxSeconds));
                    }

                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // The component is disposing; the loop ends.
        }
    }

    private static double SecondsSinceEpoch(DateTime utc) => (utc - DateTime.UnixEpoch).TotalSeconds;

    public async ValueTask DisposeAsync()
    {
        if (_pollCts is null)
        {
            return;
        }

        _pollCts.Cancel();
        if (_pollTask is not null)
        {
            try
            {
                await _pollTask;
            }
            catch (OperationCanceledException)
            {
                // Expected when the poll loop is cancelled.
            }
        }

        _pollCts.Dispose();
        _pollCts = null;
    }
}
