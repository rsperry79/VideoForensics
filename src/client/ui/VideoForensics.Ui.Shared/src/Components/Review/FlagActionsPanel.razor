@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using VideoForensics.Client.Ui.Shared.Components.Reasons
@using VideoForensics.Client.Ui.Shared.Pages
@using VideoForensics.Client.Ui.Shared.Resources
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Services.Evidence
@using VideoForensics.Client.Ui.Shared.Services.Time
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@implements IDisposable
@inject PairedSessionState SessionState
@inject IMediaFlagRepository MediaFlagRepository
@inject ICaseRepository CaseRepository
@inject IMediaItemRepository MediaItemRepository
@inject ISnapshotCaptureRepository SnapshotCaptureRepository
@inject IStringLocalizer<SharedResources> L
@inject IStringLocalizer<ReviewPage> ReviewL
@inject ILogger<FlagActionsPanel> Logger

<div class="flag-actions-panel" role="group" aria-label="@L["FlagActionsLabel"].Value" data-testid="flag-actions-panel">
    <div class="small fw-semibold mb-2">@L["FlagActionsLabel"]</div>

    <div class="small mb-1" data-testid="flag-actions-status">@L["FlagActionsStatus", StatusName()].Value</div>

    @if (Flag.ReviewedAtUtc is { } reviewedAt)
    {
        <div class="small text-muted mb-2" data-testid="flag-actions-reviewed-at">@L["FlagActionsReviewedAt", Zone.Format(reviewedAt, "yyyy-MM-dd HH:mm")].Value</div>
    }

    @if (RoleReason is { } roleReason)
    {
        <div class="small text-muted mb-2" data-testid="flag-actions-role-reason">@roleReason</div>
    }

    <div class="mb-2">
        <ReasonPicker TReason="MediaFlagDismissReason" OtherValue="MediaFlagDismissReason.Other" @bind-Value="_dismissReason" @bind-Note="_dismissNote" ValidityChanged="OnReasonValidityChanged" LabelText="@L["ReasonPickerLabel"].Value" />
    </div>

    <div class="d-flex justify-content-end gap-2">
        <SfButton CssClass="e-outline" Content="@L["FlagActionsKeep"].Value" data-testid="flag-keep" Disabled="@(!CanAct || _busy)" OnClick="OnKeepAsync" />
        <SfButton CssClass="e-danger" Content="@L["FlagActionsDismiss"].Value" data-testid="flag-dismiss" Disabled="@(!CanAct || _busy || !_reasonValid)" OnClick="OnDismissAsync" />
    </div>

    <FlagNotes FlagId="@Flag.Id" CanAdd="@(RoleReason is null)" IsOpen="@true" />

    @if (Flag.MediaItemId is not null)
    {
        <div class="flag-add-to-case mt-3" data-testid="flag-add-to-case-section">
            <div class="small fw-semibold mb-1">@L["FlagActionsAddToCase"]</div>

            @foreach (ForensicCase existing in _containing)
            {
                <div class="small text-muted mb-1" data-testid="flag-already-in-case">@L["FlagActionsAlreadyIn", existing.Title].Value</div>
            }

            <div class="d-flex gap-2 align-items-center">
                <select class="form-select form-select-sm" id="flag-add-case" data-testid="flag-add-to-case-picker" aria-label="@L["FlagActionsAddToCase"].Value" @onchange="OnCasePicked">
                    <option value="" selected="@(_pickedCaseId is null && !_creatingCase)">@L["FlagActionsPickCase"]</option>
                    <option value="@CreateCaseOption" selected="@_creatingCase">@L["FlagActionsCreateCase"]</option>
                    @foreach (ForensicCase openCase in _openCases)
                    {
                        <option value="@openCase.Id" selected="@(_pickedCaseId == openCase.Id)">@openCase.CaseNumber &middot; @openCase.Title</option>
                    }
                </select>
            </div>

            @if (_creatingCase)
            {
                <div class="flag-new-case mt-2" data-testid="flag-new-case-section">
                    <div class="mb-2">
                        <SfTextBox ID="flag-new-case-title" Placeholder="@L["FlagActionsCaseTitle"].Value" @bind-Value="_newCaseTitle" />
                    </div>
                </div>
            }

            <div class="d-flex gap-2 align-items-center mt-2">
                <SfButton CssClass="e-outline" Content="@L["FlagActionsAddToCase"].Value" data-testid="flag-add-to-case" Disabled="@(!CanAddToCase || _busy)" OnClick="OnAddToCaseAsync" />
            </div>

            @if (_notice is { } notice)
            {
                <div class="small mt-2" data-testid="flag-add-to-case-done">@notice</div>
            }
        </div>
    }
    else
    {
        <div class="flag-window mt-3" data-testid="flag-window-section">
            @if (_window is { } window)
            {
                <div class="small fw-semibold mb-1" data-testid="flag-window-counts">@L["FlagActionsWindowCounts", PendingClipCount, PendingSnapshotCount].Value</div>

                <div class="d-flex gap-2 align-items-center">
                    <select class="form-select form-select-sm" id="flag-window-case" data-testid="flag-window-case-picker" aria-label="@L["FlagActionsPickCase"].Value" @onchange="OnCasePicked">
                        <option value="" selected="@(_pickedCaseId is null && !_creatingCase)">@L["FlagActionsPickCase"]</option>
                        <option value="@CreateCaseOption" selected="@_creatingCase">@L["FlagActionsCreateCase"]</option>
                        @foreach (ForensicCase openCase in _openCases)
                        {
                            <option value="@openCase.Id" selected="@(_pickedCaseId == openCase.Id)">@openCase.CaseNumber &middot; @openCase.Title</option>
                        }
                    </select>
                </div>

                @if (_creatingCase)
                {
                    <div class="flag-new-case mt-2" data-testid="flag-new-case-section">
                        <div class="mb-2">
                            <SfTextBox ID="flag-new-case-title" Placeholder="@L["FlagActionsCaseTitle"].Value" @bind-Value="_newCaseTitle" />
                        </div>
                    </div>
                }

                <div class="d-flex gap-2 align-items-center mt-2">
                    <SfButton CssClass="e-outline" Content="@L["FlagActionsWindowConfirm"].Value" data-testid="flag-add-window" Disabled="@(!CanAddWindow || _busy)" OnClick="OnAddWindowAsync" />
                </div>
            }

            @if (_windowNotice is { } windowNotice)
            {
                <div class="small mt-2" data-testid="flag-window-done">@windowNotice</div>
            }
        </div>
    }

    @if (_error is { } error)
    {
        <div class="small text-danger mt-2" role="alert" data-testid="flag-actions-error">@error</div>
    }
</div>

@code {
    /// <summary>The flag being reviewed. Its status decides whether the actions apply.</summary>
    [Parameter, EditorRequired]
    public MediaFlag Flag { get; set; } = default!;

    /// <summary>Raised with the updated flag after a Keep or Dismiss is saved. Not raised when the save fails.</summary>
    [Parameter]
    public EventCallback<MediaFlag> OnChanged { get; set; }

    /// <summary>The signed-in user's zone. Until the browser's zone is known, UTC is used.</summary>
    [CascadingParameter]
    private UserTimeZone? UserTz { get; set; }

    private UserTimeZone Zone => UserTz ?? UserTimeZone.Unavailable;

    /// <summary>The case picker value that opens the new-case form. A case id is never this text, so the two cannot clash.</summary>
    private const string CreateCaseOption = "create";

    private readonly CancellationTokenSource _disposeCts = new();
    private MediaFlagDismissReason? _dismissReason;
    private string? _dismissNote;
    private bool _reasonValid;
    private bool _busy;
    private LocalizedString? _error;

    /// <summary>The operator role parsed from the paired session, or null when no role is known.</summary>
    private OperatorRole? Role => SessionState.Role is not null && Enum.TryParse<OperatorRole>(SessionState.Role, out OperatorRole role) ? role : null;

    /// <summary>Why the operator cannot review, or null when the operator holds the Review role.</summary>
    private LocalizedString? RoleReason =>
        Role is null
            ? ReviewL["ReasonSignInRequired"]
            : Role.Value >= OperatorRole.Review ? null : ReviewL["ReasonRequiresReview"];

    /// <summary>True when the operator may act on this flag: the role is held and the flag is still Unreviewed.</summary>
    private bool CanAct => RoleReason is null && Flag.Status == MediaFlagStatus.Unreviewed;

    /// <summary>True when the new-case form has a title. The case number is generated by the server.</summary>
    private bool NewCaseReady => !string.IsNullOrWhiteSpace(_newCaseTitle);

    /// <summary>
    /// True when the operator may add the clip: the Review role is held, and either the new-case form is complete or a case is picked
    /// that does not already hold the clip.
    /// </summary>
    private bool CanAddToCase =>
        RoleReason is null
        && (_creatingCase
            ? NewCaseReady
            : _pickedCaseId is { } picked && !_containing.Any(existing => existing.Id == picked));

    /// <summary>
    /// True when the operator may add the RSSI window: the Review role is held, either the new-case form is complete or a case is picked,
    /// and the window holds at least one item.
    /// </summary>
    private bool CanAddWindow =>
        RoleReason is null
        && (_creatingCase ? NewCaseReady : _pickedCaseId is not null)
        && _window is { } window
        && window.Clips.Count + window.Snapshots.Count > 0;

    /// <summary>How far an RSSI flag's window is widened on each side when its clips and snapshots are added to a case.</summary>
    private static readonly TimeSpan RssiPinPad = TimeSpan.FromHours(1);

    /// <summary>The clips and current snapshots of an RSSI flag's padded window, oldest first.</summary>
    private sealed record RssiWindow(IReadOnlyList<MediaItem> Clips, IReadOnlyList<SnapshotCapture> Snapshots);

    private IReadOnlyList<ForensicCase> _openCases = [];
    private IReadOnlyList<ForensicCase> _containing = [];
    private Guid? _pickedCaseId;
    private bool _creatingCase;
    private string _newCaseTitle = string.Empty;
    private Guid? _loadedFlagId;
    private string? _notice;
    private RssiWindow? _window;
    private string? _windowNotice;

    /// <summary>The active pins of the picked case as (kind, target id) keys. Empty when no case is picked.</summary>
    private HashSet<(CaseItemKind Kind, Guid TargetId)> _pinnedToPicked = new();

    /// <summary>The window clips the picked case does not already hold. Every window clip when no case is picked.</summary>
    private int PendingClipCount => _window?.Clips.Count(clip => !_pinnedToPicked.Contains((CaseItemKind.Media, clip.Id))) ?? 0;

    /// <summary>The window snapshots the picked case does not already hold. Every window snapshot when no case is picked.</summary>
    private int PendingSnapshotCount => _window?.Snapshots.Count(snapshot => !_pinnedToPicked.Contains((CaseItemKind.Snapshot, snapshot.Id))) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        // The role and operator come from the paired session, which loads on first use; the Actions menu does the same.
        await SessionState.EnsureLoadedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // A clip flag loads the cases that already hold its clip; an RSSI flag loads its padded window. Both load the open cases for the picker.
        if (Flag.Id == _loadedFlagId)
        {
            return;
        }

        _loadedFlagId = Flag.Id;
        _pickedCaseId = null;
        _creatingCase = false;
        _newCaseTitle = string.Empty;
        _notice = null;
        _windowNotice = null;
        _containing = [];
        _window = null;
        _pinnedToPicked = new();
        try
        {
            _openCases = await CaseRepository.ListAsync(CaseStatus.Open, _disposeCts.Token);
            if (Flag.MediaItemId is { } mediaId)
            {
                _containing = await CaseRepository.ListCasesContainingAsync(CaseItemKind.Media, mediaId, _disposeCts.Token);
            }
            else
            {
                _window = await LoadWindowAsync(_disposeCts.Token);
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError("Could not load cases for the flag add-to-case section: {ExceptionType}: {Message}", ex.GetType().Name, ex.Message);
            _openCases = [];
            _containing = [];
            _window = null;
        }
    }

    /// <summary>Reads the device's clips and current snapshots in the flag window widened by <see cref="RssiPinPad"/> on each side.</summary>
    private async Task<RssiWindow> LoadWindowAsync(CancellationToken ct)
    {
        DateTime fromUtc = Flag.WindowStartUtc - RssiPinPad;
        DateTime toUtc = Flag.WindowEndUtc + RssiPinPad;
        IReadOnlyList<MediaItem> clips = await MediaItemRepository.GetByDeviceAndDateRangeAsync(Flag.DeviceId, fromUtc, toUtc, ct);
        IReadOnlyList<SnapshotCapture> snapshots = await SnapshotCaptureRepository.GetCurrentForDeviceAsync(
            Flag.DeviceId,
            new DateTimeOffset(DateTime.SpecifyKind(fromUtc, DateTimeKind.Utc)),
            new DateTimeOffset(DateTime.SpecifyKind(toUtc, DateTimeKind.Utc)),
            ct);
        return new RssiWindow(clips, snapshots);
    }

    /// <summary>Picks a case from the dropdown, or opens the new-case form when the create option is chosen.</summary>
    private async Task OnCasePicked(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        string? value = args.Value?.ToString();
        _creatingCase = value == CreateCaseOption;
        _pickedCaseId = !_creatingCase && Guid.TryParse(value, out Guid caseId) ? caseId : null;
        _notice = null;
        _windowNotice = null;
        _pinnedToPicked = new();
        if (_pickedCaseId is { } picked)
        {
            await LoadPinnedToPickedAsync(picked);
        }
    }

    /// <summary>Reads the picked case's active pins so the RSSI window counts leave out items it already holds. A stale read is dropped.</summary>
    private async Task LoadPinnedToPickedAsync(Guid caseId)
    {
        try
        {
            IReadOnlyList<CaseItem> pins = await CaseRepository.ListItemsAsync(caseId, false, _disposeCts.Token);
            if (_pickedCaseId == caseId)
            {
                _pinnedToPicked = PinnedKeys(pins);
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError("Could not read the pins of case {CaseId} for the RSSI window counts: {ExceptionType}: {Message}", caseId, ex.GetType().Name, ex.Message);
        }
    }

    /// <summary>The active pins as (kind, target id) keys: a Media pin keys its clip and a Snapshot pin keys its snapshot.</summary>
    private static HashSet<(CaseItemKind Kind, Guid TargetId)> PinnedKeys(IEnumerable<CaseItem> pins)
    {
        var keys = new HashSet<(CaseItemKind Kind, Guid TargetId)>();
        foreach (CaseItem pin in pins)
        {
            if (pin.Kind == CaseItemKind.Media && pin.MediaItemId is { } mediaId)
            {
                _ = keys.Add((pin.Kind, mediaId));
            }
            else if (pin.Kind == CaseItemKind.Snapshot && pin.SnapshotCaptureId is { } snapshotId)
            {
                _ = keys.Add((pin.Kind, snapshotId));
            }
        }

        return keys;
    }

    /// <summary>
    /// Creates a case from the new-case form the way CaseNew does: the signed-in operator leads it and created it. The case number is
    /// not sent, so the repository generates it. On success the case is listed and picked, and the form is cleared. Any failure sets
    /// the message and returns null, so nothing is added to a case.
    /// </summary>
    private async Task<ForensicCase?> CreateCaseAsync(string operatorId)
    {
        try
        {
            ForensicCase created = await CaseRepository.CreateAsync(
                null,
                _newCaseTitle.Trim(),
                null,
                SessionState.OperatorId,
                null,
                null,
                [Flag.DeviceId],
                operatorId,
                _disposeCts.Token);
            _openCases = [.. _openCases, created];
            _pickedCaseId = created.Id;
            _pinnedToPicked = new();
            _creatingCase = false;
            _newCaseTitle = string.Empty;
            return created;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError("Creating a case from the flag panel failed: {ExceptionType}: {Message}", ex.GetType().Name, ex.Message);
            _error = L["FlagActionsCreateFailed"];
            return null;
        }
    }

    /// <summary>
    /// Pins the flagged clip to the picked case as a Media item. A new case is created first when the create option is chosen, and
    /// the clip is not added if that fails. The repository reports a duplicate pin, a closed case and a missing case with the same
    /// exception type, so the failure is told apart by reading the case and its pins again.
    /// </summary>
    private async Task OnAddToCaseAsync()
    {
        if (_busy || !CanAddToCase || Flag.MediaItemId is not { } mediaId)
        {
            return;
        }

        // Same rule as Keep and Dismiss: never fall back to a machine identity, refuse instead.
        if (EvidenceActions.ResolveOperatorActor(SessionState.OperatorId) is not { } operatorId)
        {
            _error = ReviewL["ReasonSignInRequired"];
            return;
        }

        _busy = true;
        _error = null;
        _notice = null;
        try
        {
            if (_creatingCase && await CreateCaseAsync(operatorId) is null)
            {
                return;
            }

            await AddClipToPickedCaseAsync(mediaId, operatorId);
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            return;
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Adds the clip to the picked case and reports the result. The caller holds the busy flag.</summary>
    private async Task AddClipToPickedCaseAsync(Guid mediaId, string operatorId)
    {
        if (_pickedCaseId is not { } caseId)
        {
            return;
        }

        try
        {
            _ = await CaseRepository.AddItemAsync(caseId, CaseItemKind.Media, mediaId, L["FlagActionsPinReason"].Value, operatorId, _disposeCts.Token);
            ForensicCase? added = _openCases.FirstOrDefault(c => c.Id == caseId);
            if (added is not null)
            {
                _containing = [.. _containing, added];
                _notice = L["FlagActionsAddDone", added.Title].Value;
            }
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            return;
        }
        catch (InvalidOperationException)
        {
            _error = await DescribeAddFailureAsync(caseId, mediaId);
        }
        catch (KeyNotFoundException)
        {
            // The case itself may be the missing entity, so check it before blaming the clip.
            ForensicCase? picked = await CaseRepository.GetAsync(caseId, _disposeCts.Token);
            if (picked is null)
            {
                Logger.LogError("Adding flagged clip to case failed: the case is missing");
                _error = L["FlagActionsMissingCase"];
            }
            else
            {
                Logger.LogError("Adding flagged clip {MediaItemId} to case {CaseId} failed: the media item is missing", mediaId, caseId);
                _error = L["FlagActionsMissingTarget"];
            }
        }
        catch (Exception ex)
        {
            Logger.LogError("Adding flagged clip {MediaItemId} to case {CaseId} failed: {ExceptionType}: {Message}", mediaId, caseId, ex.GetType().Name, ex.Message);
            _error = L["FlagActionsFailed"];
        }
    }

    /// <summary>Reads the case and its pins again to tell a closed case and a duplicate pin apart from any other failure.</summary>
    private async Task<LocalizedString> DescribeAddFailureAsync(Guid caseId, Guid mediaId)
    {
        try
        {
            ForensicCase? target = await CaseRepository.GetAsync(caseId, _disposeCts.Token);
            if (target?.Status == CaseStatus.Closed)
            {
                return L["FlagActionsClosedCase"];
            }

            IReadOnlyList<ForensicCase> containing = await CaseRepository.ListCasesContainingAsync(CaseItemKind.Media, mediaId, _disposeCts.Token);
            return containing.Any(existing => existing.Id == caseId) ? L["FlagActionsDuplicate"] : L["FlagActionsFailed"];
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError("Could not read the case after a failed add-to-case: {ExceptionType}: {Message}", ex.GetType().Name, ex.Message);
            return L["FlagActionsFailed"];
        }
    }

    /// <summary>
    /// Pins every clip and snapshot of the RSSI window to the picked case. A new case is created first when the create option is chosen.
    /// An item already pinned to the case is skipped, not an error. Any other failure stops the batch and reports how many items were not added.
    /// </summary>
    private async Task OnAddWindowAsync()
    {
        if (_busy || !CanAddWindow || _window is not { } window)
        {
            return;
        }

        // Same rule as the clip add: never fall back to a machine identity, refuse instead.
        if (EvidenceActions.ResolveOperatorActor(SessionState.OperatorId) is not { } operatorId)
        {
            _error = ReviewL["ReasonSignInRequired"];
            return;
        }

        _busy = true;
        _error = null;
        _windowNotice = null;
        try
        {
            if (_creatingCase && await CreateCaseAsync(operatorId) is null)
            {
                return;
            }

            if (_pickedCaseId is not { } caseId)
            {
                return;
            }

            ForensicCase? target = await CaseRepository.GetAsync(caseId, _disposeCts.Token);
            if (target is null)
            {
                _error = L["FlagActionsMissingTarget"];
                return;
            }

            if (target.Status == CaseStatus.Closed)
            {
                _error = L["FlagActionsClosedCase"];
                return;
            }

            // One read of the case's active pins covers every window item, instead of one read per item.
            HashSet<(CaseItemKind Kind, Guid TargetId)> pinned = PinnedKeys(await CaseRepository.ListItemsAsync(caseId, false, _disposeCts.Token));

            var pending = new List<(CaseItemKind Kind, Guid TargetId)>();
            foreach (MediaItem clip in window.Clips)
            {
                if (!pinned.Contains((CaseItemKind.Media, clip.Id)))
                {
                    pending.Add((CaseItemKind.Media, clip.Id));
                }
            }

            foreach (SnapshotCapture snapshot in window.Snapshots)
            {
                if (!pinned.Contains((CaseItemKind.Snapshot, snapshot.Id)))
                {
                    pending.Add((CaseItemKind.Snapshot, snapshot.Id));
                }
            }

            string reason = L["FlagActionsPinReasonRssi"].Value;
            int clipsAdded = 0;
            int snapshotsAdded = 0;
            for (int index = 0; index < pending.Count; index++)
            {
                (CaseItemKind kind, Guid targetId) = pending[index];
                try
                {
                    _ = await CaseRepository.AddItemAsync(caseId, kind, targetId, reason, operatorId, _disposeCts.Token);
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    Logger.LogError("Adding an RSSI window {ItemKind} to a case failed: {ExceptionType}: {Message}", kind, ex.GetType().Name, ex.Message);
                    // The failed item and every item after it were not added.
                    _error = L["FlagActionsWindowPartial", pending.Count - index, pending.Count];
                    return;
                }

                if (kind == CaseItemKind.Media)
                {
                    clipsAdded++;
                }
                else
                {
                    snapshotsAdded++;
                }
            }

            _windowNotice = L["FlagActionsWindowDone", clipsAdded, snapshotsAdded].Value;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError("Adding the RSSI window to a case failed: {ExceptionType}: {Message}", ex.GetType().Name, ex.Message);
            _error = L["FlagActionsFailed"];
        }
        finally
        {
            _busy = false;
        }
    }

    /// <summary>Runs a Keep: the expected status is Unreviewed and no reason is sent. Notes live in the flag's own thread.</summary>
    private Task OnKeepAsync()
    {
        return ReviewAsync(MediaFlagStatus.Kept, null);
    }

    /// <summary>Keeps Dismiss enabled only while the reason picker reports a complete reason.</summary>
    private void OnReasonValidityChanged(bool valid)
    {
        _reasonValid = valid;
    }

    /// <summary>
    /// Runs a Dismiss with the chosen reason as its enum name. The Other reason appends ": " and its trimmed note, so the
    /// note is stored with the reason.
    /// </summary>
    private Task OnDismissAsync()
    {
        if (_dismissReason is not { } reason || !_reasonValid)
        {
            return Task.CompletedTask;
        }

        string text = reason == MediaFlagDismissReason.Other
            ? $"{reason}: {(_dismissNote ?? string.Empty).Trim()}"
            : reason.ToString();
        return ReviewAsync(MediaFlagStatus.Dismissed, text);
    }

    /// <summary>
    /// Saves one review through the compare-and-set status path. A conflict or failure becomes a message and no change is
    /// raised; success raises <see cref="OnChanged"/> with the updated flag.
    /// </summary>
    private async Task ReviewAsync(MediaFlagStatus newStatus, string? reason)
    {
        if (_busy || !CanAct)
        {
            return;
        }

        // Same rule as the Evidence page and the Actions menu: never fall back to a machine identity, refuse instead.
        if (EvidenceActions.ResolveOperatorActor(SessionState.OperatorId) is not { } operatorId)
        {
            _error = ReviewL["ReasonSignInRequired"];
            return;
        }

        MediaFlag? updated = null;
        _busy = true;
        _error = null;
        try
        {
            updated = await MediaFlagRepository.UpdateStatusAsync(Flag.Id, MediaFlagStatus.Unreviewed, newStatus, reason, operatorId, _disposeCts.Token);
        }
        catch (FlagStatusConflictException)
        {
            _error = L["FlagActionsConflict"];
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Logger.LogError("Flag review {FlagId} to {Status} failed: {ExceptionType}: {Message}", Flag.Id, newStatus, ex.GetType().Name, ex.Message);
            _error = L["FlagActionsFailed"];
        }
        finally
        {
            _busy = false;
        }

        if (updated is not null)
        {
            await OnChanged.InvokeAsync(updated);
        }
    }

    private string StatusName()
    {
        LocalizedString text = L[$"FlaggedMediaStatus_{Flag.Status}"];
        return text.ResourceNotFound ? Flag.Status.ToString() : text.Value;
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }
}
