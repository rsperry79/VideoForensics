@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Resources
@inject IStringLocalizer<SharedResources> L

<div class="flag-review-shell" data-testid="flag-review-shell">
    <div class="flag-review-breadcrumb" data-testid="flag-review-breadcrumb">
        @Breadcrumb
    </div>

    <section class="flag-review-media" data-testid="flag-review-media" aria-label="@L["FlagReviewMediaLabel"]">
        @Media
    </section>

    <aside class="flag-review-side" data-testid="flag-review-side" aria-label="@L["FlagReviewSideLabel"]">
        @if (Actions is not null)
        {
            <div class="flag-review-actions" data-testid="flag-review-actions">
                @Actions
            </div>
        }
        @if (Navigator is not null)
        {
            <div class="flag-review-navigator" data-testid="flag-review-navigator">
                @Navigator
            </div>
        }
    </aside>

    <section class="flag-review-timeline" data-testid="flag-review-timeline" aria-label="@L["FlagReviewTimelineLabel"]">
        @Timeline
    </section>
</div>

@code {
    /// <summary>The breadcrumb trail above the media, already built by the caller.</summary>
    [Parameter]
    public RenderFragment? Breadcrumb { get; set; }

    /// <summary>The clip, or the media fit that shows it. Fills the middle window.</summary>
    [Parameter]
    public RenderFragment? Media { get; set; }

    /// <summary>The flag actions (add to case, keep, dismiss). Omitted when null.</summary>
    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>The previous and next flag controls, stacked under the actions. Omitted when null.</summary>
    [Parameter]
    public RenderFragment? Navigator { get; set; }

    /// <summary>The playback timeline pinned to the bottom of the shell.</summary>
    [Parameter]
    public RenderFragment? Timeline { get; set; }
}
