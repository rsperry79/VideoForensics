@implements IDisposable
@using System.Globalization
@using System.Reactive.Linq
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using VideoForensics.Client.Ui.Shared.Contracts
@using VideoForensics.Client.Ui.Shared.Pages
@using VideoForensics.Client.Ui.Shared.Services.Review
@using VideoForensics.Client.Ui.Shared.Services.Signal
@using VideoForensics.Client.Ui.Shared.Services.Time
@using VideoForensics.Core.Api.Contracts
@inject IReviewEventLoader EventLoader
@inject IReviewDetailLoader DetailLoader
@inject IServiceProvider ServiceProvider
@inject IStringLocalizer<ReviewPage> L
@inject ILogger<ReviewEventsTab> Logger

@{
    IReadOnlyList<ReviewEventRow> rows = MergedRows();
    bool eventsFailed = ShowCameraEvents && _events.Failed;
    bool systemFailed = (ShowJamming && _jamming.Failed) || (ShowAnomalies && _anomalies.Failed) || (ShowBitRate && _bitRate.Failed);
}

<section class="review-tab-panel review-events-tab" data-testid="review-tab-events">
    @if (State.CameraIds.Count == 0)
    {
        <p class="review-events-message" data-testid="review-events-no-cameras">@L["EventsNoCameras"]</p>
    }
    else if (!Ready)
    {
        <p class="review-events-message" role="status" data-testid="review-events-loading">@L["EventsLoading"]</p>
    }
    else
    {
        @if (eventsFailed)
        {
            <p class="review-events-message text-danger" role="alert" data-testid="review-events-error">@L["EventsLoadFailed"]</p>
        }
        @if (systemFailed)
        {
            <p class="review-events-message text-danger" role="alert" data-testid="review-events-system-error">@L["EventsSystemLoadFailed"]</p>
        }

        @if (rows.Count == 0)
        {
            @if (!eventsFailed)
            {
                <p class="review-events-message" data-testid="review-events-empty">@L["EventsEmpty"]</p>
            }
        }
        else
        {
            <div class="list-group review-events-list" aria-label="@L["EventsListLabel"]">
                @foreach (ReviewEventRow row in rows)
                {
                    if (row.Kind == ReviewEventRowKind.CameraEvent)
                    {
                        EventDto evt = (EventDto)row.Source;
                        bool selected = evt.Id == State.SelectedEventId;
                        <button type="button" class="list-group-item list-group-item-action d-flex flex-wrap gap-2 align-items-center @(selected ? "active" : string.Empty)"
                                aria-current="@(selected ? "true" : null)" data-testid="review-event-row" data-kind="@row.Kind" data-event-id="@evt.Id.ToString("D")"
                                title="@HoverText(row)" @onclick="() => OnRowClick(evt)">
                            <span class="review-event-time"><LocalTimeText Value="evt.OccurredAtUtc" Format="g" /></span>
                            <span class="review-event-camera">@CameraName(evt.DeviceId)</span>
                            <span class="review-event-type">@RowTypeLabel(evt)</span>
                            @if (evt.DownloadStatus == EventDownloadStatusDto.Unavailable)
                            {
                                <span class="badge text-bg-warning" data-testid="review-event-unavailable">@L["EventUnavailable"]</span>
                            }
                        </button>
                    }
                    else
                    {
                        <button type="button" class="list-group-item list-group-item-action d-flex flex-wrap gap-2 align-items-center"
                                data-testid="review-event-row" data-kind="@row.Kind" title="@HoverText(row)" @onclick="() => OnSystemRowClick(row)">
                            <span class="review-event-time"><LocalTimeText Value="row.StartUtc" Format="g" /></span>
                            @if (row.Kind == ReviewEventRowKind.SignalAnomaly)
                            {
                                <span class="review-detail-range"><LocalTimeText Value="row.EndUtc" Format="g" /></span>
                            }
                            <span class="review-event-camera">@CameraName(row.DeviceId)</span>
                            <span class="review-event-type">@SystemRowLabel(row.Kind)</span>
                        </button>
                    }
                }
            </div>
        }
    }
</section>

@code {
    private static readonly TimeSpan ReloadQuietPeriod = TimeSpan.FromMilliseconds(750);

    /// <summary>The review state the tab reads and writes (cameras, range, selected event, cursor, tab).</summary>
    [Parameter, EditorRequired]
    public ReviewPageState State { get; set; } = default!;

    /// <summary>Display name for each camera id. A camera missing here shows its id.</summary>
    [Parameter]
    public IReadOnlyDictionary<Guid, string> DeviceNames { get; set; } = new Dictionary<Guid, string>();

    /// <summary>Zone supplied by <c>UserTimeZoneHost</c>. Without it, the machine's local zone is used.</summary>
    [CascadingParameter]
    public UserTimeZone? Zone { get; set; }

    /// <summary>The cameras, range and event types the last load of each source asked for.</summary>
    private LoadKey? _key;
    private IReadOnlySet<Guid> _shownDeviceIds = new HashSet<Guid>();
    private bool _disposed;

    // One slot per source. Each source loads on its own, so a slow source never holds up the others.
    private readonly Slot<EventDto> _events = new();
    private readonly Slot<JammingIncidentDto> _jamming = new();
    private readonly Slot<ReviewAnomaly> _anomalies = new();
    private readonly Slot<ReviewBitRateFlag> _bitRate = new();

    // Each row's detail, read once per page so a camera row can show its Person or Vehicle type and its hover lines.
    private readonly Dictionary<Guid, EventDetailDto?> _details = [];

    private IDisposable? _evidenceSubscription;
    private IDisposable? _healthSubscription;

    protected override Task OnInitializedAsync()
    {
        State.OnChange += OnReviewStateChanged;

        // Optional, like the other review feeds: a host with no realtime feed simply never refreshes from that source.
        // Each throttle collapses a burst of changes into one re-query.
        var evidence = ServiceProvider.GetService(typeof(IEvidenceChangedSource)) as IEvidenceChangedSource;
        _evidenceSubscription = evidence?.EvidenceChanged
            .Where(change => _shownDeviceIds.Contains(change.DeviceId))
            .Throttle(ReloadQuietPeriod)
            .Subscribe(change => { _ = InvokeAsync(() => RefreshEventsAsync()); });

        var health = ServiceProvider.GetService(typeof(IDeviceHealthChangedSource)) as IDeviceHealthChangedSource;
        _healthSubscription = health?.DeviceHealthChanged
            .Where(change => _shownDeviceIds.Contains(change.DeviceId))
            .Throttle(ReloadQuietPeriod)
            .Subscribe(change => { _ = InvokeAsync(() => RefreshSystemAsync()); });

        ResetAll();
        return Task.CompletedTask;
    }

    private void OnReviewStateChanged()
    {
        _ = InvokeAsync(OnReviewStateChangedAsync);
    }

    /// <summary>
    /// A camera, range, or event-type change reloads every source. A cursor, tab, or selection change only re-renders,
    /// so the list keeps the user's place.
    /// </summary>
    private Task OnReviewStateChangedAsync()
    {
        if (_disposed)
        {
            return Task.CompletedTask;
        }

        if (_key is null || !_key.Matches(State))
        {
            ResetAll();
            return Task.CompletedTask;
        }

        StateHasChanged();
        return Task.CompletedTask;
    }

    private void ResetAll()
    {
        _key = CurrentKey();
        _shownDeviceIds = _key.Cameras.ToHashSet();
        _ = LoadEventsAsync(LoadMode.Reset);
        ReloadSystemSources(reset: true);
    }

    private Task RefreshEventsAsync()
    {
        if (_disposed || !Current(_events))
        {
            return Task.CompletedTask;
        }

        return LoadEventsAsync(LoadMode.Refresh);
    }

    /// <summary>A device health change re-reads the three system sources. The camera events are left as they are.</summary>
    private Task RefreshSystemAsync()
    {
        if (_disposed || _key is null || !_key.Matches(State))
        {
            return Task.CompletedTask;
        }

        ReloadSystemSources(reset: false);
        return Task.CompletedTask;
    }

    private void ReloadSystemSources(bool reset)
    {
        _ = LoadSlotAsync(_jamming, ShowJamming, reset, (key, ct) => DetailLoader.LoadJammingAsync(key.Cameras, key.FromUtc, key.ToUtc, ct), "jamming incidents");
        _ = LoadSlotAsync(_anomalies, ShowAnomalies, reset, (key, ct) => DetailLoader.LoadAnomaliesAsync(key.Cameras, key.FromUtc, key.ToUtc, ct), "signal anomalies");
        _ = LoadSlotAsync(_bitRate, ShowBitRate, reset, (key, ct) => DetailLoader.LoadBitRateFlagsAsync(key.Cameras, key.FromUtc, key.ToUtc, ct), "bit rate flags");
    }

    /// <summary>
    /// Reads every camera event in the range, page by page, into one list. Each page request asks for the next
    /// <see cref="ReviewEventFilters.PageSize"/> rows after the ones already read. A newer load cancels this one, and a
    /// result that is no longer current is dropped, so a slow answer never overwrites a newer list.
    /// </summary>
    private async Task LoadEventsAsync(LoadMode mode)
    {
        if (_disposed)
        {
            return;
        }

        _events.Cts?.Cancel();
        _events.Cts?.Dispose();
        var cts = new CancellationTokenSource();
        _events.Cts = cts;
        CancellationToken ct = cts.Token;

        LoadKey key = CurrentKey();
        _events.Failed = false;
        if (key.Cameras.Count == 0 || !ShowsCameraEvents(key.EventTypes))
        {
            _events.Items = null;
            StateHasChanged();
            return;
        }

        if (mode == LoadMode.Reset)
        {
            _events.Items = null;
            StateHasChanged();
        }

        try
        {
            List<EventDto> rows = await ReadAllEventsAsync(key, ct);
            if (!IsCurrent(cts))
            {
                return;
            }

            if (mode == LoadMode.Refresh)
            {
                // Re-read the rows, so an open row shows fresh detail.
                foreach (EventDto row in rows)
                {
                    _details.Remove(row.Id);
                }
            }

            await LoadRowDetailsAsync(rows, ct);
            if (!IsCurrent(cts))
            {
                return;
            }

            _events.Items = new Loaded<EventDto>(key, rows);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            // A newer query or the disposal replaced this one; it owns the list now.
            return;
        }
        catch (Exception ex)
        {
            if (!IsCurrent(cts))
            {
                return;
            }

            Logger.LogError("Could not load review events: {ExceptionType}: {Message}", ex.GetType().FullName, ex.Message);
            _events.Items = null;
            _events.Failed = true;
        }

        if (IsCurrent(cts))
        {
            StateHasChanged();
        }
    }

    private async Task<List<EventDto>> ReadAllEventsAsync(LoadKey key, CancellationToken ct)
    {
        IReadOnlyList<string>? providerTypes = ReviewEventFilters.ProviderTypes(key.EventTypes);
        var rows = new List<EventDto>();
        while (true)
        {
            EventPageDto page = await EventLoader.LoadAsync(key.Cameras, key.FromUtc, key.ToUtc, providerTypes, rows.Count, ReviewEventFilters.PageSize, ct);
            rows.AddRange(page.Items);

            // An empty page, or the reported total reached, ends the read.
            if (!page.Items.Any() || rows.Count >= page.TotalCount)
            {
                return rows;
            }
        }
    }

    /// <summary>
    /// Runs one system source's query into its slot, with the same cancel and stale-drop rules as the camera events.
    /// A source the Event Filter hides is not queried at all.
    /// </summary>
    private async Task LoadSlotAsync<T>(Slot<T> slot, bool shown, bool reset, Func<LoadKey, CancellationToken, Task<IReadOnlyList<T>>> fetch, string what)
    {
        if (_disposed)
        {
            return;
        }

        slot.Cts?.Cancel();
        slot.Cts?.Dispose();
        var cts = new CancellationTokenSource();
        slot.Cts = cts;
        CancellationToken ct = cts.Token;

        LoadKey key = CurrentKey();
        slot.Failed = false;
        if (key.Cameras.Count == 0 || !shown)
        {
            slot.Items = null;
            StateHasChanged();
            return;
        }

        if (reset)
        {
            slot.Items = null;
            StateHasChanged();
        }

        try
        {
            IReadOnlyList<T> items = await fetch(key, ct);
            if (!IsCurrent(cts))
            {
                return;
            }

            slot.Items = new Loaded<T>(key, items);
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            if (!IsCurrent(cts))
            {
                return;
            }

            Logger.LogError("Could not load review {Source}: {ExceptionType}: {Message}", what, ex.GetType().FullName, ex.Message);
            slot.Items = null;
            slot.Failed = true;
        }

        if (IsCurrent(cts))
        {
            StateHasChanged();
        }
    }

    private bool IsCurrent(CancellationTokenSource cts)
    {
        return !_disposed && !cts.IsCancellationRequested;
    }

    /// <summary>True when a slot holds the list for the current state.</summary>
    private bool Current<T>(Slot<T> slot)
    {
        return slot.Items is not null && slot.Items.Key.Matches(State);
    }

    /// <summary>A source is done when it is not shown, failed, or holds the current state's list.</summary>
    private bool Done<T>(Slot<T> slot, bool shown)
    {
        return !shown || slot.Failed || Current(slot);
    }

    /// <summary>The slot's items when it is shown and current, else nothing.</summary>
    private IReadOnlyList<T> Included<T>(Slot<T> slot, bool shown)
    {
        return shown && Current(slot) ? slot.Items!.Items : Array.Empty<T>();
    }

    /// <summary>True once every shown source has finished (loaded, or failed) for the current state.</summary>
    private bool Ready => Done(_events, ShowCameraEvents) && Done(_jamming, ShowJamming) && Done(_anomalies, ShowAnomalies) && Done(_bitRate, ShowBitRate);

    private IReadOnlyList<ReviewEventRow> MergedRows()
    {
        return ReviewEventRows.Merge(
            Included(_events, ShowCameraEvents),
            Included(_jamming, ShowJamming),
            Included(_anomalies, ShowAnomalies),
            Included(_bitRate, ShowBitRate));
    }

    /// <summary>
    /// Selects the event's camera, the event, and its time, then switches to the Timeline tab, where the player lives.
    /// The camera is only changed when it is not already the one and only selected camera.
    /// </summary>
    private void OnRowClick(EventDto evt)
    {
        bool alreadyOnlyCamera = State.CameraIds.Count == 1 && State.CameraIds[0] == evt.DeviceId;
        if (!alreadyOnlyCamera)
        {
            State.SetCameras([evt.DeviceId]);
        }

        State.SelectEvent(evt.Id);
        State.SetCursor(evt.OccurredAtUtc);
        State.RequestPlayOnArrival();
        State.SetTab(ReviewTab.Timeline);
    }

    /// <summary>A system row selects its camera and time, then switches to the Timeline tab, as the Detail tab's rows did.</summary>
    private void OnSystemRowClick(ReviewEventRow row)
    {
        bool alreadyOnlyCamera = State.CameraIds.Count == 1 && State.CameraIds[0] == row.DeviceId;
        if (!alreadyOnlyCamera)
        {
            State.SetCameras([row.DeviceId]);
        }

        State.SetCursor(row.StartUtc);
        State.RequestPlayOnArrival();
        State.SetTab(ReviewTab.Timeline);
    }

    private string CameraName(Guid deviceId)
    {
        return DeviceNames.TryGetValue(deviceId, out string? name) ? name : deviceId.ToString("D");
    }

    /// <summary>The row's label: the detection type (Person, Vehicle) when its detail names one, else the event's own type.</summary>
    private string RowTypeLabel(EventDto evt)
    {
        _ = _details.TryGetValue(evt.Id, out EventDetailDto? detail);
        return ReviewEventLabels.RowLabel(L, evt, detail);
    }

    /// <summary>The label a system row shows: the title of the Detail section the row came from.</summary>
    private string SystemRowLabel(ReviewEventRowKind kind)
    {
        return kind switch
        {
            ReviewEventRowKind.Jamming => L["DetailJammingTitle"].Value,
            ReviewEventRowKind.SignalAnomaly => L["DetailAnomaliesTitle"].Value,
            _ => L["DetailBitRateTitle"].Value,
        };
    }

    /// <summary>
    /// The row's hover text: its data as plain lines joined by a newline, or null when it has none. Built from the
    /// same fields the Detail tab expanded, so no row shows less than the Detail tab did.
    /// </summary>
    private string? HoverText(ReviewEventRow row)
    {
        List<string> lines = row.Kind switch
        {
            ReviewEventRowKind.CameraEvent => CameraHoverLines((EventDto)row.Source),
            ReviewEventRowKind.Jamming => JammingHoverLines((JammingIncidentDto)row.Source),
            ReviewEventRowKind.SignalAnomaly => AnomalyHoverLines((ReviewAnomaly)row.Source),
            _ => BitRateHoverLines((ReviewBitRateFlag)row.Source),
        };
        return lines.Count == 0 ? null : string.Join("\n", lines);
    }

    private List<string> CameraHoverLines(EventDto evt)
    {
        var lines = new List<string>();
        _ = _details.TryGetValue(evt.Id, out EventDetailDto? detail);
        if (detail is null)
        {
            return lines;
        }

        if (detail.Detection is { } det)
        {
            if (!string.IsNullOrWhiteSpace(det.ShortDescription))
            {
                lines.Add(det.ShortDescription);
            }

            if (!string.IsNullOrWhiteSpace(det.FullDescription))
            {
                lines.Add(det.FullDescription);
            }

            if (!string.IsNullOrWhiteSpace(det.DetectionType))
            {
                lines.Add(HoverField("DetailFieldDetectionType", DetectionLabel(det.DetectionType, evt.EventType)));
            }

            if (Percent(det.Confidence) is { } confidence)
            {
                lines.Add(HoverField("DetailFieldConfidence", confidence));
            }

            if (Percent(det.Anomaly) is { } anomaly)
            {
                lines.Add(HoverField("DetailFieldAnomaly", anomaly));
            }

            if (Percent(det.Similarity) is { } similarity)
            {
                lines.Add(HoverField("DetailFieldSimilarity", similarity));
            }

            if (!string.IsNullOrWhiteSpace(det.ModelVersion))
            {
                lines.Add(HoverField("DetailFieldModelVersion", det.ModelVersion));
            }

            if (det.StreamBroken == true)
            {
                lines.Add(L["DetailFieldStreamBroken"].Value);
            }
        }

        if (detail.Zones.Count > 0)
        {
            lines.Add(HoverField("DetailFieldZones", string.Join(", ", detail.Zones.Select(zone => WithScore(zone.ZoneName ?? zone.ZoneId, zone.Confidence)))));
        }

        if (detail.People.Count > 0)
        {
            lines.Add(HoverField("DetailFieldPeople", string.Join(", ", detail.People.Select(person => WithScore(person.ProfileName ?? person.ProfileId, person.Confidence)))));
        }

        if (detail.SecurityAlerts.Count > 0)
        {
            lines.Add(HoverField("DetailFieldAlerts", string.Join(", ", detail.SecurityAlerts.Select(alert => $"{alert.Severity} {alert.AlertText}"))));
        }

        return lines;
    }

    private List<string> JammingHoverLines(JammingIncidentDto incident)
    {
        return
        [
            HoverField("DetailFieldConfidence", ConfidenceLabel(incident.Confidence)),
            string.Format(L["DetailJammingAffected"].Value, incident.AffectedEventCount),
        ];
    }

    private List<string> AnomalyHoverLines(ReviewAnomaly anomaly)
    {
        return
        [
            LevelLabel(anomaly.Level),
            HoverRange(anomaly.StartUtc, anomaly.EndUtc),
        ];
    }

    private List<string> BitRateHoverLines(ReviewBitRateFlag flag)
    {
        return
        [
            BitRateLabel(flag.FlagType),
            HoverRange(flag.StartUtc, flag.EndUtc),
        ];
    }

    /// <summary>The localized name of a bit-rate flag type.</summary>
    private string BitRateLabel(string flagType)
    {
        return flagType == "BitrateDeviation" ? L["DetailBitRateDeviation"].Value : L["DetailBitRateCollapse"].Value;
    }

    private string HoverField(string labelKey, string value)
    {
        return string.Format(L["EventHoverLine"].Value, L[labelKey].Value, value);
    }

    private string HoverRange(DateTime startUtc, DateTime endUtc)
    {
        return string.Format(L["EventHoverRange"].Value, LocalText(startUtc), LocalText(endUtc));
    }

    private string LocalText(DateTime utc)
    {
        return (Zone ?? new UserTimeZone(TimeZoneInfo.Local)).Format(utc, "g");
    }

    /// <summary>A name with its score after it, for example a zone or a person with its confidence.</summary>
    private static string WithScore(string name, decimal? score)
    {
        return Percent(score) is { } percent ? $"{name} {percent}" : name;
    }

    private string DetectionLabel(string detectionType, string eventType)
    {
        return ReviewEventLabels.DetectionLabel(L, detectionType, eventType);
    }

    private string ConfidenceLabel(string level)
    {
        return L["JammingConfidence_" + level].Value;
    }

    private string LevelLabel(SignalDeviationLevel level)
    {
        LocalizedString label = L["DetailLevel" + level.ToString()];
        return label.ResourceNotFound ? level.ToString() : label.Value;
    }

    /// <summary>A 0 to 1 score shown as a percentage, or null when the score is not recorded.</summary>
    private static string? Percent(decimal? value)
    {
        return value is null ? null : ((double)value.Value).ToString("P0", CultureInfo.CurrentCulture);
    }

    private bool ShowCameraEvents => ShowsCameraEvents(State.EventTypes);

    /// <summary>
    /// Provider events are asked for unless the selection holds only system types. An empty provider list means no provider
    /// type was selected, so no camera event is queried; a null list means no selection, so every type is queried.
    /// </summary>
    private static bool ShowsCameraEvents(IReadOnlyCollection<string> selection)
    {
        return ReviewEventFilters.ProviderTypes(selection) is not { Count: 0 };
    }

    private bool ShowJamming => ReviewEventFilters.Shows(State.EventTypes, ReviewEventFilters.Jamming);

    private bool ShowAnomalies => ReviewEventFilters.Shows(State.EventTypes, ReviewEventFilters.SignalAnomaly);

    private bool ShowBitRate => ReviewEventFilters.Shows(State.EventTypes, ReviewEventFilters.BitRate);

    private LoadKey CurrentKey()
    {
        return new LoadKey(State.CameraIds.ToList(), State.FromUtc, State.ToUtc, State.EventTypes.ToList());
    }

    /// <summary>Loads the detail for rows not yet read, in one batch. A failure here is logged and the rows keep their event-type label.</summary>
    private async Task LoadRowDetailsAsync(IReadOnlyList<EventDto> rows, CancellationToken ct)
    {
        Guid[] missing = rows.Select(row => row.Id).Where(id => !_details.ContainsKey(id)).ToArray();
        if (missing.Length == 0)
        {
            return;
        }

        try
        {
            IReadOnlyDictionary<Guid, EventDetailDto> found = await DetailLoader.LoadEventDetailsAsync(missing, ct);
            foreach (Guid id in missing)
            {
                _details[id] = found.TryGetValue(id, out EventDetailDto? detail) ? detail : null;
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError("Could not load event details for the events list: {ExceptionType}: {Message}", ex.GetType().FullName, ex.Message);
        }
    }

    private static void CancelSlot<T>(Slot<T> slot)
    {
        slot.Cts?.Cancel();
        slot.Cts?.Dispose();
        slot.Cts = null;
    }

    public void Dispose()
    {
        if (_disposed)
        {
            return;
        }

        _disposed = true;
        State.OnChange -= OnReviewStateChanged;
        _evidenceSubscription?.Dispose();
        _evidenceSubscription = null;
        _healthSubscription?.Dispose();
        _healthSubscription = null;
        CancelSlot(_events);
        CancelSlot(_jamming);
        CancelSlot(_anomalies);
        CancelSlot(_bitRate);
    }

    private enum LoadMode
    {
        Reset,
        Refresh,
    }

    /// <summary>The cameras, range and event types one load asked for. A list is only shown while this still matches the state.</summary>
    private sealed record LoadKey(IReadOnlyList<Guid> Cameras, DateTime FromUtc, DateTime ToUtc, IReadOnlyList<string> EventTypes)
    {
        public bool Matches(ReviewPageState state)
        {
            return Cameras.SequenceEqual(state.CameraIds) && FromUtc == state.FromUtc && ToUtc == state.ToUtc && EventTypes.SequenceEqual(state.EventTypes);
        }
    }

    /// <summary>The items one source loaded, and the query that produced them.</summary>
    private sealed record Loaded<T>(LoadKey Key, IReadOnlyList<T> Items);

    /// <summary>One source's list, whether it failed, and the cancellation source of its load in flight.</summary>
    private sealed class Slot<T>
    {
        public Loaded<T>? Items { get; set; }

        public bool Failed { get; set; }

        public CancellationTokenSource? Cts { get; set; }
    }
}
