@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Pages
@using VideoForensics.Client.Ui.Shared.Services.Review
@implements IDisposable
@inject ReviewPageState State
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ReviewPage> L

<nav class="review-view-nav" aria-label="@L["ViewNavLabel"]" data-testid="review-view-nav">
    <div role="tablist" aria-label="@L["TabsLabel"]">
        @foreach (ReviewTab tab in Enum.GetValues<ReviewTab>())
        {
            bool active = !OnLivePage && State.ActiveTab == tab;
            <div class="left-nav-entry">
                <button type="button"
                        role="tab"
                        class="e-btn left-nav-item @(active ? "e-primary" : "e-flat")"
                        aria-selected="@(active ? "true" : "false")"
                        data-testid="@TabTestId(tab)"
                        @onclick="() => OnTab(tab)">@L[TabKey(tab)]</button>
            </div>
        }
    </div>

    <div class="left-nav-entry">
        <button type="button" class="e-btn left-nav-item @(OnLivePage ? "e-primary" : "e-flat")" data-testid="review-live" @onclick="OnLive">@L["Live"]</button>
    </div>
</nav>

@code {
    protected override void OnInitialized()
    {
        State.OnChange += OnStateChanged;
    }

    private void OnStateChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    // The nav also sits in the Live page's left panel. There the tabs lead back to the review page, and Live is the current view.
    private bool OnLivePage => new Uri(NavigationManager.Uri).AbsolutePath.StartsWith("/live-view", StringComparison.OrdinalIgnoreCase);

    private void OnTab(ReviewTab tab)
    {
        if (!OnLivePage)
        {
            State.SetTab(tab);
            return;
        }

        NavigationManager.NavigateTo(tab == ReviewTab.Timeline ? "/media" : "/media?tab=" + tab);
    }

    private void OnLive()
    {
        NavigationManager.NavigateTo(State.LastShownCameraId is Guid camera ? $"/live-view?device={camera}" : "/live-view");
    }

    private static string TabKey(ReviewTab tab)
    {
        return tab switch
        {
            ReviewTab.Events => "TabEvents",
            ReviewTab.Detail => "TabDetail",
            _ => "TabTimeline",
        };
    }

    private static string TabTestId(ReviewTab tab)
    {
        return "review-tab-button-" + tab.ToString().ToLowerInvariant();
    }

    public void Dispose()
    {
        State.OnChange -= OnStateChanged;
    }
}
