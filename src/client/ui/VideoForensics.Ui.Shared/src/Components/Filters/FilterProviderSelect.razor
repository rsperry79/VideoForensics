@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Resources
@inject IStringLocalizer<SharedResources> L

<select class="@Class" data-testid="@TestId" aria-label="@L["ScopeProvider"]" @onchange="OnChanged">
    <option value="" selected="@(Value is null)">@L["ScopeAllProviders"]</option>
    @foreach (string provider in ProviderNames)
    {
        <option value="@provider" selected="@(Value == provider)">@provider</option>
    }
</select>

@code {
    /// <summary>The providers to offer, in display order.</summary>
    [Parameter]
    public IReadOnlyList<string> ProviderNames { get; set; } = [];

    /// <summary>The picked provider, or null for all providers.</summary>
    [Parameter]
    public string? Value { get; set; }

    /// <summary>Raised with the picked provider, or null when "all providers" is picked.</summary>
    [Parameter]
    public EventCallback<string?> ValueChanged { get; set; }

    /// <summary>The <c>data-testid</c> of the select.</summary>
    [Parameter]
    public string TestId { get; set; } = string.Empty;

    /// <summary>CSS classes of the select; the caller decides the styling.</summary>
    [Parameter]
    public string Class { get; set; } = "form-select form-select-sm";

    private Task OnChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        string? picked = e.Value?.ToString();
        return ValueChanged.InvokeAsync(string.IsNullOrWhiteSpace(picked) ? null : picked);
    }
}
