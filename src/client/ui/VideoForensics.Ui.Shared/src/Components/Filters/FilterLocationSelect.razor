@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Resources
@using VideoForensics.Client.Ui.Shared.Services.Scope
@inject IStringLocalizer<SharedResources> L

<select class="@Class" data-testid="@TestId" aria-label="@L["ScopeLocation"]" @onchange="OnChanged">
    <option value="" selected="@(Value is null)">@L["ScopeAllLocations"]</option>
    @foreach (FilterLocation location in Locations)
    {
        <option value="@location.Id" selected="@(Value == location.Id)">@location.Name</option>
    }
</select>

@code {
    /// <summary>The locations to offer, in display order.</summary>
    [Parameter]
    public IReadOnlyList<FilterLocation> Locations { get; set; } = [];

    /// <summary>The picked location, or null for all locations.</summary>
    [Parameter]
    public Guid? Value { get; set; }

    /// <summary>Raised with the picked location, or null when "all locations" is picked.</summary>
    [Parameter]
    public EventCallback<Guid?> ValueChanged { get; set; }

    /// <summary>The <c>data-testid</c> of the select.</summary>
    [Parameter]
    public string TestId { get; set; } = string.Empty;

    /// <summary>CSS classes of the select; the caller decides the styling.</summary>
    [Parameter]
    public string Class { get; set; } = "form-select form-select-sm";

    private Task OnChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        return ValueChanged.InvokeAsync(Guid.TryParse(e.Value?.ToString(), out Guid parsed) ? parsed : null);
    }
}
