@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Resources
@using VideoForensics.Client.Ui.Shared.Layout
@using VideoForensics.Client.Ui.Shared.Services
@inject IProviderAccountRepository AccountRepository
@inject IAccountExportService ExportService
@inject StepUpService StepUp
@inject PairedSessionState SessionState
@inject IStringLocalizer<SharedResources> L

<div class="p-3 border border-danger rounded mb-3" data-testid="account-remove-panel" role="group" aria-label="@L["AccountRemove_Title"]">
    <h5>@L["AccountRemove_Title"]</h5>
    @if (_errorMessage is not null)
    {
        <p class="text-danger">@_errorMessage</p>
    }
    @if (!_deleteStep)
    {
        <p>@L["AccountRemove_Prompt"]</p>
        <div class="d-flex gap-2 align-items-center">
            <SfButton CssClass="e-primary" Content="@L["AccountRemove_Retain"]" OnClick="RetainAsync" Disabled="@_isBusy" />
            @if (CanDeletePermanently)
            {
                <SfButton CssClass="e-danger" Content="@L["AccountRemove_DeletePermanently"]" OnClick="GoToDeleteStep" Disabled="@_isBusy" />
            }
            <SfButton CssClass="e-outline" Content="@L["AccountRemove_Cancel"]" OnClick="CancelAsync" Disabled="@_isBusy" />
        </div>
        <small class="text-muted">@L["AccountRemove_RetainHint"]</small>
    }
    else if (_purgeConfirm)
    {
        <p class="text-danger" data-testid="account-purge-confirm">@L["AccountRemove_PurgeConfirm"]</p>
        <div class="d-flex gap-2 align-items-center">
            <SfButton CssClass="e-danger" Content="@L["AccountRemove_PurgeConfirmButton"]" OnClick="PurgeAsync" Disabled="@_isBusy" />
            <SfButton CssClass="e-outline" Content="@L["AccountRemove_Cancel"]" OnClick="CancelPurgeConfirm" Disabled="@_isBusy" />
        </div>
    }
    else
    {
        <p>@L["AccountRemove_ExportPrompt"]</p>
        <div class="d-flex gap-2 align-items-center">
            <SfButton CssClass="e-primary" Content="@L["AccountRemove_ExportFirst"]" OnClick="ExportFirstAsync" Disabled="@_isBusy" />
            <SfButton CssClass="e-danger" Content="@L["AccountRemove_DeleteWithoutExport"]" OnClick="DeleteWithoutExportAsync" Disabled="@_isBusy" />
            <SfButton CssClass="e-danger" Content="@L["AccountRemove_ExportAndDelete"]" OnClick="AskPurgeConfirmAsync" Disabled="@_isBusy" />
            <SfButton CssClass="e-outline" Content="@L["AccountRemove_Cancel"]" OnClick="CancelAsync" Disabled="@_isBusy" />
        </div>
    }
</div>

@code {
    /// <summary>What happened when the operator finished the flow.</summary>
    public enum RemoveOutcome { Retained, Deleted, ExportQueued }

    /// <summary>Result of the remove flow; <paramref name="ExportJobId"/> is set only for <see cref="RemoveOutcome.ExportQueued"/>.</summary>
    public sealed record RemoveResult(Guid AccountId, RemoveOutcome Outcome, Guid? ExportJobId);

    private bool _deleteStep;
    private bool _purgeConfirm;
    private bool _isBusy;
    private string? _errorMessage;

    [Parameter, EditorRequired] public Guid AccountId { get; set; }

    /// <summary>Skips the retain/delete choice (used for accounts that are already retired).</summary>
    [Parameter] public bool StartAtDeleteStep { get; set; }

    [Parameter] public EventCallback<RemoveResult> OnCompleted { get; set; }

    [Parameter] public EventCallback OnCancelled { get; set; }

    /// <summary>
    /// Permanent delete is SuperAdmin on the Local tier, whatever the provider edit setting says. The server enforces this
    /// too; hiding the step here stops an Admin from reaching a button that would only fail.
    /// </summary>
    private bool CanDeletePermanently => PageAccessRules.Allows(AccessPolicy.SuperAdminLocal, NavContext.FromSession(SessionState, appLockSupported: false));

    protected override void OnInitialized()
    {
        _deleteStep = StartAtDeleteStep && CanDeletePermanently;
    }

    private void GoToDeleteStep()
    {
        _deleteStep = true;
    }

    private Task CancelAsync() => OnCancelled.InvokeAsync();

    /// <summary>The purge is irreversible, so the first click only asks; nothing is queued until the operator confirms.</summary>
    private Task AskPurgeConfirmAsync()
    {
        _purgeConfirm = true;
        return Task.CompletedTask;
    }

    private Task CancelPurgeConfirm()
    {
        _purgeConfirm = false;
        return Task.CompletedTask;
    }

    private Task RetainAsync() => RunAsync(async ct =>
    {
        string? token = await TryGetStepUpTokenAsync();
        if (token is null)
        {
            return null;
        }

        await AccountRepository.RetireAsync(AccountId, DateTime.UtcNow, ct, token);
        return new RemoveResult(AccountId, RemoveOutcome.Retained, null);
    });

    private Task DeleteWithoutExportAsync() => RunAsync(async ct =>
    {
        string? token = await TryGetStepUpTokenAsync();
        if (token is null)
        {
            return null;
        }

        await AccountRepository.DeleteAsync(AccountId, ct, token);
        return new RemoveResult(AccountId, RemoveOutcome.Deleted, null);
    });

    private Task ExportFirstAsync() => RunAsync(async ct =>
    {
        string? token = await TryGetStepUpTokenAsync();
        if (token is null)
        {
            return null;
        }

        // Export only: purge is disabled, so the account is kept. "Delete without export" is the separate, explicit delete.
        Guid jobId = await ExportService.QueueExportAsync(AccountId, false, ct, token);
        return new RemoveResult(AccountId, RemoveOutcome.ExportQueued, jobId);
    });

    /// <summary>Exports, then deletes the account's own rows. Shared locations, devices and events are not touched.</summary>
    private Task PurgeAsync() => RunAsync(async ct =>
    {
        string? token = await TryGetStepUpTokenAsync();
        if (token is null)
        {
            return null;
        }

        Guid jobId = await ExportService.QueueExportAsync(AccountId, true, ct, token);
        return new RemoveResult(AccountId, RemoveOutcome.ExportQueued, jobId);
    });

    /// <summary>Fetches a step-up token; on failure or cancel shows the localized message and returns null so the action is skipped.</summary>
    private async Task<string?> TryGetStepUpTokenAsync()
    {
        try
        {
            return await StepUp.GetStepUpTokenAsync();
        }
        catch (Exception)
        {
            _errorMessage = L["AccountRemove_StepUpFailed"];
            return null;
        }
    }

    private async Task RunAsync(Func<CancellationToken, Task<RemoveResult?>> action)
    {
        _isBusy = true;
        _errorMessage = null;
        try
        {
            RemoveResult? result = await action(CancellationToken.None);
            if (result is not null)
            {
                await OnCompleted.InvokeAsync(result);
            }
        }
        catch (Exception ex)
        {
            _errorMessage = L["AccountRemove_Error", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }
}
