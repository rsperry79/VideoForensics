@using System.Collections.Generic
@inject NavigationManager NavigationManager
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Resources
@inject IStringLocalizer<SharedResources> L

<div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem;">
    @if (Items != null && Items.Count >= 2)
    {
        <SfButton
            IconCss="e-icons e-chevron-left"
            CssClass="e-outline e-small"
            OnClick="@(() => NavigateToParent())"
            TrueName="Back"
            Title="@L["BreadcrumbBack"]" />
    }

    @if (Items != null && Items.Count > 0)
    {
        <nav aria-label="@L["BreadcrumbNavLabel"]">
            <ol class="breadcrumb-trail" style="display: flex; align-items: center; gap: 0.5rem; list-style: none; margin: 0; padding: 0;">
                @for (int i = 0; i < Items.Count; i++)
                {
                    var item = Items[i];
                    var isLast = i == Items.Count - 1;

                    @if (isLast || string.IsNullOrEmpty(item.Url))
                    {
                        <li aria-current="@(isLast ? "page" : null)" style="font-weight: 600; color: #333;">@item.Label</li>
                    }
                    else
                    {
                        <li><a href="@item.Url" style="text-decoration: none; color: #0066cc; cursor: pointer;">@item.Label</a></li>
                    }
                }
            </ol>
        </nav>
    }
</div>

@code {
    /// <summary>
    /// Ordered breadcrumb trail from root to current page.
    /// The LAST item's Url will always be null (it's the current page, not a link).
    /// All earlier items have a non-null Url.
    /// </summary>
    [Parameter]
    public List<(string Label, string? Url)>? Items { get; set; }

    private void NavigateToParent()
    {
        if (Items != null && Items.Count >= 2)
        {
            var parentUrl = Items[Items.Count - 2].Url;
            if (!string.IsNullOrEmpty(parentUrl))
            {
                NavigationManager.NavigateTo(parentUrl);
            }
        }
    }
}
