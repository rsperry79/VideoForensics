@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.DependencyInjection
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Client.Common.Viewer
@using VideoForensics.Client.Ui.Shared.Components.Review
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Services.Cases
@using VideoForensics.Client.Ui.Shared.Services.Review
@using VideoForensics.Client.Ui.Shared.Services.Scope
@implements IAsyncDisposable
@inject ScopeState ScopeState
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Resources
@inject IStringLocalizer<SharedResources> L
@inject IDeviceRepository DeviceRepository
@inject DeviceOwnershipService OwnershipService
@inject ICaseRepository CaseRepository
@inject CaseState CaseState
@inject PairedSessionState SessionState
@inject NavigationManager Nav
@inject TimeProvider TimeProvider
@inject IServiceProvider Services

<div class="scope-rail">
    <div class="scope-section" data-testid="scope-time-range">
        <ReviewSidebarSection Title="@L["ScopeTimeRange"]">
            <select class="form-select form-select-sm mb-2" data-testid="scope-range" aria-label="@L["ScopeTimeRange"]" @onchange="OnRangeChanged">
                <option value="day" selected="@(CurrentRange == ScopeRange.Last24Hours)">@L["ScopeRangeLast24Hours"]</option>
                <option value="week" selected="@(CurrentRange == ScopeRange.Last7Days)">@L["ScopeRangeLast7Days"]</option>
                <option value="month" selected="@(CurrentRange == ScopeRange.Last30Days)">@L["ScopeRangeLast30Days"]</option>
                <option value="custom" selected="@(CurrentRange == ScopeRange.Custom)">@L["ScopeRangeCustom"]</option>
            </select>

            @if (CurrentRange == ScopeRange.Custom)
            {
                @* One column: the From label and its picker, then the To label and its picker. *@
                <div class="scope-range-dates d-flex flex-column gap-2">
                    <label class="form-label small mb-0">
                        @L["ScopeFrom"]
                        <input type="date" class="form-control form-control-sm" data-testid="scope-range-from" value="@FromDateValue" @onchange="OnFromChanged" />
                    </label>
                    <label class="form-label small mb-0">
                        @L["ScopeTo"]
                        <input type="date" class="form-control form-control-sm" data-testid="scope-range-to" value="@ToDateValue" @onchange="OnToChanged" />
                    </label>
                </div>
            }
        </ReviewSidebarSection>
    </div>

    @if (_devicesLoaded)
    {
        @if (_deviceLoadError)
        {
            <div class="scope-rail-message">@L["ScopeDevicesUnavailable"]</div>
        }
        else
        {
            <div class="scope-section" data-testid="scope-provider-account">
                <ReviewSidebarSection Title="@L["ScopeFilters"]">
                    @* No labels above the dropdowns: each one's first option says what it filters, and each keeps its own aria-label. *@
                    <FilterProviderSelect ProviderNames="_providerNames" Value="@_providerFilter" ValueChanged="OnProviderPicked"
                                          TestId="scope-provider-filter" Class="form-select form-select-sm mb-2" />
                    <FilterAccountSelect Accounts="AccountOptions" AccountNames="_accountNames" Value="_accountFilter" ValueChanged="OnAccountPicked"
                                         TestId="scope-account-filter" Class="form-select form-select-sm mb-2" />
                    <FilterLocationSelect Locations="_locations" Value="_locationFilter" ValueChanged="OnLocationPicked"
                                          TestId="scope-location-filter" Class="form-select form-select-sm mb-2" />

                    @if (_visibleDevices.Count == 0)
                    {
                        <div class="scope-hint">@L["ScopeNoDevices"]</div>
                    }
                    else
                    {
                        @* The summary says which device is picked, or how many: the name for one, "N Devices" for more, "All devices" for all. *@
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100 text-start" data-testid="scope-device-button"
                                aria-expanded="@(_devicesOpen ? "true" : "false")" @onclick="OnDevicesToggled">@DeviceSummary</button>

                        @if (_devicesOpen)
                        {
                            <div class="scope-device-list" data-testid="scope-device-list">
                                @foreach (var device in _visibleDevices)
                                {
                                    <label class="scope-device-item">
                                        <input type="checkbox"
                                               data-device-id="@device.Id"
                                               checked="@IsDeviceSelected(device.Id)"
                                               @onchange="@(e => OnDeviceToggled(device.Id, e))" />
                                        <span>@device.Name</span>
                                    </label>
                                }
                            </div>
                        }
                    }
                </ReviewSidebarSection>
            </div>
        }

    }

    @* Case sits last, under the time range and the filters. *@
    <div class="scope-section">
        <ReviewSidebarSection Title="@L["ScopeCase"]">
            @if (_caseLoadError)
            {
                <div class="scope-rail-message">@L["ScopeCasesUnavailable"]</div>
            }
            else
            {
                <select class="form-select form-select-sm mb-1" data-testid="case-picker" aria-label="@L["ScopeCase"]" @onchange="OnCasePicked">
                    <option value="">@L["ScopeNoCase"]</option>
                    @foreach (var openCase in _openCases)
                    {
                        <option value="@openCase.Id" selected="@(CaseState.ActiveCase?.Id == openCase.Id)">@openCase.CaseNumber &middot; @openCase.Title</option>
                    }
                </select>

                @* A no-match filter is not a device list, so it can't be saved to a case as one. *@
                @if (ScopeRailRules.ShowSaveScopeToCase(CaseState.ActiveCase is not null, CaseState.ScopeDiffersFromCase, _role, ScopeState.Current.MatchesNoDevices))
                {
                    <button type="button" class="scope-quick-range-btn" data-testid="save-scope-to-case" @onclick="OnSaveScopeToCaseClicked">@L["ScopeSaveToCase"]</button>
                }

                @if (_saveScopeError is not null)
                {
                    <div class="scope-rail-message">@_saveScopeError</div>
                }
            }
            <a class="scope-hint" href="/cases">@L["ScopeAllCases"]</a>
        </ReviewSidebarSection>
    </div>
</div>

@code {
    // Quick-range button spans expressed in whole days back from "today" (date granularity, not a
    // rolling 24h/7d/30h duration): "24h" == today-1..today+1 (exclusive) so it renders as a single
    // full day either side of now, matching the other quick ranges' shape.
    private const int QuickRange24HoursDaysBack = 1;
    private const int QuickRange7DaysDaysBack = 7;
    private const int QuickRange30DaysDaysBack = 30;

    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private List<VideoForensics.Data.Common.Entities.Device> _visibleDevices = new();
    private List<ProviderAccount> _accounts = new();
    private Dictionary<Guid, string> _accountNames = new();
    private IReadOnlyList<DeviceOwnership> _ownership = Array.Empty<DeviceOwnership>();
    private IReadOnlyList<string> _providerNames = Array.Empty<string>();
    private string? _providerFilter;
    private Guid? _accountFilter;
    private IReadOnlyList<FilterLocation> _locations = Array.Empty<FilterLocation>();
    private Guid? _locationFilter;
    private bool _devicesLoaded = false;
    private bool _deviceLoadError = false;

    // The device list opens from its summary button; the time range shows its pickers once Custom is chosen.
    private bool _devicesOpen;
    private bool _customRange;

    // The settings Media shares with this rail. Resolved on demand, so a host that does not register the store just skips saving.
    private ReviewSettingsStore? _settings;

    private List<ForensicCase> _openCases = new();
    private bool _caseLoadError = false;
    private string? _saveScopeError;
    private OperatorRole? _role;

    private DateTime TodayUtc => TimeProvider.GetUtcNow().UtcDateTime.Date;

    private string FromDateValue => ScopeRailRules.FormatFromDate(ScopeState.Current.FromUtc);

    private string ToDateValue => ScopeRailRules.FormatToDate(ScopeState.Current.ToUtc);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _devices = (await DeviceRepository.ListAsync(CancellationToken.None)).ToList();
            _devicesLoaded = true;
        }
        catch
        {
            _deviceLoadError = true;
            _devicesLoaded = true;
        }

        if (!_deviceLoadError)
        {
            await LoadOwnershipAsync();
        }

        try
        {
            _openCases = (await CaseRepository.ListAsync(CaseStatus.Open, CancellationToken.None)).ToList();
        }
        catch
        {
            _caseLoadError = true;
        }

        await SessionState.EnsureLoadedAsync();
        _role = SessionState.Role is not null && Enum.TryParse<OperatorRole>(SessionState.Role, out var role) ? role : null;

        // Subscribe to location changes to apply query string
        Nav.LocationChanged += OnLocationChanged;

        // Subscribe to scope changes to update URL
        ScopeState.OnChange += OnScopeChanged;

        // Subscribe to case changes (e.g. active case closed/switched elsewhere)
        CaseState.OnChange += OnCaseStateChanged;

        // Apply initial query string from URL, then activate any case named by the URL. No
        // StateHasChanged here - this runs before the component's first render, which will
        // already reflect the applied scope/case.
        bool addressHasNoScope = new Uri(Nav.Uri).Query.Length == 0;
        ApplyUrlQueryStringCore();
        await ApplyCaseFromUrlAsync();

        // A bare address takes the settings last saved here or on Media. An address that carries a scope wins over them.
        _settings = Services.GetService<ReviewSettingsStore>();
        if (addressHasNoScope)
        {
            await RestoreSettingsAsync();
        }
    }

    /// <summary>
    /// Applies the settings saved by this rail or by Media: filters, devices, time range and case. When the saved devices are
    /// every camera, Media was only showing its default set, so the scope stays on all devices instead of narrowing to them.
    /// </summary>
    private async Task RestoreSettingsAsync()
    {
        SavedReviewSettings? saved = _settings is null ? null : await _settings.LoadAsync();
        if (saved is null)
        {
            return;
        }

        ReviewUrlState url = ReviewUrl.Parse(saved.Query);
        _providerFilter = url.Provider;
        _accountFilter = url.Account;
        _locationFilter = url.Location;
        RecomputeVisibleDevices();

        IReadOnlyList<Guid> devices = url.Devices;
        if (devices.Count > 0 && _devices.Where(d => DeviceKinds.IsCamera(d.Type)).All(d => devices.Contains(d.Id)))
        {
            devices = [];
        }

        // The rail works in whole days with an exclusive upper bound; a saved time of day rounds out to the day.
        DateTime from = url.FromUtc?.Date ?? ScopeState.Current.FromUtc;
        DateTime to = url.ToUtc is DateTime end ? (end.TimeOfDay == TimeSpan.Zero ? end : end.Date.AddDays(1)) : ScopeState.Current.ToUtc;
        if (to <= from)
        {
            (from, to) = (ScopeState.Current.FromUtc, ScopeState.Current.ToUtc);
        }

        ForensicScope restored = ScopeState.Current with { DeviceIds = devices, FromUtc = from, ToUtc = to, MatchesNoDevices = false };
        if (_providerFilter is not null || _accountFilter is not null || _locationFilter is not null)
        {
            restored = ScopeRailRules.ApplyFilters(restored, _visibleDevices.Select(d => d.Id).ToList(), _providerFilter, _accountFilter, _locationFilter);
        }

        ScopeState.Set(restored);

        if (url.CaseId is Guid caseId)
        {
            await CaseState.ActivateAsync(caseId, CancellationToken.None);
        }
    }

    /// <summary>Saves this rail's settings into the shared copy, keeping what Media owns (the tab and the cursor).</summary>
    private async Task SaveSettingsAsync()
    {
        if (_settings is null)
        {
            return;
        }

        ForensicScope scope = ScopeState.Current;
        string? provider = _providerFilter;
        Guid? account = _accountFilter;
        Guid? location = _locationFilter;
        Guid? caseId = CaseState.ActiveCase?.Id;
        await _settings.UpdateAsync(current =>
        {
            // Media shows at most nine cameras, so only that many ids go into the shared copy.
            ReviewUrlState next = ReviewUrl.Parse(current.Query) with
            {
                Devices = scope.DeviceIds.Take(CameraSync.MaxTiles).ToList(),
                FromUtc = scope.FromUtc,
                ToUtc = scope.ToUtc,
                Provider = provider,
                Account = account,
                Location = location,
                CaseId = caseId,
            };
            return current with { Query = ReviewUrl.Build(next) };
        });
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Raised outside the component's render/event sync context, so marshal back onto it.
        _ = InvokeAsync(async () =>
        {
            ApplyUrlQueryStringCore();
            await ApplyCaseFromUrlAsync();
            StateHasChanged();
        });
    }

    private void ApplyUrlQueryStringCore()
    {
        var uri = new Uri(Nav.Uri);
        ScopeState.ApplyQueryString(uri.Query);

        // A no-match flag restored from the URL is only meaningful while a Provider/Account filter is shown.
        // This rail does not restore its filter controls from the URL, so an orphaned flag is dropped rather than
        // left blocking every page with a notice the operator cannot act on.
        var scope = ScopeRailRules.ClearOrphanedNoMatch(ScopeState.Current, _providerFilter, _accountFilter, _locationFilter);
        if (scope != ScopeState.Current)
        {
            ScopeState.Set(scope);
        }
    }

    private async Task ApplyCaseFromUrlAsync()
    {
        var caseId = CaseUrl.Read(Nav.Uri);
        if (caseId == CaseState.ActiveCase?.Id)
        {
            return;
        }

        if (caseId.HasValue)
        {
            await CaseState.ActivateAsync(caseId.Value, CancellationToken.None);
        }
        else
        {
            CaseState.Deactivate();
        }
    }

    private void OnScopeChanged()
    {
        UpdateUrl();
        _ = SaveSettingsAsync();

        // ScopeState can change from outside this component's own handlers (another component
        // sharing the same scoped ScopeState instance), so marshal back onto the sync context.
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateUrl()
    {
        var scopeQuery = ScopeState.ToQueryString();
        var currentUri = Nav.Uri;
        var newUri = ScopeUrl.Merge(currentUri, scopeQuery);

        if (newUri != currentUri)
        {
            Nav.NavigateTo(newUri, new NavigationOptions { ReplaceHistoryEntry = true });
        }
    }

    /// <summary>
    /// Loads the provider accounts and their locations so devices can be narrowed by provider and account.
    /// A failure leaves the filters empty and every device visible rather than hiding the device list.
    /// </summary>
    private async Task LoadOwnershipAsync()
    {
        var snapshot = await OwnershipService.LoadAsync(_devices, CancellationToken.None);
        _accounts = snapshot.Accounts.ToList();
        _accountNames = snapshot.AccountNames.ToDictionary(kv => kv.Key, kv => kv.Value);
        _ownership = snapshot.Ownership;
        _providerNames = snapshot.ProviderNames;
        _locations = snapshot.Locations;
        RecomputeVisibleDevices();
    }

    private IReadOnlyList<ProviderAccount> AccountOptions => ScopeDeviceFilter.AccountsForProvider(_accounts, _providerFilter);

    private void RecomputeVisibleDevices()
    {
        _visibleDevices = ScopeRailRules.VisibleDevices(_devices, _ownership, _providerFilter, _accountFilter, _locationFilter).ToList();
    }

    private void OnProviderPicked(string? provider)
    {
        // An account outside the newly picked provider is cleared by the rule.
        (_providerFilter, _accountFilter) = ScopeRailRules.ApplyProviderPick(_accounts, _accountFilter, provider);
        ApplyFilters();
    }

    private void OnAccountPicked(Guid? account)
    {
        _accountFilter = account;
        ApplyFilters();
    }

    private void OnLocationPicked(Guid? location)
    {
        _locationFilter = location;
        ApplyFilters();
    }

    /// <summary>
    /// Recomputes the visible device list and, while a provider, account or location filter is active, scopes the
    /// investigation to exactly the visible devices. Clearing the filters keeps the current device selection.
    /// </summary>
    private void ApplyFilters()
    {
        RecomputeVisibleDevices();

        var visibleIds = _visibleDevices.Select(d => d.Id).ToList();
        ScopeState.Set(ScopeRailRules.ApplyFilters(ScopeState.Current, visibleIds, _providerFilter, _accountFilter, _locationFilter));

        // A filter change may leave the scope as it was, so it does not always raise OnScopeChanged.
        _ = SaveSettingsAsync();
    }

    private bool IsDeviceSelected(Guid deviceId) => ScopeState.Current.DeviceIds.Contains(deviceId);

    private void OnDeviceToggled(Guid deviceId, Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        var isChecked = e.Value is bool value && value;
        ScopeState.Set(ScopeRailRules.ToggleDevice(ScopeState.Current, deviceId, isChecked, _providerFilter, _accountFilter, _locationFilter));
    }

    private void OnFromChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (ScopeRailRules.TryParseDateInput(e.Value?.ToString(), out var date))
        {
            ScopeState.Set(ScopeRailRules.SetFromDate(ScopeState.Current, date));
        }
    }

    private void OnToChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (ScopeRailRules.TryParseDateInput(e.Value?.ToString(), out var date))
        {
            ScopeState.Set(ScopeRailRules.SetToDate(ScopeState.Current, date));
        }
    }

    private enum ScopeRange
    {
        Last24Hours,
        Last7Days,
        Last30Days,
        Custom,
    }

    /// <summary>The preset whose whole-day window matches the scope, or Custom. Picking Custom keeps it selected while the dates are edited.</summary>
    private ScopeRange CurrentRange
    {
        get
        {
            if (_customRange)
            {
                return ScopeRange.Custom;
            }

            (ScopeRange Range, int DaysBack)[] presets =
            [
                (ScopeRange.Last24Hours, QuickRange24HoursDaysBack),
                (ScopeRange.Last7Days, QuickRange7DaysDaysBack),
                (ScopeRange.Last30Days, QuickRange30DaysDaysBack),
            ];
            foreach ((ScopeRange range, int daysBack) in presets)
            {
                ForensicScope preset = ScopeRailRules.ApplyQuickRange(ScopeState.Current, TodayUtc, daysBack);
                if (preset.FromUtc == ScopeState.Current.FromUtc && preset.ToUtc == ScopeState.Current.ToUtc)
                {
                    return range;
                }
            }

            return ScopeRange.Custom;
        }
    }

    private void OnRangeChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        string? value = e.Value?.ToString();
        if (value == "custom")
        {
            // Only the pickers appear; the window stays as it is until a date is entered.
            _customRange = true;
            return;
        }

        _customRange = false;
        OnQuickRangeClicked(value switch
        {
            "week" => QuickRange7DaysDaysBack,
            "month" => QuickRange30DaysDaysBack,
            _ => QuickRange24HoursDaysBack,
        });
    }

    private void OnQuickRangeClicked(int daysBack)
    {
        ScopeState.Set(ScopeRailRules.ApplyQuickRange(ScopeState.Current, TodayUtc, daysBack));
    }

    private void OnDevicesToggled()
    {
        _devicesOpen = !_devicesOpen;
    }

    /// <summary>The device button's text: all devices, the one device's name, or how many are picked.</summary>
    private string DeviceSummary
    {
        get
        {
            IReadOnlyList<Guid> chosen = ScopeState.Current.DeviceIds;
            bool all = ScopeState.Current.IncludesAllDevices
                || (_visibleDevices.Count > 0 && _visibleDevices.All(d => chosen.Contains(d.Id)));
            if (all)
            {
                return L["ScopeAllDevices"].Value;
            }

            if (chosen.Count == 1)
            {
                VideoForensics.Data.Common.Entities.Device? only = _devices.FirstOrDefault(d => d.Id == chosen[0]);
                return only?.Name ?? chosen[0].ToString("D");
            }

            return L["ScopeDevicesCount", chosen.Count].Value;
        }
    }

    private async Task OnCasePicked(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _saveScopeError = null;
        var value = e.Value?.ToString();
        var caseId = Guid.TryParse(value, out var parsed) ? (Guid?)parsed : null;

        // Unsubscribe while activating/deactivating so the scope change this may trigger doesn't
        // write a scope-only URL update in between - the case key is written together with the
        // scope below in a single navigation instead.
        ScopeState.OnChange -= OnScopeChanged;
        try
        {
            if (caseId.HasValue)
            {
                await CaseState.ActivateAsync(caseId.Value, CancellationToken.None);
            }
            else
            {
                CaseState.Deactivate();
            }
        }
        finally
        {
            ScopeState.OnChange += OnScopeChanged;
        }

        UpdateUrlWithCase(caseId);
    }

    private void UpdateUrlWithCase(Guid? caseId)
    {
        var scopeQuery = ScopeState.ToQueryString();
        var currentUri = Nav.Uri;
        var withScope = ScopeUrl.Merge(currentUri, scopeQuery);
        var withCase = CaseUrl.Merge(withScope, caseId);

        if (withCase != currentUri)
        {
            Nav.NavigateTo(withCase, new NavigationOptions { ReplaceHistoryEntry = true });
        }
    }

    private async Task OnSaveScopeToCaseClicked()
    {
        _saveScopeError = null;
        try
        {
            var actor = SessionState.OperatorId?.ToString() ?? "unknown";
            await CaseState.SaveScopeToCaseAsync(actor, CancellationToken.None);
        }
        catch (InvalidOperationException ex)
        {
            _saveScopeError = ex.Message;
        }
    }

    private void OnCaseStateChanged()
    {
        // CaseState can change from outside this component (e.g. another component sharing the
        // same scoped CaseState instance), so marshal back onto the sync context.
        _ = SaveSettingsAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        Nav.LocationChanged -= OnLocationChanged;
        ScopeState.OnChange -= OnScopeChanged;
        CaseState.OnChange -= OnCaseStateChanged;
        await ValueTask.CompletedTask;
    }
}
