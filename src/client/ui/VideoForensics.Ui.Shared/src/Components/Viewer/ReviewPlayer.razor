@implements IAsyncDisposable
@using Microsoft.Extensions.Localization
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> L
@using Microsoft.AspNetCore.Components.Web
@using VideoForensics.Client.Common.Viewer
@using VideoForensics.Client.Ui.Shared.Resources

@if (_url is null)
{
    <div class="review-player-gap" data-testid="review-player-gap">@L["ReviewPlayerGap"]</div>
}
else
{
    <video class="review-player" data-testid="review-player" data-clip-id="@_selection!.ClipId" src="@_url" controls preload="metadata" @ref="_video"></video>
}

@code {
    /// <summary>The media-viewer script that reads the video's playback position. Imported on the first read.</summary>
    private const string MediaViewerScript = "./_content/VideoForensics.Client.Ui.Shared/scripts/media-viewer.js";

    private IJSObjectReference? _mediaViewerModule;

    /// <summary>
    /// Reads the video's current playback position in whole milliseconds. Returns null when no video is rendered (the cursor
    /// is in a gap) or when the browser call fails, so the caller shows a message rather than a guessed position.
    /// </summary>
    public async Task<long?> GetCurrentTimeMsAsync()
    {
        if (_url is null)
        {
            return null;
        }

        try
        {
            _mediaViewerModule ??= await JS.InvokeAsync<IJSObjectReference>("import", MediaViewerScript);
            if (_mediaViewerModule is null)
            {
                return null;
            }

            double currentTimeMs = await _mediaViewerModule.InvokeAsync<double>("getCurrentTimeMs", _video);
            return (long)Math.Round(currentTimeMs);
        }
        catch (JSDisconnectedException)
        {
            return null;
        }
        catch (JSException)
        {
            return null;
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        if (_mediaViewerModule is not null)
        {
            try
            {
                await _mediaViewerModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone, so there is nothing left to release.
            }
        }
    }

    /// <summary>Clips for this camera. The player picks the one covering <see cref="Cursor"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ClipWindow> Clips { get; set; } = [];

    /// <summary>Maps a clip id to its playable URL (for example a media content URL with a ticket).</summary>
    [Parameter, EditorRequired] public Func<string, string?> ContentUrlFor { get; set; } = _ => null;

    /// <summary>The shared playback time (UTC). A change re-selects the clip and seeks to the offset.</summary>
    [Parameter] public DateTime? Cursor { get; set; }

    private ClipSelection? _selection;
    private ClipWindow? _selectedClip;
    private string? _url;
    private ElementReference _video;
    private bool _seekPending;

    /// <summary>
    /// Reads the playback position as absolute UTC seconds since the Unix epoch: the selected clip's start plus the
    /// video's current offset. Returns null when no clip is selected or no video is rendered.
    /// </summary>
    public async Task<double?> ReadPlaybackUtcSecondsAsync()
    {
        if (_selectedClip is null || _url is null)
        {
            return null;
        }

        double offsetSeconds = await JS.InvokeAsync<double>("vfGetVideoTime", _video);
        return (_selectedClip.StartUtc - DateTime.UnixEpoch).TotalSeconds + offsetSeconds;
    }

    /// <summary>
    /// Seeks the video to an absolute UTC time. Does nothing when the time falls outside the selected clip, so a tile
    /// in a gap keeps playing where it is.
    /// </summary>
    public async Task SeekToUtcAsync(DateTime utc)
    {
        if (_selectedClip is null || _url is null)
        {
            return;
        }

        double offsetSeconds = (utc - _selectedClip.StartUtc).TotalSeconds;
        if (offsetSeconds < 0 || offsetSeconds > _selectedClip.DurationSeconds)
        {
            return;
        }

        await JS.InvokeVoidAsync("vfSetVideoTime", _video, offsetSeconds);
    }

    protected override void OnParametersSet()
    {
        _selection = Cursor is DateTime time ? ReviewTimeline.ClipAt(Clips, time) : null;
        _selectedClip = _selection is null ? null : Clips.FirstOrDefault(c => c.Id == _selection.ClipId);
        _url = _selection is null ? null : ContentUrlFor(_selection.ClipId);
        _seekPending = _url is not null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_seekPending && _selection is not null && _url is not null)
        {
            _seekPending = false;
            await JS.InvokeVoidAsync("vfSetVideoTime", _video, _selection.OffsetSeconds);
        }
    }
}
