@using VideoForensics.Client.Common.Viewer

@* Picks the clip that covers the cursor and hands it to MediaPlayer. A cursor in a gap shows the gap message. *@
<MediaPlayer @ref="_player"
             Source="@_url"
             SourceStartUtc="_selectedClip?.StartUtc"
             SourceDurationSeconds="_selectedClip?.DurationSeconds"
             Cursor="Cursor"
             Gap="true"
             Class="review-player"
             data-clip-id="@_selection?.ClipId" />

@code {
    /// <summary>Clips for this camera. The player picks the one covering <see cref="Cursor"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<ClipWindow> Clips { get; set; } = [];

    /// <summary>Maps a clip id to its playable URL (for example a media content URL with a ticket).</summary>
    [Parameter, EditorRequired] public Func<string, string?> ContentUrlFor { get; set; } = _ => null;

    /// <summary>The shared playback time (UTC). A change re-selects the clip and seeks to the offset.</summary>
    [Parameter] public DateTime? Cursor { get; set; }

    private ClipSelection? _selection;
    private ClipWindow? _selectedClip;
    private string? _url;
    private MediaPlayer? _player;

    /// <summary>
    /// Reads the video's current playback position in whole milliseconds. Returns null when no video is rendered (the cursor
    /// is in a gap) or when the browser call fails, so the caller shows a message rather than a guessed position.
    /// </summary>
    public Task<long?> GetCurrentTimeMsAsync() =>
        _player is null ? Task.FromResult<long?>(null) : _player.GetCurrentTimeMsAsync();

    /// <summary>
    /// Reads the playback position as absolute UTC seconds since the Unix epoch: the selected clip's start plus the
    /// video's current offset. Returns null when no clip is selected or no video is rendered.
    /// </summary>
    public Task<double?> ReadPlaybackUtcSecondsAsync() =>
        _player is null ? Task.FromResult<double?>(null) : _player.GetPlaybackUtcSecondsAsync();

    /// <summary>
    /// Seeks the video to an absolute UTC time. Does nothing when the time falls outside the selected clip, so a tile
    /// in a gap keeps playing where it is.
    /// </summary>
    public Task SeekToUtcAsync(DateTime utc) =>
        _player is null ? Task.CompletedTask : _player.SeekToUtcAsync(utc);

    protected override void OnParametersSet()
    {
        _selection = Cursor is DateTime time ? ReviewTimeline.ClipAt(Clips, time) : null;
        _selectedClip = _selection is null ? null : Clips.FirstOrDefault(c => c.Id == _selection.ClipId);
        _url = _selection is null ? null : ContentUrlFor(_selection.ClipId);
    }
}
