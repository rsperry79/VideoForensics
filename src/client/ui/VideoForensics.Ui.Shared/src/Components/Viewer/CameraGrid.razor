@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Common.Viewer
@using VideoForensics.Client.Ui.Shared.Resources
@inject IStringLocalizer<SharedResources> L

@if (!CameraSync.IsTileCountAllowed(Tiles.Count))
{
    <div class="camera-grid-limit" data-testid="camera-grid-limit">@string.Format(L["CameraGridLimit"], CameraSync.MaxTiles)</div>
}
else
{
    <div class="camera-grid" data-testid="camera-grid">
        @for (int i = 0; i < Tiles.Count; i++)
        {
            CameraTile tile = Tiles[i];
            int index = i;
            <figure class="camera-tile" data-testid="camera-tile">
                <figcaption>@tile.Label</figcaption>
                @if (index == 0)
                {
                    @* The first camera is the full player with its own controls. *@
                    <ReviewPlayer @ref="_firstPlayer" Clips="tile.Clips" ContentUrlFor="tile.ContentUrlFor" Cursor="Cursor" />
                }
                else
                {
                    @* Every other camera is a muted preview that follows the shared cursor. A click opens it as the single view. *@
                    CameraPreview preview = PreviewFor(tile);
                    <button type="button" class="camera-tile-preview" data-testid="camera-tile-preview" data-camera-index="@index" aria-label="@tile.Label" @onclick="() => OnSelect.InvokeAsync(index)">
                        @if (preview.Clip is null || preview.Url is null)
                        {
                            <span class="camera-tile-placeholder" data-testid="camera-tile-placeholder">@L["ReviewPlayerGap"]</span>
                        }
                        else
                        {
                            <MediaPlayer Source="@preview.Url" SourceStartUtc="@preview.Clip.StartUtc" Cursor="Cursor" Muted="true" Loop="true" Autoplay="true" Controls="MediaPlayerControls.None" />
                        }
                    </button>
                }
            </figure>
        }
    </div>
}

@code {
    /// <summary>One entry per camera. The grid refuses more than <see cref="CameraSync.MaxTiles"/>.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<CameraTile> Tiles { get; set; } = [];

    /// <summary>Shared playback time (UTC) that every tile follows.</summary>
    [Parameter] public DateTime? Cursor { get; set; }

    /// <summary>Raised with a tile's index when its preview is clicked.</summary>
    [Parameter] public EventCallback<int> OnSelect { get; set; }

    // The first camera's full player, which the grid's transport bar drives.
    private ReviewPlayer? _firstPlayer;

    /// <summary>Plays or pauses the first camera. Does nothing when there is no full player (a gap, or no cameras).</summary>
    public Task TogglePlayAsync() => _firstPlayer is null ? Task.CompletedTask : _firstPlayer.TogglePlayAsync();

    /// <summary>Steps the first camera by a number of seconds (negative goes back).</summary>
    public Task StepAsync(double seconds) => _firstPlayer is null ? Task.CompletedTask : _firstPlayer.StepAsync(seconds);

    /// <summary>The clip covering the cursor for one tile, and its preview URL. Either is null in a gap or with no preview.</summary>
    private sealed record CameraPreview(ClipWindow? Clip, string? Url);

    private CameraPreview PreviewFor(CameraTile tile)
    {
        if (Cursor is not DateTime time)
        {
            return new CameraPreview(null, null);
        }

        ClipSelection? selection = ReviewTimeline.ClipAt(tile.Clips, time);
        ClipWindow? clip = selection is null ? null : tile.Clips.FirstOrDefault(c => c.Id == selection.ClipId);
        string? url = clip is null ? null : tile.PreviewUrlFor?.Invoke(clip.Id);
        return new CameraPreview(clip, url);
    }
}
