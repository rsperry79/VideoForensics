@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> L
@using VideoForensics.Client.Common.Viewer
@using VideoForensics.Client.Ui.Shared.Resources

@if (_hasMain)
{
    <ReviewPlayer @ref="_mainPlayer" Clips="Cameras[SelectedIndex].Clips" ContentUrlFor="Cameras[SelectedIndex].ContentUrlFor" Cursor="Cursor" />
}

@if (_previewIndexes.Count > 0)
{
    <div class="single-camera-others-caption">@L["SingleCameraOthers"]</div>
    <div class="single-camera-strip">
        @foreach (int index in _previewIndexes)
        {
            CameraTile camera = Cameras[index];
            ClipWindow? previewClip = PreviewClipOf(camera);
            string? previewUrl = previewClip is null ? null : camera.PreviewUrlFor?.Invoke(previewClip.Id);
            DateTime? previewStartUtc = previewClip?.StartUtc;
            <button type="button" class="single-camera-preview" data-testid="single-camera-preview" data-camera-index="@index" title="@camera.Label" @onclick="() => OnSelect.InvokeAsync(index)">
                @if (previewUrl is null)
                {
                    <div class="single-camera-placeholder" data-testid="single-camera-placeholder">@L["ReviewPlayerGap"]</div>
                }
                else
                {
                    <MediaPlayer Source="@previewUrl" SourceStartUtc="@previewStartUtc" Cursor="Cursor" Muted="true" Loop="true" Autoplay="true" Controls="MediaPlayerControls.None" />
                }
                <span class="single-camera-caption">@camera.Label</span>
            </button>
        }
    </div>
}

@code {
    // The main player, read by the timeline tab's Grab still button for the playback position.
    private ReviewPlayer? _mainPlayer;

    /// <summary>
    /// Reads the main player's playback position in milliseconds. Null when no main player is rendered (no camera is
    /// selected) or when the player has no video at the cursor.
    /// </summary>
    public Task<long?> GetCurrentTimeMsAsync()
    {
        return _mainPlayer is null ? Task.FromResult<long?>(null) : _mainPlayer.GetCurrentTimeMsAsync();
    }

    /// <summary>Every camera. The entry at <see cref="SelectedIndex"/> plays large; the others appear as preview tiles.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<CameraTile> Cameras { get; set; } = [];

    /// <summary>Index into <see cref="Cameras"/> of the camera shown large.</summary>
    [Parameter] public int SelectedIndex { get; set; }

    /// <summary>Shared playback time (UTC). The main player and each preview follow it.</summary>
    [Parameter] public DateTime? Cursor { get; set; }

    /// <summary>Raised with the index (into <see cref="Cameras"/>) of a preview tile the user clicked.</summary>
    [Parameter] public EventCallback<int> OnSelect { get; set; }

    private bool _hasMain => SelectedIndex >= 0 && SelectedIndex < Cameras.Count;

    // Every camera except the one shown large, in list order. An out-of-range selection means no selection, so no tiles.
    private List<int> _previewIndexes => _hasMain
        ? Enumerable.Range(0, Cameras.Count).Where(i => i != SelectedIndex).ToList()
        : new List<int>();

    /// <summary>
    /// Returns the clip that covers the cursor. Null when there is no cursor or no clip covers it. A preview is a 1 fps copy of
    /// its clip, so the cursor's offset into the clip gives the same moment as the main camera.
    /// </summary>
    private ClipWindow? PreviewClipOf(CameraTile camera)
    {
        if (Cursor is not DateTime time)
        {
            return null;
        }

        ClipSelection? selection = ReviewTimeline.ClipAt(camera.Clips, time);
        return selection is null ? null : camera.Clips.FirstOrDefault(c => c.Id == selection.ClipId);
    }
}
