@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResources> L
@using VideoForensics.Client.Common.Viewer
@using VideoForensics.Client.Ui.Shared.Resources

@if (_hasMain)
{
    <ReviewPlayer Clips="Cameras[SelectedIndex].Clips" ContentUrlFor="Cameras[SelectedIndex].ContentUrlFor" Cursor="Cursor" />
}

@if (_previewIndexes.Count > 0)
{
    <div class="single-camera-others-caption">@L["SingleCameraOthers"]</div>
    <div class="single-camera-strip" style="display:flex;gap:8px;overflow-x:auto;">
        @foreach (int index in _previewIndexes)
        {
            CameraTile camera = Cameras[index];
            string? previewUrl = PreviewUrlOf(camera);
            <button type="button" class="single-camera-preview" data-testid="single-camera-preview" data-camera-index="@index" title="@camera.Label" style="flex:0 0 160px;display:flex;flex-direction:column;gap:4px;padding:0;border:0;background:none;cursor:pointer;" @onclick="() => OnSelect.InvokeAsync(index)">
                @if (previewUrl is null)
                {
                    <div class="single-camera-placeholder" data-testid="single-camera-placeholder" style="width:100%;aspect-ratio:16/9;background:#222;"></div>
                }
                else
                {
                    <video src="@previewUrl" muted loop autoplay playsinline preload="metadata" style="width:100%;aspect-ratio:16/9;background:#000;"></video>
                }
                <span class="single-camera-caption">@camera.Label</span>
            </button>
        }
    </div>
}

@code {
    /// <summary>Every camera. The entry at <see cref="SelectedIndex"/> plays large; the others appear as preview tiles.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<CameraTile> Cameras { get; set; } = [];

    /// <summary>Index into <see cref="Cameras"/> of the camera shown large.</summary>
    [Parameter] public int SelectedIndex { get; set; }

    /// <summary>Shared playback time (UTC). The main player and each preview follow it.</summary>
    [Parameter] public DateTime? Cursor { get; set; }

    /// <summary>Raised with the index (into <see cref="Cameras"/>) of a preview tile the user clicked.</summary>
    [Parameter] public EventCallback<int> OnSelect { get; set; }

    private bool _hasMain => SelectedIndex >= 0 && SelectedIndex < Cameras.Count;

    // Every camera except the one shown large, in list order.
    private List<int> _previewIndexes => Enumerable.Range(0, Cameras.Count).Where(i => i != SelectedIndex).ToList();

    /// <summary>
    /// Returns the preview URL for the clip that covers the cursor. Null when there is no cursor, no clip covers it, or the
    /// camera has no preview source, so the tile shows a placeholder instead of a video.
    /// </summary>
    private string? PreviewUrlOf(CameraTile camera)
    {
        if (Cursor is not DateTime time)
        {
            return null;
        }

        ClipSelection? selection = ReviewTimeline.ClipAt(camera.Clips, time);
        return selection is null ? null : camera.PreviewUrlFor?.Invoke(selection.ClipId);
    }
}
