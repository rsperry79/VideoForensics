@inject IStringLocalizer<MediaViewer> L
@using VideoForensics.Client.Ui.Shared.Components.Viewer
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Services.Evidence
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization

<div class="media-viewer" data-testid="media-viewer" tabindex="0" @onkeydown="HandleKeydown" @ref="_rootElement">
    <!-- Header -->
    <div class="viewer-header">
        <span>@Item.Label · @Item.DeviceName · <LocalTimeText Value="@Item.OccurredAtUtc" Format="yyyy-MM-dd HH:mm:ss" /></span>
        <span class="viewer-hash" title="@Item.Media?.Sha256Hash">
            @if (!string.IsNullOrEmpty(Item.Media?.Sha256Hash) && Item.Media.Sha256Hash.Length >= 12)
            {
                @Item.Media.Sha256Hash.Substring(0, 12)
            }
        </span>
    </div>

    <!-- Toolbar -->
    @if (!string.IsNullOrEmpty(ContentUrl))
    {
        <div class="viewer-toolbar">
            @if (MediaFormatHelper.IsImage(Item.Media?.MediaFormat))
            {
                <!-- Image toolbar -->
                <button class="btn btn-sm btn-outline-secondary" data-testid="zoom-in" @onclick="ZoomIn">+</button>
                <button class="btn btn-sm btn-outline-secondary" data-testid="zoom-out" @onclick="ZoomOut">-</button>
                <button class="btn btn-sm btn-outline-secondary" data-testid="zoom-fit" @onclick="ZoomFit">@L["ZoomFit"]</button>
            }
            else if (MediaFormatHelper.IsVideo(Item.Media?.MediaFormat))
            {
                <!-- Video toolbar -->
                <select class="form-select form-select-sm speed-select" data-testid="speed" @onchange="ChangePlaybackSpeed">
                    <option value="0.25">0.25x</option>
                    <option value="0.5">0.5x</option>
                    <option value="1" selected>1x</option>
                    <option value="1.5">1.5x</option>
                    <option value="2">2x</option>
                </select>
                <button class="btn btn-sm btn-outline-secondary" data-testid="frame-back" @onclick="FrameBack">@L["FrameBackLabel"]</button>
                <button class="btn btn-sm btn-outline-secondary" data-testid="frame-forward" @onclick="FrameForward">@L["FrameForwardLabel"]</button>
                <button class="btn btn-sm btn-outline-secondary" data-testid="play-toggle" @onclick="PlayToggle">▶</button>
                @if (CanGrabStill)
                {
                    <button class="btn btn-sm btn-outline-secondary" data-testid="grab-still" title="@L["GrabStillTitle"]" @onclick="GrabStillAsync" disabled="@(StillCaptureStatus?.InProgress == true)">@L["GrabStillLabel"]</button>
                }
            }
        </div>
    }

    @if (StillCaptureStatus is not null)
    {
        <div class="viewer-still-capture">
            @if (StillCaptureStatus.InProgress)
            {
                <span data-testid="grab-still-progress">@L["GrabStillInProgress"]</span>
            }
            else if (StillCaptureStatus.ErrorMessage is not null)
            {
                <span class="text-danger" data-testid="grab-still-error">@L["GrabStillErrorPrefix"] @StillCaptureStatus.ErrorMessage</span>
            }
            else if (StillCaptureStatus.Sha256Hash is not null)
            {
                <span data-testid="grab-still-result">
                    @L["GrabStillResultPrefix"] @StillCaptureStatus.Sha256Hash
                    @if (StillCaptureStatus.OpenUrl is not null)
                    {
                        <a href="@StillCaptureStatus.OpenUrl" target="_blank" rel="noopener" data-testid="grab-still-open">@L["GrabStillOpenLabel"]</a>
                    }
                </span>
            }
        </div>
    }

    <!-- Media area -->
    <div class="viewer-media">
        @if (string.IsNullOrEmpty(ContentUrl))
        {
            <div class="viewer-unavailable">
                @L["MediaPreviewUnavailable"]
            </div>
        }
        else if (MediaFormatHelper.IsImage(Item.Media?.MediaFormat))
        {
            <img src="@ContentUrl"
                 class="@GetImageCssClass()"
                 style="@_viewport.ToCssTransform()"
                 @onwheel="HandleMouseWheel"
                 @onmousedown="HandleMouseDown"
                 @onmousemove="HandleMouseMove"
                 @onmouseup="HandleMouseUp"
                 @onmouseleave="HandleMouseUp" />
        }
        else if (MediaFormatHelper.IsVideo(Item.Media?.MediaFormat))
        {
            <MediaPlayer @ref="_player" Source="@ContentUrl" PlaybackRate="_playbackRate" />
        }
    </div>

    <!-- Footer -->
    <div class="viewer-footer">
        <button class="btn btn-sm btn-outline-secondary" data-testid="viewer-prev" disabled="@(!HasPrevious)" @onclick="OnPrevious">@L["ViewerPrev"]</button>
        <button class="btn btn-sm btn-outline-secondary" data-testid="viewer-next" disabled="@(!HasNext)" @onclick="OnNext">@L["ViewerNext"]</button>
        <button class="btn btn-sm btn-outline-secondary" data-testid="viewer-close" @onclick="OnClose">@L["ViewerClose"]</button>
    </div>
</div>

@code {
    [Parameter]
    public required EvidenceItem Item { get; set; }

    [Parameter]
    public string? ContentUrl { get; set; }

    [Parameter]
    public bool HasPrevious { get; set; }

    [Parameter]
    public bool HasNext { get; set; }

    [Parameter]
    public EventCallback OnPrevious { get; set; }

    [Parameter]
    public EventCallback OnNext { get; set; }

    [Parameter]
    public EventCallback OnClose { get; set; }

    /// <summary>
    /// Invoked when the operator grabs the current video frame as a new evidence still, with the
    /// current playback position (milliseconds into the source video). Only wired up for video
    /// items; the parent (e.g. ReviewPage.razor) is responsible for calling the capture service and
    /// updating <see cref="StillCaptureStatus"/> with the result.
    /// </summary>
    [Parameter]
    public EventCallback<long> OnGrabStill { get; set; }

    /// <summary>
    /// True if the current operator is allowed to grab a still (Review role or above - the same
    /// minimum the server's POST /api/v1/media/{id}/stills endpoint enforces). The parent computes
    /// this from its own session/role state; when false the "Grab still" button is not rendered at
    /// all, matching how the case-pinning UI hides its own action for below-Review operators.
    /// Defaults to true so a caller that hasn't been made role-aware still sees the button.
    /// </summary>
    [Parameter]
    public bool CanGrabStill { get; set; } = true;

    /// <summary>Status of the most recent (or in-flight) still capture, shown inline in the viewer.</summary>
    [Parameter]
    public MediaStillCaptureStatus? StillCaptureStatus { get; set; }

    private ElementReference _rootElement;
    private MediaPlayer? _player;
    private double _playbackRate = 1.0;
    private ImageViewport _viewport = new();
    private bool _isDragging = false;
    private double _dragStartX = 0;
    private double _dragStartY = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FocusViewerAsync();
        }
    }

    private async Task FocusViewerAsync()
    {
        try
        {
            await _rootElement.FocusAsync();
        }
        catch (JSDisconnectedException)
        {
            // Ignore JS disconnection
        }
    }

    public override async Task SetParametersAsync(ParameterView parameters)
    {
        var oldItemKey = Item?.Key;

        await base.SetParametersAsync(parameters);

        // Reset viewport when item changes
        if (Item?.Key != oldItemKey)
        {
            _viewport = new ImageViewport();
        }
    }

    private async Task ZoomIn()
    {
        _viewport = _viewport.ZoomIn();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ZoomOut()
    {
        _viewport = _viewport.ZoomOut();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ZoomFit()
    {
        _viewport = _viewport.Fit();
        await InvokeAsync(StateHasChanged);
    }

    // The player applies the rate (through the playback policy) when it re-renders with the new value.
    private void ChangePlaybackSpeed(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (double.TryParse(e.Value?.ToString(), out var rate))
        {
            _playbackRate = rate;
        }
    }

    private async Task FrameBack()
    {
        await StepFrame(-GetFrameStepSeconds());
    }

    private async Task FrameForward()
    {
        await StepFrame(GetFrameStepSeconds());
    }

    /// <summary>
    /// Computes the number of seconds a single frame step represents.
    /// Falls back to 30 fps when the media's frame rate is unknown, zero, or negative,
    /// since dividing by zero or a negative rate would be nonsensical.
    /// </summary>
    private double GetFrameStepSeconds()
    {
        var frameRate = Item.Media?.FrameRate;
        var effectiveFrameRate = frameRate is > 0 ? (double)frameRate.Value : 30d;
        return 1.0 / effectiveFrameRate;
    }

    private async Task StepFrame(double seconds)
    {
        if (_player is not null)
        {
            await _player.StepAsync(seconds);
        }
    }

    /// <summary>
    /// Reads the video's current playback position and invokes <see cref="OnGrabStill"/> with it as a millisecond
    /// offset into the source video.
    /// </summary>
    private async Task GrabStillAsync()
    {
        long offsetMs = _player is null ? 0 : await _player.GetCurrentTimeMsAsync() ?? 0;
        await OnGrabStill.InvokeAsync(offsetMs);
    }

    private async Task PlayToggle()
    {
        if (_player is not null)
        {
            await _player.TogglePlayAsync();
        }
    }

    private async Task HandleKeydown(KeyboardEventArgs e)
    {
        var isVideo = MediaFormatHelper.IsVideo(Item.Media?.MediaFormat);
        var action = MediaViewerKeys.Map(e.Key, isVideo);

        switch (action)
        {
            case MediaViewerAction.Previous:
                if (HasPrevious)
                    await OnPrevious.InvokeAsync();
                break;
            case MediaViewerAction.Next:
                if (HasNext)
                    await OnNext.InvokeAsync();
                break;
            case MediaViewerAction.Close:
                await OnClose.InvokeAsync();
                break;
            case MediaViewerAction.ZoomIn:
                await ZoomIn();
                break;
            case MediaViewerAction.ZoomOut:
                await ZoomOut();
                break;
            case MediaViewerAction.TogglePlay:
                await PlayToggle();
                break;
            case MediaViewerAction.FrameBack:
                await FrameBack();
                break;
            case MediaViewerAction.FrameForward:
                await FrameForward();
                break;
            case MediaViewerAction.GrabStill:
                await GrabStillAsync();
                break;
        }
    }

    private async Task HandleMouseWheel(WheelEventArgs e)
    {
        if (!MediaFormatHelper.IsImage(Item.Media?.MediaFormat))
            return;

        if (e.DeltaY < 0)
        {
            await ZoomIn();
        }
        else if (e.DeltaY > 0)
        {
            await ZoomOut();
        }
    }

    private void HandleMouseDown(MouseEventArgs e)
    {
        if (!MediaFormatHelper.IsImage(Item.Media?.MediaFormat) || _viewport.Scale <= 1)
            return;

        _isDragging = true;
        _dragStartX = e.ClientX;
        _dragStartY = e.ClientY;
    }

    private void HandleMouseMove(MouseEventArgs e)
    {
        if (!_isDragging)
            return;

        var deltaX = e.ClientX - _dragStartX;
        var deltaY = e.ClientY - _dragStartY;
        _viewport = _viewport.PanBy(deltaX, deltaY);
        _dragStartX = e.ClientX;
        _dragStartY = e.ClientY;
    }

    private void HandleMouseUp(MouseEventArgs e)
    {
        _isDragging = false;
    }

    /// <summary>
    /// CSS classes for the image element: "zoomed" when scale > 1 (pan is available),
    /// and "dragging" while a pan gesture is in progress, to drive grab/grabbing cursors.
    /// </summary>
    private string GetImageCssClass()
    {
        var classes = new List<string>();
        if (_viewport.Scale > 1)
        {
            classes.Add("zoomed");
        }
        if (_isDragging)
        {
            classes.Add("dragging");
        }
        return string.Join(' ', classes);
    }
}
