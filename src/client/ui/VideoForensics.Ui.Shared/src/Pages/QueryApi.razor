@page "/query"
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Components
@using VideoForensics.Client.Ui.Shared.Contracts
@using VideoForensics.Client.Ui.Shared.Resources
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Services.QueryApi
@using VideoForensics.Client.Ui.Shared.Services.Inspector
@using VideoForensics.Client.Ui.Shared.Components.Inspector
@using VideoForensics.Client.Ui.Shared.Components.Dump
@using VideoForensics.Core.Providers.Common.Contracts
@inject IProviderAuthService AuthService
@inject IDeviceDiscoveryService DeviceDiscoveryService
@inject IStringLocalizer<QueryApi> L
@inject IStringLocalizer<SharedResources> SharedL
@inject IQueryApiFilterState FilterState

<Breadcrumb Items="@BreadcrumbItems" />

<div class="d-flex justify-content-between align-items-center mb-4">
    <h4 class="mb-0">@L["Title"]</h4>
</div>

<ul class="nav nav-tabs mb-4" data-testid="query-api-tabs">
    <li class="nav-item"><NavLink class="nav-link" href="/query/devices">@L["Devices"]</NavLink></li>
    <li class="nav-item"><NavLink class="nav-link" href="/query/events">@L["Events"]</NavLink></li>
    <li class="nav-item"><NavLink class="nav-link" href="/query/config">@L["Config"]</NavLink></li>
</ul>

<div class="card border rounded p-4 mb-4">
    <h5 class="mt-4 mb-2">@L["AccountStatus"]</h5>
    <SfButton Content="@L["CheckStatus"]" OnClick="RunAccountStatusAsync" CssClass="e-primary" />
    @if (_accountStatus is not null)
    {
        <p class="mt-2">@_accountStatus</p>
        @if (_accountStatusDetails is not null)
        {
            <details class="mt-2">
                <summary>@L["RawResponse"]</summary>
                <DumpView Value="@_accountStatusDetails" InitialExpandDepth="1" />
            </details>
        }
        else
        {
            <p class="mt-2">@L["NoStatusDetail"]</p>
        }
    }
</div>

<div class="card border rounded p-4 mb-4">
    <h5 class="mt-4 mb-2">@L["Locations"]</h5>
    <SfButton Content="@L["GetLocations"]" OnClick="RunLocationsAsync" CssClass="e-primary" Disabled="@_locationsLoading" />
    @if (!string.IsNullOrEmpty(_locationsError))
    {
        <div class="alert alert-danger mt-2">@_locationsError</div>
    }
    @if (_locations is not null)
    {
        @if (_locations.Count == 0)
        {
            <p class="mt-2">@L["NoLocationsFound"]</p>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <ForensicGrid TItem="Location"
                    DataSource="@_locations"
                    ToInspector="@ToLocationInspector"
                    OnRowSelected="@OnLocationRowSelected"
                    Columns="@LocationGridColumns"
                    ExportFileName="locations.csv"
                    PageSize="20" />
            </div>
            <details class="mt-2">
                <summary>@L["RawResponse"]</summary>
                <DumpView Value="@_locations" InitialExpandDepth="1" />
            </details>
        }
    }
</div>

<div data-testid="api-tester" class="card border rounded p-4 mb-4">
    <h5 class="mb-2">@SharedL["API Tester"]</h5>
    <RingSelfTest />
</div>

@code {
    private List<(string Label, string? Url)> BreadcrumbItems =>
    [
        (SharedL["Sources"], "/accounts"),
        (SharedL["Query API"], null)
    ];

    // Account Status
    private string? _accountStatus;
    private ProviderAuthStatus? _accountStatusDetails;

    // Fetches first: on the remote client the synchronous status reads the value this call just refreshed.
    private async Task RunAccountStatusAsync()
    {
        _accountStatusDetails = await AuthService.GetAuthStatusDetailsAsync();
        _accountStatus = AuthService.GetAuthStatus();
    }

    // Locations
    private bool _locationsLoading;
    private string? _locationsError;
    private List<Location>? _locations;
    private DateTime _locationsRetrievedAt;

    private async Task RunLocationsAsync()
    {
        _locationsLoading = true;
        _locationsError = null;
        try
        {
            _locationsRetrievedAt = DateTime.UtcNow;
            var locations = await DeviceDiscoveryService.GetLocationsAsync(CancellationToken.None);
            _locations = locations.ToList();
        }
        catch (Exception ex)
        {
            _locationsError = L["FailedToGetLocations", ex.Message];
        }
        finally
        {
            _locationsLoading = false;
        }
    }

    // Inspector Mapper
    private InspectorModel ToLocationInspector(Location location)
    {
        return LocationInspectorMapper.ToInspector(location, _locationsRetrievedAt);
    }

    // Row Selection: selecting a location sets the shared location used by the Devices and Events subpages
    private Task OnLocationRowSelected(Location location)
    {
        FilterState.SetLocationId(QueryApiDrillDownHelpers.DrillDownLocationId(location));
        return Task.CompletedTask;
    }

    // Grid Column Definitions
    private RenderFragment LocationGridColumns => __builder =>
    {
        <GridColumn Field="@nameof(Location.Id)" HeaderText="@L["ColId"]" MinWidth="100" />
        <GridColumn Field="@nameof(Location.Name)" HeaderText="@L["ColName"]" MinWidth="100" />
        <GridColumn Field="@nameof(Location.Address)" HeaderText="@L["ColAddress"]" MinWidth="100" />
    };
}
