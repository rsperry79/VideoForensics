@page "/review/export"
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@inject PairedSessionState SessionState
@inject IEvidenceExportService EvidenceExportService
@inject ICaseRepository CaseRepository
@inject WebAuthnClient WebAuthn
@inject StepUpService StepUp
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ExportEvidence> L
@inject IStringLocalizer<VideoForensics.Ui.Shared.Resources.SharedResources> SharedL

<Breadcrumb Items="@_breadcrumbItems" />

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <span>@L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToExport"]</span>
}
else
{
    <span>@L["ExportScopeMessage"]</span>

    <div class="mb-3">
        <label for="export-case-picker" class="form-label">@L["CasePickerLabel"]</label>
        <select id="export-case-picker" class="form-select" data-testid="case-picker" value="@_selectedCaseId" @onchange="OnCaseChanged" disabled="@_isExporting">
            <option value="">@L["CasePickerPlaceholder"]</option>
            @foreach (ForensicCase c in _cases)
            {
                <option value="@c.Id" selected="@(c.Id == _selectedCaseId)">@c.CaseNumber · @c.Title</option>
            }
        </select>
    </div>
    @if (_loadError is not null)
    {
        <div class="alert alert-danger mb-3">@_loadError</div>
    }
    else if (_cases.Count == 0)
    {
        <div class="mb-3"><span>@L["NoCases"]</span></div>
    }
    else if (_selectedCaseId is null)
    {
        <div class="mb-3"><span>@L["SelectCaseMessage"]</span></div>
    }
    <div class="mb-3">
        <SfTextBox @bind-Value="_recipientDescription" Placeholder="@L["RecipientDescriptionPlaceholder"]" Enabled="@(!_isExporting)" />
    </div>
    <div class="mb-3">
        <SfTextBox @bind-Value="_passphrase" Type="Syncfusion.Blazor.Inputs.InputType.Password" Placeholder="@L["PassphrasePlaceholder"].Value" Enabled="@(!_isExporting)" />
    </div>
    <div class="mb-3">
        <button type="button" class="btn btn-primary" data-testid="export-button" @onclick="ExportAsync" disabled="@(_isExporting || _selectedCaseId is null)">
            @(_isExporting ? L["ExportingButton"] : L["ExportButton"])
        </button>
    </div>

    @if (_result is not null)
    {
        @if (_result.Success)
        {
            <div>
                <span>@L["ExportSucceeded"]</span>
                <span>@L["ArchivePath"] @_result.ArchivePath</span>
                <span>@L["ArchiveSha256"] @_result.ArchiveSha256Hash</span>
                <span>@L["ItemsIncluded"] @_result.ItemsIncluded</span>
                @if (_result.ItemsExcludedForFailedIntegrity.Count > 0)
                {
                    <span>@L["ItemsExcludedForFailedIntegrity"] @_result.ItemsExcludedForFailedIntegrity.Count</span>
                }
            </div>
        }
        else
        {
            <div class="alert alert-danger">@L["ExportFailed", _result.ErrorMessage]</div>
        }
    }
}

@code {
    /// <summary>The case to export, from the <c>?caseId=</c> query parameter; the operator can change it with the picker.</summary>
    [SupplyParameterFromQuery(Name = "caseId")]
    public Guid? CaseId { get; set; }

    private List<(string Label, string? Url)> _breadcrumbItems = new();
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _isExporting;
    private List<ForensicCase> _cases = new();
    private Guid? _selectedCaseId;
    private string? _loadError;
    private ExportResult? _result;

    private string? _recipientDescription;
    private string? _passphrase;

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbItems = new() { (SharedL["Events"], "/events"), (SharedL["Export Evidence"], null) };
        try
        {
            await SessionState.EnsureLoadedAsync();
            _isAuthenticated = SessionState.IsSignedIn;
            if (_isAuthenticated)
            {
                await LoadCasesAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadCasesAsync()
    {
        try
        {
            _cases = (await CaseRepository.ListAsync(null, CancellationToken.None)).ToList();
            // Only preselect a case that exists; a stale or foreign id leaves the picker empty and export disabled.
            _selectedCaseId = CaseId.HasValue && _cases.Any(c => c.Id == CaseId.Value) ? CaseId : null;
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToLoadCases", ex.Message].Value;
        }
    }

    private void OnCaseChanged(Microsoft.AspNetCore.Components.ChangeEventArgs args)
    {
        _selectedCaseId = Guid.TryParse(args.Value?.ToString(), out Guid id) ? id : null;
        _result = null;
    }

    private async Task ExportAsync()
    {
        if (_selectedCaseId is not Guid caseId)
        {
            return;
        }

        _isExporting = true;
        _result = null;
        try
        {
            // Exporting evidence needs a fresh passkey step-up, the same as the HTTP export.
            string stepUpToken;
            try
            {
                stepUpToken = await StepUp.GetStepUpTokenAsync();
            }
            catch (Exception)
            {
                _result = new ExportResult { Success = false, ErrorMessage = L["StepUpFailed"].Value };
                return;
            }

            _result = await EvidenceExportService.ExportEvidenceAsync(
                caseId,
                string.IsNullOrWhiteSpace(_recipientDescription) ? null : _recipientDescription,
                string.IsNullOrWhiteSpace(_passphrase) ? null : _passphrase,
                CancellationToken.None,
                stepUpToken);
        }
        catch (UnauthorizedAccessException ex)
        {
            // The guard's message is already localized to the operator's culture.
            _result = new ExportResult { Success = false, ErrorMessage = ex.Message };
        }
        catch (Exception ex)
        {
            _result = new ExportResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            _isExporting = false;
        }
    }
}
