@page "/settings/theme"
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Resources
@using VideoForensics.Client.Ui.Shared.Services
@inject ThemePreferenceService ThemeService
@inject IStringLocalizer<SharedResources> L

<h4 class="mb-4">@L["Theme"]</h4>

<div class="d-flex flex-column gap-2" style="max-width: 240px;">
    <button class="btn btn-outline-secondary text-start" @onclick="() => SetThemeAsync(ThemeMode.Light)">@L["Light theme"]</button>
    <button class="btn btn-outline-secondary text-start" @onclick="() => SetThemeAsync(ThemeMode.Dark)">@L["Dark theme"]</button>
    <button class="btn btn-outline-secondary text-start" @onclick="() => SetThemeAsync(ThemeMode.System)">@L["System theme"]</button>
</div>

@code {
    private async Task SetThemeAsync(ThemeMode mode)
    {
        await ThemeService.SetModeAsync(mode);
    }
}
