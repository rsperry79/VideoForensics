@page "/query/events"
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Components
@using VideoForensics.Ui.Shared.Contracts
@using VideoForensics.Ui.Shared.Resources
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Services.QueryApi
@using VideoForensics.Ui.Shared.Services.Inspector
@using VideoForensics.Ui.Shared.Services.Scope
@using VideoForensics.Ui.Shared.Components.Inspector
@using VideoForensics.Ui.Shared.Components.Dump
@using VideoForensics.Core.Providers.Common.Contracts
@implements IDisposable
@inject IDeviceDiscoveryService DeviceDiscoveryService
@inject IEventAndConfigService EventAndConfigService
@inject IStringLocalizer<QueryApiEvents> L
@inject IStringLocalizer<SharedResources> SharedL
@inject IQueryApiFilterState FilterState
@inject ScopeState ScopeState

<Breadcrumb Items="@BreadcrumbItems" />

<PageRightPanelContent>
    <div class="right-panel-section">
        <small>@L["Title"]</small>
        <div class="d-flex flex-column gap-2 mb-2">
            <div>
                <label>@L["LabelLocationId"]</label>
                <SfDropDownList ID="query-api-events-location-filter" TValue="string" TItem="QueryApiSelectOption" @bind-Value="LocationIdValue" DataSource="@LocationOptions" Placeholder="@L["SelectLocation"]" CssClass="w-100">
                    <DropDownListFieldSettings Text="Label" Value="Value" />
                </SfDropDownList>
            </div>
            <div>
                <label>@L["LabelDeviceId"]</label>
                <SfDropDownList ID="query-api-device-events-filter" TValue="string" TItem="QueryApiSelectOption" @bind-Value="DeviceIdValue" DataSource="@DeviceOptions" Placeholder="@L["SelectDevice"]" CssClass="w-100">
                    <DropDownListFieldSettings Text="Label" Value="Value" />
                </SfDropDownList>
            </div>
        </div>
    </div>
</PageRightPanelContent>

@if (!string.IsNullOrEmpty(_locationsError))
{
    <div class="alert alert-danger mt-2">@_locationsError</div>
}
@if (!string.IsNullOrEmpty(_devicesError))
{
    <div class="alert alert-danger mt-2">@_devicesError</div>
}

<div class="card border rounded p-4 mb-4">
    <h5 class="mt-4 mb-2">@L["Title"] · <LocalTimeText Value="@ScopeState.Current.FromUtc" Format="yyyy-MM-dd" /> → <LocalTimeText Value="@ScopeState.Current.ToUtc" Format="yyyy-MM-dd" /></h5>
    <SfButton Content="@L["GetEvents"]" OnClick="RunEventsAsync" CssClass="e-primary" Disabled="@(_eventsLoading || string.IsNullOrWhiteSpace(FilterState.DeviceId))" />
    @if (!string.IsNullOrEmpty(_eventsError))
    {
        <div class="alert alert-danger mt-2">@_eventsError</div>
    }
    @if (_events is not null)
    {
        @if (_events.Count == 0)
        {
            <p class="mt-2">@L["NoEventsFound"]</p>
        }
        else
        {
            <div style="display: flex; flex-direction: column; gap: 1rem;">
                <ForensicGrid TItem="DeviceEvent"
                    DataSource="@_events"
                    ToInspector="@ToDeviceEventInspector"
                    Columns="@DeviceEventGridColumns"
                    ExportFileName="device-events.csv"
                    PageSize="20" />
            </div>
            <details class="mt-2">
                <summary>@L["RawResponse"]</summary>
                <DumpView Value="@_events" InitialExpandDepth="1" />
            </details>
        }
    }
</div>

@code {
    private List<(string Label, string? Url)> BreadcrumbItems =>
    [
        (SharedL["Sources"], "/accounts"),
        (SharedL["Query API"], "/query"),
        (L["Title"], null)
    ];

    // Shared selections are read and written through the filter state, so they survive navigation.
    private string LocationIdValue
    {
        get => FilterState.LocationId ?? string.Empty;
        set => FilterState.SetLocationId(string.IsNullOrEmpty(value) ? null : value);
    }

    private string DeviceIdValue
    {
        get => FilterState.DeviceId ?? string.Empty;
        set => FilterState.SetDeviceId(string.IsNullOrEmpty(value) ? null : value);
    }

    private System.Action? _onScopeChangeHandler;
    private string? _loadedDevicesLocationId;

    protected override async Task OnInitializedAsync()
    {
        _onScopeChangeHandler = () => _ = InvokeAsync(StateHasChanged);
        ScopeState.OnChange += _onScopeChangeHandler;
        FilterState.OnChange += OnFilterChanged;

        await LoadLocationsAsync();
        await LoadDevicesForSelectedLocationAsync();
    }

    // Reloads the device dropdown when the shared location changes; device-only changes just re-render.
    private void OnFilterChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (FilterState.LocationId != _loadedDevicesLocationId)
            {
                await LoadDevicesForSelectedLocationAsync();
            }

            StateHasChanged();
        });
    }

    // Locations (feeds the location dropdown)
    private List<Location>? _locations;
    private string? _locationsError;

    private async Task LoadLocationsAsync()
    {
        _locationsError = null;
        try
        {
            _locations = (await DeviceDiscoveryService.GetLocationsAsync(CancellationToken.None)).ToList();
        }
        catch (Exception ex)
        {
            _locationsError = L["FailedToGetLocations", ex.Message];
        }
    }

    // Devices at the shared location (feeds the device dropdown)
    private List<Device>? _devices;
    private string? _devicesError;

    private async Task LoadDevicesForSelectedLocationAsync()
    {
        var locationId = FilterState.LocationId;
        _loadedDevicesLocationId = locationId;
        _devicesError = null;
        _devices = new List<Device>();
        if (string.IsNullOrWhiteSpace(locationId))
        {
            return;
        }

        try
        {
            _devices = (await DeviceDiscoveryService.GetDevicesAsync(locationId, CancellationToken.None)).ToList();
        }
        catch (Exception ex)
        {
            _devicesError = L["FailedToGetDevices", ex.Message];
        }
    }

    // Device Events
    private bool _eventsLoading;
    private string? _eventsError;
    private List<DeviceEvent>? _events;
    private DateTime _eventsRetrievedAt;

    private async Task RunEventsAsync()
    {
        _eventsLoading = true;
        _eventsError = null;
        try
        {
            _eventsRetrievedAt = DateTime.UtcNow;
            var events = await EventAndConfigService.GetEventsAsync(
                FilterState.DeviceId ?? string.Empty,
                ScopeState.Current.FromUtc,
                ScopeState.Current.ToUtc,
                null,
                CancellationToken.None);
            _events = events.ToList();
        }
        catch (Exception ex)
        {
            _eventsError = L["FailedToGetEvents", ex.Message];
        }
        finally
        {
            _eventsLoading = false;
        }
    }

    // Dropdown Options
    private IReadOnlyList<QueryApiSelectOption> LocationOptions =>
        (_locations ?? []).Select(l => new QueryApiSelectOption(l.Id, QueryApiDrillDownHelpers.LocationDisplayLabel(l))).ToList();

    private IReadOnlyList<QueryApiSelectOption> DeviceOptions =>
        (_devices ?? []).Select(d => new QueryApiSelectOption(d.Id, QueryApiDrillDownHelpers.DeviceDisplayLabel(d))).ToList();

    private InspectorModel ToDeviceEventInspector(DeviceEvent @event)
    {
        return DeviceEventInspectorMapper.ToInspector(
            @event,
            FilterState.DeviceId ?? string.Empty,
            ScopeState.Current.FromUtc,
            ScopeState.Current.ToUtc,
            _eventsRetrievedAt);
    }

    private RenderFragment DeviceEventGridColumns => __builder =>
    {
        <GridColumn Field="@nameof(DeviceEvent.Id)" HeaderText="@L["ColId"]" MinWidth="100" />
        <GridColumn Field="@nameof(DeviceEvent.EventType)" HeaderText="@L["ColEventType"]" MinWidth="100" />
        <GridColumn Field="@nameof(DeviceEvent.Timestamp)" HeaderText="@L["ColTimestamp"]" MinWidth="100">
            <Template>
                <LocalTimeText Value="@((context as DeviceEvent)!.Timestamp)" />
            </Template>
        </GridColumn>
        <GridColumn Field="@nameof(DeviceEvent.SnapshotUrl)" HeaderText="@L["ColSnapshotUrl"]" MinWidth="100" />
    };

    void IDisposable.Dispose()
    {
        if (_onScopeChangeHandler is not null)
        {
            ScopeState.OnChange -= _onScopeChangeHandler;
        }

        FilterState.OnChange -= OnFilterChanged;
    }
}
