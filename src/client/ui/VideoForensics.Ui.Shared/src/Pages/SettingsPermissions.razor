@page "/settings/permissions"
@using System.Net
@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Services
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject ISelfApiHttpClientFactory ClientFactory
@inject IStringLocalizer<SettingsPermissions> L

<div class="d-flex align-items-center gap-2 mb-4">
    <h4 class="mb-0">@L["Title"]</h4>
</div>

@if (!SessionState.IsSignedIn)
{
    <div class="alert alert-info mb-4">
        <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignInPrompt"]</a> @L["SignInToManage"]
    </div>
}
else if (_isLoading)
{
    <div class="spinner-border spinner-border-sm" role="status"></div>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@L["ProviderAccountsSection"]</h5>
            <p class="text-body-secondary">@L["ProviderAccountsDescription"]</p>

            <label class="form-label" for="provider-edit-access">@L["ProviderEditLabel"]</label>
            <select id="provider-edit-access" class="form-select mb-3" @bind="_providerEditAccess" disabled="@_saving">
                <option value="Admin">@L["ProviderEditAdminOption"]</option>
                <option value="SuperAdmin">@L["ProviderEditSuperAdminOption"]</option>
            </select>

            <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@_saving">@L["Save"]</button>

            @if (_status is not null)
            {
                <div class="alert alert-secondary mt-3 mb-0" role="status">@_status</div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">@L["ReportsSection"]</h5>
            <p class="text-body-secondary">@L["ReportsDescription"]</p>

            <label class="form-label" for="report-settings-access">@L["ReportsLabel"]</label>
            <select id="report-settings-access" class="form-select mb-3" @bind="_reportSettingsAccess" disabled="@_saving">
                <option value="SuperAdmin">@L["ReportsSuperAdminOption"]</option>
                <option value="Admin">@L["ProviderEditAdminOption"]</option>
            </select>

            <button type="button" class="btn btn-primary" @onclick="SaveReportsAsync" disabled="@_saving">@L["Save"]</button>

            @if (_reportsStatus is not null)
            {
                <div class="alert alert-secondary mt-3 mb-0" role="status">@_reportsStatus</div>
            }
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private string? _loadError;
    private string? _status;
    private bool _saving;
    private string _providerEditAccess = "Admin";
    private string _reportSettingsAccess = "SuperAdmin";
    private string? _reportsStatus;

    /// <summary>Response shape of GET /api/v1/permissions/provider-accounts.</summary>
    private sealed record ProviderPermissionsResponse(string ProviderAccountEditAccess);

    /// <summary>Response shape of GET /api/v1/permissions/reports.</summary>
    private sealed record ReportPermissionsResponse(string ReportSettingsAccess);

    protected override async Task OnInitializedAsync()
    {
        await SessionState.EnsureLoadedAsync();
        if (!SessionState.IsSignedIn)
        {
            _isLoading = false;
            return;
        }

        try
        {
            HttpClient client = ClientFactory.CreateClient();
            ProviderPermissionsResponse? result = await client.GetFromJsonAsync<ProviderPermissionsResponse>("/api/v1/permissions/provider-accounts");
            _providerEditAccess = result?.ProviderAccountEditAccess ?? "Admin";

            ReportPermissionsResponse? reports = await client.GetFromJsonAsync<ReportPermissionsResponse>("/api/v1/permissions/reports");
            _reportSettingsAccess = reports?.ReportSettingsAccess ?? "SuperAdmin";
        }
        catch (HttpRequestException ex)
        {
            _loadError = L["LoadFailed", ex.Message].Value;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveReportsAsync()
    {
        _saving = true;
        _reportsStatus = null;
        try
        {
            HttpClient client = ClientFactory.CreateClient();
            HttpResponseMessage response = await client.PutAsJsonAsync("/api/v1/permissions/reports", new { reportSettingsAccess = _reportSettingsAccess });
            _reportsStatus = response.IsSuccessStatusCode
                ? L["SaveSucceeded"].Value
                : L["SaveFailed", response.StatusCode.ToString()].Value;
        }
        catch (HttpRequestException ex)
        {
            _reportsStatus = L["SaveFailed", ex.Message].Value;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _status = null;
        try
        {
            HttpClient client = ClientFactory.CreateClient();
            HttpResponseMessage response = await client.PutAsJsonAsync("/api/v1/permissions/provider-accounts", new { providerAccountEditAccess = _providerEditAccess });
            _status = response.IsSuccessStatusCode
                ? L["SaveSucceeded"].Value
                : L["SaveFailed", response.StatusCode.ToString()].Value;
        }
        catch (HttpRequestException ex)
        {
            _status = L["SaveFailed", ex.Message].Value;
        }
        finally
        {
            _saving = false;
        }
    }
}
