@page "/query/devices/{LocationId}/{DeviceId}"
@using System.Globalization
@using System.Reflection
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Components
@using VideoForensics.Ui.Shared.Resources
@using VideoForensics.Ui.Shared.Services.QueryApi
@using VideoForensics.Core.Providers.Common.Contracts
@inject IDeviceDiscoveryService DeviceDiscoveryService
@inject IStringLocalizer<QueryApiDeviceDetails> L
@inject IStringLocalizer<SharedResources> SharedL
@inject IDeviceControlService DeviceControlService
@inject ILogger<QueryApiDeviceDetails> Logger

<Breadcrumb Items="@BreadcrumbItems" />

@if (!string.IsNullOrEmpty(_loadError))
{
    <div class="alert alert-danger mt-2">@_loadError</div>
}
else if (_loading)
{
    <p>@L["Loading"]</p>
}
else if (_device is null)
{
    <p data-testid="device-not-found">@L["DeviceNotFound"]</p>
}
else
{
    <h4 class="mb-4" data-testid="device-name">@QueryApiDrillDownHelpers.DeviceDisplayLabel(_device)</h4>

    <div class="card border rounded p-4 mb-4">
        <h5 class="mb-3">@L["SectionIdentity"]</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">@L["LabelId"]</dt>
            <dd class="col-sm-9" data-testid="device-id">@_device.Id</dd>
            <dt class="col-sm-3">@L["LabelName"]</dt>
            <dd class="col-sm-9">@_device.Name</dd>
            <dt class="col-sm-3">@L["LabelType"]</dt>
            <dd class="col-sm-9">@_device.Type</dd>
            <dt class="col-sm-3">@L["LabelLocationId"]</dt>
            <dd class="col-sm-9">@_device.LocationId</dd>
        </dl>
    </div>

    <div class="card border rounded p-4 mb-4">
        <h5 class="mb-3">@L["SectionStatus"]</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">@L["LabelOnline"]</dt>
            <dd class="col-sm-9" data-testid="device-status">@StatusText(_device.IsOnline)</dd>
        </dl>
    </div>

    @if (IsCameraType || IsChime)
    {
        <div class="card border rounded p-4 mb-4">
            <h5 class="mb-3">@L["ControlsTitle"]</h5>
            @if (IsCameraType)
            {
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" class="btn btn-outline-primary" data-testid="control-light-on" disabled="@_controlBusy" @onclick="() => RunControlAsync(id => DeviceControlService.SetLightAsync(id, true, CancellationToken.None))">@L["ControlLightOn"]</button>
                    <button type="button" class="btn btn-outline-primary" data-testid="control-light-off" disabled="@_controlBusy" @onclick="() => RunControlAsync(id => DeviceControlService.SetLightAsync(id, false, CancellationToken.None))">@L["ControlLightOff"]</button>
                    <button type="button" class="btn btn-outline-primary" data-testid="control-motion-on" disabled="@_controlBusy" @onclick="() => RunControlAsync(id => DeviceControlService.SetMotionDetectionAsync(id, true, CancellationToken.None))">@L["ControlMotionOn"]</button>
                    <button type="button" class="btn btn-outline-primary" data-testid="control-motion-off" disabled="@_controlBusy" @onclick="() => RunControlAsync(id => DeviceControlService.SetMotionDetectionAsync(id, false, CancellationToken.None))">@L["ControlMotionOff"]</button>
                    <button type="button" class="btn btn-outline-primary" data-testid="control-night-on" disabled="@_controlBusy" @onclick="() => RunControlAsync(id => DeviceControlService.SetNightModeAsync(id, true, CancellationToken.None))">@L["ControlNightOn"]</button>
                    <button type="button" class="btn btn-outline-primary" data-testid="control-night-off" disabled="@_controlBusy" @onclick="() => RunControlAsync(id => DeviceControlService.SetNightModeAsync(id, false, CancellationToken.None))">@L["ControlNightOff"]</button>
                    <button type="button" class="btn btn-outline-danger" data-testid="control-siren-on" disabled="@_controlBusy" @onclick="() => RunControlAsync(id => DeviceControlService.SetSirenAsync(id, true, SirenDurationSeconds, CancellationToken.None))">@L["ControlSirenOn"]</button>
                    <button type="button" class="btn btn-outline-danger" data-testid="control-siren-off" disabled="@_controlBusy" @onclick="() => RunControlAsync(id => DeviceControlService.SetSirenAsync(id, false, null, CancellationToken.None))">@L["ControlSirenOff"]</button>
                </div>
                <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
                    <div>
                        <label for="control-volume-input" class="form-label">@L["ControlVolumeLabel"]</label>
                        <input id="control-volume-input" type="number" min="0" max="11" class="form-control" data-testid="control-volume-input" @bind="_volumeInput" />
                    </div>
                    <button type="button" class="btn btn-primary" data-testid="control-volume-apply" disabled="@_controlBusy" @onclick="ApplyVolumeAsync">@L["ControlVolumeApply"]</button>
                </div>
            }
            @if (IsChime)
            {
                <div class="d-flex flex-wrap gap-2 align-items-end mb-3">
                    <div>
                        <label for="control-dnd-input" class="form-label">@L["ControlDndLabel"]</label>
                        <input id="control-dnd-input" type="number" min="1" max="86400" class="form-control" data-testid="control-dnd-input" @bind="_dndInput" />
                    </div>
                    <button type="button" class="btn btn-primary" data-testid="control-dnd-apply" disabled="@_controlBusy" @onclick="ApplyDoNotDisturbAsync">@L["ControlDndApply"]</button>
                </div>
            }
            @if (_message is not null)
            {
                <div class="alert @(_messageIsError ? "alert-danger" : "alert-success") mb-0" data-testid="control-message">@_message</div>
            }
        </div>
    }

    <div class="card border rounded p-4 mb-4">
        <h5 class="mb-3">@L["SectionDetails"]</h5>
        @if (_detailRows.Count == 0)
        {
            <p class="mb-0">@L["NoDetails"]</p>
        }
        else
        {
            <dl class="row mb-0">
                @foreach (var row in _detailRows)
                {
                    <dt class="col-sm-3">@row.Label</dt>
                    <dd class="col-sm-9">@row.Value</dd>
                }
            </dl>
        }
    </div>

    @if (_device.Metadata is { Count: > 0 })
    {
        <div class="card border rounded p-4 mb-4">
            <h5 class="mb-3">@L["SectionMetadata"]</h5>
            <dl class="row mb-0">
                @foreach (var kvp in _device.Metadata)
                {
                    <dt class="col-sm-3">@kvp.Key</dt>
                    <dd class="col-sm-9">@kvp.Value</dd>
                }
            </dl>
        </div>
    }
}

@code {
    [Parameter]
    public string LocationId { get; set; } = string.Empty;

    [Parameter]
    public string DeviceId { get; set; } = string.Empty;

    private Device? _device;
    private bool _loading = true;
    private string? _loadError;
    private List<(string Label, string Value)> _detailRows = new();
    private bool _controlBusy;
    private string? _message;
    private bool _messageIsError;
    private string _volumeInput = string.Empty;
    private string _dndInput = string.Empty;

    // Seconds the siren runs when turned on from the UI; off sends null so the provider default applies.
    private const int SirenDurationSeconds = 30;

    private bool IsCameraType => _device?.Type is "doorbot" or "authorized_doorbot" or "stickup_cam";

    private bool IsChime => _device?.Type == "chime";

    private List<(string Label, string? Url)> BreadcrumbItems =>
    [
        (SharedL["Sources"], "/accounts"),
        (SharedL["Query API"], "/query"),
        (L["BreadcrumbDevices"], "/query/devices"),
        (_device is null ? DeviceId : QueryApiDrillDownHelpers.DeviceDisplayLabel(_device), null)
    ];

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _loadError = null;
        _device = null;
        _message = null;
        _volumeInput = string.Empty;
        _dndInput = string.Empty;
        try
        {
            var devices = await DeviceDiscoveryService.GetDevicesAsync(LocationId, CancellationToken.None);
            _device = devices.FirstOrDefault(d => d.Id == DeviceId);
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToGetDevice", ex.Message];
        }
        finally
        {
            _loading = false;
        }

        _detailRows = BuildDetailRows(_device);
    }

    // Runs one provider control call. The exception is logged and replaced with a generic message, since provider
    // exception text can contain URLs and must not reach the UI.
    private async Task RunControlAsync(Func<string, Task> call)
    {
        if (_device is null || _controlBusy)
        {
            return;
        }

        var deviceId = _device.Id;
        _controlBusy = true;
        _message = null;
        StateHasChanged();
        try
        {
            await call(deviceId);
            Logger.LogInformation("Device control succeeded for device {DeviceId}", deviceId);
            _message = L["ControlSuccess"];
            _messageIsError = false;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Device control failed for device {DeviceId}", deviceId);
            _message = L["ControlFailed"];
            _messageIsError = true;
        }
        finally
        {
            _controlBusy = false;
        }
    }

    // Range is checked in the UI before any provider call so out-of-range input never reaches the service.
    private async Task ApplyVolumeAsync()
    {
        if (!TryParseInRange(_volumeInput, 0, 11, out var volume))
        {
            ShowInvalidRange();
            return;
        }

        await RunControlAsync(id => DeviceControlService.SetVolumeAsync(id, volume, CancellationToken.None));
    }

    private async Task ApplyDoNotDisturbAsync()
    {
        if (!TryParseInRange(_dndInput, 1, 86400, out var seconds))
        {
            ShowInvalidRange();
            return;
        }

        await RunControlAsync(id => DeviceControlService.SetDoNotDisturbAsync(id, seconds, CancellationToken.None));
    }

    private static bool TryParseInRange(string text, int min, int max, out int value) =>
        int.TryParse(text, NumberStyles.Integer, CultureInfo.InvariantCulture, out value) && value >= min && value <= max;

    private void ShowInvalidRange()
    {
        _message = L["ControlInvalidRange"];
        _messageIsError = true;
    }


    private string StatusText(bool? isOnline) =>
        isOnline switch
        {
            null => L["Unknown"],
            true => L["Yes"],
            false => L["No"]
        };

    // One label/value row per populated provider detail field. A null property means the provider did not
    // supply it, so it is omitted rather than shown as a value.
    private List<(string Label, string Value)> BuildDetailRows(Device? device)
    {
        var rows = new List<(string Label, string Value)>();
        if (device?.Details is null)
        {
            return rows;
        }

        foreach (var property in typeof(DeviceDetailFields).GetProperties(BindingFlags.Public | BindingFlags.Instance))
        {
            var value = property.GetValue(device.Details);
            if (value is null)
            {
                continue;
            }

            rows.Add((L["Detail_" + property.Name], FormatValue(value)));
        }

        return rows;
    }

    // Scalars render as text; lists join their items; anything structured (zones, settings) renders as compact JSON.
    private string FormatValue(object value) =>
        value switch
        {
            bool b => b ? L["Yes"] : L["No"],
            string s => s,
            IFormattable f => f.ToString(null, CultureInfo.InvariantCulture) ?? string.Empty,
            System.Collections.IEnumerable list when value is not string => string.Join(", ", list.Cast<object>().Select(FormatScalarOrJson)),
            _ => JsonSerializer.Serialize(value)
        };

    private static string FormatScalarOrJson(object item) =>
        item is string or bool or IFormattable ? item.ToString() ?? string.Empty : JsonSerializer.Serialize(item);
}
