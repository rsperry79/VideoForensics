@page "/analyze/validate/integrity"
@page "/analyze/validate/reconcile"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using Syncfusion.Blazor.Calendars
@inject IProviderAuthService AuthService
@inject IEvidenceValidationService EvidenceValidationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ValidateEvidence> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedInMessage"] <a href="@NavigationManager.SignInPathWithReturnUrl()">Sign in</a>
    </div>
}
else
{
    <div class="d-flex flex-row gap-2 mb-4">
        <SfButton Content="@L["VerifyIntegrityTab"]" OnClick='() => _activeTab = "integrity"' CssClass='@(_activeTab == "integrity" ? "e-primary" : "e-flat")' />
        <SfButton Content="@L["ReconcileTab"]" OnClick='() => _activeTab = "reconcile"' CssClass='@(_activeTab == "reconcile" ? "e-primary" : "e-flat")' />
    </div>

    @if (_activeTab == "integrity")
    {
        <PageRightPanelContent>
            <div class="right-panel-section">
                <span>@L["AllDevicesFilter"]</span>
                <SfDropDownList TValue="string" TItem="KeyValuePair<string,string>" @bind-Value="_selectedDeviceId" DataSource="@DeviceOptions" Placeholder="@L["AllDevicesFilter"]">
                    <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
                </SfDropDownList>
            </div>
        </PageRightPanelContent>

        <SfButton Content="@L["VerifyButton"]" OnClick="VerifyIntegrityAsync" CssClass="e-primary mb-4" />

        @if (_verificationResults is not null)
        {
            @if (_verificationResults.Count == 0)
            {
                <span>@L["NoMediaFound"]</span>
            }
            else
            {
                <SfGrid TValue="MediaVerificationResult" DataSource="@_filteredVerificationResults" AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowResizing="true">
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
                    <GridPageSettings PageSize="20"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(MediaVerificationResult.FileName)" HeaderText="@L["ColFileName"]" MinWidth="100" />
                        <GridColumn HeaderText="@L["ColStatus"]" MinWidth="100">
                            <Template>
                                @{
                                    var result = (MediaVerificationResult)context;
                                    <span style="color:@StatusColor(result.Status)">@result.Status</span>
                                }
                            </Template>
                        </GridColumn>
                        <GridColumn Field="@nameof(MediaVerificationResult.FailureReason)" HeaderText="@L["ColFailureReason"]" MinWidth="100" />
                    </GridColumns>
                </SfGrid>
            }
        }
    }
    else
    {
        <PageRightPanelContent>
            <div class="right-panel-section">
                <span>@L["SelectDeviceFilter"]</span>
                <SfDropDownList TValue="string" TItem="KeyValuePair<string,string>" @bind-Value="_selectedDeviceId" DataSource="@DeviceOptions" Placeholder="@L["SelectDeviceFilter"]">
                    <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
                </SfDropDownList>
            </div>
            <div class="right-panel-section">
                <span>@L["ProviderDeviceIdLabel"]</span>
                <SfTextBox @bind-Value="_providerDeviceId" Placeholder="@L["ProviderDeviceIdPlaceholder"]" />
            </div>
            <div class="right-panel-section">
                <span>@L["FromLabel"]</span>
                <SfDatePicker TValue="DateTime" @bind-Value="_fromDate" CssClass="w-100" />
            </div>
            <div class="right-panel-section">
                <span>@L["ToLabel"]</span>
                <SfDatePicker TValue="DateTime" @bind-Value="_toDate" CssClass="w-100" />
            </div>
        </PageRightPanelContent>

        <SfButton Content="@L["ReconcileButton"]" OnClick="ReconcileAsync" CssClass="e-primary mb-4" />

        @if (_discrepancies is not null)
        {
            @if (_discrepancies.Count == 0)
            {
                <span>@L["NoDiscrepanciesFound"]</span>
            }
            else
            {
                <SfGrid TValue="ReconciliationDiscrepancy" DataSource="@_filteredDiscrepancies" AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowResizing="true">
                    <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
                    <GridPageSettings PageSize="20"></GridPageSettings>
                    <GridColumns>
                        <GridColumn Field="@nameof(ReconciliationDiscrepancy.Type)" HeaderText="@L["ColType"]" MinWidth="100" />
                        <GridColumn Field="@nameof(ReconciliationDiscrepancy.ProviderEventId)" HeaderText="@L["ColProviderEventId"]" MinWidth="100" />
                        <GridColumn Field="@nameof(ReconciliationDiscrepancy.FieldName)" HeaderText="@L["ColField"]" MinWidth="100" />
                        <GridColumn Field="@nameof(ReconciliationDiscrepancy.StoredValue)" HeaderText="@L["ColStoredValue"]" MinWidth="100" />
                        <GridColumn Field="@nameof(ReconciliationDiscrepancy.ProviderValue)" HeaderText="@L["ColProviderValue"]" MinWidth="100" />
                    </GridColumns>
                </SfGrid>
            }
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private string _providerDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private string _activeTab = "integrity";
    private IReadOnlyList<MediaVerificationResult>? _verificationResults;
    private IReadOnlyList<ReconciliationDiscrepancy>? _discrepancies;
    private IEnumerable<MediaVerificationResult> _filteredVerificationResults = new List<MediaVerificationResult>();
    private IEnumerable<ReconciliationDiscrepancy> _filteredDiscrepancies = new List<ReconciliationDiscrepancy>();

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _devices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _activeTab = NavigationManager.Uri.Contains("reconcile", StringComparison.OrdinalIgnoreCase)
                ? "reconcile"
                : "integrity";

            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();

                // Deliberately NOT auto-run on load, unlike the read-only report pages: verifying
                // hashes every media file's bytes from disk, which is expensive across a whole
                // library (thousands of files) - it must be an explicit, on-demand action.
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task VerifyIntegrityAsync()
    {
        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _verificationResults = await EvidenceValidationService.VerifyLocalIntegrityAsync(deviceId, CancellationToken.None);
        _filteredVerificationResults = _verificationResults ?? new List<MediaVerificationResult>();
    }

    private async Task ReconcileAsync()
    {
        if (!Guid.TryParse(_selectedDeviceId, out var deviceId) || string.IsNullOrWhiteSpace(_providerDeviceId))
        {
            return;
        }

        _discrepancies = await EvidenceValidationService.ReconcileWithProviderAsync(
            deviceId,
            _providerDeviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
        _filteredDiscrepancies = _discrepancies ?? new List<ReconciliationDiscrepancy>();
    }

    private static string StatusColor(string status) => status switch
    {
        "verified" => "green",
        "failed" => "red",
        "missing" => "goldenrod",
        _ => "black",
    };
}
