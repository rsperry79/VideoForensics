@page "/devices/config"
@using VideoForensics.Ui.Shared.Layout
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Data.Common.Contracts
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@inject PairedSessionState SessionState
@inject IProviderAuthService AuthService
@inject IDeviceRepository DeviceRepository
@inject IDeviceConfigRepository DeviceConfigRepository
@inject IDeviceTypedSettingsReader TypedSettings
@inject NavigationManager NavigationManager
@inject IStringLocalizer<DeviceConfig> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <p>@L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToViewConfig"]</p>
}
else if (!_hasProviderAccount)
{
    <div class="alert alert-info" data-testid="no-provider-account">@L["NoProviderAccount"]
        @if (CanLinkProviderAccount)
        {
            <a href="/accounts/add">@L["AddProviderAccount"]</a>
        }
        else
        {
            @L["AskAdministratorToLinkAccount"]
        }
    </div>
}
else
{
    <PageRightPanelContent>
        <div class="right-panel-section">
            <small>@L["ProviderFilter"]</small>
            <SfDropDownList TValue="string" TItem="string" Value="@_providerFilter" DataSource="@ProviderOptions" Placeholder="@L["AllProviders"]" data-testid="device-config-provider-filter"
                ValueChange="@((ChangeEventArgs<string, string> args) => OnProviderFilterChanged(args))">
            </SfDropDownList>
        </div>
        <div class="right-panel-section">
            <small>@L["SelectDevice"]</small>
            <SfDropDownList TValue="string" TItem="KeyValuePair<string, string>" @bind-Value="_selectedDeviceIdStr" DataSource="@DeviceOptions" Placeholder="@L["SelectDevice"]">
                <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
            </SfDropDownList>
            <SfButton Content="@L["LoadConfiguration"]" OnClick="LoadConfigAsync" Disabled="@(_loading || string.IsNullOrEmpty(_selectedDeviceIdStr))" CssClass="e-primary mt-2" />
            @if (_selectedDevice is { } selected && RingSettingsRoute.IsRingDevice(selected))
            {
                <p class="mt-2"><a href="@RingSettingsRoute.Href(selected.Id)">@L["OpenRingSettings"]</a></p>
            }

            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger mt-2">@_error</div>
            }
        </div>
    </PageRightPanelContent>

    @if (_loadedOnce)
    {
        <h5 class="mt-4 mb-2">@L["LatestConfiguration"]</h5>
        @if (_latest is null)
        {
            <p>@L["NoConfigSnapshot"]</p>
        }
        else
        {
            <SfGrid TValue="DeviceConfigSnapshot" DataSource="@(new[] { _latest })" AllowPaging="false" AllowResizing="true">
                <GridColumns>
                    <GridColumn Field="@nameof(DeviceConfigSnapshot.CapturedAtUtc)" HeaderText="@L["ColCapturedAt"]" MinWidth="100" />
                    <GridColumn HeaderText="@L["ColMotionDetectionEnabled"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceConfigSnapshot)context;
                                @(snapshot.MotionDetectionEnabled?.ToString() ?? "-")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColMotionSensitivity"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceConfigSnapshot)context;
                                @(snapshot.MotionSensitivity ?? "-")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColRecordingMode"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceConfigSnapshot)context;
                                @(snapshot.RecordingMode ?? "-")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(DeviceConfigSnapshot.Source)" HeaderText="@L["ColSource"]" MinWidth="100" />
                </GridColumns>
            </SfGrid>
        }

        <h5 class="mt-4 mb-2">@L["TypedSettingsTitle"]</h5>
        @if (_typed is null || (_typed.OfflineMotion is null && _typed.DetectionTypes.Count == 0 && _typed.Thresholds.Count == 0))
        {
            <p>@L["NoTypedSettings"]</p>
        }
        else
        {
            @if (_typed.OfflineMotion is { } offline)
            {
                <h6 class="mt-3">@L["OfflineMotionTitle"]</h6>
                <table class="table table-sm" data-testid="typed-offline-motion">
                    <tbody>
                        <tr><th>@L["ColEnabledFlag"]</th><td>@(offline.Enabled?.ToString() ?? "-")</td></tr>
                        <tr><th>@L["ColSubscribed"]</th><td>@(offline.Subscribed?.ToString() ?? "-")</td></tr>
                        <tr><th>@L["ColMaxUploadKb"]</th><td>@(offline.MaxUploadKb?.ToString() ?? "-")</td></tr>
                        <tr><th>@L["ColResolutionP"]</th><td>@(offline.ResolutionP?.ToString() ?? "-")</td></tr>
                        <tr><th>@L["ColFrequencyAfterSecs"]</th><td>@(offline.FrequencyAfterSecs?.ToString() ?? "-")</td></tr>
                        <tr><th>@L["ColPeriodAfterSecs"]</th><td>@(offline.PeriodAfterSecs?.ToString() ?? "-")</td></tr>
                    </tbody>
                </table>
            }
            @if (_typed.DetectionTypes.Count > 0)
            {
                <h6 class="mt-3">@L["DetectionTypesTitle"]</h6>
                <table class="table table-sm" data-testid="typed-detection-types">
                    <thead><tr><th>@L["ColDetectionType"]</th><th>@L["ColEnabledFlag"]</th><th>@L["ColMode"]</th><th>@L["ColRecord"]</th><th>@L["ColNotification"]</th></tr></thead>
                    <tbody>
                        @foreach (var t in _typed.DetectionTypes)
                        {
                            <tr><td>@t.DetectionType</td><td>@(t.Enabled?.ToString() ?? "-")</td><td>@(t.Mode ?? "-")</td><td>@(t.Record?.ToString() ?? "-")</td><td>@(t.Notification?.ToString() ?? "-")</td></tr>
                        }
                    </tbody>
                </table>
            }
            @if (_typed.Thresholds.Count > 0)
            {
                <h6 class="mt-3">@L["ThresholdsTitle"]</h6>
                <table class="table table-sm" data-testid="typed-thresholds">
                    <thead><tr><th>@L["ColDetectionType"]</th><th>@L["ColThreshold"]</th></tr></thead>
                    <tbody>
                        @foreach (var th in _typed.Thresholds)
                        {
                            <tr><td>@th.DetectionType</td><td>@(th.Threshold?.ToString() ?? "-")</td></tr>
                        }
                    </tbody>
                </table>
            }
        }

        <h5 class="mt-4 mb-2">@L["History"]</h5>
        @if (_history.Count == 0)
        {
            <p>@L["NoConfigHistory"]</p>
        }
        else
        {
            <SfGrid TValue="DeviceConfigSnapshot" DataSource="@_filteredHistory" AllowPaging="true" AllowSorting="true" AllowFiltering="true" AllowResizing="true">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(DeviceConfigSnapshot.CapturedAtUtc)" HeaderText="@L["ColCapturedAt"]" MinWidth="100" />
                    <GridColumn HeaderText="@L["ColMotionDetectionEnabled"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceConfigSnapshot)context;
                                @(snapshot.MotionDetectionEnabled?.ToString() ?? "-")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColMotionSensitivity"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceConfigSnapshot)context;
                                @(snapshot.MotionSensitivity ?? "-")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColRecordingMode"]" MinWidth="100">
                        <Template>
                            @{
                                var snapshot = (DeviceConfigSnapshot)context;
                                @(snapshot.RecordingMode ?? "-")
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(DeviceConfigSnapshot.Source)" HeaderText="@L["ColSource"]" MinWidth="100" />
                </GridColumns>
            </SfGrid>
        }
    }
}

@code {

    /// <summary>Only SuperAdmin on the Local tier may open the account wizard (/accounts/add), so only they get the link.</summary>
    private bool CanLinkProviderAccount => PageAccessRules.Allows(AccessPolicy.SuperAdminLocal, NavContext.FromSession(SessionState, appLockSupported: false));

    private bool _isLoading = true;
    private bool _isAuthenticated;
    private bool _hasProviderAccount;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceIdStr = string.Empty;

    private bool _loading;
    private bool _loadedOnce;
    private string? _error;
    private DeviceConfigSnapshot? _latest;
    private List<DeviceConfigSnapshot> _history = new();
    private DeviceTypedSettings? _typed;
    private IEnumerable<DeviceConfigSnapshot> _filteredHistory = new List<DeviceConfigSnapshot>();

    private string? _providerFilter;

    private VideoForensics.Data.Common.Entities.Device? _selectedDevice => Guid.TryParse(_selectedDeviceIdStr, out Guid id) ? _devices.FirstOrDefault(d => d.Id == id) : null;

    private IReadOnlyList<string> ProviderOptions => DeviceConfigFilter.ProviderOptions(_devices);

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        DeviceConfigFilter.Filter(_devices, _providerFilter).Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    /// <summary>Changing the provider drops a selected device that the new filter hides, so the page never loads a hidden device.</summary>
    private void OnProviderFilterChanged(ChangeEventArgs<string, string> args)
    {
        _providerFilter = args.Value;
        if (!DeviceOptions.Any(o => o.Key == _selectedDeviceIdStr))
        {
            _selectedDeviceIdStr = string.Empty;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Device config needs the paired operator session AND a linked provider (Ring) account.
            await SessionState.EnsureLoadedAsync();
            _isAuthenticated = SessionState.IsSignedIn;
            if (_isAuthenticated)
            {
                _hasProviderAccount = await AuthService.IsAuthenticatedAsync();
            }
            if (_hasProviderAccount)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task LoadConfigAsync()
    {
        if (!Guid.TryParse(_selectedDeviceIdStr, out var deviceId))
        {
            return;
        }

        _loading = true;
        _error = null;
        try
        {
            _latest = await DeviceConfigRepository.GetLatestAsync(deviceId, CancellationToken.None);
            var history = await DeviceConfigRepository.GetHistoryAsync(deviceId, CancellationToken.None);
            _history = history.OrderByDescending(s => s.CapturedAtUtc).ToList();
            _filteredHistory = _history;
            _typed = await TypedSettings.GetAsync(deviceId, CancellationToken.None);
            _loadedOnce = true;
        }
        catch (Exception ex)
        {
            _error = L["FailedToLoadConfig", ex.Message];
        }
        finally
        {
            _loading = false;
        }
    }

}
