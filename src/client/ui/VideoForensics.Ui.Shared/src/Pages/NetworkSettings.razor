@page "/settings/network"
@using VideoForensics.Core.Api.Contracts
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Client.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@using Syncfusion.Blazor.DropDowns
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject WebAuthnClient WebAuthn
@inject StepUpService StepUp
@using VideoForensics.Client.Ui.Shared.Layout
@using Microsoft.JSInterop
@inject IStringLocalizer<NetworkSettings> L
@inject IJSRuntime JS
@inject IForensicsConfiguration Config
@inject VideoForensics.Client.Core.Contracts.IConfigToolsOrchestrator ConfigTools

<div class="d-flex align-items-center gap-2 mb-4">
    <h4 class="mb-0">@L["Title"]</h4>
    <button type="button" class="help-toggle-btn" title="@L["HelpButtonTitle"]" @onclick="() => _showHelp = !_showHelp">?</button>
</div>

@if (_showHelp)
{
    <div class="alert alert-warning mb-4 d-flex justify-content-between align-items-start gap-2">
        <div>
            <p class="mb-2">@L["WarningText"]</p>
            <p class="mb-0">@L["RemoteAccessHelpText"]</p>
        </div>
        <SfButton Content="@L["CloseHelp"]" OnClick="@(() => _showHelp = false)" CssClass="e-flat e-small" />
    </div>
}

@if (!SessionState.IsSignedIn)
{
    <div class="alert alert-info mb-4">
        <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignInPrompt"]</a> @L["SignInToManage"]
    </div>
}

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_authError is not null)
{
    <div class="alert alert-danger mb-2">@_authError</div>
    <span>
        @L["AuthErrorHeader"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignInPrompt"]</a> @L["AuthErrorDescription"]
    </span>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else
{
    <div class="mb-4">
        <h5 class="mb-2">@L["NetworkTierLabel"]</h5>
        <small class="text-muted d-block mb-2">@L["NetworkTierHelp"]</small>
        <div>
            <SfDropDownList TValue="NetworkTier" TItem="NetworkTierOption" DataSource="@_tierOptions" @bind-Value="_selectedTier" Style="max-width: 420px;">
                <DropDownListFieldSettings Text="Text" Value="Value" />
                <DropDownListEvents TValue="NetworkTier" TItem="NetworkTierOption" ValueChange="@(async (ChangeEventArgs<NetworkTier, NetworkTierOption> args) => await OnTierChanged(args.Value))" />
            </SfDropDownList>
        </div>

        @if (_pendingTier is not null)
        {
            <div class="alert alert-info mt-3">
                @L["ConfirmWiden", _currentTier, _pendingTier]
                <SfButton Content="@(_isSaving ? L["ConfirmingButton"] : L["ConfirmButton"])" OnClick="ConfirmWidenAsync" CssClass="e-primary mt-2" Disabled="@_isSaving" />
                <SfButton Content="@L["CancelButton"]" OnClick="CancelPendingWiden" CssClass="e-flat mt-2" />
            </div>
        }

        @if (_message is not null)
        {
            <span style="color: @(_success ? "#4caf50" : "#f44336")" class="mt-3">@_message</span>
        }

        @if (SessionState.IsSignedIn)
        {
            <h5 class="mt-4 mb-2">@L["InternalUrlHeading"]</h5>
            <small class="text-muted d-block mb-2">@L["InternalUrlHelp"]</small>
            <div class="d-flex flex-row gap-2 align-items-center flex-wrap">
                <input type="text" class="form-control" style="max-width: 420px;" aria-label="@L["InternalUrlLabel"]" placeholder="http://machine.local:5162" disabled="@(!CanAdmin)" @bind="_internalUrl" />
                <SfButton Content="@L["SaveButton"]" OnClick="SaveInternalUrlAsync" Disabled="@(!CanAdmin || _isInternalUrlSaving)" CssClass="e-primary" />
            </div>
            @if (_internalUrlMessage is not null)
            {
                <span style="@(_internalUrlSuccess ? "color: green;" : "color: red;")" class="mt-2 d-block">@_internalUrlMessage</span>
            }

            <h5 class="mt-4 mb-2">@L["ServerPortsHeading"]</h5>
            <small class="text-muted d-block mb-2">@L["ServerPortsHelp"]</small>
            <div class="d-flex flex-row gap-2 align-items-center flex-wrap">
                <label>@L["HttpPortLabel"]</label>
                <input type="number" class="form-control" style="max-width: 120px;" min="1" max="65535" disabled="@(!CanAdmin)" @bind="_httpPort" />
                <label>@L["HttpsPortLabel"]</label>
                <input type="number" class="form-control" style="max-width: 120px;" min="1" max="65535" disabled="@(!CanAdmin)" @bind="_httpsPort" />
                <SfButton Content="@L["SaveButton"]" OnClick="SaveServerPortsAsync" Disabled="@(!CanAdmin || _isServerPortsSaving)" CssClass="e-primary" />
            </div>
            @if (_serverPortsMessage is not null)
            {
                <span style="@(_serverPortsSuccess ? "color: green;" : "color: red;")" class="mt-2 d-block">@_serverPortsMessage</span>
            }
        }
    </div>

    @if (SessionState.IsSignedIn)
    {
        <h5 class="mt-4 mb-2">@L["NetworkDiscoverySection"]</h5>
        <div class="mb-4">
            <SfCheckBox TChecked="bool" Enabled="@CanAdmin" @bind-Checked="@Config.EnableMdnsAdvertisement" @bind-Checked:after="@(async () => await SaveMdnsAdvertisementAsync(Config.EnableMdnsAdvertisement))" Label="@L["EnableMdnsAdvertisement"].Value" />
            @if (_mdnsMessage is not null)
            {
                <span style="@(_mdnsSuccess ? "color: green;" : "color: red;")" class="mt-2 d-block">@_mdnsMessage</span>
            }
        </div>
    }

    @if (SessionState.IsSignedIn)
    {
        <h5 class="mt-4 mb-2">@L["DownloadsSection"]</h5>
        <div class="mb-4">
            <div class="d-flex flex-row gap-2 align-items-center flex-wrap">
                <label>@L["MaxConcurrentDownloads"]</label>
                <SfNumericTextBox TValue="int" @bind-Value="_maxConcurrentDownloads" Enabled="@CanAdmin" Style="max-width: 200px;" HtmlAttributes="_maxConcurrentAttributes" />
                <SfButton Content="@L["SaveButton"]" OnClick="SaveMaxConcurrentAsync" Disabled="@(!CanAdmin)" CssClass="e-primary" />
                @if (_maxConcurrentMessage is not null)
                {
                    <span style="@(_maxConcurrentSuccess ? "color: green;" : "color: red;")">@_maxConcurrentMessage</span>
                }
            </div>
            <small class="text-muted d-block mt-2">@L["MaxConcurrentDownloadsHelp"]</small>
        </div>
    }

    <h5 class="mt-4 mb-2">@L["RemoteAccessSectionTitle"]</h5>

    @if (_currentTier != NetworkTier.Internet)
    {
        <div class="alert alert-info mb-4">@L["RequiresInternetTier"]</div>
    }
    else if (_isRemoteAccessLoading)
    {
        <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
    }
    else if (_remoteAccessLoadError is not null)
    {
        <div class="alert alert-danger">@_remoteAccessLoadError</div>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body p-4">
                <div class="d-flex flex-column gap-2">
                    <span>
                        @L["StatusLabel"] <span class="badge @GetTunnelBadgeClass()">@_tunnelStatus</span>
                    </span>
                    <span>@L["ConfiguredAddressLabel"] @(_configuredUrl ?? L["NotConfiguredText"])</span>
                    <div class="border rounded p-3">
                        <strong class="d-block mb-2">@L["CurrentConfigHeading"]</strong>
                        <div class="row small g-1">
                            <div class="col-sm-4 text-muted">@L["NetworkTierLabel"]</div><div class="col-sm-8">@_networkTier</div>
                            <div class="col-sm-4 text-muted">@L["RpIdLabel"]</div><div class="col-sm-8"><code>@_rpId</code></div>
                            <div class="col-sm-4 text-muted">@L["PasskeyOriginsLabel"]</div><div class="col-sm-8"><code>@string.Join(", ", _passkeyOrigins)</code></div>
                            <div class="col-sm-4 text-muted">@L["ApiTokenLabel"]</div><div class="col-sm-8">@(_cloudflareAuthenticated ? L["SavedText"] : L["NotSavedText"])</div>
                            <div class="col-sm-4 text-muted">@L["TunnelTokenLabel"]</div><div class="col-sm-8">@(_tunnelConfigured ? L["SavedText"] : L["NotSavedText"])</div>
                        </div>
                    </div>
                    @if (_tunnelPublicUrl is not null)
                    {
                        <span>@L["PublicUrlLabel"] <a href="@_tunnelPublicUrl" target="_blank" rel="noopener">@_tunnelPublicUrl</a></span>
                    }
                    @if (_tunnelErrorMessage is not null)
                    {
                        <span class="text-danger">@_tunnelErrorMessage</span>
                    }
                    @if (_tunnelStatus is "Running" or "Starting")
                    {
                        <div style="width: fit-content;">
                            <SfButton Content="@L["StopTunnelButton"]" OnClick="StopTunnelAsync" CssClass="e-danger" />
                        </div>
                    }
                    @if (_tunnelConfigured)
                    {
                        <div style="width: fit-content;">
                            <SfButton Content="@(_confirmDisconnect ? L["ConfirmDisconnectButton"] : L["DisconnectButton"])" OnClick="DisconnectAsync" CssClass="e-flat" />
                        </div>
                    }
                    @if (_offerLocalPassword)
                    {
                        <div class="alert alert-info mt-2" role="alert" data-testid="offer-local-password">
                            <p class="mb-2">@L["OfferLocalPasswordText"]</p>
                            <SfButton Content="@L["EnableLocalPasswordButton"]" OnClick="EnableLocalPasswordAsync" CssClass="e-primary e-small" />
                            <SfButton Content="@L["NotNowButton"]" OnClick="() => _offerLocalPassword = false" CssClass="e-flat e-small ms-2" />
                        </div>
                    }
                    @if (_tunnelRecentLogLines.Count > 0)
                    {
                        <small class="mt-2">@L["RecentLogLabel"]</small>
                        <pre style="max-height: 200px; overflow-y: auto; background: var(--rz-base-100); padding: 8px; font-size: 0.75rem;">@string.Join("\n", _tunnelRecentLogLines)</pre>
                    }
                </div>
            </div>
        </div>

        <div class="card mb-4"><div class="card-body p-4">
            <strong class="d-block mb-2">@L["LetsEncryptHeading"]</strong>
            @if (_leStatus is { } status)
            {
                <p class="mb-2">
                    @if (status.Issued)
                    {
                        @L["CertificateStatusIssued", status.Hostname ?? "-", status.NotAfter?.ToString("yyyy-MM-dd") ?? "-"]
                        @if (status.RenewalDue)
                        {
                            <span class="text-warning">@L["CertificateStatusRenewalDue"]</span>
                        }
                    }
                    else
                    {
                        @L["CertificateStatusNone"]
                    }
                </p>
            }
            <div class="mb-2" style="max-width: 420px;">
                <label class="form-label mb-1" for="le-contact-email">@L["ContactEmailLabel"]</label>
                <input id="le-contact-email" type="email" class="form-control" @bind="_leContactEmail" />
            </div>
            <div class="form-check mb-1">
                <input id="le-use-staging" type="checkbox" class="form-check-input" @bind="_leUseStaging" />
                <label class="form-check-label" for="le-use-staging">@L["UseStagingLabel"]</label>
            </div>
            <small class="text-muted d-block mb-3">@L["UseStagingHelp"]</small>
            <div class="d-flex gap-2 flex-wrap">
                <SfButton Content="@L["SaveCertSettingsButton"]" OnClick="SaveCertificateSettingsAsync" Disabled="@_isLeBusy" CssClass="e-flat" />
                <SfButton Content="@L["RequestCertificateButton"]" OnClick="RequestCertificateAsync" Disabled="@_isLeBusy" CssClass="e-primary" />
                <SfButton Content="@L["DownloadCertificateButton"]" OnClick="DownloadCertificateAsync" Disabled="@(_isLeBusy || _leStatus is not { Issued: true })" CssClass="e-flat" />
                <SfButton Content="@L["ResetCertificateButton"]" OnClick="ResetCertificateAsync" Disabled="@(_isLeBusy || _leStatus is not { Issued: true })" CssClass="e-danger" />
            </div>
            @if (_leMessage is not null)
            {
                <div class="alert @(_leSucceeded ? "alert-success" : "alert-danger") mt-3 mb-0">@_leMessage</div>
            }
        </div></div>

        @* The Cloudflare setup is only needed until a tunnel is configured; once it is, the status card above is enough. *@
        @if (!_tunnelConfigured && _wizardVisible)
        {
            <div class="card border-primary mb-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <strong>@L["WizardHeading"]</strong>
                        <SfButton Content="@L["WizardHideButton"]" OnClick="() => _wizardVisible = false" CssClass="e-flat e-small" />
                    </div>
                    <small class="text-muted d-block mb-3">@L["WizardStepIndicator", _wizardStep, WizardStepCount]</small>

                    @switch (_wizardStep)
                    {
                        case 1:
                            <p class="mb-1">@L["WizardStep1Title"]</p>
                            <small class="text-muted d-block mb-2">@L["WizardApiTokenHelp"]</small>
                            <input type="password" class="form-control mb-2" style="max-width: 420px;" autocomplete="off" aria-label="@L["WizardApiTokenLabel"]" placeholder="@L["WizardApiTokenLabel"]" @bind="_apiToken" />
                            <div>
                                <SfButton Content="@(_isWizardBusy ? L["WizardValidatingButton"] : L["WizardValidateButton"])" OnClick="ValidateApiTokenAsync" Disabled="@(_isWizardBusy || string.IsNullOrWhiteSpace(_apiToken))" CssClass="e-primary" />
                            </div>
                            break;

                        case 2:
                            <p class="mb-1">@L["WizardStep2Title"]</p>
                            <small class="text-muted d-block mb-2">@L["WizardStep2Help"]</small>
                            <div class="d-flex flex-row gap-2 align-items-end flex-wrap mb-2">
                                <div>
                                    <label class="form-label mb-1">@L["WizardHostnameLabel"]</label>
                                    <input class="form-control" style="max-width: 180px;" placeholder="video" @bind="_hostnamePrefix" />
                                </div>
                                <span class="pb-2">.</span>
                                <div>
                                    <label class="form-label mb-1">@L["WizardDomainLabel"]</label>
                                    <SfDropDownList TValue="string" TItem="string" @bind-Value="_selectedDomain" DataSource="@_zones" Placeholder="@L["WizardDomainPlaceholder"]" Style="max-width: 260px;" />
                                </div>
                            </div>
                            @if (BuildFqdn() is string previewFqdn)
                            {
                                <small class="d-block mb-2">@L["WizardFqdnPreview", previewFqdn]</small>
                            }
                            <div class="d-flex gap-2">
                                <SfButton Content="@L["WizardBackButton"]" OnClick="() => _wizardStep = 1" CssClass="e-flat" />
                                <SfButton Content="@L["WizardNextButton"]" OnClick="() => _wizardStep = 3" Disabled="@(BuildFqdn() is null)" CssClass="e-primary" />
                            </div>
                            break;

                        case 3:
                            <p class="mb-1">@L["WizardStep3Title"]</p>
                            <small class="text-muted d-block mb-2">@L["WizardTunnelTokenHelp"]</small>
                            <input type="password" class="form-control mb-2" style="max-width: 420px;" autocomplete="off" aria-label="@L["WizardTunnelTokenLabel"]" placeholder="@L["WizardTunnelTokenLabel"]" @bind="_tunnelToken" />
                            <div class="d-flex gap-2 flex-wrap">
                                <SfButton Content="@L["WizardBackButton"]" OnClick="() => _wizardStep = 2" CssClass="e-flat" />
                                <SfButton Content="@(_isWizardBusy ? L["WizardSavingButton"] : L["WizardSaveButton"])" OnClick="SaveTunnelConfigurationAsync" Disabled="@(_isWizardBusy || string.IsNullOrWhiteSpace(_tunnelToken))" CssClass="e-primary" />
                            </div>
                            <small class="text-muted d-block mt-3 mb-2">@L["WizardCreateTunnelHelp"]</small>
                            <SfButton Content="@(_isWizardBusy ? L["WizardCreatingButton"] : L["WizardCreateTunnelButton"])" OnClick="ProvisionTunnelAsync" Disabled="@(_isWizardBusy || BuildFqdn() is null)" CssClass="e-primary" />
                            break;

                        default:
                            <p class="mb-1">@L["WizardStep4Title"]</p>
                            <small class="d-block mb-2">@L["WizardSavedAddress", _configuredUrl ?? L["NotConfiguredText"]]</small>
                            <div class="d-flex gap-2">
                                <SfButton Content="@L["WizardBackButton"]" OnClick="() => _wizardStep = 3" CssClass="e-flat" />
                                @if (_tunnelStatus is "Stopped" or "Failed")
                                {
                                    <SfButton Content="@(_isTunnelActing ? L["StartingTunnelButton"] : L["StartTunnelButton"])" OnClick="StartTunnelAsync" Disabled="@(_isTunnelActing || !_tunnelConfigured)" CssClass="e-primary" />
                                }
                            </div>
                            break;
                    }
                </div>
            </div>
        }
        else if (!_tunnelConfigured)
        {
            <SfButton Content="@L["WizardShowButton"]" OnClick="() => _wizardVisible = true" CssClass="e-primary mb-4" />
        }

        @if (_wizardMessage is not null)
        {
            <div class="alert @(_wizardSucceeded ? "alert-success" : "alert-danger") mb-4">@_wizardMessage</div>
        }

        @if (_tunnelActionError is not null)
        {
            <div class="alert alert-danger mt-4">@_tunnelActionError</div>
        }
    }
}

@code {
    private sealed record NetworkTierOption(string Text, NetworkTier Value);

    private const int WizardStepCount = 4;

    private bool _isLoading = true;
    private bool _isSaving;
    private bool _showHelp;
    private string? _authError;
    private string? _loadError;
    private string? _message;
    private bool _success;

    private bool _mdnsSuccess;
    private string? _mdnsMessage;

    private int _maxConcurrentDownloads;

    // A bare number box is matched by browser autofill heuristics (it offered to save a "License Number"). This is a setting, not personal data.
    private readonly Dictionary<string, object> _maxConcurrentAttributes = new() { { "autocomplete", "off" }, { "name", "maxConcurrentDownloads" } };
    private bool _maxConcurrentSuccess;
    private string? _maxConcurrentMessage;

    private NetworkTier _currentTier;
    private NetworkTier _selectedTier;
    private NetworkTier? _pendingTier;

    private List<NetworkTierOption> _tierOptions => new()
    {
        new(L["LocalLabelText"], NetworkTier.Local),
        new(L["NetworkLabelText"], NetworkTier.Network),
        new(L["InternetLabelText"], NetworkTier.Internet),
    };

    // Remote access (Cloudflare Tunnel) state - only relevant/shown once the Internet tier is selected.
    private bool _isRemoteAccessLoading = true;
    private bool _isTunnelActing;
    private string? _remoteAccessLoadError;
    private string? _tunnelActionError;

    private string _tunnelStatus = "Stopped";
    private bool _tunnelConfigured;
    private string? _configuredUrl;
    private string _networkTier = "";
    private string _rpId = "";
    private string[] _passkeyOrigins = Array.Empty<string>();
    private bool _cloudflareAuthenticated;
    private string? _tunnelPublicUrl;
    private bool _offerLocalPassword;
    private string? _tunnelErrorMessage;
    private List<string> _tunnelRecentLogLines = new();

    // Setup wizard. Tokens are bound to inputs only long enough to submit them, then cleared; the
    // page never renders a token value back.
    private bool _wizardVisible = true;
    private int _wizardStep = 1;
    private bool _isWizardBusy;
    private string? _wizardMessage;
    private bool _wizardSucceeded;
    private string? _apiToken;
    private string? _tunnelToken;
    private string? _hostnamePrefix;
    private string? _selectedDomain;
    private List<string> _zones = new();
    private bool _confirmDisconnect;

    // Let's Encrypt settings. The contact email and staging choice are saved separately from issuing a certificate.
    private string? _leContactEmail;
    private bool _leUseStaging = true;
    private bool _isLeBusy;
    private string? _leMessage;
    private bool _leSucceeded;
    private CertificateStatus? _leStatus;
    private const string LeDownloadModule = "./_content/VideoForensics.Client.Ui.Shared/scripts/server-logs.js";

    private sealed record CertificateStatus(string? Hostname, bool Issued, DateTimeOffset? NotAfter, bool RenewalDue);

    private string GetTunnelBadgeClass() => _tunnelStatus switch
    {
        "Running" => "bg-success",
        "Starting" => "bg-info",
        "Failed" => "bg-danger",
        _ => "bg-light text-dark"
    };

    // Builds hostname-prefix + "." + selected-domain, or null while either part is missing or invalid.
    private string? BuildFqdn()
    {
        string prefix = (_hostnamePrefix ?? string.Empty).Trim().ToLowerInvariant();
        string domain = (_selectedDomain ?? string.Empty).Trim().TrimEnd('.').ToLowerInvariant();
        if (prefix.Length == 0 || domain.Length == 0 || !_zones.Contains(_selectedDomain!))
        {
            return null;
        }

        return $"{prefix}.{domain}";
    }

    protected override async Task OnInitializedAsync()
    {
        _maxConcurrentDownloads = Config.MaxConcurrentDownloads;
        await LoadAsync();
    }

    private async Task SaveMaxConcurrentAsync()
    {
        (_maxConcurrentSuccess, _maxConcurrentMessage) = await ConfigTools.SetMaxConcurrentDownloadsAsync(Config, _maxConcurrentDownloads, CancellationToken.None);
    }

    private bool CanAdmin => PageAccessRules.Allows(AccessPolicy.Admin, NavContext.FromSession(SessionState, appLockSupported: false));

    private async Task SaveMdnsAdvertisementAsync(bool enabled)
    {
        try
        {
            Config.EnableMdnsAdvertisement = enabled;
            try
            {
                (bool applied, _) = await ConfigTools.SetMdnsAdvertisementAsync(Config, enabled, CancellationToken.None);
                if (!applied)
                {
                    Config.EnableMdnsAdvertisement = !enabled;
                    _mdnsSuccess = false;
                    _mdnsMessage = L["AdminOnlySettingsNote"].Value;
                    return;
                }
            }
            catch (NotSupportedException)
            {
                _mdnsSuccess = false;
                _mdnsMessage = L["ConfigurationNotSupported"].Value;
                return;
            }
            _mdnsSuccess = true;
            _mdnsMessage = L["MdnsStatus", enabled ? "enabled" : "disabled"].Value;
        }
        catch (Exception ex)
        {
            _mdnsSuccess = false;
            _mdnsMessage = L["MdnsError", ex.Message].Value;
        }
    }

    private async Task ValidateApiTokenAsync()
    {
        if (string.IsNullOrWhiteSpace(_apiToken))
        {
            return;
        }

        _isWizardBusy = true;
        _wizardMessage = null;
        try
        {
            HttpResponseMessage response = await CreateClient().PostAsJsonAsync("api/remote-access/token", new { apiToken = _apiToken.Trim() });
            if (!response.IsSuccessStatusCode)
            {
                SetWizardError(await SafeReadErrorAsync(response) ?? response.ReasonPhrase);
                return;
            }

            _zones = await ReadZoneNamesAsync(response);
            _apiToken = null;
            _selectedDomain = _zones.FirstOrDefault();
            _wizardStep = 2;
            _wizardMessage = L["WizardTokenValidated", _zones.Count];
            _wizardSucceeded = true;
        }
        catch (Exception ex)
        {
            SetWizardError(ex.Message);
        }
        finally
        {
            _isWizardBusy = false;
        }
    }

    private async Task ProvisionTunnelAsync()
    {
        string? fqdn = BuildFqdn();
        if (fqdn is null)
        {
            return;
        }

        if (SessionState.SessionToken is null)
        {
            SetWizardError(L["RemoteAccessSignInRequired"]);
            return;
        }

        _isWizardBusy = true;
        _wizardMessage = null;
        try
        {
            // Creating a tunnel changes public DNS, so it needs a fresh passkey assertion like starting one.
            var stepUpToken = await StepUp.GetStepUpTokenAsync();
            var client = CreateClient();
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);

            var body = new { hostnamePrefix = _hostnamePrefix!.Trim(), domain = _selectedDomain! };
            HttpResponseMessage response = await client.PostAsJsonAsync("api/remote-access/tunnel/provision", body);
            if (!response.IsSuccessStatusCode)
            {
                SetWizardError(await SafeReadErrorAsync(response) ?? response.ReasonPhrase);
                return;
            }

            _tunnelToken = null;
            _wizardStep = WizardStepCount;
            _wizardMessage = L["WizardTunnelCreatedMessage"];
            _wizardSucceeded = true;
            await LoadRemoteAccessStatusAsync();
        }
        catch (Exception ex)
        {
            SetWizardError(ex.Message);
        }
        finally
        {
            _isWizardBusy = false;
        }
    }

    // First click arms the disconnect, second click performs it, so a stray click cannot remove the tokens.
    private async Task DisconnectAsync()
    {
        if (!_confirmDisconnect)
        {
            _confirmDisconnect = true;
            return;
        }

        _confirmDisconnect = false;
        _tunnelActionError = null;
        try
        {
            var response = await CreateClient().PostAsync("api/remote-access/disconnect", null);
            if (!response.IsSuccessStatusCode)
            {
                _tunnelActionError = await SafeReadErrorAsync(response) ?? L["RemoteAccessStopFailed", response.StatusCode.ToString()];
                return;
            }

            _zones = new List<string>();
            _selectedDomain = null;
            _hostnamePrefix = null;
            _wizardVisible = true;
            await LoadRemoteAccessStatusAsync();
        }
        catch (Exception ex)
        {
            _tunnelActionError = L["RemoteAccessStopFailed", ex.Message];
        }
    }

    private async Task SaveTunnelConfigurationAsync()
    {
        string? fqdn = BuildFqdn();
        if (fqdn is null || string.IsNullOrWhiteSpace(_tunnelToken))
        {
            return;
        }

        _isWizardBusy = true;
        _wizardMessage = null;
        try
        {
            var body = new { tunnelToken = _tunnelToken.Trim(), hostnamePrefix = _hostnamePrefix!.Trim(), domain = _selectedDomain! };
            HttpResponseMessage response = await CreateClient().PostAsJsonAsync("api/remote-access/tunnel", body);
            if (!response.IsSuccessStatusCode)
            {
                SetWizardError(await SafeReadErrorAsync(response) ?? response.ReasonPhrase);
                return;
            }

            _tunnelToken = null;
            _wizardStep = WizardStepCount;
            _wizardMessage = L["WizardSavedMessage"];
            _wizardSucceeded = true;
            await LoadRemoteAccessStatusAsync();
        }
        catch (Exception ex)
        {
            SetWizardError(ex.Message);
        }
        finally
        {
            _isWizardBusy = false;
        }
    }

    private void SetWizardError(string? message)
    {
        _wizardMessage = message ?? L["WizardUnknownError"];
        _wizardSucceeded = false;
    }

    private static async Task<List<string>> ReadZoneNamesAsync(HttpResponseMessage response)
    {
        System.Text.Json.JsonElement body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
        return body.GetProperty("zones").EnumerateArray()
            .Select(zone => zone.GetProperty("name").GetString() ?? string.Empty)
            .Where(name => name.Length > 0)
            .ToList();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            if (_currentTier == NetworkTier.Internet)
            {
                await LoadRemoteAccessStatusAsync();
            }

            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        try
        {
            var client = CreateClient();
            var response = await client.GetAsync("api/network-settings");
            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = L["AuthUnauthorized"];
                return;
            }

            response.EnsureSuccessStatusCode();
            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            _currentTier = Enum.Parse<NetworkTier>(body.GetProperty("configuredTier").GetString()!);
            _selectedTier = _currentTier;
            _pendingTier = null;

            var internalUrlResponse = await client.GetAsync("api/network-settings/internal-url");
            if (internalUrlResponse.IsSuccessStatusCode)
            {
                var internalUrlBody = await internalUrlResponse.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                _internalUrl = NullableString(internalUrlBody, "internalServerUrl");
            }

            var portsResponse = await client.GetAsync("api/network-settings/server-ports");
            if (portsResponse.IsSuccessStatusCode)
            {
                var portsBody = await portsResponse.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                _httpPort = portsBody.TryGetProperty("httpPort", out var httpPortValue) && httpPortValue.ValueKind == System.Text.Json.JsonValueKind.Number ? httpPortValue.GetInt32() : 0;
                _httpsPort = portsBody.TryGetProperty("httpsPort", out var httpsPortValue) && httpsPortValue.ValueKind == System.Text.Json.JsonValueKind.Number ? httpsPortValue.GetInt32() : 0;
            }
        }
        catch (Exception ex)
        {
            _loadError = L["LoadFailed", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task OnTierChanged(NetworkTier newTier)
    {
        _selectedTier = newTier;
        _message = null;

        if (newTier > _currentTier)
        {
            // Widening requires step-up confirmation before it takes effect.
            _pendingTier = newTier;
            return;
        }

        // Narrowing (or re-selecting the current tier) needs no confirmation.
        await SaveAsync(newTier, stepUpToken: null);
    }

    private void CancelPendingWiden()
    {
        _pendingTier = null;
        _selectedTier = _currentTier;
    }

    private async Task ConfirmWidenAsync()
    {
        if (_pendingTier is null || SessionState.SessionToken is null)
        {
            return;
        }

        _isSaving = true;
        try
        {
            var stepUpToken = await StepUp.GetStepUpTokenAsync();
            await SaveAsync(_pendingTier.Value, stepUpToken);
            _pendingTier = null;
        }
        catch (Exception ex)
        {
            _success = false;
            _message = L["SaveFailed", ex.Message];
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task SaveAsync(NetworkTier tier, string? stepUpToken)
    {
        try
        {
            var client = CreateClient();
            if (stepUpToken is not null)
            {
                client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            }

            var response = await client.PostAsJsonAsync("api/network-settings", new { tier });
            if (!response.IsSuccessStatusCode)
            {
                var body = await SafeReadErrorAsync(response);
                _success = false;
                _message = body ?? L["SaveFailed", response.StatusCode.ToString()];
                _selectedTier = _currentTier;
                return;
            }

            _currentTier = tier;
            _success = true;
            _message = L["SavedMessage"];

            if (_currentTier == NetworkTier.Internet)
            {
                await LoadRemoteAccessStatusAsync();
            }
        }
        catch (Exception ex)
        {
            _success = false;
            _message = L["SaveFailed", ex.Message];
            _selectedTier = _currentTier;
        }
    }

    private static async Task<string?> SafeReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var doc = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            return doc is not null && doc.TryGetValue("error", out var msg) ? msg : null;
        }
        catch
        {
            return null;
        }
    }

    private async Task LoadRemoteAccessStatusAsync()
    {
        _isRemoteAccessLoading = true;
        _remoteAccessLoadError = null;
        try
        {
            var client = CreateClient();
            var response = await client.GetAsync("api/remote-access/status");
            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _remoteAccessLoadError = L["AuthUnauthorized"];
                return;
            }

            response.EnsureSuccessStatusCode();
            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            bool authenticated = body.GetProperty("cloudflareAuthenticated").GetBoolean();
            _tunnelConfigured = body.GetProperty("tunnelConfigured").GetBoolean();
            _configuredUrl = NullableString(body, "configuredUrl");
            _cloudflareAuthenticated = body.GetProperty("cloudflareAuthenticated").GetBoolean();
            _networkTier = body.GetProperty("networkTier").GetString() ?? "";
            _rpId = body.GetProperty("rpId").GetString() ?? "";
            _passkeyOrigins = body.GetProperty("passkeyOrigins").EnumerateArray().Select(e => e.GetString() ?? "").ToArray();
            _tunnelStatus = body.GetProperty("status").GetString() ?? "Stopped";
            _tunnelPublicUrl = NullableString(body, "publicUrl");
            _tunnelErrorMessage = NullableString(body, "errorMessage");
            _tunnelRecentLogLines = body.GetProperty("recentLogLines").EnumerateArray().Select(e => e.GetString() ?? "").ToList();

            await LoadCertificateSettingsAsync(client);
            await LoadCertificateStatusAsync(client);

            // Passkeys only work on the tunnel address, so keep the passkey address pointed at it without asking.
            if (_tunnelPublicUrl is not null && !IsPasskeyOriginCurrent(_tunnelPublicUrl))
            {
                await ConfigurePasskeyOriginAsync();
            }

            // Resume the wizard where the saved configuration leaves off.
            if (_tunnelConfigured)
            {
                _wizardStep = WizardStepCount;
            }
            else if (authenticated)
            {
                await LoadZonesAsync(client);
            }
            else
            {
                _wizardStep = 1;
            }
        }
        catch (Exception ex)
        {
            _remoteAccessLoadError = L["RemoteAccessLoadFailed", ex.Message];
        }
        finally
        {
            _isRemoteAccessLoading = false;
        }
    }

    private async Task LoadZonesAsync(HttpClient client)
    {
        HttpResponseMessage zonesResponse = await client.GetAsync("api/remote-access/zones");
        if (!zonesResponse.IsSuccessStatusCode)
        {
            _wizardStep = 1;
            SetWizardError(await SafeReadErrorAsync(zonesResponse) ?? zonesResponse.ReasonPhrase);
            return;
        }

        _zones = await ReadZoneNamesAsync(zonesResponse);
        _selectedDomain ??= _zones.FirstOrDefault();
        _wizardStep = 2;
    }

    private static string? NullableString(System.Text.Json.JsonElement body, string property)
    {
        System.Text.Json.JsonElement value = body.GetProperty(property);
        return value.ValueKind == System.Text.Json.JsonValueKind.Null ? null : value.GetString();
    }

    private async Task LoadCertificateSettingsAsync(HttpClient client)
    {
        try
        {
            var response = await client.GetAsync("api/remote-access/certificate-settings");
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            _leContactEmail = NullableString(body, "contactEmail");
            _leUseStaging = body.GetProperty("useStaging").GetBoolean();
        }
        catch (Exception)
        {
            // The form keeps its defaults; the save and request actions report their own errors.
        }
    }

    private async Task LoadCertificateStatusAsync(HttpClient client)
    {
        try
        {
            var response = await client.GetAsync("api/remote-access/certificate-status");
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var body = await response.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            bool issued = body.GetProperty("issued").GetBoolean();
            _leStatus = new CertificateStatus(
                NullableString(body, "hostname"),
                issued,
                issued ? body.GetProperty("notAfter").GetDateTimeOffset() : null,
                body.GetProperty("renewalDue").GetBoolean());
        }
        catch (Exception)
        {
            // The status line stays hidden; the actions report their own errors.
        }
    }

    private async Task DownloadCertificateAsync()
    {
        _isLeBusy = true;
        _leMessage = null;
        try
        {
            var response = await CreateClient().GetAsync("api/remote-access/certificate/download");
            if (!response.IsSuccessStatusCode)
            {
                SetLeMessage(await SafeReadErrorAsync(response) ?? L["CertificateDownloadFailed", response.StatusCode.ToString()], false);
                return;
            }

            string pem = await response.Content.ReadAsStringAsync();
            await using IJSObjectReference module = await JS.InvokeAsync<IJSObjectReference>("import", LeDownloadModule);
            await module.InvokeVoidAsync("downloadText", $"{_leStatus?.Hostname ?? "certificate"}-chain.pem", pem);
        }
        catch (Exception ex)
        {
            SetLeMessage(L["CertificateDownloadFailed", ex.Message], false);
        }
        finally
        {
            _isLeBusy = false;
        }
    }

    // Resetting changes what the server presents, so it needs a fresh passkey assertion like issuing does.
    private async Task ResetCertificateAsync()
    {
        if (SessionState.SessionToken is null)
        {
            SetLeMessage(L["RemoteAccessSignInRequired"], false);
            return;
        }

        _isLeBusy = true;
        _leMessage = null;
        try
        {
            var stepUpToken = await StepUp.GetStepUpTokenAsync();
            var client = CreateClient();
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            var response = await client.PostAsync("api/remote-access/certificate/reset", null);
            if (!response.IsSuccessStatusCode)
            {
                SetLeMessage(await SafeReadErrorAsync(response) ?? L["ResetCertificateFailed", response.StatusCode.ToString()], false);
                return;
            }

            SetLeMessage(L["ResetCertificateSucceeded"], true);
            await LoadCertificateStatusAsync(CreateClient());
        }
        catch (Exception ex)
        {
            SetLeMessage(L["ResetCertificateFailed", ex.Message], false);
        }
        finally
        {
            _isLeBusy = false;
        }
    }

