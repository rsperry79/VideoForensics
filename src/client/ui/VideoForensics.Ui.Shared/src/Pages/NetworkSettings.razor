    private void SetLeMessage(string message, bool succeeded)
    {
        _leMessage = message;
        _leSucceeded = succeeded;
    }

    // Compares by origin so a trailing slash or path in the tunnel URL does not trigger a needless save.
    private bool IsPasskeyOriginCurrent(string tunnelUrl)
    {
        if (!Uri.TryCreate(tunnelUrl, UriKind.Absolute, out Uri? tunnel))
        {
            return false;
        }

        string origin = tunnel.GetLeftPart(UriPartial.Authority);
        return _passkeyOrigins.Any(o => string.Equals(o.TrimEnd('/'), origin, StringComparison.OrdinalIgnoreCase));
    }

    private async Task ConfigurePasskeyOriginAsync()
    {
        if (string.IsNullOrWhiteSpace(_tunnelPublicUrl))
        {
            return;
        }

        try
        {
            HttpResponseMessage response = await CreateClient().PostAsJsonAsync(
                "api/network-settings/internet-url", new { internetServerUrl = _tunnelPublicUrl });
            response.EnsureSuccessStatusCode();
            _message = L["PasskeyAddressSaved"];
            _success = true;
        }
        catch (Exception ex)
        {
            _message = ex.Message;
            _success = false;
        }
    }

    private async Task StartTunnelAsync()
    {
        await RunTunnelStepUpGatedActionAsync("api/remote-access/start", null);
        if (_tunnelActionError is null)
        {
            await OfferLocalPasswordIfOffAsync();
        }
    }

    /// <summary>
    /// Once the tunnel is up, asks whether local sign-in should also accept a password. Passkeys cannot run on the plain-http
    /// LAN address, so this keeps the LAN usable. Only asks when password sign-in is currently off. Fails quiet on error.
    /// </summary>
    private async Task OfferLocalPasswordIfOffAsync()
    {
        try
        {
            using HttpResponseMessage response = await CreateClient().GetAsync("api/v1/auth-methods/settings");
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            AuthMethodSettingsDto? settings = await response.Content.ReadFromJsonAsync<AuthMethodSettingsDto>();
            _offerLocalPassword = settings is { PasswordEnabled: false };
        }
        catch (Exception)
        {
            _offerLocalPassword = false;
        }
    }

    private async Task EnableLocalPasswordAsync()
    {
        _offerLocalPassword = false;
        _isTunnelActing = true;
        try
        {
            var stepUpToken = await StepUp.GetStepUpTokenAsync();
            var client = CreateClient();
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            HttpResponseMessage response = await client.PutAsJsonAsync("api/v1/auth-methods/settings", new UpdateAuthMethodSettingsRequest(PasswordEnabled: true));
            if (!response.IsSuccessStatusCode)
            {
                _tunnelActionError = await SafeReadErrorAsync(response) ?? L["RemoteAccessActionFailed", response.StatusCode.ToString()];
            }
        }
        catch (Exception ex)
        {
            _tunnelActionError = L["RemoteAccessActionFailed", ex.Message];
        }
        finally
        {
            _isTunnelActing = false;
        }
    }

    private async Task RunTunnelStepUpGatedActionAsync(string url, object? body)
    {
        if (SessionState.SessionToken is null)
        {
            _tunnelActionError = L["RemoteAccessSignInRequired"];
            return;
        }

        _isTunnelActing = true;
        _tunnelActionError = null;
        try
        {
            // Starting a tunnel exposes this server to the internet - a fresh passkey assertion is
            // required at the moment of the action, not just an already-open session (plan §5.7).
            var stepUpToken = await StepUp.GetStepUpTokenAsync();

            var client = CreateClient();
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            var response = body is null
                ? await client.PostAsync(url, null)
                : await client.PostAsJsonAsync(url, body);

            if (!response.IsSuccessStatusCode)
            {
                var errorBody = await SafeReadErrorAsync(response);
                _tunnelActionError = errorBody ?? L["RemoteAccessActionFailed", response.StatusCode.ToString()];
                return;
            }

            await LoadRemoteAccessStatusAsync();
        }
        catch (Exception ex)
        {
            _tunnelActionError = L["RemoteAccessActionFailed", ex.Message];
        }
        finally
        {
            _isTunnelActing = false;
        }
    }

    private async Task StopTunnelAsync()
    {
        _tunnelActionError = null;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsync("api/remote-access/stop", null);
            if (!response.IsSuccessStatusCode)
            {
                _tunnelActionError = await SafeReadErrorAsync(response) ?? L["RemoteAccessStopFailed", response.StatusCode.ToString()];
                return;
            }

            await LoadRemoteAccessStatusAsync();
        }
        catch (Exception ex)
        {
            _tunnelActionError = L["RemoteAccessStopFailed", ex.Message];
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }
