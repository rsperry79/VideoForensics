@using VideoForensics.Core.Api.Contracts.Repositories
@page "/live-view"
@using System.Reactive.Linq
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Client.Common.Contracts
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Core.Api.Contracts
@using VideoForensics.Client.Ui.Shared.Layout.RightPanel
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using VideoForensics.Client.Ui.Shared.Contracts
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Services.Review
@using VideoForensics.Client.Common.Viewer
@implements IAsyncDisposable

@using VideoForensics.Client.Ui.Shared.Components.Review
@using VideoForensics.Client.Ui.Shared.Components.Viewer
@inject ILiveViewSessionService LiveViewSessionService
@inject ILiveViewSessionSource LiveViewSessionSource
@inject IDeviceRepository DeviceRepository
@inject IMediaItemRepository MediaItems
@inject IMediaContentUrlProvider ContentUrls
@inject IEvidenceChangedSource EvidenceChangedSource
@inject NavigationManager NavigationManager
@* The camera choice lives in the shared review state, so Live View shows the cameras chosen on the Review page and the reverse. *@
@inject ReviewPageState CameraState
@inject IJSRuntime JsRuntime
@inject PairedSessionState SessionState
@inject IStringLocalizer<LiveView> L
@inject ILogger<LiveView> Logger
@inject RightPanelFilterStore FilterStore

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a>
    </div>
}
else
{
    <PageRightPanelContent>
        <div class="right-panel-section">
            <small>@L["Title"]</small>
            <div class="d-flex flex-column gap-2">
                <ReviewCameraSelector State="CameraState" Devices="_cameraIds" DeviceNames="_deviceNames" Mode="DevicePickerMode.Cameras" />

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger">@_error</div>
                }
            </div>
        </div>

        @if (_liveDeviceId.HasValue)
        {
            <div class="right-panel-section">
                <small>@L["TelemetryHeading"]</small>
                @if (_latestTelemetry is null)
                {
                    <div class="text-muted small">@L["NoDataYet"]</div>
                }
                else
                {
                    <dl class="row small mb-0">
                        <dt class="col-7">@L["LossLabel"]</dt>
                        <dd class="col-5">@TelemetryText(LiveViewTelemetryFormatter.FormatLossPercent(_latestTelemetry.FractionLost))</dd>

                        <dt class="col-7">@L["PacketsLostLabel"]</dt>
                        <dd class="col-5">@TelemetryText(LiveViewTelemetryFormatter.FormatCount(_latestTelemetry.CumulativePacketsLost))</dd>

                        <dt class="col-7">@L["JitterLabel"]</dt>
                        <dd class="col-5">@TelemetryText(LiveViewTelemetryFormatter.FormatCount(_latestTelemetry.JitterTicks))</dd>

                        <dt class="col-7">@L["BitrateLabel"]</dt>
                        <dd class="col-5">@TelemetryText(LiveViewTelemetryFormatter.FormatKilobitsPerSecond(_latestTelemetry.BitrateBps))</dd>

                        <dt class="col-7">@L["ScoreLabel"]</dt>
                        <dd class="col-5">@TelemetryText(LiveViewTelemetryFormatter.FormatScore(_latestTelemetry.InterferenceScore))</dd>
                    </dl>
                }
            </div>
        }
    </PageRightPanelContent>

    <div class="live-view-grid">
        @foreach (Guid id in ShownCameras)
        {
            bool live = _liveDeviceId == id;
            <div class="live-view-tile" data-testid="live-view-tile" data-device-id="@id.ToString("D")">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <span class="small">@NameOf(id)</span>
                    <SfButton Content="@(live ? L["Stop"] : L["Start"])"
                        OnClick="@(async () => await ToggleLiveAsync(id))"
                        CssClass="@(live ? "e-danger" : "e-primary")"
                        Disabled="@(_isToggling || (_liveDeviceId.HasValue && !live))" />
                </div>

                @if (live)
                {
                    <div class="live-view-container">
                        <MediaPlayer Live="true" ElementId="liveViewPlayer" Class="live-view-video" Autoplay="true" Muted="true" Controls="MediaPlayerControls.None" Fit="MediaFitMode.Cover" />
                    </div>
                }
                else if (_stills.TryGetValue(id, out string? url) && !string.IsNullOrEmpty(url))
                {
                    <img class="live-view-still" src="@url" alt="@NameOf(id)" data-testid="live-view-still" />
                }
                else
                {
                    <div class="live-view-empty small text-muted">@L["NoStill"]</div>
                }
            </div>
        }
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated = false;
    private bool _isToggling = false;
    private string? _error;

    /// <summary>The camera to show first, passed by the review page's Live link.</summary>
    [SupplyParameterFromQuery(Name = "device")]
    public Guid? Device { get; set; }

    private IReadOnlyList<Guid> _cameraIds = [];
    private Dictionary<Guid, string> _deviceNames = new();

    // The media page's camera filter. An empty selection means the first cameras, as the media page shows them.

    /// <summary>Key for this page's remembered camera choice in the device's local storage.</summary>
    private const string FilterPageKey = "live-view";

    // The latest still per camera, as a browser-loadable URL. A null value means the camera has no still in the last hour.
    private readonly Dictionary<Guid, string?> _stills = new();

    // One live stream at a time. _pendingStreamSessionId starts the stream once its tile has rendered.
    private Guid? _liveDeviceId;
    private Guid? _selectedSessionId;
    private Guid? _pendingStreamSessionId;
    private IJSObjectReference? _hubConnection;
    private IJSObjectReference? _jsModule;
    private readonly LiveViewActivationWaiter _activationWaiter = new();
    private IDisposable? _telemetrySubscription;
    private IDisposable? _evidenceSubscription;
    private volatile bool _disposed;
    private LiveViewTelemetrySample? _latestTelemetry;

    private IReadOnlyList<Guid> ShownCameras =>
        CameraState.CameraIds.Count > 0
            ? CameraState.CameraIds
            : _cameraIds.Take(CameraSync.MaxTiles).ToList();

    private string NameOf(Guid id) => _deviceNames.TryGetValue(id, out string? name) ? name : id.ToString("D");

    protected override async Task OnInitializedAsync()
    {
        _isLoading = true;
        _isAuthenticated = true; // Assume authenticated since @attribute [Authorize] gates the page

        try
        {
            var devices = await DeviceRepository.ListAsync(System.Threading.CancellationToken.None);
            var cameras = devices.Where(device => DeviceKinds.IsCamera(device.Type)).ToList();
            _cameraIds = cameras.Select(device => device.Id).ToList();
            _deviceNames = cameras.ToDictionary(device => device.Id, device => device.Name ?? $"Device {device.ProviderDeviceId}");

            if (Device is Guid requested && _cameraIds.Contains(requested))
            {
                CameraState.SetCameras([requested]);
            }
            else
            {
                // Restore the camera choice the operator last made on this device. Ids that no longer exist are dropped.
                RightPanelFilters? stored = await FilterStore.LoadAsync(FilterPageKey);
                if (stored?.Cameras is { } saved)
                {
                    Guid[] restored = saved.Select(s => Guid.TryParse(s, out Guid id) ? id : Guid.Empty)
                        .Where(id => _cameraIds.Contains(id))
                        .ToArray();
                    if (restored.Length > 0)
                    {
                        CameraState.SetCameras(restored);
                    }
                }
            }

            CameraState.OnChange += OnCameraSelectionChanged;
            _evidenceSubscription = EvidenceChangedSource.EvidenceChanged.Subscribe(OnEvidenceChanged);
            await LoadMissingStillsAsync();

            _jsModule = await JsRuntime.InvokeAsync<IJSObjectReference>(
                "import", "./_content/VideoForensics.Client.Ui.Shared/scripts/liveview.js");

            // Open the SignalR connection in JS and keep a reference to it. The server sends its ICE candidates
            // inside the offer, and startLiveView registers the handler for any it pushes later.
            _hubConnection = await _jsModule.InvokeAsync<IJSObjectReference>("initializeHubConnection", NavigationManager.ToAbsoluteUri("/hubs/liveview-signaling").ToString(), SessionState.SessionToken);
        }
        catch (Exception ex)
        {
            _error = L["ErrorInitializing", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // The stream starts only after its tile has rendered, so the player element exists when the JS looks for it.
        if (_pendingStreamSessionId is Guid sessionId && _jsModule is not null && _hubConnection is not null)
        {
            _pendingStreamSessionId = null;
            try
            {
                await _jsModule.InvokeVoidAsync("startLiveView", _hubConnection, sessionId, "liveViewPlayer");
            }
            catch (JSException ex)
            {
                _error = ex.Message;
                await StopLiveAsync();
                StateHasChanged();
            }
        }
    }

    private void OnCameraSelectionChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            await FilterStore.SaveAsync(FilterPageKey, new RightPanelFilters(null, null, CameraState.CameraIds.Select(id => id.ToString("D")).ToArray()));
            await LoadMissingStillsAsync();
            StateHasChanged();
        });
    }

    // The evidence feed says which camera gained a snapshot. Only a camera on screen reloads its still.
    private void OnEvidenceChanged(EvidenceChangedDto change)
    {
        if (_disposed || !ShownCameras.Contains(change.DeviceId) || _liveDeviceId == change.DeviceId)
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            if (_disposed)
            {
                return;
            }

            await LoadStillAsync(change.DeviceId, System.Threading.CancellationToken.None);
            StateHasChanged();
        });
    }

    private async Task LoadMissingStillsAsync()
    {
        foreach (Guid id in ShownCameras)
        {
            if (!_stills.ContainsKey(id))
            {
                await LoadStillAsync(id, System.Threading.CancellationToken.None);
            }
        }
    }

    /// <summary>Loads the camera's newest snapshot in the last hour, as a browser-loadable URL.</summary>
    private async Task LoadStillAsync(Guid deviceId, System.Threading.CancellationToken ct)
    {
        try
        {
            DateTime now = DateTime.UtcNow;
            IReadOnlyList<MediaItemDto> snapshots = await MediaItems.GetSnapshotsByDeviceAndDateRangeAsync(deviceId, now.AddHours(-1), now, ct);
            MediaItemDto? newest = snapshots.LastOrDefault();
            if (newest is null)
            {
                _stills[deviceId] = null;
                return;
            }

            IReadOnlyDictionary<Guid, string> urls = await ContentUrls.GetContentUrlsAsync([newest.Id], ct);
            _stills[deviceId] = urls.TryGetValue(newest.Id, out string? url) ? url : null;
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError("Could not load the latest still for {DeviceName}: {ExceptionType}: {Message}", NameOf(deviceId), ex.GetType().FullName, ex.Message);
            _stills[deviceId] = null;
        }
    }

    private async Task ToggleLiveAsync(Guid deviceId)
    {
        try
        {
            _isToggling = true;
            _error = null;

            if (_liveDeviceId == deviceId)
            {
                await StopLiveAsync();
                return;
            }

            if (_liveDeviceId.HasValue)
            {
                await StopLiveAsync();
            }

            var session = await LiveViewSessionService.StartAsync(
                deviceId,
                LiveViewTriggerReason.Manual,
                null,
                System.Threading.CancellationToken.None);

            _selectedSessionId = session.Id;
            _liveDeviceId = deviceId;
            SubscribeToTelemetry(session.Id);

            // Always wait, even when the start response is already Active. The waiter joins the session's push
            // group before its race-guard read, so telemetry arrives for a session that was Active at start.
            LiveViewSession? active = await _activationWaiter.WaitForActiveAsync(
                session.Id,
                LiveViewSessionSource,
                ct => LiveViewSessionService.GetActiveSessionAsync(deviceId, ct),
                LiveViewActivationWaiter.DefaultTimeout,
                System.Threading.CancellationToken.None);

            if (active is null)
            {
                _error = L["SessionFailedToConnect"];
                await UnsubscribeFromSessionAsync(session.Id);
                _selectedSessionId = null;
                _liveDeviceId = null;
                return;
            }

            _pendingStreamSessionId = active.Id;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            await StopLiveAsync();
        }
        finally
        {
            _isToggling = false;
        }
    }

    /// <summary>Stops the live stream on screen and puts that camera's still back.</summary>
    private async Task StopLiveAsync()
    {
        Guid? stopped = _liveDeviceId;

        if (_selectedSessionId is Guid sessionId)
        {
            try
            {
                await LiveViewSessionService.StopAsync(sessionId, "ManualStop", System.Threading.CancellationToken.None);
            }
            catch (Exception ex)
            {
                Logger.LogError("Could not stop a live-view session: {ExceptionType}: {Message}", ex.GetType().FullName, ex.Message);
            }

            await UnsubscribeFromSessionAsync(sessionId);
        }

        _selectedSessionId = null;
        _liveDeviceId = null;
        _pendingStreamSessionId = null;

        if (stopped is Guid id)
        {
            await LoadStillAsync(id, System.Threading.CancellationToken.None);
        }
    }

    private async Task CleanupAsync()
    {
        _disposed = true;
        CameraState.OnChange -= OnCameraSelectionChanged;
        _evidenceSubscription?.Dispose();
        _evidenceSubscription = null;

        if (_liveDeviceId.HasValue && _selectedSessionId.HasValue)
        {
            try
            {
                await LiveViewSessionService.StopAsync(_selectedSessionId.Value, "PageDisposed", System.Threading.CancellationToken.None);
            }
            catch (Exception ex)
            {
                Logger.LogError("Could not stop a live-view session on leaving the page: {ExceptionType}: {Message}", ex.GetType().FullName, ex.Message);
            }
        }

        if (_selectedSessionId.HasValue)
            await UnsubscribeFromSessionAsync(_selectedSessionId.Value);

        DisposeTelemetrySubscription();

        if (_jsModule is not null && _hubConnection is not null)
        {
            try
            {
                await _jsModule.InvokeVoidAsync("stopHubConnection", _hubConnection);
                await _hubConnection.DisposeAsync();
            }
            catch (JSException)
            {
                // Best effort: the circuit may already be gone, and the server drops the connection on disconnect.
            }
            catch (JSDisconnectedException)
            {
                // Disposal runs after the circuit has closed, so JavaScript can no longer be called. Nothing is left to stop.
            }
        }

        if (_jsModule is not null)
        {
            try
            {
                await _jsModule.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit closed first, so the module is already gone.
            }
        }
    }

    // Leaving the push group is best effort: the page is already leaving this session. A failure is logged and does not
    // block the stop or dispose, since the hub drops group membership on disconnect anyway.
    private async Task UnsubscribeFromSessionAsync(Guid sessionId)
    {
        DisposeTelemetrySubscription();

        try
        {
            await LiveViewSessionSource.UnsubscribeAsync(sessionId, System.Threading.CancellationToken.None);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not leave the live-view push group for a session");
        }
    }

    // Telemetry arrives on a hub thread, so the update is marshalled onto the component's dispatcher. Samples for
    // any other session are ignored, so a stale push cannot overwrite the session on screen.
    private void SubscribeToTelemetry(Guid sessionId)
    {
        DisposeTelemetrySubscription();
        _telemetrySubscription = LiveViewSessionSource.Telemetry.Subscribe(sample =>
        {
            if (_disposed || sample.SessionId != sessionId)
            {
                return;
            }

            _ = InvokeAsync(() =>
            {
                if (_disposed)
                {
                    return;
                }

                _latestTelemetry = sample;
                StateHasChanged();
            });
        });
    }

    private void DisposeTelemetrySubscription()
    {
        _telemetrySubscription?.Dispose();
        _telemetrySubscription = null;
        _latestTelemetry = null;
    }

    // A value the formatter could not produce is a resource key; everything else is already invariant-formatted text.
    private string TelemetryText(string text) =>
        text == LiveViewTelemetryFormatter.NotAvailableKey ? L[text].Value : text;

    public async ValueTask DisposeAsync()
    {
        await CleanupAsync();
    }
}

<style>
.live-view-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 0.75rem;
    /* Fill the page width, so one camera stretches across it instead of sitting at its minimum size. */
    width: 100%;
    box-sizing: border-box;
}

.live-view-tile {
    background-color: #111;
    border-radius: 4px;
    padding: 0.5rem;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
}

.live-view-still {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
}

.live-view-empty {
    min-height: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
}

.live-view-container {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    background-color: #000;
}

/* The player's box is the flex item, so it must fill the container for the video's max-height to apply. */
div.live-view-container > div.media-player {
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
}

.live-view-video {
    max-width: 100%;
    max-height: 100%;
    object-fit: cover;
}
</style>
