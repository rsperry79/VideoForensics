@page "/chat"
@using VideoForensics.Client.Ui.Shared.Components
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Resources

@inject IStringLocalizer<SharedResources> L

<div class="chat-page">
    <h1>@L["Chat"]</h1>
    <p class="chat-subtitle">Ask questions about the investigation. The assistant can search events, analyze patterns, and provide insights.</p>

    <div class="chat-container">
        <ChatPanel />
    </div>
</div>

<style>
    .chat-page {
        display: flex;
        flex-direction: column;
        height: 100%;
        padding: 16px;
        background: var(--bs-body-bg);
    }

    .chat-page h1 {
        margin: 0 0 4px 0;
        font-size: 24px;
        font-weight: 600;
        color: var(--bs-emphasis-color);
    }

    .chat-subtitle {
        margin: 0 0 12px 0;
        font-size: 14px;
        color: var(--bs-secondary-color);
    }

    .chat-container {
        flex: 1;
        display: flex;
        flex-direction: column;
        min-height: 0;
    }
</style>
