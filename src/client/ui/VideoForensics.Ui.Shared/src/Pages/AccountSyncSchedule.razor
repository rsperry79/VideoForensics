@page "/accounts/{Id:guid}/schedule"
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Data.Common.Contracts
@inject ISyncScheduleRepository SyncScheduleRepository
@inject NavigationManager NavigationManager
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AccountSyncSchedule> L

<Breadcrumb Items="@_breadcrumbItems" />

<h4 class="mb-4">@L["SyncScheduleTitle"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @(_statusIsError ? "alert-danger" : "alert-success")">
            @_statusMessage
        </div>
    }

    <div class="card p-4">
        <div class="card-body">
            <h5 class="card-title">@L["ConfigureSyncSettings"]</h5>

            <EditForm Model="this" OnValidSubmit="SaveScheduleAsync">
                <div class="mb-3">
                    <label for="snapshot-rssi-interval">@L["SnapshotRssiIntervalLabel"]</label>
                    <SfNumericTextBox ID="snapshot-rssi-interval" @bind-Value="_snapshotRssiIntervalMinutes" Min="1" Step="1" />
                </div>
                <div class="mb-3">
                    <label for="event-poll-interval">@L["EventPollIntervalLabel"]</label>
                    <SfNumericTextBox ID="event-poll-interval" @bind-Value="_eventPollIntervalMinutes" Min="1" Step="1" />
                </div>

                <div class="mb-3">
                    <label for="is-enabled">
                        <SfCheckBox ID="is-enabled" @bind-Checked="_isEnabled" TChecked="bool" />
                        @L["EnableSync"]
                    </label>
                </div>

                @if (_schedule != null)
                {
                    <div class="mb-3">
                        <label>@L["LastEventPoll"]</label>
                        <p>@(_schedule.EventLastRunUtc?.ToString("g") ?? L["Never"])</p>
                    </div>

                    <div class="mb-3">
                        <label>@L["NextEventPoll"]</label>
                        <p>@(_schedule.EventNextRunUtc?.ToString("g") ?? L["NotAvailable"])</p>
                    </div>

                    <div class="mb-3">
                        <label>@L["LastSnapshotPoll"]</label>
                        <p>@(_schedule.SnapshotLastRunUtc?.ToString("g") ?? L["Never"])</p>
                    </div>

                    <div class="mb-3">
                        <label>@L["NextSnapshotPoll"]</label>
                        <p>@(_schedule.SnapshotNextRunUtc?.ToString("g") ?? L["NotAvailable"])</p>
                    </div>
                }

                <hr class="my-4" />

                <div class="mb-3">
                    <label for="use-advanced-jamming">
                        <SfCheckBox ID="use-advanced-jamming" @bind-Checked="_useAdvancedJammingSchedule" TChecked="bool" />
                        @L["AdvancedJammingSchedule"]
                    </label>
                </div>

                @if (_useAdvancedJammingSchedule)
                {
                    <div class="card border-secondary mb-4">
                        <div class="card-header bg-light">
                            <h6 class="mb-0">@L["JammingDetectionWindows"]</h6>
                        </div>
                        <div class="card-body">
                            @if (_jammingWindows == null || _jammingWindows.Count == 0)
                            {
                                <p class="text-muted">@L["NoJammingWindows"]</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>@L["ColDayOfWeek"]</th>
                                                <th>@L["ColStartTime"]</th>
                                                <th>@L["ColEndTime"]</th>
                                                <th>@L["ColIntervalMin"]</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var window in _jammingWindows)
                                            {
                                                <tr>
                                                    <td>
                                                        <SfDropDownList TValue="int" TItem="(int Value, string Display)" DataSource="@_dayOfWeekOptions" @bind-Value="window.DayOfWeek">
                                                            <DropDownListFieldSettings Text="Display" Value="Value"></DropDownListFieldSettings>
                                                        </SfDropDownList>
                                                    </td>
                                                    <td>
                                                        <SfDropDownList TValue="int" TItem="TimeOption" DataSource="@_timeOptions" @bind-Value="window.StartMinuteOfDay">
                                                            <DropDownListFieldSettings Text="@nameof(TimeOption.Display)" Value="@nameof(TimeOption.Minutes)"></DropDownListFieldSettings>
                                                        </SfDropDownList>
                                                    </td>
                                                    <td>
                                                        <SfDropDownList TValue="int" TItem="TimeOption" DataSource="@_timeOptions" @bind-Value="window.EndMinuteOfDay">
                                                            <DropDownListFieldSettings Text="@nameof(TimeOption.Display)" Value="@nameof(TimeOption.Minutes)"></DropDownListFieldSettings>
                                                        </SfDropDownList>
                                                    </td>
                                                    <td>
                                                        <SfNumericTextBox @bind-Value="window.SnapshotRssiIntervalMinutes" Min="1" Step="1" />
                                                    </td>
                                                    <td>
                                                        <SfButton type="button" IconCss="e-icons e-delete" CssClass="e-outline e-small" OnClick="@(() => RemoveWindow(window))" TrueName="@L["Remove"]" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <div class="mt-3">
                                <SfButton type="button" OnClick="AddWindow" CssClass="e-outline" Content="@L["AddWindow"]" />
                            </div>
                        </div>
                    </div>
                }

                <div class="mt-4">
                    <SfButton type="submit" CssClass="e-primary" Disabled="@_isBusy" Content="@(_isBusy ? L["Saving"] : L["Save"])" />
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private List<(string Label, string? Url)> _breadcrumbItems = new();
    private SyncSchedule? _schedule;
    private int _snapshotRssiIntervalMinutes = 60;
    private int _eventPollIntervalMinutes = 60;
    private bool _isEnabled = true;
    private bool _useAdvancedJammingSchedule;
    private List<JammingScheduleWindow>? _jammingWindows;
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _statusMessage;
    private bool _statusIsError;

    private record TimeOption(int Minutes, string Display);
    private List<TimeOption> _timeOptions = [];
    private List<(int Value, string Display)> _dayOfWeekOptions = [];

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbItems = new() { (L["BreadcrumbAccounts"], "/accounts"), (L["BreadcrumbAccountDetails"], $"/accounts/{Id}"), (L["SyncScheduleTitle"], null) };
        _timeOptions = BuildTimeOptions();
        _dayOfWeekOptions = BuildDayOfWeekOptions();
        await LoadScheduleAsync();
    }

    private List<TimeOption> BuildTimeOptions()
    {
        var options = new List<TimeOption>();
        for (int minutes = 0; minutes < 24 * 60; minutes += 15)
        {
            int hours = minutes / 60;
            int mins = minutes % 60;
            options.Add(new TimeOption(minutes, $"{hours:D2}:{mins:D2}"));
        }
        return options;
    }

    private List<(int Value, string Display)> BuildDayOfWeekOptions()
    {
        return new List<(int Value, string Display)>
        {
            (0, L["Sunday"]),
            (1, L["Monday"]),
            (2, L["Tuesday"]),
            (3, L["Wednesday"]),
            (4, L["Thursday"]),
            (5, L["Friday"]),
            (6, L["Saturday"])
        };
    }

    private async Task LoadScheduleAsync()
    {
        _isLoading = true;
        _statusMessage = null;
        _statusIsError = false;
        try
        {
            _schedule = await SyncScheduleRepository.GetByProviderAccountIdAsync(Id, CancellationToken.None);
            if (_schedule != null)
            {
                _snapshotRssiIntervalMinutes = _schedule.SnapshotRssiIntervalMinutes;
                _eventPollIntervalMinutes = _schedule.EventPollIntervalMinutes;
                _isEnabled = _schedule.IsEnabled;
                _useAdvancedJammingSchedule = _schedule.UseAdvancedJammingSchedule;
                // Create a mutable copy of jamming windows for editing
                _jammingWindows = new List<JammingScheduleWindow>(_schedule.JammingWindows ?? []);
            }
            else
            {
                _jammingWindows = [];
            }
        }
        catch (Exception ex)
        {
            _statusMessage = L["FailedToLoadSchedule", ex.Message];
            _statusIsError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void AddWindow()
    {
        if (_jammingWindows == null)
        {
            _jammingWindows = [];
        }

        // Default: Monday, 00:00-00:15, matching default interval
        var newWindow = new JammingScheduleWindow
        {
            Id = Guid.NewGuid(),
            SyncScheduleId = _schedule?.Id ?? Guid.Empty,
            DayOfWeek = 1, // Monday
            StartMinuteOfDay = 0, // 00:00
            EndMinuteOfDay = 15, // 00:15
            SnapshotRssiIntervalMinutes = _snapshotRssiIntervalMinutes
        };

        _jammingWindows.Add(newWindow);
    }

    private void RemoveWindow(JammingScheduleWindow window)
    {
        _jammingWindows?.Remove(window);
    }

    private bool ValidateJammingWindows()
    {
        if (!_useAdvancedJammingSchedule)
        {
            return true; // No validation needed when advanced mode is off
        }

        if (_jammingWindows == null || _jammingWindows.Count == 0)
        {
            _statusMessage = L["AdvancedScheduleNoWindows"];
            _statusIsError = true;
            return false;
        }

        foreach (var window in _jammingWindows)
        {
            // Validate day of week
            if (window.DayOfWeek < 0 || window.DayOfWeek > 6)
            {
                _statusMessage = L["InvalidDayOfWeek", window.DayOfWeek];
                _statusIsError = true;
                return false;
            }

            // Validate start and end times are multiples of 15
            if (window.StartMinuteOfDay % 15 != 0)
            {
                _statusMessage = L["StartTimeMultiple", FormatMinutes(window.StartMinuteOfDay)];
                _statusIsError = true;
                return false;
            }

            if (window.EndMinuteOfDay % 15 != 0)
            {
                _statusMessage = L["EndTimeMultiple", FormatMinutes(window.EndMinuteOfDay)];
                _statusIsError = true;
                return false;
            }

            // Validate end time is after start time
            if (window.EndMinuteOfDay <= window.StartMinuteOfDay)
            {
                _statusMessage = L["EndAfterStart", GetDayName(window.DayOfWeek)];
                _statusIsError = true;
                return false;
            }

            // Validate interval meets minimum
            if (window.SnapshotRssiIntervalMinutes < SyncSchedule.MinimumPollIntervalMinutes)
            {
                _statusMessage = L["IntervalMinimum", SyncSchedule.MinimumPollIntervalMinutes];
                _statusIsError = true;
                return false;
            }
        }

        return true;
    }

    private string FormatMinutes(int minutes)
    {
        int hours = minutes / 60;
        int mins = minutes % 60;
        return $"{hours:D2}:{mins:D2}";
    }

    private string GetDayName(int dayOfWeek) => dayOfWeek switch
    {
        0 => L["Sunday"],
        1 => L["Monday"],
        2 => L["Tuesday"],
        3 => L["Wednesday"],
        4 => L["Thursday"],
        5 => L["Friday"],
        6 => L["Saturday"],
        _ => L["Unknown"]
    };

    private async Task SaveScheduleAsync()
    {
        // Validate jamming windows before attempting save
        if (!ValidateJammingWindows())
        {
            return;
        }

        _isBusy = true;
        try
        {
            if (_schedule == null)
            {
                _schedule = new SyncSchedule
                {
                    Id = Guid.NewGuid(),
                    ProviderAccountId = Id,
                    SnapshotRssiIntervalMinutes = _snapshotRssiIntervalMinutes,
                    EventPollIntervalMinutes = _eventPollIntervalMinutes,
                    IsEnabled = _isEnabled,
                    UseAdvancedJammingSchedule = _useAdvancedJammingSchedule,
                    EventNextRunUtc = null,
                    EventLastRunUtc = null,
                    SnapshotNextRunUtc = null,
                    SnapshotLastRunUtc = null,
                    JammingWindows = _useAdvancedJammingSchedule ? (_jammingWindows ?? []) : []
                };
            }
            else
            {
                _schedule.SnapshotRssiIntervalMinutes = _snapshotRssiIntervalMinutes;
                _schedule.EventPollIntervalMinutes = _eventPollIntervalMinutes;
                _schedule.IsEnabled = _isEnabled;
                _schedule.UseAdvancedJammingSchedule = _useAdvancedJammingSchedule;
                // Ensure SyncScheduleId is set on windows for persistence
                if (_useAdvancedJammingSchedule && _jammingWindows != null)
                {
                    foreach (var window in _jammingWindows)
                    {
                        window.SyncScheduleId = _schedule.Id;
                    }
                    _schedule.JammingWindows = _jammingWindows;
                }
                else
                {
                    _schedule.JammingWindows = [];
                }
            }

            await SyncScheduleRepository.UpsertAsync(_schedule, CancellationToken.None);
            _statusMessage = L["ScheduleSaved"];
            _statusIsError = false;

            // Navigate back after a brief delay to show the success message
            await Task.Delay(1500);
            NavigationManager.NavigateTo($"/accounts/{Id}");
        }
        catch (Exception ex)
        {
            _statusMessage = L["FailedToSaveSchedule", ex.Message];
            _statusIsError = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

}
