@using VideoForensics.Data.Common.Entities
@using VideoForensics.Data.Common.Contracts
@inject ISyncScheduleRepository SyncScheduleRepository
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@inject PairedSessionState SessionState
@inject IProviderAccountEditAccess EditAccess
@using VideoForensics.Client.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AccountSyncSchedule> L


<h5 class="mb-3">@L["SyncScheduleTitle"]</h5>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <div class="alert @(_statusIsError ? "alert-danger" : "alert-success")">
            @_statusMessage
        </div>
    }

    <div>
        <div>

            <div id="config-sync-interval" class="mb-4">
                <label for="config-sync-interval-hours" class="form-label fw-bold">@L["ConfigSyncIntervalLabel"]</label>
                <div>
                    <input id="config-sync-interval-hours" type="number" class="form-control" style="width: 8rem;"
                           min="1" max="720" value="@_configSyncHours" disabled="@(!_canEditAccount)" @onchange="OnConfigSyncIntervalChangedAsync" />
                </div>
                @if (_configSyncIntervalError)
                {
                    <p class="text-danger mb-0 mt-1">@L["ConfigSyncIntervalInvalid"]</p>
                }
            </div>

            <EditForm Model="this" OnValidSubmit="SaveScheduleAsync">
                <div class="mb-3">
                    <label for="snapshot-rssi-interval">@L["SnapshotRssiIntervalLabel"]</label>
                    <IntervalSecondsInput Id="snapshot-rssi-interval" Value="_snapshotRssiIntervalSeconds" ValueChanged="v => _snapshotRssiIntervalSeconds = v" />
                </div>
                <div class="mb-3">
                    <label for="event-poll-interval">@L["EventPollIntervalLabel"]</label>
                    <SfNumericTextBox ID="event-poll-interval" @bind-Value="_eventPollIntervalMinutes" Min="1" Step="1" />
                </div>
                <div class="mb-3">
                    <label for="snapshot-rollup-interval">@L["SnapshotRollupIntervalLabel"]</label>
                    <SfNumericTextBox ID="snapshot-rollup-interval" @bind-Value="_snapshotRollupIntervalMinutes" Min="1" Step="1" />
                </div>

                <div class="mb-3">
                    <label for="is-enabled">
                        <SfCheckBox ID="is-enabled" @bind-Checked="_isEnabled" TChecked="bool" />
                        @L["EnableSync"]
                    </label>
                </div>

                @if (_schedule != null)
                {
                    <div class="mb-3">
                        <label>@L["LastEventPoll"]</label>
                        <p><LocalTimeText Value="@_schedule.EventLastRunUtc" Format="g" Fallback="@L["Never"]" /></p>
                    </div>

                    <div class="mb-3">
                        <label>@L["NextEventPoll"]</label>
                        <p><LocalTimeText Value="@_schedule.EventNextRunUtc" Format="g" Fallback="@L["NotAvailable"]" /></p>
                    </div>

                    <div class="mb-3">
                        <label>@L["LastSnapshotPoll"]</label>
                        <p><LocalTimeText Value="@_schedule.SnapshotLastRunUtc" Format="g" Fallback="@L["Never"]" /></p>
                    </div>

                    <div class="mb-3">
                        <label>@L["NextSnapshotPoll"]</label>
                        <p><LocalTimeText Value="@_schedule.SnapshotNextRunUtc" Format="g" Fallback="@L["NotAvailable"]" /></p>
                    </div>
                }

                <hr class="my-4" />

                <div class="mb-3">
                    <label for="use-advanced-jamming">
                        <SfCheckBox ID="use-advanced-jamming" @bind-Checked="_useAdvancedJammingSchedule" TChecked="bool" />
                        @L["AdvancedJammingSchedule"]
                    </label>
                </div>

                <div class="mb-4">
                    <h6 class="mb-2">@L["DeviceCaptureModesHeading"]</h6>
                    <div>
                        <p class="text-muted small">@L["DeviceCaptureModesHelp"]</p>
                        @if (_deviceModes.Count == 0)
                        {
                            <p class="text-muted mb-0">@L["NoDevicesForSchedule"]</p>
                        }
                        else
                        {
                            @foreach (DeviceModeRow row in _deviceModes)
                            {
                                string label = DeviceLabel.For(row.Name, row.ProviderDeviceId);
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <span class="flex-grow-1">@label</span>
                                    <select class="form-select form-select-sm" style="max-width: 220px;" aria-label="@label" value="@row.Mode" disabled="@_isBusy"
                                            @onchange="e => SetDeviceModeAsync(row, e.Value?.ToString())">
                                        <option value="Capture">@L["DeviceModeCapture"]</option>
                                        <option value="HealthOnly">@L["DeviceModeHealthOnly"]</option>
                                        <option value="Off">@L["DeviceModeOff"]</option>
                                    </select>
                                </div>
                            }
                        }
                    </div>
                </div>

                @if (_useAdvancedJammingSchedule)
                {
                    <div class="mb-4">
                        <h6 class="mb-2">@L["JammingDetectionWindows"]</h6>
                        <div>
                            @if (_jammingWindows == null || _jammingWindows.Count == 0)
                            {
                                <p class="text-muted">@L["NoJammingWindows"]</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover">
                                        <thead class="table-light">
                                            <tr>
                                                <th>@L["ColDayOfWeek"]</th>
                                                <th>@L["ColStartTime"]</th>
                                                <th>@L["ColEndTime"]</th>
                                                <th>@L["ColIntervalMin"]</th>
                                                <th></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var window in _jammingWindows)
                                            {
                                                <tr>
                                                    <td>
                                                        <SfDropDownList TValue="int" TItem="(int Value, string Display)" DataSource="@_dayOfWeekOptions" @bind-Value="window.DayOfWeek">
                                                            <DropDownListFieldSettings Text="Display" Value="Value"></DropDownListFieldSettings>
                                                        </SfDropDownList>
                                                    </td>
                                                    <td>
                                                        <SfDropDownList TValue="int" TItem="TimeOption" DataSource="@_timeOptions" @bind-Value="window.StartMinuteOfDay">
                                                            <DropDownListFieldSettings Text="@nameof(TimeOption.Display)" Value="@nameof(TimeOption.Minutes)"></DropDownListFieldSettings>
                                                        </SfDropDownList>
                                                    </td>
                                                    <td>
                                                        <SfDropDownList TValue="int" TItem="TimeOption" DataSource="@_timeOptions" @bind-Value="window.EndMinuteOfDay">
                                                            <DropDownListFieldSettings Text="@nameof(TimeOption.Display)" Value="@nameof(TimeOption.Minutes)"></DropDownListFieldSettings>
                                                        </SfDropDownList>
                                                    </td>
                                                    <td>
                                                        <IntervalSecondsInput Value="window.SnapshotRssiIntervalSeconds" ValueChanged="v => window.SnapshotRssiIntervalSeconds = v" />
                                                    </td>
                                                    <td>
                                                        <SfButton type="button" IconCss="e-icons e-delete" CssClass="e-outline e-small" OnClick="@(() => RemoveWindow(window))" TrueName="@L["Remove"]" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            <div class="mt-3">
                                <SfButton type="button" OnClick="AddWindow" CssClass="e-outline" Content="@L["AddWindow"]" />
                            </div>
                        </div>
                    </div>
                }

                <div class="mt-4">
                    <SfButton type="submit" CssClass="e-primary" Disabled="@_isBusy" Content="@(_isBusy ? L["Saving"] : L["Save"])" />
                </div>
            </EditForm>
        </div>
    </div>

    <SfToast @ref="_toastRef" />
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private SyncSchedule? _schedule;
    private int _snapshotRssiIntervalSeconds = SyncSchedule.DefaultSnapshotIntervalSeconds;
    private int _eventPollIntervalMinutes = 60;
    private int _snapshotRollupIntervalMinutes = SyncSchedule.DefaultSnapshotRollupIntervalMinutes;
    private bool _isEnabled = true;
    private bool _useAdvancedJammingSchedule;
    private List<JammingScheduleWindow>? _jammingWindows;
    private bool _isLoading = true;
    private bool _isBusy;
    private bool _canEditAccount;
    private string? _statusMessage;
    private bool _statusIsError;

    private record TimeOption(int Minutes, string Display);
    private List<TimeOption> _timeOptions = [];
    private List<(int Value, string Display)> _dayOfWeekOptions = [];

    protected override async Task OnInitializedAsync()
    {
        _timeOptions = BuildTimeOptions();
        _dayOfWeekOptions = BuildDayOfWeekOptions();
        _canEditAccount = await EditAccess.CanEditAsync(CancellationToken.None);
        await LoadScheduleAsync();
        await LoadConfigSyncIntervalAsync();
    }

    private const int DefaultConfigSyncHours = 24;
    private const int MinConfigSyncHours = 1;
    private const int MaxConfigSyncHours = 720;
    private int _configSyncHours = DefaultConfigSyncHours;
    private bool _configSyncIntervalError;
    private SfToast _toastRef = null!;

    private async Task LoadConfigSyncIntervalAsync()
    {
        try
        {
            var interval = await GetApiAsync<VideoForensics.Core.Api.Contracts.ConfigSyncIntervalDto>(
                $"api/v1/accounts/provider-accounts/{Id}/config-sync-interval");
            _configSyncHours = interval?.Hours ?? DefaultConfigSyncHours;
        }
        catch
        {
            // The interval is a setting, not a list; when it can't be read the default stays on screen.
            _configSyncHours = DefaultConfigSyncHours;
        }
        _configSyncIntervalError = false;
        StateHasChanged();
    }

    private async Task OnConfigSyncIntervalChangedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out int hours)
            || hours < MinConfigSyncHours || hours > MaxConfigSyncHours)
        {
            _configSyncIntervalError = true;
            return;
        }

        _configSyncIntervalError = false;
        if (hours == _configSyncHours)
        {
            return;
        }

        try
        {
            using HttpResponseMessage response = await SendApiAsync(
                HttpMethod.Put, $"api/v1/accounts/provider-accounts/{Id}/config-sync-interval", new VideoForensics.Core.Api.Contracts.ConfigSyncIntervalDto(hours));
            if (response.IsSuccessStatusCode)
            {
                _configSyncHours = hours;
                await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
                {
                    Title = L["ConfigSyncIntervalSaved"],
                    Icon = "e-success"
                });
            }
            else
            {
                await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
                {
                    Title = L["ConfigSyncIntervalSaveFailed"],
                    Icon = "e-danger"
                });
            }
        }
        catch (Exception ex)
        {
            await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
            {
                Title = L["ErrorTitle"],
                Content = ex.Message,
                Icon = "e-danger"
            });
        }
    }

    /// <summary>
    /// GET against the account API with the paired-device bearer token.
    /// </summary>
    /// <summary>One device on the schedule page: its capture choice, saved as "Capture", "HealthOnly", or "Off".</summary>
    private sealed record DeviceModeRow(Guid DeviceId, string Name, string ProviderDeviceId, string Mode);

    private List<DeviceModeRow> _deviceModes = new();

    private async Task LoadDeviceModesAsync()
    {
        try
        {
            _deviceModes = await GetApiAsync<List<DeviceModeRow>>($"api/v1/device-capture-modes?providerAccountId={Id}") ?? new List<DeviceModeRow>();
        }
        catch (Exception ex)
        {
            _statusMessage = L["FailedToLoadDeviceModes", ex.Message];
            _statusIsError = true;
        }
    }

    private async Task SetDeviceModeAsync(DeviceModeRow row, string? mode)
    {
        if (string.IsNullOrEmpty(mode) || mode == row.Mode)
        {
            return;
        }

        try
        {
            using HttpResponseMessage response = await SendApiAsync(HttpMethod.Put, $"api/v1/device-capture-modes/{row.DeviceId}", new { mode });
            response.EnsureSuccessStatusCode();
            int index = _deviceModes.IndexOf(row);
            if (index >= 0)
            {
                _deviceModes[index] = row with { Mode = mode };
            }

            _statusMessage = L["DeviceModeSaved", DeviceLabel.For(row.Name, row.ProviderDeviceId)];
            _statusIsError = false;
        }
        catch (Exception ex)
        {
            _statusMessage = L["FailedToSaveDeviceMode", ex.Message];
            _statusIsError = true;
        }
    }

    private async Task<T?> GetApiAsync<T>(string relativePath)
    {
        using HttpResponseMessage response = await SendApiAsync(HttpMethod.Get, relativePath);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<T>(CancellationToken.None);
    }

    /// <summary>
    /// Sends a request to the account API with the paired-device bearer token and an optional JSON body.
    /// The injected HttpClient has no base address or auth header in production, so the absolute URI and
    /// header are set per request. The caller disposes the response.
    /// </summary>
    private async Task<HttpResponseMessage> SendApiAsync(HttpMethod method, string relativePath, object? body = null)
    {
        await SessionState.EnsureLoadedAsync();
        using var request = new HttpRequestMessage(method, new Uri(new Uri(NavigationManager.BaseUri), relativePath));
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        if (body is not null)
        {
            request.Content = JsonContent.Create(body, options: System.Text.Json.JsonSerializerOptions.Web);
        }
        return await HttpClient.SendAsync(request, CancellationToken.None);
    }

    private List<TimeOption> BuildTimeOptions()
    {
        var options = new List<TimeOption>();
        for (int minutes = 0; minutes < 24 * 60; minutes += 15)
        {
            int hours = minutes / 60;
            int mins = minutes % 60;
            options.Add(new TimeOption(minutes, $"{hours:D2}:{mins:D2}"));
        }
        return options;
    }

    private List<(int Value, string Display)> BuildDayOfWeekOptions()
    {
        return new List<(int Value, string Display)>
        {
            (0, L["Sunday"]),
            (1, L["Monday"]),
            (2, L["Tuesday"]),
            (3, L["Wednesday"]),
            (4, L["Thursday"]),
            (5, L["Friday"]),
            (6, L["Saturday"])
        };
    }

    private async Task LoadScheduleAsync()
    {
        _isLoading = true;
        _statusMessage = null;
        _statusIsError = false;
        try
        {
            _schedule = await SyncScheduleRepository.GetByProviderAccountIdAsync(Id, CancellationToken.None);
            if (_schedule != null)
            {
                _snapshotRssiIntervalSeconds = _schedule.SnapshotRssiIntervalSeconds;
                _eventPollIntervalMinutes = _schedule.EventPollIntervalMinutes;
                _snapshotRollupIntervalMinutes = _schedule.SnapshotRollupIntervalMinutes;
                _isEnabled = _schedule.IsEnabled;
                _useAdvancedJammingSchedule = _schedule.UseAdvancedJammingSchedule;
                // Create a mutable copy of jamming windows for editing
                _jammingWindows = new List<JammingScheduleWindow>(_schedule.JammingWindows ?? []);
            }
            else
            {
                _jammingWindows = [];
            }
        }
        catch (Exception ex)
        {
            _statusMessage = L["FailedToLoadSchedule", ex.Message];
            _statusIsError = true;
        }
        finally
        {
            await LoadDeviceModesAsync();
            _isLoading = false;
        }
    }

    private void AddWindow()
    {
        if (_jammingWindows == null)
        {
            _jammingWindows = [];
        }

        // Default: Monday, 00:00-00:15, matching default interval
        var newWindow = new JammingScheduleWindow
        {
            Id = Guid.NewGuid(),
            SyncScheduleId = _schedule?.Id ?? Guid.Empty,
            DayOfWeek = 1, // Monday
            StartMinuteOfDay = 0, // 00:00
            EndMinuteOfDay = 15, // 00:15
            SnapshotRssiIntervalSeconds = _snapshotRssiIntervalSeconds
        };

        _jammingWindows.Add(newWindow);
    }

    private void RemoveWindow(JammingScheduleWindow window)
    {
        _jammingWindows?.Remove(window);
    }

    private bool ValidateJammingWindows()
    {
        if (!_useAdvancedJammingSchedule)
        {
            return true; // No validation needed when advanced mode is off
        }

        if (_jammingWindows == null || _jammingWindows.Count == 0)
        {
            _statusMessage = L["AdvancedScheduleNoWindows"];
            _statusIsError = true;
            return false;
        }

        foreach (var window in _jammingWindows)
        {
            // Validate day of week
            if (window.DayOfWeek < 0 || window.DayOfWeek > 6)
            {
                _statusMessage = L["InvalidDayOfWeek", window.DayOfWeek];
                _statusIsError = true;
                return false;
            }

            // Validate start and end times are multiples of 15
            if (window.StartMinuteOfDay % 15 != 0)
            {
                _statusMessage = L["StartTimeMultiple", FormatMinutes(window.StartMinuteOfDay)];
                _statusIsError = true;
                return false;
            }

            if (window.EndMinuteOfDay % 15 != 0)
            {
                _statusMessage = L["EndTimeMultiple", FormatMinutes(window.EndMinuteOfDay)];
                _statusIsError = true;
                return false;
            }

            // Validate end time is after start time
            if (window.EndMinuteOfDay <= window.StartMinuteOfDay)
            {
                _statusMessage = L["EndAfterStart", GetDayName(window.DayOfWeek)];
                _statusIsError = true;
                return false;
            }

            // Validate interval meets minimum
            if (window.SnapshotRssiIntervalSeconds < SyncSchedule.MinimumSnapshotIntervalSeconds)
            {
                _statusMessage = L["IntervalMinimum", SyncSchedule.MinimumSnapshotIntervalSeconds];
                _statusIsError = true;
                return false;
            }
        }

        return true;
    }

    private string FormatMinutes(int minutes)
    {
        int hours = minutes / 60;
        int mins = minutes % 60;
        return $"{hours:D2}:{mins:D2}";
    }

    private string GetDayName(int dayOfWeek) => dayOfWeek switch
    {
        0 => L["Sunday"],
        1 => L["Monday"],
        2 => L["Tuesday"],
        3 => L["Wednesday"],
        4 => L["Thursday"],
        5 => L["Friday"],
        6 => L["Saturday"],
        _ => L["Unknown"]
    };

    private async Task SaveScheduleAsync()
    {
        // Validate jamming windows before attempting save
        if (!ValidateJammingWindows())
        {
            return;
        }

        _isBusy = true;
        try
        {
            if (_schedule == null)
            {
                _schedule = new SyncSchedule
                {
                    Id = Guid.NewGuid(),
                    ProviderAccountId = Id,
                    SnapshotRssiIntervalSeconds = _snapshotRssiIntervalSeconds,
                    EventPollIntervalMinutes = _eventPollIntervalMinutes,
                    SnapshotRollupIntervalMinutes = _snapshotRollupIntervalMinutes,
                    IsEnabled = _isEnabled,
                    UseAdvancedJammingSchedule = _useAdvancedJammingSchedule,
                    EventNextRunUtc = null,
                    EventLastRunUtc = null,
                    SnapshotNextRunUtc = null,
                    SnapshotLastRunUtc = null,
                    JammingWindows = _useAdvancedJammingSchedule ? (_jammingWindows ?? []) : []
                };
            }
            else
            {
                _schedule.SnapshotRssiIntervalSeconds = _snapshotRssiIntervalSeconds;
                _schedule.EventPollIntervalMinutes = _eventPollIntervalMinutes;
                _schedule.SnapshotRollupIntervalMinutes = _snapshotRollupIntervalMinutes;
                _schedule.IsEnabled = _isEnabled;
                _schedule.UseAdvancedJammingSchedule = _useAdvancedJammingSchedule;
                // Ensure SyncScheduleId is set on windows for persistence
                if (_useAdvancedJammingSchedule && _jammingWindows != null)
                {
                    foreach (var window in _jammingWindows)
                    {
                        window.SyncScheduleId = _schedule.Id;
                    }
                    _schedule.JammingWindows = _jammingWindows;
                }
                else
                {
                    _schedule.JammingWindows = [];
                }
            }

            await SyncScheduleRepository.UpsertAsync(_schedule, CancellationToken.None);
            _statusMessage = L["ScheduleSaved"];
            _statusIsError = false;

        }
        catch (Exception ex)
        {
            _statusMessage = L["FailedToSaveSchedule", ex.Message];
            _statusIsError = true;
        }
        finally
        {
            _isBusy = false;
        }
    }

}
