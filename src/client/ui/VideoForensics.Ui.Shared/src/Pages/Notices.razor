@page "/notices"
@using Microsoft.AspNetCore.Components
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Core.Providers.Common.Contracts
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Services.Scope
@inject DeviceOwnershipService OwnershipService
@inject INoticeRepository NoticeRepository
@inject IStringLocalizer<Notices> L
@inject INoticeDismissalRepository NoticeDismissalRepository
@inject PairedSessionState SessionState

<Breadcrumb Items="@_breadcrumbItems" />

<h4 class="mb-4">@L["NoticesTitle"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    <PageRightPanelContent>
        <div class="right-panel-section">
            <small style="font-weight: bold;">@L["FilterProvider"]</small>
            <SfDropDownList TValue="string" TItem="KeyValuePair<string, string>" Value="@_providerFilterValue" DataSource="@ProviderFilterOptions"
                Placeholder="@L["AllProviders"]" data-testid="notices-provider-filter" ValueChange="@OnProviderFilterChanged">
                <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
            </SfDropDownList>
            <small style="font-weight: bold;">@L["FilterAccount"]</small>
            <SfDropDownList TValue="string" TItem="KeyValuePair<string, string>" Value="@_accountFilterValue" DataSource="@AccountFilterOptions"
                Placeholder="@L["AllAccounts"]" data-testid="notices-account-filter" ValueChange="@OnAccountFilterChanged">
                <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
            </SfDropDownList>
        </div>
    </PageRightPanelContent>

    <div style="margin-bottom: 16px; display: flex; align-items: center; gap: 12px;">
        <SfCheckBox TChecked="bool" @bind-Checked="_showDismissed" @bind-Checked:after="LoadNoticesAsync" Label="@L["ShowDismissed"]" />
        <SfButton Content="@L["MarkAllAsRead"]" OnClick="@DismissAllAsync" Disabled="@(_notices.Count == 0)" CssClass="e-info" />
    </div>

    @if (_notices.Count == 0)
    {
        <p>@(_showDismissed ? L["NoNoticesFound"] : L["NoUndismissedNotices"])</p>
    }
    else
    {
        <SfGrid TValue="Notice" DataSource="@_notices" AllowSorting="true" AllowPaging="true" AllowFiltering="true" AllowResizing="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
            <GridPageSettings PageSize="20"></GridPageSettings>
            <GridColumns>
                <GridColumn HeaderText="@L["ColumnSeverity"]" Width="100px" AllowSorting="true">
                    <Template>
                        @{
                            var notice = (Notice)context;
                            <span class="@GetSeverityBadgeClass(notice.Severity)" style="padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold;">
                                @GetSeverityLabel(notice.Severity)
                            </span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="EventType" HeaderText="@L["ColumnEventType"]" AllowSorting="true" MinWidth="100" />
                <GridColumn HeaderText="@L["ColumnDetails"]" AllowSorting="false" MinWidth="100">
                    <Template>
                        @{
                            var notice = (Notice)context;
                            <span title="@notice.Details">
                                @(notice.Details?.Length > 100 ? notice.Details.Substring(0, 100) + "..." : notice.Details ?? "")
                            </span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="TimestampUtc" HeaderText="@L["ColumnTimestamp"]" AllowSorting="true" Format="yyyy-MM-dd HH:mm:ss" MinWidth="100" />
                <GridColumn HeaderText="" Width="120px" AllowSorting="false" AllowFiltering="false">
                    <Template>
                        @{
                            var notice = (Notice)context;
                            <SfButton Content="@L["Dismiss"]" OnClick="@(() => DismissNoticeAsync(notice.Id))" CssClass="e-outline e-small" />
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }
}

@code {
    private List<(string Label, string? Url)> _breadcrumbItems = new();
    private List<Notice> _notices = new();
    private List<Notice> _allNotices = new();
    private bool _showDismissed = false;
    private bool _isLoading = true;

    // Provider/Account filters. A notice without a provider account is global, so it is hidden while either filter is set.
    private DeviceOwnershipSnapshot? _ownership;
    private string _providerFilterValue = string.Empty;
    private string _accountFilterValue = string.Empty;

    private IEnumerable<KeyValuePair<string, string>> ProviderFilterOptions =>
        (_ownership?.ProviderNames ?? Array.Empty<string>()).Select(p => new KeyValuePair<string, string>(p, p));

    private IEnumerable<KeyValuePair<string, string>> AccountFilterOptions =>
        ScopeDeviceFilter.AccountsForProvider(_ownership?.Accounts ?? Array.Empty<ProviderAccount>(), ProviderFilterOrNull)
            .Select(a => new KeyValuePair<string, string>(a.Id.ToString(), _ownership!.AccountNames.GetValueOrDefault(a.Id, a.ProviderName)));

    private string? ProviderFilterOrNull => string.IsNullOrEmpty(_providerFilterValue) ? null : _providerFilterValue;

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbItems = new() { (L["BreadcrumbHome"].Value, "/"), (L["NoticesTitle"].Value, null) };
        _ownership = await OwnershipService.LoadAsync(Array.Empty<VideoForensics.Data.Common.Entities.Device>(), CancellationToken.None);
        await LoadNoticesAsync();
    }

    private void OnProviderFilterChanged(ChangeEventArgs<string, KeyValuePair<string, string>> args)
    {
        _providerFilterValue = args.Value ?? string.Empty;

        // An account from another provider can't stay selected.
        if (AccountFilterOptions.All(o => o.Key != _accountFilterValue))
        {
            _accountFilterValue = string.Empty;
        }

        ApplyFilters();
    }

    private void OnAccountFilterChanged(ChangeEventArgs<string, KeyValuePair<string, string>> args)
    {
        _accountFilterValue = args.Value ?? string.Empty;
        ApplyFilters();
    }

    private void ApplyFilters()
    {
        var accountId = Guid.TryParse(_accountFilterValue, out var parsed) ? parsed : (Guid?)null;
        _notices = _allNotices.Where(n => Matches(n, accountId)).ToList();
    }

    private bool Matches(Notice notice, Guid? accountId)
    {
        if (ProviderFilterOrNull is null && accountId is null)
        {
            return true;
        }

        if (notice.ProviderAccountId is not { } noticeAccountId)
        {
            return false;
        }

        if (accountId is { } selectedAccount && noticeAccountId != selectedAccount)
        {
            return false;
        }

        if (ProviderFilterOrNull is { } provider)
        {
            var account = _ownership?.Accounts.FirstOrDefault(a => a.Id == noticeAccountId);
            return account is not null && string.Equals(account.ProviderName, provider, StringComparison.OrdinalIgnoreCase);
        }

        return true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityAuditLog.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadNoticesAsync();
            StateHasChanged();
        }
    }

    private async Task LoadNoticesAsync()
    {
        if (!SessionState.OperatorId.HasValue)
        {
            _isLoading = false;
            return;
        }

        _isLoading = true;
        bool isAdmin = SessionState.Role is not null && Enum.TryParse<OperatorRole>(SessionState.Role, out OperatorRole role) && role >= OperatorRole.Admin;
        _allNotices = (await NoticeRepository.ListForOperatorAsync(SessionState.OperatorId.Value, isAdmin, _showDismissed, CancellationToken.None))
            .OrderByDescending(n => n.TimestampUtc)
            .ToList();
        ApplyFilters();
        _isLoading = false;
    }

    private async Task DismissNoticeAsync(Guid noticeId)
    {
        if (!SessionState.OperatorId.HasValue)
        {
            return;
        }

        await NoticeDismissalRepository.DismissAsync(noticeId, SessionState.OperatorId.Value, CancellationToken.None);
        await LoadNoticesAsync();
    }

    private async Task DismissAllAsync()
    {
        if (!SessionState.OperatorId.HasValue || _notices.Count == 0)
        {
            return;
        }

        await NoticeDismissalRepository.DismissAllAsync(_notices.Select(n => n.Id), SessionState.OperatorId.Value, CancellationToken.None);
        await LoadNoticesAsync();
    }

    private async Task ToggleShowDismissedAsync(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _showDismissed = (bool)(e.Value ?? false);
        await LoadNoticesAsync();
    }

    private string GetSeverityBadgeClass(NoticeSeverity severity)
    {
        return severity switch
        {
            NoticeSeverity.Info => "severity-badge-info",
            NoticeSeverity.Warning => "severity-badge-warning",
            NoticeSeverity.Alert => "severity-badge-alert",
            NoticeSeverity.Critical => "severity-badge-critical",
            _ => "severity-badge-info"
        };
    }

    private string GetSeverityLabel(NoticeSeverity severity)
    {
        return severity switch
        {
            NoticeSeverity.Info => L["SeverityInfo"],
            NoticeSeverity.Warning => L["SeverityWarning"],
            NoticeSeverity.Alert => L["SeverityAlert"],
            NoticeSeverity.Critical => L["SeverityCritical"],
            _ => L["SeverityInfo"]
        };
    }
}
