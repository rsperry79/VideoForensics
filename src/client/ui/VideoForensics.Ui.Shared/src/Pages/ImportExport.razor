@page "/tools/import-export"
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Dialogs
@using Microsoft.AspNetCore.Components.Forms
@inject IBackupExportService BackupExportService
@inject IBackupImportService BackupImportService
@inject IFileDialogService FileDialogService
@inject IStringLocalizer<ImportExport> L
@inject IJSRuntime JsRuntime

<h4 class="mb-4">@L["Title"]</h4>

<div class="card mb-4">
    <div class="card-body p-4">
        <h5 class="mb-2">@L["ExportSectionTitle"]</h5>

        @if (_prepareResult is not null)
        {
            <div class="mt-2">
                <span>@L["Validated"] @_prepareResult.Validated</span>
                <span>@L["Backfilled"] @_prepareResult.Backfilled</span>
                <span>@L["MissingMedia"] @_prepareResult.MissingMedia</span>
                <span>@L["UnrecoverableSidecars"] @_prepareResult.MissingSidecarUnrecoverable</span>
                @foreach (var detail in _prepareResult.Details)
                {
                    <span class="mt-1">@detail</span>
                }
            </div>
        }

        <div class="mt-4">
            <SfButton Content="@L["ExportBackup"]" OnClick="ExportAsync" Disabled="@_isExporting" CssClass="e-primary" />
        </div>

        @if (_exportResult is not null)
        {
            @if (_exportResult.Success)
            {
                <div class="mt-2">
                    <span class="mt-2">@L["ExportComplete"]</span>
                    <span>@L["AccountsCount"] @_exportResult.ProviderAccountCount</span>
                    <span>@L["LocationsCount"] @_exportResult.LocationCount</span>
                    <span>@L["DevicesCount"] @_exportResult.DeviceCount</span>
                    <span>@L["EventsCount"] @_exportResult.EventCount</span>
                    <span>@L["MediaItemsCount"] @_exportResult.MediaItemCount</span>
                </div>
            }
            else
            {
                <div class="alert alert-danger mt-2">@_exportResult.ErrorMessage</div>
            }
        }
    </div>
</div>

<div class="card mb-4">
    <div class="card-body p-4">
        <h5 class="mb-2">@L["ImportSectionTitle"]</h5>

        <div class="mt-2">
            <small class="mb-1 d-block">@L["SelectBackupFile"]</small>
            <InputFile @ref="_backupFileInput" OnChange="OnBackupFileSelected" style="display:none" />
            <SfButton Content="@L["ChooseBackupFile"]" OnClick="TriggerBackupFilePickerAsync" CssClass="e-flat" />
            <span class="mt-1 d-block">@(_selectedBackupFileName ?? L["NoFileSelected"])</span>
        </div>

        <div class="mt-4">
            <small class="mb-1 d-block">@L["SelectMediaRootFolder"]</small>
            <SfButton Content="@L["BrowseMediaRootFolder"]" OnClick="BrowseMediaRootFolderAsync" Disabled="@_isImporting" CssClass="e-flat" />
            <span class="mt-1 d-block">@(_mediaRootPath ?? L["NoFolderSelected"])</span>
        </div>

        <div class="mt-4">
            <SfButton Content="@L["Import"]" OnClick="ImportAsync" Disabled="@_isImporting" CssClass="e-primary" />
        </div>

        @if (_importResult is not null)
        {
            @if (_importResult.Success)
            {
                <div class="mt-2">
                    <span>@L["ProviderAccountsSummary", _importResult.ProviderAccounts.Inserted, _importResult.ProviderAccounts.SkippedExisting, _importResult.ProviderAccounts.SkippedOrphaned]</span>
                    <span>@L["LocationsSummary", _importResult.Locations.Inserted, _importResult.Locations.SkippedExisting, _importResult.Locations.SkippedOrphaned]</span>
                    <span>@L["DevicesSummary", _importResult.Devices.Inserted, _importResult.Devices.SkippedExisting, _importResult.Devices.SkippedOrphaned]</span>
                    <span>@L["EventsSummary", _importResult.Events.Inserted, _importResult.Events.SkippedExisting, _importResult.Events.SkippedOrphaned]</span>
                    <span>@L["DownloadEventsSummary", _importResult.DownloadEvents.Inserted, _importResult.DownloadEvents.SkippedExisting, _importResult.DownloadEvents.SkippedOrphaned]</span>
                    <span>@L["MediaItemsSummary", _importResult.MediaItems.Inserted, _importResult.MediaItems.SkippedExisting, _importResult.MediaItems.SkippedOrphaned, _importResult.MediaItems.IntegrityIssues]</span>
                    @foreach (var detail in _importResult.Details)
                    {
                        <span class="mt-1 d-block">@detail</span>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-danger mt-2">@_importResult.ErrorMessage</div>
            }
        }
    </div>
</div>

<SfDialog @bind-Visible="_folderBrowserDialogVisible" Header="@L["BrowseMediaRootFolder"]" Width="600px" IsModal="true">
    <FolderBrowserDialog OnClosed="OnFolderBrowserDialogClosed" />
</SfDialog>

@code {
    private bool _isExporting;
    private bool _isImporting;
    private bool _folderBrowserDialogVisible;

    private PrepareExportResult? _prepareResult;
    private BackupExportResult? _exportResult;
    private BackupImportResult? _importResult;

    private string _backupZipPath = "";
    private string? _mediaRootPath;
    private string? _selectedBackupFileName;
    private InputFile? _backupFileInput;

    private readonly string _stagingDirectory = Path.Combine(
        Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments),
        "VideoForensics",
        "Backups");

    private async Task ExportAsync()
    {
        _isExporting = true;
        _prepareResult = null;
        _exportResult = null;
        try
        {
            // Prepare first, showing validation counts
            _prepareResult = await BackupExportService.PrepareForExportAsync(CancellationToken.None);

            // Then export
            _exportResult = await BackupExportService.ExportBackupAsync(_stagingDirectory, CancellationToken.None);

            if (_exportResult.Success && _exportResult.ArchivePath is not null)
            {
                // Write SHA-256 sidecar file
                string? hashFilePath = null;
                if (!string.IsNullOrEmpty(_exportResult.ArchiveSha256Hash))
                {
                    hashFilePath = _exportResult.ArchivePath + ".sha256.txt";
                    await File.WriteAllTextAsync(hashFilePath, _exportResult.ArchiveSha256Hash, CancellationToken.None);
                }

                try
                {
                    await FileDialogService.SaveExportedArchiveAsync(
                        _exportResult.ArchivePath,
                        Path.GetFileName(_exportResult.ArchivePath),
                        CancellationToken.None);

                    // Also save the hash sidecar file
                    if (hashFilePath is not null)
                    {
                        await FileDialogService.SaveExportedArchiveAsync(
                            hashFilePath,
                            Path.GetFileName(hashFilePath),
                            CancellationToken.None);
                    }
                }
                catch (Exception ex)
                {
                    // Log save dialog failure but don't corrupt the export result display
                    Console.WriteLine($"Save dialog failed: {ex.Message}");
                }
            }
        }
        catch (Exception ex)
        {
            _exportResult = new BackupExportResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            _isExporting = false;
        }
    }

    private async Task TriggerBackupFilePickerAsync()
    {
        if (_backupFileInput is not null)
        {
            await JsRuntime.InvokeVoidAsync("vfClickElement", _backupFileInput.Element);
        }
    }

    private async Task OnBackupFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        var tempDir = Path.Combine(Path.GetTempPath(), "VideoForensicsImports");
        Directory.CreateDirectory(tempDir);
        var tempPath = Path.Combine(tempDir, $"{Guid.NewGuid()}.zip");

        await using var stream = file.OpenReadStream(maxAllowedSize: 500_000_000);
        await using var fileStream = File.Create(tempPath);
        await stream.CopyToAsync(fileStream);

        _backupZipPath = tempPath;
        _selectedBackupFileName = file.Name;
    }

    private Task BrowseMediaRootFolderAsync()
    {
        _folderBrowserDialogVisible = true;
        return Task.CompletedTask;
    }

    private Task OnFolderBrowserDialogClosed(string? path)
    {
        _folderBrowserDialogVisible = false;
        if (path is not null)
        {
            _mediaRootPath = path;
        }
        StateHasChanged();
        return Task.CompletedTask;
    }

    private async Task ImportAsync()
    {
        _isImporting = true;
        _importResult = null;
        try
        {
            _importResult = await BackupImportService.ImportBackupAsync(_backupZipPath, _mediaRootPath, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _importResult = new BackupImportResult { Success = false, ErrorMessage = ex.Message };
        }
        finally
        {
            _isImporting = false;
        }
    }
}
