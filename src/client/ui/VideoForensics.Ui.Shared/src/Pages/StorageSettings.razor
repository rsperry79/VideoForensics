@page "/settings/storage"
@inject NavigationManager NavigationManager
@using VideoForensics.Client.Common.Contracts
@using VideoForensics.Core.Helpers.Platform
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Dialogs
@inject IStorageSettingsService StorageService
@inject PairedSessionState SessionState
@inject IStringLocalizer<VideoForensics.Client.Ui.Shared.Pages.StorageSettings> L

<h4 class="mb-4">@L["Title"]</h4>

@if (!SessionState.IsSignedIn)
{
    <div class="alert alert-info mb-4">
        <a href="@NavigationManager.SignInPathWithReturnUrl()">Sign in</a> @L["SignInToManage"]
    </div>
}

<div class="d-flex flex-row gap-2 mb-2">
    <SfButton Content="@L["RefreshButton"]" OnClick="LoadAsync" Disabled="@_isLoading" CssClass="e-flat" />
</div>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_authError is not null)
{
    <div class="alert alert-danger mb-2">@_authError</div>
    <span>@L["NotAuthorizedMessage"]</span>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else if (_storageData is null || _storageData.Categories.Count == 0)
{
    <span>@L["NoStorageFound"]</span>
}
else
{
    <SfGrid TValue="StorageCategoryStatus" DataSource="@_storageData.Categories" AllowSorting="true" AllowPaging="false" AllowResizing="true">
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
        <GridEvents TValue="StorageCategoryStatus" RowSelected="OnRowSelected"></GridEvents>
        <GridColumns>
            <GridColumn Field="@nameof(StorageCategoryStatus.Category)" HeaderText="@L["ColCategory"]" MinWidth="100" />
            <GridColumn Field="@nameof(StorageCategoryStatus.CurrentPath)" HeaderText="@L["ColPath"]" MinWidth="400" />
            <GridColumn HeaderText="@L["ColUsedSpace"]" MinWidth="100">
                <Template>
                    @{
                        var status = (StorageCategoryStatus)context;
                        @FormatBytes(status.UsedBytes)
                    }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="@L["ColFreeSpace"]" MinWidth="100">
                <Template>
                    @{
                        var status = (StorageCategoryStatus)context;
                        @FormatBytes(status.FreeBytes)
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
}

@code {
    private bool _isLoading = true;
    private VideoForensics.Client.Common.Contracts.StorageSettings? _storageData;
    private string? _authError;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;

        try
        {
            _storageData = await StorageService.GetStatusAsync(CancellationToken.None);
        }
        catch (HttpRequestException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
        {
            _authError = L["NotAuthorizedToView"];
            _storageData = null;
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToLoad", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnRowSelected(RowSelectEventArgs<StorageCategoryStatus> args)
    {
        NavigationManager.NavigateTo($"/settings/storage/details?category={args.Data.Category}");
    }

    private static string FormatBytes(long bytes)
    {
        const double kb = 1024;
        const double mb = kb * 1024;
        const double gb = mb * 1024;
        const double tb = gb * 1024;

        return bytes >= tb ? $"{bytes / tb:F2} TB"
            : bytes >= gb ? $"{bytes / gb:F2} GB"
            : bytes >= mb ? $"{bytes / mb:F2} MB"
            : bytes >= kb ? $"{bytes / kb:F2} KB"
            : $"{bytes} bytes";
    }
}
