@page "/settings/storage"
@inject NavigationManager NavigationManager
@using VideoForensics.Client.Common.Contracts
@using VideoForensics.Core.Helpers.Platform
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Dialogs
@inject IStorageSettingsService StorageService
@inject PairedSessionState SessionState
@inject IStringLocalizer<VideoForensics.Client.Ui.Shared.Pages.StorageSettings> L

<h4 class="mb-4">@L["Title"]</h4>

@if (!SessionState.IsSignedIn)
{
    <div class="alert alert-info mb-4">
        <a href="@NavigationManager.SignInPathWithReturnUrl()">Sign in</a> @L["SignInToManage"]
    </div>
}

<div class="d-flex flex-row gap-2 mb-2">
    <SfButton Content="@L["RefreshButton"]" OnClick="LoadAsync" Disabled="@_isLoading" CssClass="e-flat" />
</div>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_authError is not null)
{
    <div class="alert alert-danger mb-2">@_authError</div>
    <span>@L["NotAuthorizedMessage"]</span>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else if (_storageData is null || _storageData.Categories.Count == 0)
{
    <span>@L["NoStorageFound"]</span>
}
else
{
    <section class="card mb-4" data-testid="default-storage-path-section">
        <div class="card-body">
            <h6 class="card-title">@L["DefaultPathHeading"]</h6>
            <p class="small text-muted mb-2">@L["DefaultPathHint"]</p>
            <code data-testid="default-storage-path">@_storageData.DefaultRoot</code>
            <div class="mt-3">
                <SfButton Content="@L["ChangeDefaultPathButton"]" OnClick="BeginChangeDefault" CssClass="e-primary" />
            </div>

            @if (_pendingDefaultRoot is not null)
            {
                <div class="mt-3 d-flex flex-column gap-2" data-testid="default-storage-path-pending">
                    <code>@_pendingDefaultRoot</code>
                    <span class="text-muted">@L["ConfirmDefaultPathMessage"]</span>
                    <div class="d-flex flex-row gap-2">
                        <SfButton Content="@L["ConfirmButton"]" OnClick="AskConfirmDefault" CssClass="e-primary" />
                        <SfButton Content="@L["CancelButton"]" OnClick="CancelDefault" CssClass="e-flat" />
                    </div>
                </div>
            }

            @if (_defaultActionMessage is not null)
            {
                <div class="mt-3 @(_defaultActionSuccess ? "text-success" : "text-danger")" role="status" data-testid="default-storage-path-message">@_defaultActionMessage</div>
            }
        </div>
    </section>

    <SfDialog @bind-Visible="_defaultFolderDialogVisible" Header="@L["BrowseFolderTitle"]" Width="600px" IsModal="true">
        <FolderPicker OnClosed="OnDefaultFolderSelected" />
    </SfDialog>

    <SfDialog @bind-Visible="_confirmDefaultVisible" Header="@L["ConfirmMoveTitle"]" Width="500px" IsModal="true">
        <div class="mb-3">@L["ConfirmDefaultPathMessage"]</div>
        <div class="d-flex flex-row gap-2 justify-content-end">
            <SfButton Content="@L["CancelButton"]" OnClick="CancelConfirmDefault" CssClass="e-flat" />
            <SfButton Content="@L["MoveFilesButton"]" OnClick="ConfirmDefaultAsync" CssClass="e-primary" />
        </div>
    </SfDialog>

    <div class="mb-2">
        <h6 class="mb-1" data-testid="storage-table-heading">@L["StorageTableHeading"]</h6>
        <p class="small text-muted mb-2">@L["StorageTableHint"]</p>
    </div>

    <SfGrid TValue="StorageCategoryStatus" DataSource="@StorageCategoryTotals.Ordered(_storageData.Categories)" AllowSorting="true" AllowPaging="false" AllowResizing="true">
        <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
        <GridEvents TValue="StorageCategoryStatus" RowSelected="OnRowSelected"></GridEvents>
        <GridColumns>
            <GridColumn Field="@nameof(StorageCategoryStatus.Category)" HeaderText="@L["ColCategory"]" MinWidth="100" />
            <GridColumn HeaderText="@L["ColPath"]" MinWidth="400">
                <Template>
                    @{
                        var status = (StorageCategoryStatus)context;
                        @StoragePathDisplay.Format(status, L["DefaultLocationPrefix"])
                    }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="@L["ColUsedSpace"]" MinWidth="100">
                <Template>
                    @{
                        var status = (StorageCategoryStatus)context;
                        @FormatBytes(status.UsedBytes)
                    }
                </Template>
            </GridColumn>
            <GridColumn HeaderText="@L["ColFreeSpace"]" MinWidth="100">
                <Template>
                    @{
                        var status = (StorageCategoryStatus)context;
                        @FormatBytes(status.FreeBytes)
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>

    <div class="d-flex justify-content-end mt-2 fw-semibold" data-testid="storage-total-used">
        @L["StorageTotalUsed"]: @FormatBytes(StorageCategoryTotals.TotalUsed(_storageData.Categories))
    </div>
}

@code {
    private bool _isLoading = true;
    private VideoForensics.Client.Common.Contracts.StorageSettings? _storageData;
    private string? _authError;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private bool _defaultFolderDialogVisible;
    private bool _confirmDefaultVisible;
    private string? _pendingDefaultRoot;
    private string? _defaultActionMessage;
    private bool _defaultActionSuccess;

    private void BeginChangeDefault()
    {
        _defaultActionMessage = null;
        _defaultFolderDialogVisible = true;
    }

    private Task OnDefaultFolderSelected(string? path)
    {
        _defaultFolderDialogVisible = false;
        if (path is not null)
        {
            _pendingDefaultRoot = path;
        }

        return Task.CompletedTask;
    }

    private void CancelDefault() => _pendingDefaultRoot = null;

    private void AskConfirmDefault() => _confirmDefaultVisible = true;

    private void CancelConfirmDefault() => _confirmDefaultVisible = false;

    private async Task ConfirmDefaultAsync()
    {
        _confirmDefaultVisible = false;
        if (string.IsNullOrWhiteSpace(_pendingDefaultRoot))
        {
            _defaultActionSuccess = false;
            _defaultActionMessage = L["PathRequired"];
            return;
        }

        try
        {
            RelocateStorageCategoryResult result = await StorageService.ChangeDefaultRootAsync(_pendingDefaultRoot, CancellationToken.None);
            _defaultActionSuccess = result.Succeeded;
            _defaultActionMessage = result.Succeeded ? L["ChangeDefaultPathDone"].Value : result.ErrorMessage ?? L["RelocateFailed"].Value;
            if (result.Succeeded)
            {
                _pendingDefaultRoot = null;
                await LoadAsync();
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
        {
            _defaultActionSuccess = false;
            _defaultActionMessage = L["NotAuthorizedToModify"].Value;
        }
        catch (Exception ex)
        {
            _defaultActionSuccess = false;
            _defaultActionMessage = L["FailedToLoad", ex.Message].Value;
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;

        try
        {
            _storageData = await StorageService.GetStatusAsync(CancellationToken.None);
        }
        catch (HttpRequestException ex) when (ex.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
        {
            _authError = L["NotAuthorizedToView"];
            _storageData = null;
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToLoad", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnRowSelected(RowSelectEventArgs<StorageCategoryStatus> args)
    {
        NavigationManager.NavigateTo($"/settings/storage/details?category={args.Data.Category}");
    }

    private static string FormatBytes(long bytes)
    {
        const double kb = 1024;
        const double mb = kb * 1024;
        const double gb = mb * 1024;
        const double tb = gb * 1024;

        return bytes >= tb ? $"{bytes / tb:F2} TB"
            : bytes >= gb ? $"{bytes / gb:F2} GB"
            : bytes >= mb ? $"{bytes / mb:F2} MB"
            : bytes >= kb ? $"{bytes / kb:F2} KB"
            : $"{bytes} bytes";
    }
}
