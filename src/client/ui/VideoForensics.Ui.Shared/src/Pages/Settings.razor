@page "/settings"
@using VideoForensics.Client.Core.Tools
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@inject IProviderAuthService AuthService
@inject IForensicsConfiguration Config
@inject IForensicsConfigurationService ConfigService
@inject ConfigToolsOrchestrator ConfigTools
@inject NavigationManager NavigationManager
@inject IStringLocalizer<Settings> L
@inject IServerLocationInformationService ServerLocationService

<h4 class="mb-4">@L["Title"]</h4>

<h6 class="mt-4 mb-2">@L["AppearanceSection"]</h6>
<div class="card p-4 mb-4">
    <div class="card-body">
        <ThemeLanguagePicker />
    </div>
</div>

<h6 class="mt-4 mb-2">Server Connection</h6>
<div class="card p-4 mb-4">
    <div class="card-body d-flex flex-column gap-2">
        <div class="d-flex flex-row gap-3">
            <div>
                <strong>Connection Status:</strong>
                <div class="text-muted">@ServerLocationService.LocationDescription</div>
            </div>
        </div>
        @if (ServerLocationService.CurrentServerAddress is not null)
        {
            <div class="d-flex flex-row gap-3">
                <div>
                    <strong>Server Address:</strong>
                    <div class="text-muted" style="font-family: monospace; word-break: break-all;">@ServerLocationService.CurrentServerAddress.AbsoluteUri</div>
                </div>
            </div>
        }
    </div>
</div>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToChangeSettings"]
    </div>
}
else
{
    <h6 class="mt-4 mb-2">@L["ReportsSection"]</h6>
    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-column gap-2">
            <SfCheckBox TChecked="bool" @bind-Checked="@Config.EnableForensicAnalysisReports" @bind-Checked:after="@(async () => await SaveForensicAnalysisReportsAsync(Config.EnableForensicAnalysisReports))" Label="@L["ForensicAnalysis"].Value" />
            @if (_reportMessages.TryGetValue("ForensicAnalysis", out var m1))
            {
                <small style="@(m1.Success ? "color: green;" : "color: red;")">@m1.Message</small>
            }
            <SfCheckBox TChecked="bool" @bind-Checked="@Config.EnableSignalAnomalyReports" @bind-Checked:after="@(async () => await SaveSignalAnomalyReportsAsync(Config.EnableSignalAnomalyReports))" Label="@L["SignalAnomaly"].Value" />
            @if (_reportMessages.TryGetValue("SignalAnomaly", out var m2))
            {
                <small style="@(m2.Success ? "color: green;" : "color: red;")">@m2.Message</small>
            }
            <SfCheckBox TChecked="bool" @bind-Checked="@Config.EnableChainOfCustodyReports" @bind-Checked:after="@(async () => await SaveChainOfCustodyReportsAsync(Config.EnableChainOfCustodyReports))" Label="@L["ChainOfCustody"].Value" />
            @if (_reportMessages.TryGetValue("ChainOfCustody", out var m3))
            {
                <small style="@(m3.Success ? "color: green;" : "color: red;")">@m3.Message</small>
            }
            <SfCheckBox TChecked="bool" @bind-Checked="@Config.EnableEvidenceValidationReports" @bind-Checked:after="@(async () => await SaveEvidenceValidationReportsAsync(Config.EnableEvidenceValidationReports))" Label="@L["EvidenceValidation"].Value" />
            @if (_reportMessages.TryGetValue("EvidenceValidation", out var m4))
            {
                <small style="@(m4.Success ? "color: green;" : "color: red;")">@m4.Message</small>
            }
            <SfCheckBox TChecked="bool" @bind-Checked="@Config.EnableAccessControlMonitoring" @bind-Checked:after="@(async () => await SaveAccessControlReportsAsync(Config.EnableAccessControlMonitoring))" Label="@L["AccessControl"].Value" />
            @if (_reportMessages.TryGetValue("AccessControl", out var m5))
            {
                <small style="@(m5.Success ? "color: green;" : "color: red;")">@m5.Message</small>
            }
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["HealthSyncSection"]</h6>
    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-column gap-2">
            <SfCheckBox TChecked="bool" @bind-Checked="@Config.EnableHealthSync" @bind-Checked:after="@(async () => await SaveHealthSyncAsync(Config.EnableHealthSync))" Label="@L["EnableHealthSync"].Value" />
            @if (_healthSyncMessage is not null)
            {
                <span style="@(_healthSyncSuccess ? "color: green;" : "color: red;")">@_healthSyncMessage</span>
            }
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["NetworkDiscoverySection"]</h6>
    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-column gap-2">
            <SfCheckBox TChecked="bool" @bind-Checked="@Config.EnableMdnsAdvertisement" @bind-Checked:after="@(async () => await SaveMdnsAdvertisementAsync(Config.EnableMdnsAdvertisement))" Label="@L["EnableMdnsAdvertisement"].Value" />
            @if (_mdnsMessage is not null)
            {
                <span style="@(_mdnsSuccess ? "color: green;" : "color: red;")">@_mdnsMessage</span>
            }
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["RetentionSection"]</h6>
    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-row gap-2 align-items-center">
            <label>@L["RetentionDaysLabel"]</label>
            <SfNumericTextBox TValue="int" @bind-Value="_retentionDays" Style="max-width: 200px;" />
            <SfButton Content="@L["SaveButton"]" OnClick="SaveRetentionAsync" CssClass="e-primary" />
            @if (_retentionMessage is not null)
            {
                <span style="@(_retentionSuccess ? "color: green;" : "color: red;")">@_retentionMessage</span>
            }
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["DownloadsSection"]</h6>
    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-column gap-3">
            <div class="d-flex flex-row gap-2 align-items-center">
                <label>@L["MaxConcurrentDownloads"]</label>
                <SfNumericTextBox TValue="int" @bind-Value="_maxConcurrentDownloads" Style="max-width: 260px;" />
                <SfButton Content="@L["SaveButton"]" OnClick="SaveMaxConcurrentAsync" CssClass="e-primary" />
                @if (_maxConcurrentMessage is not null)
                {
                    <span style="@(_maxConcurrentSuccess ? "color: green;" : "color: red;")">@_maxConcurrentMessage</span>
                }
            </div>
            <div class="d-flex flex-row gap-2 align-items-center">
                <label>@L["DownloadLocation"]</label>
                <SfTextBox Placeholder="@L["DownloadLocation"]" @bind-Value="_downloadLocation" Style="max-width: 400px;" />
                <SfButton Content="@L["SaveButton"]" OnClick="SaveDownloadLocationAsync" CssClass="e-primary" />
                @if (_downloadLocationMessage is not null)
                {
                    <span style="@(_downloadLocationSuccess ? "color: green;" : "color: red;")">@_downloadLocationMessage</span>
                }
            </div>
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["ReportingFormatSection"]</h6>
    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-column gap-3">
            <div class="d-flex flex-row gap-2 align-items-center">
                <SfDropDownList TValue="string" TItem="string" @bind-Value="_reportFormat" DataSource="@(new[] { "json", "xml", "csv" })" Style="max-width: 200px;" />
                <SfButton Content="@L["SaveButton"]" OnClick="SaveReportFormatAsync" CssClass="e-primary" />
                @if (_reportFormatMessage is not null)
                {
                    <span style="@(_reportFormatSuccess ? "color: green;" : "color: red;")">@_reportFormatMessage</span>
                }
            </div>
            <div class="d-flex flex-row gap-2 align-items-center">
                <SfDropDownList TValue="RedactionLevel" TItem="RedactionLevel" @bind-Value="_redactionLevel" DataSource="@(Enum.GetValues<RedactionLevel>())" Style="max-width: 200px;" />
                <SfButton Content="@L["SaveButton"]" OnClick="SaveRedactionLevelAsync" CssClass="e-primary" />
                @if (_redactionLevelMessage is not null)
                {
                    <span style="@(_redactionLevelSuccess ? "color: green;" : "color: red;")">@_redactionLevelMessage</span>
                }
            </div>
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["LoggingSection"]</h6>
    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-row gap-2 align-items-center">
            <SfDropDownList TValue="string" TItem="string" @bind-Value="_loggingLevel" DataSource="@(new[] { "Debug", "Information", "Warning", "Error", "Critical" })" Style="max-width: 200px;" />
            <SfButton Content="@L["SaveButton"]" OnClick="SaveLoggingLevelAsync" CssClass="e-primary" />
            @if (_loggingLevelMessage is not null)
            {
                <span style="@(_loggingLevelSuccess ? "color: green;" : "color: red;")">@_loggingLevelMessage</span>
            }
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    private readonly Dictionary<string, (bool Success, string Message)> _reportMessages = new();

    private bool _healthSyncSuccess;
    private string? _healthSyncMessage;

    private bool _mdnsSuccess;
    private string? _mdnsMessage;

    private int _retentionDays;
    private bool _retentionSuccess;
    private string? _retentionMessage;

    private int _maxConcurrentDownloads;
    private bool _maxConcurrentSuccess;
    private string? _maxConcurrentMessage;

    private string _downloadLocation = string.Empty;
    private bool _downloadLocationSuccess;
    private string? _downloadLocationMessage;

    private string _reportFormat = "json";
    private bool _reportFormatSuccess;
    private string? _reportFormatMessage;

    private RedactionLevel _redactionLevel;
    private bool _redactionLevelSuccess;
    private string? _redactionLevelMessage;

    private string _loggingLevel = "Information";
    private bool _loggingLevelSuccess;
    private string? _loggingLevelMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _isAuthenticated = await AuthService.IsAuthenticatedAsync();
            if (_isAuthenticated)
            {
                _retentionDays = Config.RetentionDaysDefault;
                _maxConcurrentDownloads = Config.MaxConcurrentDownloads;
                _downloadLocation = Config.DownloadLocation ?? string.Empty;
                _reportFormat = Config.ReportOutputFormat;
                _redactionLevel = Config.RedactionLevel;
                _loggingLevel = Config.LogLevel;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private Task SaveForensicAnalysisReportsAsync(bool enabled) => SaveReportToggleAsync("ForensicAnalysis", enabled);
    private Task SaveSignalAnomalyReportsAsync(bool enabled) => SaveReportToggleAsync("SignalAnomaly", enabled);
    private Task SaveChainOfCustodyReportsAsync(bool enabled) => SaveReportToggleAsync("ChainOfCustody", enabled);
    private Task SaveEvidenceValidationReportsAsync(bool enabled) => SaveReportToggleAsync("EvidenceValidation", enabled);
    private Task SaveAccessControlReportsAsync(bool enabled) => SaveReportToggleAsync("AccessControl", enabled);

    private async Task SaveReportToggleAsync(string reportType, bool enabled)
    {
        var (success, message) = await ConfigTools.SetReportEnabledAsync(Config, reportType, enabled, CancellationToken.None);
        _reportMessages[reportType] = (success, message);
    }

    private async Task SaveHealthSyncAsync(bool enabled)
    {
        try
        {
            Config.EnableHealthSync = enabled;
            try
            {
                await ConfigService.SaveConfigurationAsync(Config, CancellationToken.None);
            }
            catch (NotSupportedException)
            {
                _healthSyncSuccess = false;
                _healthSyncMessage = L["ConfigurationNotSupported"]?.Value ?? "This setting can only be changed from the server directly.";
                return;
            }
            _healthSyncSuccess = true;
            _healthSyncMessage = L["HealthSyncStatus", enabled ? "enabled" : "disabled"].Value;
        }
        catch (Exception ex)
        {
            _healthSyncSuccess = false;
            _healthSyncMessage = L["HealthSyncError", ex.Message].Value;
        }
    }

    private async Task SaveMdnsAdvertisementAsync(bool enabled)
    {
        try
        {
            Config.EnableMdnsAdvertisement = enabled;
            try
            {
                await ConfigService.SaveConfigurationAsync(Config, CancellationToken.None);
            }
            catch (NotSupportedException)
            {
                _mdnsSuccess = false;
                _mdnsMessage = L["ConfigurationNotSupported"]?.Value ?? "This setting can only be changed from the server directly.";
                return;
            }
            _mdnsSuccess = true;
            _mdnsMessage = L["MdnsStatus", enabled ? "enabled" : "disabled"].Value;
        }
        catch (Exception ex)
        {
            _mdnsSuccess = false;
            _mdnsMessage = L["MdnsError", ex.Message].Value;
        }
    }

    private async Task SaveRetentionAsync()
    {
        (_retentionSuccess, _retentionMessage) = await ConfigTools.SetRetentionDaysAsync(Config, _retentionDays, CancellationToken.None);
    }

    private async Task SaveMaxConcurrentAsync()
    {
        (_maxConcurrentSuccess, _maxConcurrentMessage) = await ConfigTools.SetMaxConcurrentDownloadsAsync(Config, _maxConcurrentDownloads, CancellationToken.None);
    }

    private async Task SaveDownloadLocationAsync()
    {
        (_downloadLocationSuccess, _downloadLocationMessage) = await ConfigTools.SetDownloadLocationAsync(Config, _downloadLocation, CancellationToken.None);
    }

    private async Task SaveReportFormatAsync()
    {
        (_reportFormatSuccess, _reportFormatMessage) = await ConfigTools.SetReportFormatAsync(Config, _reportFormat, CancellationToken.None);
    }

    private async Task SaveRedactionLevelAsync()
    {
        (_redactionLevelSuccess, _redactionLevelMessage) = await ConfigTools.SetRedactionLevelAsync(Config, _redactionLevel, CancellationToken.None);
    }

    private async Task SaveLoggingLevelAsync()
    {
        (_loggingLevelSuccess, _loggingLevelMessage) = await ConfigTools.SetLoggingLevelAsync(Config, _loggingLevel, CancellationToken.None);
    }
}
