@page "/settings/infrastructure"
@using VideoForensics.Client.Core.Tools
@using Microsoft.Extensions.Localization
@inject VideoForensics.Client.Ui.Shared.Services.PairedSessionState SessionState
@inject IForensicsConfiguration Config
@inject VideoForensics.Client.Core.Contracts.IConfigToolsOrchestrator ConfigTools
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@inject IOperatorPreferencesRepository PreferencesRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<SettingsInfrastructure> L
@using System.Net.Http.Json
@using VideoForensics.Client.Ui.Shared.Services
@inject ISelfApiHttpClientFactory ClientFactory

<h4 class="mb-4">@L["Title"]</h4>

@if (!CanLocalAdmin)
{
    <div class="alert alert-info">@L["AdminOnlySettingsNote"]</div>
}

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToChangeSettings"]
    </div>
}
else
{
    <h6 class="mt-4 mb-2">@L["DiagnosticsSection"]</h6>
    <div class="card mb-4">
        <div class="card-body p-4">
            <p class="text-body-secondary">@L["LogPipeDescription"]</p>
            <div class="form-check mb-3">
                <input id="log-pipe-enabled" class="form-check-input" type="checkbox" @bind="_logPipeEnabled" disabled="@(_logPipeSaving || _logPipeLoading)" />
                <label class="form-check-label" for="log-pipe-enabled">@L["LogPipeLabel"]</label>
            </div>
            <button type="button" class="btn btn-primary" @onclick="SaveLogPipeAsync" disabled="@(_logPipeSaving || _logPipeLoading)">@L["SaveButton"]</button>
            @if (_logPipeMessage is not null)
            {
                <span class="ms-3" role="status">@_logPipeMessage</span>
            }
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["DataEncryptionSection"]</h6>
    @if (!_encryptionWarningDismissed)
    {
        <div class="alert alert-warning alert-dismissible mb-4" role="alert">
            <strong>@L["EncryptionWarning"]</strong>
            <button type="button" class="btn-close" aria-label="@L["Dismiss"]" @onclick="DismissEncryptionWarningAsync"></button>
        </div>
    }

    <h6 class="mt-4 mb-2">@L["KeyStorageSection"]</h6>
    <div class="card mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-row gap-2">
                <SfDropDownList TValue="KeyStorageProvider" TItem="KeyStorageProvider" @bind-Value="_keyStorageProvider" Enabled="@CanLocalAdmin" DataSource="@(Enum.GetValues<KeyStorageProvider>())" Style="max-width: 260px;" />
                <SfButton Content="@L["SaveButton"]" OnClick="SaveKeyStorageProviderAsync" Disabled="@(!CanLocalAdmin)" CssClass="e-primary" />
                @if (_keyStorageProviderMessage is not null)
                {
                    <span style="@(_keyStorageProviderSuccess ? "color: green;" : "color: red;")">@_keyStorageProviderMessage</span>
                }
            </div>
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["FactoryResetSection"]</h6>
    <div class="card mb-4">
        <div class="card-body p-4">
            @if (!_showFactoryResetConfirm)
            {
                <SfButton Content="@L["FactoryResetButton"]" OnClick="() => _showFactoryResetConfirm = true" Disabled="@(!CanLocalAdmin)" CssClass="e-danger" />
            }
            else
            {
                <div class="alert alert-danger mb-2">
                    <strong>@L["FactoryResetWarning"]</strong>
                </div>
                <div class="d-flex flex-row gap-2">
                    <SfButton Content="@L["ConfirmDelete"]" OnClick="ConfirmFactoryResetAsync" Disabled="@_factoryResetting" CssClass="e-danger" />
                    <SfButton Content="@L["CancelButton"]" OnClick="() => _showFactoryResetConfirm = false" Disabled="@_factoryResetting" CssClass="e-flat" />
                </div>
            }

            @if (_factoryResetMessage is not null)
            {
                <span style="@(_factoryResetSuccess ? "color: green;" : "color: red;")" class="mt-2"><strong>@_factoryResetMessage</strong></span>
            }
        </div>
    </div>
}

@code {
    private bool CanLocalAdmin => VideoForensics.Client.Ui.Shared.Layout.PageAccessRules.Allows(
        VideoForensics.Client.Ui.Shared.Layout.AccessPolicy.SuperAdminLocal,
        VideoForensics.Client.Ui.Shared.Layout.NavContext.FromSession(SessionState, appLockSupported: false));

    private bool _isLoading = true;
    private bool _isAuthenticated;

    // Stored per operator, so a dismissal follows the person across devices and visits.
    private bool _encryptionWarningDismissed;

    private KeyStorageProvider _keyStorageProvider;
    private bool _keyStorageProviderSuccess;
    private string? _keyStorageProviderMessage;

    private bool _logPipeEnabled;
    private bool _logPipeLoading = true;
    private bool _logPipeSaving;
    private string? _logPipeMessage;

    private bool _showFactoryResetConfirm;
    private bool _factoryResetting;
    private bool _factoryResetSuccess;
    private string? _factoryResetMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await SessionState.EnsureLoadedAsync();
            _isAuthenticated = SessionState.IsSignedIn;
            if (_isAuthenticated)
            {
                _keyStorageProvider = Config.KeyStorageProvider;
                await LoadLogPipeAsync();
                if (SessionState.OperatorId is Guid operatorId)
                {
                    OperatorPreferences? saved = await PreferencesRepository.GetAsync(operatorId, CancellationToken.None);
                    _encryptionWarningDismissed = saved?.EncryptionWarningDismissed ?? false;
                }
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task DismissEncryptionWarningAsync()
    {
        _encryptionWarningDismissed = true;
        if (SessionState.OperatorId is Guid operatorId)
        {
            await PreferencesRepository.SetEncryptionWarningDismissedAsync(operatorId, true, CancellationToken.None);
        }
    }

    private async Task LoadLogPipeAsync()
    {
        try
        {
            HttpClient client = ClientFactory.CreateClient();
            LogPipeSetting? setting = await client.GetFromJsonAsync<LogPipeSetting>("/api/v1/diagnostics/log-pipe");
            _logPipeEnabled = setting?.Enabled ?? false;
        }
        catch (HttpRequestException ex)
        {
            _logPipeMessage = L["LogPipeLoadFailed", ex.Message].Value;
        }
        finally
        {
            _logPipeLoading = false;
        }
    }

    private async Task SaveLogPipeAsync()
    {
        _logPipeSaving = true;
        _logPipeMessage = null;
        try
        {
            HttpClient client = ClientFactory.CreateClient();
            HttpResponseMessage response = await client.PostAsJsonAsync("/api/v1/diagnostics/log-pipe", new LogPipeSetting(_logPipeEnabled));
            if (response.IsSuccessStatusCode)
            {
                _logPipeMessage = L["LogPipeSaved"].Value;
            }
            else
            {
                _logPipeMessage = L["LogPipeSaveFailed", (int)response.StatusCode].Value;
            }
        }
        catch (HttpRequestException ex)
        {
            _logPipeMessage = L["LogPipeSaveFailed", ex.Message].Value;
        }
        finally
        {
            _logPipeSaving = false;
        }
    }

    // Mirrors the WebApp's LogPipeSettingDto. Kept local because Ui.Shared cannot reference the WebApp.
    private sealed record LogPipeSetting(bool Enabled);

    private async Task SaveKeyStorageProviderAsync()
    {
        (_keyStorageProviderSuccess, _keyStorageProviderMessage) = await ConfigTools.SetKeyStorageProviderAsync(Config, _keyStorageProvider, CancellationToken.None);
    }

    private async Task ConfirmFactoryResetAsync()
    {
        _factoryResetting = true;
        try
        {
            (_factoryResetSuccess, _factoryResetMessage) = await ConfigTools.FactoryResetAsync(CancellationToken.None);
        }
        finally
        {
            _factoryResetting = false;
            _showFactoryResetConfirm = false;
        }
    }
}
