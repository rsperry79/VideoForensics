@page "/settings/app-lock"
@using Microsoft.Extensions.Localization
@inject IAppLockPreferencesStore AppLockPreferences
@inject IStringLocalizer<AppLock> L

<h4 class="mb-4">@L["Title"]</h4>

@if (!AppLockPreferences.IsSupported)
{
    <div class="alert alert-info">
        @L["UnsupportedAlert"]
    </div>
}
else
{
    <p class="mb-4">
        @L["Description"]
    </p>

    <div class="card border p-4 mb-4">
        <SfDropDownList TValue="int" TItem="TimeoutOption" Value="@_selectedSeconds" ValueChanged="@OnTimeoutChangedAsync"
            DataSource="@_timeoutOptionsList" CssClass="w-100" Style="max-width: 320px;">
            <DropDownListFieldSettings Text="Text" Value="Value"></DropDownListFieldSettings>
        </SfDropDownList>
        @if (_message is not null)
        {
            <span class="mt-2 d-block">@_message</span>
        }
    </div>
}

@code {
    private record TimeoutOption(int Value, string Text);

    private List<TimeoutOption> _timeoutOptionsList = new();

    private int _selectedSeconds;
    private string? _message;

    protected override void OnInitialized()
    {
        _timeoutOptionsList = new()
        {
            new(0, L["TimeoutImmediate"].Value),
            new(60, L["TimeoutOneMinute"].Value),
            new(300, L["TimeoutFiveMinutes"].Value),
            new(900, L["TimeoutFifteenMinutes"].Value),
        };

        if (AppLockPreferences.IsSupported)
        {
            _selectedSeconds = (int)AppLockPreferences.GetIdleLockTimeout().TotalSeconds;
        }
    }

    private Task OnTimeoutChangedAsync(int seconds)
    {
        _selectedSeconds = seconds;
        AppLockPreferences.SetIdleLockTimeout(TimeSpan.FromSeconds(seconds));
        _message = L["SavedMessage"];
        return Task.CompletedTask;
    }
}
