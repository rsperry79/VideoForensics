@page "/accounts/{Id:guid}/sync"
@inherits AccountTabPageBase
@using VideoForensics.Client.Ui.Shared.Layout.RightPanel
@using VideoForensics.Client.Ui.Shared.Services
@using Microsoft.Extensions.Localization

<Breadcrumb Items="@_breadcrumbItems" />

@if (IsLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <p>@StatusMessage</p>
    }

    @if (Account == null)
    {
        <p>@L["AccountNotFound"]</p>
    }
    else
    {
        <AccountTabs AccountId="@Id" />

        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">@(AccountEmail is null ? Account.ProviderName : $"{Account.ProviderName} - {AccountEmail}")</h5>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LastSuccessfulAuthLabel"]</label>
                    <p class="mb-0"><LocalTimeText Value="@Account.LastSuccessfulAuthUtc" Fallback="@L["Never"]" /></p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LastDownloadLabel"]</label>
                    <p class="mb-0"><LocalTimeText Value="@Account.LastDownloadTimeUtc" Fallback="@L["Never"]" /></p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LastSyncCompletedLabel"]</label>
                    <p class="mb-0"><LocalTimeText Value="@Account.LastSyncCompletedUtc" Fallback="@L["Never"]" /></p>
                </div>
            </div>
        </div>

        <div id="schedule" class="mb-4">
            <AccountSyncSchedule Id="@Id" />
        </div>

        <div class="mb-4">
            <div class="d-flex flex-wrap gap-2 align-items-end mb-2">
                <div>
                    <label class="form-label" for="sync-type">@L["SyncTypeLabel"]</label>
                    <select id="sync-type" class="form-select" @bind="_syncType">
                        @foreach (var t in SyncRequestBuilder.SyncTypes)
                        {
                            <option value="@t">@SyncTypeChoiceLabel(t)</option>
                        }
                    </select>
                </div>
                @if (!IsConfigSync)
                {
                    <div>
                        <label class="form-label" for="sync-range">@L["SyncRangeLabel"]</label>
                        <select id="sync-range" class="form-select" @onchange="OnRangeChanged">
                            @foreach (var r in SyncRequestBuilder.RangeOptions)
                            {
                                <option value="@r" selected="@(r == _syncRange)">@RangeLabel(r)</option>
                            }
                        </select>
                    </div>
                    @if (_syncRange == SyncRequestBuilder.CustomRange)
                    {
                        <div>
                            <label class="form-label" for="sync-custom-start">@L["SyncCustomStart"]</label>
                            <input id="sync-custom-start" type="date" class="form-control" value="@_customStart" @onchange="e => _customStart = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div>
                            <label class="form-label" for="sync-custom-end">@L["SyncCustomEnd"]</label>
                            <input id="sync-custom-end" type="date" class="form-control" value="@_customEnd" @onchange="e => _customEnd = e.Value?.ToString() ?? string.Empty" />
                            <div id="sync-custom-end-hint" class="form-text">@L["CustomEndHint"]</div>
                        </div>
                    }
                }
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                @if (CanEditAccount)
                {
                    <SfButton CssClass="e-primary" Content="@L["SyncNow"]" OnClick="SyncNowAsync" Disabled="@_isSyncing" />
                }
                @if (_isSyncing)
                {
                    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" Height="30px" Width="30px" />
                }
                @if (CanEditAccount && !string.IsNullOrEmpty(Account.LastErrorMessage))
                {
                    <SfButton CssClass="e-warning" Content="@L["Login"]" OnClick="() => _reAuthDialogVisible = true" />
                }
            </div>
        </div>

        <div id="sync-output" class="mb-4">
            <h5>@L["SyncOutputTitle"]</h5>
            @if (LatestRun is { } latest)
            {
                <p class="mb-1">
                    <strong>@L["LatestSyncRunLabel"]</strong>
                    <LocalTimeText Value="@latest.StartedUtc" Format="g" /> - @(latest.Success ? L["SyncSucceeded"] : L["SyncRunFailed"])
                </p>
            }
            <DownloadProgressPanel IsActive="@_isSyncing" CollectionType="@SyncTypeChoiceLabel(_runningSyncType)" />
        </div>

        <div id="sync-links" class="mb-4">
            <a class="btn btn-outline-primary" href="/accounts/@Id/sync/history">@L["ViewSyncHistory"]</a>
        </div>

        <ReAuthDialog @bind-Visible="_reAuthDialogVisible"
                      ProviderName="@Account.ProviderName"
                      InitialEmail="@AccountEmail"
                      OnAuthenticated="HandleReAuthenticatedAsync" />

        <SfToast @ref="_toastRef" />
    }
}

@code {
    private List<(string Label, string? Url)> _breadcrumbItems = new();
    private string _syncType = "All";

    /// <summary>The sync type the progress panel titles itself with: captured at Sync Now, so changing the dropdown mid-run does not relabel it.</summary>
    private string _runningSyncType = "All";
    private string _syncRange = "30";
    private string _customStart = SyncRequestBuilder.DefaultCustomRange(DateTime.Today).Start;
    private string _customEnd = SyncRequestBuilder.DefaultCustomRange(DateTime.Today).End;
    private bool _reAuthDialogVisible;
    private bool _isSyncing;
    private SfToast _toastRef = null!;
    private List<VideoForensics.Core.Api.Contracts.ProviderSyncRunSummaryDto>? _syncRuns;

    private VideoForensics.Core.Api.Contracts.ProviderSyncRunSummaryDto? LatestRun =>
        _syncRuns?.OrderByDescending(r => r.StartedUtc).FirstOrDefault();

    private void OnRangeChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _syncRange = e.Value?.ToString() ?? "30";
        if (_syncRange == SyncRequestBuilder.CustomRange)
        {
            (_customStart, _customEnd) = SyncRequestBuilder.DefaultCustomRange(DateTime.Today);
        }
    }

    private string SyncTypeChoiceLabel(string type) => type switch
    {
        "Events" => L["SyncChoiceEvents"],
        "Snapshots" => L["SyncChoiceSnapshots"],
        "Config" => L["SyncChoiceConfig"],
        _ => L["SyncChoiceAll"],
    };

    private bool IsConfigSync => _syncType == SyncRequestBuilder.ConfigSyncType;

    private string RangeLabel(string range) => range switch
    {
        "30" => L["SyncRange30"],
        "60" => L["SyncRange60"],
        "90" => L["SyncRange90"],
        "365" => L["SyncRange365"],
        SyncRequestBuilder.AllRange => L["SyncRangeAll"],
        _ => L["SyncRangeCustom"],
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountAsync();
        _breadcrumbItems = new() { (L["BreadcrumbAccounts"], "/accounts"), (L["BreadcrumbAccountDetails"], $"/accounts/{Id}"), (L["TabSync"], null) };
        // Render the account card first; the history loads after it and doesn't hold it up.
        StateHasChanged();
        if (Account is not null)
        {
            await LoadSyncRunsAsync();
        }
    }

    private async Task LoadSyncRunsAsync()
    {
        try
        {
            _syncRuns = await GetApiAsync<List<VideoForensics.Core.Api.Contracts.ProviderSyncRunSummaryDto>>(
                $"api/v1/accounts/provider-accounts/{Id}/sync-runs") ?? new();
        }
        catch
        {
            _syncRuns = null;
        }
        StateHasChanged();
    }


    private async Task HandleReAuthenticatedAsync(AuthResult result)
    {
        if (result.Success)
        {
            await LoadAccountAsync();
        }
    }

    private async Task SyncNowAsync()
    {
        _runningSyncType = _syncType;
        _isSyncing = true;
        try
        {
            await SessionState.EnsureLoadedAsync();
            // Session state loads lazily; the token is only populated after this.
            // The injected HttpClient has no base address, so relative URIs fail before a request is sent.
            using var request = new HttpRequestMessage(HttpMethod.Post, new Uri(new Uri(NavigationManager.BaseUri), $"api/v1/accounts/provider-accounts/{Id}/sync-now"))
            {
                Content = JsonContent.Create(SyncRequestBuilder.Build(_syncType, _syncRange, _customStart, _customEnd)),
            };
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
            using HttpResponseMessage response = await HttpClient.SendAsync(request, CancellationToken.None);

            if (response.IsSuccessStatusCode)
            {
                await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
                {
                    Title = L["SyncStarted"],
                    Icon = "e-success"
                });

                // Reload after a delay to show the updated timestamps
                await Task.Delay(2000);
                await LoadAccountAsync();
                await LoadSyncRunsAsync();
            }
            else
            {
                await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
                {
                    Title = L["SyncFailed"],
                    Icon = "e-danger"
                });
            }
        }
        catch (Exception ex)
        {
            await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
            {
                Title = L["ErrorTitle"],
                Content = ex.Message,
                Icon = "e-danger"
            });
        }
        finally
        {
            _isSyncing = false;
        }
    }
}
