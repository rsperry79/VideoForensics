@page "/accounts/{Id:guid}/sync"
@inherits AccountTabPageBase
@using VideoForensics.Client.Ui.Shared.Layout.RightPanel
@using VideoForensics.Client.Ui.Shared.Services
@using Microsoft.Extensions.Localization

<Breadcrumb Items="@_breadcrumbItems" />

@if (IsLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <p>@StatusMessage</p>
    }

    @if (Account == null)
    {
        <p>@L["AccountNotFound"]</p>
    }
    else
    {
        <AccountTabs AccountId="@Id" />

        <div class="card mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LastDownloadLabel"]</label>
                    <p class="mb-0"><LocalTimeText Value="@Account.LastDownloadTimeUtc" Fallback="@L["Never"]" /></p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LastSyncCompletedLabel"]</label>
                    <p class="mb-0"><LocalTimeText Value="@Account.LastSyncCompletedUtc" Fallback="@L["Never"]" /></p>
                </div>
            </div>
        </div>

        <div id="schedule" class="mb-4">
            <AccountSyncSchedule Id="@Id" />
        </div>
    }
}

@code {
    private List<(string Label, string? Url)> _breadcrumbItems = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountAsync();
        _breadcrumbItems = new() { (L["BreadcrumbAccounts"], "/accounts"), (L["BreadcrumbAccountDetails"], $"/accounts/{Id}"), (L["TabSync"], null) };
    }
}
