@using VideoForensics.Core.Api.Contracts
@using VideoForensics.Core.Api.Contracts.Repositories
@page "/signal-history/review/{FlagId:guid}"
@implements IDisposable
@using Microsoft.Extensions.Localization
@using Syncfusion.Blazor.Navigations
@using VideoForensics.Client.Common.Contracts
@using VideoForensics.Client.Ui.Shared.Components.Review
@using VideoForensics.Client.Ui.Shared.Components.Viewer
@using VideoForensics.Client.Ui.Shared.Contracts
@using VideoForensics.Client.Ui.Shared.Layout.RightPanel
@using VideoForensics.Client.Ui.Shared.Services.Signal
@using VideoForensics.Client.Ui.Shared.Resources
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@inject IMediaFlagRepository MediaFlagRepository
@inject IMediaItemRepository MediaItemRepository
@inject IMediaContentUrlProvider MediaContentUrls
@inject IDeviceRepository DeviceRepository
@inject ISignalAnalysisService Signals
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager NavigationManager

<PageRightPanelContent>
    @if (_flag is not null)
    {
        <ClipNavigator Filter="@RssiFilter" CurrentFlagId="@FlagId" OnNavigate="OnNeighbourNavigate" />
    }
    @if (_flag is { } flag)
    {
        <FlagActionsPanel Flag="@flag" OnChanged="OnFlagChanged" />
    }
</PageRightPanelContent>

<FlagReviewShell>
    <Breadcrumb>
        <SfBreadcrumb>
            <BreadcrumbItems>
                <BreadcrumbItem Text="@L["RssiReviewBreadcrumbRoot"].Value" Url="/signal-history" />
                @if (_flag is not null)
                {
                    <BreadcrumbItem Text="@_cameraName" />
                }
            </BreadcrumbItems>
        </SfBreadcrumb>
        <h5 class="mb-0" data-testid="rssi-review-title">@L["RssiReviewTitle"]</h5>
        @if (_noUnreviewedMessage is { } noUnreviewed)
        {
            <div class="small text-muted" role="status" data-testid="flag-review-no-unreviewed">@noUnreviewed</div>
        }
    </Breadcrumb>

    <Media>
        @if (_loaded)
        {
            <MediaFit State="_state"
                      Source="@_source"
                      PlaybackRate="@_rate"
                      SourceStartUtc="@_clipStartUtc"
                      SourceDurationSeconds="@_clipDurationSeconds"
                      PlayerChanged="OnPlayerChanged" />
        }
    </Media>

    <Timeline>
        @if (_player is { } player && _flag is not null)
        {
            <HistogramTimeline Player="@player"
                               WindowStartUtc="@_windowStart"
                               WindowEndUtc="@_windowEnd"
                               Markers="@_markers"
                               OnRateChange="@(r => _rate = r)"
                               EventType="@_flag?.EventType">
                <Histogram>
                    <RssiSeriesChart Readings="@_readings" WindowStartUtc="@_windowStart" WindowEndUtc="@_windowEnd" Player="@player" StdDevDbm="@_stdDevDbm" />
                </Histogram>
            </HistogramTimeline>
        }
    </Timeline>
</FlagReviewShell>

@code {
    /// <summary>The RssiDeviation flag to review.</summary>
    [Parameter]
    public Guid FlagId { get; set; }

    private static readonly MediaFlagFilter RssiFilter = new() { Types = [MediaFlagType.RssiDeviation] };

    /// <summary>How far the clip search extends beyond the flag window on each side.</summary>
    private static readonly TimeSpan ClipSearchPad = TimeSpan.FromHours(1);

    /// <summary>How far the timeline window extends beyond the flag window when the clip has no known duration.</summary>
    private static readonly TimeSpan FlagWindowPad = TimeSpan.FromMinutes(5);

    private readonly CancellationTokenSource _disposeCts = new();
    private Guid? _loadedFlagId;
    private bool _loaded;
    private MediaFlag? _flag;
    private MediaFitState _state = MediaFitState.FlagNotFound;
    private string? _source;
    private DateTime? _clipStartUtc;
    private double? _clipDurationSeconds;
    private string _cameraName = string.Empty;
    private double _rate = 1.0;
    private MediaPlayer? _player;
    private DateTime _windowStart;
    private DateTime _windowEnd;
    private IReadOnlyCollection<MediaFlag> _markers = [];
    private IReadOnlyList<SignalSample> _readings = [];
    private double? _stdDevDbm;
    private string? _noUnreviewedMessage;

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedFlagId == FlagId)
        {
            return;
        }

        _loadedFlagId = FlagId;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        CancellationToken ct = _disposeCts.Token;
        _loaded = false;
        _flag = null;
        _player = null;
        _source = null;
        _markers = [];
        _readings = [];
        _stdDevDbm = null;
        _noUnreviewedMessage = null;
        _state = MediaFitState.FlagNotFound;
        try
        {
            MediaFlag? flag = await MediaFlagRepository.GetAsync(FlagId, ct);
            if (flag is null || flag.FlagType != MediaFlagType.RssiDeviation)
            {
                return;
            }

            _flag = flag;
            _markers = [flag];
            _windowStart = flag.WindowStartUtc - FlagWindowPad;
            _windowEnd = flag.WindowEndUtc + FlagWindowPad;

            var device = await DeviceRepository.GetAsync(flag.DeviceId, ct);
            _cameraName = device?.Name ?? L["FlaggedMediaUnknownCamera"].Value;

            IReadOnlyList<MediaItemDto> clips = await MediaItemRepository.GetByDeviceAndDateRangeAsync(
                flag.DeviceId,
                flag.WindowStartUtc - ClipSearchPad,
                flag.WindowEndUtc + ClipSearchPad,
                ct);
            if (clips.Count == 0)
            {
                _state = MediaFitState.NoClipInHour;
                return;
            }

            IReadOnlyList<MediaItemDto> playable = clips.Where(c => !c.IsPurged).ToList();
            if (playable.Count == 0)
            {
                _state = MediaFitState.Purged;
                return;
            }

            MediaItemDto clip = playable.FirstOrDefault(c => Covers(c, flag.WindowStartUtc)) ?? playable[0];
            IReadOnlyDictionary<Guid, string> urls = await MediaContentUrls.GetContentUrlsAsync([clip.Id], ct);
            _source = urls.TryGetValue(clip.Id, out string? url) ? url : null;
            _state = MediaStill.IsStill(clip) ? MediaFitState.Still : MediaFitState.Playable;
            _clipStartUtc = clip.RecordedAtUtc;
            _clipDurationSeconds = clip.DurationSeconds;
            if (clip.DurationSeconds is { } seconds)
            {
                _windowStart = clip.RecordedAtUtc;
                _windowEnd = clip.RecordedAtUtc.AddSeconds(seconds);
            }

            SignalAnalysis analysis = await Signals.AnalyzeAsync([flag.DeviceId], _windowStart, _windowEnd, ct);
            SignalDeviceAnalysis? camera = analysis.Devices.FirstOrDefault(d => d.DeviceId == flag.DeviceId);
            _readings = camera?.Readings ?? [];
            // The camera's all-time std dev, the same figure the signal history shows as Dev. Computed on the server.
            _stdDevDbm = camera?.AllTime.StdDev;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            // The page is leaving; the load is dropped.
        }
        finally
        {
            _loaded = !_disposeCts.IsCancellationRequested;
        }
    }

    /// <summary>True when the clip's recorded span, which needs a known duration, contains the instant.</summary>
    private static bool Covers(MediaItemDto clip, DateTime instantUtc)
    {
        if (clip.DurationSeconds is not { } seconds)
        {
            return false;
        }

        return clip.RecordedAtUtc <= instantUtc && instantUtc < clip.RecordedAtUtc.AddSeconds(seconds);
    }

    private void OnPlayerChanged(MediaPlayer? player)
    {
        _player = player;
    }

    /// <summary>Keep or Dismiss moves to the next unreviewed flag. Undoing a review stays on the flag.</summary>
    private async Task OnFlagChanged(MediaFlag updated)
    {
        _flag = updated;
        _markers = [updated];
        if (updated.Status == MediaFlagStatus.Unreviewed)
        {
            return;
        }

        try
        {
            MediaFlag? next = await FlagAdvance.FindNextUnreviewedAsync(MediaFlagRepository, RssiFilter, updated.Id, _disposeCts.Token);
            if (next is { } found && FlaggedMediaTable.ReviewPath(found) is { } path)
            {
                NavigationManager.NavigateTo(path);
                return;
            }

            _noUnreviewedMessage = L["NoUnreviewedFlagsLeft"].Value;
        }
        catch (OperationCanceledException) when (_disposeCts.IsCancellationRequested)
        {
            // The page is leaving; the advance is dropped.
        }
    }

    private void OnNeighbourNavigate(MediaFlag neighbour)
    {
        string? path = FlaggedMediaTable.ReviewPath(neighbour);
        if (path is not null)
        {
            NavigationManager.NavigateTo(path);
        }
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }
}
