@page "/cases/new"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Services.Cases
@using VideoForensics.Ui.Shared.Services.Scope
@implements IAsyncDisposable
@inject ICaseRepository CaseRepository
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject CaseState CaseState
@inject ScopeState ScopeState
@inject IDeviceRepository DeviceRepository
@inject IStringLocalizer<CaseNew> L

<h4 class="mb-4">@L["NewCaseTitle"]</h4>

@if (SessionState.OperatorId is null || !Enum.TryParse(SessionState.Role, out OperatorRole role) || role < OperatorRole.Review)
{
    <div class="alert alert-info">@L["NoPermission"]</div>
}
else
{
    <div class="card">
        <div class="card-body">
            <form @onsubmit="HandleSubmit">
                <div class="mb-3">
                    <label for="caseNumber" class="form-label">@L["CaseNumberLabel"]</label>
                    <input type="text" class="form-control" id="caseNumber" disabled value="@_caseNumberPreview" />
                    <small class="form-text text-muted">@L["CaseNumberHelp"]</small>
                </div>

                <div class="mb-3">
                    <label for="title" class="form-label">@L["TitleLabel"]</label>
                    <input type="text" class="form-control" id="title" @bind="_title" placeholder="@L["TitlePlaceholder"]" />
                    @if (!string.IsNullOrEmpty(_titleError))
                    {
                        <div class="text-danger">@_titleError</div>
                    }
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">@L["DescriptionLabel"]</label>
                    <textarea class="form-control" id="description" @bind="_description" rows="4" placeholder="@L["DescriptionPlaceholder"]"></textarea>
                </div>

                <div class="mb-3 form-check">
                    <input type="checkbox" class="form-check-input" id="useCurrentScope" @bind="_useCurrentScope" />
                    <label class="form-check-label" for="useCurrentScope">@L["UseCurrentScope"]</label>
                    @if (_useCurrentScope)
                    {
                        <div class="mt-2 p-2 bg-light border rounded">
                            <p class="mb-1">
                                <strong>@L["DevicesLabel"]</strong>
                                @if (ScopeState.Current.DeviceIds.Count == 0)
                                {
                                    <span>@L["AllDevices"]</span>
                                }
                                else
                                {
                                    <span>@L["DevicesSelected", ScopeState.Current.DeviceIds.Count]</span>
                                }
                            </p>
                            <p class="mb-0">
                                <strong>@L["WindowLabel"]</strong> @ScopeState.Current.FromUtc:u - @ScopeState.Current.ToUtc:u
                            </p>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(_submitError))
                {
                    <div class="alert alert-danger">@_submitError</div>
                }

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary" data-testid="create-case">@L["CreateCase"]</button>
                    <a href="/cases" class="btn btn-secondary">@L["Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
}

@code {
    private string _title = "";
    private string _description = "";
    private bool _useCurrentScope = true;
    private string? _titleError;
    private string? _submitError;

    private string _caseNumberPreview => GenerateCaseNumberPreview();

    private string GenerateCaseNumberPreview()
    {
        DateTime now = DateTime.UtcNow;
        return $"manual-{now:yyyy-MM-dd-HH-mm}-0";
    }

    private async Task HandleSubmit()
    {
        // Validate
        _titleError = string.IsNullOrWhiteSpace(_title) ? L["TitleRequired"].Value : null;
        _submitError = null;

        if (_titleError is not null)
        {
            return;
        }

        try
        {
            var scopeFromUtc = _useCurrentScope ? ScopeState.Current.FromUtc : (DateTime?)null;
            var scopeToUtc = _useCurrentScope ? ScopeState.Current.ToUtc : (DateTime?)null;
            var deviceIds = _useCurrentScope ? ScopeState.Current.DeviceIds : new List<Guid>();

            var createdCase = await CaseRepository.CreateAsync(
                null,
                _title.Trim(),
                string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(),
                SessionState.OperatorId,
                scopeFromUtc,
                scopeToUtc,
                deviceIds,
                SessionState.OperatorId.ToString(),
                CancellationToken.None);

            // Activate the case and navigate to details
            await CaseState.ActivateAsync(createdCase.Id, CancellationToken.None);
            NavigationManager.NavigateTo($"/cases/{createdCase.Id}");
        }
        catch (InvalidOperationException ex)
        {
            _submitError = ex.Message;
        }
        catch (Exception ex)
        {
            _submitError = L["FailedToCreateCase", ex.Message].Value;
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        await Task.CompletedTask;
    }
}
