@page "/accounts/add"
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using Microsoft.AspNetCore.Components
@inject IProviderAuthService AuthService
@inject IMultiProviderAuthService MultiProviderAuthService
@inject IForensicsConfiguration ForensicsConfig
@inject IForensicsConfigurationService ForensicsConfigService
@inject NavigationManager NavigationManager
@inject IStringLocalizer<AddAccountWizard> L

<Breadcrumb Items="@_breadcrumbItems" />

<h4 class="mb-4">@L["AddAccount"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (_currentStep == 1)
    {
        <div>
            <h5>@L["SelectProviderHeading"]</h5>
            <p>@L["SelectProviderPrompt"]</p>
            <div class="provider-list mt-3">
                @if (_availableProviders != null)
                {
                    @foreach (var provider in _availableProviders)
                    {
                        <div class="provider-card mb-2 p-3"
                             style="border: 2px solid @(_selectedProvider == provider ? "#007bff" : "#ddd"); border-radius: 8px; cursor: pointer;"
                             @onclick="() => _selectedProvider = provider">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <SfRadioButton Label="@provider" Name="provider" TChecked="string" Value="@provider" Checked="@_selectedProvider" ValueChange="@((Syncfusion.Blazor.Buttons.ChangeArgs<string> args) => _selectedProvider = args.Value)" />
                            </div>
                        </div>
                    }
                }
            </div>
            <div class="mt-4">
                <SfButton CssClass="e-primary" Content="@L["Next"]" OnClick="() => _currentStep = 2" Disabled="@string.IsNullOrEmpty(_selectedProvider)" />
            </div>
        </div>
    }
    else if (_currentStep == 2)
    {
        <div>
            @if (_selectedProvider == "Uniview")
            {
                <h5>@L["UniviewAuthHeading"]</h5>
                <p style="color: #666; font-size: 0.95rem;">
                    @L["UniviewHostHint"]
                </p>

                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <p style="color: red; margin-bottom: 1rem;">@_errorMessage</p>
                }

                <EditForm Model="this" OnValidSubmit="AuthenticateUniviewAsync">
                    <div class="mb-3">
                        <label for="uniview-username">@L["UsernameLabel"]</label>
                        <SfTextBox ID="uniview-username" @bind-Value="_univiewUsername" />
                    </div>
                    <div class="mb-3">
                        <label for="uniview-password">@L["PasswordLabel"]</label>
                        <SfTextBox ID="uniview-password" Type="Syncfusion.Blazor.Inputs.InputType.Password" @bind-Value="_univiewPassword" />
                    </div>
                    <div>
                        <SfButton CssClass="e-primary" type="submit" Disabled="@_isBusy" Content="@(_isBusy ? L["Authenticating"] : L["Authenticate"])" />
                        <SfButton CssClass="e-outline ms-2" type="button" Content="@L["Back"]" OnClick="() => _currentStep = 1" Disabled="@_isBusy" />
                    </div>
                </EditForm>
            }
            else
            {
                <h5>@L["ProviderAccountHeading", _selectedProvider ?? string.Empty]</h5>
                @if (!string.IsNullOrEmpty(_errorMessage))
                {
                    <p style="color: red; margin-bottom: 1rem;">@_errorMessage</p>
                }
                <AuthForm IdPrefix="add-account-wizard" SubmitLabel="@L["AddAccount"]"
                          OnAuthenticated="HandleAuthenticationAsync"
                          AvailableProviders="@(new[] { _selectedProvider })" />
                <SfButton CssClass="e-outline mt-2" Content="@L["Back"]" OnClick="() => { _currentStep = 1; _errorMessage = null; }" Disabled="@_isBusy" />
            }
        </div>
    }
    else if (_currentStep == 3)
    {
        <div class="mt-3">
            @if (_authSuccess)
            {
                <div style="padding: 20px; background-color: #d4edda; border: 1px solid #c3e6cb; border-radius: 8px; color: #155724;">
                    <h5>@L["Success"]</h5>
                    <p>@L["AccountAddedSuccessfully", _selectedProvider ?? string.Empty]</p>
                </div>
            }
            else
            {
                <div style="padding: 20px; background-color: #f8d7da; border: 1px solid #f5c6cb; border-radius: 8px; color: #721c24;">
                    <h5>@L["AuthenticationFailedHeading"]</h5>
                    <p>@_errorMessage</p>
                </div>
                <div class="mt-3">
                    <SfButton CssClass="e-danger" Content="@L["TryAgain"]" OnClick="() => _currentStep = 2" />
                </div>
            }
        </div>
    }
}

@code {
    private List<(string Label, string? Url)> _breadcrumbItems = new();
    private int _currentStep = 1;
    private bool _isLoading = true;
    private bool _isBusy;
    private string? _selectedProvider;
    private IReadOnlyList<string>? _availableProviders;
    private string? _errorMessage;
    private bool _authSuccess;
    private string _univiewUsername = "";
    private string _univiewPassword = "";

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbItems = new() { (L["BreadcrumbAccounts"], "/accounts"), (L["AddAccount"], null) };
        try
        {
            _availableProviders = await MultiProviderAuthService.GetAvailableProvidersAsync();
            _selectedProvider = _availableProviders?.FirstOrDefault();
        }
        catch (Exception ex)
        {
            _errorMessage = L["FailedToLoadProviders", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task AuthenticateUniviewAsync()
    {
        _errorMessage = null;
        _isBusy = true;
        try
        {
            var authService = MultiProviderAuthService.GetService("Uniview");
            var result = await authService.AuthenticateAsync(_univiewUsername, _univiewPassword, CancellationToken.None);

            if (result.Success)
            {
                if (result.ProviderAccountId.HasValue && ForensicsConfig.ActiveProviderAccountId != result.ProviderAccountId)
                {
                    ForensicsConfig.ActiveProviderAccountId = result.ProviderAccountId;
                    await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);
                }

                _authSuccess = true;
                _currentStep = 3;
                _univiewUsername = "";
                _univiewPassword = "";
            }
            else
            {
                _authSuccess = false;
                _errorMessage = result.ErrorMessage ?? L["AuthenticationFailed"].Value;
                _currentStep = 3;
            }
        }
        catch (Exception ex)
        {
            _authSuccess = false;
            _errorMessage = L["AuthenticationFailedWithReason", ex.Message];
            _currentStep = 3;
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleAuthenticationAsync(AuthResult result)
    {
        if (result.Success)
        {
            _authSuccess = true;
            _errorMessage = null;
            _currentStep = 3;
        }
        else
        {
            _authSuccess = false;
            _errorMessage = result.ErrorMessage ?? L["AuthenticationFailed"].Value;
            _currentStep = 3;
        }
        await Task.CompletedTask;
    }

}
