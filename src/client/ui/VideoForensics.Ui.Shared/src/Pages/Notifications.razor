@page "/settings/notifications"
@using VideoForensics.Client.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Layout
@using VideoForensics.Client.Ui.Shared.Layout.RightPanel
@using VideoForensics.Core.Api.Contracts
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject IStringLocalizer<Notifications> L
@inject WebPushClient WebPushClient

<h4 class="mb-4">@L["Title"]</h4>

@if (!SessionState.IsSignedIn)
{
    <div class="alert alert-info mb-4">
        <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignInWithPasskey"]</a> @L["ToManageNotifications"]
    </div>
}

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_authError is not null)
{
    <div class="alert alert-danger mb-2">@_authError</div>
    <p>
        @L["NotAuthorized"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignInWithPasskey"]</a> @L["SignInRequired"]
    </p>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else if (_noAccess)
{
    <div class="alert alert-info">@L["NoAccessNote"]</div>
}
else
{
    <h6 class="mt-4 mb-2">@L["UrgentEventOverrides"]</h6>
    <div class="card border p-4 mb-4">
        <p class="mb-2">
            @L["UrgencyDescription"]
        </p>
        @if (_urgencyRows.Count == 0)
        {
            <p>@L["NoEventTypes"]</p>
        }
        else
        {
            <SfGrid TValue="UrgencyRow" DataSource="@_filteredUrgencyRows" AllowSorting="true" AllowPaging="true" AllowFiltering="true" AllowResizing="true">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(UrgencyRow.EventType)" HeaderText="@L["ColEventType"]" MinWidth="100" />
                    <GridColumn HeaderText="@L["ColDefault"]" AllowSorting="false" AllowFiltering="false" MinWidth="100">
                        <Template>
                            @{
                                var row = (UrgencyRow)context;
                                @(row.DefaultUrgent ? L["Urgent"] : L["Routine"])
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="@L["ColEffective"]" AllowSorting="false" AllowFiltering="false" MinWidth="100">
                        <Template>
                            @{
                                var row = (UrgencyRow)context;
                                <label><SfCheckBox TChecked="bool" Checked="@row.EffectiveUrgent" CheckedChanged="@(v => SetOverrideAsync(row.EventType, v))" /> @(row.EffectiveUrgent ? L["Urgent"] : L["Routine"])</label>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="" AllowSorting="false" AllowFiltering="false" MinWidth="100">
                        <Template>
                            @{
                                var row = (UrgencyRow)context;
                                @if (row.OverrideUrgent is not null)
                                {
                                    <SfButton Content="@L["ResetToDefault"]" OnClick="@(() => ClearOverrideAsync(row.EventType))" CssClass="e-flat" />
                                }
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        }
        @if (_settingsMessage is not null)
        {
            <span style="color: @(_settingsSuccess ? "#4caf50" : "#f44336")">@_settingsMessage</span>
        }
    </div>

    <h6 class="mt-4 mb-2">@L["PushNotifications"]</h6>
    <div class="card border p-4 mb-4">
        <div class="d-flex flex-column gap-2">
            <p>
                @L["PushNotificationsDescription"]
            </p>

            <div class="d-flex flex-row gap-2 mb-3">
                <div style="flex: 1;">
                    <label>@L["MinimumSeverity"]</label>
                    <SfDropDownList TValue="string" TItem="KeyValuePair<string,string>" @bind-Value="_minimumSeverity" DataSource="@_severityOptions" Enabled="@(_pushEnabled && !_isCheckingPush)" Style="max-width: 200px;">
                        <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
                    </SfDropDownList>
                </div>
                <div>
                    <label>&nbsp;</label>
                    <label><SfCheckBox TChecked="bool" Checked="@_pushEnabled" CheckedChanged="@((v) => { _pushEnabled = v; _pushPrefsDirty = true; })" /> @L["EnablePushNotifications"]</label>
                </div>
            </div>

            <div class="d-flex flex-row gap-2 mb-3">
                <SfButton Content="@(_isCheckingPush ? L["CheckingConfigButton"] : L["CheckConfigButton"])" OnClick="CheckConfigurationAsync" CssClass="e-flat" Disabled="@_isCheckingPush" />
                <div style="flex: 1; display: flex; align-items: center;">
                    <span style="padding: 6px 12px; border-radius: 4px; @GetStatusStyle()">@GetStatusDisplay()</span>
                </div>
            </div>

            @if (_pushStatus == "Active")
            {
                <SfButton Content="@(_isDisabling ? L["DisablingPushButton"] : L["DisablePushButton"])" OnClick="DisablePushAsync" CssClass="e-danger" Disabled="@_isDisabling" />
            }
            else if (_pushStatus == "NotEnabled")
            {
                <SfButton Content="@(_isEnabling ? L["EnablingPushButton"] : L["EnablePushButton"])" OnClick="EnablePushAsync" CssClass="e-primary" Disabled="@_isEnabling" />
            }
            else if (_pushStatus == "Blocked")
            {
                <div class="alert alert-warning mb-0">
                    @L["PushBlockedMessage"]
                </div>
            }

            @if (_pushMessage is not null)
            {
                <span style="color: @(_pushSuccess ? "#4caf50" : "#f44336")">@_pushMessage</span>
            }

            <SfButton Content="@(_isSavingPushPrefs ? L["SavingButton"] : L["SaveButton"])" OnClick="SavePushPreferencesAsync" CssClass="e-primary" Disabled="@(_isSavingPushPrefs || !_pushPrefsDirty)" />
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private string? _authError;
    private string? _loadError;
    private bool _noAccess;
    private string? _settingsMessage;
    private bool _settingsSuccess;

    private record UrgencyRow(string EventType, bool DefaultUrgent, bool? OverrideUrgent, bool EffectiveUrgent);
    private List<UrgencyRow> _urgencyRows = new();
    private IEnumerable<UrgencyRow> _filteredUrgencyRows = new List<UrgencyRow>();

    // Push notifications state
    private string _pushStatus = "Unknown"; // "NotSupported", "Blocked", "NotEnabled", "Active", "Unknown"
    private bool _pushEnabled;
    private string _minimumSeverity = "1"; // Default to Warning (1)
    private bool _isCheckingPush;
    private bool _isEnabling;
    private bool _isDisabling;
    private bool _isSavingPushPrefs;
    private string? _pushMessage;
    private bool _pushSuccess;
    private bool _pushPrefsDirty;

    private List<KeyValuePair<string, string>> _severityOptions => new()
    {
        new("0", L["SeverityInfo"].Value),
        new("1", L["SeverityWarning"].Value),
        new("2", L["SeverityAlert"].Value),
        new("3", L["SeverityCritical"].Value),
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass - see the identical note
        // on SecurityDevices.razor.
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        _noAccess = false;
        try
        {
            var client = CreateClient();

            // Admins only reach the controls when a Super Admin has opened notification settings to them.
            var permissions = await client.GetFromJsonAsync<NotificationPermissionsDto>("api/v1/permissions/notifications");
            _noAccess = !NotificationSettingsGate.CanChange(permissions?.NotificationSettingsAccess, NavContext.FromSession(SessionState, appLockSupported: false));
            if (_noAccess)
            {
                return;
            }

            var overridesResponse = await client.GetAsync("api/notifications/urgency-overrides");
            if (overridesResponse.IsSuccessStatusCode)
            {
                var rows = await overridesResponse.Content.ReadFromJsonAsync<List<System.Text.Json.JsonElement>>();
                _urgencyRows = (rows ?? new()).Select(r => new UrgencyRow(
                    r.GetProperty("eventType").GetString()!,
                    r.GetProperty("defaultUrgent").GetBoolean(),
                    r.GetProperty("overrideUrgent").ValueKind == System.Text.Json.JsonValueKind.Null ? null : r.GetProperty("overrideUrgent").GetBoolean(),
                    r.GetProperty("effectiveUrgent").GetBoolean()
                )).ToList();
                _filteredUrgencyRows = _urgencyRows;
            }
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToLoadSettings", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SetOverrideAsync(string eventType, bool isUrgent)
    {
        try
        {
            var client = CreateClient();
            await client.PostAsJsonAsync("api/notifications/urgency-overrides/set", new { eventType, isUrgent });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _settingsSuccess = false;
            _settingsMessage = L["FailedToUpdateOverride", ex.Message];
        }
    }

    private async Task ClearOverrideAsync(string eventType)
    {
        try
        {
            var client = CreateClient();
            await client.PostAsJsonAsync("api/notifications/urgency-overrides/clear", new { eventType });
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _settingsSuccess = false;
            _settingsMessage = L["FailedToClearOverride", ex.Message];
        }
    }

    private static async Task<string?> SafeReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var doc = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            return doc is not null && doc.TryGetValue("error", out var msg) ? msg : null;
        }
        catch
        {
            return null;
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }

    private async Task CheckConfigurationAsync()
    {
        _isCheckingPush = true;
        _pushMessage = null;
        try
        {
            bool isSupported = await WebPushClient.IsSupportedAsync();
            if (!isSupported)
            {
                _pushStatus = "NotSupported";
                return;
            }

            string permission = await WebPushClient.GetPermissionStateAsync();
            if (permission == "denied")
            {
                _pushStatus = "Blocked";
                return;
            }

            string? endpoint = await WebPushClient.GetCurrentSubscriptionEndpointAsync();
            _pushStatus = endpoint != null ? "Active" : "NotEnabled";
        }
        catch (Exception ex)
        {
            _pushSuccess = false;
            _pushMessage = L["CheckConfigFailed", ex.Message];
        }
        finally
        {
            _isCheckingPush = false;
        }
    }

    private async Task EnablePushAsync()
    {
        _isEnabling = true;
        _pushMessage = null;
        try
        {
            var client = CreateClient();
            var keyResponse = await client.GetAsync("api/v1/push/vapid-public-key");
            if (!keyResponse.IsSuccessStatusCode)
            {
                _pushSuccess = false;
                _pushMessage = L["GetVapidKeyFailed", keyResponse.StatusCode.ToString()];
                return;
            }

            var keyBody = await keyResponse.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
            string publicKey = keyBody.GetProperty("publicKey").GetString() ?? "";

            var (endpoint, p256dhKey, authKey) = await WebPushClient.SubscribeAsync(publicKey);

            var subscribeResponse = await client.PostAsJsonAsync("api/v1/push/subscribe", new
            {
                endpoint,
                p256dhKey,
                authKey
            });

            if (!subscribeResponse.IsSuccessStatusCode)
            {
                _pushSuccess = false;
                _pushMessage = L["SubscribeFailed", subscribeResponse.StatusCode.ToString()];
                return;
            }

            _pushSuccess = true;
            _pushMessage = L["PushEnabled"];
            _pushEnabled = true;
            _pushPrefsDirty = true;
            await CheckConfigurationAsync();
        }
        catch (Exception ex)
        {
            _pushSuccess = false;
            _pushMessage = L["EnablePushFailed", ex.Message];
        }
        finally
        {
            _isEnabling = false;
        }
    }

    private async Task DisablePushAsync()
    {
        _isDisabling = true;
        _pushMessage = null;
        try
        {
            string? endpoint = await WebPushClient.UnsubscribeAsync();
            if (endpoint == null)
            {
                _pushSuccess = false;
                _pushMessage = L["NoActiveSubscription"];
                return;
            }

            var client = CreateClient();
            var response = await client.PostAsJsonAsync("api/v1/push/unsubscribe", new { endpoint });

            if (!response.IsSuccessStatusCode)
            {
                _pushSuccess = false;
                _pushMessage = L["UnsubscribeFailed", response.StatusCode.ToString()];
                return;
            }

            _pushSuccess = true;
            _pushMessage = L["PushDisabled"];
            _pushEnabled = false;
            _pushPrefsDirty = true;
            await CheckConfigurationAsync();
        }
        catch (Exception ex)
        {
            _pushSuccess = false;
            _pushMessage = L["DisablePushFailed", ex.Message];
        }
        finally
        {
            _isDisabling = false;
        }
    }

    private async Task SavePushPreferencesAsync()
    {
        _isSavingPushPrefs = true;
        _pushMessage = null;
        try
        {
            var client = CreateClient();
            var response = await client.PostAsJsonAsync("api/v1/push/preferences", new
            {
                pushEnabled = _pushEnabled,
                minimumSeverity = int.Parse(_minimumSeverity)
            });

            if (!response.IsSuccessStatusCode)
            {
                _pushSuccess = false;
                _pushMessage = L["SavePreferencesFailed", response.StatusCode.ToString()];
                return;
            }

            _pushSuccess = true;
            _pushMessage = L["PreferencesSaved"];
            _pushPrefsDirty = false;
        }
        catch (Exception ex)
        {
            _pushSuccess = false;
            _pushMessage = L["SavePreferencesFailed", ex.Message];
        }
        finally
        {
            _isSavingPushPrefs = false;
        }
    }

    private string GetStatusDisplay() => _pushStatus switch
    {
        "NotSupported" => L["PushNotSupported"],
        "Blocked" => L["PushBlocked"],
        "NotEnabled" => L["PushNotEnabled"],
        "Active" => L["PushActive"],
        _ => L["CheckingStatus"]
    };

    private string GetStatusStyle() => _pushStatus switch
    {
        "Active" => "background-color: #e8f5e9; color: #2e7d32; border: 1px solid #81c784;",
        "Blocked" => "background-color: #ffebee; color: #c62828; border: 1px solid #ef5350;",
        "NotSupported" => "background-color: #f5f5f5; color: #616161; border: 1px solid #bdbdbd;",
        "NotEnabled" => "background-color: #fff3e0; color: #e65100; border: 1px solid #ffb74d;",
        _ => "background-color: #f5f5f5; color: #616161; border: 1px solid #bdbdbd;"
    };
}
