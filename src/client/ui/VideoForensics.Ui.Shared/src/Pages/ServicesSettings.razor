@page "/settings/services"
@using VideoForensics.Client.Core.Tools
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Layout
@using VideoForensics.Client.Ui.Shared.Services
@inject PairedSessionState SessionState
@inject IForensicsConfiguration Config
@inject VideoForensics.Client.Core.Contracts.IConfigToolsOrchestrator ConfigTools
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ServicesSettings> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-info">
        @L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToChangeSettings"]
    </div>
}
else
{
    <h6 class="mt-4 mb-2">@L["HealthSyncSection"]</h6>
    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-column gap-2">
            <small class="text-body-secondary">@L["HealthSyncDescription"]</small>
            <SfCheckBox TChecked="bool" @bind-Checked="@Config.EnableHealthSync" @bind-Checked:after="@(async () => await SaveHealthSyncAsync(Config.EnableHealthSync))" Label="@L["EnableHealthSync"].Value" />
            @if (_healthSyncMessage is not null)
            {
                <span style="@(_healthSyncSuccess ? "color: green;" : "color: red;")">@_healthSyncMessage</span>
            }
        </div>
    </div>

    <h6 class="mt-4 mb-2">@L["ScheduledServicesSection"]</h6>
    <p class="text-body-secondary">@L["ScheduledServicesDescription"]</p>

    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-column gap-3">
            <div>
                <SfCheckBox TChecked="bool" @bind-Checked="@Config.EnableScheduledReports" @bind-Checked:after="@(async () => await SaveReportGenerationAsync(Config.EnableScheduledReports))" Label="@L["ReportGenerationLabel"].Value" />
                <small class="d-block text-body-secondary">@L["ReportGenerationDescription"]</small>
            </div>
            <div>
                <label class="form-label fw-semibold" for="report-interval">@L["ReportIntervalLabel"]</label>
                <small class="d-block text-body-secondary mb-2">@L["ReportIntervalHelp"]</small>
                <div class="d-flex flex-row gap-2 align-items-center">
                    <input id="report-interval" type="number" class="form-control" style="max-width: 160px;" min="1" max="168" @bind="_reportInterval" />
                    <button type="button" class="btn btn-primary" @onclick="SaveReportIntervalAsync">@L["SaveButton"]</button>
                </div>
            </div>
            @if (_reportMessage is not null)
            {
                <span style="@(_reportSuccess ? "color: green;" : "color: red;")">@_reportMessage</span>
            }
        </div>
    </div>

    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-column gap-3">
            <div>
                <label class="form-label fw-semibold" for="prune-interval">@L["LogPruneLabel"]</label>
                <small class="d-block text-body-secondary mb-2">@L["IntervalHelp"]</small>
                <div class="d-flex flex-row gap-2 align-items-center">
                    <input id="prune-interval" type="number" class="form-control" style="max-width: 160px;" min="1" max="168" @bind="_pruneInterval" />
                    <button type="button" class="btn btn-primary" @onclick="SavePruneIntervalAsync">@L["SaveButton"]</button>
                </div>
            </div>
            <div>
                <label class="form-label fw-semibold" for="update-interval">@L["UpdateCheckLabel"]</label>
                <small class="d-block text-body-secondary mb-2">@L["UpdateCheckHelp"]</small>
                <div class="d-flex flex-row gap-2 align-items-center">
                    <input id="update-interval" type="number" class="form-control" style="max-width: 160px;" min="1" max="168" @bind="_updateInterval" />
                    <button type="button" class="btn btn-primary" @onclick="SaveUpdateIntervalAsync">@L["SaveButton"]</button>
                </div>
            </div>
            <div>
                <label class="form-label fw-semibold" for="backfill-interval">@L["MediaBackfillLabel"]</label>
                <small class="d-block text-body-secondary mb-2">@L["IntervalHelp"]</small>
                <div class="d-flex flex-row gap-2 align-items-center">
                    <input id="backfill-interval" type="number" class="form-control" style="max-width: 160px;" min="1" max="168" @bind="_backfillInterval" />
                    <button type="button" class="btn btn-primary" @onclick="SaveBackfillIntervalAsync">@L["SaveButton"]</button>
                </div>
            </div>
            <small class="text-body-secondary">@L["FixedBackfillNote"]</small>
            @if (_intervalMessage is not null)
            {
                <span style="@(_intervalSuccess ? "color: green;" : "color: red;")">@_intervalMessage</span>
            }
        </div>
    </div>

    <div class="card p-4 mb-4">
        <div class="card-body d-flex flex-column gap-3">
            <div>
                <label class="form-label fw-semibold" for="timelapse-check">@L["TimelapseCheckIntervalLabel"]</label>
                <small class="d-block text-body-secondary mb-2">@L["TimelapseCheckIntervalHelp"]</small>
                <div class="d-flex flex-row gap-2 align-items-center">
                    <input id="timelapse-check" type="number" class="form-control" style="max-width: 160px;" min="1" max="1440" @bind="_timelapseCheckMinutes" />
                    <button type="button" class="btn btn-primary" @onclick="SaveTimelapseCheckAsync">@L["SaveButton"]</button>
                </div>
            </div>
            <div>
                <label class="form-label fw-semibold" for="timelapse-max-segment">@L["TimelapseMaxSegmentLabel"]</label>
                <small class="d-block text-body-secondary mb-2">@L["TimelapseMaxSegmentHelp"]</small>
                <div class="d-flex flex-row gap-2 align-items-center">
                    <input id="timelapse-max-segment" type="number" class="form-control" style="max-width: 160px;" min="1" max="1440" @bind="_timelapseMaxSegmentMinutes" />
                    <button type="button" class="btn btn-primary" @onclick="SaveTimelapseMaxSegmentAsync">@L["SaveButton"]</button>
                </div>
            </div>
            @if (_timelapseMessage is not null)
            {
                <span style="@(_timelapseSuccess ? "color: green;" : "color: red;")">@_timelapseMessage</span>
            }
        </div>
    </div>
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;

    private bool _healthSyncSuccess;
    private string? _healthSyncMessage;

    private bool _reportSuccess;
    private string? _reportMessage;

    private bool _intervalSuccess;
    private string? _intervalMessage;

    private int _reportInterval;
    private int _pruneInterval;
    private int _updateInterval;
    private int _backfillInterval;

    private bool _timelapseSuccess;
    private string? _timelapseMessage;

    private int _timelapseCheckMinutes;
    private int _timelapseMaxSegmentMinutes;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await SessionState.EnsureLoadedAsync();
            _isAuthenticated = SessionState.IsSignedIn;
            ResetIntervalInputs();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SaveHealthSyncAsync(bool enabled)
    {
        try
        {
            Config.EnableHealthSync = enabled;
            (bool applied, string message) = await ConfigTools.SetHealthSyncAsync(Config, enabled, CancellationToken.None);
            if (!applied)
            {
                Config.EnableHealthSync = !enabled;
                _healthSyncSuccess = false;
                _healthSyncMessage = message;
                return;
            }

            _healthSyncSuccess = true;
            _healthSyncMessage = L["HealthSyncStatus", enabled ? L["EnabledWord"].Value : L["DisabledWord"].Value].Value;
        }
        catch (NotSupportedException)
        {
            _healthSyncSuccess = false;
            _healthSyncMessage = L["ConfigurationNotSupported"].Value;
        }
        catch (Exception ex)
        {
            _healthSyncSuccess = false;
            _healthSyncMessage = L["HealthSyncError", ex.Message].Value;
        }
    }

    private async Task SaveReportGenerationAsync(bool enabled)
    {
        try
        {
            (bool applied, string message) = await ConfigTools.SetScheduledReportsEnabledAsync(Config, enabled, CancellationToken.None);
            if (!applied)
            {
                Config.EnableScheduledReports = !enabled;
                _reportSuccess = false;
                _reportMessage = message;
                return;
            }

            _reportSuccess = true;
            _reportMessage = L["ReportGenerationStatus", enabled ? L["EnabledWord"].Value : L["DisabledWord"].Value].Value;
        }
        catch (Exception ex)
        {
            _reportSuccess = false;
            _reportMessage = L["ReportGenerationError", ex.Message].Value;
        }
    }

    private async Task SaveIntervalAsync(string service, int hours)
    {
        try
        {
            (bool applied, string message) = await ConfigTools.SetServiceIntervalHoursAsync(Config, service, hours, CancellationToken.None);
            _intervalSuccess = applied;
            _intervalMessage = message;
            if (!applied)
            {
                ResetIntervalInputs();
            }
        }
        catch (Exception ex)
        {
            _intervalSuccess = false;
            _intervalMessage = L["IntervalError", ex.Message].Value;
        }
    }

    private Task SavePruneIntervalAsync() => SaveIntervalAsync("LogPrune", _pruneInterval);

    private Task SaveUpdateIntervalAsync() => SaveIntervalAsync("UpdateCheck", _updateInterval);

    private Task SaveBackfillIntervalAsync() => SaveIntervalAsync("MediaBackfill", _backfillInterval);

    private async Task SaveReportIntervalAsync()
    {
        try
        {
            (bool applied, string message) = await ConfigTools.SetScheduledReportIntervalHoursAsync(Config, _reportInterval, CancellationToken.None);
            _reportSuccess = applied;
            _reportMessage = message;
            if (!applied)
            {
                ResetIntervalInputs();
            }
        }
        catch (Exception ex)
        {
            _reportSuccess = false;
            _reportMessage = L["IntervalError", ex.Message].Value;
        }
    }

    private async Task SaveTimelapseCheckAsync()
    {
        try
        {
            (bool applied, _) = await ConfigTools.SetTimelapseCheckIntervalMinutesAsync(Config, _timelapseCheckMinutes, CancellationToken.None);
            _timelapseSuccess = applied;
            _timelapseMessage = applied ? L["TimelapseCheckSaved", _timelapseCheckMinutes].Value : L["TimelapseRangeError"].Value;
            if (!applied)
            {
                ResetIntervalInputs();
            }
        }
        catch (Exception ex)
        {
            _timelapseSuccess = false;
            _timelapseMessage = L["IntervalError", ex.Message].Value;
        }
    }

    private async Task SaveTimelapseMaxSegmentAsync()
    {
        try
        {
            (bool applied, _) = await ConfigTools.SetTimelapseMaxSegmentMinutesAsync(Config, _timelapseMaxSegmentMinutes, CancellationToken.None);
            _timelapseSuccess = applied;
            _timelapseMessage = applied ? L["TimelapseMaxSegmentSaved", _timelapseMaxSegmentMinutes].Value : L["TimelapseRangeError"].Value;
            if (!applied)
            {
                ResetIntervalInputs();
            }
        }
        catch (Exception ex)
        {
            _timelapseSuccess = false;
            _timelapseMessage = L["IntervalError", ex.Message].Value;
        }
    }

    private void ResetIntervalInputs()
    {
        _reportInterval = Config.ScheduledReportIntervalHours;
        _pruneInterval = Config.LogPruneIntervalHours;
        _updateInterval = Config.UpdateCheckIntervalHours;
        _backfillInterval = Config.MediaBackfillIntervalHours;
        _timelapseCheckMinutes = Config.TimelapseCheckIntervalMinutes;
        _timelapseMaxSegmentMinutes = Config.TimelapseMaxSegmentMinutes;
    }
}
