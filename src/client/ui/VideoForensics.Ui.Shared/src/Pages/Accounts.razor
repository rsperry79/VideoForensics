@page "/accounts"
@using Microsoft.Extensions.Localization
@using VideoForensics.Core.Providers.Common.Contracts
@using VideoForensics.Ui.Shared.Layout.RightPanel
@inject IProviderAccountRepository ProviderAccountRepository
@inject IUserRepository UserRepository
@inject IStringLocalizer<Accounts> L
@inject NavigationManager NavigationManager

<h4 class="mb-4">@L["Title"]</h4>

<PageRightPanelContent>
    <div class="right-panel-section">
        <small style="font-weight: bold;">@L["FilterProviders"]</small>
        <SfMultiSelect TValue="string[]" TItem="string" DataSource="@_providerNames"
            Value="@_selectedProviders" ValueChanged="OnProvidersChanged"
            Mode="Syncfusion.Blazor.DropDowns.VisualMode.CheckBox" Placeholder="@L["FilterProviders"]">
        </SfMultiSelect>
    </div>
</PageRightPanelContent>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <p>@_statusMessage</p>
    }

    @if (_rows.Count == 0)
    {
        <p>@L["NoAccountsLinked"]</p>
    }
    else
    {
        <SfGrid TValue="AccountRow" DataSource="@_filteredRows" AllowSorting="true" AllowPaging="true" AllowFiltering="true" AllowResizing="true" AutoFit="true">
            <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
            <GridPageSettings PageSize="20"></GridPageSettings>
            <GridColumns>
                <GridColumn Field="DisplayName" HeaderText="@L["ColDisplayName"]">
                    <Template>
                        @{
                            var row = (AccountRow)context;
                            @if (!string.IsNullOrEmpty(row.Account.LastErrorMessage))
                            {
                                <i class="material-icons" style="color: #d32f2f; cursor: help; vertical-align: middle;" title="@($"{row.Account.LastErrorMessage}\n(as of {row.Account.LastErrorUtc?.ToString() ?? L["UnknownTime"]})")">error</i>
                            }
                            <span>@row.DisplayName</span>
                        }
                    </Template>
                </GridColumn>
                <GridColumn Field="Account.ProviderName" HeaderText="@L["ColProvider"]" />
                <GridColumn Field="Account.LinkedUtc" HeaderText="@L["ColLinked"]" />
                <GridColumn HeaderText="@L["ColLastAuth"]">
                    <Template>
                        @{
                            var row = (AccountRow)context;
                            @(row.Account.LastSuccessfulAuthUtc?.ToString() ?? "-")
                        }
                    </Template>
                </GridColumn>
                <GridColumn HeaderText="" AllowSorting="false" AllowFiltering="false">
                    <Template>
                        @{
                            var row = (AccountRow)context;
                            <SfButton Content="@L["Details"]" OnClick="@((UIMouseEventArgs) => GoToAccountDetailsAsync(row.Account.Id))" CssClass="e-info" />
                        }
                    </Template>
                </GridColumn>
            </GridColumns>
        </SfGrid>
    }
}

<div class="mt-4">
    <SfButton CssClass="e-primary" Content="@L["AddAccount"]" OnClick="GoToAddAccount" />
</div>

@code {
    private sealed record AccountRow(VideoForensics.Data.Common.Entities.ProviderAccount Account, string DisplayName);

    private List<AccountRow> _rows = new();
    private List<string> _providerNames = new();
    private string[] _selectedProviders = Array.Empty<string>();
    private IEnumerable<AccountRow> _filteredRows = new List<AccountRow>();
    private bool _isLoading = true;
    private string? _statusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadAccountsAsync();
    }

    private async Task LoadAccountsAsync()
    {
        _isLoading = true;
        try
        {
            var accounts = await ProviderAccountRepository.ListAsync(CancellationToken.None);
            var rows = new List<AccountRow>();
            foreach (var account in accounts)
            {
                string displayName = account.ProviderName;
                try
                {
                    var user = await UserRepository.GetAsync(account.UserId, CancellationToken.None);
                    if (user is not null)
                    {
                        displayName = user.DisplayName;
                    }
                }
                catch
                {
                    // Fall back to ProviderName if user lookup fails for any reason.
                }

                rows.Add(new AccountRow(account, displayName));
            }

            _rows = rows;
            _providerNames = rows.Select(r => r.Account.ProviderName).Distinct().OrderBy(n => n).ToList();
            // Every provider is selected by default so the grid starts with all accounts visible.
            _selectedProviders = _providerNames.ToArray();
            ApplyProviderFilter();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnProvidersChanged(string[] selected)
    {
        _selectedProviders = selected ?? Array.Empty<string>();
        ApplyProviderFilter();
    }

    private void ApplyProviderFilter()
    {
        var selected = new HashSet<string>(_selectedProviders, StringComparer.OrdinalIgnoreCase);
        _filteredRows = _rows.Where(r => selected.Contains(r.Account.ProviderName)).ToList();
    }

    private void GoToAddAccount()
    {
        NavigationManager.NavigateTo("/accounts/add");
    }

    private void GoToAccountDetailsAsync(Guid accountId)
    {
        NavigationManager.NavigateTo($"/accounts/{accountId}");
    }
}
