@page "/signal-history"
@implements IAsyncDisposable
@using System.Globalization
@using System.Net
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.Extensions.Localization
@using Microsoft.JSInterop
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Services.DeviceSettings
@using VideoForensics.Client.Ui.Shared.Services.Scope
@using VideoForensics.Client.Ui.Shared.Services.Signal
@using VideoForensics.Data.Common.Contracts
@using Device = VideoForensics.Data.Common.Entities.Device
@using DeviceHealth = VideoForensics.Data.Common.Entities.DeviceHealth
@inject IDeviceRepository DeviceRepository
@inject IDeviceHealthRepository DeviceHealthRepository
@inject ScopeState ScopeState
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject IStringLocalizer<SignalHistory> L

<h4 class="mb-2">@L["PageTitle"]</h4>
<p class="text-muted small">@L["PageIntro"]</p>
<p class="small mb-3" data-testid="signal-scope-summary">@L["ScopeHint", _sections.Count, _from.ToShortDateString(), _to.ToShortDateString()]</p>

@if (_sections.Count == 0)
{
    <p class="text-muted">@L["NoDevicesInScope"]</p>
}

@foreach (DeviceSignal section in _sections)
{
    <div class="card mb-3" data-testid="signal-device">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
            <strong>@DeviceName(section.Device)</strong>
            @if (RingSettingsRoute.IsRingDevice(section.Device))
            {
                <a href="@RingSettingsRoute.Href(section.Device.Id)">@L["DeviceSettings"]</a>
            }
        </div>
        <div class="card-body">
            @if (section.AllTime.Count == 0)
            {
                <p class="text-muted mb-0">@L["NoReadings"]</p>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-lg-4">
                        <table class="table table-sm mb-0">
                            <tbody>
                                <tr><th>@L["StatCount"]</th><td>@section.AllTime.Count</td></tr>
                                <tr><th>@L["StatLatest"]</th><td>@section.AllTime.Latest dBm</td></tr>
                                <tr><th>@L["StatMin"]</th><td>@section.AllTime.Min dBm</td></tr>
                                <tr><th>@L["StatMax"]</th><td>@section.AllTime.Max dBm</td></tr>
                                <tr><th>@L["StatAverage"]</th><td>@section.AllTime.Average.ToString("0.0") dBm</td></tr>
                                <tr><th>@L["StatPercentWeak"]</th><td>@section.AllTime.PercentWeak.ToString("0") %</td></tr>
                            </tbody>
                        </table>
                    </div>
                    <div class="col-lg-8">
                        <p class="small text-muted mb-1">@L["TimelineLabel"]</p>
                        @if (section.InRangeCount == 0)
                        {
                            <p class="small text-muted mb-1" data-testid="signal-no-range">@L["NoReadingsInRange"]</p>
                        }
                        <svg id="@PlotId(section.Device.Id)"
                             viewBox="0 0 @SignalChartModel.ViewWidth @SignalChartModel.ViewHeight"
                             width="100%"
                             role="img"
                             aria-label="@L["TimelineLabel"]"
                             class="signal-chart"
                             style="user-select: none; border: 1px solid var(--bs-border-color);"
                             @onmousedown="e => BeginSelectionAsync(section, e)"
                             @onmousemove="e => MoveSelectionAsync(section, e)"
                             @onmouseup="() => EndSelection(section)"
                             @onmouseleave="() => EndSelection(section)"
                             @oncontextmenu="e => OpenMenu(section, e)"
                             @oncontextmenu:preventDefault="true">
                            @* y-axis: dBm gridlines and labels *@
                            @foreach (int dbm in SignalChartModel.DbmTicks)
                            {
                                double y = SignalChartModel.MapDbm(dbm);
                                <line x1="@SignalChartModel.PlotLeft" x2="@(SignalChartModel.PlotLeft + SignalChartModel.PlotWidth)" y1="@y" y2="@y" style="stroke: var(--bs-border-color);" stroke-dasharray="2 4" />
                                @SvgText(SignalChartModel.PlotLeft - 6, y, "end", "currentColor", dbm.ToString(CultureInfo.InvariantCulture), dominantBaseline: "middle")
                            }
                            @SvgText(6, SignalChartModel.PlotTop + 10, "start", "currentColor", L["AxisDbm"])

                            @* x-axis: evenly spaced time labels across the visible window *@
                            <line x1="@SignalChartModel.PlotLeft" x2="@(SignalChartModel.PlotLeft + SignalChartModel.PlotWidth)" y1="@(SignalChartModel.PlotTop + SignalChartModel.PlotHeight)" y2="@(SignalChartModel.PlotTop + SignalChartModel.PlotHeight)" style="stroke: var(--bs-border-color);" />
                            @foreach (DateTime tick in SignalChartModel.TimeTicks(_from, _to, 5))
                            {
                                @SvgText(SignalChartModel.MapX(tick, _from, _to), SignalChartModel.PlotTop + SignalChartModel.PlotHeight + 16, "middle", "currentColor", SignalChartModel.FormatTick(tick, _to - _from))
                            }

                            <polyline points="@section.Points" fill="none" stroke="currentColor" stroke-width="2" />

                            @* All-time reference bars: average, strongest and weakest, drawn across the whole plot. *@
                            @{
                                double averageY = SignalChartModel.MapDbm(section.AllTime.Average);
                                @ReferenceBar(averageY, "var(--bs-primary)", 2, "6 4", $"{L["AllTimeAverage"]} {section.AllTime.Average.ToString("0.0", CultureInfo.InvariantCulture)}")
                            }
                            @if (section.AllTime.Max is int strongest)
                            {
                                @ReferenceBar(SignalChartModel.MapDbm(strongest), "var(--bs-success)", 3, null, $"{L["AllTimeStrongest"]} {strongest}")
                            }
                            @if (section.AllTime.Min is int weakest)
                            {
                                @ReferenceBar(SignalChartModel.MapDbm(weakest), "var(--bs-danger)", 3, null, $"{L["AllTimeWeakest"]} {weakest}")
                            }

                            @if (SelectionRangeFor(section) is { } selected)
                            {
                                double left = SignalChartModel.MapX(selected.start, _from, _to);
                                double right = SignalChartModel.MapX(selected.end, _from, _to);
                                <rect class="signal-selection" x="@left" y="@SignalChartModel.PlotTop" width="@(right - left)" height="@SignalChartModel.PlotHeight" style="fill: var(--bs-primary); opacity: 0.15;" />
                            }
                        </svg>
                        <p class="small text-muted mb-0 mt-1">@L["SelectionHint"]</p>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (_menuDeviceId is Guid)
{
    <div class="card shadow position-fixed" style="left: @(_menuX)px; top: @(_menuY)px; z-index: 1050; min-width: 200px;" data-testid="signal-menu">
        <div class="list-group list-group-flush">
            @if (_menuRange is null)
            {
                <div class="list-group-item small text-muted">@L["NoSelection"]</div>
            }
            else
            {
                <button type="button" class="list-group-item list-group-item-action" data-testid="signal-drill-down" @onclick="DrillDown">@L["DrillDown"]</button>
                <button type="button" class="list-group-item list-group-item-action" data-testid="signal-create-case" @onclick="CreateCase">@L["CreateCase"]</button>
            }
            <button type="button" class="list-group-item list-group-item-action small" @onclick="CloseMenu">@L["CloseMenu"]</button>
        </div>
    </div>
}

@code {
    private sealed class DeviceSignal
    {
        public required Device Device { get; init; }
        public required SignalStats AllTime { get; init; }
        public required string Points { get; init; }
        public required int InRangeCount { get; init; }
        public double? SelectionStart { get; set; }
        public double? SelectionEnd { get; set; }
        public bool Dragging { get; set; }
    }

    /// <summary>The offset of a pointer on the chart, and the chart's rendered width, both in CSS pixels.</summary>
    private sealed record PlotPointer(double Offset, double Width);

    private List<DeviceSignal> _sections = new();
    private DateTime _from;
    private DateTime _to;
    private IJSObjectReference? _module;
    private Guid? _menuDeviceId;
    private double _menuX;
    private double _menuY;
    private (DateTime start, DateTime end)? _menuRange;

    protected override async Task OnInitializedAsync()
    {
        ScopeState.OnChange += OnScopeChanged;
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./_content/VideoForensics.Client.Ui.Shared/scripts/signal-chart.js");
        }
    }

    private async void OnScopeChanged()
    {
        await InvokeAsync(async () =>
        {
            _menuDeviceId = null;
            await LoadAsync();
            StateHasChanged();
        });
    }

    /// <summary>
    /// Loads one section per device in the investigation scope. The right-hand scope panel chooses the devices
    /// and the time window; all-time figures come from the full history, the plotted line from the window.
    /// </summary>
    private async Task LoadAsync()
    {
        ForensicScope scope = ScopeState.Current;
        _from = scope.FromUtc;
        _to = scope.ToUtc;

        List<Device> devices = (await DeviceRepository.ListAsync(CancellationToken.None)).OrderBy(d => d.Name).ToList();
        IEnumerable<Device> inScope = scope.MatchesNoDevices
            ? []
            : scope.IncludesAllDevices ? devices : devices.Where(d => scope.DeviceIds.Contains(d.Id));

        var sections = new List<DeviceSignal>();
        foreach (Device device in inScope)
        {
            IReadOnlyList<DeviceHealth> rows = await DeviceHealthRepository.GetHistoryAsync(device.Id, CancellationToken.None);
            List<SignalSample> samples = rows.Select(r => new SignalSample(r.CapturedAtUtc, r.WifiSignalRssi)).ToList();
            sections.Add(new DeviceSignal
            {
                Device = device,
                AllTime = SignalStats.Compute(samples),
                Points = SignalChartModel.Polyline(samples, _from, _to),
                InRangeCount = samples.Count(s => s.RssiDbm is not null && s.CapturedAtUtc >= _from && s.CapturedAtUtc <= _to),
            });
        }

        _sections = sections;
    }

    private static string DeviceName(Device device)
    {
        return string.IsNullOrWhiteSpace(device.Name) ? DeviceLabel.For(device.Name, device.ProviderDeviceId) : device.Name;
    }

    private static string PlotId(Guid deviceId) => $"signal-plot-{deviceId:N}";

    /// <summary>
    /// An SVG text label. Razor reserves the text tag and rejects attributes on it, so the label is built as markup
    /// here, with its content encoded.
    /// </summary>
    private static MarkupString SvgText(double x, double y, string anchor, string fill, string content, string? dominantBaseline = null)
    {
        string baseline = dominantBaseline is null ? string.Empty : $" dominant-baseline=\"{dominantBaseline}\"";
        return new MarkupString(
            $"<text x=\"{Format(x)}\" y=\"{Format(y)}\" text-anchor=\"{anchor}\"{baseline} font-size=\"11\" style=\"fill: {fill};\">{WebUtility.HtmlEncode(content)}</text>");
    }

    /// <summary>A horizontal reference bar across the plot, with its label at the right edge just above the bar.</summary>
    private static MarkupString ReferenceBar(double y, string colour, int width, string? dash, string label)
    {
        double right = SignalChartModel.PlotLeft + SignalChartModel.PlotWidth;
        string dashAttribute = dash is null ? string.Empty : $" stroke-dasharray=\"{dash}\"";
        string bar = $"<line class=\"signal-bar\" x1=\"{Format(SignalChartModel.PlotLeft)}\" x2=\"{Format(right)}\" y1=\"{Format(y)}\" y2=\"{Format(y)}\" stroke-width=\"{width}\"{dashAttribute} style=\"stroke: {colour};\" />";
        return new MarkupString(bar + SvgText(right - 4, y - 4, "end", colour, label).Value);
    }

    private static string Format(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);

    private async Task<PlotPointer> MeasureAsync(Guid deviceId, double clientX)
    {
        if (_module is null)
        {
            return new PlotPointer(0, 0);
        }

        return await _module.InvokeAsync<PlotPointer>("measure", PlotId(deviceId), clientX);
    }

    private async Task BeginSelectionAsync(DeviceSignal section, MouseEventArgs e)
    {
        _menuDeviceId = null;
        if (e.Button != 0)
        {
            // Right-button presses open the menu and must not clear or move the selection.
            return;
        }

        double fraction = await FractionAsync(section, e.ClientX);
        section.SelectionStart = fraction;
        section.SelectionEnd = fraction;
        section.Dragging = true;
    }

    private async Task MoveSelectionAsync(DeviceSignal section, MouseEventArgs e)
    {
        if (!section.Dragging)
        {
            return;
        }

        section.SelectionEnd = await FractionAsync(section, e.ClientX);
    }

    private static void EndSelection(DeviceSignal section)
    {
        section.Dragging = false;
    }

    private async Task<double> FractionAsync(DeviceSignal section, double clientX)
    {
        PlotPointer pointer = await MeasureAsync(section.Device.Id, clientX);
        return SignalChartModel.FractionFromCanvasOffset(pointer.Offset, pointer.Width);
    }

    private (DateTime start, DateTime end)? SelectionRangeFor(DeviceSignal section)
    {
        if (section.SelectionStart is not double start || section.SelectionEnd is not double end)
        {
            return null;
        }

        return SignalChartModel.SelectionRange(start, end, _from, _to);
    }

    private void OpenMenu(DeviceSignal section, MouseEventArgs e)
    {
        _menuDeviceId = section.Device.Id;
        _menuX = e.ClientX;
        _menuY = e.ClientY;
        _menuRange = SelectionRangeFor(section);
    }

    private void CloseMenu()
    {
        _menuDeviceId = null;
    }

    /// <summary>
    /// Narrows the scope to this camera and the selected period. The scope panel shows the same filter,
    /// and the graph reloads to show only that period.
    /// </summary>
    private void DrillDown()
    {
        ApplySelectionToScope();
    }

    /// <summary>Sets the scope to the selected period, then opens the new-case page, which picks the scope up.</summary>
    private void CreateCase()
    {
        if (ApplySelectionToScope())
        {
            NavigationManager.NavigateTo("/cases/new");
        }
    }

    private bool ApplySelectionToScope()
    {
        if (_menuDeviceId is not Guid deviceId || _menuRange is not { } range)
        {
            return false;
        }

        ForensicScope current = ScopeState.Current;
        ScopeState.Set(new ForensicScope([deviceId], range.start, range.end, current.Search));
        _menuDeviceId = null;
        return true;
    }

    public async ValueTask DisposeAsync()
    {
        ScopeState.OnChange -= OnScopeChanged;
        if (_module is not null)
        {
            await _module.DisposeAsync();
        }
    }
}
