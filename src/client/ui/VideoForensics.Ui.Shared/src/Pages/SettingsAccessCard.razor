@using System.Net.Http.Json
@using Microsoft.Extensions.Localization
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Core.Api.Contracts
@inject ISelfApiHttpClientFactory ClientFactory
@inject IStringLocalizer<SettingsPermissions> L

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">@Title</h5>
        <p class="text-body-secondary">@Description</p>

        <label class="form-label" for="@SelectId">@Label</label>
        <select id="@SelectId" class="form-select mb-3" @bind="_access" disabled="@(_saving || _loading)">
            <option value="SuperAdmin">@L["ReportsSuperAdminOption"]</option>
            <option value="Admin">@L["ProviderEditAdminOption"]</option>
        </select>

        <button type="button" class="btn btn-primary" @onclick="SaveAsync" disabled="@(_saving || _loading)">@L["Save"]</button>

        @if (_status is not null)
        {
            <div class="alert alert-secondary mt-3 mb-0" role="status">@_status</div>
        }
    </div>
</div>

@code {
    /// <summary>Route segment under /api/v1/permissions, e.g. "reports".</summary>
    [Parameter, EditorRequired] public string Route { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;

    [Parameter, EditorRequired] public string Label { get; set; } = string.Empty;

    private string SelectId => $"{Route}-settings-access";

    private bool _loading = true;
    private bool _saving;
    private string _access = "SuperAdmin";
    private string? _status;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            HttpClient client = ClientFactory.CreateClient();
            SettingsAccessLevelDto? result = await client.GetFromJsonAsync<SettingsAccessLevelDto>($"/api/v1/permissions/{Route}");
            _access = result?.Access ?? "SuperAdmin";
        }
        catch (HttpRequestException ex)
        {
            _status = L["LoadFailed", ex.Message].Value;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _status = null;
        try
        {
            HttpClient client = ClientFactory.CreateClient();
            HttpResponseMessage response = await client.PutAsJsonAsync($"/api/v1/permissions/{Route}", new UpdateSettingsAccessRequest(_access));
            _status = response.IsSuccessStatusCode
                ? L["SaveSucceeded"].Value
                : L["SaveFailed", response.StatusCode.ToString()].Value;
        }
        catch (HttpRequestException ex)
        {
            _status = L["SaveFailed", ex.Message].Value;
        }
        finally
        {
            _saving = false;
        }
    }
}
