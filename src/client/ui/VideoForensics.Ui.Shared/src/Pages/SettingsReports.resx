    <value>Report file format</value>
  </data>
  <data name="FormatDescription" xml:space="preserve">
    <value>The file type used when a report is exported. JSON suits other software, XML suits systems that require it, and CSV opens in a spreadsheet.</value>
  </data>
  <data name="RedactionLabel" xml:space="preserve">
    <value>Redaction level</value>
  </data>
  <data name="RedactionDescription" xml:space="preserve">
