@page "/admin/pending-credentials"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Services
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject WebAuthnClient WebAuthn
@inject IStringLocalizer<PendingCredentials> L

<h4 class="mb-4">@L["Title"]</h4>

@if (!SessionState.IsSignedIn)
{
    <div class="alert alert-info mb-4">
        <a href="/signin">Sign in with your passkey</a> @L["SignInToManage"]
    </div>
}

<h6 class="mt-4 mb-2">@L["PendingHeading"]</h6>
<div class="d-flex flex-row gap-2 mb-2">
    <SfButton Content="@L["RefreshButton"]" OnClick="LoadAsync" Disabled="@_isLoading" CssClass="e-flat" />
</div>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_authError is not null)
{
    <div class="alert alert-danger mb-2">@_authError</div>
    <span>@L["NotAuthorizedMessage"]</span>
}
else if (_loadError is not null)
{
    <div class="alert alert-danger">@_loadError</div>
}
else if (_credentials is null || _credentials.Count == 0)
{
    <span>@L["NoPendingCredentials"]</span>
}
else
{
    <SfGrid TValue="PendingCredentialItem" DataSource="@_credentials" AllowSorting="true" AllowPaging="true" AllowResizing="true">
        <GridPageSettings PageSize="20"></GridPageSettings>
        <GridColumns>
            <GridColumn Field="@nameof(PendingCredentialItem.OperatorDisplayName)" HeaderText="@L["ColOperatorName"]" MinWidth="150" />
            <GridColumn Field="@nameof(PendingCredentialItem.CredentialLabel)" HeaderText="@L["ColCredentialLabel"]" MinWidth="100" />
            <GridColumn Field="@nameof(PendingCredentialItem.CreatedAtUtc)" HeaderText="@L["ColCreatedAt"]" MinWidth="150" />
            <GridColumn HeaderText="" AllowSorting="false" MinWidth="200">
                <Template>
                    @{
                        var item = (PendingCredentialItem)context;
                        @if (_pendingActionCredentialId == item.CredentialId)
                        {
                            <div class="d-flex flex-row gap-2 align-items-center">
                                <SfButton Content="@L["ApproveButton"]" OnClick="() => ApproveAsync(item.CredentialId)" CssClass="e-success" Disabled="@_isApproving" />
                                <SfButton Content="@L["RevokeButton"]" OnClick="() => BeginRevoke(item.CredentialId)" CssClass="e-danger" />
                                <SfButton Content="@L["CancelButton"]" OnClick="CancelAction" CssClass="e-flat" />
                            </div>
                        }
                        else
                        {
                            <SfButton Content="@L["ActionsButton"]" OnClick="() => SelectCredential(item.CredentialId)" CssClass="e-outline" />
                        }
                    }
                </Template>
            </GridColumn>
        </GridColumns>
    </SfGrid>
}

@if (_showRevokeDialog && _pendingActionCredentialId.HasValue)
{
    <div class="modal show d-block" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@L["RevokeCredentialTitle"]</h5>
                    <button type="button" class="btn-close" @onclick="CancelAction"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">@L["RevokeReasonLabel"]</label>
                        <SfTextBox @bind-Value="_revokeReason" Placeholder="@L["RevokeReasonPlaceholder"].Value" />
                    </div>
                </div>
                <div class="modal-footer">
                    <SfButton Content="@L["CancelButton"]" OnClick="CancelAction" CssClass="e-flat" />
                    <SfButton Content="@(_isRevoking ? L["RevokingButton"] : L["RevokeButton"])" OnClick="ConfirmRevokeAsync" CssClass="e-danger" Disabled="@_isRevoking" />
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@if (_actionError is not null)
{
    <div class="alert alert-danger mt-4">@_actionError</div>
}

@if (_successMessage is not null)
{
    <div class="alert alert-success mt-4">@_successMessage</div>
}

@code {
    private bool _isLoading = true;
    private List<PendingCredentialItem>? _credentials = new();
    private string? _authError;
    private string? _loadError;
    private string? _actionError;
    private string? _successMessage;
    private Guid? _pendingActionCredentialId;
    private bool _showRevokeDialog;
    private string _revokeReason = string.Empty;
    private bool _isApproving;
    private bool _isRevoking;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // IJSRuntime is unavailable during Blazor's static prerender pass
        if (firstRender)
        {
            await SessionState.EnsureLoadedAsync();
            await LoadAsync();
            StateHasChanged();
        }
    }

    private async Task LoadAsync()
    {
        _isLoading = true;
        _authError = null;
        _loadError = null;
        _actionError = null;
        _successMessage = null;
        try
        {
            var client = CreateClient();
            var response = await client.GetAsync("api/devices-management/operator-credentials/pending");
            if (response.StatusCode is System.Net.HttpStatusCode.Unauthorized or System.Net.HttpStatusCode.Forbidden)
            {
                _authError = L["NotAuthorizedToView"];
                _credentials = null;
                return;
            }

            response.EnsureSuccessStatusCode();
            var pendingList = await response.Content.ReadFromJsonAsync<List<PendingCredentialDto>>(JsonOptions);
            if (pendingList is not null)
            {
                _credentials = pendingList.Select(c => new PendingCredentialItem
                {
                    CredentialId = c.Id,
                    OperatorDisplayName = c.OperatorDisplayName,
                    CredentialLabel = c.Label,
                    CreatedAtUtc = c.CreatedAtUtc
                }).ToList();
            }
        }
        catch (Exception ex)
        {
            _loadError = L["FailedToLoad", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void SelectCredential(Guid credentialId)
    {
        _pendingActionCredentialId = credentialId;
        _revokeReason = string.Empty;
        _showRevokeDialog = false;
        _actionError = null;
    }

    private void CancelAction()
    {
        _pendingActionCredentialId = null;
        _showRevokeDialog = false;
        _revokeReason = string.Empty;
    }

    private void BeginRevoke(Guid credentialId)
    {
        _showRevokeDialog = true;
        _revokeReason = string.Empty;
    }

    private async Task ApproveAsync(Guid credentialId)
    {
        if (SessionState.SessionToken is null)
        {
            _actionError = L["SignInFirstError"];
            return;
        }

        _isApproving = true;
        _actionError = null;
        _successMessage = null;
        try
        {
            // Step-up required for high-risk approval action
            var stepUpToken = await WebAuthn.StepUpAsync(SessionState.SessionToken);

            var client = CreateClient();
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            var response = await client.PostAsJsonAsync($"api/devices-management/operator-credentials/{credentialId}/approve", new { });
            if (!response.IsSuccessStatusCode)
            {
                var body = await SafeReadErrorAsync(response);
                _actionError = body ?? L["ApproveFailed", response.StatusCode];
                return;
            }

            _successMessage = L["CredentialApproved"];
            CancelAction();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = L["ApproveFailed", ex.Message];
        }
        finally
        {
            _isApproving = false;
        }
    }

    private async Task ConfirmRevokeAsync()
    {
        if (!_pendingActionCredentialId.HasValue || SessionState.SessionToken is null)
        {
            return;
        }

        _isRevoking = true;
        _actionError = null;
        _successMessage = null;
        try
        {
            // Step-up required for high-risk revoke action
            var stepUpToken = await WebAuthn.StepUpAsync(SessionState.SessionToken);

            var client = CreateClient();
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            var response = await client.PostAsJsonAsync($"api/devices-management/operator-credentials/{_pendingActionCredentialId}/revoke",
                new { Reason = string.IsNullOrWhiteSpace(_revokeReason) ? "Revoked by admin" : _revokeReason });
            if (!response.IsSuccessStatusCode)
            {
                var body = await SafeReadErrorAsync(response);
                _actionError = body ?? L["RevokeFailed", response.StatusCode];
                return;
            }

            _successMessage = L["CredentialRevoked"];
            CancelAction();
            await LoadAsync();
        }
        catch (Exception ex)
        {
            _actionError = L["RevokeFailed", ex.Message];
        }
        finally
        {
            _isRevoking = false;
        }
    }

    private static async Task<string?> SafeReadErrorAsync(HttpResponseMessage response)
    {
        try
        {
            var doc = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>(JsonOptions);
            return doc is not null && doc.TryGetValue("error", out var msg) ? msg : null;
        }
        catch
        {
            return null;
        }
    }

    private HttpClient CreateClient()
    {
        var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
        if (SessionState.SessionToken is not null)
        {
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        }

        return client;
    }

    private static readonly System.Text.Json.JsonSerializerOptions JsonOptions = new() { PropertyNameCaseInsensitive = true };

    private class PendingCredentialItem
    {
        public Guid CredentialId { get; set; }
        public string OperatorDisplayName { get; set; } = string.Empty;
        public string CredentialLabel { get; set; } = string.Empty;
        public DateTime CreatedAtUtc { get; set; }
    }

    private record PendingCredentialDto(Guid Id, string OperatorDisplayName, string Label, DateTime CreatedAtUtc);
}
