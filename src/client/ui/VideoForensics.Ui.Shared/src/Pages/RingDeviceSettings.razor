@page "/devices/config/ring/{DeviceId:guid}"
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Services
@using Microsoft.Extensions.Localization
@inject IDeviceRepository DeviceRepository
@inject IDeviceTypedSettingsReader TypedSettings
@inject IStringLocalizer<RingDeviceSettings> L

<h4 class="mb-2">@L["Title"]</h4>
<p><a href="/accounts">@L["BackToDeviceConfig"]</a></p>

@if (_loading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_device is null)
{
    <p>@L["NotFound"]</p>
}
else if (!RingSettingsRoute.IsRingDevice(_device))
{
    <p>@L["NotRing"]</p>
}
else
{
    <h5 class="mb-3">@_device.Name</h5>

    @if (_typed is null || (_typed.OfflineMotion is null && _typed.DetectionTypes.Count == 0 && _typed.Thresholds.Count == 0))
    {
        <p>@L["NoTypedSettings"]</p>
    }
    else
    {
        @if (_typed.OfflineMotion is { } offline)
        {
            <h6 class="mt-3">@L["OfflineMotionTitle"]</h6>
            <table class="table table-sm" data-testid="ring-offline-motion">
                <tbody>
                    <tr><th>@L["ColEnabledFlag"]</th><td>@(offline.Enabled?.ToString() ?? "-")</td></tr>
                    <tr><th>@L["ColSubscribed"]</th><td>@(offline.Subscribed?.ToString() ?? "-")</td></tr>
                    <tr><th>@L["ColMaxUploadKb"]</th><td>@(offline.MaxUploadKb?.ToString() ?? "-")</td></tr>
                    <tr><th>@L["ColResolutionP"]</th><td>@(offline.ResolutionP?.ToString() ?? "-")</td></tr>
                    <tr><th>@L["ColFrequencyAfterSecs"]</th><td>@(offline.FrequencyAfterSecs?.ToString() ?? "-")</td></tr>
                    <tr><th>@L["ColPeriodAfterSecs"]</th><td>@(offline.PeriodAfterSecs?.ToString() ?? "-")</td></tr>
                </tbody>
            </table>
        }
        @if (_typed.DetectionTypes.Count > 0)
        {
            <h6 class="mt-3">@L["DetectionTypesTitle"]</h6>
            <table class="table table-sm" data-testid="ring-detection-types">
                <thead><tr><th>@L["ColDetectionType"]</th><th>@L["ColEnabledFlag"]</th><th>@L["ColMode"]</th><th>@L["ColRecord"]</th><th>@L["ColNotification"]</th></tr></thead>
                <tbody>
                    @foreach (var t in _typed.DetectionTypes)
                    {
                        <tr><td>@t.DetectionType</td><td>@(t.Enabled?.ToString() ?? "-")</td><td>@(t.Mode ?? "-")</td><td>@(t.Record?.ToString() ?? "-")</td><td>@(t.Notification?.ToString() ?? "-")</td></tr>
                    }
                </tbody>
            </table>
        }
        @if (_typed.Thresholds.Count > 0)
        {
            <h6 class="mt-3">@L["ThresholdsTitle"]</h6>
            <table class="table table-sm" data-testid="ring-thresholds">
                <thead><tr><th>@L["ColDetectionType"]</th><th>@L["ColThreshold"]</th></tr></thead>
                <tbody>
                    @foreach (var th in _typed.Thresholds)
                    {
                        <tr><td>@th.DetectionType</td><td>@(th.Threshold?.ToString() ?? "-")</td></tr>
                    }
                </tbody>
            </table>
        }
    }
    @if (!string.IsNullOrEmpty(_device.SettingsMetadataJson))
    {
        <h6 class="mt-3">@L["OtherSettingsTitle"]</h6>
        <pre data-testid="ring-other-settings" style="white-space: pre-wrap; font-size: 0.85rem;">@_device.SettingsMetadataJson</pre>
    }
}

@code {
    [Parameter]
    public Guid DeviceId { get; set; }

    private VideoForensics.Data.Common.Entities.Device? _device;
    private DeviceTypedSettings? _typed;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // The list carries ProviderName (the single-device read does not), so the device is found in it.
            IReadOnlyList<VideoForensics.Data.Common.Entities.Device> devices = await DeviceRepository.ListAsync(CancellationToken.None);
            _device = devices.FirstOrDefault(d => d.Id == DeviceId);
            if (_device is not null && RingSettingsRoute.IsRingDevice(_device))
            {
                _typed = await TypedSettings.GetAsync(DeviceId, CancellationToken.None);
            }
        }
        finally
        {
            _loading = false;
        }
    }
}
