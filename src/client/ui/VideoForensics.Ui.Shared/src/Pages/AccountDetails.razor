@page "/accounts/{Id:guid}"
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Core.Providers.Common.Contracts
@inject IProviderAccountRepository ProviderAccountRepository
@inject IUserRepository UserRepository
@inject IForensicsConfiguration ForensicsConfig
@inject IForensicsConfigurationService ForensicsConfigService
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@inject PairedSessionState SessionState
@inject WebAuthnClient WebAuthn
@inject StepUpService StepUp
@inject IProviderAuthService AuthService
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AccountDetails> L

<Breadcrumb Items="@_breadcrumbItems" />

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <p>@_statusMessage</p>
    }

    @if (_account == null)
    {
        <p>@L["AccountNotFound"]</p>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">@L["AccountLabel"]</label>
                    <h5 class="card-title">@(_accountEmail is null ? _account.ProviderName : $"{_account.ProviderName} - {_accountEmail}")</h5>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LinkedLabel"]</label>
                    <p class="form-control-plaintext">@_account.LinkedUtc</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LastSuccessfulAuthLabel"]</label>
                    <p class="form-control-plaintext">@(_account.LastSuccessfulAuthUtc?.ToString() ?? L["Never"])</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["ActiveLabel"]</label>
                    <p class="form-control-plaintext">@(_account.IsActive ? L["Yes"] : L["No"])</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LastDownloadLabel"]</label>
                    <p class="form-control-plaintext">@(_account.LastDownloadTimeUtc?.ToString() ?? L["Never"])</p>
                </div>

                @if (_account.LastErrorUtc.HasValue || !string.IsNullOrEmpty(_account.LastErrorMessage))
                {
                    <div class="mb-3 p-3 border border-danger rounded" style="background-color: #fff5f5;">
                        <label class="form-label fw-bold text-danger">@L["LastErrorLabel"]</label>
                        <p class="form-control-plaintext mb-1">
                            <strong>@L["TimeLabel"]</strong> @(_account.LastErrorUtc?.ToString() ?? L["NoValue"])
                        </p>
                        <p class="form-control-plaintext">
                            <strong>@L["MessageLabel"]</strong> @(_account.LastErrorMessage ?? L["NoValue"])
                        </p>
                    </div>
                }
            </div>
        </div>

        <div class="mb-4">
            <div class="d-flex flex-wrap gap-2 align-items-end mb-2">
                <div>
                    <label class="form-label" for="sync-type">@L["SyncTypeLabel"]</label>
                    <select id="sync-type" class="form-select" @bind="_syncType">
                        @foreach (var t in SyncRequestBuilder.SyncTypes)
                        {
                            <option value="@t">@SyncTypeChoiceLabel(t)</option>
                        }
                    </select>
                </div>
                @if (!IsConfigSync)
                {
                    <div>
                        <label class="form-label" for="sync-range">@L["SyncRangeLabel"]</label>
                        <select id="sync-range" class="form-select" @onchange="OnRangeChanged">
                            @foreach (var r in SyncRequestBuilder.RangeOptions)
                            {
                                <option value="@r" selected="@(r == _syncRange)">@RangeLabel(r)</option>
                            }
                        </select>
                    </div>
                    @if (_syncRange == SyncRequestBuilder.CustomRange)
                    {
                        <div>
                            <label class="form-label" for="sync-custom-start">@L["SyncCustomStart"]</label>
                            <input id="sync-custom-start" type="date" class="form-control" value="@_customStart" @onchange="e => _customStart = e.Value?.ToString() ?? string.Empty" />
                        </div>
                        <div>
                            <label class="form-label" for="sync-custom-end">@L["SyncCustomEnd"]</label>
                            <input id="sync-custom-end" type="date" class="form-control" value="@_customEnd" @onchange="e => _customEnd = e.Value?.ToString() ?? string.Empty" />
                            <div id="sync-custom-end-hint" class="form-text">@L["CustomEndHint"]</div>
                        </div>
                    }
                }
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center">
                <SfButton CssClass="e-primary" Content="@L["SyncNow"]" OnClick="SyncNowAsync" Disabled="@_isSyncing" />
                @if (_isSyncing)
                {
                    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" Height="30px" Width="30px" />
                }
                <SfButton CssClass="e-primary" Content="@L["SyncSchedule"]" OnClick="GoToSyncSchedule" />
                @if (!string.IsNullOrEmpty(_account?.LastErrorMessage))
                {
                    <SfButton CssClass="e-warning" Content="@L["Login"]" OnClick="() => _reAuthDialogVisible = true" />
                }
            </div>
        </div>

        <div id="sync-output" class="mb-4">
            <h5>@L["SyncOutputTitle"]</h5>
            @if (LatestRun is { } latest)
            {
                <p class="mb-1">
                    <strong>@L["LatestSyncRunLabel"]</strong>
                    @latest.StartedUtc.ToLocalTime().ToString("g") - @(latest.Success ? L["SyncSucceeded"] : L["SyncRunFailed"])
                </p>
            }
            <DownloadProgressPanel IsActive="@_isSyncing" />
        </div>

        <div>
            @if (_confirmingRemove)
            {
                <AccountRemovePanel AccountId="@Id" OnCompleted="OnRemoveCompletedAsync" OnCancelled="CancelRemove" />
            }
            else
            {
                <SfButton CssClass="e-danger" Content="@L["RemoveAccount"]" OnClick="PromptRemove" Disabled="@_isBusy" />
            }
        </div>

        <div id="sync-history" class="mb-4">
            <h5>@L["SyncHistoryTitle"]</h5>
            @if (_syncRunsError)
            {
                <p class="text-danger">@L["LoadListError"]</p>
            }
            else if (_syncRuns is not null && _syncRuns.Count == 0)
            {
                <p>@L["SyncNoRuns"]</p>
            }
            else if (_syncRuns is not null)
            {
                <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@L["ColSyncTime"]</th>
                            <th>@L["ColSyncStatus"]</th>
                            <th>@L["ColSyncType"]</th>
                            <th>@L["ColSyncRecords"]</th>
                            <th>@L["ColDetails"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in _syncRuns)
                        {
                            <tr class="sync-run-row">
                                <td>@run.StartedUtc.ToLocalTime().ToString("g")</td>
                                <td>@(run.Success ? L["SyncSucceeded"] : L["SyncRunFailed"])</td>
                                <td>@SyncTypeLabel(run.SyncType)</td>
                                <td>@(SyncRequestBuilder.FormatRecords(L["SyncRecordsSummary"].Value, run.DevicesSynced, run.LocationsSynced, run.EventsSynced, run.ConfigAreasSynced, run.FeedsFailed, run.SnapshotsSynced, L["SyncRecordsSnapshots"].Value) ?? L["SyncRecordsUnknown"].Value)</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ToggleRunDetailsAsync(run.Id)">@L["ColDetails"]</button>
                                </td>
                            </tr>
                            @if (_expandedRunId == run.Id)
                            {
                                <tr class="sync-run-detail">
                                    <td colspan="5">
                                        @if (_runDetailError)
                                        {
                                            <p class="text-danger mb-0">@L["SyncDetailsError"]</p>
                                        }
                                        else if (_runDetail is not null)
                                        {
                                            <strong>@L["SyncDetailsTitle"]</strong>
                                            <p class="mb-1"><strong>@L["SyncDetailsStarted"]</strong> @_runDetail.StartedUtc.ToLocalTime().ToString("g")</p>
                                            <p class="mb-1"><strong>@L["SyncDetailsCompleted"]</strong> @(_runDetail.CompletedUtc?.ToLocalTime().ToString("g") ?? L["SyncNotCompleted"])</p>
                                            <p class="mb-1"><strong>@L["ColSyncStatus"]</strong> @(_runDetail.Success ? L["SyncSucceeded"] : L["SyncRunFailed"])</p>
                                            @if (!string.IsNullOrEmpty(_runDetail.ErrorMessage))
                                            {
                                                <p class="mb-0"><strong>@L["SyncDetailsMessage"]</strong> @_runDetail.ErrorMessage</p>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>

        <div id="attached-cases" class="mb-4">
            <h5>@L["AttachedCasesTitle"]</h5>
            @if (_casesError)
            {
                <p class="text-danger">@L["LoadListError"]</p>
            }
            else if (_cases is not null && _cases.Count == 0)
            {
                <p>@L["CasesNone"]</p>
            }
            else if (_cases is not null)
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@L["ColCaseType"]</th>
                            <th>@L["ColEventDate"]</th>
                            <th>@L["ColCreatedDate"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var caseRow in _cases)
                        {
                            <tr class="case-row">
                                <td>@CaseTypeLabel(caseRow.CaseType)</td>
                                <td data-col="event-date">@(caseRow.ScopeFromUtc?.ToLocalTime().ToString("d"))</td>
                                <td>@caseRow.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenCase(caseRow.Id)">@L["OpenCase"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (_account is not null)
        {
            <ReAuthDialog @bind-Visible="_reAuthDialogVisible"
                          ProviderName="@_account.ProviderName"
                          InitialEmail="@_accountEmail"
                          OnAuthenticated="HandleReAuthenticatedAsync" />
        }

        <SfToast @ref="_toastRef" />
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private List<(string Label, string? Url)> _breadcrumbItems = new();
    private VideoForensics.Data.Common.Entities.ProviderAccount? _account;
    private string? _accountEmail;
    private bool _isLoading = true;
    private bool _isBusy;
    private string _syncType = "All";
    private string _syncRange = "30";
    private string _customStart = SyncRequestBuilder.DefaultCustomRange(DateTime.Today).Start;
    private string _customEnd = SyncRequestBuilder.DefaultCustomRange(DateTime.Today).End;
    private bool _confirmingRemove;
    private bool _reAuthDialogVisible;
    private bool _isSyncing;
    private string? _statusMessage;
    private SfToast _toastRef = null!;
    private List<VideoForensics.Core.Api.Contracts.ProviderSyncRunSummaryDto>? _syncRuns;
    private bool _syncRunsError;
    private List<VideoForensics.Core.Api.Contracts.AccountCaseDto>? _cases;
    private bool _casesError;
    private Guid? _expandedRunId;
    private VideoForensics.Core.Api.Contracts.ProviderSyncRunDetailDto? _runDetail;
    private bool _runDetailError;

    private VideoForensics.Core.Api.Contracts.ProviderSyncRunSummaryDto? LatestRun =>
        _syncRuns?.OrderByDescending(r => r.StartedUtc).FirstOrDefault();

    private void OnRangeChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _syncRange = e.Value?.ToString() ?? "30";
        if (_syncRange == SyncRequestBuilder.CustomRange)
        {
            (_customStart, _customEnd) = SyncRequestBuilder.DefaultCustomRange(DateTime.Today);
        }
    }

    private string SyncTypeChoiceLabel(string type) => type switch
    {
        "Events" => L["SyncChoiceEvents"],
        "Snapshots" => L["SyncChoiceSnapshots"],
        "Config" => L["SyncChoiceConfig"],
        _ => L["SyncChoiceAll"],
    };

    private bool IsConfigSync => _syncType == SyncRequestBuilder.ConfigSyncType;

    private string RangeLabel(string range) => range switch
    {
        "30" => L["SyncRange30"],
        "60" => L["SyncRange60"],
        "90" => L["SyncRange90"],
        "365" => L["SyncRange365"],
        SyncRequestBuilder.AllRange => L["SyncRangeAll"],
        _ => L["SyncRangeCustom"],
    };

    private string SyncTypeLabel(string? type) => type switch
    {
        "Full" => L["SyncTypeFull"],
        "Incremental" => L["SyncTypeIncremental"],
        "Snapshots" => L["SyncTypeSnapshots"],
        "Config" => L["SyncTypeConfig"],
        _ => L["SyncTypeUnknown"],
    };

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbItems = new() { (L["BreadcrumbAccounts"], "/accounts"), (L["BreadcrumbAccountDetails"], null) };
        await LoadAccountAsync();
        // Render the account card first; the lists load after it and don't hold it up.
        StateHasChanged();
        if (_account is not null)
        {
            await LoadListsAsync();
        }
    }

    private async Task LoadListsAsync()
    {
        await LoadSyncRunsAsync();
        await LoadCasesAsync();
    }

    private async Task LoadSyncRunsAsync()
    {
        _expandedRunId = null;
        _runDetail = null;
        _runDetailError = false;
        try
        {
            _syncRuns = await GetApiAsync<List<VideoForensics.Core.Api.Contracts.ProviderSyncRunSummaryDto>>(
                $"api/v1/accounts/provider-accounts/{Id}/sync-runs") ?? new();
            _syncRunsError = false;
        }
        catch
        {
            _syncRuns = null;
            _syncRunsError = true;
        }
        StateHasChanged();
    }

    private async Task LoadCasesAsync()
    {
        try
        {
            _cases = await GetApiAsync<List<VideoForensics.Core.Api.Contracts.AccountCaseDto>>(
                $"api/v1/accounts/provider-accounts/{Id}/cases") ?? new();
            _casesError = false;
        }
        catch
        {
            _cases = null;
            _casesError = true;
        }
        StateHasChanged();
    }

    private async Task ToggleRunDetailsAsync(Guid runId)
    {
        if (_expandedRunId == runId)
        {
            _expandedRunId = null;
            _runDetail = null;
            _runDetailError = false;
            return;
        }

        _expandedRunId = runId;
        _runDetail = null;
        _runDetailError = false;
        try
        {
            var detail = await GetApiAsync<VideoForensics.Core.Api.Contracts.ProviderSyncRunDetailDto>(
                $"api/v1/accounts/provider-accounts/{Id}/sync-runs/{runId}");
            if (_expandedRunId == runId)
            {
                _runDetail = detail;
            }
        }
        catch
        {
            if (_expandedRunId == runId)
            {
                _runDetailError = true;
            }
        }
    }

    private void OpenCase(Guid caseId)
    {
        NavigationManager.NavigateTo($"/cases/{caseId}");
    }

    /// <summary>
    /// GET against the account API with the paired-device bearer token. The injected HttpClient has
    /// no base address or auth header in production, so the absolute URI and header are set per request.
    /// </summary>
    private async Task<T?> GetApiAsync<T>(string relativePath)
    {
        await SessionState.EnsureLoadedAsync();
        using var request = new HttpRequestMessage(HttpMethod.Get, new Uri(new Uri(NavigationManager.BaseUri), relativePath));
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        using HttpResponseMessage response = await HttpClient.SendAsync(request, CancellationToken.None);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<T>(CancellationToken.None);
    }

    private async Task LoadAccountAsync()
    {
        _isLoading = true;
        _statusMessage = null;
        try
        {
            _account = await ProviderAccountRepository.GetAsync(Id, CancellationToken.None);

            if (_account is not null)
            {
                try
                {
                    // The provider login (email for Ring) is the account's name.
                    var user = await UserRepository.GetAsync(_account.UserId, CancellationToken.None);
                    _accountEmail = user?.ProviderUserKey;
                }
                catch
                {
                    // Fall back to ProviderName if user lookup fails
                }
            }
        }
        catch (Exception ex)
        {
            _statusMessage = L["ErrorLoadingAccount", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>Maps the API's CaseType value to its localized label; unknown values show as Other.</summary>
    private string CaseTypeLabel(string caseType) => caseType switch
    {
        "Detected" => L["CaseTypeDetected"],
        "Suspected" => L["CaseTypeSuspected"],
        "Manual" => L["CaseTypeManual"],
        _ => L["CaseTypeOther"],
    };

    private void GoToSyncSchedule()
    {
        NavigationManager.NavigateTo($"/accounts/{Id}/schedule");
    }

    private void PromptRemove()
    {
        _confirmingRemove = true;
    }

    private void CancelRemove()
    {
        _confirmingRemove = false;
    }

    private async Task OnRemoveCompletedAsync(AccountRemovePanel.RemoveResult result)
    {
        _isBusy = true;
        _confirmingRemove = false;
        _statusMessage = null;
        try
        {
            if (ForensicsConfig.ActiveProviderAccountId == Id)
            {
                ForensicsConfig.ActiveProviderAccountId = null;
                try
                {
                    await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);
                }
                catch (NotSupportedException)
                {
                    _statusMessage = L["SettingServerOnly"];
                    return;
                }
            }

            NavigationManager.NavigateTo("/accounts");
        }
        catch (Exception ex)
        {
            _statusMessage = L["ErrorRemovingAccount", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleReAuthenticatedAsync(AuthResult result)
    {
        if (result.Success)
        {
            await LoadAccountAsync();
        }
    }

    private async Task SyncNowAsync()
    {
        _isSyncing = true;
        try
        {
            await SessionState.EnsureLoadedAsync();
            // Session state loads lazily; the token is only populated after this.
            // The injected HttpClient has no base address, so relative URIs fail before a request is sent.
            // Build the client the same way the other authenticated calls on this page do.
            using var request = new HttpRequestMessage(HttpMethod.Post, new Uri(new Uri(NavigationManager.BaseUri), $"api/v1/accounts/provider-accounts/{Id}/sync-now"))
            {
                Content = JsonContent.Create(SyncRequestBuilder.Build(_syncType, _syncRange, _customStart, _customEnd)),
            };
            request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
            using HttpResponseMessage response = await HttpClient.SendAsync(request, CancellationToken.None);

            if (response.IsSuccessStatusCode)
            {
                await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
                {
                    Title = L["SyncStarted"],
                    Icon = "e-success"
                });

                // Reload account details after a delay to show updated timestamp
                await Task.Delay(2000);
                await LoadAccountAsync();
                await LoadSyncRunsAsync();
            }
            else
            {
                await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
                {
                    Title = L["SyncFailed"],
                    Icon = "e-danger"
                });
            }
        }
        catch (Exception ex)
        {
            await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
            {
                Title = L["ErrorTitle"],
                Content = ex.Message,
                Icon = "e-danger"
            });
        }
        finally
        {
            _isSyncing = false;
        }
    }
}
