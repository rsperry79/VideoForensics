@page "/accounts/{Id:guid}"
@inherits AccountTabPageBase
@using VideoForensics.Client.Ui.Shared.Services
@inject IForensicsConfiguration ForensicsConfig
@inject IForensicsConfigurationService ForensicsConfigService
@inject IMultiProviderAuthService MultiProviderAuthService

<Breadcrumb Items="@_breadcrumbItems" />

@if (IsLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(StatusMessage))
    {
        <p>@StatusMessage</p>
    }

    @if (Account == null)
    {
        <p>@L["AccountNotFound"]</p>
    }
    else
    {
        <AccountTabs AccountId="@Id" />

        <div class="card mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">@L["AccountLabel"]</label>
                    <h5 class="card-title">@(AccountEmail is null ? Account.ProviderName : $"{Account.ProviderName} - {AccountEmail}")</h5>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LinkedLabel"]</label>
                    <p class="mb-0"><LocalTimeText Value="@Account.LinkedUtc" /></p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["ActiveLabel"]</label>
                    <p class="mb-0">@(Account.IsActive ? L["Yes"] : L["No"])</p>
                </div>

                @if (Account.LastErrorUtc.HasValue || !string.IsNullOrEmpty(Account.LastErrorMessage))
                {
                    <div class="mb-3 p-3 border border-danger rounded" role="alert" style="background-color: #fff5f5; color: #842029;">
                        <h6 class="fw-bold text-danger">@L["CredentialErrorTitle"]</h6>
                        <p class="mb-2">@L["CredentialRecoveryMessage"]</p>
                        <label class="form-label fw-bold text-danger">@L["LastErrorLabel"]</label>
                        <p class="mb-1">
                            <strong>@L["TimeLabel"]</strong> <LocalTimeText Value="@Account.LastErrorUtc" Fallback="@L["NoValue"]" />
                        </p>
                        <p class="mb-0">
                            <strong>@L["MessageLabel"]</strong> @L["CredentialRecoveryMessage"]
                        </p>
                    </div>
                }

                <div class="mb-3 d-flex gap-2 align-items-center" style="color: #212529;">
                    <SfButton CssClass="e-warning" Content="@(_validationBusy ? L["Validating"] : L["ValidateCredential"])" OnClick="ValidateCredentialAsync" Disabled="@_validationBusy" />
                    @if (CanEditAccount)
                    {
                        <SfButton CssClass="e-outline" Content="@L["Reauthenticate"]" OnClick="ShowReauthentication" Disabled="@_validationBusy" />
                    }
                    @if (!string.IsNullOrEmpty(_credentialStatus))
                    {
                        <span role="status">@_credentialStatus</span>
                    }
                </div>

                @if (_showReauthentication && CanEditAccount)
                {
                    <div class="mb-3 p-3 border rounded" style="color: #212529;">
                        <h6>@L["ReauthenticateHeading"]</h6>
                        <p>@L["ReauthenticatePrompt"]</p>
                        <AuthForm IdPrefix="account-reauth" SubmitLabel="@L["Reauthenticate"]"
                                  InitialEmail="@AccountEmail"
                                  AvailableProviders="@(new[] { Account.ProviderName })"
                                  OnAuthenticated="HandleReauthenticationAsync" />
                    </div>
                }
            </div>
        </div>

        <div>
            @if (_confirmingRemove)
            {
                <AccountRemovePanel AccountId="@Id" OnCompleted="OnRemoveCompletedAsync" OnCancelled="CancelRemove" />
            }
            else if (CanEditAccount)
            {
                <SfButton CssClass="e-danger" Content="@L["RemoveAccount"]" OnClick="PromptRemove" Disabled="@_isBusy" />
            }
        </div>
    }
}

@code {
    private List<(string Label, string? Url)> _breadcrumbItems = new();
    private bool _confirmingRemove;
    private bool _isBusy;
    private bool _validationBusy;
    private bool _showReauthentication;
    private string? _credentialStatus;

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbItems = new() { (L["BreadcrumbAccounts"], "/accounts"), (L["BreadcrumbAccountDetails"], null) };
        await LoadAccountAsync();
    }

    private void ShowReauthentication()
    {
        _credentialStatus = null;
        _showReauthentication = true;
    }

    private async Task ValidateCredentialAsync()
    {
        if (Account is null)
        {
            return;
        }

        _validationBusy = true;
        _credentialStatus = null;
        try
        {
            bool valid = await MultiProviderAuthService.GetService(Account.ProviderName)
                .RestoreFromSavedCredentialsAsync(Account.Id, CancellationToken.None);
            _credentialStatus = valid ? L["CredentialValid"] : L["CredentialInvalidReauthenticate"];
            if (valid)
            {
                await LoadAccountAsync();
            }
            else
            {
                _showReauthentication = true;
            }
        }
        catch (Exception)
        {
            _credentialStatus = L["CredentialValidationFailed"];
            _showReauthentication = true;
        }
        finally
        {
            _validationBusy = false;
        }
    }

    private async Task HandleReauthenticationAsync(AuthResult result)
    {
        if (result.ProviderAccountId != Id)
        {
            _credentialStatus = L["ReauthenticationWrongAccount"];
            return;
        }

        _showReauthentication = false;
        _credentialStatus = L["CredentialValid"];
        await LoadAccountAsync();
    }

    private void PromptRemove()
    {
        _confirmingRemove = true;
    }

    private void CancelRemove()
    {
        _confirmingRemove = false;
    }

    private async Task OnRemoveCompletedAsync(AccountRemovePanel.RemoveResult result)
    {
        _isBusy = true;
        _confirmingRemove = false;
        StatusMessage = null;
        try
        {
            if (ForensicsConfig.ActiveProviderAccountId == Id)
            {
                ForensicsConfig.ActiveProviderAccountId = null;
                try
                {
                    await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);
                }
                catch (NotSupportedException)
                {
                    StatusMessage = L["SettingServerOnly"];
                    return;
                }
            }

            NavigationManager.NavigateTo("/accounts");
        }
        catch (Exception ex)
        {
            StatusMessage = L["ErrorRemovingAccount", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }
}
