@page "/accounts/{Id:guid}"
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Core.Providers.Common.Contracts
@inject IProviderAccountRepository ProviderAccountRepository
@inject IUserRepository UserRepository
@inject IForensicsConfiguration ForensicsConfig
@inject IForensicsConfigurationService ForensicsConfigService
@inject NavigationManager NavigationManager
@inject HttpClient HttpClient
@inject PairedSessionState SessionState
@inject WebAuthnClient WebAuthn
@inject StepUpService StepUp
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<AccountDetails> L

<Breadcrumb Items="@_breadcrumbItems" />

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else
{
    @if (!string.IsNullOrEmpty(_statusMessage))
    {
        <p>@_statusMessage</p>
    }

    @if (_account == null)
    {
        <p>@L["AccountNotFound"]</p>
    }
    else
    {
        <div class="card mb-4">
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">@L["AccountLabel"]</label>
                    <h5 class="card-title">@(_accountEmail is null ? _account.ProviderName : $"{_account.ProviderName} - {_accountEmail}")</h5>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LinkedLabel"]</label>
                    <p class="form-control-plaintext">@_account.LinkedUtc</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LastSuccessfulAuthLabel"]</label>
                    <p class="form-control-plaintext">@(_account.LastSuccessfulAuthUtc?.ToString() ?? L["Never"])</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["ActiveLabel"]</label>
                    <p class="form-control-plaintext">@(_account.IsActive ? L["Yes"] : L["No"])</p>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">@L["LastDownloadLabel"]</label>
                    <p class="form-control-plaintext">@(_account.LastDownloadTimeUtc?.ToString() ?? L["Never"])</p>
                </div>

                @if (_account.LastErrorUtc.HasValue || !string.IsNullOrEmpty(_account.LastErrorMessage))
                {
                    <div class="mb-3 p-3 border border-danger rounded" style="background-color: #fff5f5;">
                        <label class="form-label fw-bold text-danger">@L["LastErrorLabel"]</label>
                        <p class="form-control-plaintext mb-1">
                            <strong>@L["TimeLabel"]</strong> @(_account.LastErrorUtc?.ToString() ?? L["NoValue"])
                        </p>
                        <p class="form-control-plaintext">
                            <strong>@L["MessageLabel"]</strong> @(_account.LastErrorMessage ?? L["NoValue"])
                        </p>
                    </div>
                }
            </div>
        </div>

        <div class="mb-4">
            <div class="d-flex gap-2 align-items-center">
                <SfButton CssClass="e-primary" Content="@L["SyncSchedule"]" OnClick="GoToSyncSchedule" />
                @if (!string.IsNullOrEmpty(_account?.LastErrorMessage))
                {
                    <SfButton CssClass="e-warning" Content="@L["Login"]" OnClick="() => _reAuthDialogVisible = true" />
                }
            </div>
        </div>

        <div id="sync-panel" class="card mb-4">
            <div class="card-body">
                <h5 class="card-title">@L["SyncPanelTitle"]</h5>
                <div class="d-flex flex-wrap gap-3 align-items-end mb-3">
                    <div>
                        <label for="sync-type" class="form-label">@L["SyncTypeDropdownLabel"]</label>
                        <select id="sync-type" class="form-select" @bind="_syncType" disabled="@_isSyncing">
                            <option value="All">@L["SyncTypeAll"]</option>
                            <option value="Config">@L["SyncTypeConfig"]</option>
                            <option value="Snapshots">@L["SyncTypeSnapshots"]</option>
                            <option value="Events">@L["SyncTypeEvents"]</option>
                        </select>
                    </div>
                    @if (SyncRequestBuilder.UsesRange(_syncType))
                    {
                        <div>
                            <label for="sync-range" class="form-label">@L["RangeLabel"]</label>
                            <select id="sync-range" class="form-select" @bind="_syncRange" disabled="@_isSyncing">
                                <option value="SinceLast">@L["RangeSinceLast"]</option>
                                <option value="30">@L["RangeDays30"]</option>
                                <option value="60">@L["RangeDays60"]</option>
                                <option value="90">@L["RangeDays90"]</option>
                                <option value="365">@L["RangeDays365"]</option>
                                <option value="All">@L["RangeAllHistory"]</option>
                                <option value="Custom">@L["RangeCustom"]</option>
                            </select>
                        </div>
                        @if (_syncRange == CustomRange)
                        {
                            <div class="sync-custom-range">
                                <label for="sync-custom-start" class="form-label">@L["CustomStartLabel"]</label>
                                <input id="sync-custom-start" type="date" class="form-control" value="@CustomStartText" disabled="@_isSyncing" @onchange="OnCustomStartChanged" />
                            </div>
                            <div class="sync-custom-range">
                                <label for="sync-custom-end" class="form-label">@L["CustomEndLabel"]</label>
                                <input id="sync-custom-end" type="date" class="form-control" value="@CustomEndText" disabled="@_isSyncing" @onchange="OnCustomEndChanged" />
                                <div id="sync-custom-end-hint" class="form-text">@L["CustomEndHint"]</div>
                            </div>
                        }
                    }
                    <div class="d-flex gap-2 align-items-center">
                        <SfButton CssClass="e-primary" Content="@L["SyncNow"]" OnClick="SyncNowAsync" Disabled="@_isSyncing" />
                        @if (_isSyncing)
                        {
                            <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" Height="30px" Width="30px" />
                        }
                    </div>
                </div>

                <div id="sync-output">
                    @if (LatestSyncRun is { } latest)
                    {
                        <p class="mb-1">
                            <strong>@L["LatestSyncRunLabel"]</strong>
                            @latest.StartedUtc.ToLocalTime().ToString("g")
                            @(latest.Success ? L["SyncSucceeded"] : L["SyncRunFailed"])
                            @SyncTypeLabel(latest.SyncType)
                        </p>
                        <button type="button" class="btn btn-sm btn-outline-primary mb-2" @onclick="ShowLatestRunInHistoryAsync">@L["ShowLatestSyncRun"]</button>
                    }
                    <DownloadProgressPanel IsActive="_isSyncing" />
                </div>
            </div>
        </div>

        <div>
            @if (_confirmingRemove)
            {
                <div class="d-flex gap-2 align-items-center p-3 border border-danger rounded">
                    <p class="mb-0">@L["ConfirmRemovePrompt"]</p>
                    <SfButton CssClass="e-danger" Content="@L["YesRemove"]" OnClick="ConfirmRemoveAsync" Disabled="@_isBusy" />
                    <SfButton CssClass="e-outline" Content="@L["Cancel"]" OnClick="CancelRemove" Disabled="@_isBusy" />
                </div>
            }
            else
            {
                <SfButton CssClass="e-danger" Content="@L["RemoveAccount"]" OnClick="PromptRemove" Disabled="@_isBusy" />
            }
        </div>

        <div id="sync-history" class="mb-4">
            <h5>@L["SyncHistoryTitle"]</h5>
            @if (_syncRunsError)
            {
                <p class="text-danger">@L["LoadListError"]</p>
            }
            else if (_syncRuns is not null && _syncRuns.Count == 0)
            {
                <p>@L["SyncNoRuns"]</p>
            }
            else if (_syncRuns is not null)
            {
                <div class="table-responsive">
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@L["ColSyncTime"]</th>
                            <th>@L["ColSyncStatus"]</th>
                            <th>@L["ColSyncType"]</th>
                            <th>@L["ColSyncRecords"]</th>
                            <th>@L["ColDetails"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var run in _syncRuns)
                        {
                            <tr class="sync-run-row">
                                <td>@run.StartedUtc.ToLocalTime().ToString("g")</td>
                                <td>@(run.Success ? L["SyncSucceeded"] : L["SyncRunFailed"])</td>
                                <td>@SyncTypeLabel(run.SyncType)</td>
                                <td>@RecordsText(run.DevicesSynced, run.LocationsSynced, run.EventsSynced, run.ConfigAreasSynced, run.FeedsFailed, run.SnapshotsSynced)</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => ToggleRunDetailsAsync(run.Id)">@L["ColDetails"]</button>
                                </td>
                            </tr>
                            @if (_expandedRunId == run.Id)
                            {
                                <tr class="sync-run-detail">
                                    <td colspan="5">
                                        @if (_runDetailError)
                                        {
                                            <p class="text-danger mb-0">@L["SyncDetailsError"]</p>
                                        }
                                        else if (_runDetail is not null)
                                        {
                                            <strong>@L["SyncDetailsTitle"]</strong>
                                            <p class="mb-1"><strong>@L["SyncDetailsStarted"]</strong> @_runDetail.StartedUtc.ToLocalTime().ToString("g")</p>
                                            <p class="mb-1"><strong>@L["SyncDetailsCompleted"]</strong> @(_runDetail.CompletedUtc?.ToLocalTime().ToString("g") ?? L["SyncNotCompleted"])</p>
                                            <p class="mb-1"><strong>@L["ColSyncStatus"]</strong> @(_runDetail.Success ? L["SyncSucceeded"] : L["SyncRunFailed"])</p>
                                            <p class="mb-1"><strong>@L["ColSyncType"]</strong> @SyncTypeLabel(_runDetail.SyncType)</p>
                                            <p class="mb-1"><strong>@L["ColSyncRecords"]</strong> @RecordsText(_runDetail.DevicesSynced, _runDetail.LocationsSynced, _runDetail.EventsSynced, _runDetail.ConfigAreasSynced, _runDetail.FeedsFailed, _runDetail.SnapshotsSynced)</p>
                                            @if (!string.IsNullOrEmpty(_runDetail.ErrorMessage))
                                            {
                                                <p class="mb-0"><strong>@L["SyncDetailsMessage"]</strong> @_runDetail.ErrorMessage</p>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
                </div>
            }
        </div>

        <div id="attached-cases" class="mb-4">
            <h5>@L["AttachedCasesTitle"]</h5>
            @if (_casesError)
            {
                <p class="text-danger">@L["LoadListError"]</p>
            }
            else if (_cases is not null && _cases.Count == 0)
            {
                <p>@L["CasesNone"]</p>
            }
            else if (_cases is not null)
            {
                <table class="table table-sm">
                    <thead>
                        <tr>
                            <th>@L["ColCaseType"]</th>
                            <th>@L["ColEventDate"]</th>
                            <th>@L["ColCreatedDate"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var caseRow in _cases)
                        {
                            <tr class="case-row">
                                <td>@CaseTypeLabel(caseRow.CaseType)</td>
                                <td data-col="event-date">@(caseRow.ScopeFromUtc?.ToLocalTime().ToString("d"))</td>
                                <td>@caseRow.CreatedAtUtc.ToLocalTime().ToString("g")</td>
                                <td>
                                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => OpenCase(caseRow.Id)">@L["OpenCase"]</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>

        @if (_account is not null)
        {
            <ReAuthDialog @bind-Visible="_reAuthDialogVisible"
                          ProviderName="@_account.ProviderName"
                          InitialEmail="@_accountEmail"
                          OnAuthenticated="HandleReAuthenticatedAsync" />
        }

        <SfToast @ref="_toastRef" />
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private List<(string Label, string? Url)> _breadcrumbItems = new();
    private VideoForensics.Data.Common.Entities.ProviderAccount? _account;
    private string? _accountEmail;
    private const string SinceLastRange = "SinceLast";
    private const string CustomRange = "Custom";
    private const int CustomRangeDefaultDays = 30;

    private bool _isLoading = true;
    private bool _isBusy;
    private bool _confirmingRemove;
    private bool _reAuthDialogVisible;
    private bool _isSyncing;
    private string? _statusMessage;
    private SfToast _toastRef = null!;
    private List<VideoForensics.Core.Api.Contracts.ProviderSyncRunSummaryDto>? _syncRuns;
    private bool _syncRunsError;
    private List<VideoForensics.Core.Api.Contracts.AccountCaseDto>? _cases;
    private bool _casesError;
    private Guid? _expandedRunId;
    private VideoForensics.Core.Api.Contracts.ProviderSyncRunDetailDto? _runDetail;
    private bool _runDetailError;
    private string _syncType = "Events";
    private string _syncRange = SinceLastRange;
    private DateOnly _customStart = DateOnly.FromDateTime(DateTime.Today.AddDays(-CustomRangeDefaultDays));
    private DateOnly _customEnd = DateOnly.FromDateTime(DateTime.Today);

    /// <summary>The most recent sync run by start time, or null when there are none or the list failed to load.</summary>
    private VideoForensics.Core.Api.Contracts.ProviderSyncRunSummaryDto? LatestSyncRun =>
        _syncRuns?.OrderByDescending(r => r.StartedUtc).FirstOrDefault();

    private string CustomStartText => _customStart.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    private string CustomEndText => _customEnd.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    private VideoForensics.Core.Api.Contracts.ProviderSyncRunSummaryDto? LatestRun =>
        _syncRuns?.OrderByDescending(r => r.StartedUtc).FirstOrDefault();

    private void OnRangeChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        _syncRange = e.Value?.ToString() ?? "30";
        if (_syncRange == SyncRequestBuilder.CustomRange)
        {
            (_customStart, _customEnd) = SyncRequestBuilder.DefaultCustomRange(DateTime.Today);
        }
    }

    private string SyncTypeChoiceLabel(string type) => type switch
    {
        "Events" => L["SyncChoiceEvents"],
        "Snapshots" => L["SyncChoiceSnapshots"],
        _ => L["SyncChoiceAll"],
    };

    private string RangeLabel(string range) => range switch
    {
        "30" => L["SyncRange30"],
        "60" => L["SyncRange60"],
        "90" => L["SyncRange90"],
        "365" => L["SyncRange365"],
        SyncRequestBuilder.AllRange => L["SyncRangeAll"],
        _ => L["SyncRangeCustom"],
    };

    private string SyncTypeLabel(string? type) => type switch
    {
        "Full" => L["SyncTypeFull"],
        "Incremental" => L["SyncTypeIncremental"],
        _ => L["SyncTypeUnknown"],
    };

    protected override async Task OnInitializedAsync()
    {
        _breadcrumbItems = new() { (L["BreadcrumbAccounts"], "/accounts"), (L["BreadcrumbAccountDetails"], null) };
        await LoadAccountAsync();
        // Render the account card first; the lists load after it and don't hold it up.
        StateHasChanged();
        if (_account is not null)
        {
            await LoadListsAsync();
        }
    }

    private async Task LoadListsAsync()
    {
        await LoadSyncRunsAsync();
        await LoadCasesAsync();
    }

    private void OnCustomStartChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _customStart = ParseDate(e.Value, _customStart);

    private void OnCustomEndChanged(Microsoft.AspNetCore.Components.ChangeEventArgs e) => _customEnd = ParseDate(e.Value, _customEnd);

    private static DateOnly ParseDate(object? value, DateOnly fallback) =>
        DateOnly.TryParseExact(value?.ToString(), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out DateOnly parsed)
            ? parsed
            : fallback;

    private async Task ShowLatestRunInHistoryAsync()
    {
        if (LatestSyncRun is { } latest && _expandedRunId != latest.Id)
        {
            await ToggleRunDetailsAsync(latest.Id);
        }
    }

    private async Task LoadSyncRunsAsync()
    {
        _expandedRunId = null;
        _runDetail = null;
        _runDetailError = false;
        try
        {
            _syncRuns = await GetApiAsync<List<VideoForensics.Core.Api.Contracts.ProviderSyncRunSummaryDto>>(
                $"api/v1/accounts/provider-accounts/{Id}/sync-runs") ?? new();
            _syncRunsError = false;
        }
        catch
        {
            _syncRuns = null;
            _syncRunsError = true;
        }
        StateHasChanged();
    }

    private async Task LoadCasesAsync()
    {
        try
        {
            _cases = await GetApiAsync<List<VideoForensics.Core.Api.Contracts.AccountCaseDto>>(
                $"api/v1/accounts/provider-accounts/{Id}/cases") ?? new();
            _casesError = false;
        }
        catch
        {
            _cases = null;
            _casesError = true;
        }
        StateHasChanged();
    }

    private async Task ToggleRunDetailsAsync(Guid runId)
    {
        if (_expandedRunId == runId)
        {
            _expandedRunId = null;
            _runDetail = null;
            _runDetailError = false;
            return;
        }

        _expandedRunId = runId;
        _runDetail = null;
        _runDetailError = false;
        try
        {
            var detail = await GetApiAsync<VideoForensics.Core.Api.Contracts.ProviderSyncRunDetailDto>(
                $"api/v1/accounts/provider-accounts/{Id}/sync-runs/{runId}");
            if (_expandedRunId == runId)
            {
                _runDetail = detail;
            }
        }
        catch
        {
            if (_expandedRunId == runId)
            {
                _runDetailError = true;
            }
        }
    }

    private void OpenCase(Guid caseId)
    {
        NavigationManager.NavigateTo($"/cases/{caseId}");
    }

    /// <summary>Localized label for a sync run's type. Unrecognized or old values show as Unknown.</summary>
    private string SyncTypeLabel(string? syncType) => syncType switch
    {
        "Full" => L["SyncTypeFull"].Value,
        "Events" => L["SyncTypeEvents"].Value,
        "Snapshots" => L["SyncTypeSnapshots"].Value,
        _ => L["SyncTypeUnknown"].Value,
    };

    /// <summary>Localized record counts for a sync run; "Not recorded" when the run has no counts (rows older than the counts).</summary>
    private string RecordsText(int? devices, int? locations, int? events, int? configAreas, int? feedsFailed, int? snapshots = null) =>
        SyncRequestBuilder.FormatRecords(L["SyncRecordsSummary"].Value, devices, locations, events, configAreas, feedsFailed, snapshots, L["SyncRecordsSnapshots"].Value)
            ?? L["SyncRecordsUnknown"].Value;

    /// <summary>
    /// GET against the account API with the paired-device bearer token.
    /// </summary>
    private async Task<T?> GetApiAsync<T>(string relativePath)
    {
        using HttpResponseMessage response = await SendApiAsync(HttpMethod.Get, relativePath);
        response.EnsureSuccessStatusCode();
        return await response.Content.ReadFromJsonAsync<T>(CancellationToken.None);
    }

    /// <summary>
    /// Sends a request to the account API with the paired-device bearer token and an optional JSON body.
    /// The injected HttpClient has no base address or auth header in production, so the absolute URI and
    /// header are set per request. The caller disposes the response.
    /// </summary>
    private async Task<HttpResponseMessage> SendApiAsync(HttpMethod method, string relativePath, object? body = null)
    {
        await SessionState.EnsureLoadedAsync();
        using var request = new HttpRequestMessage(method, new Uri(new Uri(NavigationManager.BaseUri), relativePath));
        request.Headers.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
        if (body is not null)
        {
            request.Content = JsonContent.Create(body, options: System.Text.Json.JsonSerializerOptions.Web);
        }
        return await HttpClient.SendAsync(request, CancellationToken.None);
    }

    private async Task LoadAccountAsync()
    {
        _isLoading = true;
        _statusMessage = null;
        try
        {
            _account = await ProviderAccountRepository.GetAsync(Id, CancellationToken.None);

            if (_account is not null)
            {
                try
                {
                    // The provider login (email for Ring) is the account's name.
                    var user = await UserRepository.GetAsync(_account.UserId, CancellationToken.None);
                    _accountEmail = user?.ProviderUserKey;
                }
                catch
                {
                    // Fall back to ProviderName if user lookup fails
                }

            }
        }
        catch (Exception ex)
        {
            _statusMessage = L["ErrorLoadingAccount", ex.Message];
        }
        finally
        {
            _isLoading = false;
        }
    }

    /// <summary>Maps the API's CaseType value to its localized label; unknown values show as Other.</summary>
    private string CaseTypeLabel(string caseType) => caseType switch
    {
        "Detected" => L["CaseTypeDetected"],
        "Suspected" => L["CaseTypeSuspected"],
        "Manual" => L["CaseTypeManual"],
        _ => L["CaseTypeOther"],
    };

    private void GoToSyncSchedule()
    {
        NavigationManager.NavigateTo($"/accounts/{Id}/schedule");
    }

    private void PromptRemove()
    {
        _confirmingRemove = true;
    }

    private void CancelRemove()
    {
        _confirmingRemove = false;
    }

    private async Task ConfirmRemoveAsync()
    {
        _isBusy = true;
        _confirmingRemove = false;
        _statusMessage = null;
        try
        {
            await SessionState.EnsureLoadedAsync();
            // Session state loads lazily; the token is only populated after this.
            // Removing an account is protected by StepUpEndpointFilter: a fresh passkey assertion must accompany the call.
            var stepUpToken = await StepUp.GetStepUpTokenAsync();
            using var client = new HttpClient { BaseAddress = new Uri(NavigationManager.BaseUri) };
            client.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", SessionState.SessionToken);
            client.DefaultRequestHeaders.Add("X-StepUp-Token", stepUpToken);
            using HttpResponseMessage response = await client.DeleteAsync($"api/v1/accounts/provider-accounts/{Id}", CancellationToken.None);
            response.EnsureSuccessStatusCode();

            if (ForensicsConfig.ActiveProviderAccountId == Id)
            {
                ForensicsConfig.ActiveProviderAccountId = null;
                try
                {
                    await ForensicsConfigService.SaveConfigurationAsync(ForensicsConfig);
                }
                catch (NotSupportedException)
                {
                    _statusMessage = L["SettingServerOnly"];
                    _isBusy = false;
                    return;
                }
            }

            NavigationManager.NavigateTo("/accounts");
        }
        catch (Exception ex)
        {
            _statusMessage = L["ErrorRemovingAccount", ex.Message];
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task HandleReAuthenticatedAsync(AuthResult result)
    {
        if (result.Success)
        {
            await LoadAccountAsync();
        }
    }

    /// <summary>Builds the sync-now body from the panel: a custom range runs from the start day through the end day, local time.</summary>
    private VideoForensics.Core.Api.Contracts.SyncNowRequest BuildSyncNowRequest() =>
        SyncRequestBuilder.Build(_syncType, _syncRange, _customStart, _customEnd);

    private async Task SyncNowAsync()
    {
        _isSyncing = true;
        try
        {
            using HttpResponseMessage response = await SendApiAsync(
                HttpMethod.Post, $"api/v1/accounts/provider-accounts/{Id}/sync-now", BuildSyncNowRequest());

            if (response.IsSuccessStatusCode)
            {
                await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
                {
                    Title = L["SyncStarted"],
                    Icon = "e-success"
                });

                // Reload account details after a delay to show updated timestamp
                await Task.Delay(2000);
                await LoadAccountAsync();
                await LoadSyncRunsAsync();
            }
            else
            {
                await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
                {
                    Title = L["SyncFailed"],
                    Icon = "e-danger"
                });
            }
        }
        catch (Exception ex)
        {
            await _toastRef.ShowAsync(new Syncfusion.Blazor.Notifications.ToastModel
            {
                Title = L["ErrorTitle"],
                Content = ex.Message,
                Icon = "e-danger"
            });
        }
        finally
        {
            _isSyncing = false;
        }
    }
}
