@page "/cases"
@using VideoForensics.Client.Ui.Shared.Services.Time
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Client.Ui.Shared.Components.Inspector
@using VideoForensics.Client.Ui.Shared.Components.Scope
@using VideoForensics.Client.Ui.Shared.Layout.RightPanel
@using VideoForensics.Client.Ui.Shared.Layout.LeftPanel
@using VideoForensics.Client.Ui.Shared.Services
@using VideoForensics.Client.Ui.Shared.Services.Cases
@using VideoForensics.Client.Ui.Shared.Services.Inspector
@implements IAsyncDisposable
@inject ICaseRepository CaseRepository
@inject NavigationManager NavigationManager
@inject PairedSessionState SessionState
@inject InspectorState InspectorState
@inject IStringLocalizer<Cases> L

    <h4 class="mb-4">@L["CasesTitle"]</h4>

<PageRightPanelContent>
    <ScopeRail />
    <div class="right-panel-section">
    <small style="font-weight: bold;">@L["FilterStatus"]</small>
    <select @bind="_statusFilter" @bind:after="LoadCases" class="form-select" aria-label="@L["FilterStatus"]" data-testid="case-status-filter">
        <option value="">@L["FilterAll"]</option>
        <option value="Open">@L["FilterOpen"]</option>
        <option value="Closed">@L["FilterClosed"]</option>
    </select>
    </div>
</PageRightPanelContent>

<div class="mb-3 d-flex gap-2">
    @if (SessionState.OperatorId.HasValue && Enum.TryParse(SessionState.Role, out OperatorRole role) && role >= OperatorRole.Review)
    {
    <button class="btn btn-primary" @onclick="NavigateToNewCase" data-testid="new-case">@L["NewCase"]</button>
    }
</div>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_cases is null || _cases.Count == 0)
{
    <p>@L["NoCasesFound"]</p>
}
else
{
    <ForensicGrid TItem="ForensicCase"
              DataSource="@_cases"
              OnRowSelected="@OnCaseSelected"
              ToInspector="@(c => new InspectorModel(c.CaseNumber, new { CaseNumber = c.CaseNumber, Title = c.Title, Status = c.Status.ToString(), Created = Zone.Format(c.CreatedAtUtc, "u"), Updated = Zone.Format(c.UpdatedAtUtc, "u") }))">
    <Columns>
        <GridColumn Field="@nameof(ForensicCase.CaseNumber)" HeaderText="@L["ColumnCaseNumber"]" Width="120"></GridColumn>
        <GridColumn Field="@nameof(ForensicCase.Title)" HeaderText="@L["ColumnTitle"]" Width="250"></GridColumn>
        <GridColumn Field="@nameof(ForensicCase.Status)" HeaderText="@L["ColumnStatus"]" Width="100"></GridColumn>
        <GridColumn Field="@nameof(ForensicCase.CreatedAtUtc)" HeaderText="@L["ColumnCreated"]" Width="150"><Template><LocalTimeText Value="@((context as ForensicCase)!.CreatedAtUtc)" Format="u" /></Template></GridColumn>
        <GridColumn Field="@nameof(ForensicCase.UpdatedAtUtc)" HeaderText="@L["ColumnUpdated"]" Width="150"><Template><LocalTimeText Value="@((context as ForensicCase)!.UpdatedAtUtc)" Format="u" /></Template></GridColumn>
    </Columns>
    </ForensicGrid>
}

@code {
    [CascadingParameter]
    private UserTimeZone? UserTz { get; set; }

    private UserTimeZone Zone => UserTz ?? new UserTimeZone(TimeZoneInfo.Local);

    private IReadOnlyList<ForensicCase>? _cases;
    private string _statusFilter = "Open";
    private bool _isLoading = true;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadCases();
    }

    private async Task LoadCases()
    {
        try
        {
            _isLoading = true;
            _error = null;

            CaseStatus? status = _statusFilter switch
            {
                "Open" => CaseStatus.Open,
                "Closed" => CaseStatus.Closed,
                _ => null
            };

            _cases = await CaseRepository.ListAsync(status, CancellationToken.None);
        }
        catch (Exception ex)
        {
            _error = L["FailedToLoadCases", ex.Message].Value;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnCaseSelected(ForensicCase @case)
    {
        NavigationManager.NavigateTo($"/cases/{@case.Id}");
    }

    private void NavigateToNewCase()
    {
        NavigationManager.NavigateTo("/cases/new");
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        await Task.CompletedTask;
    }
}
