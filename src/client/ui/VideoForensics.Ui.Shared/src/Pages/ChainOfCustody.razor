@page "/analyze/chain-of-custody"
@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Core.Contracts
@using VideoForensics.Data.Core.Models
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Services
@using Syncfusion.Blazor.Calendars
@using VideoForensics.Ui.Shared.Components.Scope
@using VideoForensics.Ui.Shared.Services.Scope
@inject PairedSessionState SessionState
@inject IReportGenerationService ReportGenerationService
@inject IDeviceRepository DeviceRepository
@inject NavigationManager NavigationManager
@inject IStringLocalizer<ChainOfCustody> L

<h4 class="mb-4">@L["Title"]</h4>

@if (_isLoading)
{
    <SfProgressBar Type="Syncfusion.Blazor.ProgressBar.ProgressType.Circular" IsIndeterminate="true" />
}
else if (!_isAuthenticated)
{
    <div class="alert alert-warning">@L["NotSignedIn"] <a href="@NavigationManager.SignInPathWithReturnUrl()">@L["SignIn"]</a> @L["SignInToViewChainOfCustody"]</div>
}
else
{
    <PageRightPanelContent>
        <div class="right-panel-section">
            <h6>@L["Filters"]</h6>
            <DeviceOwnershipFilters Devices="_devices" VisibleDevicesChanged="OnDeviceFilterChanged" />
            <SfDropDownList TValue="string" TItem="KeyValuePair<string, string>" @bind-Value="_selectedDeviceId" DataSource="@DeviceOptions"
                Placeholder="@L["AllDevicesPlaceholder"]" class="w-100 mt-2" ValueChange="@(async (ChangeEventArgs<string, KeyValuePair<string, string>> args) => await RunReportAsync())">
                <DropDownListFieldSettings Text="Value" Value="Key"></DropDownListFieldSettings>
            </SfDropDownList>
            <small class="mt-3">@L["FromLabel"]</small>
            <SfDatePicker TValue="DateTime" @bind-Value="_fromDate" ValueChange="RunReportAsync" CssClass="w-100" />
            <small class="mt-2">@L["ToLabel"]</small>
            <SfDatePicker TValue="DateTime" @bind-Value="_toDate" ValueChange="RunReportAsync" CssClass="w-100" />
            <SfButton Content="@L["RunReport"]" OnClick="RunReportAsync" CssClass="e-primary" class="mt-3 w-100" />
        </div>

    </PageRightPanelContent>

    @if (_report is not null)
    {
        @if (_report.ChainIntegrityVerified)
        {
            <div class="alert alert-success">@L["ChainIntegrityVerified"]</div>
        }
        else
        {
            <div class="alert alert-danger">@L["ChainIntegrityFailed", _report.ChainVerificationStatus]</div>
        }

        <h5 class="mt-4 mb-2">@L["AuditTrailTitle"]</h5>
        @if (_report.AuditTrail.Count == 0)
        {
            <p>@L["NoAuditTrailFound"]</p>
        }
        else
        {
            <SfGrid TValue="ActionLogEntry" DataSource="@_filteredAuditTrail" AllowSorting="true" AllowPaging="true" AllowFiltering="true" AllowResizing="true">
                <GridFilterSettings Type="Syncfusion.Blazor.Grids.FilterType.CheckBox"></GridFilterSettings>
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridColumns>
                    <GridColumn Field="@nameof(ActionLogEntry.TimestampUtc)" HeaderText="@L["ColTimestamp"]" MinWidth="100" />
                    <GridColumn Field="@nameof(ActionLogEntry.Actor)" HeaderText="@L["ColActor"]" MinWidth="100" />
                    <GridColumn Field="@nameof(ActionLogEntry.ActorType)" HeaderText="@L["ColActorType"]" MinWidth="100" />
                    <GridColumn Field="@nameof(ActionLogEntry.Action)" HeaderText="@L["ColAction"]" MinWidth="100" />
                    <GridColumn Field="@nameof(ActionLogEntry.EntityType)" HeaderText="@L["ColEntityType"]" MinWidth="100" />
                    <GridColumn HeaderText="@L["ColEntityId"]" MinWidth="100">
                        <Template>
                            @{
                                var entry = (ActionLogEntry)context;
                                @(entry.EntityId?.ToString("N")[..8] ?? "-")
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        }
    }
}

@code {
    private bool _isLoading = true;
    private bool _isAuthenticated;
    private List<VideoForensics.Data.Common.Entities.Device> _devices = new();
    private string _selectedDeviceId = string.Empty;
    private DateTime _fromDate = DateTime.UtcNow.AddDays(-90).Date;
    private DateTime _toDate = DateTime.UtcNow.Date;
    private ChainOfCustodyReport? _report;
    private IEnumerable<ActionLogEntry> _filteredAuditTrail = new List<ActionLogEntry>();

    // Provider/Account filters narrow this list. While a filter is set there is no "all devices" choice:
    // the report is for one device, so an empty selection falls back to the first visible device.
    private List<VideoForensics.Data.Common.Entities.Device> _visibleDevices = new();
    private bool _isFiltered;

    private IEnumerable<KeyValuePair<string, string>> DeviceOptions =>
        _visibleDevices.Select(d => new KeyValuePair<string, string>(d.Id.ToString(), d.Name));

    private async Task OnDeviceFilterChanged(DeviceFilterResult result)
    {
        _isFiltered = result.IsFiltered;
        _visibleDevices = result.Devices.ToList();
        if (_isFiltered && !_visibleDevices.Any(d => d.Id.ToString() == _selectedDeviceId))
        {
            _selectedDeviceId = _visibleDevices.FirstOrDefault()?.Id.ToString() ?? string.Empty;
        }

        await RunReportAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Chain of custody reads the server database only, so the paired operator session is the
            // gate, not whether a provider (Ring) account is linked.
            await SessionState.EnsureLoadedAsync();
            _isAuthenticated = SessionState.IsSignedIn;
            if (_isAuthenticated)
            {
                var devices = await DeviceRepository.ListAsync(CancellationToken.None);
                _devices = devices.ToList();
                _visibleDevices = _devices;
                await RunReportAsync();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task RunReportAsync()
    {
        // A filter that leaves no device must not widen to "all devices".
        if (_isFiltered && _visibleDevices.Count == 0)
        {
            _report = null;
            _filteredAuditTrail = new List<ActionLogEntry>();
            return;
        }

        Guid? deviceId = Guid.TryParse(_selectedDeviceId, out var parsed) ? parsed : null;
        _report = await ReportGenerationService.BuildChainOfCustodyReportAsync(
            deviceId,
            _fromDate,
            _toDate,
            CancellationToken.None);
        _filteredAuditTrail = _report?.AuditTrail ?? new List<ActionLogEntry>();
    }
}
