@using VideoForensics.Ui.Shared.Services.Inspector
@using VideoForensics.Ui.Shared.Components.Dump
@implements IDisposable
@inject InspectorState InspectorState

@if (InspectorState.Current is not null)
{
    <div class="inspector-panel">
        <div class="inspector-header">
            <h3 class="inspector-title">@InspectorState.Current.Title</h3>
            <button class="inspector-close-button" data-testid="inspector-close" @onclick="OnCloseClick">✕</button>
        </div>

        <div class="inspector-tabs">
            <button class="inspector-tab @(_activeTab == "fields" ? "active" : "")"
                    data-testid="inspector-tab-fields"
                    @onclick="@(() => SelectTab("fields"))">
                Fields
            </button>
            <button class="inspector-tab @(_activeTab == "raw" ? "active" : "")"
                    data-testid="inspector-tab-raw"
                    @onclick="@(() => SelectTab("raw"))">
                Raw
            </button>
            <button class="inspector-tab @(_activeTab == "related" ? "active" : "")"
                    data-testid="inspector-tab-related"
                    @onclick="@(() => SelectTab("related"))">
                Related
            </button>
            <button class="inspector-tab @(_activeTab == "provenance" ? "active" : "")"
                    data-testid="inspector-tab-provenance"
                    @onclick="@(() => SelectTab("provenance"))">
                Provenance
            </button>
        </div>

        <div class="inspector-content">
            @if (_activeTab == "fields")
            {
                <DumpView Value="@InspectorState.Current.Fields" InitialExpandDepth="1" />
            }
            else if (_activeTab == "raw")
            {
                @if (!string.IsNullOrEmpty(InspectorState.Current.RawJson))
                {
                    <DumpView Json="@InspectorState.Current.RawJson" />
                }
                else
                {
                    <div class="muted-text">No raw provider data recorded for this item.</div>
                }
            }
            else if (_activeTab == "related")
            {
                @if (InspectorState.Current.Related != null && InspectorState.Current.Related.Count > 0)
                {
                    <div class="related-links">
                        @foreach (var link in InspectorState.Current.Related)
                        {
                            <a href="@link.Href">@link.Text</a>
                        }
                    </div>
                }
                else
                {
                    <div class="muted-text">No related items.</div>
                }
            }
            else if (_activeTab == "provenance")
            {
                @if (InspectorState.Current.Provenance != null && InspectorState.Current.Provenance.Count > 0)
                {
                    <table class="provenance-table">
                        <thead>
                            <tr>
                                <th>Key</th>
                                <th>Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in InspectorState.Current.Provenance)
                            {
                                <tr>
                                    <td>@item.Key</td>
                                    <td>@item.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="muted-text">No provenance recorded.</div>
                }
            }
        </div>
    </div>
}

@code {
    private string _activeTab = "fields";

    protected override void OnInitialized()
    {
        InspectorState.OnChange += OnInspectorChanged;
    }

    private void OnCloseClick()
    {
        InspectorState.Clear();
    }

    private void SelectTab(string tab)
    {
        _activeTab = tab;
    }

    private void OnInspectorChanged()
    {
        // Reset to fields tab when a new model is shown
        if (InspectorState.Current is not null)
        {
            _activeTab = "fields";
        }
        StateHasChanged();
    }

    public void Dispose()
    {
        InspectorState.OnChange -= OnInspectorChanged;
    }
}
