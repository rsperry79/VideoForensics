@using VideoForensics.Client.Common.Contracts
@using VideoForensics.Data.Common.Contracts
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Services.Cases
@using VideoForensics.Ui.Shared.Services.Evidence
@using VideoForensics.Ui.Shared.Services.Inspector
@using VideoForensics.Ui.Shared.Components.Dump
@implements IDisposable
@inject InspectorState InspectorState
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Resources
@inject IStringLocalizer<SharedResources> L
@inject CaseState CaseState
@inject PairedSessionState SessionState
@inject ILegalHoldRepository LegalHoldRepository
@inject IEvidenceValidationService EvidenceValidationService
@inject NavigationManager NavigationManager

@if (InspectorState.Current is not null)
{
    <div class="inspector-panel">
        <div class="inspector-header">
            <h3 class="inspector-title">@InspectorState.Current.Title</h3>
            <button class="inspector-close-button" data-testid="inspector-close" @onclick="OnCloseClick">✕</button>
        </div>

        <div class="inspector-tabs">
            <button class="inspector-tab @(_activeTab == "fields" ? "active" : "")"
                    data-testid="inspector-tab-fields"
                    @onclick="@(() => SelectTab("fields"))">
                @L["InspectorTabFields"]
            </button>
            <button class="inspector-tab @(_activeTab == "raw" ? "active" : "")"
                    data-testid="inspector-tab-raw"
                    @onclick="@(() => SelectTab("raw"))">
                @L["InspectorTabRaw"]
            </button>
            <button class="inspector-tab @(_activeTab == "related" ? "active" : "")"
                    data-testid="inspector-tab-related"
                    @onclick="@(() => SelectTab("related"))">
                @L["InspectorTabRelated"]
            </button>
            <button class="inspector-tab @(_activeTab == "provenance" ? "active" : "")"
                    data-testid="inspector-tab-provenance"
                    @onclick="@(() => SelectTab("provenance"))">
                @L["InspectorTabProvenance"]
            </button>
        </div>

        <div class="inspector-content">
            @if (_activeTab == "fields")
            {
                <DumpView Value="@InspectorState.Current.Fields" InitialExpandDepth="1" />
            }
            else if (_activeTab == "raw")
            {
                @if (!string.IsNullOrEmpty(InspectorState.Current.RawJson))
                {
                    <DumpView Json="@InspectorState.Current.RawJson" />
                }
                else
                {
                    <div class="muted-text">@L["InspectorNoRawData"]</div>
                }
            }
            else if (_activeTab == "related")
            {
                @if (InspectorState.Current.Related != null && InspectorState.Current.Related.Count > 0)
                {
                    <div class="related-links">
                        @foreach (var link in InspectorState.Current.Related)
                        {
                            <a href="@link.Href">@link.Text</a>
                        }
                    </div>
                }
                else
                {
                    <div class="muted-text">@L["InspectorNoRelated"]</div>
                }
            }
            else if (_activeTab == "provenance")
            {
                @if (InspectorState.Current.Provenance != null && InspectorState.Current.Provenance.Count > 0)
                {
                    <table class="provenance-table">
                        <thead>
                            <tr>
                                <th>@L["InspectorKey"]</th>
                                <th>@L["InspectorValue"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in InspectorState.Current.Provenance)
                            {
                                <tr>
                                    <td>@item.Key</td>
                                    <td>@item.Value</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="muted-text">@L["InspectorNoProvenance"]</div>
                }
            }
        </div>

        @if (InspectorState.Current.Pin is not null)
        {
            <div class="inspector-pin-section">
                @if (CaseState.ActiveCase is null)
                {
                    <div class="muted-text">@L["InspectorSelectCase"]</div>
                }
                else if (CaseState.ActiveCase.Status == CaseStatus.Open && _role.HasValue && _role >= OperatorRole.Review)
                {
                    <textarea class="inspector-pin-reason"
                              data-testid="pin-reason"
                              placeholder="@L["InspectorPinReason"]"
                              @bind="_pinReason"
                              @bind:event="oninput"></textarea>
                    <button type="button"
                            class="inspector-pin-button"
                            data-testid="pin-to-case"
                            disabled="@string.IsNullOrWhiteSpace(_pinReason)"
                            @onclick="OnPinClicked">
                        @L["InspectorPinTo", CaseState.ActiveCase.CaseNumber]
                    </button>
                    @if (_pinSuccessMessage is not null)
                    {
                        <div class="inspector-pin-success">@_pinSuccessMessage</div>
                    }
                    @if (_pinError is not null)
                    {
                        <div class="inspector-pin-error">@_pinError</div>
                    }
                }
            </div>
        }

        @if (EffectiveActions is not null)
        {
            <div class="inspector-actions-section">
                @if (EvidenceActions.CanPlaceHold(EffectiveActions) && _pendingAction != PendingEvidenceAction.Release)
                {
                    @if (_pendingAction == PendingEvidenceAction.Hold)
                    {
                        <textarea class="inspector-action-reason"
                                  data-testid="hold-reason"
                                  placeholder="@L["InspectorHoldReason"]"
                                  @bind="_actionReasonInput"
                                  @bind:event="oninput"></textarea>
                        <button type="button" data-testid="confirm-place-hold"
                                disabled="@string.IsNullOrWhiteSpace(_actionReasonInput)"
                                @onclick="OnConfirmPlaceHoldClicked">
                            @L["InspectorConfirm"]
                        </button>
                        <button type="button" data-testid="cancel-evidence-action" @onclick="OnCancelActionClicked">
                            @L["InspectorCancel"]
                        </button>
                    }
                    else
                    {
                        <button type="button" data-testid="place-legal-hold" @onclick="@(() => BeginAction(PendingEvidenceAction.Hold))">
                            @L["InspectorPlaceHold"]
                        </button>
                    }
                }

                @if (EvidenceActions.CanReleaseHold(EffectiveActions) && _pendingAction != PendingEvidenceAction.Hold)
                {
                    @if (_pendingAction == PendingEvidenceAction.Release)
                    {
                        <textarea class="inspector-action-reason"
                                  data-testid="hold-reason"
                                  placeholder="@L["InspectorReleaseReason"]"
                                  @bind="_actionReasonInput"
                                  @bind:event="oninput"></textarea>
                        <button type="button" data-testid="confirm-release-hold"
                                disabled="@string.IsNullOrWhiteSpace(_actionReasonInput)"
                                @onclick="OnConfirmReleaseClicked">
                            @L["InspectorConfirm"]
                        </button>
                        <button type="button" data-testid="cancel-evidence-action" @onclick="OnCancelActionClicked">
                            @L["InspectorCancel"]
                        </button>
                    }
                    else
                    {
                        <button type="button" data-testid="release-legal-hold" @onclick="@(() => BeginAction(PendingEvidenceAction.Release))">
                            @L["InspectorReleaseHold"]
                        </button>
                    }
                }

                @if (EvidenceActions.CanVerifyIntegrity(EffectiveActions))
                {
                    <button type="button" data-testid="verify-integrity" @onclick="OnVerifyIntegrityClicked">
                        @L["InspectorVerifyIntegrity"]
                    </button>
                }

                @if (EvidenceActions.CanExport(EffectiveActions))
                {
                    <button type="button" data-testid="export-evidence" @onclick="OnExportClicked">
                        @L["InspectorExport"]
                    </button>
                }

                @if (_actionSuccessMessage is not null)
                {
                    <div class="inspector-action-success">@_actionSuccessMessage</div>
                }
                @if (_actionError is not null)
                {
                    <div class="inspector-action-error">@_actionError</div>
                }
            </div>
        }
    </div>
}

@code {
    private enum PendingEvidenceAction { None, Hold, Release }

    private string _activeTab = "fields";
    private string _pinReason = string.Empty;
    private string? _pinError;
    private string? _pinSuccessMessage;
    private OperatorRole? _role;

    private PendingEvidenceAction _pendingAction = PendingEvidenceAction.None;
    private string _actionReasonInput = string.Empty;
    private string? _actionSuccessMessage;
    private string? _actionError;

    // Local override of the on-hold state shown to the operator immediately after placing/releasing
    // a hold, without needing to re-fetch or re-map the inspected item. Reset whenever a different
    // item is shown (see OnInspectorChanged); until then it takes precedence over the model's own
    // InspectorState.Current.Actions.ActiveHoldId.
    private bool _hasHoldOverride;
    private Guid? _holdOverrideActiveHoldId;

    protected override async Task OnInitializedAsync()
    {
        InspectorState.OnChange += OnInspectorChanged;
        CaseState.OnChange += OnCaseStateChanged;

        await SessionState.EnsureLoadedAsync();
        _role = SessionState.Role is not null && Enum.TryParse<OperatorRole>(SessionState.Role, out var role) ? role : null;
    }

    private void OnCloseClick()
    {
        InspectorState.Clear();
    }

    private void SelectTab(string tab)
    {
        _activeTab = tab;
    }

    private void OnInspectorChanged()
    {
        // Reset to fields tab and clear the pin form when a new model is shown
        if (InspectorState.Current is not null)
        {
            _activeTab = "fields";
        }

        _pinReason = string.Empty;
        _pinError = null;
        _pinSuccessMessage = null;

        _pendingAction = PendingEvidenceAction.None;
        _actionReasonInput = string.Empty;
        _actionSuccessMessage = null;
        _actionError = null;
        _hasHoldOverride = false;
        _holdOverrideActiveHoldId = null;

        StateHasChanged();
    }

    private void OnCaseStateChanged()
    {
        // CaseState can change from outside this component (e.g. another component sharing the
        // same scoped CaseState instance), so marshal back onto the sync context.
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task OnPinClicked()
    {
        var pin = InspectorState.Current?.Pin;
        if (pin is null || CaseState.ActiveCase is null || string.IsNullOrWhiteSpace(_pinReason))
        {
            return;
        }

        _pinError = null;
        _pinSuccessMessage = null;
        var caseNumber = CaseState.ActiveCase.CaseNumber;
        var actor = SessionState.OperatorId?.ToString() ?? "unknown";

        try
        {
            await CaseState.PinAsync(pin.Kind, pin.TargetId, _pinReason, actor, CancellationToken.None);
            _pinSuccessMessage = L["InspectorPinnedTo", caseNumber].Value;
        }
        catch (InvalidOperationException ex)
        {
            _pinError = ex.Message;
        }
    }

    /// <summary>
    /// The inspected item's Actions with the local hold-placed/released override applied (set right
    /// after a successful action, see <see cref="OnConfirmPlaceHoldClicked"/>/
    /// <see cref="OnConfirmReleaseClicked"/>), so the button set flips immediately without needing
    /// the host page to re-map and re-show a fresh InspectorModel. Null when the inspected item
    /// carries no evidence actions at all (e.g. Query API/Self-Test inspector uses).
    /// </summary>
    private EvidenceActionState? EffectiveActions
    {
        get
        {
            var actions = InspectorState.Current?.Actions;
            if (actions is null)
            {
                return null;
            }

            return _hasHoldOverride ? actions with { ActiveHoldId = _holdOverrideActiveHoldId } : actions;
        }
    }

    private void BeginAction(PendingEvidenceAction action)
    {
        _pendingAction = action;
        _actionReasonInput = string.Empty;
        _actionSuccessMessage = null;
        _actionError = null;
    }

    private void OnCancelActionClicked()
    {
        _pendingAction = PendingEvidenceAction.None;
        _actionReasonInput = string.Empty;
    }

    private async Task OnConfirmPlaceHoldClicked()
    {
        var actions = InspectorState.Current?.Actions;
        if (actions?.MediaItemId is not { } mediaItemId || string.IsNullOrWhiteSpace(_actionReasonInput))
        {
            return;
        }

        _actionError = null;

        // Never fall back to a machine-level identity (e.g. Environment.UserName) if no operator
        // is signed in - that would misattribute the action in the chain of custody. Refuse instead.
        var actor = EvidenceActions.ResolveOperatorActor(SessionState.OperatorId);
        if (actor is null)
        {
            _actionError = L["InspectorSignInRequired"].Value;
            _pendingAction = PendingEvidenceAction.None;
            _actionReasonInput = string.Empty;
            return;
        }

        try
        {
            var hold = await LegalHoldRepository.PlaceAsync(mediaItemId, _actionReasonInput, actor, CancellationToken.None);
            _hasHoldOverride = true;
            _holdOverrideActiveHoldId = hold.Id;
            _actionSuccessMessage = L["InspectorHoldPlaced"].Value;
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _pendingAction = PendingEvidenceAction.None;
            _actionReasonInput = string.Empty;
        }
    }

    private async Task OnConfirmReleaseClicked()
    {
        var activeHoldId = EffectiveActions?.ActiveHoldId;
        if (activeHoldId is not { } holdId || string.IsNullOrWhiteSpace(_actionReasonInput))
        {
            return;
        }

        _actionError = null;

        // Never fall back to a machine-level identity (e.g. Environment.UserName) if no operator
        // is signed in - that would misattribute the action in the chain of custody. Refuse instead.
        var actor = EvidenceActions.ResolveOperatorActor(SessionState.OperatorId);
        if (actor is null)
        {
            _actionError = L["InspectorSignInRequired"].Value;
            _pendingAction = PendingEvidenceAction.None;
            _actionReasonInput = string.Empty;
            return;
        }

        try
        {
            await LegalHoldRepository.ReleaseAsync(holdId, actor, _actionReasonInput, CancellationToken.None);
            _hasHoldOverride = true;
            _holdOverrideActiveHoldId = null;
            _actionSuccessMessage = L["InspectorHoldReleased"].Value;
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
        finally
        {
            _pendingAction = PendingEvidenceAction.None;
            _actionReasonInput = string.Empty;
        }
    }

    private async Task OnVerifyIntegrityClicked()
    {
        var actions = InspectorState.Current?.Actions;
        if (actions is null)
        {
            return;
        }

        _actionError = null;
        try
        {
            var results = await EvidenceValidationService.VerifyLocalIntegrityAsync(actions.DeviceId, CancellationToken.None);
            var failed = results.Count(r => r.Status != "verified");
            _actionSuccessMessage = L["InspectorFilesVerified", results.Count - failed, results.Count].Value;
        }
        catch (Exception ex)
        {
            _actionError = ex.Message;
        }
    }

    private void OnExportClicked()
    {
        var actions = InspectorState.Current?.Actions;
        if (actions?.MediaItemId is not { } mediaItemId)
        {
            return;
        }

        NavigationManager.NavigateTo(EvidenceActions.BuildExportUrl(new[] { mediaItemId }));
    }

    public void Dispose()
    {
        InspectorState.OnChange -= OnInspectorChanged;
        CaseState.OnChange -= OnCaseStateChanged;
    }
}
