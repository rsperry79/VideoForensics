@implements IAsyncDisposable
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Resources
@inject IStringLocalizer<SharedResources> L

@if (IsActive || _hasEverStarted)
{
    <div class="download-progress-panel">
        <h3>@L["DownloadProgressTitle", CollectionType]</h3>

        @{
            var progress = _progress;
            var currentDevice = _currentDevice;
        }

        @if (progress is not null)
        {
            <p>
                @L["DownloadProgressFiles", progress.FilesCompleted, progress.FilesTotal, FormatBytes(progress.BytesDownloaded)]
            </p>
        }

        @if (currentDevice.Total > 0)
        {
            <p>@L["DownloadProgressDevice", currentDevice.Name, currentDevice.Index, currentDevice.Total]</p>
        }

        @if (!string.IsNullOrEmpty(_lastError))
        {
            <p style="color: red;">@L["DownloadProgressError", _lastError]</p>
        }

        <div class="activity-log" style="height: 200px; overflow-y: auto; border: 1px solid #ccc; padding: 4px; font-family: monospace; font-size: 0.85em;">
            @foreach (var line in _activityLog)
            {
                <div>@line</div>
            }
        </div>
    </div>
}

@code {
    private const int MaxActivityLogLines = 200;
    private static readonly TimeSpan PollInterval = TimeSpan.FromMilliseconds(500);

    [Parameter] public bool IsActive { get; set; }
    [Parameter] public IVideoDownloadService? DownloadService { get; set; }
    [Parameter] public string CollectionType { get; set; } = "Videos";

    private PeriodicTimer? _timer;
    private Task? _pollLoopTask;
    private bool _hasEverStarted;

    private DownloadStatus? _progress;
    private (int Index, int Total, string Name) _currentDevice;
    private string? _lastError;
    private readonly List<string> _activityLog = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsActive && _timer is null && DownloadService is not null)
        {
            _hasEverStarted = true;
            StartPolling();
        }
        else if (!IsActive && _timer is not null)
        {
            await StopPollingAsync();
        }

        await base.OnAfterRenderAsync(firstRender);
    }

    private void StartPolling()
    {
        _timer = new PeriodicTimer(PollInterval);
        _pollLoopTask = RunPollLoopAsync(_timer);
    }

    private async Task RunPollLoopAsync(PeriodicTimer timer)
    {
        try
        {
            while (await timer.WaitForNextTickAsync())
            {
                PollOnce();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (ObjectDisposedException)
        {
            // Timer disposed while awaiting a tick - normal shutdown path.
        }
    }

    private void PollOnce()
    {
        if (DownloadService is null)
        {
            return;
        }

        _progress = DownloadService.GetProgress();
        _currentDevice = DownloadService.GetCurrentDevice();
        _lastError = DownloadService.GetLastError();

        var drained = DownloadService.DrainActivityLog();
        if (drained.Count > 0)
        {
            _activityLog.AddRange(drained);
            if (_activityLog.Count > MaxActivityLogLines)
            {
                _activityLog.RemoveRange(0, _activityLog.Count - MaxActivityLogLines);
            }
        }
    }

    private async Task StopPollingAsync()
    {
        var timer = _timer;
        _timer = null;
        timer?.Dispose();

        if (_pollLoopTask is not null)
        {
            try
            {
                await _pollLoopTask;
            }
            catch
            {
                // Swallow - polling loop already logged/handled its own exceptions via disposal.
            }
            _pollLoopTask = null;
        }

        // One last poll to pick up any final status/activity after the download finished.
        PollOnce();
    }

    private static string FormatBytes(long bytes)
    {
        double value = bytes;
        string[] units = { "B", "KB", "MB", "GB" };
        var unitIndex = 0;
        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }
        return $"{value:0.##} {units[unitIndex]}";
    }

    public async ValueTask DisposeAsync()
    {
        await StopPollingAsync();
    }
}
