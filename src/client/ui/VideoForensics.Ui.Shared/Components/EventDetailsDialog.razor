<div style="display: flex; flex-direction: column; gap: 0.75rem;">
    @if (MediaItemId.HasValue)
    {
        @if (IsImage)
        {
            <img src="@ContentUrl" alt="Snapshot" style="max-width: 100%; max-height: 320px; object-fit: contain;" />
        }
        else if (IsVideo)
        {
            <video controls src="@ContentUrl" style="max-width: 100%; max-height: 320px;"></video>
        }
    }

    <h6>Event</h6>
    <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">Type:</span><span>@EventType</span></div>
    <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">Occurred At (UTC):</span><span>@OccurredAtUtc</span></div>
    <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">Discovered At (UTC):</span><span>@DiscoveredAtUtc</span></div>
    <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">Downloaded At (UTC):</span><span>@(DownloadedAtUtc?.ToString() ?? "-")</span></div>
    <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">Provider Event ID:</span><span>@ProviderEventId</span></div>
    @if (!string.IsNullOrEmpty(SnapshotUrl))
    {
        <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">Snapshot URL:</span><span>@SnapshotUrl</span></div>
    }

    @if (MediaItemId.HasValue)
    {
        <h6 style="margin-top: 1rem;">Downloaded Media</h6>
        <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">File Name:</span><span>@FileName</span></div>
        <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">Format:</span><span>@MediaFormat</span></div>
        <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">File Size:</span><span>@FormatFileSize(FileSizeBytes)</span></div>
        @if (!string.IsNullOrEmpty(Resolution))
        {
            <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">Resolution:</span><span>@Resolution</span></div>
        }
        <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">Integrity:</span><span>@IntegrityStatusText</span></div>
        <div style="display: flex; gap: 0.5rem;"><span style="font-weight: 500;">Legal Hold:</span><span>@LegalHoldStatusText</span></div>
    }

    <div style="display: flex; justify-content: flex-end; margin-top: 1rem;">
        <SfButton Content="Close" OnClick="@OnCloseClicked" CssClass="e-flat" />
    </div>
</div>

@code {
    [Parameter] public EventCallback OnClosed { get; set; }

    [Parameter] public string EventType { get; set; } = string.Empty;
    [Parameter] public DateTime OccurredAtUtc { get; set; }
    [Parameter] public DateTime DiscoveredAtUtc { get; set; }
    [Parameter] public DateTime? DownloadedAtUtc { get; set; }
    [Parameter] public string ProviderEventId { get; set; } = string.Empty;
    [Parameter] public string? SnapshotUrl { get; set; }

    [Parameter] public Guid? MediaItemId { get; set; }
    [Parameter] public string? FileName { get; set; }
    [Parameter] public string? MediaFormat { get; set; }
    [Parameter] public long FileSizeBytes { get; set; }
    [Parameter] public string? Resolution { get; set; }
    [Parameter] public string IntegrityStatusText { get; set; } = "-";
    [Parameter] public string LegalHoldStatusText { get; set; } = "-";

    private string ContentUrl => $"/api/media/{MediaItemId}/content";

    private bool IsImage => MediaFormat is not null &&
        (MediaFormat.Contains("jpg", StringComparison.OrdinalIgnoreCase) ||
         MediaFormat.Contains("jpeg", StringComparison.OrdinalIgnoreCase) ||
         MediaFormat.Contains("png", StringComparison.OrdinalIgnoreCase) ||
         MediaFormat.Contains("image", StringComparison.OrdinalIgnoreCase));

    private bool IsVideo => MediaFormat is not null &&
        (MediaFormat.Contains("mp4", StringComparison.OrdinalIgnoreCase) ||
         MediaFormat.Contains("video", StringComparison.OrdinalIgnoreCase));

    private async Task OnCloseClicked()
    {
        await OnClosed.InvokeAsync();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes <= 0)
        {
            return "-";
        }

        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        var unitIndex = 0;
        while (size >= 1024 && unitIndex < units.Length - 1)
        {
            size /= 1024;
            unitIndex++;
        }

        return $"{size:F1} {units[unitIndex]}";
    }
}
