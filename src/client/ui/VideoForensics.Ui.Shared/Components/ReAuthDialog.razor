@using VideoForensics.Providers.Common.Contracts
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Resources
@inject IStringLocalizer<SharedResources> L

<SfDialog @bind-Visible="Visible" Width="420px" IsModal="true" ShowCloseIcon="true" Header="@L["ReAuthTitle", ProviderName]">
    <p>@L["ReAuthPrompt"]</p>
    <AuthForm IdPrefix="reauth" SubmitLabel="@L["ReAuthLogIn"]"
              OnAuthenticated="HandleAuthenticatedAsync"
              AvailableProviders="@(new[] { ProviderName })"
              InitialEmail="@InitialEmail" />
</SfDialog>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public required string ProviderName { get; set; }
    [Parameter] public string? InitialEmail { get; set; }
    [Parameter] public EventCallback<AuthResult> OnAuthenticated { get; set; }

    private async Task HandleAuthenticatedAsync(AuthResult result)
    {
        if (result.Success)
        {
            Visible = false;
            await VisibleChanged.InvokeAsync(false);
        }

        await OnAuthenticated.InvokeAsync(result);
    }
}
