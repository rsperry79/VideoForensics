@using Microsoft.Extensions.Localization
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Resources
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Layout
@inject PairedSessionState SessionState
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@inject IUiModeService UiModeService

@* The operator's OWN login (paired-device / WebAuthn session) - kept separate from provider
   account logins, which are switched via AccountSwitcher in the right panel. *@
<div class="user-menu" data-testid="user-menu" data-role-label="@ButtonLabel">
    <SfButton Content="@ButtonLabel" CssClass="user-menu-toggle e-flat" OnClick="@Toggle" title="@L["AccountMenuTitle"]" data-testid="user-menu-toggle" />

    @if (_open)
    {
        <div class="user-menu-dropdown" data-testid="user-menu-dropdown">
            @foreach (var item in UserMenu.Items(BuildContext()))
            {
                @if (item.Action is not null)
                {
                    <button type="button" class="user-menu-item" data-testid="user-menu-item" data-action="@item.Action" @onclick="@(async () => await HandleActionAsync(item.Action))">@L[item.Text]</button>
                }
                else if (item.Path is not null)
                {
                    <button type="button" class="user-menu-item" data-testid="user-menu-item" data-path="@item.Path" @onclick="@(() => NavigateTo(item.Path))">@L[item.Text]</button>
                }
                else
                {
                    <button type="button" class="user-menu-item" data-testid="user-menu-signout" @onclick="SignOutAsync">@L[item.Text]</button>
                }
            }
        </div>
    }
</div>

@code {
    private bool _open;

    private OperatorRole? Role => SessionState.Role is not null && Enum.TryParse<OperatorRole>(SessionState.Role, out var role) ? role : null;

    private string ButtonLabel => SessionState.IsSignedIn ? (Role?.ToString() ?? L["OperatorFallback"].Value) : L["Device Sign-In"].Value;

    private NavContext BuildContext() => new(
        SessionState.IsSignedIn,
        Role,
        AppLockSupported: false,
        UiMode: UiModeService.Mode,
        UiModeLocked: UiModeService.IsLocked);

    private void Toggle()
    {
        _open = !_open;
    }

    private void NavigateTo(string path)
    {
        _open = false;
        Nav.NavigateTo(path);
    }

    private async Task SignOutAsync()
    {
        _open = false;
        await SessionState.ClearAsync();
        Nav.NavigateTo("/signin");
    }

    private async Task HandleActionAsync(string action)
    {
        _open = false;
        
        if (action.StartsWith("set-ui-mode:"))
        {
            var mode = action.Substring("set-ui-mode:".Length);
            try
            {
                await UiModeService.SetModeAsync(mode);
            }
            catch (InvalidOperationException)
            {
                // Mode is locked - just close the menu and re-render
                StateHasChanged();
            }
        }
    }
}