@namespace VideoForensics.Ui.Shared.Layout.Simple
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Resources
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Components
@implements IDisposable
@inject PairedSessionState SessionState
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@inject IUiModeService UiModeService

<div class="simple-layout">
    <header class="simple-layout-header">
        <span class="simple-layout-title">VideoForensics</span>
        <div class="simple-layout-buttons">
            @if (!UiModeService.IsLocked)
            {
                <SfButton Content="Standard view" OnClick="@SwitchToStandardAsync" CssClass="simple-layout-standard-button e-flat" />
            }
            <SfButton Content="@L["SignOut"]" OnClick="@SignOutAsync" CssClass="simple-layout-signout e-flat" />
        </div>
    </header>
    <main class="simple-layout-body">
        <div class="simple-layout-content">
            @if (IsHomeRoute())
            {
                <SimpleHome />
            }
            else
            {
                @Body
            }
        </div>
        <div class="simple-layout-chat">
            <ChatPanel />
        </div>
    </main>
</div>

@code {
    protected override void OnInitialized()
    {
        UiModeService.OnChange += StateHasChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    // Only the home routes get the plain-language home; every other route (sign-in, password change, chat, cases...) renders as routed.
    private bool IsHomeRoute()
    {
        var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        return path.Length == 0 || string.Equals(path, "/evidence", StringComparison.OrdinalIgnoreCase);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) => _ = InvokeAsync(StateHasChanged);

    private async Task SwitchToStandardAsync()
    {
        await UiModeService.SetModeAsync("Standard");
    }

    private async Task SignOutAsync()
    {
        await SessionState.ClearAsync();
        Nav.NavigateTo("/signin");
    }

    public void Dispose()
    {
        UiModeService.OnChange -= StateHasChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }
}