@inherits LayoutComponentBase
@using VideoForensics.Data.Common.Entities
@using VideoForensics.Ui.Shared.Services
@inject PairedSessionState SessionState
@inject IProviderAuthService ProviderAuth
@inject IAppLockPreferencesStore AppLockPreferences

<RadzenTheme Theme="material" />
<RadzenComponents @rendermode="InteractiveServer" />

<RadzenLayout>
    <RadzenHeader>
        <div class="app-bar">
            <RadzenText TextStyle="TextStyle.H6" class="app-bar-brand">VideoForensics</RadzenText>

            <RadzenMenu class="app-bar-menu">
                <RadzenMenuItem Text="Dashboard" Path="/" Match="NavLinkMatch.All" />
                <RadzenMenuItem Text="Full Workflow" Path="/workflow" />

                <RadzenMenuItem Text="Collect">
                    <RadzenMenuItem Text="Collect Videos" Path="/collect/videos" />
                    <RadzenMenuItem Text="Collect Snapshots" Path="/collect/snapshots" />
                </RadzenMenuItem>

                <RadzenMenuItem Text="Analyze">
                    <RadzenMenuItem Text="Forensic Reports" Path="/analyze/reports" />
                    <RadzenMenuItem Text="Signal Anomalies" Path="/analyze/signal-anomalies" />
                    <RadzenMenuItem Text="Access Control" Path="/analyze/access-control" />
                    <RadzenMenuItem Text="Chain of Custody" Path="/analyze/chain-of-custody" />
                    <RadzenMenuItem Text="Validate Evidence" Path="/analyze/validate/integrity" />
                    <RadzenMenuItem Text="Jamming Analysis" Path="/analyze/jamming" />
                </RadzenMenuItem>

                <RadzenMenuItem Text="Events" Path="/events" />

                <RadzenMenuItem Text="Devices">
                    <RadzenMenuItem Text="Device Configuration" Path="/devices/config" />
                    @if (HasRole(OperatorRole.SuperAdmin))
                    {
                        <RadzenMenuItem Text="Paired Devices" Path="/settings/devices" />
                    }
                    @if (!SessionState.IsSignedIn)
                    {
                        <RadzenMenuItem Text="Device Sign-In" Path="/device-signin" />
                    }
                </RadzenMenuItem>

                <RadzenMenuItem Text="Query API" Path="/query" />
            </RadzenMenu>

            <RadzenMenu class="app-bar-settings">
                <RadzenMenuItem Text="Settings">
                    <RadzenMenuItem Text="General" Path="/settings" />
                    <RadzenMenuItem Text="Accounts" Path="/accounts" />
                    <RadzenMenuItem Text="Infrastructure" Path="/settings/infrastructure" />
                    @if (HasRole(OperatorRole.SuperAdmin))
                    {
                        <RadzenMenuItem Text="Operators" Path="/settings/operators" />
                        <RadzenMenuItem Text="Network Access" Path="/settings/network" />
                        <RadzenMenuItem Text="Remote Access" Path="/settings/remote-access" />
                    }
                    @if (HasRole(OperatorRole.Admin))
                    {
                        <RadzenMenuItem Text="Notifications" Path="/settings/notifications" />
                        <RadzenMenuItem Text="Security Audit Log" Path="/settings/security-log" />
                    }
                    @if (AppLockPreferences.IsSupported)
                    {
                        <RadzenMenuItem Text="App Lock" Path="/settings/app-lock" />
                    }
                </RadzenMenuItem>
            </RadzenMenu>
        </div>
    </RadzenHeader>
    <RadzenBody>
        <div class="app-body">
            @Body
        </div>
    </RadzenBody>
</RadzenLayout>

@code {
    private OperatorRole? _role;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // IJSRuntime is unavailable during Blazor's static prerender pass, so the session can
            // only be resolved once the circuit is connected (same pattern as SecurityOperators.razor).
            await SessionState.EnsureLoadedAsync();
            _role = SessionState.Role is not null && Enum.TryParse<OperatorRole>(SessionState.Role, out var role) ? role : null;
            StateHasChanged();
        }
    }

    private bool HasRole(OperatorRole minimum) => SessionState.IsSignedIn && _role is not null && _role >= minimum;
}
