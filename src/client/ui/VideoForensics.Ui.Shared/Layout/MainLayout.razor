@inherits LayoutComponentBase
@using Microsoft.Extensions.Localization
@using Syncfusion.Blazor.Layouts
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Resources
@inject PairedSessionState SessionState
@inject IAppLockPreferencesStore AppLockPreferences
@inject NavigationManager Nav
@inject ThemePreferenceService ThemeService
@inject LayoutPreferencesState LayoutPrefs
@inject IStringLocalizer<SharedResources> L
@inject IServerConnectivityState ConnectivityState

<div class="app-layout">
    @if (ConnectivityState.IsUnreachable)
    {
        <div class="alert alert-danger" role="alert" style="margin: 0; border-radius: 0; border: none; padding: 12px 16px;">
            <strong>Server Not Reachable</strong> — Could not connect to the server. Please check your connection or pair a new device.
        </div>
    }

    <div class="app-header">
        <div class="app-bar">
            <SfButton Content="☰" CssClass="left-nav-toggle e-flat" OnClick="@ToggleLeftNavAsync" title="Toggle navigation" />

            <div class="top-tabs">
                @foreach (var group in VisibleGroups)
                {
                    <SfButton Content="@L[group.Text]" OnClick="@(() => Nav.NavigateTo(group.Path))"
                              CssClass="@("top-tab-button " + (group.Key == ActiveGroup.Key ? "e-primary" : "e-flat"))" />
                }
            </div>

            <SfButton Content="⚙" CssClass="right-panel-toggle e-flat" OnClick="@ToggleRightPanelAsync" title="Toggle settings panel" />
        </div>
    </div>

    <div class="app-body">
        <SfSplitter @ref="_splitter" Height="100%" Width="100%" CssClass="e-splitter-layout" Orientation="Syncfusion.Blazor.Layouts.Orientation.Horizontal">
            @if (!LayoutPrefs.LeftNavCollapsed)
            {
                <SplitterPanes>
                    <SplitterPane Size="@($"{_leftNavWidth}px")" Min="48px" Max="400px" CssClass="splitter-left-nav">
                        <div class="left-nav-items">
                            @foreach (var item in ActiveGroupItems)
                            {
                                <SfButton Content="@L[item.Text]" OnClick="@(() => Nav.NavigateTo(item.Path))"
                                          CssClass="@("left-nav-item " + (PathMatches(item.Path) ? "e-primary" : "e-flat"))" />
                            }
                        </div>
                    </SplitterPane>
                    <SplitterPane Size="*" CssClass="splitter-page-body">
                        <div class="page-body">
                            @Body
                        </div>
                    </SplitterPane>
                    @if (!LayoutPrefs.RightPanelCollapsed)
                    {
                        <SplitterPane Size="@($"{_rightPanelWidth}px")" Min="250px" Max="500px" CssClass="splitter-right-panel">
                            <RightPanelHost />
                        </SplitterPane>
                    }
                </SplitterPanes>
            }
            else
            {
                <SplitterPanes>
                    <SplitterPane Size="48px" Min="48px" Max="48px" CssClass="splitter-left-nav-collapsed">
                        <div class="left-nav-toggle-collapsed" title="Toggle navigation">
                            <SfButton Content="☰" CssClass="e-flat" OnClick="@ToggleLeftNavAsync" />
                        </div>
                    </SplitterPane>
                    <SplitterPane Size="*" CssClass="splitter-page-body">
                        <div class="page-body">
                            @Body
                        </div>
                    </SplitterPane>
                    @if (!LayoutPrefs.RightPanelCollapsed)
                    {
                        <SplitterPane Size="@($"{_rightPanelWidth}px")" Min="250px" Max="500px" CssClass="splitter-right-panel">
                            <RightPanelHost />
                        </SplitterPane>
                    }
                </SplitterPanes>
            }
        </SfSplitter>
    </div>
</div>
