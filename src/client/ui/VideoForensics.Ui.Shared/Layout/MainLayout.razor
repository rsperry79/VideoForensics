@inherits LayoutComponentBase
@using Microsoft.Extensions.Localization
@using VideoForensics.Ui.Shared.Services
@using VideoForensics.Ui.Shared.Layout.RightPanel
@using VideoForensics.Ui.Shared.Resources
@inject PairedSessionState SessionState
@inject IAppLockPreferencesStore AppLockPreferences
@inject IBlazorRenderModeProvider RenderModeProvider
@inject NavigationManager Nav
@inject ThemePreferenceService ThemeService
@inject LayoutPreferencesState LayoutPrefs
@inject IStringLocalizer<SharedResources> L

<RadzenTheme Theme="@ThemeService.EffectiveRadzenThemeName" />
<RadzenComponents @rendermode="RenderModeProvider.InteractiveServerOrNull" />

<RadzenLayout>
    <RadzenHeader>
        <div class="app-bar">
            <RadzenText TextStyle="TextStyle.H6" class="app-bar-brand">VideoForensics</RadzenText>

            <div class="top-tabs">
                @foreach (var group in VisibleGroups)
                {
                    <RadzenButton Text="@L[group.Text]" Click="@(() => Nav.NavigateTo(group.Path))"
                                  ButtonStyle="@(group.Key == ActiveGroup.Key ? ButtonStyle.Primary : ButtonStyle.Base)"
                                  Variant="Variant.Flat" class="top-tab-button" />
                }
            </div>

            <RadzenButton Icon="tune" class="right-panel-toggle" Click="@ToggleRightPanelAsync"
                          ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" title="Toggle settings panel" />
        </div>
    </RadzenHeader>

    <RadzenBody>
        <div class="docked-body">
            <div class="left-nav @(LayoutPrefs.LeftNavCollapsed ? "collapsed" : "")">
                <RadzenButton Icon="@(LayoutPrefs.LeftNavCollapsed ? "chevron_right" : "chevron_left")"
                              Click="@ToggleLeftNavAsync" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" class="left-nav-toggle" />
                @if (!LayoutPrefs.LeftNavCollapsed)
                {
                    <div class="left-nav-items">
                        @foreach (var item in ActiveGroupItems)
                        {
                            <RadzenButton Text="@L[item.Text]" Click="@(() => Nav.NavigateTo(item.Path))"
                                          ButtonStyle="@(PathMatches(item.Path) ? ButtonStyle.Primary : ButtonStyle.Base)"
                                          Variant="Variant.Flat" class="left-nav-item" />
                        }
                    </div>
                }
            </div>

            <div class="page-body">
                @Body
            </div>

            @if (!LayoutPrefs.RightPanelCollapsed)
            {
                <RightPanelHost />
            }
        </div>
    </RadzenBody>
</RadzenLayout>
