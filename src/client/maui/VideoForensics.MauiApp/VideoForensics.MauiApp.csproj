<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <!-- Directory.Build.props (src/Directory.Build.props) sets a repo-wide single TargetFramework
         (net8.0) for the console/library projects; this is the first multi-targeted-shaped MAUI
         project, so TargetFramework must be cleared here or it conflicts with TargetFrameworks. -->
    <TargetFramework></TargetFramework>
    <!-- net10.0-ios is opt-in via -p:BuildIOS=true, not unconditional - MSBuild's restore
         evaluates ALL TargetFrameworks up front, so an unconditional ios entry would require
         the maui-ios workload just to build the Windows target, breaking every Windows-only
         dev machine. The iOS build is currently only exercised in CI on a macOS runner
         (see .github/workflows/build-ios.yml), which passes -p:BuildIOS=true explicitly.
         IMPORTANT: The two TargetFrameworks lines below are MUTUALLY EXCLUSIVE (either/or),
         not additive. A prior approach appended both TFMs when BuildIOS=true, creating
         "net10.0-windows10.0.19041.0;net10.0-ios" on the macOS runner. This failed with
         NETSDK1100 because the build pipeline still touched the Windows slice even when
         -f net10.0-ios was passed, requiring EnableWindowsTargeting (unavailable on macOS).
         The fix: keep only one TFM active at a time via explicit Condition branches. -->
    <TargetFrameworks Condition="'$(BuildIOS)' != 'true'">net10.0-windows10.0.19041.0</TargetFrameworks>
    <TargetFrameworks Condition="'$(BuildIOS)' == 'true'">net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>VideoForensics.MauiApp</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCssItems>false</EnableDefaultCssItems>
    <Nullable>enable</Nullable>

    <MauiXamlInflator>SourceGen</MauiXamlInflator>

    <!-- Pin to the latest Microsoft.Maui.Controls NuGet release (10.0.110) rather than the
         version implied by the installed maui-windows workload manifest (10.0.20) - the NuGet
         package itself ships ahead of the workload manifest, and CommunityToolkit.Maui's latest
         release requires a newer Microsoft.Maui.Controls than the workload-implied default. -->
    <MauiVersion>10.0.110</MauiVersion>

    <!-- Display name -->
    <ApplicationTitle>Video Forensics</ApplicationTitle>

    <!-- App Identifier -->
    <ApplicationId>com.dvvictimprotection.videoforensics</ApplicationId>

    <!-- Versions -->
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
    <WindowsPackageType>None</WindowsPackageType>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

    <AssemblyName>VideoForensics.MauiApp</AssemblyName>
    <Authors>DV Victim Protection Team</Authors>
    <Description>Windows MAUI Blazor Hybrid client for VideoForensics</Description>
    <Copyright>2026</Copyright>
    <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>

    <!-- Microsoft.CodeAnalysis.Workspaces (pulled in transitively by Microsoft.CodeAnalysis) wants
         SQLitePCLRaw.core 3.0.2, while EF Core Sqlite (via VideoForensics.Data.Database.Sqlite)
         needs 2.1.12 - MSBuild picks 2.1.12 as primary since that's the one actually used for the
         app's real SQLite access; Workspaces' own SQLite-backed cache is never exercised by this
         app, so losing that reference is safe. Same rationale as the NU1608 suppression in
         VideoForensics.Data.Database.Sqlite.csproj.
         The PRI249 warnings from the unused Syncfusion theme CSS files are fixed by the
         ExcludeUnusedSyncfusionThemesFromPri target at the bottom of this file. -->
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- App Icon -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

    <!-- Splash Screen -->
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

    <!-- Images -->
    <MauiImage Include="Resources\Images\*" />
    <MauiImage Update="Resources\Images\dotnet_bot.svg" BaseSize="168,208" />

    <!-- Custom Fonts -->
    <MauiFont Include="Resources\Fonts\*" />

    <!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Maui" Version="15.0.1" />
    <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.110" />
    <!-- Microsoft.AspNetCore.Components.WebView.Maui is Windows-only; iOS builds do not support Blazor WebView -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="10.0.110" Condition="'$(BuildIOS)' != 'true'" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.12" />
    <PackageReference Include="Plugin.Fingerprint.MAUI" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ui\VideoForensics.Ui.Shared\VideoForensics.Ui.Shared.csproj" />
    <ProjectReference Include="..\..\host\VideoForensics.Hosting\VideoForensics.Hosting.csproj" />
    <ProjectReference Include="..\..\..\core\core\core.logging\VideoForensics.Core.Logging.csproj" />
  </ItemGroup>

  <!-- Keep only the Syncfusion theme CSS the app references (bootstrap5.css via index.html,
       bootstrap5-dark.css via theme-detect.js) out of PRI generation/packaging. The other ~45 theme files
       are never loaded, and names like bootstrap5.3-dark.css / tailwind3-dark.css make the PRI
       indexer read "3-DARK" etc. as invalid resource qualifiers (PRI249). -->
  <Target Name="ExcludeUnusedSyncfusionThemesFromPri" BeforeTargets="_GenerateProjectPriConfigurationFiles" Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <ItemGroup>
      <_UnusedSfTheme Include="@(PriOutputs)" Condition="$([System.String]::Copy('%(PriOutputs.TargetPath)').Replace('/', '\').StartsWith('wwwroot\_content\Syncfusion.Blazor.Themes\')) AND '%(PriOutputs.Filename)%(PriOutputs.Extension)' != 'bootstrap5.css' AND '%(PriOutputs.Filename)%(PriOutputs.Extension)' != 'bootstrap5-dark.css'" />
      <PriOutputs Remove="@(_UnusedSfTheme)" />
    </ItemGroup>
  </Target>

</Project>


