<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <AssemblyName>VideoForensics.Data.Database.Sqlite</AssemblyName>
        <RootNamespace>VideoForensics.Data.Database.Sqlite</RootNamespace>
        <Version>1.0.0</Version>
        <Authors>DV Victim Protection Team</Authors>
        <Description>SQLite EF Core provider implementation for the VideoForensics data access layer</Description>
        <Copyright>2026</Copyright>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
        <!-- Microsoft.CodeAnalysis is pinned to 5.9.0; EF Core Design's transitive Workspaces.MSBuild 5.0.0 dependency wants Workspaces.Common == 5.0.0 exactly, which NuGet flags but is safe since EF's design-time tooling isn't invoked in a normal build. -->
        <NoWarn>$(NoWarn);NU1608</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis" Version="5.9.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\data.database\VideoForensics.Data.Database.csproj" />
    </ItemGroup>

</Project>
