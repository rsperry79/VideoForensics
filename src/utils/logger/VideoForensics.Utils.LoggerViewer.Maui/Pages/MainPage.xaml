<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:VideoForensics.Utils.LoggerViewer.Maui.Converters"
             x:Class="VideoForensics.Utils.LoggerViewer.Maui.Pages.MainPage"
             Title="Logger Viewer"
             BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1F1F1F}">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:LogLevelTextColorConverter x:Key="LogLevelTextColorConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="auto,auto,*,auto" Padding="0" Spacing="0">
        <!-- Toolbar -->
        <Grid Grid.Row="0" Padding="12" ColumnDefinitions="*,auto,auto,auto" ColumnSpacing="8" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2F2F2F}">
            <!-- Filter Dropdown -->
            <Picker x:Name="LogLevelPicker"
                    Grid.Column="0"
                    Title="Select Level"
                    SelectedIndexChanged="OnLogLevelChanged"
                    BackgroundColor="{AppThemeBinding Light=White, Dark=#3F3F3F}"
                    TextColor="{AppThemeBinding Light=Black, Dark=White}">
                <Picker.Items>
                    <x:String>All</x:String>
                    <x:String>Debug</x:String>
                    <x:String>Information</x:String>
                    <x:String>Warning</x:String>
                    <x:String>Error</x:String>
                    <x:String>Critical</x:String>
                </Picker.Items>
            </Picker>

            <!-- Clear Button -->
            <Button Grid.Column="1"
                    Text="Clear"
                    Command="{Binding ClearCommand}"
                    BackgroundColor="{StaticResource WarningColor}"
                    TextColor="White" />

            <!-- Save Button -->
            <Button Grid.Column="2"
                    Text="Save"
                    Command="{Binding SaveCommand}"
                    BackgroundColor="{StaticResource SuccessColor}"
                    TextColor="White" />

            <!-- Connect/Disconnect Button -->
            <Button x:Name="ConnectButton"
                    Grid.Column="3"
                    Text="Connect"
                    Command="{Binding ConnectCommand}"
                    BackgroundColor="{StaticResource InfoColor}"
                    TextColor="White" />
        </Grid>

        <!-- Filter and Auto-scroll Options -->
        <Grid Grid.Row="1" Padding="12" ColumnDefinitions="*,auto" ColumnSpacing="8" BackgroundColor="{AppThemeBinding Light=#FAFAFA, Dark=#2A2A2A}">
            <Label Grid.Column="0"
                   Text="{Binding ConnectionStatus}"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   FontSize="12"
                   VerticalOptions="Center" />

            <CheckBox Grid.Column="1"
                      IsChecked="{Binding AutoScroll}"
                      VerticalOptions="Center" />
            <Label Grid.Column="1"
                   Text="Auto-scroll"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   FontSize="12"
                   Margin="35,0,0,0"
                   VerticalOptions="Center" />
        </Grid>

        <!-- Log Entries CollectionView -->
        <CollectionView Grid.Row="2"
                        ItemsSource="{Binding FilteredEntries}"
                        SelectionMode="Single"
                        Background="{AppThemeBinding Light=White, Dark=#1F1F1F}">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12" RowDefinitions="auto,auto" ColumnDefinitions="60,*" ColumnSpacing="8" BackgroundColor="{AppThemeBinding Light=White, Dark=#2F2F2F}" BorderStroke="{AppThemeBinding Light=#E0E0E0, Dark=#404040}">
                        <!-- Timestamp -->
                        <Label Grid.Row="0" Grid.Column="0"
                               Text="{Binding Timestamp, StringFormat='{0:HH:mm:ss}'}"
                               TextColor="{AppThemeBinding Light=#808080, Dark=#B0B0B0}"
                               FontSize="11"
                               FontAttributes="Bold" />

                        <!-- Log Level (colored) -->
                        <Label Grid.Row="0" Grid.Column="1"
                               Text="{Binding Level}"
                               TextColor="{Binding Level, Converter={StaticResource LogLevelTextColorConverter}}"
                               FontSize="11"
                               FontAttributes="Bold" />

                        <!-- Message -->
                        <Label Grid.Row="1" Grid.ColumnSpan="2"
                               Text="{Binding Message}"
                               TextColor="{AppThemeBinding Light=Black, Dark=White}"
                               FontSize="12"
                               LineBreakMode="WordWrap" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Padding="12" ColumnDefinitions="*,auto" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2F2F2F}" BorderStroke="{AppThemeBinding Light=#E0E0E0, Dark=#404040}">
            <Label Grid.Column="0"
                   Text="{Binding EntryCount, StringFormat='Entries: {0}'}"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   FontSize="12"
                   VerticalOptions="Center" />

            <Label Grid.Column="1"
                   x:Name="CountLabel"
                   TextColor="{AppThemeBinding Light=Black, Dark=White}"
                   FontSize="12"
                   VerticalOptions="Center" />
        </Grid>
    </Grid>

</ContentPage>
