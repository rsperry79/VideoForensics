<?xml version = "1.0" encoding = "UTF-8" ?>
<Application
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="VideoForensics.Utils.LoggerViewer.Maui.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Color Converters -->
            <converters:LogLevelColorConverter x:Key="LogLevelColorConverter" xmlns:converters="clr-namespace:VideoForensics.Utils.LoggerViewer.Maui.Converters" />
            <converters:LogLevelTextColorConverter x:Key="LogLevelTextColorConverter" xmlns:converters="clr-namespace:VideoForensics.Utils.LoggerViewer.Maui.Converters" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
