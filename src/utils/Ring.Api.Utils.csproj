<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>Ring.Api</RootNamespace>
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>../../KoenZomers.RingApi.snk</AssemblyOriginatorKeyFile>
        <AssemblyName>Ring.Api.Utils</AssemblyName>
        <Company>Koen Zomers</Company>
        <Authors>Koen Zomers, Daniel Espinosa</Authors>
        <Description>Testing and validation utilities for Ring.Api</Description>
        <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
        <Copyright>Koen Zomers</Copyright>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../../KoenZomers.RingApi.snk" Link="KoenZomers.RingApi.snk" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../common/Ring.Api.Common.csproj" />
        <ProjectReference Include="../core/Ring.Api.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Compile Remove="tests/**" />
    </ItemGroup>

</Project>



