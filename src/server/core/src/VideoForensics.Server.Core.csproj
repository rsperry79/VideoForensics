        <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.15" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
        <PackageReference Include="NodaTime" Version="3.3.7" />
        <PackageReference Include="SharpZipLib" Version="1.4.2" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../client/core/VideoForensics.Client.Core/src/VideoForensics.Client.Core.csproj" />
