<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <AssemblyName>VideoForensics.Server.Core</AssemblyName>
        <RootNamespace>VideoForensics.Client.Core</RootNamespace>
        <Authors>DV Victim Protection Team</Authors>
        <Description>Server-only services that use the data layer. Moved out of Client.Core so Client.Core has no data-layer reference. Not referenced by client UI hosts.</Description>
        <Copyright>2026</Copyright>
        <PackageLicenseExpression>EPL-2.0</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
