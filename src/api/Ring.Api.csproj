<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Ring.Api</RootNamespace>
    <AssemblyName>Ring.Api</AssemblyName>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Nullable>enable</Nullable>
    <Description>Aggregated Ring API package combining all Ring API modules (Core, Auth, Video, Common, Utils, Snapshots) into a single NuGet package for convenient consumption.</Description>
    <AssemblyTitle>Ring API</AssemblyTitle>
    <Version>1.0.0</Version>
    <Authors>Koen Zomers;Ring Community</Authors>
    <PackageProjectUrl>https://github.com/koenbeuk/RingApi</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/koenbeuk/RingApi</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ring;api;video;doorbell;security;camera</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../core/Ring.Api.Core.csproj" />
    <ProjectReference Include="../auth/Ring.Api.Auth.csproj" />
    <ProjectReference Include="../video/Ring.Api.Video.csproj" />
    <ProjectReference Include="../common/Ring.Api.Common.csproj" />
    <ProjectReference Include="../utils/Ring.Api.Utils.csproj" />
    <ProjectReference Include="../snapshots/Ring.Api.Snapshots.csproj" />
  </ItemGroup>

</Project>



